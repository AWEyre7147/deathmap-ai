# Python and installed dependencies
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
node_modules/
build/
dist/

# Local configuration and secrets
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
/docs/.obsidian/
/AGENTS.md

# Generated workspaces and local development notes
/tmp/
/.tmp/
/.discovery/
/results/generated/
/outputs/*
!/outputs/README.md
/logs/
*.log
/docs/workflow/
/docs/development/

# Raw/intermediate workspaces and isolated external validation
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/icraft/

# Large reference snapshots; curated receipts and annotations remain available
/data/cellosaurus/orcs-annotations/raw/*.txt
/data/cellosaurus/orcs-annotations/raw/*.obo
/data/cellosaurus/orcs-annotations/raw/*.part

# Excel session lock files
~$*.xlsx
~$*.xlsm

# Keep ORCS deliverables at the top level; retain source-run workspaces locally.
/data/orcs/*/
!/data/orcs/raw/
