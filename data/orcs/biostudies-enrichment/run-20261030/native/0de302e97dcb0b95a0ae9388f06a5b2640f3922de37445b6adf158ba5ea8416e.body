  }, {
    "name" : "Title",
    "value" : "CRISPR/Cas9 genome-wide screening identifies KEAP1 as a sorafenib, lenvatinib, and regorafenib sensitivity gene in hepatocellular carcinoma."
  }, {
    "name" : "ReleaseDate",
    "value" : "2019-01-01"
