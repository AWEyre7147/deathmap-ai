  }, {
    "name" : "Title",
    "value" : "Systematic Dissection of the Metabolic-Apoptotic Interface in AML Reveals Heme Biosynthesis to Be a Regulator of Drug Sensitivity."
  }, {
    "name" : "ReleaseDate",
    "value" : "2019-01-01"
  }, {
