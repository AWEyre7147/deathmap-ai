  }, {
    "name" : "Title",
    "value" : "A High-Resolution Genome-Wide CRISPR/Cas9 Viability Screen Reveals Structural Features and Contextual Diversity of the Human Cell-Essential Proteome."
  }, {
    "name" : "ReleaseDate",
    "value" : "2018-01-01"
