{"page":1,"pageSize":100,"totalHits":1,"isTotalHitsExact":true,"sortBy":"id","sortOrder":"ascending","suggestion":[],"expandedEfoTerms":[],"expandedSynonyms":[],"query":"\"PMC6927754\"","facets":null,"hits":[{"accession":"S-EPMC6927754","type":"study","title":"Genome-wide CRISPR screening reveals genetic modifiers of mutant EGFR dependence in human NSCLC.","author":"Zeng H Castillo-Cabrera J Manser M Lu B Yang Z Strande V Begue D Zamponi R Qiu S Sigoillot F Wang Q Lindeman A Reece-Hoyes JS Russ C Bonenfant D Jiang X Wang Y Cong F","links":41,"files":9,"release_date":"2019-01-01","views":17,"isPublic":true,"content":"S-EPMC6927754 PMC6927754 Genome-wide CRISPR screening reveals genetic modifiers of mutant EGFR dependence in human NSCLC. EGFR-mutant NSCLCs frequently respond to EGFR tyrosine kinase inhibitors (TKIs). However, the responses are not durable, and the magnitude of tumor regression is variable"}],"nextCursor":null,"tooManyExpansionTerms":false}