{"page":1,"pageSize":100,"totalHits":1,"isTotalHitsExact":true,"sortBy":"id","sortOrder":"ascending","suggestion":[],"expandedEfoTerms":[],"expandedSynonyms":[],"query":"\"PMC6547413\"","facets":null,"hits":[{"accession":"S-EPMC6547413","type":"study","title":"PRMT1 loss sensitizes cells to PRMT5 inhibition.","author":"Gao G Zhang L Villarreal OD He W Su D Bedford E Moh P Shen J Shi X Bedford MT Xu H","links":3,"files":1,"release_date":"2019-01-01","views":16,"isPublic":true,"content":"S-EPMC6547413 PMC6547413 PRMT1 loss sensitizes cells to PRMT5 inhibition. PRMT5 is an arginine methyltransferase that accounts for the vast majority of the symmetric methylation in cells. PRMT5 exerts its function when complexed with MEP50/WDR77. This activity is often elevated in cancer cells"}],"nextCursor":null,"tooManyExpansionTerms":false}