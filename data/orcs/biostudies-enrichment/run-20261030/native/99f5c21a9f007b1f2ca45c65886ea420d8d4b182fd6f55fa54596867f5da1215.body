  }, {
    "name" : "Title",
    "value" : "Survival-based CRISPR genetic screens across a panel of permissive cell lines identify common and cell-specific SARS-CoV-2 host factors."
  }, {
    "name" : "ReleaseDate",
    "value" : "2023-01-01"
  }, {
