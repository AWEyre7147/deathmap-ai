    "name" : "Title",
    "value" : "Genome-Wide CRISPR Screens Reveal ZATT as a Synthetic Lethal Target of TOP2-Poison Etoposide That Can Act in a TDP2-Independent Pathway"
  }, {
    "name" : "ReleaseDate",
    "value" : "2023-01-01"
  }, {
