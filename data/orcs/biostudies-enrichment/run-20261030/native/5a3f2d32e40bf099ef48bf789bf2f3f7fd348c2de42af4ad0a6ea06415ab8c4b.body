  }, {
    "name" : "Title",
    "value" : "Genome-wide CRISPRi screen and proteomic profiling identify key genes related to ferulic acid's antifungal activity."
  }, {
    "name" : "ReleaseDate",
    "value" : "2025-01-01"
  }, {
