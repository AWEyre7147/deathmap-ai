  }, {
    "name" : "Title",
    "value" : "Genome-wide CRISPR/Cas9 screening identifies determinant of panobinostat sensitivity in acute lymphoblastic leukemia."
  }, {
    "name" : "ReleaseDate",
    "value" : "2022-01-01"
  }, {
    "name" : "AttachTo",
    "value" : "EuropePMC"
