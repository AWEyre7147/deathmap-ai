  }, {
    "name" : "Title",
    "value" : "Integrated proteogenetic analysis reveals the landscape of a mitochondrial-autophagosome synapse during PARK2-dependent mitophagy."
  }, {
    "name" : "ReleaseDate",
    "value" : "2019-01-01"
  }, {
    "name" : "AttachTo",
    "value" : "EuropePMC"
