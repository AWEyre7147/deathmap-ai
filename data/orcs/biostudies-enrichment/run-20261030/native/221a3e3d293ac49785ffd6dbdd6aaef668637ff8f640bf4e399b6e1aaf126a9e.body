    "name" : "Title",
    "value" : "Genome-Wide CRISPR Screening Identifies DCK and CCNL1 as Genes That Contribute to Gemcitabine Resistance in Pancreatic Cancer."
  }, {
    "name" : "ReleaseDate",
    "value" : "2022-01-01"
  }, {
