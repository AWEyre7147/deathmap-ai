    "name" : "Title",
    "value" : "CRISPR-Knockout Screen Identifies Dmap1 as a Regulator of Chemically Induced Reprogramming and Differentiation of Cardiac Progenitors."
  }, {
    "name" : "ReleaseDate",
    "value" : "2019-01-01"
