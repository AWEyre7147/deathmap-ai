      {
        "name": "Title",
        "value": "A Genome-Wide Screen Identifies PDPK1 as a Target to Enhance the Efficacy of MEK1/2 Inhibitors in NRAS Mutant Melanoma."
      },
      {
        "name": "ReleaseDate",
        "value": "2022-01-01"
      },
