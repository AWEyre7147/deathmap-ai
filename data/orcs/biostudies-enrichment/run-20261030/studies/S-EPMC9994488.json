      },
      {
        "name": "Title",
        "value": "Thioparib inhibits homologous recombination repair, activates the type I IFN response, and overcomes olaparib resistance."
      },
      {
        "name": "ReleaseDate",
        "value": "2023-01-01"
      },
      {
