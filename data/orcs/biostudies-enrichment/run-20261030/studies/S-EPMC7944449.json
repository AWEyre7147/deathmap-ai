      {
        "name": "Title",
        "value": "Cytidine Monophosphate <i>N</i>-Acetylneuraminic Acid Synthetase and Solute Carrier Family 35 Member A1 Are Required for Reovirus Binding and Infection."
      },
      {
        "name": "ReleaseDate",
        "value": "2020-01-01"
      },
