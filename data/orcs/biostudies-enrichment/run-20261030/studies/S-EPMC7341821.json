      {
        "name": "Title",
        "value": "A Genome-wide CRISPR Screen Reveals a Role for the Non-canonical Nucleosome-Remodeling BAF Complex in Foxp3 Expression and Regulatory T Cell Function."
      },
      {
        "name": "ReleaseDate",
        "value": "2020-01-01"
      },
      {
