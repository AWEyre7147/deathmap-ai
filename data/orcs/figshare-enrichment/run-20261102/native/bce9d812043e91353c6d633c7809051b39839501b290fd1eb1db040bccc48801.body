{"files": [{"id": 25569135, "name": "12915_2020_905_MOESM7_ESM.pdf", "size": 59120, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/25569135", "supplied_md5": "b84e06293c0de0f6ab916b928ca41cc6", "computed_md5": "b84e06293c0de0f6ab916b928ca41cc6", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 9676479, "full_name": "Luisa Henkel", "first_name": "Luisa", "last_name": "Henkel", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9676482, "full_name": "Benedikt Rauscher", "first_name": "Benedikt", "last_name": "Rauscher", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 476884, "full_name": "Barbara Schmitt", "first_name": "Barbara", "last_name": "Schmitt", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3446093, "full_name": "Jan Winter", "first_name": "Jan", "last_name": "Winter", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9676485, "full_name": "Michael Boutros", "first_name": "Michael", "last_name": "Boutros", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9458-817X"}], "custom_fields": [{"name": "Research Data Support", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Complete where RDS data are part of RDS submission"}, "field_type": "text", "order": null, "is_mandatory": false}], "figshare_url": "https://springernature.figshare.com/articles/journal_contribution/Additional_file_7_of_Genome-scale_CRISPR_screening_at_high_sensitivity_with_an_empirically_designed_sgRNA_library/13278627", "download_disabled": false, "description": "Additional file 7: Figure S3. DNA content analysis to determine ploidy of various HAP1 Cas9 populations. (A) HAP1 Cas9 bulk and HAP1 Cas9 SCC11 and SCC12 cells were stained for DNA content using Nicoletti buffer and FACS analysis. The percentage of G1 haploid cells and G2 diploid cells are indicated for each cell population (n\u2009=\u20092 for each condition). (B-C) Enriched haploid and diploid populations of the HAP1 Cas9 SCC11 (B) and Cas9 SCC12 (C) cell lines were obtained by FACS sorting. Subsequently, haploid and diploid populations were independently transduced with the HDCRISPRv1 vector expressing sgRNAs targeting the surface marker CD46 and editing efficiency was directly compared in the haploid and diploid population of the same cell line. Non-edited samples of the respective cell lines served as a control. Lines represent the mean of three independent experiments for each condition.", "funding": "de.NBi BMBF", "funding_list": [{"id": 19470555, "title": "de.NBi BMBF", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 59120, "created_date": "2020-11-24T04:55:41Z", "modified_date": "2026-03-08T09:19:22Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 47, "name": "CC BY + CC0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["CRISPR/Cas9", "Genetic screens", "sgRNA design", "Gene essentiality", "Functional genomics"], "keywords": ["CRISPR/Cas9", "Genetic screens", "sgRNA design", "Gene essentiality", "Functional genomics"], "categories": [{"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1038/nrg1291", "https://doi.org/10.1038/nrg2364", "https://doi.org/10.1038/nrg.2017.97", "https://doi.org/10.1126/science.1225829", "https://doi.org/10.1126/science.1232033", "https://doi.org/10.1126/science.1246981", "https://doi.org/10.1126/science.1247005", "https://doi.org/10.1016/j.cell.2015.11.015", "https://doi.org/10.1016/j.cell.2015.02.038", "https://doi.org/10.1016/j.cell.2015.02.038", "https://doi.org/10.1158/2159-8290.CD-16-0154", "https://doi.org/10.1126/science.aah7111", "https://doi.org/10.1038/ng.3984", "https://doi.org/10.1038/s41586-019-1103-9", "https://doi.org/10.1038/s41467