{"files": [{"id": 42161548, "name": "pgen.1010903.g007.tif", "size": 1620924, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/42161548", "supplied_md5": "25b848cfbcdc71ff8ef3e37195092a5a", "computed_md5": "25b848cfbcdc71ff8ef3e37195092a5a", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 842833, "full_name": "Karine Normandin", "first_name": "Karine", "last_name": "Normandin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 126532, "full_name": "Jasmin Coulombe-Huntington", "first_name": "Jasmin", "last_name": "Coulombe-Huntington", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16892359, "full_name": "Corinne St-Denis", "first_name": "Corinne", "last_name": "St-Denis", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16892362, "full_name": "Alexandre Bernard", "first_name": "Alexandre", "last_name": "Bernard", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592382, "full_name": "Mohammed Bourouh", "first_name": "Mohammed", "last_name": "Bourouh", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 470436, "full_name": "Thierry Bertomeu", "first_name": "Thierry", "last_name": "Bertomeu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1118, "full_name": "Mike Tyers", "first_name": "Mike", "last_name": "Tyers", "is_active": false, "url_name": "Mike_Tyers", "orcid_id": ""}, {"id": 73964, "full_name": "Vincent Archambault", "first_name": "Vincent", "last_name": "Archambault", "is_active": false, "url_name": "Vincent_Archambault", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/CENP-A_loading_on_centromeres_is_extremely_sensitive_to_partial_PLK1_inhibition_/24044788", "download_disabled": false, "description": "<p><b>A.</b> Immunofluorescence in RPE-1 cells treated for 72 h with the indicated concentrations of BI2536. CENP-A levels were measured in the DAPI-stained areas (inside yellow dotted lines). <b>B.</b> Quantifications as illustrated in A. Each data point is from a single cell. Blue and grey points are from two independent experiments (100 cells were analyzed per condition per experiment). Averages \u00b1SD are shown. *** p < 0.001, ** p < 0.01 in Student\u2019s unpaired T test. ns: non-significant. <b>C.</b> Western blots showing CENP-A levels in a crude chromatin fraction (C, pellet) vs the soluble fraction (S). The crude chromatin fraction was resuspended in 1/10 volume relative to the total lysate. Histone H3 (HH3) and \u03b1-Tubulin were monitored as chromatin and soluble markers, respectively. Concentrations of BI2536 used were measured in a cell proliferation inhibition assay (see <a href=\"http://www.plosgenetics.org/article/info:doi/10.1371/journal.pgen.1010903#sec012\" target=\"_blank\">Materials & Methods</a>; IC<sub>10</sub>: 2.7 nM, IC<sub>30</sub>: 5.0 nM, IC<sub>50</sub>: 7.2 nM. IC<sub>90</sub>: 19.2 nM). Coordinate values used to generate graphs are available in <a href=\"http://www.plosgenetics.org/article/info:doi/10.1371/journal.pgen.1010903#pgen.1010903.s023\" target=\"_blank\">S7 Data</a>.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1620924, "created_date": "2023-08-28T17:34:06Z", "modified_date": "2023-09-08T18:01:50Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["xlink \"> polo", "wide screening strategy", "threonine kinase required", "spindle assembly checkpoint", "like kinase 1", "cell division cycle", "compromised cells resulted", "nuclear reassembly defects", "different kinetochore perturbations", "rendering cells hypersensitive", "partial plk1 inactivation", "partial plk1 inhibition", "partial inhibition", "cancer cells", "often hypersensitive", "mitotic defects", "kinetochore complex", "plk1 