 not antiviral hit. Empty square: not tested/no data available.</p> <p>(TIF)</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 2144396, "created_date": "2022-04-14T17:53:56Z", "modified_date": "2023-06-10T04:03:25Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["pooled genetic screens", "isogenic cell lines", "cdna expression experiments", "proapoptotic isg activities", "inducible isg expression", "isg antiviral functions", "isg repertoire", "antiviral state", "viral specificities", "throughput interrogation", "throughput approach", "studies demonstrate", "stimulated genes"], "keywords": ["pooled genetic screens", "isogenic cell lines", "cdna expression experiments", "proapoptotic isg activities", "inducible isg expression", "isg antiviral functions", "isg repertoire", "antiviral state", "viral specificities", "throughput interrogation", "throughput approach", "studies demonstrate", "stimulated genes"], "categories": [{"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 24, "title": "Evolutionary Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 272, "title": "Environmental Sciences not elsewhere classified", "parent_id": 33, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 46, "title": "Immunology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 61, "title": "Developmental Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 64, "title": "Cancer", "parent_id": 48