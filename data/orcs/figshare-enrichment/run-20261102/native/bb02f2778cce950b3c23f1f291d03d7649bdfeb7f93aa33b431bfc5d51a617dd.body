{"files": [{"id": 39621107, "name": "ppat.1011232.s001.tif", "size": 2046374, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39621107", "supplied_md5": "ce59bb5e320521da011aa450298511df", "computed_md5": "ce59bb5e320521da011aa450298511df", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 139140, "full_name": "Tian Xia", "first_name": "Tian", "last_name": "Xia", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10164, "full_name": "Xin Wu", "first_name": "Xin", "last_name": "Wu", "is_active": false, "url_name": "Xin_Wu", "orcid_id": ""}, {"id": 14797226, "full_name": "Eunjin Hong", "first_name": "Eunjin", "last_name": "Hong", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14797229, "full_name": "Kyle Jung", "first_name": "Kyle", "last_name": "Jung", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14797232, "full_name": "Chih-Jen Lai", "first_name": "Chih-Jen", "last_name": "Lai", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14797235, "full_name": "Mi-Jeong Kwak", "first_name": "Mi-Jeong", "last_name": "Kwak", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14797238, "full_name": "Hogyu Seo", "first_name": "Hogyu", "last_name": "Seo", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2560966, "full_name": "Stephanie Kim", "first_name": "Stephanie", "last_name": "Kim", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 583925, "full_name": "Zhongyi Jiang", "first_name": "Zhongyi", "last_name": "Jiang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14797241, "full_name": "Inho Cha", "first_name": "Inho", "last_name": "Cha", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9611629, "full_name": "Jae U. Jung", "first_name": "Jae U.", "last_name": "Jung", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/HRTV_requires_GlcCer_for_efficient_infection_in_HeLa_cell_/22278488", "download_disabled": false, "description": "<p><b>A.</b> Knockout efficiency of <i>SPTLC2-</i>, <i>UGCG-</i> or <i>UGT8</i> gene in HeLa cell lines was measured by qPCR. Data shown are means \u00b1 SEM from representative experiments (n = 3 technical replicates). <i>P</i> values were determined by multiple unpaired t-tests. **, <i>P</i> < 0.01; *, <i>P</i> < 0.05. <b>B.</b> SPTLC2 protein levels in 293T and HeLa knockout cells. <b>C.</b> Control and KO HeLa cells were infected with HRTV (MOI = 1) for the indicated times for qPCR analysis. Data shown are means \u00b1 SEM from representative experiments (n = 3 technical replicates). <i>P</i> values were determined by ordinary one-way ANOVA with Dunnett\u2019s multiple comparison tests. ****, <i>P</i>\u2009<\u20090.0001; ***, <i>P</i> < 0.001; **, <i>P</i> < 0.01; *, <i>P</i> < 0.05. <b>D-E.</b> Effects of SPTLC2-, UGCG- or UGT8-deficiency on HRTV gene expression. Control or KO HeLa cells were infected with HRTV or VSV-GFP for 24 hours (MOI = 4), followed by immunostaining with an anti-N monoclonal antibody for immunofluorescence microscopy (<b>D</b>). Infectivity was quantified by ImageJ (<b>E</b>). <i>P</i> values were determined by ordinary one-way ANOVA with Dunnett\u2019s multiple comparison test (n\u2009 = \u20096\u201311) ****, P\u2009<\u20090.0001.</p> <p>(TIF)</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 2046374, "created_date": "2023-03-15T17:34:55Z", "modified_date": "2023-06-14T14:58:21Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["recombinant viruses pseudotyped", "potential therapeutic target", "group binding pocket", "glucose ceramide glucosyltransferase", "dabie bandavirus glycoprotein", "dabie bandavirus </", "borne zoonotic