{"files": [{"id": 39964227, "name": "15357163mct170868-sup-188896_2_supp_4465450_p1b555.pdf", "size": 336131, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39964227", "supplied_md5": "8588c317f46f7192eee49f6e70a12f81", "computed_md5": "8588c317f46f7192eee49f6e70a12f81", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 352940, "full_name": "Diede Brunen", "first_name": "Diede", "last_name": "Brunen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15070626, "full_name": "Romy C. de Vries", "first_name": "Romy C.", "last_name": "de Vries", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 6016799, "full_name": "Cor Lieftink", "first_name": "Cor", "last_name": "Lieftink", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10094612, "full_name": "Roderick L. Beijersbergen", "first_name": "Roderick L.", "last_name": "Beijersbergen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 82847, "full_name": "Ren\u00e9 Bernards", "first_name": "Ren\u00e9", "last_name": "Bernards", "is_active": false, "url_name": "Ren_Bernards", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "The majority of high-risk neuroblastoma patients are refractory to, or relapse on, current treatment regimens, resulting in 5-year survival rates of less than 50%. This emphasizes the urgent need to identify novel therapeutic targets. Here, we report that high PIM kinase expression is correlated with poor overall survival. Treatment of neuroblastoma cell lines with the pan-PIM inhibitors AZD1208 or PIM-447 suppressed proliferation through inhibition of mTOR signaling. In a panel of neuroblastoma cell lines, we observed a marked binary response to PIM inhibition, suggesting that specific genetic lesions control responses to PIM inhibition. Using a genome-wide CRISPR-Cas9 genetic screen, we identified NF1 loss as the major resistance mechanism to PIM kinase inhibitors. Treatment with AZD1208 impaired the growth of NF1 wild-type xenografts, while NF1 knockout cells were insensitive. Thus, our data indicate that PIM inhibition may be a novel targeted therapy in NF1 wild-type neuroblastoma. Mol Cancer Ther; 17(4); 849\u201357. \u00a92018 AACR.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplemental_figure_1_PIM_expression_and_overall_survival_Versteeg_cohort_from_PIM_Kinases_Are_a_Potential_Prognostic_Biomarker_and_Therapeutic_Target_in_Neuroblastoma/22504488", "download_disabled": false, "description": "<p>(A-D) High PIM2 and -3 mRNA expression correlates with poor overall survival in neuroblastoma. Kaplan- Meier survival curves of the Versteeg cohort (88 patients) demonstrate overall patient survival, using median PIM expression as a cut-off value for high versus low expression. High PIM1/2/3 indicates patients with high expression of either PIM1, -2, or -3. P-values were calculated using a log-rank test. (E-G) PIM expression across tumor stages (Versteeg cohort). P-values were calculated using a one-way ANOVA and Dunnett''s test. p {less than or equal to} 0.05 (*) (H) PIM expression in MYCN amplified and non-amplified tumors (Versteeg cohort). P-values were calculated using an unpaired T-test. p {less than or equal to} 0.001 (***)</p>", "funding": "Dutch Cancer Society", "funding_list": [{"id": 125042, "title": "Dutch Cancer Society", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23239251, "title": "Centerfor Cancer Genomics", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23225412, "title": "Stand Up To Cancer", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 336131, "created_date": "2023-04-03T15:00:56Z", "modified_date": "2023-07-02T15:12:35Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Drug Resistance", "Novel mechanisms", "Drug Targets", "Pediatric Cancers", "Small Molecule Agents"], "keywords": ["Drug Resistance", "Novel mechanisms", "Drug Targets", "Pediatric Cancers", "Small Molecule Agents"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/1535-7163.MCT-17-0868"], "has_linked_file": false, "citation": "Brunen, Diede; de Vries, Romy C.; Lieftink, Cor; Beijersbergen, Roderick L.; Bernards, Ren\u00e9 (2018). Supplemental figure 1. PIM expression and overall survival Versteeg cohort from PIM Kinases Are a Potential Prognostic Biomarker and Therapeutic Target in Neuroblastoma. American Association for Cancer Research. Journal contribution. https://doi.org/10.1158/1535-7163.22504488.v1", "related_materials": [{"id": 108065649, "identifier": "10.1158/1535-7163.MCT-17-0868", "title": "PIM Kinases Are a Potential Prognostic Biomarker and Therapeutic Target in Neuroblastoma", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/1535-7163.MCT-17-0868"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22504488, "title": "Supplemental figure 1. PIM expression and overall survival Versteeg cohort from PIM Kinases Are a Potential Prognostic Biomarker and Therapeutic Target in Neuroblastoma", "doi": "10.1158/1535-7163.22504488.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/22504488", "published_date": "2023-04-03T15:00:56Z", "thumb": "https://ndownloader.figshare.com/files/39964227/preview/39964227/thumb.png", "defined_type": 6, "defined_type_name": "journal contribution", "group_id": 46213, "url_private_api": "https://api.figshare.com/v2/account/articles/22504488", "url_public_api": "https://api.figshare.com/v2/articles/22504488", "url_private_html": "https://figshare.com/account/articles/22504488", "url_public_html": "https://aacr.figshare.com/articles/journal_contribution/Supplemental_figure_1_PIM_expression_and_overall_survival_Versteeg_cohort_from_PIM_Kinases_Are_a_Potential_Prognostic_Biomarker_and_Therapeutic_Target_in_Neuroblastoma/22504488", "timeline": {"posted": "2023-04-03T15:00:56", "publisherPublication": "2018-04-01T00:00:00", "firstOnline": "2023-04-03"}, "resource_title": "PIM Kinases Are a Potential Prognostic Biomarker and Therapeutic Target in Neuroblastoma", "resource_doi": "10.1158/1535-7163.MCT-17-0868"}