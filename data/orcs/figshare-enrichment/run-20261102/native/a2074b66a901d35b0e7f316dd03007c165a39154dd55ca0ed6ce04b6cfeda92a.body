/22278560", "published_date": "2023-03-15T17:35:20Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-plos-725668748/39621179/thumb.png", "defined_type": 1, "defined_type_name": "figure", "group_id": 113, "url_private_api": "https://api.figshare.com/v2/account/articles/22278560", "url_public_api": "https://api.figshare.com/v2/articles/22278560", "url_private_html": "https://figshare.com/account/articles/22278560", "url_public_html": "https://plos.figshare.com/articles/figure/The_HRTV_Gc_protein_is_associated_with_GlcCer_in_the_lipid_bilayer_/22278560", "timeline": {"posted": "2023-03-15T17:35:20", "publisherPublication": "2023-03-15T17:34:54", "firstOnline": "2023-03-15"}, "resource_title": "Glucosylceramide is essential for Heartland and Dabie bandavirus glycoprotein-induced membrane fusion", "resource_doi": "10.1371/journal.ppat.1011232"}