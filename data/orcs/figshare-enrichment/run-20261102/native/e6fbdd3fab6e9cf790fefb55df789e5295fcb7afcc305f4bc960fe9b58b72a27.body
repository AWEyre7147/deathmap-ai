computed_md5": "441481d5d581627f2fc5ab62b28ce18e", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"}], "folder_structure": {}, "authors": [{"id": 127458, "full_name": "Jingwei Cheng", "first_name": "Jingwei", "last_name": "Cheng", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3359795, "full_name": "Donglim Esther Park", "first_name": "Donglim Esther", "last_name": "Park", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 127454, "full_name": "Christian Berrios", "first_name": "Christian", "last_name": "Berrios", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4512622, "full_name": "Elizabeth A. White", "first_name": "Elizabeth A.", "last_name": "White", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 486227, "full_name": "Reety Arora", "first_name": "Reety", "last_name": "Arora", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 127452, "full_name": "Rosa Yoon", "first_name": "Rosa", "last_name": "Yoon", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4512628, "full_name": "Timothy Branigan", "first_name": "Timothy", "last_name": "Branigan", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 548618, "full_name": "Tengfei Xiao", "first_name": "Tengfei", "last_name": "Xiao", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4512613, "full_name": "Thomas Westerling", "first_name": "Thomas", "last_name": "Westerling", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4512616, "full_name": "Alexander Federation", "first_name": "Alexander", "last_name": "Federation", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4512625, "full_name": "Rhamy Zeid", "first_name": "Rhamy", "last_name": "Zeid", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4512619, "full_name": "Benjamin Strober", "first_name": "Benjamin", "last_name": "Strober", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 271965, "full_name": "Selene K. Swanson", "first_name": "Selene K.", "last_name": "Swanson", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 66526, "full_name": "Laurence Florens", "first_name": "Laurence", "last_name": "Florens", "is_active": false, "url_name": "Laurence_Florens", "orcid_id": ""}, {"id": 513974, "full_name": "James E. Bradner", "first_name": "James E.", "last_name": "Bradner", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2473, "full_name": "Myles Brown", "first_name": "Myles", "last_name": "Brown", "is_active": false, "url_name": "Myles_Brown", "orcid_id": ""}, {"id": 1351938, "full_name": "Peter M. Howley", "first_name": "Peter M.", "last_name": "Howley", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 127447, "full_name": "Megha Padi", "first_name": "Megha", "last_name": "Padi", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 127462, "full_name": "Michael P. Washburn", "first_name": "Michael P.", "last_name": "Washburn", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 127469, "full_name": "James A. DeCaprio", "first_name": "James", "last_name": "A. DeCaprio", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/dataset/Merkel_cell_polyomavirus_recruits_MYCL_to_the_EP400_complex_to_promote_oncogenesis/5499829", "download_disabled": false, "description": "<div><p>Merkel cell carcinoma (MCC) frequently contains integrated copies of Merkel cell polyomavirus DNA that express a truncated form of Large T antigen (LT) and an intact Small T antigen (ST). While LT binds RB and inactivates its tumor suppressor function, it is less clear how ST contributes to MCC tumorigenesis. Here we show that ST binds specifically to the MYC homolog MYCL (L-MYC) and recruits it to the 15-component EP400 histone acetyltransferase and chromatin remodeling complex. We performed a large-scale immunoprecipitation for ST and identified co-precipitating proteins by mass spectrometry. In addition to protein phosphatase 2A (PP2A) subunits, we identified MYCL and its heterodimeric partner MAX plus the EP400 complex. Immunoprecipitation for MAX and EP400 complex components confirmed their association with ST. We determined that the ST-MYCL-EP400 complex binds together to specific gene promoters and activates their expression by integrating chromatin immunoprecipitation with sequencing (ChIP-seq) and RNA-seq. MYCL and EP400 were required for maintenance of cell viability and cooperated with ST to promote gene expression in MCC cell lines. A genome-wide CRISPR-Cas9 screen confirmed the requirement for MYCL and EP400 in MCPyV-positive MCC cell lines. We demonstrate that ST can activate gene expression in a EP400 and MYCL dependent manner and this activity contributes to cellular transformation and generation of induced pluripotent stem cells.</p></div>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 19626816, "created_date": "2017-10-13T17:37:39Z", "modified_date": "2023-06-01T02:05:54Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["PP 2A subunits", "protein phosphatase 2", "RB", "genome-wide CRISPR-Cas 9 screen", "MCC cell lines", "L-MYC", "gene expression", "tumor suppressor function", "15- component EP 400 histone acetyltransferase", "MYC homolog MYCL", "oncogenesis Merkel cell carcinoma", "Large T antigen", "heterodimeric partner MAX", "Merkel cell polyomavirus DNA", "ST", "MCPyV-positive MCC cell lines", "ST-MYCL-EP", "EP 400", "LT", "Small T antigen", "Merkel cell polyomavirus recruits MYCL"], "keywords": ["PP 2A subunits", "protein phosphatase 2", "RB", "genome-wide CRISPR-Cas 9 screen", "MCC cell lines", "L-MYC", "gene expression", "tumor suppressor function", "15- component EP 400 histone acetyltransferase", "MYC homolog MYCL", "oncogenesis Merkel cell carcinoma", "Large T antigen", "heterodimeric partner MAX", "Merkel cell polyomavirus DNA", "ST", "MCPyV-positive MCC cell lines", "ST-MYCL-EP", "EP 400", "LT", "Small T antigen", "Merkel cell polyomavirus recruits MYCL"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 12, "title": "Cell Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 61, "title": "Developmental Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 64, "title": "Cancer", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 132, "title": "Infectious Diseases", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1371/journal.ppat.1006668"], "has_linked_file": false, "citation": "Cheng, Jingwei; Park, Donglim Esther; Berrios, Christian; White, Elizabeth A.; Arora, Reety; Yoon, Rosa; et al. (2017). Merkel cell polyomavirus recruits MYCL to the EP400 complex to promote oncogenesis. PLOS Pathogens. Dataset. https://doi.org/10.1371/journal.ppat.1006668", "related_materials": [{"id": 15370181, "identifier": "10.1371/journal.ppat.1006668", "title": "Merkel cell polyomavirus recruits MYCL to the EP400 complex to promote oncogenesis", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1371/journal.ppat.1006668"}], "is_embargoed": false, "embargo_date": null, "embargo