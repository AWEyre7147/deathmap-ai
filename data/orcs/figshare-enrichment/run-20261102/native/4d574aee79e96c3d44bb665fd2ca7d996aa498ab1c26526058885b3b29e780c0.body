{"files": [{"id": 39870930, "name": "00085472can183374-sup-211068_3_supp_5741479_pwz5ml.xlsx", "size": 1593063, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39870930", "supplied_md5": "bf97951568870e6c1af87673f8890d27", "computed_md5": "bf97951568870e6c1af87673f8890d27", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"}], "folder_structure": {}, "authors": [{"id": 549548, "full_name": "Junbo Liang", "first_name": "Junbo", "last_name": "Liang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 325, "full_name": "Hong Zhao", "first_name": "Hong", "last_name": "Zhao", "is_active": false, "url_name": "Hong_Zhao", "orcid_id": ""}, {"id": 14941773, "full_name": "Bill H. Diplas", "first_name": "Bill H.", "last_name": "Diplas", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-9248-7351"}, {"id": 9858, "full_name": "Song Liu", "first_name": "Song", "last_name": "Liu", "is_active": false, "url_name": "Song_Liu", "orcid_id": ""}, {"id": 4632793, "full_name": "Jianmei Liu", "first_name": "Jianmei", "last_name": "Liu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8671749, "full_name": "Dingding Wang", "first_name": "Dingding", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 32611, "full_name": "Yan Lu", "first_name": "Yan", "last_name": "Lu", "is_active": false, "url_name": "Yan_Lu", "orcid_id": ""}, {"id": 349093, "full_name": "Qing Zhu", "first_name": "Qing", "last_name": "Zhu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4530574, "full_name": "Jiayu Wu", "first_name": "Jiayu", "last_name": "Wu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 797112, "full_name": "Wenjia Wang", "first_name": "Wenjia", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 168017, "full_name": "Hai Yan", "first_name": "Hai", "last_name": "Yan", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20896, "full_name": "Yi-Xin Zeng", "first_name": "Yi-Xin", "last_name": "Zeng", "is_active": false, "url_name": "Yi_Xin_Zeng", "orcid_id": ""}, {"id": 212345, "full_name": "Xiaoyue Wang", "first_name": "Xiaoyue", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 150296, "full_name": "Yuchen Jiao", "first_name": "Yuchen", "last_name": "Jiao", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "The tumor suppressor gene ATRX is frequently mutated in a variety of tumors including gliomas and liver cancers, which are highly unresponsive to current therapies. Here, we performed a genome-wide synthetic lethal screen, using CRISPR-Cas9 genome editing, to identify potential therapeutic targets specific for ATRX-mutated cancers. In isogenic hepatocellular carcinoma (HCC) cell lines engineered for ATRX loss, we identified 58 genes, including the checkpoint kinase WEE1, uniquely required for the cell growth of ATRX null cells. Treatment with the WEE1 inhibitor AZD1775 robustly inhibited the growth of several ATRX-deficient HCC cell lines in vitro, as well as xenografts in vivo. The increased sensitivity to the WEE1 inhibitor was caused by accumulated DNA damage\u2013induced apoptosis. AZD1775 also selectively inhibited the proliferation of patient-derived primary cell lines from gliomas with naturally occurring ATRX mutations, indicating that the synthetic lethal relationship between WEE1 and ATRX could be exploited in a broader spectrum of human tumors. As WEE1 inhibitors have been investigated in several phase II clinical trials, our discovery provides the basis for an easily clinically testable therapeutic strategy specific for cancers deficient in ATRX.\nATRX-mutant cancer cells depend on WEE1, which provides a basis for therapeutically targeting WEE1 in ATRX-deficient cancers.See related commentary by Cole, p. 375", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/dataset/Supplementary_Table_S1_from_Genome-Wide_CRISPR-Cas9_Screen_Reveals_Selective_Vulnerability_of_i_ATRX_i_-Mutant_Cancers_to_WEE1_Inhibition/22424652", "download_disabled": false, "description": "<p>Supplementary Table S1. lists all the candidate genes identified from the ATRX synthetic lethal CRISPR-Cas9 screen.</p>", "funding": "National Natural Science Foundation Fund", "funding_list": [{"id": 23227194, "title": "National Natural Science Foundation Fund", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 54953, "title": "National Key Basic Research Program of China", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23225834, "title": "CAMS", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23227197, "title": "Infection Diseases of China", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 1593063, "created_date": "2023-03-31T03:24:08Z", "modified_date": "2024-02-23T09:15:17Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Cell Cycle", "Cell cycle checkpoints", "Cns Cancers", "Gliomas, Glioblastomas", "Drug Targets", "Protein kinase & phosphatase drug targets", "Gastrointestinal Cancers", "Liver cancer", "Genome Biology", "Functional genomics", "Small Molecule Agents"], "keywords": ["Cell Cycle", "Cell cycle checkpoints", "Cns Cancers", "Gliomas, Glioblastomas", "Drug Targets", "Protein kinase & phosphatase drug targets", "Gastrointestinal Cancers", "Liver cancer", "Genome Biology", "Functional genomics", "Small Molecule Agents"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/0008-5472.CAN-18-3374"], "has_linked_file": false, "citation": "Liang, Junbo; Zhao, Hong; Diplas, Bill H.; Liu, Song; Liu, Jianmei; Wang, Dingding; et al. (2020). Supplementary Table S1 from Genome-Wide CRISPR-Cas9 Screen Reveals Selective Vulnerability of ATRX-Mutant Cancers to WEE1 Inhibition. American Association for Cancer Research. Dataset. https://doi.org/10.1158/0008-5472.22424652.v1", "related_materials": [{"id": 95247573, "identifier": "10.1158/0008-5472.CAN-18-3374", "title": "Genome-Wide CRISPR-Cas9 Screen Reveals Selective Vulnerability of ATRX-Mutant Cancers to WEE1 Inhibition", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/0008-5472.CAN-18-3374"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22424652, "title": "Supplementary Table S1 from Genome-Wide CRISPR-Cas9 Screen Reveals Selective Vulnerability of <i>ATRX</i>-Mutant Cancers to WEE1 Inhibition", "doi": "10.1158/0008-5472.22424652.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/22424652", "published_date": "2023-03-31T03:24:07Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": 46225, "url_private_api": "https://api.figshare.com/v2/account/articles/22424652", "url_public_api": "https://api.figshare.com/v2/articles/22424652", "url_private_html": "https://figshare.com/account/articles/22424652", "url_public_html": "https://aacr.figshare.com/articles/dataset/Supplementary_Table_S1_from_Genome-Wide_CRISPR-Cas9_Screen_Reveals_Selective_Vulnerability_of_i_ATRX_i_-Mutan