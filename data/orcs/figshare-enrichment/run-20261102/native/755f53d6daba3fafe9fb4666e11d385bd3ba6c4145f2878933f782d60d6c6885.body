{"files": [{"id": 37855606, "name": "pbio.3001805.g005.tif", "size": 1565404, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/37855606", "supplied_md5": "cd138b58831aa22052429d3301d16dbf", "computed_md5": "cd138b58831aa22052429d3301d16dbf", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 13955914, "full_name": "Jaewon Song", "first_name": "Jaewon", "last_name": "Song", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10319219, "full_name": "Ryan D. Chow", "first_name": "Ryan D.", "last_name": "Chow", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14009135, "full_name": "Mario A. Pe\u00f1a-Hern\u00e1ndez", "first_name": "Mario A.", "last_name": "Pe\u00f1a-Hern\u00e1ndez", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8200, "full_name": "Li Zhang", "first_name": "Li", "last_name": "Zhang", "is_active": false, "url_name": "Li_Zhang", "orcid_id": ""}, {"id": 13955920, "full_name": "Skylar A. Loeb", "first_name": "Skylar A.", "last_name": "Loeb", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 13955923, "full_name": "Eui-Young So", "first_name": "Eui-Young", "last_name": "So", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 13955926, "full_name": "Olin D. Liang", "first_name": "Olin D.", "last_name": "Liang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 129621, "full_name": "Ping Ren", "first_name": "Ping", "last_name": "Ren", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 127044, "full_name": "Sidi Chen", "first_name": "Sidi", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8677404, "full_name": "Craig B. Wilen", "first_name": "Craig B.", "last_name": "Wilen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 179163, "full_name": "Sanghyun Lee", "first_name": "Sanghyun", "last_name": "Lee", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/LRRC15_expression_is_enriched_in_the_fibroblasts_of_COVID-19_patients_and_associated_with_reduced_SARS-CoV-2_viral_burden_/21330298", "download_disabled": false, "description": "<p>(<b>A</b>, <b>B</b>) Cell type\u2013specific expression of <i>ACE2</i> and <i>LRRC15</i>, assessed by scRNA-seq of lungs from deceased COVID-19 patients (<b>A</b>) Delorey and colleagues [<a href=\"http://www.plosbiology.org/article/info:doi/10.1371/journal.pbio.3001805#pbio.3001805.ref044\" target=\"_blank\">44</a>] or (<b>B</b>) Melms and colleagues [<a href=\"http://www.plosbiology.org/article/info:doi/10.1371/journal.pbio.3001805#pbio.3001805.ref043\" target=\"_blank\">43</a>]. (<b>C</b>) Tukey boxplots (IQR boxes with 1.5 \u00d7 IQR whiskers) of the relative frequencies of fibroblast subtypes among total fibroblasts, comparing COVID-19 patients (blue) to non-COVID-19 controls (red). Statistical significance was assessed by two-tailed unpaired Mann\u2013Whitney test. (<b>D</b>) Volcano plot of differentially expressed genes in the lungs of deceased COVID-19 patients, comparing samples with high vs. low SARS-CoV-2 RNA levels at the time of death [<a href=\"http://www.plosbiology.org/article/info:doi/10.1371/journal.pbio.3001805#pbio.3001805.ref046\" target=\"_blank\">46</a>]. Genes with positive log<sub>2</sub> fold changes are associated with high viral burden, while genes with negative log<sub>2</sub> fold changes are associated with low viral burden. (<b>E</b>) <i>LRRC15</i> expression in lung cell lines (A549, A549-ACE2, Calu-3), comparing mock controls vs. SARS-CoV-2-infected samples. Data represent means \u00b1 SEM. Statistical significance was assessed by two-tailed unpaired Welch\u2019s <i>t</i> test. For underlying data, see <b><a href=\"http://www.plosbiology.org/article/info:doi/10.1371/journal.pbio.3001805#pbio.3001805.s002\" target=\"_blank\">S2 Data</a></b>. ACE2, angiotensin-converting enzyme 2; COVID-19, Coronavirus Disease 2019; IQR, interquartile range; LRRC15, leucin-rich repeat-containing 15; SARS-CoV-2, Severe Acute Respiratory Syndrome Coronavirus 2; scRNA-seq, single-cell RNA-sequencing.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1565404, "created_date": "2022-10-13T18:04:52Z", "modified_date": "2023-06-13T06:56:16Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["inhibitory attachment factor", "div >< p", "although attachment factors", "regulates viral entry", "coreceptors facilitating entry", "lrrc15 directly binds", "identified human lrrc15", "converting enzyme 2", "human lung single", "2 cellular entry", "mediated viral entry", "entry receptor angiotensin", "lrrc15 inhibits sars", "2 entry", "mediated entry", "inhibits spike", "lrrc15 represents", "lrrc15 </", "trans </", "surface </", "spike protein", "protective role", "primarily detected", "physiological context", "particularly enriched", "moderate affinity", "largely unknown", "extensively studied", "binding domain", ">, suggesting", "19 patients"], "keywords": ["inhibitory attachment factor", "div >< p", "although attachment factors", "regulates viral entry", "coreceptors facilitating entry", "lrrc15 directly binds", "identified human lrrc15", "converting enzyme 2", "human lung single", "2 cellular entry", "mediated viral entry", "entry receptor angiotensin", "lrrc15 inhibits sars", "2 entry", "mediated entry", "inhibits spike", "lrrc15 represents", "lrrc15 </", "trans </", "surface </", "spike protein", "protective role", "primarily detected", "physiological context", "particularly enriched", "moderate affinity", "largely unknown", "extensively studied", "binding domain", ">, suggesting", "19 patients"], "categories": [{"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id