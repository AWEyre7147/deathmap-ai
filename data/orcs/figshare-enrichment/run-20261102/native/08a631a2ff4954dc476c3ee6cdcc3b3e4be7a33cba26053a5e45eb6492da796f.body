{"files": [{"id": 40000025, "name": "21598290cd190117-sup-216243_2_supp_5484298_pqktn1.xlsx", "size": 43637, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/40000025", "supplied_md5": "82080faa74025a06b9e7f8fae5ca4e20", "computed_md5": "82080faa74025a06b9e7f8fae5ca4e20", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"}], "folder_structure": {}, "authors": [{"id": 499602, "full_name": "Xufeng Chen", "first_name": "Xufeng", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15112904, "full_name": "Christina Glytsou", "first_name": "Christina", "last_name": "Glytsou", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-6260-338X"}, {"id": 50017, "full_name": "Hua Zhou", "first_name": "Hua", "last_name": "Zhou", "is_active": false, "url_name": "Hua_Zhou", "orcid_id": ""}, {"id": 14946148, "full_name": "Sonali Narang", "first_name": "Sonali", "last_name": "Narang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15112907, "full_name": "Denis E. Reyna", "first_name": "Denis E.", "last_name": "Reyna", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 781284, "full_name": "Andrea Lopez", "first_name": "Andrea", "last_name": "Lopez", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15112910, "full_name": "Theodore Sakellaropoulos", "first_name": "Theodore", "last_name": "Sakellaropoulos", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-9946-9498"}, {"id": 4069660, "full_name": "Yixiao Gong", "first_name": "Yixiao", "last_name": "Gong", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8824268, "full_name": "Andreas Kloetgen", "first_name": "Andreas", "last_name": "Kloetgen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15112913, "full_name": "Yoon Sing Yap", "first_name": "Yoon Sing", "last_name": "Yap", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 30587, "full_name": "Eric Wang", "first_name": "Eric", "last_name": "Wang", "is_active": false, "url_name": "Eric_Wang", "orcid_id": ""}, {"id": 15096242, "full_name": "Evripidis Gavathiotis", "first_name": "Evripidis", "last_name": "Gavathiotis", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-6319-8331"}, {"id": 14946172, "full_name": "Aristotelis Tsirigos", "first_name": "Aristotelis", "last_name": "Tsirigos", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-7512-8477"}, {"id": 771250, "full_name": "Raoul Tibes", "first_name": "Raoul", "last_name": "Tibes", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10272, "full_name": "Iannis Aifantis", "first_name": "Iannis", "last_name": "Aifantis", "is_active": false, "url_name": "Iannis_Aifantis", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "The BCL2 family plays important roles in acute myeloid leukemia (AML). Venetoclax, a selective BCL2 inhibitor, has received FDA approval for the treatment of AML. However, drug resistance ensues after prolonged treatment, highlighting the need for a greater understanding of the underlying mechanisms. Using a genome-wide CRISPR/Cas9 screen in human AML, we identified genes whose inactivation sensitizes AML blasts to venetoclax. Genes involved in mitochondrial organization and function were significantly depleted throughout our screen, including the mitochondrial chaperonin CLPB. We demonstrated that CLPB is upregulated in human AML, it is further induced upon acquisition of venetoclax resistance, and its ablation sensitizes AML to venetoclax. Mechanistically, CLPB maintains the mitochondrial cristae structure via its interaction with the cristae-shaping protein OPA1, whereas its loss promotes apoptosis by inducing cristae remodeling and mitochondrial stress responses. Overall, our data suggest that targeting mitochondrial architecture may provide a promising approach to circumvent venetoclax resistance.\nA genome-wide CRISPR/Cas9 screen reveals genes involved in mitochondrial biological processes participate in the acquisition of venetoclax resistance. Loss of the mitochondrial protein CLPB leads to structural and functional defects of mitochondria, hence sensitizing AML cells to apoptosis. Targeting CLPB synergizes with venetoclax and the venetoclax/azacitidine combination in AML in a p53-independent manner.See related commentary by Savona and Rathmell, p. 831.This article is highlighted in the In This Issue feature, p. 813", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/dataset/Supplementary_Table_3_from_Targeting_Mitochondrial_Structure_Sensitizes_Acute_Myeloid_Leukemia_to_Venetoclax_Treatment/22536734", "download_disabled": false, "description": "<p>Relative quantification of metabolites in the hybrid panel in CLPB knockout MOLM-13</p>", "funding": "NIH", "funding_list": [{"id": 29591, "title": "NIH", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 335318, "title": "NCI", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23223854, "title": "NYU", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23226035, "title": "NYSTEM", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 61334, "title": "Leukemia and Lymphoma Society", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 22722314, "title": "New York State Department of Health", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 43637, "created_date": "2023-04-03T22:46:56Z", "modified_date": "2024-03-04T08:40:13Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": [