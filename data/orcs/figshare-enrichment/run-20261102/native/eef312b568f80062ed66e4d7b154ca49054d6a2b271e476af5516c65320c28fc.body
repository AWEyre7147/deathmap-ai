{"files": [{"id": 37855597, "name": "pbio.3001805.g002.tif", "size": 1669116, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/37855597", "supplied_md5": "013123a65e97a14c74ff0783103b495a", "computed_md5": "013123a65e97a14c74ff0783103b495a", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 13955914, "full_name": "Jaewon Song", "first_name": "Jaewon", "last_name": "Song", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10319219, "full_name": "Ryan D. Chow", "first_name": "Ryan D.", "last_name": "Chow", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14009135, "full_name": "Mario A. Pe\u00f1a-Hern\u00e1ndez", "first_name": "Mario A.", "last_name": "Pe\u00f1a-Hern\u00e1ndez", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8200, "full_name": "Li Zhang", "first_name": "Li", "last_name": "Zhang", "is_active": false, "url_name": "Li_Zhang", "orcid_id": ""}, {"id": 13955920, "full_name": "Skylar A. Loeb", "first_name": "Skylar A.", "last_name": "Loeb", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 13955923, "full_name": "Eui-Young So", "first_name": "Eui-Young", "last_name": "So", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 13955926, "full_name": "Olin D. Liang", "first_name": "Olin D.", "last_name": "Liang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 129621, "full_name": "Ping Ren", "first_name": "Ping", "last_name": "Ren", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 127044, "full_name": "Sidi Chen", "first_name": "Sidi", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8677404, "full_name": "Craig B. Wilen", "first_name": "Craig B.", "last_name": "Wilen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 179163, "full_name": "Sanghyun Lee", "first_name": "Sanghyun", "last_name": "Lee", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/LRRC15_binds_with_SARS-CoV-2_spike_protein_at_the_RBD_/21330289", "download_disabled": false, "description": "<p>(<b>A</b>) A375 cells were transduced with indicated activating sgRNAs and incubated with SARS-CoV-2 spike S1-Fc fusion protein. Protein binding was measured by flow cytometry with MFI shown. (<b>B</b>) HeLa cells were transduced with indicated activating sgRNAs and incubated with SARS-CoV-2 spike S1-Fc fusion protein. Protein binding was measured by flow cytometry with MFI shown. (<b>C</b>) Dose-dependent binding of SARS-CoV-2 spike protein (Wuhan-Hu-1) to both ACE2 and LRRC15 with an Fc tag was determined by ELISA. Human IgG1 was included as a negative control. Dots indicate means of duplicates. (<b>D</b>) HeLa cells were transduced with indicated activating sgRNAs and incubated with SARS-CoV-2 spike NTD-Fc or RBD-Fc fusion protein. Protein binding was measured by flow cytometry with MFI shown. (<b>E</b>) The binding of the SARS-CoV-2 RBD and NTD to LRRC15 was measured by ELISA. For underlying data, see <b><a href=\"http://www.plosbiology.org/article/info:doi/10.1371/journal.pbio.3001805#pbio.3001805.s003\" target=\"_blank\">S3 Data</a></b>. ACE2, angiotensin-converting enzyme 2; LRRC15, leucin-rich repeat-containing 15; MFI, mean fluorescence intensity; NTD, N-terminal domain; RBD, receptor-binding domain; SARS-CoV-2, Severe Acute Respiratory Syndrome Coronavirus 2; sgRNA, single guide RNA.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1669116, "created_date": "2022-10-13T18:04:48Z", "modified_date": "2023-06-13T06:56:23Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["inhibitory attachment factor", "div >< p", "although attachment factors", "regulates viral entry", "coreceptors fac