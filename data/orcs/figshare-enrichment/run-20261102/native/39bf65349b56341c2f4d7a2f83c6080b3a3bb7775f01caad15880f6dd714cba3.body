{"files": [{"id": 38660709, "name": "ppat.1010800.g002.tif", "size": 1890220, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/38660709", "supplied_md5": "db06d62acc032431f9a64557afe728fe", "computed_md5": "db06d62acc032431f9a64557afe728fe", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 14305263, "full_name": "Alejandro Mat\u00eda", "first_name": "Alejandro", "last_name": "Mat\u00eda", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14305266, "full_name": "Maria M. Lorenzo", "first_name": "Maria M.", "last_name": "Lorenzo", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14305269, "full_name": "Yolimar C. Romero-Estremera", "first_name": "Yolimar C.", "last_name": "Romero-Estremera", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14305272, "full_name": "Juana M. S\u00e1nchez-Puig", "first_name": "Juana M.", "last_name": "S\u00e1nchez-Puig", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14223767, "full_name": "Angel Zaballos", "first_name": "Angel", "last_name": "Zaballos", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 468443, "full_name": "Rafael Blasco", "first_name": "Rafael", "last_name": "Blasco", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/Hit_identification_/21784656", "download_disabled": false, "description": "<p>A) Example of results obtained in one screen experiment (1_1) analyzed with MaGeCK. Hits with FDR < 0.05 are labelled with gene name tags. B) Heatmap summarizing the 27 experiments/experiment variations. Experiments are named with the starting cell pool followed by a number for the conditions used for that particular sample (see <a href=\"http://www.plospathogens.org/article/info:doi/10.1371/journal.ppat.1010800#ppat.1010800.s009\" target=\"_blank\">S1 Table</a>). Genes with FDR < 0.05 in at least 1 experiment are included in the analysis. Enrichment results after selection are shown in the left panel as a heatmap representing the gene rank obtained with MaGeCK. For comparison, the right panel shows the log2-fold change for each gene in non-infected control experiment. Dots to the right of the red dotted line indicate enrichment in non-infected cultures for that particular gene inactivation. For instance, CMIP KOs are depleted from the pool during passages in the absence of infection, whereas CSK KOs are enriched.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1890220, "created_date": "2022-12-27T18:42:31Z", "modified_date": "2023-06-15T00:34:11Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["wide genetic screens", "therefore cell survival", "screening top hits", "provide complete resistance", "consistently found \u03b2", "single gene knock", "significant gene hits", "early gene expression", "find genes necessary", "absolute infection blockage", "thus allow cells", "downstream related pathways", "div >< p", "vaccinia virus infection", "vaccinia virus", "b2m gene", "identify genes", "genes belonging", "survive infection", "virus internalization", "virus entry", "virus binding", "surviving cells", "significantly diminished", "results point", "relevant factor", "reduced probability", "proteins known", "powerful tools", "novel finding", "host factors", "host factor", "2 microglobulin", "&# 946"], "keywords": ["wide genetic screens", "therefore cell survival", "screening top hits", "provide complete resistance", "consistently found \u03b2", "single gene knock", "significant gene hits", "early gene expression", "find genes necessary", "absolute infection blockage", "thus allow cells", "downstream related pathways", "div >< p", "vaccinia virus infection", "vaccinia virus", "b2m gen