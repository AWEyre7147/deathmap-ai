{"files": [{"id": 47099659, "name": "ppat.1011970.g002.tif", "size": 1138496, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/47099659", "supplied_md5": "d7139525edda0f25e8e829106f921e0b", "computed_md5": "d7139525edda0f25e8e829106f921e0b", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 4308, "full_name": "Yan Chen", "first_name": "Yan", "last_name": "Chen", "is_active": false, "url_name": "Yan_Chen", "orcid_id": ""}, {"id": 18841048, "full_name": "Rodney P. Kincaid", "first_name": "Rodney P.", "last_name": "Kincaid", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 18841051, "full_name": "Kelley Bastin", "first_name": "Kelley", "last_name": "Bastin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 18841054, "full_name": "Devin N. Fachko", "first_name": "Devin N.", "last_name": "Fachko", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 18841057, "full_name": "Rebecca L. Skalsky", "first_name": "Rebecca L.", "last_name": "Skalsky", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/Depletion_of_miR-142_enhances_EBV_lytic_gene_products_/26051926", "download_disabled": false, "description": "<p>A. and B. Immunoblot analysis of EBV viral proteins in Neg3 (C4 or C2 single clones) or miR-142 mutant (10024.C19 or 10033.C23 single clones) BL cells following anti-IgM treatment for 0, 24 or 48 hrs. Beta-actin levels are shown as loading controls. Shown is the representative of three independent experiments. C. and. D. EBV viral gene expression in control (Neg3) or miR-142 mutant cells (10024.C19 or 10033.C23) following anti-IgM treatment for 0, 24 or 48 hrs. Lytic gene expression was determined by qRT-PCR. Values are normalized to GAPDH and shown relative to Neg3 control cells treated with anti-IgM for 48 hrs. Shown is the average of three independent experiments. Student\u2019s t-test, *p<0.05. E. and F. Validation of miR -142 knockdown in miR-142 mutant cells. Taqman qRT-PCR was performed for miR-142-3p or 5p expression in total RNA samples from panels C. and D. Values are normalized to miR-16 and shown relative to Neg3 control cells at 0 hr. Shown is the average of three independent experiments. Student\u2019s t-test, *p<0.05. G. Cell-associated EBV DNA levels in mock or anti-IgM treated cells. Viral DNA copies were measured by qPCR using primers to LMP1. Shown is the average of six replicates with standard deviations. Student\u2019s t-test, *p<0.05. H. and I. EBV DNA in the supernatants of cells treated with anti-IgM. Viral DNA copies were measured by qPCR as in G. and are reported as EBV DNA copies per mL of supernatant. Shown is the average of six replicates with standard deviations. Student\u2019s t-test, *p<0.05.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1138496, "created_date": "2024-06-17T17:37:26Z", "modified_date": "2024-06-28T17:35:36Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["b cell receptor", "surface ig cross", "xlink \"> reactivation", "142 targets related", "142 enhanced levels", "restricts ebv entry", "support viral infection", "infected bl cells", "cells using anti", "ebv lytic phase", "erk signaling initiated", "ebv reactivation", "mapk signaling", "lytic stage", "ig antibodies", "induce reactivation", "ebv latency", "taken together", "significant role", "results show", "latency plays", "key regulator", "immediate early", "grna library", "genetic ablation", "gain insight", "fully understood", "effects could", "dabrafenib ).", "clip experiments", "burkitt lymphoma", "based screen", "barr virus"], "keywords": ["b cell receptor", "surface ig cross", "xlink \"> reactivation", "142 targets related", "142 enhanced l