{"files": [{"id": 39876394, "name": "can-21-0373_supplementary_methods_supps2.docx", "size": 37681, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39876394", "supplied_md5": "363e36eeaf2ab114eeb8e8da4f112b36", "computed_md5": "363e36eeaf2ab114eeb8e8da4f112b36", "mimetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}], "folder_structure": {}, "authors": [{"id": 11813688, "full_name": "Henry Beetham", "first_name": "Henry", "last_name": "Beetham", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14952886, "full_name": "Billie G.C. Griffith", "first_name": "Billie G.C.", "last_name": "Griffith", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14952889, "full_name": "Olga Murina", "first_name": "Olga", "last_name": "Murina", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14952892, "full_name": "Alexander E.P. Loftus", "first_name": "Alexander E.P.", "last_name": "Loftus", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-0013-1532"}, {"id": 14952895, "full_name": "David A. Parry", "first_name": "David A.", "last_name": "Parry", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0376-7736"}, {"id": 4872862, "full_name": "Carolin Temps", "first_name": "Carolin", "last_name": "Temps", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 12106395, "full_name": "Jayne Culley", "first_name": "Jayne", "last_name": "Culley", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14950125, "full_name": "Morwenna Muir", "first_name": "Morwenna", "last_name": "Muir", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-5835-3886"}, {"id": 14950146, "full_name": "Asier Unciti-Broceta", "first_name": "Asier", "last_name": "Unciti-Broceta", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-1029-2855"}, {"id": 14952898, "full_name": "Andrew H. Sims", "first_name": "Andrew H.", "last_name": "Sims", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-9082-3665"}, {"id": 14952901, "full_name": "Adam Byron", "first_name": "Adam", "last_name": "Byron", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-5939-9883"}, {"id": 14950143, "full_name": "Valerie G. Brunton", "first_name": "Valerie G.", "last_name": "Brunton", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-7778-8794"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "SRC is a nonreceptor tyrosine kinase with key roles in breast cancer development and progression. Despite this, SRC tyrosine kinase inhibitors have so far failed to live up to their promise in clinical trials, with poor overall response rates. We aimed to identify possible synergistic gene\u2013drug interactions to discover new rational combination therapies for SRC inhibitors. An unbiased genome-wide CRISPR-Cas9 knockout screen in a model of triple-negative breast cancer revealed that loss of integrin-linked kinase (ILK) and its binding partners \u03b1-Parvin and PINCH-1 sensitizes cells to bosutinib, a clinically approved SRC/ABL kinase inhibitor. Sensitivity to bosutinib did not correlate with ABL dependency; instead, bosutinib likely induces these effects by acting as a SRC tyrosine kinase inhibitor. Furthermore, in vitro and in vivo models showed that loss of ILK enhanced sensitivity to eCF506, a novel and highly selective inhibitor of SRC with a unique mode of action. Whole-genome RNA sequencing following bosutinib treatment in ILK knockout cells identified broad changes in the expression of genes regulating cell adhesion and cell\u2013extracellular matrix. Increased sensitivity to SRC inhibition in ILK knockout cells was associated with defective adhesion, resulting in reduced cell number as well as increased G1 arrest and apoptosis. These findings support the potential of ILK loss as an exploitable therapeutic vulnerability in breast cancer, enhancing the effectiveness of clinical SRC inhibitors.\nA CRISPR-Cas9 screen reveals that loss of integrin-linked kinase synergizes with SRC inhibition, providing a new opportunity for enhancing the clinical effectiveness of SRC inhibitors in breast cancer.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Data_from_Loss_of_Integrin-Linked_Kinase_Sensitizes_Breast_Cancer_to_SRC_Inhibitors/22430062", "download_disabled": false, "description": "Supplementary Data from Loss of Integrin-Linked Kinase Sensitizes Breast Cancer to SRC Inhibitors", "funding": "Breast Cancer Now", "funding_list": [{"id": 59336, "title": "Breast Cancer Now", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 74165, "title": "UK Medical Research Council", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23228767, "title": "Human Genetics Unit", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 52436, "title": "Cancer Research UK", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 37681, "created_date": "2023-03-31T04:43:30Z", "modified_date": "2025-11-24T22:23:16Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Breast Cancer", "Carcinogenesis", "Tumor initiation and promotion", "Drug Targets", "Protein kinase & phosphatase drug targets", "Genome Biology", "Functional genomics", "Progression, Invasion & Metastasis", "Cell adhesion and extracellular matrix", "Small Molecule Agents", "Kinase inhibitors"], "keywords": ["Breast Cancer", "Carcinogenesis", "Tumor initiation and promotion", "Drug Targets", "Protein kinase & phosphatase drug targets", "Genome Biology", "Functional genomics", "Progression, Invasion & Metastasis", "Cell adhesion and extracellular matrix", "Small Molecule Agents", "Kinase inhibitors"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37348, "title": "Cancer Biology", "parent_id": 0, "path": "/37348", "source_id": "", "taxonomy_id": 106}, {"id": 37351, "title": "Tumor Biology", "parent_id": 0, "path": "/37351", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/0008-5472.CAN-21-0373"], "has_linked_file": false, "citation": "Beetham, Henry; Griffith, Billie G.C.; Murina, Olga; Loftus, Alexander E.P.; Parry, David A.; Temps, Carolin; et al. (2022). Supplementary Data from Loss of Integrin-Linked Kinase Sensitizes Breast Cancer to SRC Inhibitors. American Association for Cancer Research. Journal contribution. https://doi.org/10.1158/0008-5472.22430062.v1", "related_materials": [{"id": 244487747, "identifier": "10.1158/0008-5472.CAN-21-0373", "title": "Loss of Integrin-Linked Kinase Sensitizes Breast Cancer to SRC Inhibitors", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/0008-5472.CAN-21-0373"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22430062, "title": "Supplementary Data from Loss of Integrin-Linked Kinase Sensitizes Breast Cancer to SRC Inhibitors", "doi": "10.1158/0008-5472.22430062.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/22430062", "published_date": "2023-03-31T04:43:30Z", "thumb": "https://s3-eu-west-1.amazonaws.com/figshare-production-eu-aacr-previews2426-eu-west-1/39876394/thu