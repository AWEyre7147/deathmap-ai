{"files": [{"id": 60748958, "name": "mct-24-0861_supplementary_table_s2_suppst2.pdf", "size": 264332, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/60748958", "supplied_md5": "0ec16cfb5075458c7e14326d5a7f953d", "computed_md5": "0ec16cfb5075458c7e14326d5a7f953d", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 22939559, "full_name": "Ujas A. Patel", "first_name": "Ujas A.", "last_name": "Patel", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-7870-8776"}, {"id": 22939562, "full_name": "Mary Y. Shi", "first_name": "Mary Y.", "last_name": "Shi", "is_active": false, "url_name": "_", "orcid_id": "0009-0007-2311-7622"}, {"id": 22939565, "full_name": "Jalal M. Kazan", "first_name": "Jalal M.", "last_name": "Kazan", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-7310-704X"}, {"id": 15039186, "full_name": "Kevin C.J. Nixon", "first_name": "Kevin C.J.", "last_name": "Nixon", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3645-1159"}, {"id": 22939568, "full_name": "Xiaozhuo Ran", "first_name": "Xiaozhuo", "last_name": "Ran", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-6154-1172"}, {"id": 22939571, "full_name": "Sree N. Nair", "first_name": "Sree N.", "last_name": "Nair", "is_active": false, "url_name": "_", "orcid_id": "0009-0001-8434-2651"}, {"id": 22939574, "full_name": "Olivia Huang", "first_name": "Olivia", "last_name": "Huang", "is_active": false, "url_name": "_", "orcid_id": "0009-0003-6088-7555"}, {"id": 22939577, "full_name": "Lifang Song", "first_name": "Lifang", "last_name": "Song", "is_active": false, "url_name": "_", "orcid_id": "0009-0000-0907-8494"}, {"id": 22939580, "full_name": "Mansi K. Aparnathi", "first_name": "Mansi K.", "last_name": "Aparnathi", "is_active": false, "url_name": "_", "orcid_id": "0009-0009-2914-6509"}, {"id": 15035585, "full_name": "Michael Y. He", "first_name": "Michael Y.", "last_name": "He", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2235-2758"}, {"id": 22939583, "full_name": "Mehran Bakhtiari", "first_name": "Mehran", "last_name": "Bakhtiari", "is_active": false, "url_name": "_", "orcid_id": "0009-0006-6604-5780"}, {"id": 22939586, "full_name": "Rehna Krishnan", "first_name": "Rehna", "last_name": "Krishnan", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-9298-1392"}, {"id": 22939589, "full_name": "Razan K. Hessenow", "first_name": "Razan K.", "last_name": "Hessenow", "is_active": false, "url_name": "_", "orcid_id": "0009-0002-1488-8103"}, {"id": 22939592, "full_name": "Vivek Philip", "first_name": "Vivek", "last_name": "Philip", "is_active": false, "url_name": "_", "orcid_id": "0009-0000-3554-0224"}, {"id": 22939595, "full_name": "Troy Ketela", "first_name": "Troy", "last_name": "Ketela", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4732-6553"}, {"id": 15048777, "full_name": "Verena Jendrossek", "first_name": "Verena", "last_name": "Jendrossek", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-1058-2107"}, {"id": 22939598, "full_name": "Razqallah Hakem", "first_name": "Razqallah", "last_name": "Hakem", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-5948-7931"}, {"id": 14960919, "full_name": "Housheng H. He", "first_name": "Housheng H.", "last_name": "He", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2898-3363"}, {"id": 15035597, "full_name": "Robert Kridel", "first_name": "Robert", "last_name": "Kridel", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0287-7124"}, {"id": 15039207, "full_name": "Benjamin H. Lok", "first_name": "Benjamin H.", "last_name": "Lok", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3675-8847"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Small cell lung cancer (SCLC) is an aggressive malignancy, with most patients presenting with prognostically poor extensive-stage disease. Limited progress in standard care stresses the urgent need for novel therapies. Radiotherapy offers some survival benefit for selected patients with SCLC but could be enhanced with radiosensitizers. In this study, we identify HDAC3 as a novel radiosensitizing target in SCLC using a CRISPR knockout screen and demonstrate its efficacy and mechanism. SBC5 cells were transduced with a custom EpiDrug single-guide RNA library and treated with ionizing radiation (IR) to identify radiosensitizing genes. HDAC3 emerged as a candidate and was validated through genetic knockdown and pharmacologic inhibition (RGFP966) in multiple SCLC cell lines. Both approaches enhanced radiosensitivity, as shown by cell viability (dose modification factor10 = 1.14\u20131.69) and clonogenic assays (dose modification factor10 = 1.16\u20131.41). We assessed changes in chromatin accessibility by assay for transposase-accessible chromatin using sequencing and IR-induced DNA damage and repair using \u03b3H2AX foci detection, double-strand break (DSB) repair assays, and immunoblotting of repair proteins. HDAC3-deficient cells exhibited increased chromatin accessibility, greater IR-induced DSBs, and impaired repair capacity, resulting in persistent DNA damage. This repair defect sensitized cells to PARP inhibitors, for which combining RGFP966 with olaparib or talazoparib produced additive to synergistic effects. In SCLC xenograft models, HDAC3 knockdown or RGFP966, combined with IR, achieved significant tumor growth inhibition. Collectively, we identified HDAC3 as a novel radiosensitizing target in SCLC. Its functional loss increased the generation and persistence of IR-induced DNA DSBs, effectively sensitizing SCLC cell lines and xenografts to IR, providing a potential radiosensitization strategy to treat SCLC.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Table_S2_from_CRISPR_Screen_Identifies_HDAC3_as_a_Novel_Radiosensitizing_Target_in_Small_Cell_Lung_Cancer/30986273", "download_disabled": false, "description": "<p>shRNA sequences that were used to generate HDAC3 KD and the non-targeting control.</p>", "funding": "Terry Fox Research Institute (TFRI)", "funding_list": [{"id": 23238150, "title": "Terry Fox Research Institute (TFRI)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 13616591, "title": "Canada Foundation for Innovation (CFI)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23230056, "title": "Cancer Research Society (CRS)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 69728, "title": "Canadian Institutes of Health Research (CIHR)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 6977159, "title": "National Cancer Institute (NCI)", "grant_code": "814047", "funder_name": "United States Department of Health and Human Services", "is_user_defined": 0, "url": "https://app.dimensions.ai/details/grant/grant.7584078"}, {"id": 29292596, "title": "Clinical and Translational Science Center, Weill Cornell Medicine (CTSC)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 57779, "title": "Deutsche Forschungsgemeinschaft (DFG)", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 264332, "created_date": "2026-01-02T08:24:28Z", "modified_date": "2026-01-02T08:24:28Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Dna Damage And Repair", "Drug Mechanisms", "Modulation of DNA repair", "Epigenetics", "Chromatin structure and function", "Histone Modification", "Lung Cancer", "Preclinical Models", "Radiation Oncology", "Radioprotectors and radiosensitizers", "Radiobiology", "Radiation-induced DNA damage"], "keywords": ["Dna Damage And Repair", "Drug Mechanisms", "Modulation of DNA repair", "Epigenetics", "Chromatin structure and function", "Histone Modification", "Lung Cancer", "Preclinical Models", "Radiation Oncology", "Radioprotectors and radiosensitizers", "Radiobiology", "Radiation-induced DNA damage"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37342, "title": "Cancer Risk Factors", "parent_id": 0, "path": "/37342", "source_id": "", "taxonomy_id": 106}, {"id": 37348, "title": "Cancer Biology", "parent_id": 0, "path": "/37348", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}, {"id": 37375, "title": "Methods and Technology", "parent_id": 0, "path": "/37375", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/1535-7163.MCT-24-0861"], "has_linked_file": false, "citation": "Patel, Ujas A.; Shi, Mary Y.; Kazan, Jalal M.; Nixon, Kevin C.J.; Ran, Xiaozhuo; Nair, Sree N.; et al. (2026). Supplementary Table S2 from CRISPR Screen Identifies HDAC3 as a Novel Radiosensitizing Target in Small Cell Lung Cancer. American Association for Cancer Research. Journal contribution. https://doi.org/10.1158/1535-7163.30986273", "related_materials": [{"id": 251157743, "identifier": "10.1158/1535-7163.MCT-24-0861", "title": "CRISPR Screen Identifies HDAC3 as a Novel Radiosensitizing Target in Small Cell Lung Cancer", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/1535-7163.MCT-24-0861"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 30986273, "title": "