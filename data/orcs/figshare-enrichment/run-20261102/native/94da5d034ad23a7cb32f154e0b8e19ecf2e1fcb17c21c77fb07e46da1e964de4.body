{"files": [{"id": 65674534, "name": "can-22-2245_table_s2_suppst2.xlsx", "size": 3798371, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/65674534", "supplied_md5": "bc6efb6db6c21afda5303249e8241ff0", "computed_md5": "bc6efb6db6c21afda5303249e8241ff0", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"}], "folder_structure": {}, "authors": [{"id": 14963387, "full_name": "Kimberly R. Hagel", "first_name": "Kimberly R.", "last_name": "Hagel", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-1845-8699"}, {"id": 14963390, "full_name": "Rand Arafeh", "first_name": "Rand", "last_name": "Arafeh", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-7107-2982"}, {"id": 14963393, "full_name": "Sydney Gang", "first_name": "Sydney", "last_name": "Gang", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0410-7262"}, {"id": 14963396, "full_name": "Taylor E. Arnoff", "first_name": "Taylor E.", "last_name": "Arnoff", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-7181-9417"}, {"id": 14963399, "full_name": "Rebecca C. Larson", "first_name": "Rebecca C.", "last_name": "Larson", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0174-061X"}, {"id": 14963402, "full_name": "John G. Doench", "first_name": "John G.", "last_name": "Doench", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3707-9889"}, {"id": 14963405, "full_name": "Nathan D. Mathewson", "first_name": "Nathan D.", "last_name": "Mathewson", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-8895-2609"}, {"id": 14963408, "full_name": "Kai W. Wucherpfennig", "first_name": "Kai W.", "last_name": "Wucherpfennig", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-1829-302X"}, {"id": 14963411, "full_name": "Marcela V. Maus", "first_name": "Marcela V.", "last_name": "Maus", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-7578-0393"}, {"id": 14962806, "full_name": "William C. Hahn", "first_name": "William C.", "last_name": "Hahn", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2840-9791"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Chimeric antigen receptor (CAR) T-cell therapy can lead to dramatic clinical responses in B-cell malignancies. However, early clinical trials with CAR T-cell therapy in non\u2013B-cell malignancies have been disappointing to date, suggesting that tumor-intrinsic features contribute to resistance. To investigate tumor-intrinsic modes of resistance, we performed genome scale CRISPR-Cas9 screens in mesothelin (MSLN)-expressing pancreatic cancer cells. Co-culture with MSLN-targeting CAR T cells identified both antigen-dependent and antigen-independent modes of resistance. In particular, loss of the majority of the genes involved in the pathway responsible for GPI-anchor biosynthesis and attachment abrogated the ability of CAR T cells to target pancreatic cancer cells, suggesting that disruption of this pathway may permit MSLN CAR T-cell evasion in the clinic. Antigen-independent mediators of CAR T-cell response included members of the death receptor pathway as well as genes that regulate tumor transcriptional responses, including TFAP4 and INTS12. TFAP4-mediated CAR T resistance depended on the NF\u03baB transcription factor p65, indicating that tumor resistance to CAR T-cell therapy likely involves alterations in tumor-intrinsic states. Overall, this study uncovers multiple antigen-dependent and -independent mechanisms of CAR T-cell evasion by pancreatic cancer, paving the way for overcoming resistance in this disease that is notoriously refractory to immunotherapy.\nThe identification and validation of key determinants of CAR T-cell response in pancreatic cancer provide insights into the landscape of tumor cell intrinsic resistance mechanisms and into approaches to improve therapeutic efficacy.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/dataset/Table_S2_from_Systematic_Interrogation_of_Tumor_Cell_Resistance_to_Chimeric_Antigen_Receptor_T-cell_Therapy_in_Pancreatic_Cancer/32730196", "download_disabled": false, "description": "<p>differential gene expression in HupT3 cells following TFAP4 knockout and overexpression</p>", "funding": "National Cancer Institute (NCI)", "funding_list": [{"id": 6977159, "title": "National Cancer Institute (NCI)", "grant_code": "814047", "funder_name": "United States Department of Health and Human Services", "is_user_defined": 0, "url": "https://app.dimensions.ai/details/grant/grant.7584078"}], "version": 1, "status": "public", "size": 3798371, "created_date": "2026-06-18T12:30:53Z", "modified_date": "2026-06-18T12:30:53Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Gastrointestinal Cancers", "Pancreatic cancer", "Gene Regulation", "Transcription factor function", "Gene Technologies", "High-throughput sequencing", "Genome Biology", "Silencing and reactivation of gene expression", "Immunotherapy", "Biomarkers for immunotherapy", "Engineered/CAR T cells"], "keywords": ["Gastrointestinal Cancers", "Pancreatic cancer", "Gene Regulation", "Transcription factor function", "Gene Technologies", "High-throughput sequencing", "Genome Biology", "Silencing and reactivation of gene expression", "Immunotherapy", "Biomarkers for immunotherapy", "Engineered/CAR T cells"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37363, "title": "Immuno-oncology", "parent_id": 0, "path": "/37363", "source_id": "", "taxonomy_id": 106}, {"id": 37375, "title": "Methods and Technology", "parent_id": 0, "path": "/37375", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/0008-5472.CAN-22-2245"], "has_linked_file": false, "citation": "Hagel, Kimberly R.; Arafeh, Rand; Gang, Sydney; Arnoff, Taylor E.; Larson, Rebecca C.; Doench, John G.; et al. (2023). Table S2 from Systematic Interrogation of Tumor Cell Resistance to Chimeric Antigen Receptor T-cell Therapy in Pancreatic Cancer. American Association for Cancer Research. Dataset. https://doi.org/10.1158/0008-5472.32730196", "related_materials": [{"id": 280479877, "identifier": "10.1158/0008-5472.CAN-22-2245", "title": "Systematic Interrogation of Tumor Cell Resistance to Chimeric Antigen Receptor T-cell Therapy in Pancreatic Cancer", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/0008-5472.CAN-22-2245"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 32730196, "title": "Table S2 from Systematic Interrogation of Tumor Cell Resistance to Chimeric Antigen Receptor T-cell Therapy in Pancreatic Cancer", "doi": "10.1158/0008-5472.32730196", "handle": "", "url": "https://api.figshare.com/v2/articles/32730196", "published_date": "2026-06-18T12:30:53Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": 46225, "url_private_api": "https://api.figshare.com/v2/account/articles/32730196", "url_public_api": "https://api.figshare.com/v2/articles/32730196", "url_private_html": "https://figshare.com/account/articles/32730196", "url_public_html": "https://aacr.figshare.com/articles/dataset/Table_S2_from_Systematic_Interrogation_of_Tumor_Cell_Resistance_to_Chimeric_Antigen_Receptor_T-cell_Therapy_in_Pancreatic_Cancer/32730196", "timeline": {"posted": "2026-06-18T12:30:53", "publisherPublication": "2023-02-15T00:00:0