{"files": [{"id": 25476911, "name": "pgen.1009176.g006.tif", "size": 682476, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/25476911", "supplied_md5": "44f74a099ea6c96cad02958400baae75", "computed_md5": "44f74a099ea6c96cad02958400baae75", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 9592409, "full_name": "Emily M. Schleicher", "first_name": "Emily M.", "last_name": "Schleicher", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592412, "full_name": "Ashna Dhoonmoon", "first_name": "Ashna", "last_name": "Dhoonmoon", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592415, "full_name": "Lindsey M. Jackson", "first_name": "Lindsey M.", "last_name": "Jackson", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592418, "full_name": "Kristen E. Clements", "first_name": "Kristen E.", "last_name": "Clements", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592421, "full_name": "Coryn L. Stump", "first_name": "Coryn L.", "last_name": "Stump", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592424, "full_name": "Claudia M. Nicolae", "first_name": "Claudia M.", "last_name": "Nicolae", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 274443, "full_name": "George-Lucian Moldovan", "first_name": "George-Lucian", "last_name": "Moldovan", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/The_role_of_MED12_in_the_cellular_response_to_ATR_inhibitors_does_not_involve_the_Mediator_complex_/13179176", "download_disabled": false, "description": "<p>(<b>A</b>) Cellular proliferation assay showing that RNASEH2 depletion in HeLa cells results in VE822 sensitivity in both wildtype and MED12-knockdown cells. The average of four experiments is shown, with error bars representing standard deviations. Asterisks indicate statistical significance compared to the control sample, unless otherwise indicated. (<b>B</b>) DNA fiber combing experiment showing that RNASEH2 depletion reduced replication fork speed in both wildtype and MED12-knockdown HeLa cells, upon treatment with 2\u03bcM VE822. The median values are indicated for each sample, and the asterisks indicate statistical significance compared to the control sample, unless otherwise indicated. At least 100 fibers were quantified. (<b>C</b>, <b>D</b>) Unlike MED12 depletion, knockdown of the core Mediator complex subunit MED7 in HeLa cells does not promote ATRi resistance. Cellular proliferation (<b>C</b>) and colony survival (<b>D</b>) experiments are shown. The average of four (<b>C</b>) or three (<b>D</b>) experiments is shown, with error bars representing standard deviations. Asterisks indicate statistical significance compared to the control sample. (<b>E</b>, <b>F</b>) Unlike MED12 depletion, knockdown of CDK8 module subunits MED13, CCNC, or CDK8 in HeLa cells does not promote VE822 resistance. Cellular proliferation (<b>E</b>) and colony survival (<b>F</b>) experiments are shown. The average of three experiments is shown, with error bars representing standard deviations. Asterisks indicate statistical significance compared to the control sample. (<b>G</b>) DNA fiber combing experiment showing that, unlike MED12 depletion, knockdown of MED7, MED13 or CDK8 in HeLa cells does not restore normal fork speed upon treatment with 2\u03bcM VE822. The median values are indicated for each sample, and the asterisks indicate statistical significance compared to the control sample. At least 100 fibers were quantified.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 374388, "created_date": "2020-11-02T18:47:06Z", "modified_date": "2023-06-14T02:28:19Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["replication fork stability", "ATR inhibitors", "genome-wide screen findings", "AZD", "CRISPR activation screens", "MED 12-mediated inhibition", "DNA replication fork progression", "ATR inhibitor-induced apoptosis", "ATR inhibitor resistance", "VE", "Dual genome-wide CRISPR knockout", "TGF", "ATR inhibition", "genome-wide CRISPR knockout", "cell cycle progression", "MCF 10A cells"], "keywords": ["replication fork stability", "ATR inhibitors", "genome-wide screen findings", "AZD", "CRISPR activation screens", "MED 12-mediated inhibition", "DNA replication fork progression", "ATR inhibitor-induced apoptosis", "ATR inhibitor resistance", "VE", "Dual genome-wide CRISPR knockout", "TGF", "ATR inhibition", "genome-wide CRISPR knockout", "cell cycle progression", "MCF 10A cells"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 12, "title": "Cell Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 19, "title": "Pharmacology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 64, "title": "Cancer", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"