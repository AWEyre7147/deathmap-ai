{"files": [{"id": 25476899, "name": "pgen.1009176.g003.tif", "size": 1184216, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/25476899", "supplied_md5": "2ada951081929367b9a2a61522aa8e99", "computed_md5": "2ada951081929367b9a2a61522aa8e99", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 9592409, "full_name": "Emily M. Schleicher", "first_name": "Emily M.", "last_name": "Schleicher", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592412, "full_name": "Ashna Dhoonmoon", "first_name": "Ashna", "last_name": "Dhoonmoon", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592415, "full_name": "Lindsey M. Jackson", "first_name": "Lindsey M.", "last_name": "Jackson", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592418, "full_name": "Kristen E. Clements", "first_name": "Kristen E.", "last_name": "Clements", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592421, "full_name": "Coryn L. Stump", "first_name": "Coryn L.", "last_name": "Stump", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9592424, "full_name": "Claudia M. Nicolae", "first_name": "Claudia M.", "last_name": "Nicolae", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 274443, "full_name": "George-Lucian Moldovan", "first_name": "George-Lucian", "last_name": "Moldovan", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/The_top_seven_common_hits_were_confirmed_to_cause_resistance_to_ATRi_when_depleted_in_three_different_cell_lines_/13179167", "download_disabled": false, "description": "<p>(<b>A</b>) Scatterplot showing the results of the ATRi resistance knockout screens. Each gene targeted by the library was ranked according to P-values calculated using RSA analysis. The P-values are based on the fold change of the guides targeting each gene between the ATRi- and DMSO-treated conditions. There were seven identical hits in the top 40 hits of both ATRi knockout screens. (<b>B</b>) The seven top common hits have diverse biological functions. (<b>C</b>) Knockdown of the top common gene hits in HeLa cells results in resistance to ATRi in a colony survival assay. The average of three experiments is shown, with error bars representing standard deviations. Asterisks indicate statistical significance for each hit compared to control. (<b>D</b>) Knockdown of the top common gene hits in HeLa cells results in resistance to ATRi in a cellular proliferation assay. The average of three experiments is shown, with error bars representing standard deviations. Asterisks indicate statistical significance for each hit compared to control. (<b>E, F</b>) Knockdown of the top common gene hits also results in resistance to ATRi in MCF10A cells (<b>E</b>) and 8988T cells (<b>F</b>) in cellular proliferation assays. The average of three experiments is shown, with error bars representing standard deviations. Asterisks indicate statistical significance for each hit compared to the control. (<b>G</b>) Knockdown of the top common gene hits in 8988T cells results in resistance to ATRi in a colony survival assay. The average of three experiments is shown, with error bars representing standard deviations. Asterisks indicate statistical significance for each hit compared to control.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 624104, "created_date": "2020-11-02T18:47:02Z", "modified_date": "2023-06-14T01:34:13Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["replication fork stability", "ATR inhibitors", "genome-wide screen findings", "AZD", "CRISPR activation screens", "MED 12-mediated inhibition", "DNA replication fork progression", "ATR inhibitor-induced apoptosis", "ATR inhibitor resistance", "VE", "Dual genome-wide CRISPR knockout", "TGF", "ATR inhibition", "genome-wide CRISPR knockout", "cell cycle progression", "MCF 10A cells"], "keywords": ["replication fork stability", "ATR inhibitors", "genome-wide screen findings", "AZD", "CRISPR activation screens", "MED 12-mediated inhibition", "DNA replication fork progression", "ATR inhibitor-induced apoptosis", "ATR inhibitor resistance", "VE", "Dual genome-wide CRISPR knockout", "TGF", "ATR inhibition", "genome-wide CRISPR knockout", "cell cycle progression", "MCF 10A cells"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 12, "title": "Cell Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 19, "title": "Pharmacology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 64, "title": "Cancer", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 128, "title": "Hematology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 134, "title": "Virology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1