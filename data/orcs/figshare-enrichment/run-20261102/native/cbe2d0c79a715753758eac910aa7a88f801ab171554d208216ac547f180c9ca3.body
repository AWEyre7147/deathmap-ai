{"files": [{"id": 39985342, "name": "mct-21-0841_supplementary_table_2_suppts2.pdf", "size": 12419, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39985342", "supplied_md5": "596111467581694077c5a02cc63e4589", "computed_md5": "596111467581694077c5a02cc63e4589", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 14956988, "full_name": "Huadong Chen", "first_name": "Huadong", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4681-0853"}, {"id": 14957027, "full_name": "Morgan E. Diolaiti", "first_name": "Morgan E.", "last_name": "Diolaiti", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-5900-3060"}, {"id": 14956985, "full_name": "Patrick C. O'Leary", "first_name": "Patrick C.", "last_name": "O'Leary", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2919-5943"}, {"id": 15089785, "full_name": "Ajda Rojc", "first_name": "Ajda", "last_name": "Rojc", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-6183-7109"}, {"id": 14957021, "full_name": "Nevan J. Krogan", "first_name": "Nevan J.", "last_name": "Krogan", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4902-337X"}, {"id": 14957024, "full_name": "Minkyu Kim", "first_name": "Minkyu", "last_name": "Kim", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-9317-1658"}, {"id": 14957030, "full_name": "Alan Ashworth", "first_name": "Alan", "last_name": "Ashworth", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-1446-7878"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Inhibitors directed toward PARP1 and PARP2 are approved agents for the treatment of BRCA1 and BRCA2-related cancers. Other members of the PARP family have also been implicated in cancer and are being assessed as therapeutic targets in cancer and other diseases. Recently, an inhibitor of PARP7 (RBN-2397) has reached early-stage human clinical trials. Here, we performed a genome-wide CRISPR screen for genes that modify the response of cells to RBN-2397. We identify the polycyclic aromatic hydrocarbon receptor AHR and multiple components of the cohesin complex as determinants of resistance to this agent. Activators and inhibitors of AHR modulate the cellular response to PARP7 inhibition, suggesting potential combination therapy approaches.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Table_from_A_Whole-Genome_CRISPR_Screen_Identifies_AHR_Loss_as_a_Mechanism_of_Resistance_to_a_PARP7_Inhibitor/22522591", "download_disabled": false, "description": "Supplementary Table from A Whole-Genome CRISPR Screen Identifies AHR Loss as a Mechanism of Resistance to a PARP7 Inhibitor", "funding": "NIH", "funding_list": [{"id": 29591, "title": "NIH", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 12419, "created_date": "2023-04-03T18:45:39Z", "modified_date": "2025-11-27T12:09:39Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Cell Cycle", "Drug Mechanisms", "Cellular responses to anticancer drugs", "Drug Resistance", "Small Molecule Agents"], "keywords": ["Cell Cycle", "Drug Mechanisms", "Cellular responses to anticancer drugs", "Drug Resistance", "Small Molecule Agents"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/1535-7163.MCT-21-0841"], "has_linked_file": false, "citation": "Chen, Huadong; Diolaiti, Morgan E.; O'Leary, Patrick C.; Rojc, Ajda; Krogan, Nevan J.; Kim, Minkyu; et al. (2022). Supplementary Table from A Whole-Genome CRISPR Screen Identifies AHR Loss as a Mechanism of Resistance to a PARP7 Inhibitor. American Association for Cancer Research. Journal contribution. https://doi.org/10.1158/1535-7163.22522591.v1", "related_materials": [{"id": 245742673, "identifier": "10.1158/1535-7163.MCT-21-0841", "title": "A Whole-Genome CRISPR Screen Identifies AHR Loss as a Mechanism of Resistance to a PARP7 Inhibitor", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/1535-7163.MCT-21-0841"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22522591, "title": "Supplementary Table from A Whole-Genome CRISPR Screen Identifies AHR Loss as a Mechanism of Resistance to a PARP7 Inhibitor", "doi": "10.1158/1535-7163.22522591.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/22522591", "published_date": "2023-04-03T18:45:39Z", "thumb": "https://s3-eu-west-1.amazonaws.com/figshare-production-eu-aacr-previews2426-eu-west-1/39985342/thumb.png", "defined_type": 6, "defined_type_name": "journal contribution", "group_id": 46213, "url_private_api": "https://api.figshare.com/v2/account/articles/22522591", "url_public_api": "https://api.figshare.com/v2/articles/22522591", "url_private_html": "https://figshare.com/account/articles/22522591", "url_public_html": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Table_from_A_Whole-Genome_CRISPR_Screen_Identifies_AHR_Loss_as_a_Mechanism_of_Resistance_to_a_PARP7_Inhibitor/22522591", "timeline": {"posted": "2023-04-03T18:45:39", "publisherPublication": "2022-07-05T00:00:00", "firstOnline": "2023-04-03"}, "resource_title": "A Whole-Genome CRISPR Screen Identifies AHR Loss as a Mechanism of Resistance to a PARP7 Inhibitor", "resource_doi": "10.1158/1535-7163.MCT-21-0841"}