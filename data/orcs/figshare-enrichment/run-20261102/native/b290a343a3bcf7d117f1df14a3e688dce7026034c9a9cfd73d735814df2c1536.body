{"files": [{"id": 59812438, "name": "3962fig3.jpeg", "size": 965692, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/59812438", "supplied_md5": "a77522734cba40ab24ffebdcf827d0ff", "computed_md5": "a77522734cba40ab24ffebdcf827d0ff", "mimetype": "image/jpeg"}], "folder_structure": {}, "authors": [{"id": 14961612, "full_name": "Marta J. Llorca-Cardenosa", "first_name": "Marta J.", "last_name": "Llorca-Cardenosa", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9136-8374"}, {"id": 14961615, "full_name": "Lauren I. Aronson", "first_name": "Lauren I.", "last_name": "Aronson", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-8479-5685"}, {"id": 14961618, "full_name": "Dragomir B. Krastev", "first_name": "Dragomir B.", "last_name": "Krastev", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4298-7272"}, {"id": 14961621, "full_name": "Jadwiga Nieminuszczy", "first_name": "Jadwiga", "last_name": "Nieminuszczy", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4672-9684"}, {"id": 14961624, "full_name": "John Alexander", "first_name": "John", "last_name": "Alexander", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-3973-6501"}, {"id": 14961627, "full_name": "Feifei Song", "first_name": "Feifei", "last_name": "Song", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-8571-3111"}, {"id": 14961630, "full_name": "Malgorzata Dylewska", "first_name": "Malgorzata", "last_name": "Dylewska", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-7446-1705"}, {"id": 14961633, "full_name": "Ronan Broderick", "first_name": "Ronan", "last_name": "Broderick", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-6840-4755"}, {"id": 14961636, "full_name": "Rachel Brough", "first_name": "Rachel", "last_name": "Brough", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-1862-7130"}, {"id": 14961639, "full_name": "Astrid Zimmermann", "first_name": "Astrid", "last_name": "Zimmermann", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-6146-9812"}, {"id": 14961642, "full_name": "Frank T. Zenke", "first_name": "Frank T.", "last_name": "Zenke", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2226-3755"}, {"id": 14961645, "full_name": "Bora Gurel", "first_name": "Bora", "last_name": "Gurel", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-5018-8078"}, {"id": 14961648, "full_name": "Ruth Riisnaes", "first_name": "Ruth", "last_name": "Riisnaes", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-8924-302X"}, {"id": 14961651, "full_name": "Ana Ferreira", "first_name": "Ana", "last_name": "Ferreira", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-7844-2760"}, {"id": 14961654, "full_name": "Theodoros Roumeliotis", "first_name": "Theodoros", "last_name": "Roumeliotis", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3354-5643"}, {"id": 14961657, "full_name": "Jyoti Choudhary", "first_name": "Jyoti", "last_name": "Choudhary", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0881-5477"}, {"id": 14952601, "full_name": "Stephen J. Pettitt", "first_name": "Stephen J.", "last_name": "Pettitt", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-3313-3857"}, {"id": 14961660, "full_name": "Johann de Bono", "first_name": "Johann", "last_name": "de Bono", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2034-595X"}, {"id": 14961663, "full_name": "Andres Cervantes", "first_name": "Andres", "last_name": "Cervantes", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-3806-3691"}, {"id": 14961666, "full_name": "Syed Haider", "first_name": "Syed", "last_name": "Haider", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-6685-5480"}, {"id": 14961669, "full_name": "Wojciech Niedzwiedz", "first_name": "Wojciech", "last_name": "Niedzwiedz", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-8518-6304"}, {"id": 14952616, "full_name": "Christopher J. Lord", "first_name": "Christopher J.", "last_name": "Lord", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3226-0515"}, {"id": 14961672, "full_name": "Irene Y. Chong", "first_name": "Irene Y.", "last_name": "Chong", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-1692-4411"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Gastric cancer represents the third leading cause of global cancer mortality and an area of unmet clinical need. Drugs that target the DNA damage response, including ATR inhibitors (ATRi), have been proposed as novel targeted agents in gastric cancer. Here, we sought to evaluate the efficacy of ATRi in preclinical models of gastric cancer and to understand how ATRi resistance might emerge as a means to identify predictors of ATRi response. A positive selection genome-wide CRISPR-Cas9 screen identified candidate regulators of ATRi resistance in gastric cancer. Loss-of-function mutations in either SMG8 or SMG9 caused ATRi resistance by an SMG1-mediated mechanism. Although ATRi still impaired ATR/CHK1 signaling in SMG8/9-defective cells, other characteristic responses to ATRi exposure were not seen, such as changes in ATM/CHK2, \u03b3H2AX, phospho-RPA, or 53BP1 status or changes in the proportions of cells in S- or G2\u2013M-phases of the cell cycle. Transcription/replication conflicts (TRC) elicited by ATRi exposure are a likely cause of ATRi sensitivity, and SMG8/9-defective cells exhibited a reduced level of ATRi-induced TRCs, which could contribute to ATRi resistance. These observations suggest ATRi elicits antitumor efficacy in gastric cancer but that drug resistance could emerge via alterations in the SMG8/9/1 pathway.\nThese findings reveal how cancer cells acquire resistance to ATRi and identify pathways that could be targeted to enhance the overall effectiveness of these inhibitors.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/figure/Figure_3_from_SMG8_SMG9_Heterodimer_Loss_Modulates_SMG1_Kinase_to_Drive_ATR_Inhibitor_Resistance/30699136", "download_disabled": false, "description": "<p>Silencing of SMG1 resensitizes SMG8 and SMG9 knockout cells to ATR inhibition. <b>A,</b> Left, SMG1 was overexpressed in the SMG8 and SMG9 mutant cells after 48 hours of DMSO or 150 nmol/L berzosertib exposure compared with the WT cells. Right, Smg1 signal intensity relative to \u03b2-actin expression representing relative protein expression using ImageJ. Error bars represent SEM, considering three biological replicates. <b>B</b> and <b>C,</b> SMG1 knockdown experiment (384-well plates) showing an increase in the normalized percent of inhibition in the SMG8 and SMG9 mutant cells (red) compared with the WT cells (blue) following exposure to a range of SMG1 siRNA concentrations (from 1 to 20 nmol/L; negative controls, siCON1, siCON2; positive controls, siATM, siPLK1). <b>D,</b> Western blot analysis showing siSMG1 silencing in the YCC6 WT and SMG8 and SMG9 mutant cells. <b>E\u2013G,</b> Silencing of SMG1 in YCC6 WT, SMG8, and SMG9 mutant cells resensitizes them to ATRi (384-well plate, 5-day assay). siCON2 was used as a negative control. All panels of this figure are representative of three or more biological replicates. ns, nonsignificant.</p>", "funding": "Cancer Research UK (CRUK)", "funding_list": [{"id": 23220128, "title": "Cancer Research UK (CRUK)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 19160942, "title": "Breast Cancer Now (BCN)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 16486853, "title": "Medical Research Council (MRC)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23230020, "title": "Thornton foundation", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23230023, "title": "Syncona Foundation", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 359945, "title": "Instituto de Salud Carlos III (ISCIII)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23230026, "title": "Merck KGaA (Merck)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23230029, "title": "NIHR Biomedical Research Centre, Royal Marsden NHS Foundation Trust/Institute of Cancer Research (BRC)", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 965692, "created_date": "2025-11-24T22:40:25Z", "modified_date": "2025-11-24T22:40:25Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["DNA Damage and Repair", "DNA repair", "Drug Mechanisms", "Drug Resistance", "Gastrointestinal Cancers", "Stomach cancer"], "keywords": ["DNA Damage and Repair", "DNA repair", "Drug Mechanisms", "Drug Resistance", "Gastrointestinal Cancers", "Stomach cancer"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/0008-5472.CAN-21-4339"], "has_linked_file": false, "citation": "Llorca-Cardenosa, Marta J.; Aronson, Lauren I.; Krastev, Dragomir B.; Nieminuszczy, Jadwiga; Alexander, John; Song, Feifei; et al. (2022). Figure 3 from SMG8/SMG9 Heterodimer Loss Modulates SMG1 Kinase to Drive ATR Inhibitor Resistance. American Association for Cancer Research. Figure. https://doi.org/10.1158/0008-5472.30699136", "related_materials": [{"id": 244493542, "identifier": "10.1158/0008-5472.CAN-21-4339", "title": "SMG8/SMG9 Heterodimer Loss Modulates SMG1 Kinase to Drive ATR Inhibitor Resistance", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/0008-5472.CAN-21-4339"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 30699136, "title": "Figure 3 from SMG8/SMG9 Heterodimer Loss Modulates SMG1 Kinase to Drive ATR Inhibitor Resistance", "doi": "10.1158/0008-5472.30699136", "handle": "", "url": "https://api.figshare.com/v2/articles/30699136", "published_date": "2025-11-24T22:40:24Z", "thumb": "https://ndownloader.figshare.com/files/59812438/preview/59812438/thumb.png", "defined_type": 1, "defined_type_name": "figure", "group_id": 46225, "url_private_api": "https://api.figshare.com/v2/account/articles/30699136", "url_public_api": "https://api.figshare.com/v2/articles/30699136", "url_private_html": "https://figshare.com/account/articles/30699136", "url_public_html": "https://aacr.figshare.com/articles/figure/Figure_3_from_SMG8_SMG9_Heterodimer_Loss_Modulates_SMG1_Kinase_to_Drive_ATR_Inhibitor_Resistance/30699136", "timeline": {"posted": "2025-11-24T22:40:24", "publisherPublication": "2022-11-02T00:00:00", "firstOnline": "2025-11-24"}, "resource_title": "SMG8/SMG9 Heterodimer Loss Modulates SMG1 Kinase to Drive ATR Inhibitor Resistance", "resource_doi": "10.1158/0008-5472.CAN-21-4339"}