90"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 17700632, "title": "Top scoring HDFs are components of the autophagy pathway.", "doi": "10.1371/journal.pbio.3001490.g003", "handle": "", "url": "https://api.figshare.com/v2/articles/17700632", "published_date": "2021-12-28T19:35:50Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-plos-725668748/32397845/thumb.png", "defined_type": 1, "defined_type_name": "figure", "group_id": 116, "url_private_api": "https://api.figshare.com/v2/account/articles/17700632", "url_public_api": "https://api.figshare.com/v2/articles/17700632", "url_private_html": "https://figshare.com/account/articles/17700632", "url_public_html": "https://plos.figshare.com/articles/figure/Top_scoring_HDFs_are_components_of_the_autophagy_pathway_/17700632", "timeline": {"posted": "2021-12-28T19:35:50", "publisherPublication": "2021-12-28T21:05:11", "firstOnline": "2021-12-28"}, "resource_title": "A genome-wide CRISPR screen identifies interactors of the autophagy pathway as conserved coronavirus targets", "resource_doi": "10.1371/journal.pbio.3001490"}