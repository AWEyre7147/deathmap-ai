{"files": [{"id": 26230860, "name": "pgen.1009285.g002.tif", "size": 1739720, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/26230860", "supplied_md5": "818f900256cd11086aac2fb9351521b5", "computed_md5": "818f900256cd11086aac2fb9351521b5", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 8356980, "full_name": "Brian T. Emmer", "first_name": "Brian T.", "last_name": "Emmer", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10053054, "full_name": "Emily J. Sherman", "first_name": "Emily J.", "last_name": "Sherman", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8356983, "full_name": "Paul J. Lascuna", "first_name": "Paul J.", "last_name": "Lascuna", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10053057, "full_name": "Sarah E. Graham", "first_name": "Sarah E.", "last_name": "Graham", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 7800014, "full_name": "Cristen J. Willer", "first_name": "Cristen J.", "last_name": "Willer", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 402494, "full_name": "David Ginsburg", "first_name": "David", "last_name": "Ginsburg", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/Targeted_secondary_CRISPR_screens_for_modifiers_of_LDL_uptake_by_HuH7_cells_/13666773", "download_disabled": false, "description": "<p>(A-B) Volcano plots displaying MAGeCK gene level enrichment scores and associated gRNA log2 fold changes for each gene tested in the secondary gRNA library, under lipoprotein-rich (A) or lipoprotein-depleted (B) cultured conditions, with genes identified with FDR<5% displayed in red and positive controls in blue. (C-D) Venn diagrams of genes identified whose targeting was associated with reduced (C) or enhanced (D) cellular LDL uptake under lipoprotein-rich and/or lipoprotein-depleted culture conditions. (E) Genes identified in the primary screen for LDL uptake were stratified by FDR tier and compared for their validation rate (FDR<5%) in the secondary screen for LDL uptake. (F) Correlation of effect size for genes identified as positive regulators of LDL uptake under both lipoprotein-rich and lipoprotein-depleted culture conditions. (G) Average relative ranking of each individual gRNA among the 15 gRNA per gene in lipoprotein-depleted conditions relative to ranking of that same gRNA in lipoprotein-rich conditions. (H) Cumulative distribution function of MAGeCK enrichment scores for genes tested in both the primary and secondary CRISPR screens for LDL uptake. (I) Comparison of MAGeCK gene level enrichment scores for positive control genes in the primary versus secondary CRISPR screens for LDL uptake. (J) QQ plot of LDL GWAS results in UK Biobank within identified LDL uptake regulator genes compared to matched control genes.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1739720, "created_date": "2021-01-29T18:42:57Z", "modified_date": "2023-06-12T04:47:08Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["modifiable risk factor", "LDL uptake Hypercholesterolemia", "gRNA", "LDL uptake modifiers", "HuH 7 cells", "Candidate LDL uptake regulators", "LDL uptake", "genome-scale CRISPR screening", "Genome-scale CRISPR screening", "LDLR"], "keywords": ["modifiable risk factor", "LDL uptake Hypercholesterolemia", "gRNA", "LDL uptake modifiers", "HuH 7 cells", "Candidate LDL uptake regulators", "LDL uptake", "genome-scale CRISPR screening", "Genome-scale CRISPR screening", "LDLR"], "categories": [{"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonom