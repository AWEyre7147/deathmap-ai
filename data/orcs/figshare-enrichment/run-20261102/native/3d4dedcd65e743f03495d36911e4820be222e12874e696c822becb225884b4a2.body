{"files": [{"id": 14816264, "name": "ppat.1007704.g002.tif", "size": 1362124, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816264", "supplied_md5": "0cd14d2a3d2f0c5ad7943f5a47e3b7ec", "computed_md5": "0cd14d2a3d2f0c5ad7943f5a47e3b7ec", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 449259, "full_name": "Shu-Jung Chang", "first_name": "Shu-Jung", "last_name": "Chang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 449595, "full_name": "Sheng Chih Jin", "first_name": "Sheng", "last_name": "Chih Jin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 6560540, "full_name": "Xuyao Jiao", "first_name": "Xuyao", "last_name": "Jiao", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 114934, "full_name": "Jorge E. Gal\u00e1n", "first_name": "Jorge", "last_name": "E. Gal\u00e1n", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/A_genome-wide_CRISPR_Cas9-mediated_gene_inactivation_screen_identifies_genes_essential_for_typhoid_toxin_intoxication_/7960487", "download_disabled": false, "description": "<p>(A) A schematic of the workflow for the screen to identify genes involved in typhoid toxin toxicity. HEK293T cells expressing Cas9 were transduced with a lentiviral library encoding sgRNA targeting human genes as described in Material and Methods. After puromycin selection, cells were split and either mock treated or treated with typhoid toxin. Cells that survived the toxin treatment or that were mock treated were subjected to nucleotide sequence analysis as indicated in Materials and Methods. Sequences were aligned to the reference genome and high-quality reads were analyzed with the MAGeCK algorithm to identify positively-selected genes. (B and C) Scatter plots of effect size (log fold change; x axis) versus <i>P</i> value (-log<sub>10</sub> raw <i>P</i>-value; y-axis) for all genes. Three replicates were performed for each sub-library and the MAGeCK algorithm was used to compare treated with untreated cells across replicates for the human GeCKO v.2 sub-library A and B as described in Material and Methods. Inactivation of the genes colored in red conferred resistance to typhoid toxin with a <i>P</i>-value cutoff corresponding to 15% FDR. (D) Gene ontology term enrichment analysis of genes whose inactivation conferred toxin resistance. The <i>P</i>-values represent the probability of the identified genes to be annotated to a particular GO term relative to all the annotated human genes. GO terms are shown depicting biological processes in black and cellular components in gray.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1362124, "created_date": "2019-04-05T17:30:50Z", "modified_date": "2023-06-10T01:36:09Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["pentameric B subunit", "genome-wide screen Typhoid toxin", "endoplasmic reticulum-associated degradation machineries", "typhoid toxin hijacks", "acetyl neuraminic acid", "CRISPR", "ADP ribosyl transferase PltA", "typhoid toxin", "surface glycoprotein sialoglycans"], "keywords": ["pentameric B subunit", "genome-wide screen Typhoid toxin", "endoplasmic reticulum-associated degradation machineries", "typhoid toxin hijacks", "acetyl neuraminic acid", "CRISPR", "ADP ribosyl transferase PltA", "typhoid toxin", "surface glycoprotein sialoglycans"], "categories": [{"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 931, "title": "Information Systems not elsewhere classified", "parent_id": 52, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 132, "title": "Infectious Diseases", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 134, "title": "Virology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1371/journal.ppat.1007704"], "has_linked_file": false, "citation": "Chang, Shu-Jung; Chih Jin, Sheng; Jiao, Xuyao; E. Gal\u00e1n, Jorge (2019). A genome-wide CRISPR/Cas9-mediated gene inactivation screen identifies genes essential for typhoid toxin intoxication.. PLOS Pathogens. Figure. https://doi.org/10.1371/journal.ppat.1007704.g002", "related_materials": [{"id": 64788062, "identifier": "10.1371/journal.ppat.1007704", "title": "Unique features in the intracellular transport of typhoid toxin revealed by a genome-wide screen", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1371/journal.ppat.1007704"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 7960487, "title": "A genome-wide CRISPR/Cas9-mediated gene inactivation screen identifies genes essential for typhoid toxin intoxication.", "doi": "10.1371/journal.ppat.1007704.g002", "handle": "", "url": "https://api.figshare.com/v2/articles/7960487", "published_date": "2019-04-05T17:30:43Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-plos-725668748/14816264/thumb.png", "defined_type": 1, "defined_type_name": "figure", "group_id": 113, "url_private_api": "https://api.figshare.com/v2/account/articles/7960487", "url_public_api": "https://api.figshare.com/v2/articles/7960487", "url_private_html": "https://figshare.com/account/articles/7960487", "url_public_html": "https://plos.figshare.com/articles/figure/A_genome-wide_CRISPR_Cas9-mediated_gene_inactivation_screen_identifies_genes_essential_for_typhoid_toxin_intoxication_/7960487", "timeline": {"posted": "2019-04-05T17:30:43", "firstOnline": "2019-04-17"}, "resource_title": "Unique features in the intracellular transport of typhoid toxin revealed by a genome-wide screen", "resource_doi": "10.1371/journal.ppat.1007704"}