{"files": [{"id": 39869933, "name": "00085472can182711-sup-207884_2_supp_5364661_pngpgm.pdf", "size": 127242961, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39869933", "supplied_md5": "51191fb161980c47c21d107f14b43050", "computed_md5": "51191fb161980c47c21d107f14b43050", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 14939759, "full_name": "Tikvah K. Hayes", "first_name": "Tikvah K.", "last_name": "Hayes", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 435917, "full_name": "Flora Luo", "first_name": "Flora", "last_name": "Luo", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14939762, "full_name": "Ofir Cohen", "first_name": "Ofir", "last_name": "Cohen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14939765, "full_name": "Amy B. Goodale", "first_name": "Amy B.", "last_name": "Goodale", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 7208643, "full_name": "Yenarae Lee", "first_name": "Yenarae", "last_name": "Lee", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14939768, "full_name": "Sasha Pantel", "first_name": "Sasha", "last_name": "Pantel", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 7208646, "full_name": "Mukta Bagul", "first_name": "Mukta", "last_name": "Bagul", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 773276, "full_name": "Federica Piccioni", "first_name": "Federica", "last_name": "Piccioni", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14932302, "full_name": "David E. Root", "first_name": "David E.", "last_name": "Root", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-5122-861X"}, {"id": 14881869, "full_name": "Levi A. Garraway", "first_name": "Levi A.", "last_name": "Garraway", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 24538, "full_name": "Matthew Meyerson", "first_name": "Matthew", "last_name": "Meyerson", "is_active": false, "url_name": "Matthew_Meyerson", "orcid_id": ""}, {"id": 14939771, "full_name": "Cory M. Johannessen", "first_name": "Cory M.", "last_name": "Johannessen", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2618-1036"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Combinatorial inhibition of MEK1/2 and CDK4/6 is currently undergoing clinical investigation in NRAS-mutant melanoma. To prospectively map the landscape of resistance to this investigational regimen, we utilized a series of gain- and loss-of-function forward genetic screens to identify modulators of resistance to clinical inhibitors of MEK1/2 and CDK4/6 alone and in combination. First, we identified NRAS-mutant melanoma cell lines that were dependent on NRAS for proliferation and sensitive to MEK1/2 and CDK4/6 combination treatment. We then used a genome-scale ORF overexpression screen and a CRISPR knockout screen to identify modulators of resistance to each inhibitor alone or in combination. These orthogonal screening approaches revealed concordant means of achieving resistance to this therapeutic modality, including tyrosine kinases, RAF, RAS, AKT, and PI3K signaling. Activated KRAS was sufficient to cause resistance to combined MEK/CDK inhibition and to replace genetic depletion of oncogenic NRAS. In summary, our comprehensive functional genetic screening approach revealed modulation of resistance to the inhibition of MEK1/2, CDK4/6, or their combination in NRAS-mutant melanoma.\nThese findings reveal that NRAS-mutant melanomas can acquire resistance to genetic ablation of NRAS or combination MEK1/2 and CDK4/6 inhibition by upregulating activity of the RTK\u2013RAS\u2013RAF and RTK\u2013PI3K\u2013AKT signaling cascade.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Data_from_A_Functional_Landscape_of_Resistance_to_MEK1_2_and_CDK4_6_Inhibition_in_NRAS-Mutant_Melanoma/22423682", "download_disabled": false, "description": "<p>SF1: NRAS mutant melanoma sensitivity to trametinib and palbociclib treatment; SF2: MELJUSO ORF Screen Optimization and Validation; SF3: MELJUSO CRISPR Screen Optimization and Validation; SF4: EGFR-PI3K-AKT signaling modulates resistance to trametinib/palbociclib treatment in NRAS mutant melanoma cell lines; SF5: RAS signaling modulates resistance to trametinib/palbociclib treatment in NRAS mutant melanoma cell lines; SF6: EGFR-PI3K-AKT signaling cascade differentially replaces loss of genetic NRAS in NRAS mutant melanoma cell lines; SF7: Active KRAS can replace loss of genetic NRAS</p>", "funding": "NCI", "funding_list": [{"id": 335318, "title": "NCI", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 127242961, "created_date": "2023-03-31T03:06:41Z", "modified_date": "2023-05-30T18:16:09Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Cell Cycle", "CDKs and CDK inhibitors", "Cell Signaling", "Protein serine-threonine kinases", "Drug Mechanisms", "Drug Resistance", "Drug Targets", "Skin Cancers", "Melanoma"], "keywords": ["Cell Cycle", "CDKs and CDK inhibitors", "Cell Signaling", "Protein serine-threonine kinases", "Drug Mechanisms", "Drug Resistance", "Drug Targets", "Skin Cancers", "Melanoma"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/0008-5472.CAN-18-2711"], "has_linked_file": false, "citation": "Hayes, Tikvah K.; Luo, Flora; Cohen, Ofir; Goodale, Amy B.; Lee, Yenarae; Pantel, Sasha; et al. (2019). Supplementary Data from A Functional Landscape of Resistance to MEK1/2 and CDK4/6 Inhibition in NRAS-Mutant Melanoma. American Association for Cancer Research. Journal contribution. https://doi.org/10.1158/0008-5472.22423682.v1", "related_materials": [{"id": 4183154, "identifier": "10.1158/0008-5472.CAN-18-2711", "title": "A Functional Landscape of Resistance to MEK1/2 and CDK4/6 Inhibition in NRAS-Mutant Melanoma", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/0008-5472.CAN-18-2711"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22423682, "title": "Supplementary Data from A Functional Landscape of Resistance to MEK1/2 and CDK4/6 Inhibition in NRAS-Mutant Melanoma", "doi": "10.1158/0008-5472.22423682.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/22423682", "published_date": "2023-03-31T03:06:41Z", "thumb": "https://ndownloader.figshare.com/files/39869933/preview/39869933/thumb.png", "defined_type": 6, "defined_type_name": "journal contribution", "group_id": 46225, "url_private_api": "https://api.figshare.com/v2/account/articles/22423682", "url_public_api": "https://api.figshare.com/v2/articles/22423682", "url_private_html": "https://figshare.com/account/articles/22423682", "url_public_html": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Data_from_A_Functional_Landscape_of_Resistance_to_MEK1_2_and_CDK4_6_Inhibition_in_NRAS-Mutant_Melanoma/22423682", "timeline": {"posted": "2023-03-31T03:06:41", "publisherPublication": "2019-05-01T00:00:00", "firstOnline": "2023-03-31"}, "resource_title": "A Functional Landscape of Resistance to MEK1/2 and CDK4/6 Inhibition in NRAS-Mutant Melanoma", "resource_doi": "10.1158/0008-5472.CAN-18-2711"}