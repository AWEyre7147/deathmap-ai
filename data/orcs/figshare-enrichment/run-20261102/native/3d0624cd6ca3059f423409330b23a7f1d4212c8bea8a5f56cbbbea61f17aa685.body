{"files": [{"id": 39999412, "name": "21598290cd190125-sup-216310_2_supp_5485028_pqlflk.docx", "size": 2316610, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39999412", "supplied_md5": "93457b99899bceaf3b1804d766345697", "computed_md5": "93457b99899bceaf3b1804d766345697", "mimetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}], "folder_structure": {}, "authors": [{"id": 15111838, "full_name": "Tamilla Nechiporuk", "first_name": "Tamilla", "last_name": "Nechiporuk", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15024150, "full_name": "Stephen E. Kurtz", "first_name": "Stephen E.", "last_name": "Kurtz", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14956815, "full_name": "Olga Nikolova", "first_name": "Olga", "last_name": "Nikolova", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-8105-2440"}, {"id": 267387, "full_name": "Tingting Liu", "first_name": "Tingting", "last_name": "Liu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14935577, "full_name": "Courtney L. Jones", "first_name": "Courtney L.", "last_name": "Jones", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 352673, "full_name": "Angelo D'Alessandro", "first_name": "Angelo", "last_name": "D'Alessandro", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 11441257, "full_name": "Rachel Culp-Hill", "first_name": "Rachel", "last_name": "Culp-Hill", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15111841, "full_name": "Amanda d'Almeida", "first_name": "Amanda", "last_name": "d'Almeida", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15111844, "full_name": "Sunil K. Joshi", "first_name": "Sunil K.", "last_name": "Joshi", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15020997, "full_name": "Mara Rosenberg", "first_name": "Mara", "last_name": "Rosenberg", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-6400-3161"}, {"id": 6503927, "full_name": "Cristina E. Tognon", "first_name": "Cristina E.", "last_name": "Tognon", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 13044622, "full_name": "Alexey V. Danilov", "first_name": "Alexey V.", "last_name": "Danilov", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14864982, "full_name": "Brian J. Druker", "first_name": "Brian J.", "last_name": "Druker", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-8331-8206"}, {"id": 15014075, "full_name": "Bill H. Chang", "first_name": "Bill H.", "last_name": "Chang", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-3783-1820"}, {"id": 15111847, "full_name": "Shannon K McWeeney", "first_name": "Shannon K", "last_name": "McWeeney", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15024147, "full_name": "Jeffrey W. Tyner", "first_name": "Jeffrey W.", "last_name": "Tyner", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2133-0960"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "To study mechanisms underlying resistance to the BCL2 inhibitor venetoclax in acute myeloid leukemia (AML), we used a genome-wide CRISPR/Cas9 screen to identify gene knockouts resulting in drug resistance. We validated TP53, BAX, and PMAIP1 as genes whose inactivation results in venetoclax resistance in AML cell lines. Resistance to venetoclax resulted from an inability to execute apoptosis driven by BAX loss, decreased expression of BCL2, and/or reliance on alternative BCL2 family members such as BCL2L1. The resistance was accompanied by changes in mitochondrial homeostasis and cellular metabolism. Evaluation of TP53 knockout cells for sensitivities to a panel of small-molecule inhibitors revealed a gain of sensitivity to TRK inhibitors. We relate these observations to patient drug responses and gene expression in the Beat AML dataset. Our results implicate TP53, the apoptotic network, and mitochondrial functionality as drivers of venetoclax response in AML and suggest strategies to overcome resistance.\nAML is challenging to treat due to its heterogeneity, and single-agent therapies have universally failed, prompting a need for innovative drug combinations. We used a genetic approach to identify genes whose inactivation contributes to drug resistance as a means of forming preferred drug combinations to improve AML treatment.See related commentary by Savona and Rathmell, p. 831.This article is highlighted in the In This Issue feature, p. 813", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Methods_from_The_TP53_Apoptotic_Network_Is_a_Primary_Mediator_of_Resistance_to_BCL2_Inhibition_in_AML_Cells/22536121", "download_disabled": false, "description": "<p>Complete methods</p>", "funding": "NCI", "funding_list": [{"id": 335318, "title": "NCI", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23224380, "title": "V Foundation", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23221823, "title": "Gabrielle's Angel Foundation for Cancer Research", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23244805, "title": "ARCS", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 2316610, "created_date": "2023-04-03T22:42:25Z", "modified_date": "2024-03-04T08:15:54Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Drug Discovery Technologies", "Screening strategies (assays and chemical libraries)", "Drug Resistance", "Drug Targets"], "keywords": ["Drug Discovery Technologies", "Screening strategies (assays and chemical librarie