: "Guo Wei", "first_name": "Guo", "last_name": "Wei", "is_active": false, "url_name": "Guo_Wei", "orcid_id": ""}, {"id": 15078553, "full_name": "Adam G. Presser", "first_name": "Adam G.", "last_name": "Presser", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15078556, "full_name": "Maya K. Gelbard", "first_name": "Maya K.", "last_name": "Gelbard", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 6197780, "full_name": "Weiqun Zhang", "first_name": "Weiqun", "last_name": "Zhang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15071943, "full_name": "Ioannis K. Zervantonakis", "first_name": "Ioannis K.", "last_name": "Zervantonakis", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2386-9553"}, {"id": 15078559, "full_name": "Patrick D. Bhola", "first_name": "Patrick D.", "last_name": "Bhola", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15051762, "full_name": "Jeremy Ryan", "first_name": "Jeremy", "last_name": "Ryan", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3327-1283"}, {"id": 11239239, "full_name": "Jennifer L. Guerriero", "first_name": "Jennifer L.", "last_name": "Guerriero", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2104-5457"}, {"id": 11411789, "full_name": "Joan Montero", "first_name": "Joan", "last_name": "Montero", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4578100, "full_name": "Felice J. Liang", "first_name": "Felice J.", "last_name": "Liang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14959412, "full_name": "Andrew D. Cherniack", "first_name": "Andrew D.", "last_name": "Cherniack", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0470-0111"}, {"id": 773276, "full_name": "Federica Piccioni", "first_name": "Federica", "last_name": "Piccioni", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8569182, "full_name": "Ursula A. Matulonis", "first_name": "Ursula A.", "last_name": "Matulonis", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14872071, "full_name": "David D.L. Bowtell", "first_name": "David D.L.", "last_name": "Bowtell", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14916176, "full_name": "Kristopher A. Sarosiek", "first_name": "Kristopher A.", "last_name": "Sarosiek", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1335960, "full_name": "Anthony Letai", "first_name": "Anthony", "last_name": "Letai", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14881869, "full_name": "Levi A. Garraway", "first_name": "Levi A.", "last_name": "Garraway", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14939771, "full_name": "Cory M. Johannessen", "first_name": "Cory M.", "last_name": "Johannessen", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2618-1036"}, {"id": 24538, "full_name": "Matthew Meyerson", "first_name": "Matthew", "last_name": "Meyerson", "is_active": false, "url_name": "Matthew_Meyerson", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "High-grade serous ovarian cancer (HGSOC) is often sensitive to initial treatment with platinum and taxane combination chemotherapy, but most patients relapse with chemotherapy-resistant disease. To systematically identify genes modulating chemotherapy response, we performed pooled functional genomic screens in HGSOC cell lines treated with cisplatin, paclitaxel, or cisplatin plus paclitaxel. Genes in the intrinsic pathway of apoptosis were among the top candidate resistance genes in both gain-of-function and loss-of-function screens. In an open reading frame overexpression screen, followed by a mini-pool secondary screen, anti-apoptotic genes including BCL2L1 (BCL-XL) and BCL2L2 (BCL-W) were associated with chemotherapy resistance. In a CRISPR-Cas9 knockout screen, loss of BCL2L1 decreased cell survival whereas loss of proapoptotic genes promoted resistance. To dissect the role of individual anti-apoptotic proteins in HGSOC chemotherapy response, we evaluated overexpression or inhibition of BCL-2, BCL-XL, BCL-W, and MCL1 in HGSOC cell lines. Overexpression of anti-apoptotic proteins decreased apoptosis and modestly increased cell viability upon cisplatin or paclitaxel treatment. Conversely, specific inhibitors of BCL-XL, MCL1, or BCL-XL/BCL-2, but not BCL-2 alone, enhanced cell death when combined with cisplatin or paclitaxel. Anti-apoptotic protein inhibitors also sensitized HGSOC cells to the poly (ADP-ribose) polymerase inhibitor olaparib. These unbiased screens highlight anti-apoptotic proteins as mediators of chemotherapy resistance in HGSOC, and support inhibition of BCL-XL and MCL1, alone or combined with chemotherapy or targeted agents, in treatment of primary and recurrent HGSOC.\nAnti-apoptotic proteins modulate drug resistance in ovarian cancer, and inhibitors of BCL-XL or MCL1 promote cell death in combination with chemotherapy.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_figures_and_supplementary_table_legends_from_Pooled_Genomic_Screens_Identify_Anti-apoptotic_Genes_as_Targetable_Mediators_of_Chemotherapy_Resistance_in_Ovarian_Cancer/22512694", "download_disabled": false, "description": "<p>Figure S1A. Cisplatin and paclitaxel sensitivity in ovarian cancer cell lines Figure S1B. Cell line growth curves in ORF screen Figure S1C. Candidate resistance genes scoring in {greater than or equal to}2 conditions in primary ORF screen Figure S2A. Expression of MDR1, encoded by ABCB1 Figure S2B. Overexpression of ABCB1 and paclitaxel response Figure S2C. Overexpression of ABCB1 and paclitaxel response in HGSOC cell lines Figure S2D. Effect of ABCB1 overexpression on cell growth with paclitaxel treatment Figure S2E. Effect of MDR1/P-glycoprotein inhibitor elacridar on paclitaxel response Figure S2F. Overexpression of ABCB1 and colony formation with paclitaxel treatment and effect of elacridar on colony formation Figure S3A. Cell line growth curves in mini-pool overexpression secondary screen Figure S3B. Mini-pool overexpression secondary screen Figure S3C. Top-ranked genes by LFC in mini-pool overexpression secondary screen Figure S4A. Cell line growth curves in CRISPR-Cas9 screen Figure S4B. CRISPR-Cas9 screen data from cisplatin+paclitaxel \"low-dose\" combination Figure S5A. Expression of BCL-XL and BCL-W Figure S5B. Overexpression of BCL2L1 (BCL-XL) or BCL2L2 (BCL-W) and paclitaxel response in HGSOC cell lines Figure S5C. Effect of overexpressing anti-apoptotic proteins on apoptotic priming Figure S5D. Expression of BCL-2 and MCL1 Figure S5E. Overexpression of BCL2 or MCL1 and apoptosis induction Figure S5F. Overexpression of BCL2 or MCL1 and paclitaxel or cisplatin response Figure S6. Cell cycle analysis of HGSOC cells overexpressing anti-apoptotic proteins Figure S7A. Genomic alterations in anti-apoptotic genes in primary ovarian cancer Figure S7B. Copy-number alterations of anti-apoptotic genes in primary HGSOC Figure S7C. Copy-number alterations of pro-apoptotic genes in primary HGSOC Figure S7D. Copy number and expression of anti-apoptotic genes in primary HGSOC Figure S7E. MCL1 and BCL2L1 are focally amplified in HGSOC Figure S7F. Progression-free interval of patients with primary HGSOC with focal amplifications of BCL2L1 or MCL1 Figure S8A. Copy number alterations of anti-apoptotic genes in ovarian cancer cell lines Figure S8B. Expression of anti-apoptotic genes in ovarian cancer cell lines Figure S9A. Expression of anti-apoptotic genes in platinum-sensitive and -resistant HGSOC Figure S9B. Expression of anti-apoptotic genes in paired platinum-sensitive and- resistant HGSOC Figure S10A. Effects of single-agent anti-apoptotic protein inhibitors on ovarian cancer cell lines Figure S10B. BH3 profiling of HGSOC cell lines with a panel of pro-apoptotic peptides</p>", "funding": "Victorian Cancer Agency", "funding_list": [{"id": 238922, "title": "Victorian Cancer Agency", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 44405, "title": "National Health and Medical Research Council", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23226071, "title": "SU2C", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23228736, "title": "TVF", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 115016, "title": "Ministerio de Economia y Competitividad", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23240842, "title": "Postdoctoral Individual National Research Service", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 335318, "title": "NCI", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 86114, "title": "NHMRC", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 5488234, "created_date": "2023-04-03T16:42:57Z", "modified_date": "2023-06-26T13:54:12Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Cell Death And Senescence", "bcl-2 pathways", "Chemotherapy", "Drug Resistance", "Gynecological Cancers", "Ovarian cancer"], "keywords": ["Cell Death And Senescence", "bcl-2 pathways", "Chemotherapy", "Drug Resistance", "Gynecological Cancers", "Ovarian cancer"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37354, "title": "Molecular and Cellular Biology", "parent_id": 0, "path": "/37354", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_