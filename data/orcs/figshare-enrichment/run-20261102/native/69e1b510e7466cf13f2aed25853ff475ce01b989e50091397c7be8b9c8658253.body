{"files": [{"id": 14816267, "name": "ppat.1007704.g003.tif", "size": 357436, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816267", "supplied_md5": "5f933719daa0dfd9e2247c71cf0bd5f0", "computed_md5": "5f933719daa0dfd9e2247c71cf0bd5f0", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 449259, "full_name": "Shu-Jung Chang", "first_name": "Shu-Jung", "last_name": "Chang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 449595, "full_name": "Sheng Chih Jin", "first_name": "Sheng", "last_name": "Chih Jin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 6560540, "full_name": "Xuyao Jiao", "first_name": "Xuyao", "last_name": "Jiao", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 114934, "full_name": "Jorge E. Gal\u00e1n", "first_name": "Jorge", "last_name": "E. Gal\u00e1n", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/Validation_of_candidate_genes_involved_in_typhoid_toxin_intoxication_/7960490", "download_disabled": false, "description": "<p>(A) Genotyping of the CRISPR/Cas9-generated knockout cells. Genomic DNA was purified from CRISPR-Cas9 edited HEK293T cell lines and analyzed by PCR with specific primers listed in <a href=\"http://www.plospathogens.org/article/info:doi/10.1371/journal.ppat.1007704#ppat.1007704.s005\" target=\"_blank\">S3 Table</a>. The TMED2-deficient cell line was examined by Western blot with an anti TEMED2-specific antibody. Dotted lines indicate places where the experimentally relevant lanes were spliced together (all lanes originate from a single gel). (B) Relative toxicity of typhoid toxin in the indicated knockout cell lines after treatment with a serial dilution of purified toxin. The relative toxicity was determined from the percentage of cells at the G<sub>2</sub>M phase fitted by nonlinear regression as indicated in the Materials and Methods. Values, which were normalized relative to wild type (considered 100) are the mean \u00b1 SEM of independent determinations. ****p < 0.0001; n. s.: differences not statistically significant; two-tailed Student\u2019s t-test.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 357436, "created_date": "2019-04-05T17:30:52Z", "modified_date": "2023-06-22T09:40:21Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["pentameric B subunit", "genome-wide screen Typhoid toxin", "endoplasmic reticulum-associated degradation machineries", "typhoid toxin hijacks", "acetyl neuraminic acid", "CRISPR", "ADP ribosyl transferase PltA", "typhoid toxin", "surface glycoprotein sialoglycans"], "keywords": ["pentameric B subunit", "genome-wide screen Typhoid toxin", "endoplasmic reticulum-associated degradation machineries", "typhoid toxin hijacks", "acetyl neuraminic acid", "CRISPR", "ADP ribosyl transferase PltA", "typhoid toxin", "surface glycoprotein sialoglycans"], "categories": [{"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 931, "title": "Information Syste