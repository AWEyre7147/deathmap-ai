{"files": [{"id": 39994464, "name": "21598290cd160154-sup-161988_1_supp_0_285jfk.pdf", "size": 84559, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39994464", "supplied_md5": "789cc97e4c3a6aefa507d2762b616856", "computed_md5": "789cc97e4c3a6aefa507d2762b616856", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 8378877, "full_name": "Andrew J. Aguirre", "first_name": "Andrew J.", "last_name": "Aguirre", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15102501, "full_name": "Robin M. Meyers", "first_name": "Robin M.", "last_name": "Meyers", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14871900, "full_name": "Barbara A. Weir", "first_name": "Barbara A.", "last_name": "Weir", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 561092, "full_name": "Francisca Vazquez", "first_name": "Francisca", "last_name": "Vazquez", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2462983, "full_name": "Cheng-Zhong Zhang", "first_name": "Cheng-Zhong", "last_name": "Zhang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15003099, "full_name": "Uri Ben-David", "first_name": "Uri", "last_name": "Ben-David", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 535081, "full_name": "April Cook", "first_name": "April", "last_name": "Cook", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 143271, "full_name": "Gavin Ha", "first_name": "Gavin", "last_name": "Ha", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15102504, "full_name": "William F. Harrington", "first_name": "William F.", "last_name": "Harrington", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14947429, "full_name": "Mihir B. Doshi", "first_name": "Mihir B.", "last_name": "Doshi", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 24170, "full_name": "Maria Kost-Alimova", "first_name": "Maria", "last_name": "Kost-Alimova", "is_active": false, "url_name": "Maria_Kost_Alimova", "orcid_id": ""}, {"id": 14931599, "full_name": "Stanley Gill", "first_name": "Stanley", "last_name": "Gill", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 68252, "full_name": "Han Xu", "first_name": "Han", "last_name": "Xu", "is_active": false, "url_name": "Han_Xu", "orcid_id": ""}, {"id": 15102507, "full_name": "Levi D. Ali", "first_name": "Levi D.", "last_name": "Ali", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 500148, "full_name": "Guozhi Jiang", "first_name": "Guozhi", "last_name": "Jiang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14939768, "full_name": "Sasha Pantel", "first_name": "Sasha", "last_name": "Pantel", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 7208643, "full_name": "Yenarae Lee", "first_name": "Yenarae", "last_name": "Lee", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 7208640, "full_name": "Amy Goodale", "first_name": "Amy", "last_name": "Goodale", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 5330354, "full_name": "Andrew D. Cherniack", "first_name": "Andrew D.", "last_name": "Cherniack", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3141501, "full_name": "Coyin Oh", "first_name": "Coyin", "last_name": "Oh", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15101334, "full_name": "Gregory Kryukov", "first_name": "Gregory", "last_name": "Kryukov", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14926110, "full_name": "Glenn S. Cowley", "first_name": "Glenn S.", "last_name": "Cowley", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14881869, "full_name": "Levi A. Garraway", "first_name": "Levi A.", "last_name": "Garraway", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 54154, "full_name": "Kimberly Stegmaier", "first_name": "Kimberly", "last_name": "Stegmaier", "is_active": false, "url_name": "Kimberly_Stegmaier", "orcid_id": ""}, {"id": 15102510, "full_name": "Charles W. Roberts", "first_name": "Charles W.", "last_name": "Roberts", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 81695, "full_name": "Todd R. Golub", "first_name": "Todd R.", "last_name": "Golub", "is_active": false, "url_name": "Todd_R_Golub", "orcid_id": ""}, {"id": 24538, "full_name": "Matthew Meyerson", "first_name": "Matthew", "last_name": "Meyerson", "is_active": false, "url_name": "Matthew_Meyerson", "orcid_id": ""}, {"id": 8819989, "full_name": "David E. Root", "first_name": "David E.", "last_name": "Root", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 561103, "full_name": "Aviad Tsherniak", "first_name": "Aviad", "last_name": "Tsherniak", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 11135253, "full_name": "William C. Hahn", "first_name": "William C.", "last_name": "Hahn", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "The CRISPR/Cas9 system enables genome editing and somatic cell genetic screens in mammalian cells. We performed genome-scale loss-of-function screens in 33 cancer cell lines to identify genes essential for proliferation/survival and found a strong correlation between increased gene copy number and decreased cell viability after genome editing. Within regions of copy-number gain, CRISPR/Cas9 targeting of both expressed and unexpressed genes, as well as intergenic loci, led to significantly decreased cell proliferation through induction of a G2 cell-cycle arrest. By examining single-guide RNAs that map to multiple genomic sites, we found that this cell response to CRISPR/Cas9 editing correlated strongly with the number of target loci. These observations indicate that genome targeting by CRISPR/Cas9 elicits a gene-independent antiproliferative cell response. This effect has important practical implications for the interpretation of CRISPR/Cas9 screening data and confounds the use of this technology for the identification of essential genes in amplified regions.Significance: We found that the number of CRISPR/Cas9-induced DNA breaks dictates a gene-independent antiproliferative response in cells. These observations have practical implications for using CRISPR/Cas9 to interrogate cancer gene function and illustrate that cancer cells are highly sensitive to site-specific DNA damage, which may provide a path to novel therapeutic strategies. Cancer Discov; 6(8); 914\u201329. \u00a92016 AACR.See related commentary by Sheel and Xue, p. 824.See related article by Munoz et al., p. 900.This article is highlighted in the In This Issue feature, p. 803", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Methods_from_Genomic_Copy_Number_Dictates_a_Gene-Independent_Cell_Response_to_CRISPR_Cas9_Targeting/22531290", "download_disabled": false, "description": "<p>Supplementary Methods</p>", "funding": "Pancreatic Cancer Action Network", "funding_list": [{"id": 20984619, "title": "Pancreatic Cancer Action Network", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23222366, "title": "American Society of Clinical Oncology", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 19149914, "title": "Dana-Farber Cancer Institute", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23243148, "title": "Harvard Catalyst and Harvard Clinical and Translational Science Center", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 84559, "created_date": "2023-04-03T21:03:13Z", "modified_date": "2024-03-01T19:42:29Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org