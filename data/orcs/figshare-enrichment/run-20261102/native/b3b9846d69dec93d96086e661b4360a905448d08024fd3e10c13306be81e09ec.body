{"files": [{"id": 47099644, "name": "ppat.1011970.s003.eps", "size": 2056318, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/47099644", "supplied_md5": "04aac68b11036ed609b2ba91cee1df48", "computed_md5": "04aac68b11036ed609b2ba91cee1df48", "mimetype": "image/x-eps"}], "folder_structure": {}, "authors": [{"id": 4308, "full_name": "Yan Chen", "first_name": "Yan", "last_name": "Chen", "is_active": false, "url_name": "Yan_Chen", "orcid_id": ""}, {"id": 18841048, "full_name": "Rodney P. Kincaid", "first_name": "Rodney P.", "last_name": "Kincaid", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 18841051, "full_name": "Kelley Bastin", "first_name": "Kelley", "last_name": "Bastin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 18841054, "full_name": "Devin N. Fachko", "first_name": "Devin N.", "last_name": "Fachko", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 18841057, "full_name": "Rebecca L. Skalsky", "first_name": "Rebecca L.", "last_name": "Skalsky", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/miR-142_attenuates_activation_of_SRE_and_alters_induction_of_EGR1_/26051911", "download_disabled": false, "description": "<p>A. miR-142 inhibits a MAPK pathway reporter. 293T cells were transfected with 20 ng pGL4.33-SRE/RSV-Rluc and 250 ng pLCE or miR-142. 42 hrs post-transfection, EGF (5 ng/mL) added to cells for 6 hr in DMEM 2% FBS. N = 4 in triplicate. B. miR-142 expression from miRNA vectors. 293T cells were transfected with either pLCE, pLCE-miR-142, or pLCE-miR-142-3p. Total RNA was isolated at 48 hrs and tested for miRNAs using Taqman qRT-PCR. Values are normalized to miR-16 and shown relative to MutuI cells. Shown is the average of three experiments. C and D. EGR1 levels are increased in miR-142 mutant MutuI cells. EGR1 transcripts were measured by qRT-PCR. Values are normalized to GAPDH and reported relative to mock treated control cells. Cells tested in C. are from <a href=\"http://www.plospathogens.org/article/info:doi/10.1371/journal.ppat.1011970#ppat.1011970.g001\" target=\"_blank\">Fig 1C</a> while cells tested in D. are from <a href=\"http://www.plospathogens.org/article/info:doi/10.1371/journal.ppat.1011970#ppat.1011970.g002\" target=\"_blank\">Fig 2C and 2D</a>.</p> <p>(EPS)</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 2056318, "created_date": "2024-06-17T17:37:21Z", "modified_date": "2024-06-28T17:35:34Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["b cell receptor", "surface ig cross", "xlink \"> reactivation", "142 targets related", "142 enhanced levels", "restricts ebv entry", "support viral infection", "infected bl cells", "cells using anti", "ebv lytic phase", "erk signaling initiated", "ebv reactivation", "mapk signaling", "lytic stage", "ig antibodies", "induce reactivation", "ebv latency", "taken together", "significant role", "results show", "latency plays", "key regulator", "immediate early", "grna library", "genetic ablation", "gain insight", "fully understood", "effects could", "dabrafenib ).", "clip experiments", "burkitt lymphoma", "based screen", "barr virus"], "keywords": ["b cell receptor", "surface ig cross", "xlink \"> reactivation", "142 targets related", "142 enhanced levels", "restricts ebv entry", "support viral infection", "infected bl cells", "cells using anti", "ebv lytic phase", "erk signaling initiated", "ebv reactivation", "mapk signaling", "lytic stage", "ig antibodies", "induce reactivation", "ebv latency", "taken together", "significant role", "results show", "latency plays", "key regulator", "immediate early", "grna library", "genetic ablation", "gain insight", "fully understood", "effects could", "