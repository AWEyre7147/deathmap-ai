th": "", "source_id": "", "taxonomy_id": 10}, {"id": 64, "title": "Cancer", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 122, "title": "Mental Health", "parent_id": 18, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 132, "title": "Infectious Diseases", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 134, "title": "Virology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1371/journal.pbio.3001490"], "has_linked_file": false, "citation": "Kratzel, Annika; Kelly, Jenna N.; V\u2019kovski, Philip; Portmann, Jasmine; Br\u00fcggemann, Yannick; Todt, Daniel; et al. (2021). MERS-CoV and HCoV-229E genome-wide CRISPR/Cas-9\u2013mediated KO screens.. PLOS Biology. Figure. https://doi.org/10.1371/journal.pbio.3001490.g001", "related_materials": [{"id": 56621930, "identifier": "10.1371/journal.pbio.3001490", "title": "A genome-wide CRISPR screen identifies interactors of the autophagy pathway as conserved coronavirus targets", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1371/journal.pbio.3001490"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 17700626, "title": "MERS-CoV and HCoV-229E genome-wide CRISPR/Cas-9\u2013mediated KO screens.", "doi": "10.1371/journal.pbio.3001490.g001", "handle": "", "url": "https://api.figshare.com/v2/articles/17700626", "published_date": "2021-12-28T19:35:44Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-plos-725668748/32397839/thumb.png", "defined_type": 1, "defined_type_name": "figure", "group_id": 116, "url_private_api": "https://api.figshare.com/v2/account/articles/17700626", "url_public_api": "https://api.figshare.com/v2/articles/17700626", "url_private_html": "https://figshare.com/account/articles/17700626", "url_public_html": "https://plos.figshare.com/articles/figu