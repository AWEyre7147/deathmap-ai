{"files": [{"id": 38660721, "name": "ppat.1010800.g006.tif", "size": 353380, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/38660721", "supplied_md5": "dc7e0844434c5be80884496f0d1144c7", "computed_md5": "dc7e0844434c5be80884496f0d1144c7", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 14305263, "full_name": "Alejandro Mat\u00eda", "first_name": "Alejandro", "last_name": "Mat\u00eda", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14305266, "full_name": "Maria M. Lorenzo", "first_name": "Maria M.", "last_name": "Lorenzo", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14305269, "full_name": "Yolimar C. Romero-Estremera", "first_name": "Yolimar C.", "last_name": "Romero-Estremera", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14305272, "full_name": "Juana M. S\u00e1nchez-Puig", "first_name": "Juana M.", "last_name": "S\u00e1nchez-Puig", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14223767, "full_name": "Angel Zaballos", "first_name": "Angel", "last_name": "Zaballos", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 468443, "full_name": "Rafael Blasco", "first_name": "Rafael", "last_name": "Blasco", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/Effect_of_B2M_inactivation_on_the_early_steps_of_Vaccinia_virus_infection_/21784668", "download_disabled": false, "description": "<p>A) MW6 well plaques with HeLa and B2M KO clones 1 and 2 were infected with 200 pfu/well of V-GFP. Plaques were counted at 24 h.p.i B) Images of representative plaques under the microscope by GFP fluorescence. C) and D) Early luciferase expression was taken as a measure of virus entry. HeLa (C) and HAP1 (D) cells were infected with V-e.Luc at m.o.i. = 0.8 and luciferase activity was measured 3 h.p.i. Error bars indicate SD of three independent experiments. E) Infection of B2M deficient cells with extracellular virus (EV) and intracellular virus (IV). F) Time course expression of A26-defficient VV in B2M KO cells. nLuc expression was measured in triplicates in the culture medium of cells infected with the indicated viruses. G) Effect of A26 deletion on virus entry. nLuc activity at 40 min after virus adsorption is shown. p-values: **** < 0.0001, *** < 0.001, ** < 0.01, * < 0.05, ns > 0.05.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 353380, "created_date": "2022-12-27T18:42:35Z", "modified_date": "2023-06-06T11:35:00Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["wide genetic screens", "therefore cell survival", "screening top hits", "provide complete resistance", "consistently found \u03b2", "single gene knock", "significant gene hits", "early gene expression", "find genes necessary", "absolute infection blockage", "thus allow cells", "downstream related pathways", "div >< p", "vaccinia virus infection", "vaccinia virus", "b2m gene", "identify genes", "genes belonging", "survive infection", "virus internalization", "virus entry", "virus binding", "surviving cells", "significantly diminished", "results point", "relevant factor", "reduced probability", "proteins known", "powerful tools", "novel finding", "host factors", "host factor", "2 microglobulin", "&# 946"], "keywords": ["wide genetic screens", "therefore cell survival", "screening top hits", "provide complete resistance", "consistently found \u03b2", "single gene knock", "significant gene hits", "early gene expression", "find genes necessary", "absolute infection blockage", "thus allow cells", "downstream related pathways", "div >< p", "vaccinia virus infection", "vaccinia virus", "b2m gene", "identify genes", "genes belonging", "survive infection", "virus internalization", "virus entry", "virus binding", "surviving cells", "significantly diminished", "results point", "relevant factor", "reduced probability", "proteins known", "powerful tools", "novel finding", "host factors", "host factor", "2 microglobulin", "&# 946"], "categories": [{"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 12, "title": "Cell Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 46, "title": "Immunology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 64, "title": "Cancer", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 132, "title": "Infectious Diseases", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 134, "title": "Virology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1371/journal.ppat.1010800"], "has_linked_file": false, "citation": "Mat\u00eda, Alejandro; Lorenzo, Maria M.; Romero-Estremera, Yolimar C.; S\u00e1nchez-Puig, Juana M.; Zaballos, Angel; Blasco, Rafael (2022). Effect of B2M inactivation on the early steps of Vaccinia virus infection.. PLOS Pathogens. Figure. https://doi.org/10.1371/journal.ppat.1010800.g006", "related_materials": [{"id": 51130292, "identifier": "10.1371/journal.ppat.1010800", "title": "Identification of \u03b22 microglobulin, the product of B2M gene, as a Host Factor for Vaccinia Virus Infection by Genome-Wide CRISPR genetic screens", "relation": "IsSupplementTo