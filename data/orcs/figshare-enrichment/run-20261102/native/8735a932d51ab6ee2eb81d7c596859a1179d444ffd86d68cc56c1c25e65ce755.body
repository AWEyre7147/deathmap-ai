url_name": "_", "orcid_id": ""}, {"id": 158598, "full_name": "Martin Sachse", "first_name": "Martin", "last_name": "Sachse", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 368646, "full_name": "Cristina Risco", "first_name": "Cristina", "last_name": "Risco", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8506464, "full_name": "Terence S. Dermody", "first_name": "Terence S.", "last_name": "Dermody", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/figure/Cytosolic_entry_of_reovirus_cores_/19331293", "download_disabled": false, "description": "<p>(A) WT, KO, and KO+ HBMECs were adsorbed with Alexa 647 labeled-reovirus virions (cyan) at an MOI of 10,000 particles/cell at 37\u00b0C for 45 min and fixed with 4% PFA at 8 h post-adsorption. Cells were stained with DAPI (gray), a CD63-specific antibody to label endosomes (red), and an antiserum specific for reovirus cores (green), and imaged using confocal microscopy. Representative confocal micrographs are shown. Insets represent a merged image (far left), cores (center left), CD63 (center right), and virus (far right). (B) Colocalization of reovirus virions, cores, and endosomes was analyzed using the JaCoP plugin function from ImageJ. The results are presented as the mean colocalization (quantified by Manders coefficient) of ~ 50 cells from three independent experiments. Error bars indicate standard deviation. **, <i>P</i> < 0.01; ***, <i>P</i> < 0.001, as determined by two-tailed unpaired t-test.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 2663376, "created_date": "2022-03-09T18:30:22Z", "modified_date": "2023-06-14T21:15:07Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["rna interference screens", "putative host factor", "infectious subvirion particles", "including ebola virus", "human immunodeficiency virus", "hepatitis c virus", "assembly take place", "reovirus outer capsid", "reovirus disassembly intermediates", "npc1 transport activity", "uncoating within endosomes", "cells lacking npc1", "reovirus penetration", "reovirus attachment", "reovirus ).", "identified npc1", "viral transcription", "viral core", "target cells", "solubilizes cholesterol", "significantly impaired", "reovirus infection", "proteolytically removed", "plasma membrane", "pick c1", "new function", "mediated endocytosis", "many viruses", "mammalian orthoreovirus", "late endosomes", "findings suggest", "endoplasmic reticulum", "endocytic pathway", "cholesterol trafficking", "cholesterol homeostasis"], "keywords": ["rna interference screens", "putative host factor", "infectious subvirion particles", "including ebola virus", "human immunodeficiency virus", "hepatitis c virus", "assembly take place", "reovirus outer capsid", "reovirus disassembly intermediates", "npc1 transport activity", "uncoating within endosomes", "cells lacking npc1", "reovirus penetration", "reovirus attachment", "reovirus ).", "identified npc1", "viral transcription", "viral core", "target cells", "solubilizes cholesterol", "significantly impaired", "reovirus infection", "proteolytically removed", "plasma membrane", "pick c1", "new function", "mediated endocytosis", "many viruses", "mammalian orthoreovirus", "late endosomes", "findings suggest", "endoplasmic reticulum", "endocytic pathway", "cholesterol trafficking", "cholesterol homeostasis"], "categories": [{"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 7, "title": "Medicine", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 12, "title": "Cell Biology", "parent_id": 48, "pa