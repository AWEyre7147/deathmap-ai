, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 7, "title": "Medicine", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 12, "title": "Cell Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 46, "title": "Immunology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 61, "title": "Developmental Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 64, "title": "Cancer", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 128, "title": "Hematology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 132, "title": "Infectious Diseases", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1371/journal.ppat.1010377"], "has_linked_file": false, "citation": "Sherman, Emily J.; Mirabelli, Carmen; Tang, Vi T.; Khan, Taslima G.; Leix, Kyle; Kennedy, Andrew A.; et al. (2022). Analysis of ACE2 modifiers.. PLOS Pathogens. Figure. https://doi.org/10.1371/journal.ppat.1010377.g003", "related_materials": [{"id": 65426126, "identifier": "10.1371/journal.ppat.1010377", "title": "Identification of cell type specific ACE2 modifiers by CRISPR screening", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1371/journal.ppat.