{"files": [{"id": 39998428, "name": "21598290cd190780-sup-225096_2_supp_5887945_q0mnl1.pdf", "size": 5178847, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39998428", "supplied_md5": "ab0876339e3a171f9b4efc3c7c5d9f05", "computed_md5": "ab0876339e3a171f9b4efc3c7c5d9f05", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 143236, "full_name": "Fei Li", "first_name": "Fei", "last_name": "Li", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 625246, "full_name": "Qingyuan Huang", "first_name": "Qingyuan", "last_name": "Huang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15041931, "full_name": "Troy A. Luster", "first_name": "Troy A.", "last_name": "Luster", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 141546, "full_name": "Hai Hu", "first_name": "Hai", "last_name": "Hu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 12549, "full_name": "Hua Zhang", "first_name": "Hua", "last_name": "Zhang", "is_active": false, "url_name": "Hua_Zhang", "orcid_id": ""}, {"id": 14943013, "full_name": "Wai-Lung Ng", "first_name": "Wai-Lung", "last_name": "Ng", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2892-6318"}, {"id": 5479478, "full_name": "Alireza Khodadadi-Jamayran", "first_name": "Alireza", "last_name": "Khodadadi-Jamayran", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 17594, "full_name": "Wei Wang", "first_name": "Wei", "last_name": "Wang", "is_active": false, "url_name": "Wei_Wang", "orcid_id": ""}, {"id": 14943031, "full_name": "Ting Chen", "first_name": "Ting", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-1725-7956"}, {"id": 289731, "full_name": "Jiehui Deng", "first_name": "Jiehui", "last_name": "Deng", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 290385, "full_name": "Michela Ranieri", "first_name": "Michela", "last_name": "Ranieri", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 550085, "full_name": "Zhaoyuan Fang", "first_name": "Zhaoyuan", "last_name": "Fang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14943040, "full_name": "Val Pyon", "first_name": "Val", "last_name": "Pyon", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 12584428, "full_name": "Catr\u00edona M. Dowling", "first_name": "Catr\u00edona M.", "last_name": "Dowling", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15109693, "full_name": "Ece Bagdatlioglu", "first_name": "Ece", "last_name": "Bagdatlioglu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14943049, "full_name": "Christina Almonte", "first_name": "Christina", "last_name": "Almonte", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14943046, "full_name": "Kristen Labbe", "first_name": "Kristen", "last_name": "Labbe", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15018923, "full_name": "Heather Silver", "first_name": "Heather", "last_name": "Silver", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15109696, "full_name": "Alexandra R. Rabin", "first_name": "Alexandra R.", "last_name": "Rabin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15109699, "full_name": "Kandarp Jani", "first_name": "Kandarp", "last_name": "Jani", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14946172, "full_name": "Aristotelis Tsirigos", "first_name": "Aristotelis", "last_name": "Tsirigos", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-7512-8477"}, {"id": 33874, "full_name": "Thales Papagiannakopoulos", "first_name": "Thales", "last_name": "Papagiannakopoulos", "is_active": false, "url_name": "Thales_Papagiannakopoulos", "orcid_id": ""}, {"id": 218409, "full_name": "Peter S. Hammerman", "first_name": "Peter S.", "last_name": "Hammerman", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 404806, "full_name": "Vamsidhar Velcheti", "first_name": "Vamsidhar", "last_name": "Velcheti", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8747446, "full_name": "Gordon J. Freeman", "first_name": "Gordon J.", "last_name": "Freeman", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 128861, "full_name": "Jun Qi", "first_name": "Jun", "last_name": "Qi", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 243489, "full_name": "George Miller", "first_name": "George", "last_name": "Miller", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 165223, "full_name": "Kwok-Kin Wong", "first_name": "Kwok-Kin", "last_name": "Wong", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Despite substantial progress in lung cancer immunotherapy, the overall response rate in patients with KRAS-mutant lung adenocarcinoma (LUAD) remains low. Combining standard immunotherapy with adjuvant approaches that enhance adaptive immune responses\u2014such as epigenetic modulation of antitumor immunity\u2014is therefore an attractive strategy. To identify epigenetic regulators of tumor immunity, we constructed an epigenetic-focused single guide RNA library and performed an in vivo CRISPR screen in a KrasG12D/Trp53\u2212/\u2212 LUAD model. Our data showed that loss of the histone chaperone Asf1a in tumor cells sensitizes tumors to anti\u2013PD-1 treatment. Mechanistic studies revealed that tumor cell\u2013intrinsic Asf1a deficiency induced immunogenic macrophage differentiation in the tumor microenvironment by upregulating GM-CSF expression and potentiated T-cell activation in combination with anti\u2013PD-1. Our results provide a rationale for a novel combination therapy consisting of ASF1A inhibition and anti\u2013PD-1 immunotherapy.\nUsing an in vivo epigenetic CRISPR screen, we identified Asf1a as a critical regulator of LUAD sensitivity to anti\u2013PD-1 therapy. Asf1a deficiency synergized with anti\u2013PD-1 immunotherapy by promoting M1-like macrophage polarization and T-cell activation. Thus, we provide a new immunotherapeutic strategy for this subtype of patients with LUAD.See related commentary by Menzel and Black, p. 179.This article is highlighted in the In This Issue feature, p. 161", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Figure_S17_from_i_In_Vivo_i_Epigenetic_CRISPR_Screen_Identifies_i_Asf1a_i_as_an_Immunotherapeutic_Target_in_i_Kras_i_-Mutant_Lung_Adenocarcinoma/22535143", "download_disabled": false, "description": "<p>Secondary clustering of T cells</p>", "funding": "NIH", "funding_list": [{"id": 29591, "title": "NIH", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 5178847, "created_date": "2023-04-03T22:21:23Z", "modified_date": "2024-03-04T07:44:09Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Immunotherapy", "Lung Cancer"], "keywords": ["Immunotherapy", "Lung Cancer"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37363, "title": "Immuno-oncology", "parent_id": 0, "path": "/37363", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/2159-8290.CD-19-0780"], "has_linked_file": false, "citation": "Li, Fei; Huang, Qingyuan; Luster, Troy A.; Hu, Hai; Zhang, Hua; Ng, Wai-Lung; et al. (2020). Figure S17 from In Vivo Epigenetic CRISPR Screen Identifies Asf1a as an Immunotherapeutic Target in Kras-Mutant Lung Adenocarcinoma. American Association for Cancer Research. Journal contribution. https://doi.org/10.1158/2159-8290.22535143.v1", "related_materials": [{"id": 104331816, "identifier": "10.1158/2159-8290.CD-19-0780", "title": "In Vivo Epigenetic CRISPR Screen Identifies Asf1a as an Immunotherapeutic Target in Kras-Mutant Lung Adenocarcinoma", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/2159-8290.CD-19-0780"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22535143, "title": "Figure S17 from <i>In Vivo</i> Epigenetic CRISPR Screen Identifies <i>Asf1a</i> as an Immunotherapeutic Target in <i>Kras</i>-Mutant Lung Adenocarcinoma", "doi": "10.1158/2159-8290.22535143.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/22535143", "published_date": "2023-04-03T22:21:23Z", "thumb": "https://ndownloader.figshare.com/files/39998428/preview/39998428/thumb.png", "defined_type": 6, "defined_type_name": "journal contribution", "group_id": 46198, "url_private_api": "https://api.figshare.com/v2/account/articles/22535143", "url_public_api": "https://api.figshare.com/v2/articles/22535143", "url_private_html": "https://figshare.com/account/articles/22535143", "url_public_html": "https://aacr.figshare.com/articles/journal_contribution/Figure_S17_from_i_In_Vivo_i_Epigenetic_CRISPR_Screen_Identifies_i_Asf1a_i_as_an_Immunotherapeutic_Target_in_i_Kras_i_-Mutant_Lung_Adenocarcinoma/22535143", "timeline": {"posted": "2023-04-03T22:21:23", "publisherPublication": "2020-02-01T00:00:00", "firstOnline": "2023-04-03"}, "resource_title": "<i>In Vivo</i> Epigenetic CRISPR Screen Identifies <i>Asf1a</i> as an Immunotherapeutic Target in <i>Kras</i>-Mutant Lung Adenocarcinoma", "resource_doi": "10.1158/2159-8290.CD-19-0780"}