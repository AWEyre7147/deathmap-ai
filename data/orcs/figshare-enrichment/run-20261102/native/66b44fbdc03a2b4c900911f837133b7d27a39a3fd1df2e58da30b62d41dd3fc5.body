{"files": [{"id": 14816243, "name": "ppat.1007704.s001.docx", "size": 759463, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816243", "supplied_md5": "c68ff9738868b0c08f7904d1272eab71", "computed_md5": "c68ff9738868b0c08f7904d1272eab71", "mimetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}, {"id": 14816246, "name": "ppat.1007704.s002.docx", "size": 363945, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816246", "supplied_md5": "0e2a3185ae3eb35ee1ad728e38e5247d", "computed_md5": "0e2a3185ae3eb35ee1ad728e38e5247d", "mimetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}, {"id": 14816249, "name": "ppat.1007704.s003.xls", "size": 9500672, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816249", "supplied_md5": "288d8da1e57ed7f4de72e8c273e06803", "computed_md5": "288d8da1e57ed7f4de72e8c273e06803", "mimetype": "application/CDFV2"}, {"id": 14816252, "name": "ppat.1007704.s004.xls", "size": 14086656, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816252", "supplied_md5": "fb0fd9c67e4da07a425f5fec666c7c6f", "computed_md5": "fb0fd9c67e4da07a425f5fec666c7c6f", "mimetype": "application/CDFV2"}, {"id": 14816255, "name": "ppat.1007704.s005.pdf", "size": 19238, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816255", "supplied_md5": "8d040b67717522aa76649ad48acd446d", "computed_md5": "8d040b67717522aa76649ad48acd446d", "mimetype": "application/pdf"}, {"id": 14816258, "name": "ppat.1007704.s006.pdf", "size": 53290, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/14816258", "supplied_md5": "c171bd6be102c3448dc520986616ca36", "computed_md5": "c171bd6be102c3448dc520986616ca36", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 449259, "full_name": "Shu-Jung Chang", "first_name": "Shu-Jung", "last_name": "Chang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 449595, "full_name": "Sheng Chih Jin", "first_name": "Sheng", "last_name": "Chih Jin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 6560540, "full_name": "Xuyao Jiao", "first_name": "Xuyao", "last_name": "Jiao", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 114934, "full_name": "Jorge E. Gal\u00e1n", "first_name": "Jorge", "last_name": "E. Gal\u00e1n", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://plos.figshare.com/articles/dataset/Unique_features_in_the_intracellular_transport_of_typhoid_toxin_revealed_by_a_genome-wide_screen/7960481", "download_disabled": false, "description": "<div><p>Typhoid toxin is a virulence factor for <i>Salmonella</i> Typhi and Paratyphi, the cause of typhoid fever in humans. This toxin has a unique architecture in that its pentameric B subunit, made of PltB, is linked to two enzymatic A subunits, the ADP ribosyl transferase PltA and the deoxyribonuclease CdtB. Typhoid toxin is uniquely adapted to humans, recognizing surface glycoprotein sialoglycans terminated in acetyl neuraminic acid, which are preferentially expressed by human cells. The transport pathway to its cellular targets followed by typhoid toxin after receptor binding is currently unknown. Through a genome-wide CRISPR/Cas9-mediated screen we have characterized the mechanisms by which typhoid toxin is transported within human cells. We found that typhoid toxin hijacks specific elements of the retrograde transport and endoplasmic reticulum-associated degradation machineries to reach its subcellular destination within target cells. Our study reveals unique and common features in the transport mechanisms of bacterial toxins that could serve as the bases for the development of novel anti-toxin therapeutic strategies.</p></div>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 24783264, "created_date": "2019-04-05T17:30:48Z", "modified_date": "2023-06-02T21:04:45Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["pentameric B subunit", "genome-wide screen Typhoid toxin", "endoplasmic reticulum-associated degradation machineries", "typhoid toxin hijacks", "acetyl neuraminic acid", "CRISPR", "ADP ribosyl transferase PltA", "typhoid toxin", "surface glycoprotein sialoglycans"], "keywords": ["pentameric B subunit", "genome-wide screen Typhoid toxin", "endoplasmic reticulum-associated degradation machineries", "typhoid toxin hijacks", "acetyl neuraminic acid", "CRISPR", "ADP ribosyl transferase PltA", "typhoid toxin", "surface glycoprotein sialoglycans"], "categories": [{"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 931, "title": "Information Systems not elsewhere classified", "parent_id": 52, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 132, "title": "Infectious Diseases", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 134, "title": "Virology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1371/journal.ppat.1007704"], "has_linked_file": false, "citation": "Chang, Shu-Jung; Chih Jin, Sheng; Jiao, Xuyao; E. Gal\u00e1n, Jorge (2019). Unique features in the intracellular transport of typhoid toxin revealed by a genome-wide screen. PLOS Pathogens. Dataset. https://doi.org/10.1371/journal.ppat.1007704", "related_materials": [{"id": 33356981, "identifier": "10.1371/journal.ppat.1007704", "title": "Unique features in the intracellular transport of typhoid toxin revealed by a genome-wide screen", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1371/journal.ppat.1007704"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 7960481, "title": "Unique features in the intracellular transport of typhoid toxin revealed by a genome-wide screen", "doi": "10.1371/journal.ppat.1007704", "handle": "", "url": "https://api.figshare.com/v2/articles/7960481", "published_date": "2019-04-05T17:30:43Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-plos-725668748/14816258/thumb.png", "defined_type": 3, "defined_type_name": "dataset", "group_id": 113, "url_private_api": "https://api.figshare.com/v2/account/articles/7960481", "url_public_api": "https://api.figshare.com/v2/articles/7960481", "url_private_html": "https://figshare.com/account/articles/7960481", "url_public_html": "https://plos.figshare.com/articles/dataset/Unique_features_in_the_intracellular_transport_of_typhoid_toxin_revealed_by_a_genome-wide_screen/7960481", "timeline": {"posted": "2019-04-05T17:30:43", "firstOnline": "2019-04-17"}, "resource_title": "Unique features in the intracellular transport of typhoid toxin revealed by a genome-wide screen", "resource_doi": "10.1371/journal.ppat.1007704"}