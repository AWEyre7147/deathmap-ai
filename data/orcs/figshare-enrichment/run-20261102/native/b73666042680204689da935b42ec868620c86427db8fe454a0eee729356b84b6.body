{"files": [{"id": 39868293, "name": "00085472can183024-sup-209379_2_supp_5376442_pnplwj.docx", "size": 19035, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/39868293", "supplied_md5": "8173cfffb4f1377c23a71856f21eedf1", "computed_md5": "8173cfffb4f1377c23a71856f21eedf1", "mimetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}], "folder_structure": {}, "authors": [{"id": 1865293, "full_name": "Changlong Liu", "first_name": "Changlong", "last_name": "Liu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14936472, "full_name": "Carolyn E. Banister", "first_name": "Carolyn E.", "last_name": "Banister", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14936475, "full_name": "Phillip J. Buckhaults", "first_name": "Phillip J.", "last_name": "Buckhaults", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "TP53 mutations are common in most human cancers, but few therapeutic options for TP53-mutant tumors exist. To identify potential therapeutic options for cancer patients with TP53 mutations, we profiled 127 FDA-approved chemotherapy drugs against human embryonic stem cells (hESC) in which we engineered TP53 deletion by genome editing. We identified 27 cancer therapeutic drugs for which TP53 mutations conferred resistance; most of these drugs target DNA synthesis or topoisomerase and cause DNA damage. We then performed a genome-wide CRISPR/Cas9 knockout screen in the TP53-null hESC in the presence and absence of sublethal concentrations of cisplatin and identified 137 genes whose loss selectively resensitized the p53-null cells to this chemotherapeutic agent. Gene ontology classification of the resensitizing loci revealed significant overrepresentation of spindle checkpoint pathway genes. Moreover, we confirmed that targeting ZNF207/BuGZ sensitizes p53-null hESC to cisplatin. These data indicate that targeted inhibition of spindle assembly checkpoints (SAC) and chromosomal organizing centers may provide a way to treat p53-deficient cancer cells with standard chemotherapy drugs. Development of small-molecule inhibitors of SAC proteins may be a useful strategy for rescuing DNA-damaging chemotherapeutics in TP53-mutant cancers.\nThese findings show that inhibition of spindle assembly checkpoints and chromosomal organizing centers may provide a new way to treat p53-deficient cancer cells with standard chemotherapy drugs.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_figures_legends_from_Spindle_Assembly_Checkpoint_Inhibition_Can_Resensitize_p53-Null_Stem_Cells_to_Cancer_Chemotherapy/22422060", "download_disabled": false, "description": "<p>Supplementary figures legends</p>", "funding": "NIH", "funding_list": [{"id": 29591, "title": "NIH", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 19035, "created_date": "2023-03-31T02:42:39Z", "modified_date": "2023-06-14T20:53:34Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Chemotherapy", "Drug Resistance", "Reversal of drug resistance", "Drug Targets", "Gastrointestinal Cancers", "Colorectal cancer"], "keywords": ["Chemotherapy", "Drug Resistance", "Reversal of drug resistance", "Drug Targets", "Gastrointestinal Cancers", "Colorectal cancer"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37360, "title": "Therapeutic Research and Development", "parent_id": 0, "path": "/37360", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/0008-5472.CAN-18-3024"], "has_linked_file": false, "citation": "Liu, Changlong; Banister, Carolyn E.; Buckhaults, Phillip J. (2019). Supplementary figures legends from Spindle Assembly Checkpoint Inhibition Can Resensitize p53-Null Stem Cells to Cancer Chemotherapy. American Association for Cancer Research. Journal contribution. https://doi.org/10.1158/0008-5472.22422060.v1", "related_materials": [{"id": 84744945, "identifier": "10.1158/0008-5472.CAN-18-3024", "title": "Spindle Assembly Checkpoint Inhibition Can Resensitize p53-Null Stem Cells to Cancer Chemotherapy", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1158/0008-5472.CAN-18-3024"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22422060, "title": "Supplementary figures legends from Spindle Assembly Checkpoint Inhibition Can Resensitize p53-Null Stem Cells to Cancer Chemotherapy", "doi": "10.1158/0008-5472.22422060.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/22422060", "published_date": "2023-03-31T02:42:39Z", "thumb": "https://s3-eu-west-1.amazonaws.com/figshare-production-eu-aacr-previews2426-eu-west-1/39868293/thumb.png", "defined_type": 6, "defined_type_name": "journal contribution", "group_id": 46225, "url_private_api": "https://api.figshare.com/v2/account/articles/22422060", "url_public_api": "https://api.figshare.com/v2/articles/22422060", "url_private_html": "https://figshare.com/account/articles/22422060", "url_public_html": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_figures_legends_from_Spindle_Assembly_Checkpoint_Inhibition_Can_Resensitize_p53-Null_Stem_Cells_to_Cancer_Chemotherapy/22422060", "timeline": {"posted": "2023-03-31T02:42:39", "publisherPublication": "2019-05-01T00:00:00", "firstOnline": "2023-03-31"}, "resource_title": "Spindle Assembly Checkpoint Inhibition Can Resensitize p53-Null Stem Cells to Cancer Chemotherapy", "resource_doi": "10.1158/0008-5472.CAN-18-3024"}