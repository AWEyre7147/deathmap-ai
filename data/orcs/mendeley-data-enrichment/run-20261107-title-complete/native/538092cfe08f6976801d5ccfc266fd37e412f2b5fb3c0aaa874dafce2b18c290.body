{"records":[{"id":"bn3mzvwpb6","title":"CDC42 regulates the PYRIN inflammasome assembly","description":"original blots ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-10-26T11:19:54.988Z","url":"https://data.mendeley.com/datasets/bn3mzvwpb6","data_type":"dataset","access":"open","doi":["10.17632/bn3mzvwpb6"],"contributors":[{"first_name":"Fabio","last_name":"Martinon","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"gnmtvnjd7w","title":"Target Bile Acid Metabolomics Data","description":"Circadian disruption exacerbates MASH in mice by reducing intestinal Akkermansia muciniphila abundance via the FXR-CYP7A1-bile acid axis--Target Bile Acid Metabolomics Data\nSpecies name: Mus musculus (mouse)   Sample source: Mouse bile\nThe data shows: The biosynthetic metabolic pathways of bile acids in the bile of MASH mice with disrupted circadian rhythms are altered   ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-10-17T14:50:05.04Z","url":"https://data.mendeley.com/datasets/gnmtvnjd7w","data_type":"dataset","access":"open","doi":["10.17632/gnmtvnjd7w"],"contributors":[{"first_name":"Jin-Shui","last_name":"Pan","orcid":null}],"funders":[],"categories":["Fatty Liver Disease"],"journal_issn":[]},{"id":"ck7zws55g2","title":"Allo litocholic acid, a microbiome derived secondary bile acid, attenuates liver fibrosis","description":"Bile acids (BAs) are amphipatic molecules synthesized in the liver. Beside their role in nutrient absorption, BAs act as signaling molecules exerting a variety of regulatory function by activating a family of receptors called “bile acid-regulated receptors” (BARRs). From primary bile acid, these molecules undergo extensive microbial modifications in the intestine, generating secondary bile acids such as deoxycholic acid (DCA), lithocholic acid (LCA), and derivatives, including allo-LCA. Recent studies have shown that these bile acids can act simultaneously as GPBAR1 agonist and as RORγt inverse agonist. The aim of the study was to evaluate the effect of the administration of Allo-LCA, in preventing the development of MASH","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-12-10T16:39:19.034Z","url":"https://data.mendeley.com/datasets/ck7zws55g2","data_type":"dataset","access":"open","doi":["10.17632/ck7zws55g2"],"contributors":[{"first_name":"silvia","last_name":"marchianò","orcid":null},{"first_name":"Stefano","last_name":"Fiorucci","orcid":null},{"first_name":"Cristina","last_name":"Di Giorgio","orcid":null},{"first_name":"Michele","last_name":"Biagioli","orcid":null}],"funders":[],"categories":["Transcriptome","Metagenomic Next-Generation Sequencing"],"journal_issn":[]},{"id":"hm4ntxztws","title":"The mechanosensitive TRPV4 is required for crystal-induced inflammation ------ TRPV4 mediates crystal-induced inflammation","description":"1. Macrophage-expressed TRPV4 is essential to the generation of crystal-induced joint pain and inflammation and inflammatory responses evoked by diverse crystalline structures.  \n2. TRPV4 is critically involved in the activation of macrophage NLRP3 inflammasome and production of the inflammatory cytokine IL-1 induced by diverse crystalline materials but not non- crystalline NLRP3 inflammasome activators.\n3. A neuroimmune interaction between the TRPV1-expressing primary nociceptors and the TRPV4-expressing synovial macrophages is an important cellular mechanism behind acute gout flares.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-09-03T07:58:39.422Z","url":"https://data.mendeley.com/datasets/hm4ntxztws","data_type":"dataset","access":"open","doi":["10.17632/hm4ntxztws"],"contributors":[{"first_name":"Lvyi","last_name":"Chen","orcid":null}],"funders":[],"categories":["Behavioral Medicine"],"journal_issn":[]},{"id":"mddbrr9ksc","title":"Targeted bile acids measurements","description":"Targeted bile acid measurements of major bile acids of human and mice subjects","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-06-05T09:44:44.115Z","url":"https://data.mendeley.com/datasets/mddbrr9ksc","data_type":"dataset","access":"open","doi":["10.17632/mddbrr9ksc"],"contributors":[{"first_name":"Liu","last_name":"Linhu","orcid":null}],"funders":[],"categories":["Metabolomics","Bile Acid"],"journal_issn":[]},{"id":"3dhymjr272","title":"Targeted bile acid metabolomics ","description":"Targeted bile acid metabolomics measured human and mice major bile acids with their respective glycine and taurine conjugates.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-10-14T14:25:35.208Z","url":"https://data.mendeley.com/datasets/3dhymjr272","data_type":"dataset","access":"open","doi":["10.17632/3dhymjr272"],"contributors":[{"first_name":"lingju","last_name":"chu","orcid":null}],"funders":[],"categories":["Mouse","Metabolomics","Bile Acid","Acute Pancreatitis","Human"],"journal_issn":[]},{"id":"vtpjtgm2tw","title":"Arachidonic acid inhibition of the NLRP3 inflammasome: a mechanism to explain the anti-inflammatory effects of fasting","description":"Data for the paper \"Arachidonic acid inhibition of the NLRP3 inflammasome: a mechanism to explain the anti-inflammatory effects of fasting\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-01-25T06:37:46.877Z","url":"https://data.mendeley.com/datasets/vtpjtgm2tw","data_type":"dataset","access":"open","doi":["10.17632/vtpjtgm2tw"],"contributors":[{"first_name":"Milton","last_name":"Pereira","orcid":null}],"funders":[],"categories":["Eicosanoid","Innate Immunity","Inflammasome"],"journal_issn":[]},{"id":"z757nyv2b2","title":"Impaired GPBAR1-mediated bile acid sensing promotes IL-23/Th17-dependent inflammation in primary sclerosing cholangitis.","description":"Primary sclerosing cholangitis (PSC) is a chronic cholangiopathy characterized by progressive inflammation and fibrosis of the biliary tree, with limited therapeutic options. Dysregulated immune responses and altered bile acid signaling are hallmarks of the disease, but how these processes intersect at the level of cholangiocytes remains incompletely understood. We explored the contribution of impaired bile acid sensing in cholangiocytes to activation of the interleukin-23 (IL-23)/T helper 17 (Th17) axis in PSC. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-07-23T22:37:18.801Z","url":"https://data.mendeley.com/datasets/z757nyv2b2","data_type":"dataset","access":"open","doi":["10.17632/z757nyv2b2"],"contributors":[{"first_name":"Cristina","last_name":"Di Giorgio","orcid":null},{"first_name":"silvia","last_name":"marchianò","orcid":null},{"first_name":"Michele","last_name":"Biagioli","orcid":null},{"first_name":"Stefano","last_name":"Fiorucci","orcid":null}],"funders":[],"categories":["Bile Acid","Transcriptome","Primary Sclerosing Cholangitis"],"journal_issn":[]},{"id":"86dbkpf9z7","title":"Long-term bis(2-ethylhexyl)-2,3,4,5-tetrabromophthalate exposure induces bile acid abnormal accumulation in rats: Insights from the microbiota-gut-liver axis","description":"Microbiomics andTargeted bile acid metabolism profile","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-01T16:16:21.634Z","url":"https://data.mendeley.com/datasets/86dbkpf9z7","data_type":"dataset","access":"open","doi":["10.17632/86dbkpf9z7"],"contributors":[{"first_name":"小天","last_name":"黄","orcid":null}],"funders":[],"categories":["Microbiology","Omics"],"journal_issn":[]},{"id":"mryhjswtfv"