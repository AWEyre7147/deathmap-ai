{"records":[{"id":"km23bwyny6","title":"Identification of required host factors for SARS-CoV-2 infection in human cells, Daniloski et al","description":"Supplementary Tables S1 to S6 in MS Excel format for \"Identification of required host factors for SARS-CoV-2 infection in human cells\" by Daniloski*, Jordan* et al. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-21T14:00:41.151Z","url":"https://data.mendeley.com/datasets/km23bwyny6","data_type":"dataset","access":"open","doi":["10.17632/km23bwyny6"],"contributors":[{"first_name":"Zharko","last_name":"Daniloski","orcid":null},{"first_name":"Tristan","last_name":"Jordan","orcid":null},{"first_name":"Hans-Hermann","last_name":"Wessels","orcid":null},{"first_name":"Daisy","last_name":"Hoagland","orcid":null},{"first_name":"Silva","last_name":"Kasela","orcid":null},{"first_name":"Mateusz","last_name":"Legut","orcid":null},{"first_name":"Silas","last_name":"Maniatis","orcid":null},{"first_name":"Eleni","last_name":"Mimitou","orcid":null},{"first_name":"Lu","last_name":"Lu","orcid":null},{"first_name":"Evan","last_name":"Geller","orcid":null},{"first_name":"Oded","last_name":"Danziger","orcid":null},{"first_name":"Brad","last_name":"Rosenberg","orcid":null},{"first_name":"Hemali","last_name":"Phatnani","orcid":null},{"first_name":"Peter","last_name":"Smibert","orcid":null},{"first_name":"Tuuli","last_name":"Lappalainen","orcid":null},{"first_name":"Benjamin","last_name":"tenOever","orcid":null},{"first_name":"Neville","last_name":"Sanjana","orcid":null}],"funders":[],"categories":["Virology","Genomics"],"journal_issn":[]},{"id":"9x47wzy8x7","title":"A study of \"Genome-wide CRISPR screens reveal host factors critical for SARS-CoV-2 infection\" by Wei et al. Cell 2020","description":"Identification of host genes essential for SARS-CoV-2 infection may reveal novel therapeutic targets and inform our understanding of COVID-19 pathogenesis. Here, we performed genome-wide CRISPR screens in Vero-E6 cells with SARS-CoV-2, MERS-CoV, bat coronavirus HKU5 expressing the SARS-CoV-1 spike, and VSV expressing the SARS-CoV-2 spike. Together this identifies potential therapeutic targets for SARS-CoV-2 and reveals SARS-lineage specific and pan-coronavirus host factors that regulate susceptibility to highly pathogenic coronaviruses.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-15T21:29:14.06Z","url":"https://data.mendeley.com/datasets/9x47wzy8x7","data_type":"dataset","access":"open","doi":["10.17632/9x47wzy8x7"],"contributors":[{"first_name":"Craig","last_name":"Wilen","orcid":null}],"funders":[],"categories":["CRISPR","Middle East Respiratory Syndrome-Related Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"gcdpsxd6d5","title":"RNAi screening using HK-2 cells: insights into the roles of soluble ACE2 in SARS-CoV-2 infection. Yeung et al","description":"Severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) can cause acute respiratory disease and multiorgan failure. Finding human host factors that are essential for SARS-CoV-2 infection could facilitate the formulation of treatment strategies. Using a human kidney cell line—HK-2—that is highly susceptible to SARS-CoV-2, we performed a genome-wide RNAi screening and identified virus dependency factors (VDFs), which play regulatory roles in biological pathways linked to clinical manifestations of SARS-CoV-2 infection. Importantly, we discovered an overlooked role of a secretory form of SARS-CoV-2 receptor, soluble angiotensin converting enzyme 2 (sACE2), in SARS-CoV-2 infection. Further investigations revealed that SARS-CoV-2 exploits receptor-mediated endocytosis through interaction between its spike with sACE2 or sACE2-vasopressin via AT1 or AVPR1B, respectively. Our identification of new VDFs and the regulatory effect of sACE2 on SARS-CoV-2 infection shed new insights into pathogenesis and cell entry mechanism of SARS-CoV-2 as well as potential treatment strategies for COVID-19.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-02-22T23:41:07.557Z","url":"https://data.mendeley.com/datasets/gcdpsxd6d5","data_type":"dataset","access":"open","doi":["10.17632/gcdpsxd6d5"],"contributors":[{"first_name":"Man Lung","last_name":"Yeung","orcid":null}],"funders":[],"categories":["Screening","RNA Knockdown"],"journal_issn":[]},{"id":"72tr8jj8y4","title":"RNAi screening using HK-2 cells: insights into the roles of soluble ACE2 in SARS-CoV-2 infection. Yeung et al","description":"Severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) can cause acute respiratory disease and multiorgan failure. Finding human host factors that are essential for SARS-CoV-2 infection could facilitate the formulation of treatment strategies. Using a human kidney cell line—HK-2—that is highly susceptible to SARS-CoV-2, we performed a genome-wide RNAi screening and identified virus dependency factors (VDFs), which play regulatory roles in biological pathways linked to clinical manifestations of SARS-CoV-2 infection. Importantly, we discovered an overlooked role of a secretory form of SARS-CoV-2 receptor, soluble angiotensin converting enzyme 2 (sACE2), in SARS-CoV-2 infection. Further investigations revealed that SARS-CoV-2 exploits receptor-mediated endocytosis through interaction between its spike with sACE2 or sACE2-vasopressin via AT1 or AVPR1B, respectively. Our identification of new VDFs and the regulatory effect of sACE2 on SARS-CoV-2 infection shed new insights into pathogenesis and cell entry mechanism of SARS-CoV-2 as well as potential treatment strategies for COVID-19.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-02-22T23:48:03.555Z","url":"https://data.mendeley.com/datasets/72tr8jj8y4","data_type":"dataset","access":"open","doi":["10.17632/72tr8jj8y4"],"contributors":[{"first_name":"Man Lung","last_name":"Yeung","orcid":null}],"funders":[],"categories":["Vasopressin","Screening","RNA Knockdown","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"7bd5bhmhmz","title":"Genome-scale identification of SARS-CoV-2 and pan-coronavirus host factor networks. Schneider et al.","description":"The COVID-19 pandemic has claimed the lives of more than one million people worldwide. The causative agent, SARS-CoV-2, is a member of the Coronaviridae family, which are viruses that cause respiratory infections of varying severity. The cellular host factors and pathways co-opted by SARS- CoV-2 and other coronaviruses in the execution of their life cycles remain ill-defined. To develop an extensive compendium of host factors required for infection by SARS-CoV-2 and three seasonal coronaviruses (HCoV-OC43, HCoV-NL63, and HCoV-229E), we performed parallel genome-scale CRISPR knockout screens. These screens uncovered multiple host factors and pathways with pan- coronavirus and virus-specific functional roles, including major dependency on glycosaminoglycan biosynthesis, SREBP signaling, BMP signaling, and glycosylphosphatidylinositol biosynthesis, as well as a requirement for several poorly characterized proteins. We identified an absolute requirement for the VTT-domain containing protein TMEM41B for infection by SARS-CoV-2 and three seasonal coronaviruses. This human Coronaviridae host factor compendium represents a rich resource to develop new therapeutic strategies for acute COVID-19 and potential future coronavirus spillover events.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-12-03T09:15:53.589Z","url":"https://data.mendeley.com/datasets/7bd5bhmhmz","data_type":"dataset","access":"open","doi":["10.17632/7bd5bhmhmz"],"contributors":[{"first_name":"JT","last_name":"Poirier","orcid":null}],"funders":[],"categories":["Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"57j37g6kdh","title":"High-resolution photocatalytic mapping of SARS-CoV-2 spike interactions on the cell surface. Datta et al","description":"Identifying virus-host interactions on the cell surface can improve our understanding of viral entry and pathogenesis. SARS-CoV-2, the causative agent of the COVID-19 disease, uses ACE2 as a receptor to enter cells. Yet the full repertoire of cell surface proteins that contribute to viral entry is unknown. We developed a photocatalyst-based viral-host protein microenvironment mapping platform (ViraMap) to probe the molecular neighborhood of the SARS-CoV-2 spike protein on the human cell surface. Application of ViraMap to ACE2-expressing cells captured ACE2, the established co-receptor NRP1, and several novel cell surface proteins. We systematically analyzed the relevance of these candidate proteins to SARS-CoV-2 entry by knockdown and overexpression approaches in pseudovirus and authentic infection models and identified PTGFRN and EFNB1 as bona fide viral entry factors. Our results highlight additional host targets that participate in SARS-CoV-2 infection and showcase ViraMap as a powerful platform for defining viral interactions on the cell surface.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-07T06:19:10.123Z","url":"https://data.mendeley.com/datasets/57j37g6kdh","data_type":"dataset","access":"open","doi":["10.17632/57j37g6kdh"],"contributors":[{"first_name":"Mohsan","last_name":"Saeed","orcid":null},{"first_name":"Suprama","last_name":"Datta","orcid":null}],"funders":[],"categories":["Proteomics"],"journal_issn":[]},{"id":"wxy2fkp5w8","title":"A study of \"Super-resolution proximity labeling reveals antiviral protein network and its structural changes against SARS-CoV-2 viral proteins\". Lee et al.","description":"SARS-CoV-2 replicates in human cells by interacting with host factors following infection. To understand the virus and host interactome, proximity, we introduce a super-resolution proximity labeling (SR-PL) method with “plug and playable” PL enzyme, TurboID-GBP (GFP binding protein) and we apply it for interactome mapping of SARS-CoV-2 ORF3a and M, which generates highly perturbed ER structures. Through SR-PL analysis of the biotinylated interactome, 224 and 272 peptides are robustly identified as ORF3a and M interactomes, respectively. Within the ORF3a interactome, RNF5 co-localizes with ORF3a and generates ubiquitin modifications of ORF3a that can be involved in protein degradation. We also observe that the SARS-CoV-2 infection rate is efficiently reduced by the overexpression of RNF5 in host cells. The interactome data obtains using the SR-PL method are presented in https://sarscov2.spatiomics.org. We hope that our method will contribute to revealing virus–host interactions of other viruses in an efficient manner.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-26T18:43:48.578Z","url":"https://data.mendeley.com/datasets/wxy2fkp5w8","data_type":"dataset","access":"open","doi":["10.17632/wxy2fkp5w8"],"contributors":[{"first_name":"Yun-Bin","last_name":"Lee","orcid":null},{"first_name":"Minkyo","last_name":"Jung","orcid":null},{"first_name":"Jeesoo","last_name":"Kim","orcid":null},{"first_name":"Afandi","last_name":"Charles","orcid":null},{"first_name":"Wanda","last_name":"Christ","orcid":null},{"first_name":"Jiwoong","last_name":"Kang","orcid":null},{"first_name":"Myeong-Gyun","last_name":"Kang","orcid":null},{"first_name":"Chulhwan","last_name":"Kwak","orcid":null},{"first_name":"Jonas","last_name":"Klingström","orcid":null},{"first_name":"Anna","last_name":"Smed-Sörensen","orcid":null},{"first_name":"Jong-Seo","last_name":"Kim","orcid":null},{"first_name":"JiYoung","last_name":"Mun","orcid":null},{"first_name":"Hyun-Woo","last_name":"Rhee","orcid":null}],"funders":[{"id":"https://ror.org/00fdzyk40","name":"Korea Health Industry Development Institute","grant_id":null},{"id":"https://ror.org/013aysd81","name":"National Research Foundation of Korea","grant_id":"NRF-2020K1A3A1A47110634, NRF-2021K2A9A1A01102293, NRF-2022R1A2B5B03001658, NRF-2022M3H9A2096199, 2022M3E5E8081185 to H.-W.R.; NRF-2022M3A9I2082294, NRF-2021R1A2C2009336 to J.-S.K."},{"id":"https://ror.org/055zd7d59","name":"Korea Brain Research Institute","grant_id":"23-BR-01-03"},{"id":"https://ror.org/00gjmje40","name":"Samsung Science and Technology Foundation (South Korea)","grant_id":"SSTF-BA2201-08"},{"id":"https://ror.org/04w3jy968","name":"Samsung (South Korea)","grant_id":"IO220819-02121-01"}],"categories":["Cell Biology"],"journal_issn":[]},{"id":"kfdxbzwhfj","title":"A study of \"Super-resolution proximity labeling reveals antiviral protein network and its structural changes against SARS-CoV-2 viral proteins\". Lee et al.","description":"SARS-CoV-2 replicates in human cells by interacting with host factors following infection. To understand the virus and host interactome, proximity, we introduce a super-resolution proximity labeling (SR-PL) method with “plug and playable” PL enzyme, TurboID-GBP (GFP binding protein) and we apply it for interactome mapping of SARS-CoV-2 ORF3a and M, which generates highly perturbed ER structures. Through SR-PL analysis of the biotinylated interactome, 224 and 272 peptides are robustly identified as ORF3a and M interactomes, respectively. Within the ORF3a interactome, RNF5 co-localizes with ORF3a and generates ubiquitin modifications of ORF3a that can be involved in protein degradation. We also observe that the SARS-CoV-2 infection rate is efficiently reduced by the overexpression of RNF5 in host cells. The interactome data obtains using the SR-PL method are presented in https://sarscov2.spatiomics.org. We hope that our method will contribute to revealing virus–host interactions of other viruses in an efficient manner.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-27T19:21:30.185Z","url":"https://data.mendeley.com/datasets/kfdxbzwhfj","data_type":"dataset","access":"open","doi":["10.17632/kfdxbzwhfj"],"contributors":[{"first_name":"Yun-Bin","last_name":"Lee","orcid":null},{"first_name":"Minkyo","last_name":"Jung","orcid":null},{"first_name":"Jeesoo","last_name":"Kim","orcid":null},{"first_name":"Afandi","last_name":"Charles","orcid":null},{"first_name":"Wanda","last_name":"Christ","orcid":null},{"first_name":"Jiwoong","last_name":"Kang","orcid":null},{"first_name":"Myeong-Gyun","last_name":"Kang","orcid":null},{"first_name":"Chulhwan","last_name":"Kwak","orcid":null},{"first_name":"Jonas","last_name":"Klingström","orcid":null},{"first_name":"Jong-Seo","last_name":"Kim","orcid":null},{"first_name":"JiYoung","last_name":"Mun","orcid":null},{"first_name":"Hyun-Woo","last_name":"Rhee","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"96jwcyxgn6","title":"An Airway Organoid-Based Screen Identifies a Role for the HIF1α-Glycolysis Axis in SARS-CoV-2 Infection ","description":"SARS-CoV-2 causes the COVID-19 pandemic. It is urgent to develop disease models to dissect mechanisms regulating SARS-CoV-2 infection. Here, we derive airway organoids from human pluripotent stem cells (hPSC-AOs). The hPSC-AOs, particularly ciliated-like cells, are permissive to SARS-CoV-2 infection. Using this platform, we perform a high content screen and identify GW6471, which blocks SARS-CoV-2 infection. GW6471 can also block infection of the B.1.351 SARS-CoV-2 variant. RNA-seq analysis suggests that GW6471 blocks SARS-CoV-2 infection at least in part by inhibiting HIF1α, which is further validated by chemical inhibitor and genetic perturbation targeting HIF1α. Metabolic profiling identifies decreased rates of glycolysis upon GW6471 treatment, consistent with transcriptome profiling. Finally, xanthohumol, 5-(Tetradecyloxy)-2-furoic acid, and ND-646, three compounds that suppress fatty acid biosynthesis, also block SARS-CoV-2 infection. Together, a high content screen coupled with transcriptome and metabolic profiling reveals a key role of the HIF1α-glycolysis axis in mediating SARS-CoV-2 infection of human airway epithelium.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-10-08T10:41:17.03Z","url":"https://data.mendeley.com/datasets/96jwcyxgn6","data_type":"dataset","access":"open","doi":["10.17632/96jwcyxgn6"],"contributors":[{"first_name":"Shuibing","last_name":"Chen","orcid":null}],"funders":[],"categories":["Supplemental Irrigation"],"journal_issn":[]},{"id":"9rc2n4bkmv","title":"Functional interrogation of a SARS-CoV-2 host protein interactome identifies unique and shared coronavirus host factors. Hoffmann et al.","description":"The ongoing SARS-CoV-2 pandemic has devastated the global economy and claimed more than one million lives, presenting an urgent global health crisis. To identify host factors required for infection by SARS-CoV-2 and seasonal coronaviruses, we designed a focused high-coverage CRISPR-Cas9 library targeting 332 members of a recently published SARS-CoV-2 protein interactome. We leveraged the compact nature of this library to systematically screen SARS-CoV-2 at two physiologically relevant temperatures (33 ºC and 37 ºC) along with three related coronaviruses (HCoV-229E, HCoV-NL63, and HCoV-OC43), allowing us to probe this interactome at a much higher resolution relative to genome scale studies. This approach yielded several new insights, including unexpected virus-specific differences in Rab GTPase requirements and GPI anchor biosynthesis, as well as identification of multiple pan-coronavirus factors involved in cholesterol homeostasis. This coronavirus essentiality catalog could inform ongoing drug development efforts aimed at intercepting and treating COVID-19, and help prepare for future coronavirus outbreaks.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-11-25T19:01:19.445Z","url":"https://data.mendeley.com/datasets/9rc2n4bkmv","data_type":"dataset","access":"open","doi":["10.17632/9rc2n4bkmv"],"contributors":[{"first_name":"JT","last_name":"Poirier","orcid":null}],"funders":[],"categories":["Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]}],"total_records":142828,"page":1,"page_size":10,"execution_time":171,"aggregations":{"data_type_stats":{"dataset":142828,"collection":0},"access_type_stats":{"open":142016,"restricted":72,"embargoed":740},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2340},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1438},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":703},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":480},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":443},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":427},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":410},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":399},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":335},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":283}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":140160},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1910},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":189},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":141},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":79},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":58},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":41},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":28}],"top_institutions_stats":[{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":912},{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":907},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":537},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":410},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":381}]}}