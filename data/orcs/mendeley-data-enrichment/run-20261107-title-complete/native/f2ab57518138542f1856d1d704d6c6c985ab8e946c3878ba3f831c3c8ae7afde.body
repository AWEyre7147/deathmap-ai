{"records":[{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"3nbg93bkbf","title":"Avian influenza A(H10Nx) infections in humans in China, 2013–2025: epidemiology, phylogenetics, and mammalian adaptive evolution","description":"Table 1 Clinical characteristics of human infections with avian influenza A H10Nx virus, China, 2013-2025.\n\nTable 2 Important mammalian adapting molecular markers from eight human-origin H10Nx isolates.\n\nFigure 1. Geographic and temporal distribution of human H10Nx infections in China, 2013-2025.\n\n\nFigure 2. Phylogenetic relationships of the HA and NA genes of human-origin H10Nx viruses.\n\n\nFigure 3. Amino acid conservation and frequency of key PB2 residues in avian H10Nx viruses.\n\n\nFigure 4. Global distribution, host range, and key PB2 residues of mammalian H10 subtype AIVs detected from 1984 to 2025.\n\n\nSupplementary Figure 1. Phylogenetic tree of the PB2 and PB1 genes of human-origin H10Nx avian influenza viruses.\nSupplementary Figure 2. Phylogenetic tree of the PA and NP genes of human-origin H10Nx avian influenza viruses.\n\nSupplementary Figure 3. Phylogenetic tree of the MP and NS genes of human-origin H10Nx avian influenza viruses.\n\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-30T06:59:24.528Z","url":"https://data.mendeley.com/datasets/3nbg93bkbf","data_type":"dataset","access":"open","doi":["10.17632/3nbg93bkbf"],"contributors":[{"first_name":"Yu","last_name":"Zhang","orcid":null}],"funders":[],"categories":["Virology","Epidemiology"],"journal_issn":[]},{"id":"9bzr2sykrs","title":"De Novo Transcriptome Assembly and Data for the Blue-winged Teal (Anas discors)","description":"The blue-winged teal (Anas discors) is a recreationally and ecologically important dabbling duck species in North America. Transcriptomic data of this species can be used in public and animal health studies given its role as a natural reservoir host for avian influenza, which can be a zoonotic disease of high concern. Ileum and bursa of Fabricius tissues were sampled from six captive raised blue-winged teals, four of the six who were experimentally infected with low-pathogenic avian influenza virus H5N9. RNAseq data were generated from extracted total mRNA from each tissue and pooled to create a de novo assembly of the transcriptome using Trinity. A total of 571,105 transcripts were identified at 449,956 unique unigenes that have been functionally annotated. This transcriptome will be useful for future blue-winged teal gene expression research, especially in hypothesis driven differential expression studies to determine the driving forces of avian influenza host-pathogen interactions, spatial distribution, and transmission.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-11-15T16:28:48.346Z","url":"https://data.mendeley.com/datasets/9bzr2sykrs","data_type":"dataset","access":"open","doi":["10.17632/9bzr2sykrs"],"contributors":[{"first_name":"Amanda","last_name":"Dolinski","orcid":null},{"first_name":"Jarred","last_name":"Homola","orcid":null},{"first_name":"Jen","last_name":"Owen","orcid":null},{"first_name":"Mark ","last_name":"Jankowski","orcid":null}],"funders":[],"categories":["Bioinformatics","Transcriptome"],"journal_issn":[]},{"id":"34xgdvvv3m","title":"Dataset for 'A Paper-based Loop-Mediated Isothermal Amplification Assay for Highly Pathogenic Avian Influenza'","description":"This dataset contains raw data used during the creation of an assay for detection of highly-pathogenic avian influenza (HPAI) virus type H5 (H5) and used for the publication in the article 'A Paper-based Loop-Mediated Isothermal Amplification Assay for Highly Pathogenic Avian Influenza' published in Scientific Reports.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-04-08T07:20:36.296Z","url":"https://data.mendeley.com/datasets/34xgdvvv3m","data_type":"dataset","access":"open","doi":["10.17632/34xgdvvv3m"],"contributors":[{"first_name":"Mohamed","last_name":"Kamel","orcid":null},{"first_name":"Josiah Levi","last_name":"Davidson","orcid":"0000-0002-2271-1984"},{"first_name":"Jenna M.","last_name":"Schober","orcid":null},{"first_name":"Gregory S. ","last_name":"Fraley","orcid":null},{"first_name":"Mohit","last_name":"Verma","orcid":null}],"funders":[],"categories":["Diagnostics","Avian Influenza Virus"],"journal_issn":[]},{"id":"pbp2sw6gg3","title":"VI-PPI","description":"Data for <<Purinne nucleotide phosphorylase dominates influenza A virus replication and host inflammation via purine salvage>>","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-05-06T05:28:46.983Z","url":"https://data.mendeley.com/datasets/pbp2sw6gg3","data_type":"dataset","access":"open","doi":["10.17632/pbp2sw6gg3"],"contributors":[{"first_name":"Qingyu","last_name":"Li","orcid":null}],"funders":[],"categories":["Mouse"],"journal_issn":[]},{"id":"j5tr34p3km","title":"Genomic Surveillance of Avian Influenza Virus (H5N1 2.3.4.4b) in Brazil","description":"The complete hemagglutinin (HA) gene sequence obtained in this study was compared with representative H5N1 avian influenza virus (AIV) sequences from Brazil and Colombia available in the GenBank database, including the earliest reported H5N1 sequence from South America. Multiple sequence alignment, phylogenetic reconstruction, and molecular clock analyses consistently placed the virus within clade 2.3.4.4b. To facilitate data sharing and support future evolutionary, epidemiological, and comparative investigations, the assembled HA sequence, together with its associated metadata, including host species, sampling locality, and collection date, was submitted to a publicly accessible nucleotide sequence database.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-25T20:25:50.611Z","url":"https://data.mendeley.com/datasets/j5tr34p3km","data_type":"dataset","access":"open","doi":["10.17632/j5tr34p3km"],"contributors":[{"first_name":"Yasmin","last_name":"Garcia","orcid":null}],"funders":[],"categories":["Virology","Epidemiology of Virology","Virology Analysis"],"journal_issn":[]},{"id":"5gwvp43yx8","title":"Genomic Surveillance of Avian Influenza Virus (H5N1 2.3.4.4b) in Brazil","description":"The complete hemagglutinin (HA) gene sequence obtained in this study was compared with representative H5N1 avian influenza virus (AIV) sequences from Brazil and Colombia available in the GenBank database, including the earliest reported H5N1 sequence from South America. Multiple sequence alignment, phylogenetic reconstruction, and molecular clock analyses consistently placed the virus within clade 2.3.4.4b. To facilitate data sharing and support future evolutionary, epidemiological, and comparative investigations, the assembled HA sequence, together with its associated metadata, including host species, sampling locality, and collection date, was submitted to a publicly accessible nucleotide sequence database.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-26T18:53:11.052Z","url":"https://data.mendeley.com/datasets/5gwvp43yx8","data_type":"dataset","access":"open","doi":["10.17632/5gwvp43yx8"],"contributors":[{"first_name":"Yasmin","last_name":"Garcia","orcid":null}],"funders":[],"categories":["Virology","Emerging Viruses","Virology Analysis"],"journal_issn":[]},{"id":"9pw3yyyr4c","title":"AgeingDysbiosis_GutLungAxis_Influenza_rnaseq_metagenomics","description":"Data derived from gene expression analysis: \"Age-Associated Gut Microbiota Dysbiosis Impairs Antiviral Defense During Influenza Virus Infection and Identifies Acetate as a Protective Mediator in Senescent Human Lung Cells\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-11-02T18:13:19.497Z","url":"https://data.mendeley.com/datasets/9pw3yyyr4c","data_type":"dataset","access":"open","doi":["10.17632/9pw3yyyr4c"],"contributors":[{"first_name":"Christoph","last_name":"Wernike","orcid":null},{"first_name":"Stefanie","last_name":"Deinhardt-Emmer","orcid":null}],"funders":[],"categories":["Metagenomics","RNA Sequencing","Aging","Influenza Virus","Gut Microbiome"],"journal_issn":[]},{"id":"wm43n6h5n3","title":"A targeted single amino acid mutation in influenza A virus universal epitope transforms immunogenicity and protective immunity via CD4 + T cell activation","description":"Data related to the submission of manuscript titled 'A targeted single amino acid mutation in influenza A virus universal epitope transforms\nimmunogenicity and protective immunity via CD4+ T cell activation.'","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-02-26T12:43:26.802Z","url":"https://data.mendeley.com/datasets/wm43n6h5n3","data_type":"dataset","access":"open","doi":["10.17632/wm43n6h5n3"],"contributors":[{"first_name":"James","last_name":"Geary","orcid":null}],"funders":[{"id":"https://ror.org/029chgv08","name":"Wellcome Trust","grant_id":"209213/Z/17/Z"}],"categories":["Immunology","Structural Biology","Vaccine","Influenza"],"journal_issn":[]},{"id":"3yrp3d32mv","title":"SURVEILLANCE AND MOLECULAR EPIDEMIOLOGY OF ESPECIALLY DANGEROUS RESPIRATORY VIRUSES IN COMMERCIAL AND BACKYARD POULTRY AND MIGRATORY WATERFOWL IN INDIA","description":"Samples were collected from various avian species across Kerala, Haryana and Odisha, India between 2018-2020. All samples were tested for the presence of NDV (Newcastle disease virus) using RT-PCR based on the matrix gene (M) of the virus. Samples positive for the M gene were further tested with F gene primers to determine the pathotype of NDV. In addition, pools from all samples (five samples to a pool) from the three centers were tested for avian influenza virus (AIV) followed by testing of individual samples from positive pools. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-03-21T18:35:27.448Z","url":"https://data.mendeley.com/datasets/3yrp3d32mv","data_type":"dataset","access":"open","doi":["10.17632/3yrp3d32mv"],"contributors":[{"first_name":"Jessica","last_name":"Radzio-Basu","orcid":null}],"funders":[],"categories":["Newcastle Disease Virus","Avian Influenza Virus"],"journal_issn":[]}],"total_records":82134,"page":1,"page_size":10,"execution_time":84,"aggregations":{"data_type_stats":{"dataset":82134,"collection":0},"access_type_stats":{"open":81888,"restricted":49,"embargoed":197},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":1303},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":436},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":314},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":297},{"id":"h