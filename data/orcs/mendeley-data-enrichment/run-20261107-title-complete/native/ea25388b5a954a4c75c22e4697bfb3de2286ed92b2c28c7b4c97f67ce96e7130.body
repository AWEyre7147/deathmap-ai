{"records":[{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"dy97pwyf74","title":"The hyaluronidase, TMEM2, promotes ER homeostasis and longevity independent of the UPRER","description":"Cells have evolved complex mechanisms to maintain protein homeostasis, such as the UPRER, that are strongly associated with several diseases and the aging process. We performed a whole genome CRISPR-based knockout screen to identify genes important for cells to survive ER-based protein misfolding stress. We identified the cell-surface hyaluronidase, Transmembrane Protein 2 (TMEM2), as a potent modulator of ER-stress resistance. The breakdown of the glycosaminoglycan, hyaluronan (HA), by TMEM2 within the extracellular matrix (ECM) altered ER stress resistance independent of canonical UPRER pathways, but dependent upon the cell surface receptor, CD44, a putative HA receptor, and the MAPK cell-signaling components, ERK and p38. Lastly, and most surprisingly, ectopic expression of human TMEM2 in C. elegans protected animals from ER stress and increased both longevity and pathogen resistance independent of canonical UPRER activation, but dependent on the ERK ortholog, mpk-1, and the p38 ortholog, pmk-1. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-09-24T15:51:23.538Z","url":"https://data.mendeley.com/datasets/dy97pwyf74","data_type":"dataset","access":"open","doi":["10.17632/dy97pwyf74"],"contributors":[{"first_name":"Ryo","last_name":"Higuchi-Sanabria","orcid":null},{"first_name":"Robert","last_name":"Schinzel","orcid":null},{"first_name":"Ophir","last_name":"Shalem","orcid":null}],"funders":[],"categories":["Transcriptome"],"journal_issn":[]},{"id":"pnbjdtdkfg","title":"A genome-scale gain-of-function CRISPR screen in CD8 T cells identifies proline metabolism as a means to enhance CAR-T therapy ","description":"CyTOF raw data.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-02-14T13:21:30.568Z","url":"https://data.mendeley.com/datasets/pnbjdtdkfg","data_type":"dataset","access":"open","doi":["10.17632/pnbjdtdkfg"],"contributors":[{"first_name":"Lupeng","last_name":"Ye","orcid":null},{"first_name":"Jonathan","last_name":"Park","orcid":null},{"first_name":"Sidi","last_name":"Chen","orcid":null}],"funders":[],"categories":["Immunology"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"4mb5kjywkj","title":"Western Blot raw data of the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\"","description":"The raw images of WB is for the reviewers' request when reviewing the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-04T00:26:32.621Z","url":"https://data.mendeley.com/datasets/4mb5kjywkj","data_type":"dataset","access":"open","doi":["10.17632/4mb5kjywkj"],"contributors":[{"first_name":"Mingang","last_name":"Hao","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"s3jtdhjdbs","title":"Supplementary data for Michaelis et al., 'Protein import motor complex reacts to mitochondrial misfolding by reducing protein import and activating mitophagy'","description":"Supplementary data for Michaelis et al., 'Mitochondrial import loss induces mitophagy without membrane depolarization'. We hypothesized that inhibition of mitochondrial protein import induced mitophagy independent of mitochondrial depolarization. This dataset contains raw Illumina sequencing data for all samples from a genome-wide CRISPR/Cas9 screen for mitophagy regulators. The genome-wide library is Brunello from Doench et al Nat Biotechnol. 2016. We found that the pre-sequence translocase-associated motor complex PAM controls mitophagy induction. Loss of PAM caused a loss in protein import and was sufficient to induce mitophagy without depolarization.\nThe samples have been sequenced on an Illumina NextSeq 500 in single end mode with 75+8 cycles. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-08-05T15:38:53.752Z","url":"https://data.mendeley.com/datasets/s3jtdhjdbs","data_type":"dataset","access":"open","doi":["10.17632/s3jtdhjdbs"],"contributors":[{"first_name":"Jonas","last_name":"Michaelis","orcid":null},{"first_name":"Melinda","last_name":"Brunstein","orcid":null},{"first_name":"Süleyman","last_name":"Bozkurt","orcid":null},{"first_name":"Ludovico","last_name":"Alves","orcid":null},{"first_name":"Martin","last_name":"Wegner","orcid":null},{"first_name":"Manuel","last_name":"Kaulich","orcid":null},{"first_name":"Christian","last_name":"Pohl","orcid":null},{"first_name":"Christian","last_name":"Münch","orcid":null}],"funders":[],"categories":["Proteomics","Mitochondrion","Mitophagy","Genetic Screening","Next Generation Sequencing","CRISPR/Cas9"],"journal_issn":[]},{"id":"s83f5y9ntt","title":"DUB3 promotes BET inhibitor resistance and cancer progression through deubiquitinating BRD4. Jin et al","description":"The bromodomain and extra-terminal domain (BET) protein BRD4 is emerging as a promising anticancer therapeutic target. However, resistance to BET inhibitors often occurs, and it has been linked to aberrant degradation of BRD4 protein in cancer. Here, we demonstrate that the deubiquitinase DUB3 binds to BRD4 and promotes its deubiquitination and stabilization. Expression of DUB3 is transcriptionally repressed by the NCOR2-HDAC10 complex. The NCOR2 gene is frequently deleted in castration-resistant prostate cancer patient specimens, and loss of NCOR2 induces elevation of DUB3 and BRD4 proteins in cancer cells. DUB3-proficient prostate cancer cells are resistant to the BET inhibitor JQ1 in vitro and in mice, but this effect is diminished by DUB3 inhibitory agents such as CDK4/6 inhibitor in a RB-independent manner. Our findings identify a previously unrecognized mechanism causing BRD4 upregulation and drug resistance, suggesting that DUB3 is a viable therapeutic target to overcome BET inhibitor resistance in cancer.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-07-13T19:55:44.983Z","url":"https://data.mendeley.com/datasets/s83f5y9ntt","data_type":"dataset","access":"open","doi":["10.17632/s83f5y9ntt"],"contributors":[{"first_name":"Haojie","last_name":"Huang","orcid":null}],"funders":[],"categories":["Immunoprecipitation","Western Blot"],"journal_issn":["10972765"]},{"id":"zhpg8xshp9","title":"Lawrence et al., PNAS 2026","description":"Data from “Lawrence et al., 2026 A Genome-Wide Screen Identifies that PLCG2 Restrains Lysosomal GCase Activity.\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-22T18:23:16.389Z","url":"https://data.mendeley.com/datasets/zhpg8xshp9","data_type":"dataset","access":"open","doi":["10.17632/zhpg8xshp9"],"contributors":[{"first_name":"Baris","last_name":"Bingol","orcid":null}],"funders":[],"categories":["Natural Sciences"],"journal_issn":[]},{"id":"gbdfwg325y","title":"Bacteriostatic antibiotics promote CRISPR-Cas adaptive immunity against phages by enabling increased spacer acquisition","description":"Phages impose strong selection on bacteria to evolve resistance against viral predation. Bacteria can rapidly evolve phage resistance via receptor mutation, or using their CRISPR-Cas adaptive immune systems. Acquisition of CRISPR immunity relies on the insertion of a phage-derived sequence into CRISPR arrays in the bacterial genome. Using Pseudomonas aeruginosa and its phage DMS3vir as a model, we demonstrate that conditions that reduce bacterial growth rates, such as exposure to bacteriostatic antibiotics (which inhibit cell growth without killing), promote the evolution of CRISPR immunity. We demonstrate that this is due to slower phage development under those conditions, which provides more time for cells to acquire phage-derived sequences and mount an immune response. Our data reveal that the speed of phage development is a key determinant of the evolution of CRISPR immunity, and suggest that use of bacteriostatic antibiotics can trigger elevated levels of CRISPR immunity in human-associated and natural environments. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-04T13:32:56.091Z","url":"https://data.mendeley.com/datasets/gbdfwg325y","data_type":"dataset","access":"open","doi":["10.17632/gbdfwg325y"],"contributors":[{"first_name":"Tatiana","last_name":"Dimitriu","orcid":null}],"funders":[],"categories":["Microbiology","Antibiotics","Bacteriophage","CRISPR"],"journal_issn":[]}],"total_records":134957,"page":1,"page_size":10,"execution_time":186,"aggregations":{"data_type_stats":{"dataset":134957,"collection":0},"access_type_stats":{"open":134369,"restricted":66,"embargoed":522},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2245},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1398},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":620},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":467},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":444},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":426},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":418},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":373},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":305},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":263}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":132326},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1903},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":186},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":133},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":77},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":65},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":56},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":41},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":26}],"top_institutions_stats":[{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":909},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":864},{"id":"3bfef41a-d03e-5722-bd5