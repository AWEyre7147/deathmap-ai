{"records":[{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"4mb5kjywkj","title":"Western Blot raw data of the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\"","description":"The raw images of WB is for the reviewers' request when reviewing the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-04T00:26:32.621Z","url":"https://data.mendeley.com/datasets/4mb5kjywkj","data_type":"dataset","access":"open","doi":["10.17632/4mb5kjywkj"],"contributors":[{"first_name":"Mingang","last_name":"Hao","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"3ctpx4k6jp","title":"Porcine reproductive and respiratory syndrome virus upregulates SMPDL3B to promote viral replication by modulating lipid metabolism","description":"We generated a collection of porcine genome-scale CRISPR/Cas9 knockout (PigGeCKO) cells on a PAM background.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-26T18:53:54.241Z","url":"https://data.mendeley.com/datasets/3ctpx4k6jp","data_type":"dataset","access":"open","doi":["10.17632/3ctpx4k6jp"],"contributors":[{"first_name":"huanh","last_name":"Shen","orcid":null}],"funders":[],"categories":["Agricultural Biotechnology"],"journal_issn":[]},{"id":"nxvdzybwhf","title":"Illuminating host-mycobacterial interactions with genome-wide CRISPR knockout and CRISPRi screens","description":"The data deposited here contains genome-wide CRISPR knockout and CRISPRi screen data, including the positive hits, the negative hits, and non-targeting controls. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-30T11:32:01.108Z","url":"https://data.mendeley.com/datasets/nxvdzybwhf","data_type":"dataset","access":"open","doi":["10.17632/nxvdzybwhf"],"contributors":[{"first_name":"Yong","last_name":"Lai","orcid":null}],"funders":[],"categories":["Functional Genomics","High-Throughput Sequencing","Tuberculosis"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"pnbjdtdkfg","title":"A genome-scale gain-of-function CRISPR screen in CD8 T cells identifies proline metabolism as a means to enhance CAR-T therapy ","description":"CyTOF raw data.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-02-14T13:21:30.568Z","url":"https://data.mendeley.com/datasets/pnbjdtdkfg","data_type":"dataset","access":"open","doi":["10.17632/pnbjdtdkfg"],"contributors":[{"first_name":"Lupeng","last_name":"Ye","orcid":null},{"first_name":"Jonathan","last_name":"Park","orcid":null},{"first_name":"Sidi","last_name":"Chen","orcid":null}],"funders":[],"categories":["Immunology"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"6wyzgw8z8k","title":"The CST complex mediates end-protection at double-strand breaks and promotes PARP inhibitor sensitivity in BRCA1-deficient cells. DOI: https://doi.org/10.1016/j.celrep.2018.04.046","description":"Original data used for plotting the figures belonging to the study \"The CST complex mediates end-protection at double-strand breaks and promotes PARP inhibitor sensitivity in BRCA1-deficient cells\". ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-05-22T12:41:39.154Z","url":"https://data.mendeley.com/datasets/6wyzgw8z8k","data_type":"dataset","access":"open","doi":["10.17632/6wyzgw8z8k"],"contributors":[{"first_name":"Sven","last_name":"Rottenberg","orcid":null},{"first_name":"Marco","last_name":"Barazas","orcid":null}],"funders":[],"categories":["Cancer","DNA Repair","Olaparib","BRCA Gene"],"journal_issn":[]},{"id":"zhpg8xshp9","title":"Lawrence et al., PNAS 2026","description":"Data from “Lawrence et al., 2026 A Genome-Wide Screen Identifies that PLCG2 Restrains Lysosomal GCase Activity.\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-22T18:23:16.389Z","url":"https://data.mendeley.com/datasets/zhpg8xshp9","data_type":"dataset","access":"open","doi":["10.17632/zhpg8xshp9"],"contributors":[{"first_name":"Baris","last_name":"Bingol","orcid":null}],"funders":[],"categories":["Natural Sciences"],"journal_issn":[]},{"id":"zdnrtmyfgh","title":"A Chemical-Genetic Interaction Matrix Reveals Drug Mechanism and Genetic Architecture","description":"This dataset is associated with an article bearing the same name ( https://doi.org/10.64898/2026.01.28.701823 ), describing the results of >400 CRISPR/Cas9 chemical-genetic genome-wide knockout screens covering 305 different compounds and 5 conditions. The dataset also contains meta-data about each compound as well as the raw and/or processed data necessary to reproduce various analyses and figures from the article. The contents of each table and sub-table (tab) are described in the overview tab of each file. Table contents are briefly described below.\nTable S1. Summary of the CGI dataset. (A) Sequenced samples. (B) Independent screens. (C) Compound details and verification. (D) NALM-6 gene expression. (E) CGIs detected.\nTable S2. CRANKS scores.\nTable S3. Known compound-target relationships.\nTable S4. Combined CRANKS scores for two independent TRAIL screens.\nTable S5. Jaccard similarity indices between screens in the CGI dataset. Pairs used in Fig. 2D are indicated by class.\nTable S6. Compound-transporter CGI scores.\nTable S7. (A) Compound dose-to-solubility ratios by screen. (B) Correlation coefficients of CRANKS scores with compound dose-to-solubility ratios. \nTable S8. Vemurafenib SSL hits and Gene Ontology annotations.\nTable S9. Predicted basic pKa and logP for compounds represented in the screen similarity network.\nTable S10. Mean genome-wide CRANKS score profile of the 28 screens in the phospholipidosis cluster.\nTable S11. LipidTOX Red assay determinations. (A) Cell counts and average LipidTOX levels. (B) Compound classification.\nTable S12. Average CRANKS scores for combined screens. (A) Nocodazole. (B) Active site mTOR inhibitors. (C) Rapamycin. (D) AICAR. (E) Pyridostatin and topoisomerase II inhibitors. (F) DHFR inhibitor screens. (G) PARP inhibitors. (H) CHEK1 inhibitors.\nTable S13. Comparison of CGIs for 9 shared compounds in this dataset and the Olivieri et al (2020) dataset. \nTable S14. Data for assessment of compound synergy/antagonism, including luminescence readings, treatments by well and log2 Bliss scores determined by compound pair.\nTable S15. (A) CRANKS2 scores. (B) Top 20,000 most correlated gene pairs.\nTable S16. RNA-seq data. (A) FK-506 versus DMSO and read counts by gene. (B) PPP3CA knockout versus wild-type controls. (C) PPP3R1 knockout versus wild-type controls. (D) Transcription rates in PABIR1 knockout clones.\nTable S17. List of DDR-associated genes.\nTable S18. (A) Significant exon-level CGIs. (B) Exon classification and validation data.\nTable S19. (A) Hypothetical gene CGIs with p-values <0.002 or absolute scores ≥2.5. (B) Hypothetical gene classification and mass spectral counts.\nTable S20. Correlation between gene CRANKS scores and population doublings.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-02-09T12:56:30.064Z","url":"https://data.mendeley.com/datasets/zdnrtmyfgh","data_type":"dataset","access":"open","doi":["10.17632/zdnrtmyfgh"],"contributors":[{"first_name":"Jasmin","last_name":"Coulombe-Huntington","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"FDN-167277, FDN–167265, PJT190250, PJT152920, PJT-451236, 163051, 201311MFE"},{"id":"https://ror.org/000az4664","name":"Canada Foundation for Innovation","grant_id":null},{"id":"https://ror.org/01h531d29","name":"Natural Sciences and Engineering Research Council of Canada","grant_id":"RGPIN-2022-04206 Canada Research Chairs, https://ror.org/0517h6h17"},{"id":"https://ror.org/05vd00053","name":"Terry Fox Foundation","grant_id":"https://ror.org/05vd00053, TFF-242122"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01 OD010929, R35 GM127032, RO1 NCI80728, RO1 NCI98571"},{"id":"https://ror.org/000dswa46","name":"W. M. Keck Foundation","grant_id":null},{"id":null,"name":"IVADO","grant_id":"PD-2018b-AP-05"},{"id":null,"name":"McLaughlin Centre Accelerator","grant_id":"MC-2023-07, MC-2024-08-3"},{"id":"https://ror.org/043q8yx54","name":"Ontario Institute for Cancer Research","grant_id":"https://ror.org/043q8yx54, SU2C-AACR-DT-19–15"},{"id":null,"name":"Institute for Research in Immunology and Cancer","grant_id":"https://ror.org/00wj6x496, SPC1901, SPC2102, SPC2104, La Fondation Famille Godin"},{"id":"https://ror.org/04m0xav37","name":"Leukemia and Lymphoma Society","grant_id":"MC_UU_00035/13"},{"id":"https://ror.org/029s29983","name":"Genome Canada","grant_id":"LSARP4524, LSARP13528, SU2C-AACR-DT-19–15, Centre for Advanced Proteomic and Chemogenomic Analyses"},{"id":"https://ror.org/00xhtr962","name":"Génome Québec","grant_id":"https://ror.org/00xhtr962, LSARP4524, Centre for Advanced Proteomic and Chemogenomic Analyses"},{"id":"https://ror.org/02fnpv153","name":"American Association For Cancer Research","grant_id":"https://ror.org/02fnpv153, SU2C-AACR-DT-19–15"}],"categories":["Genetics","Bioinformatics","Systems Biology","Pharmacogenomics","Gene Knockout","Computational Biology","CRISPR/Cas9"],"journal_issn":[]}],"total_records":130751,"page":1,"page_size":10,"execution_time":133,"aggregations":{"data_type_stats":{"dataset":130751,"collection":0},"access_type_stats":{"open":130206,"restricted":64,"embargoed":481},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2182},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1398},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":594},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":451},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":438},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":413},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":408},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":363},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":291},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":256}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":128143},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1899},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":181},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":130},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","c