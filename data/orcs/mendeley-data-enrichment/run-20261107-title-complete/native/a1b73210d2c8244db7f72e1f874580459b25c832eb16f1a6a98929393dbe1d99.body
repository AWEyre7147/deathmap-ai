ll},{"first_name":"Charles","last_name":"Boone","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"MOP_142735"},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","grant_id":"MCB1818293"},{"id":"https://ror.org/01h531d29","name":"Natural Sciences and Engineering Research Council of Canada","grant_id":"RGPIN-2020-04180"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT 173542"},{"id":"https://ror.org/000az4664","name":"Canada Foundation for Innovation","grant_id":"39977"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE09-011"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE011-006"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-180285"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-GMX-463531"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2024-08-02"},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","grant_id":"DFG Bi 2086/1-1"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG005084"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2022-02"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG00583"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"T32GM008347"},{"id":null,"name":"NIH/NCI Ruth L. Kirschstein National Research F30 Award","grant_id":"5F30CA257227"}],"categories":["Genetics","Biological Network"],"journal_issn":[]},{"id":"pdr4v6hxrc","title":"Genome-wide identification and characterization of QTLs for transcriptional noise in human midbrain cells","description":"This page provides lists of tnQTLs and eQTLs in human midbrain cells derived from iPSCs.\n\nWhile cell-to-cell variation in gene expression, also known as \"transcriptional noise\", plays various biological roles, its regulation by genetic variants remains elusive. To address this, we analyzed scRNA-seq data of induced pluripotent stem cell-derived midbrain cells from 155 individuals together with their genotypes and identified significant quantitative trait loci for transcriptional noise (tnQTLs) genome-wide. Among these, tnQTLs without significant effects on expression abundance (termed tn>eQTLs) exhibited characteristics such as drastic alterations under oxidative stress. Analyses using GWAS summary statistics identified enrichment of schizophrenia association signals in tn>eQTLs, as well as putative causal effects of transcriptional noise dysregulation in specific genes. We also analyzed brain scRNA-seq data for schizophrenia and found marked disease-associated transcriptional noise alterations in superficial- and deep-layer excitatory neurons. Overall, this study provides a resource for a new class of QTLs and insights into the mechanistic basis of transcriptional noise regulation and its relevance to human traits.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-02-10T01:23:05.146Z","url":"https://data.mendeley.com/datasets/pdr4v6hxrc","data_type":"dataset","access":"open","doi":["10.17632/pdr4v6hxrc"],"contributors":[{"first_name":"Naoki","last_name":"HIROSE","orcid":"0000-0002-3358-0916"},{"first_name":"Shota","last_name":"Mizuno","orcid":null},{"first_name":"Yuki","last_name":"Niwa","orcid":null},{"first_name":"Tomonori","last_name":"Hara","orcid":null},{"first_name":"Hirona","last_name":"Yamamoto","orcid":null},{"first_name":"Emiko","last_name":"Koyama","orcid":null},{"first_name":"Junko","last_name":"Ueda","orcid":null},{"first_name":"Takashi","last_name":"Tsuboi","orcid":"0000-0001-8290-2021"},{"first_name":"Atsushi","last_name":"Takata","orcid":"0000-0002-0928-4586"}],"funders":[],"categories":["Quantitative Trait Locus","Single-Cell RNA Sequencing"],"journal_issn":[]},{"id":"2sz349gtvm","title":"511 SSR primers from Brycon orbignyanus","description":"Set of primers generated for the species Brycon orbignyanus in the manuscript \"Genome identification, characterization and primer design of microsatellite markers from the endangered fish Brycon orbignyanus (Characiformes, Bryconidae) by a low-throughput sequencing technology\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-11-22T06:59:58.17Z","url":"https://data.mendeley.com/datasets/2sz349gtvm","data_type":"dataset","access":"open","doi":["10.17632/2sz349gtvm"],"contributors":[{"first_name":"Daralyns","last_name":"Macedo","orcid":null}],"funders":[],"categories":["Tablet"],"journal_issn":[]},{"id":"9x47wzy8x7","title":"A study of \"Genome-wide CRISPR screens reveal host factors critical for SARS-CoV-2 infection\" by Wei et al. Cell 2020","description":"Identification of host genes essential for SARS-CoV-2 infection may reveal novel therapeutic targets and inform our understanding of COVID-19 pathogenesis. Here, we performed genome-wide CRISPR screens in Vero-E6 cells with SARS-CoV-2, MERS-CoV, bat coronavirus HKU5 expressing the SARS-CoV-1 spike, and VSV expressing the SARS-CoV-2 spike. Together this identifies potential therapeutic targets for SARS-CoV-2 and reveals SARS-lineage specific and pan-coronavirus host factors that regulate susceptibility to highly pathogenic coronaviruses.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-15T21:29:14.06Z","url":"https://data.mendeley.com/datasets/9x47wzy8x7","data_type":"dataset","access":"open","doi":["10.17632/9x47wzy8x7"],"contributors":[{"first_name":"Craig","last_name":"Wilen","orcid":null}],"funders":[],"categories":["CRISPR","Middle East Respiratory Syndrome-Related Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"294x7524bn","title":"Data for: The DNAJ gene family in yerba mate (Ilex paraguariensis): genome-wide identification, structural characterization, orthology based classification and expression analysis","description":"This publication holds the entire supplementary material to the contribution in Rodriguésia \"The DNAJ gene family in yerba mate (Ilex paraguariensis): genome-wide identification, structural characterization, orthology based classification and expression analysis\" by Aguilera et al.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-03-20T21:15:03.813Z","url":"https://data.mendeley.com/datasets/294x7524bn","data_type":"dataset","access":"open","doi":["10.17632/294x7524bn"],"contributors":[{"first_name":"Patricia","last_name":"Aguilera","orcid":"0000-0002-5063-9350"},{"first_name":"Humberto","last_name":"Debat","orcid":"0000-0003-3056-3739"},{"first_name":"Lorena","last_name":"Castrillo","orcid":"0000-0002-4999-1672"},{"first_name":"Gustavo","last_name":"Bich","orcid":"0000-0002-3658-5157"},{"first_name":"Mauro","last_name":"Grabiele","orcid":"0000-0001-7386-4924"}],"funders":[],"categories":["Plant Biology","Crop Genetics","Plant Bioinformatics"],"journal_issn":[]},{"id":"2tv7ntcgh6","title":"cisplatin-damaged gene locus-replicate 1-Blank-R2","description":"Cisplatin is a DNA-targeting chemotherapeutic, yet its damaged gene loci are largely unexplored. We utilized a forward chemical genetics strategy to map 7578 cisplatin-damaged genes (CDGs) with >12 fold-enrichment from A549 human lung cancer cells, of which the highly associated signalling pathways include sperm motility, molecular mechanism of cancer, and protein kinase A signalling. The three most frequently cisplatinated penta-nucleotide motifs and genomic region are CTGGG, CCAGG and GCTGG, and promoter, respectively. Among the CDGs are 1330 enzyme, 747 transcription regulator and 486 transporter genes. Importantly, cisplatin targeted 306 protein kinase genes, accounting for 59% of putative protein kinase genes in the human genome, and 92 protein phosphatase genes. This indicates that cisplatin genome-wide disturbs protein phosphorylation. This data set contains the original sequencing data of two biological replicates, matching results to the hg38 genome, and the analysis results of the distribution of the damage areas identified by the two sequencing results.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-06-23T16:24:02.941Z","url":"https://data.mendeley.com/datasets/2tv7ntcgh6","data_type":"dataset","access":"open","doi":["10.17632/2tv7ntcgh6"],"contributors":[{"first_name":"Fuyi","last_name":"Wang","orcid":null}],"funders":[],"categories":["Cancer","Gene"],"journal_issn":[]}],"total_records":143809,"page":1,"page_size":10,"execution_time":176,"aggregations":{"data_type_stats":{"dataset":143809,"collection":0},"access_type_stats":{"open":142938,"restricted":71,"embargoed":800},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2377},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1338},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":715},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":483},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":447},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":431},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":418},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":404},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":338},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":283}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":141139},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1912},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":189},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":142},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":78},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":58},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":42},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":27}],"top_institutions_stats":[{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":871},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":809},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":548},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":409},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":378}]}}