{"records":[{"id":"6phjx8s467","title":"Data for: Enhanced antitumor effects of CD123/CD33 dual-antibody modified liposome targeting to acute myeloid leukemia cells with reduced the antigen-negative escape","description":"A dual-targeting drug delivery system was  developoed to enhance the therapeutic efficacy of chemotherapeutics and reduce the antigen-negative escape for Acute myeloid leukemia. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-07-18T23:35:51.324Z","url":"https://data.mendeley.com/datasets/6phjx8s467","data_type":"dataset","access":"open","doi":["10.17632/6phjx8s467"],"contributors":[{"first_name":"ShengJun","last_name":"Mao","orcid":null}],"funders":[],"categories":["Drug Delivery","Pharmaceutics","Acute Leukemia"],"journal_issn":["03785173"]},{"id":"rm8kjxkkjv","title":"Original blots","description":"Original blots related to \"SUCLG1 Deficiency-Induced Histone Succinylation Impairs Oncogene Expression in Acute Myeloid Leukemia\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-07-24T16:04:21.305Z","url":"https://data.mendeley.com/datasets/rm8kjxkkjv","data_type":"dataset","access":"open","doi":["10.17632/rm8kjxkkjv"],"contributors":[{"first_name":"Mengqing","last_name":"Gao","orcid":null}],"funders":[],"categories":["Acute Myelogenous Leukemia","Histone Modification"],"journal_issn":[]},{"id":"hx4nwr8yyd","title":"Data for: Therapy-related acute myeloid leukemia developing 14 years after allogeneic stem cell transplantation, from a persistent R882H-DNMT3A mutated clone of patient origin.","description":"Supplementary (DOCX  2.34MB): \nMaterials and methods. \nFig. S1. TP53 mutation found in the lung carcinoma cells taken from the patient in 2012. \nFig. S2. Karyotype illustrating the metaphases of the 2015 therapy-related myelodysplastic syndrome cells. \nFig. S3. Paint of chromosome 15 (green) by fluorescent in situ hybridization. \nFig. S4. Analysis of the chimerism (Mentype® Chimera® software, Biotype) at 2015 therapy-related acute myeloid leukemia diagnosis. \nFig. S5. IDH1, DNMT3A and NPM1 mutations found at the time of the acute myeloid leukemia diagnosis in 2001. \nFig. S6. DNMT3A and TP53 mutations found at the time of the therapy-related acute myeloid leukemia diagnosis in 2015. \nFig. S7. Standard curve for the ASO-qPCR. \nFig. S8. Sensitivity assay for quantitative ASO-qPCR. \n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-07-18T12:28:12.179Z","url":"https://data.mendeley.com/datasets/hx4nwr8yyd","data_type":"dataset","access":"open","doi":["10.17632/hx4nwr8yyd"],"contributors":[{"first_name":"Iván","last_name":"Martín","orcid":null},{"first_name":"Felipe J","last_name":"Chaves","orcid":null},{"first_name":"Rosario","last_name":"Abellán","orcid":null},{"first_name":"Francisca","last_name":"García","orcid":null},{"first_name":"Mar","last_name":"Tormo","orcid":null},{"first_name":"Carlos","last_name":"Solano","orcid":null},{"first_name":"Juan-Carlos","last_name":"Hernandez-Boluda","orcid":null},{"first_name":"María Dolores","last_name":"Olivares","orcid":null},{"first_name":"Eva","last_name":"Villamón","orcid":null},{"first_name":"Fernando","last_name":"Domingo","orcid":null},{"first_name":"Blanca","last_name":"Navarro","orcid":null},{"first_name":"Marisa","last_name":"Calabuig","orcid":null},{"first_name":"Paula","last_name":"Amat","orcid":null},{"first_name":"Alicia","last_name":"Serrano","orcid":null}],"funders":[],"categories":["Molecular Biology","Cytogenetics"],"journal_issn":["00144800"]},{"id":"rdkg26mfjw","title":"CD37 a safe Chimeric Antigen Receptor target to treat acute myeloid leukemia","description":"CD37 a safe Chimeric Antigen Receptor target to treat acute myeloid leukemia - Raw data","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-04-19T10:40:12.702Z","url":"https://data.mendeley.com/datasets/rdkg26mfjw","data_type":"dataset","access":"open","doi":["10.17632/rdkg26mfjw"],"contributors":[{"first_name":"Sandy","last_name":"Joaquina","orcid":null}],"funders":[],"categories":["Data Access"],"journal_issn":[]},{"id":"48s882jvnr","title":"Case report-CARE Checklist","description":"Care checklist for case report-Metachronous Presentation of BCL2-Positive Lung Adenocarcinoma and Acute Myeloid Leukemia: a case presentation and review of the literature","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-04-28T08:34:58.817Z","url":"https://data.mendeley.com/datasets/48s882jvnr","data_type":"dataset","access":"open","doi":["10.17632/48s882jvnr"],"contributors":[{"first_name":"Bo","last_name":"Zheng","orcid":null}],"funders":[],"categories":["Data Access"],"journal_issn":[]},{"id":"2gpjp3mbs6","title":"SETDB1 suppresses NK cell-mediated immunosurveillance in acute myeloid leukemia with granulo-monocytic differentiation","description":"The data include full immunoblot images for \"SETDB1 suppresses NK cell-mediated immunosurveillance in acute myeloid leukemia with granulo-monocytic differentiation\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-05-15T07:05:55.464Z","url":"https://data.mendeley.com/datasets/2gpjp3mbs6","data_type":"dataset","access":"open","doi":["10.17632/2gpjp3mbs6"],"contributors":[{"first_name":"Yu-Hsuan","last_name":"Chang","orcid":null}],"funders":[],"categories":["Hematology","Leukemia","Western Blot","Epigenetics"],"journal_issn":[]},{"id":"5cdnt4t7xz","title":"Targeting mutant NPM1-expressing AML with T-cell receptor-like antibodies","description":"Abstract\nMutant NPM1 protein accumulation is a hallmark of acute myeloid leukemia (AML). Although intracellular proteins are generally inaccessible to antibody-based therapies, proteasomal degradation of mutant NPM1 results in the generation of peptides on the tumor cell surface via major histocompatibility complex (MHC) class I molecules. Enhanced presentation of NPM1 mutant A-derived peptides (NPM1mutA283-291-CLAVEEVSL) on HLA-A*02:01-positive tumor cells distinguishes malignant cells from healthy cells. Here, we report the development of an antibody, 2E2, that specifically targets the NPM1 mutant A peptide bound to HLA-A*02:01. We modified 2E2, including chimeric antibodies and bispecific antibodies. Modified antibodies selectively recognize mutant NPM1-expressing cells and mediate antibody-dependent cellular cytotoxicity (ADCC) in vitro. Moreover, bispecific antibodies derived from 2E2 redirect CD3+ T cells and NK cells to mutant NPM1-expressing cells, suppressing tumor growth both in vitro and in vivo. These findings underscore the potential of NPM1 peptide‒MHC complexes as novel immunotherapeutic targets in AML.\n\nKeywords: TCR-like antibody, Acute myeloid leukemia, Tumor immunotherapy, NPM1, HLA","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-27T15:21:17.055Z","url":"https://data.mendeley.com/datasets/5cdnt4t7xz","data_type":"dataset","access":"open","doi":["10.17632/5cdnt4t7xz"],"contributors":[{"first_name":"Jianda","last_name":"Hu","orcid":null}],"funders":[{"id":null,"name":"Joint Funds for the Innovation of Science and Technology, Fujian Province","grant_id":"2021Y9086, 2022Y4013, 2023Y9153"},{"id":null,"name":"Special Fund from Fujian Provincial Department of Finance","grant_id":"CZBZ202301"},{"id":null,"name":"Natural Science Foundation of Fujian Province","grant_id":"2024J01583, 2022J01240"},{"id":null,"name":"the Talent Scientific Research Project of the First Affiliated Hospital of Fujian Medical University","grant_id":"YJRC4415"},{"id":null,"name":"Scientific Research Foundation of State Key Laboratory of Vaccines for Infectious Diseases, Xiang An Biomedicine Laboratory","grant_id":"2023XAKJ0102057"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"82470173, U23A20419, U2005204"},{"id":null,"name":"the Project of Fujian Province Department of Science & Technology","grant_id":"2023Y9079"}],"categories":["Immunotherapy of Leukemia"],"journal_issn":[]},{"id":"9x47wzy8x7","title":"A study of \"Genome-wide CRISPR screens reveal host factors critical for SARS-CoV-2 infection\" by Wei et al. Cell 2020","description":"Identification of host genes essential for SARS-CoV-2 infection may reveal novel therapeutic targets and inform our understanding of COVID-19 pathogenesis. Here, we performed genome-wide CRISPR screens in Vero-E6 cells with SARS-CoV-2, MERS-CoV, bat coronavirus HKU5 expressing the SARS-CoV-1 spike, and VSV expressing the SARS-CoV-2 spike. Together this identifies potential therapeutic targets for SARS-CoV-2 and reveals SARS-lineage specific and pan-coronavirus host factors that regulate susceptibility to highly pathogenic coronaviruses.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-15T21:29:14.06Z","url":"https://data.mendeley.com/datasets/9x47wzy8x7","data_type":"dataset","access":"open","doi":["10.17632/9x47wzy8x7"],"contributors":[{"first_name":"Craig","last_name":"Wilen","orcid":null}],"funders":[],"categories":["CRISPR","Middle East Respiratory Syndrome-Related Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"3df2cj3v9z","title":"AMI-M1","description":"AML-M1 (Acute Myeloid Leukemia, French-American-British Classification M1)\nDefinition:\nAML-M1 is a subtype of acute myeloid leukemia characterized by a proliferation of myeloblasts (immature white blood cells) with minimal maturation. It is classified under the FAB (French-American-British) system as M1, which means “without maturation.”\n\nKey Features:\n\nBone marrow and blood contain ≥ 20% myeloblasts with minimal differentiation into mature cells.\n\nMyeloblasts typically lack significant granulocytic maturation beyond the blast stage.\n\nCommon markers: CD13, CD33 are usually positive, HLA-DR often positive.\n\nClinical symptoms: fatigue, anemia, infections, bleeding tendencies due to bone marrow failure.\n\nDiagnosis:\n\nBone marrow biopsy showing ≥ 20% myeloblasts.\n\nImmunophenotyping showing expression of myeloid markers such as CD13, CD33.\n\nCytogenetic and molecular testing to identify mutations (e.g., FLT3, NPM1) that guide prognosis and treatment.\n\nTreatment:\n\nTypically involves intensive chemotherapy aimed at inducing remission.\n\nMay include consolidation chemotherapy and hematopoietic stem cell transplantation in eligible patients.\n\nPrognosis:\n\nPrognosis depends on various factors including genetic mutations, patient age, and response to treatment.\n\nAML-M1 has a variable prognosis; patients with favorable mutations have better outcomes.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-07-07T17:10:45.234Z","url":"https://data.mendeley.com/datasets/3df2cj3v9z","data_type":"dataset","access":"open","doi":["10.17632/3df2cj3v9z"],"contributors":[{"first_name":"Eldirdiri Fadol Ibrahim","last_name":"Ibrahim","orcid":null}],"funders":[],"categories":["Hematological Cancer","Chemical Treatment","Science, Technology, Engineering and Mathematics"],"journal_issn":[]}],"total_records":137455,"page":1,"page_size":10,"execution_time":171,"aggregations":{"data_type_stats":{"dataset":137455,"collection":0},"access_type_stats":{"open":136678,"restricted":70,"embargoed":707},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2295},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":693},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":471},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":438},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":433},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":418},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":398},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":335},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":272},{"id":"https://ror.org/05r0vyz12","name":"Ministerio de Ciencia, Innovación y Universidades","count":231}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":134804},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1910},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":185},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":135},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":78},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":58},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":40},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":27}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":526},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":408},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":368},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":357},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":324}]}}