{"records":[{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"nnxh5d35nd","title":"Genome-wide CRISPR-Cas9 screen identified KLF11 as a druggable suppressor for sarcoma cancer stem cells","description":"The original, unprocessed data alongside the paper","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-05-31T01:39:45.722Z","url":"https://data.mendeley.com/datasets/nnxh5d35nd","data_type":"dataset","access":"open","doi":["10.17632/nnxh5d35nd"],"contributors":[{"first_name":"Le","last_name":"Qu","orcid":null}],"funders":[],"categories":["Cancer"],"journal_issn":[]},{"id":"835fcfbvhs","title":"Preparation of CRISPR/Cas9 and gRNA plasmids","description":"Human genome engineering has been transformed by the introduction of the CRISPR (clustered regularly interspaced short palindromic repeats)/Cas (CRISPR-associated) system found in most bacteria and archaea. Type II CRISPR/Cas systems have been engineered to induce RNA-guided genome editing in human cells, where small RNAs function together with Cas9 nucleases for sequence-specific cleavage of target sequences. Here we describe the protocol for Cas9-mediated human genome engineering, including construct building and transfection methods necessary for delivering Cas9 and guide RNA (gRNA) into human-induced pluripotent stem cells (hiPSCs) and HEK293 cells. Following genome editing, we also describe methods to assess genome editing effi- ciency using next-generation sequencing and isolate monoclonal hiPSCs with the desired modifications for downstream applications. Keywords: genome engineering • CRISPR • human stem cells","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2016-12-12T12:58:15.307Z","url":"https://data.mendeley.com/datasets/835fcfbvhs","data_type":"dataset","access":"open","doi":["10.17632/835fcfbvhs"],"contributors":[{"first_name":"George","last_name":"Church","orcid":null}],"funders":[],"categories":["Experimental Method"],"journal_issn":[]},{"id":"3ctpx4k6jp","title":"Porcine reproductive and respiratory syndrome virus upregulates SMPDL3B to promote viral replication by modulating lipid metabolism","description":"We generated a collection of porcine genome-scale CRISPR/Cas9 knockout (PigGeCKO) cells on a PAM background.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-26T18:53:54.241Z","url":"https://data.mendeley.com/datasets/3ctpx4k6jp","data_type":"dataset","access":"open","doi":["10.17632/3ctpx4k6jp"],"contributors":[{"first_name":"huanh","last_name":"Shen","orcid":null}],"funders":[],"categories":["Agricultural Biotechnology"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"66ms37y66x","title":"Data for: A genome-wide CRISPR/Cas9 screen reveals that riboflavin regulates hydrogen peroxide entry into HAP1 cells  ","description":"CRISPR screen data for hydrogen peroxide mediated cell death","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-02-13T14:30:16.414Z","url":"https://data.mendeley.com/datasets/66ms37y66x","data_type":"dataset","access":"open","doi":["10.17632/66ms37y66x"],"contributors":[{"first_name":"surachai","last_name":"supattapone","orcid":null},{"first_name":"Kenneth","last_name":"Mark","orcid":null},{"first_name":"Tamutenda","last_name":"Chidawanyika","orcid":null}],"funders":[],"categories":["Oxidative Stress"],"journal_issn":[]},{"id":"33tm3dd9dw","title":"FAME-CRISPR: Improved CRISPR-Cas9 Genome Editing via HDAC Inhibition and Engineered Virus-Like Particle Delivery ","description":"Raw data deposited for \"FAME-CRISPR: Improved CRISPR-Cas9 Genome Editing via HDAC Inhibition and Engineered Virus-Like Particle Delivery\" by Djamshidi et al-Cell Reports Methods","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-09-25T15:53:30.358Z","url":"https://data.mendeley.com/datasets/33tm3dd9dw","data_type":"dataset","access":"open","doi":["10.17632/33tm3dd9dw"],"contributors":[{"first_name":"Mahbod","last_name":"Djamshidi","orcid":null}],"funders":[],"categories":["Sanger Sequencing","Immunofluorescence"],"journal_issn":[]},{"id":"s3jtdhjdbs","title":"Supplementary data for Michaelis et al., 'Protein import motor complex reacts to mitochondrial misfolding by reducing protein import and activating mitophagy'","description":"Supplementary data for Michaelis et al., 'Mitochondrial import loss induces mitophagy without membrane depolarization'. We hypothesized that inhibition of mitochondrial protein import induced mitophagy independent of mitochondrial depolarization. This dataset contains raw Illumina sequencing data for all samples from a genome-wide CRISPR/Cas9 screen for mitophagy regulators. The genome-wide library is Brunello from Doench et al Nat Biotechnol. 2016. We found that the pre-sequence translocase-associated motor complex PAM controls mitophagy induction. Loss of PAM caused a loss in protein import and was sufficient to induce mitophagy without depolarization.\nThe samples have been sequenced on an Illumina NextSeq 500 in single end mode with 75+8 cycles. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-08-05T15:38:53.752Z","url":"https://data.mendeley.com/datasets/s3jtdhjdbs","data_type":"dataset","access":"open","doi":["10.17632/s3jtdhjdbs"],"contributors":[{"first_name":"Jonas","last_name":"Michaelis","orcid":null},{"first_name":"Melinda","last_name":"Brunstein","orcid":null},{"first_name":"Süleyman","last_name":"Bozkurt","orcid":null},{"first_name":"Ludovico","last_name":"Alves","orcid":null},{"first_name":"Martin","last_name":"Wegner","orcid":null},{"first_name":"Manuel","last_name":"Kaulich","orcid":null},{"first_name":"Christian","last_name":"Pohl","orcid":null},{"first_name":"Christian","last_name":"Münch","orcid":null}],"funders":[],"categories":["Proteomics","Mitochondrion","Mitophagy","Genetic Screening","Next Generation Sequencing","CRISPR/Cas9"],"journal_issn":[]},{"id":"8xhv88c7wt","title":"Genome-wide screening in human kidney organoids identifies developmental and disease-related aspects of nephrogenesis","description":"Human organoids allow the study of proliferation, lineage specification, and three-dimensional tissue development. Here, we present a genome-wide CRISPR screen in iPSC-derived kidney organoids. The combination of inducible genome editing, longitudinal sampling and endpoint sorting of tubular and stromal cells generated a complex, high-quality dataset uncovering a broad spectrum of insightful biology from early development to ‘adult’ epithelial morphogenesis. Our functional dataset allows improving mesoderm induction by ROCK inhibition, contains monogenetic and complex trait kidney disease genes, confirms two additional CAKUT genes (CCDC170 and MYH7B), and provides a large candidate list of ciliopathy-related genes. Finally, the identification of a cis-inhibitory effect of Jagged1 controlling epithelial proliferation shows how mosaic knockouts in pooled CRISPR screening can discover ways of communication between heterogeneous cell populations in complex tissues. Collectively, these data serve both as a rich resource for the kidney community and as a benchmark for future iPSC-derived organoid CRISPR screens.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-29T13:48:59.335Z","url":"https://data.mendeley.com/datasets/8xhv88c7wt","data_type":"dataset","access":"open","doi":["10.17632/8xhv88c7wt"],"contributors":[{"first_name":"Rosemarie","last_name":"Ungricht","orcid":null},{"first_name":"Philipp","last_name":"Hoppe","orcid":null}],"funders":[],"categories":["Screening","CRISPR"],"journal_issn":[]},{"id":"vs9fwhbcvj","title":"Genome-wide Brie CAD5 Surface PrPC - Differentiated PrPC High","description":"These are the raw .fastq files from NGS runs of the genome-wide CRISPR/Cas9 KO library (Brie) performed in differentiated CAD5 cells.  They are labeled Brie_PrPC_High to indicate that these sgRNA sequences were captured in the \"PrPC High\" populations during FACS.  Bioinformatic analysis was performed using the MAGeCK-VISPR and MAGeCKFlute pipelines using the biological replicates function to compare between \"PrP Low\" and \"PrP High\" samples.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-06-13T07:36:42.171Z","url":"https://data.mendeley.com/datasets/vs9fwhbcvj","data_type":"dataset","access":"open","doi":["10.17632/vs9fwhbcvj"],"contributors":[{"first_name":"Kathryn","last_name":"Beauchemin","orcid":null}],"funders":[{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"1R37NS125431"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"P20-GM113132 "},{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R01NS118796"},{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R01NS117276"}],"categories":["Prion","CRISPR"],"journal_issn":[]}],"total_records":139270,"page":1,"page_size":10,"execution_time":166,"aggregations":{"data_type_stats":{"dataset":139270,"collection":0},"access_type_stats":{"open":138526,"restricted":69,"embargoed":675},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2303},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1387},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":664},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":473},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":451},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":435},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":423},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":386},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":330},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":275}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":136619},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1909},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":186},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":137},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":79},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":65},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":57},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":43},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":31},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":25}],"top_institutions_stats":[{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":899},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":857},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":527},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":407},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":362}]}}