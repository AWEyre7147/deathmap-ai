{"records":[{"id":"p57vf9vzr4","title":"LINF_210024100","description":"40S ribosomal protein S11 | uS17\nLeishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-08-13T06:30:49.405Z","url":"https://data.mendeley.com/datasets/p57vf9vzr4","data_type":"dataset","access":"open","doi":["10.17632/p57vf9vzr4"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"bbv4g5hjfc","title":"LINF_200021000","description":"40S ribosomal protein S11 | uS17\nLeishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-08-13T06:30:46.163Z","url":"https://data.mendeley.com/datasets/bbv4g5hjfc","data_type":"dataset","access":"open","doi":["10.17632/bbv4g5hjfc"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"cjg4n3t5ss","title":"LDHU3_20.1990","description":"40S ribosomal protein S11 | uS17; Leishmania donovani (HU3 strain)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-01-07T16:07:45.658Z","url":"https://data.mendeley.com/datasets/cjg4n3t5ss","data_type":"dataset","access":"open","doi":["10.17632/cjg4n3t5ss"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","grant_id":"PID2020-117916RB-I00/AEI/10.13039/501100011033"}],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"cy23tdm2d2","title":"HSF1 manuscript data (Konada et al.,)","description":"Raw data for figures in Konada et al., under review at Molecular Cell. Topoisomerase II (TOP2) poisons, such as etoposide and doxorubicin, are potent antineoplastic drugs that are used to treat a variety of solid tumors and leukemias. Yet these drugs also cause significant secondary malignancies and toxicity to postmitotic cells. Proliferating mammalian cells express two TOP2 isoforms, TOP2A and TOP2B, while postmitotic cells only express TOP2B. Selectively targeting TOP2A, but not TOP2B, could thus prevent secondary toxicity in postmitotic cells, but such isoform-selective targeting strategies remain elusive. Here we report that the heat shock transcription factor, HSF1, facilitates the catalytic engagement of TOP2B on chromatin. Purified recombinant HSF1 stimulates the DNA cleavage and relaxation activity of purified TOP2B. Using atomic force microscopy, we show that HSF1 also enhances the binding of TOP2B across a range of DNA conformations. TOP2B co-occupies the genome with HSF1 in both postmitotic and dividing cells, and either the knockdown or inhibition of HSF1 reduces the levels of catalytically engaged TOP2B. Intriguingly, HSF1 preferentially stimulates TOP2B over TOP2A. Furthermore, pharmacological HSF1 inhibitors protect postmitotic cells from the cytotoxicity of TOP2 poisons without compromising their ability to kill cancer cells, revealing a potential strategy for minimizing the side-effects of TOP2 poison-based chemotherapy.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-08-19T20:50:31.08Z","url":"https://data.mendeley.com/datasets/cy23tdm2d2","data_type":"dataset","access":"open","doi":["10.17632/cy23tdm2d2"],"contributors":[{"first_name":"Lahiri ","last_name":"Konada","orcid":null},{"first_name":"Thomas ","last_name":"Catley","orcid":null},{"first_name":"Lance","last_name":"Heady","orcid":null},{"first_name":"Morgan","last_name":"Crewe","orcid":null},{"first_name":"Delint","last_name":"Ilse","orcid":null},{"first_name":"Laura","last_name":"Wiggins","orcid":null},{"first_name":"Sandra Fajardo","last_name":"Briseno","orcid":null},{"first_name":"Amir ","last_name":"Segev","orcid":null},{"first_name":"Alice","last_name":"Pyne","orcid":null},{"first_name":"Ram","last_name":"Madabhushi","orcid":null}],"funders":[],"categories":["Molecular Biology","Molecular Neuroscience"],"journal_issn":[]},{"id":"p7wnpbc62m","title":"Protein UFMylation regulates early events during ribosomal DNA damage response","description":"Raw data for Western blots and gels","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-02-26T15:50:54.427Z","url":"https://data.mendeley.com/datasets/p7wnpbc62m","data_type":"dataset","access":"open","doi":["10.17632/p7wnpbc62m"],"contributors":[{"first_name":"Pudchalaluck","last_name":"Panichnantakul","orcid":null},{"first_name":"Lisbeth-Carolina","last_name":"Aguilar","orcid":null},{"first_name":"Evan ","last_name":"Daynard","orcid":null},{"first_name":"Mackenzie","last_name":"Guest","orcid":null},{"first_name":"Colten","last_name":"Peters","orcid":null},{"first_name":"jackie","last_name":"vogel","orcid":null},{"first_name":"Marlene","last_name":"Oeffinger","orcid":null}],"funders":[],"categories":["Ribosomal DNA","DNA Damage"],"journal_issn":[]},{"id":"5yr357r3m9","title":"Supplementary Tables S9-S11","description":"Supplementary Table S9 - Porcine plasma proteins submitted for further analysis.\nSupplementary Table S10 - Proteins significantly altered in response to the T1 diet.\nSupplementary Table S11 - Proteins significantly altered in response to the T2 diet. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-04-03T09:26:02.109Z","url":"https://data.mendeley.com/datasets/5yr357r3m9","data_type":"dataset","access":"open","doi":["10.17632/5yr357r3m9"],"contributors":[{"first_name":"Agnieszka","last_name":"Herosimczyk","orcid":null}],"funders":[],"categories":["Protein Expression"],"journal_issn":[]},{"id":"nvn5spksw8","title":"Mass Spectrometry Data","description":"Raw data of mass spectrometry for identification of protein targets of Gli-233 and Gli-55 aptamers specific to glioma.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-06-29T14:13:45.117Z","url":"https://data.mendeley.com/datasets/nvn5spksw8","data_type":"dataset","access":"open","doi":["10.17632/nvn5spksw8"],"contributors":[{"first_name":"Yury","last_name":"Glazyrin","orcid":null}],"funders":[],"categories":["Mass Spectrometry"],"journal_issn":[]},{"id":"v3jmc69k9b","title":"Antigen-presenting cell/T/NK cell-related genes risk model for prognosis and immune therapeutic efficacy in patients with glioma","description":"Antigen-Presenting Cell/T/Natural Killer (APC/T/NK) cells are important in anti-tumour invasion, and the suppression of their functions leads to resistance of glioma patients to chemotherapy. The purpose of this study was to develop an APC/T/NK cells-related genes (ATNKGs) risk model to achieve risk stratification, prognosis, and immunotherapeutic response for glioma patients. Here we present the databases of all the analysis procedures, including the data of glioma patients from the GSE68848, TCGA and CGGA databases and original experimental and analytical data . In conclusion, the four-gene APC/T/NK cells-related prognostic model can accurately predict the glioma patients' prognosis, which may contribute to future research on the risk stratification and the formulation of personalized immunotherapy protocols for patients with giloma.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-10-06T13:33:28.728Z","url":"https://data.mendeley.com/datasets/v3jmc69k9b","data_type":"dataset","access":"open","doi":["10.17632/v3jmc69k9b"],"contributors":[{"first_name":"Donglin","last_name":"Zhou","orcid":null},{"first_name":"Jiang","last_name":"Peng","orcid":null}],"funders":[],"categories":["Bioinformatics","Glioma","Risk Modeling"],"journal_issn":[]},{"id":"tvn32z4rbd","title":"LINF_150020700","description":"mitochondrial DNA topoisomerase II | TOP2\nLeishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-07-15T12:33:38.944Z","url":"https://data.mendeley.com/datasets/tvn32z4rbd","data_type":"dataset","access":"open","doi":["10.17632/tvn32z4rbd"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"fhw7ff6gd3","title":"Data for: Anticarin β inhibits human glioma progression by suppressing cancer stemness via STAT3","description":"Glioma is the most common form of malignant brain cancer. It is very difficult to cure malignant glioma because of the presence of glioma stem cells, which are a barrier to cure, have high tumorigenesis, associated with drug resistance, and responsible for relapse by regulating stemness genes. In this study, our results demonstrated that anticarin β, a natural compound from Antiaris toxicaria, can effectively and selectively suppress proliferation and cause apoptosis in glioma cells, which has an IC50 that is 100 times lower than that in mouse normal neural stem cells. Importantly, cell sphere formation assay and real time-quantitative analysis reveal that anticarin β inhibits cancer stemness by modulating related stemness gene expression. Additionally, anticarin β induces DNA damage to regulate the oncogene expression of signal transducer and activator of transcription 3 (STAT3), Akt, mitogen-activated protein kinases (MAPKs), and eventually leading to apoptosis. Furthermore, anticarin β effectively inhibits glioma growth and prolongs the lifts pan of tumor-bearing mice without systemic toxicity in the orthotopic xenograft mice model. These results suggest that anticarin β is a promising candidate inhibitor for malignant glioma.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-07-27T06:55:33.341Z","url":"https://data.mendeley.com/datasets/fhw7ff6gd3","data_type":"dataset","access":"open","doi":["10.17632/fhw7ff6gd3"],"contributors":[{"first_name":"Min","last_name":"Zhang","orcid":null}],"funders":[],"categories":["Glioma"],"journal_issn":[]}],"total_records":84759,"page":1,"page_size":10,"execution_time":87,"aggregations":{"data_type_stats":{"dataset":84759,"collection":0},"access_type_stats":{"open":84625,"restricted":43,"embargoed":91},"top_funders_stats":[{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":3441},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":1315},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":411},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":337},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":294},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":291},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":289},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":249},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":215},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":152}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":82849},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1423},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":147},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":83},{"id":"2a9d1b7