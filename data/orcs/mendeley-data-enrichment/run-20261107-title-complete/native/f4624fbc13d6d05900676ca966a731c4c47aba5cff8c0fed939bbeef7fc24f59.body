{"records":[{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"v4zbbbsr5t","title":"VPS33A and VPS18 orchestrate porcine epidemic diarrhea virus replication by modulating autophagic flux","description":"Completion of autophagy through autophagosome-lysosome fusion represents a critical regulatory checkpoint that is frequently manipulated during viral infection, yet how coronaviruses exploit this terminal step remains incompletely understood. Porcine epidemic diarrhea virus (PEDV), a highly pathogenic alphacoronavirus, has been reported to induce autophagy, but whether and how complete autophagic flux contributes to viral replication is unclear. Here, using a genome-wide CRISPR/Cas9 knockout screen in Vero cells, we identify the HOPS complex subunits VPS33A and VPS18 as essential host factors for PEDV infection. Genetic ablation of either VPS33A or VPS18 profoundly suppresses viral progeny production and arrests autophagic flux at the autophagosome stage, demonstrating that PEDV replication is associated with HOPS-mediated autolysosome formation. Domain-mapping analyses further reveal that the structural integrity of VPS33A and the α-solenoid plus RING domains of VPS18 are indispensable for both autophagosome-lysosome fusion and efficient viral replication. Mechanistically, we show that PEDV non-structural proteins nsp3 and nsp4 physically interact with VPS33A and VPS18. While either protein alone initiates autophagosome formation, their coordinated action contributes to drive complete autophagy in a HOPS-dependent manner. Collectively, our findings uncover a coronavirus strategy that actively promotes autophagic completion through VPS33A and VPS18, two core subunits of the HOPS complex, to support replication, thereby establishing autolysosome formation as a critical host process exploited by PEDV.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-05-18T15:12:38.75Z","url":"https://data.mendeley.com/datasets/v4zbbbsr5t","data_type":"dataset","access":"open","doi":["10.17632/v4zbbbsr5t"],"contributors":[{"first_name":"liang","last_name":"guo","orcid":null}],"funders":[{"id":null,"name":"the National Key Research and Development Program of China","grant_id":"2023YFC3404301, 2023YFF1000204, and 2021YFA0805901"},{"id":null,"name":"the Hainan Provincial Natural Science Foundation of China","grant_id":"323QN261"}],"categories":["Virus","Animal"],"journal_issn":[]},{"id":"37y6z4m8s7","title":"LDHU3_15.1110","description":"Dolichol phosphate-mannose biosynthesis regulatory protein (DPM2); Leishmania donovani (HU3 strain)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-07-19T18:08:59.146Z","url":"https://data.mendeley.com/datasets/37y6z4m8s7","data_type":"dataset","access":"open","doi":["10.17632/37y6z4m8s7"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","grant_id":"PID2020-117916RB-I00/AEI/10.13039/501100011033"}],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"j92bjksxkp","title":"LINF_150016100 ","description":"Dolichol phosphate-mannose biosynthesis regulatory protein (DPM2)\nLeishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-07-09T20:31:08.656Z","url":"https://data.mendeley.com/datasets/j92bjksxkp","data_type":"dataset","access":"open","doi":["10.17632/j92bjksxkp"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"s3jtdhjdbs","title":"Supplementary data for Michaelis et al., 'Protein import motor complex reacts to mitochondrial misfolding by reducing protein import and activating mitophagy'","description":"Supplementary data for Michaelis et al., 'Mitochondrial import loss induces mitophagy without membrane depolarization'. We hypothesized that inhibition of mitochondrial protein import induced mitophagy independent of mitochondrial depolarization. This dataset contains raw Illumina sequencing data for all samples from a genome-wide CRISPR/Cas9 screen for mitophagy regulators. The genome-wide library is Brunello from Doench et al Nat Biotechnol. 2016. We found that the pre-sequence translocase-associated motor complex PAM controls mitophagy induction. Loss of PAM caused a loss in protein import and was sufficient to induce mitophagy without depolarization.\nThe samples have been sequenced on an Illumina NextSeq 500 in single end mode with 75+8 cycles. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-08-05T15:38:53.752Z","url":"https://data.mendeley.com/datasets/s3jtdhjdbs","data_type":"dataset","access":"open","doi":["10.17632/s3jtdhjdbs"],"contributors":[{"first_name":"Jonas","last_name":"Michaelis","orcid":null},{"first_name":"Melinda","last_name":"Brunstein","orcid":null},{"first_name":"Süleyman","last_name":"Bozkurt","orcid":null},{"first_name":"Ludovico","last_name":"Alves","orcid":null},{"first_name":"Martin","last_name":"Wegner","orcid":null},{"first_name":"Manuel","last_name":"Kaulich","orcid":null},{"first_name":"Christian","last_name":"Pohl","orcid":null},{"first_name":"Christian","last_name":"Münch","orcid":null}],"funders":[],"categories":["Proteomics","Mitochondrion","Mitophagy","Genetic Screening","Next Generation Sequencing","CRISPR/Cas9"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"nnxh5d35nd","title":"Genome-wide CRISPR-Cas9 screen identified KLF11 as a druggable suppressor for sarcoma cancer stem cells","description":"The original, unprocessed data alongside the paper","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-05-31T01:39:45.722Z","url":"https://data.mendeley.com/datasets/nnxh5d35nd","data_type":"dataset","access":"open","doi":["10.17632/nnxh5d35nd"],"contributors":[{"first_name":"Le","last_name":"Qu","orcid":null}],"funders":[],"categories":["Cancer"],"journal_issn":[]},{"id":"7bd5bhmhmz","title":"Genome-scale identification of SARS-CoV-2 and pan-coronavirus host factor networks. Schneider et al.","description":"The COVID-19 pandemic has claimed the lives of more than one million people worldwide. The causative agent, SARS-CoV-2, is a member of the Coronaviridae family, which are viruses that cause respiratory infections of varying severity. The cellular host factors and pathways co-opted by SARS- CoV-2 and other coronaviruses in the execution of their life cycles remain ill-defined. To develop an extensive compendium of host factors required for infection by SARS-CoV-2 and three seasonal coronaviruses (HCoV-OC43, HCoV-NL63, and HCoV-229E), we performed parallel genome-scale CRISPR knockout screens. These screens uncovered multiple host factors and pathways with pan- coronavirus and virus-specific functional roles, including major dependency on glycosaminoglycan biosynthesis, SREBP signaling, BMP signaling, and glycosylphosphatidylinositol biosynthesis, as well as a requirement for several poorly characterized proteins. We identified an absolute requirement for the VTT-domain containing protein TMEM41B for infection by SARS-CoV-2 and three seasonal coronaviruses. This human Coronaviridae host factor compendium represents a rich resource to develop new therapeutic strategies for acute COVID-19 and potential future coronavirus spillover events.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-12-03T09:15:53.589Z","url":"https://data.mendeley.com/datasets/7bd5bhmhmz","data_type":"dataset","access":"open","doi":["10.17632/7bd5bhmhmz"],"contributors":[{"first_name":"JT","last_name":"Poirier","orcid":null}],"funders":[],"categories":["Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"75brhkh25r","title":"A genome-wide hepatocyte CRISPR-CAS9 screen to identify host factors essential for optimal Plasmodium liver stage development. ","description":"To identify host genes critical for Plasmodium LS development, we used the GeCKOv2 sgRNA pool to generate a whole-genome knockout library in HepG2-CD81 cells (Sanjana et al., 2014; Shalem et al., 2014). HepG2-CD81 cells were transduced with lentivirus containing the pooled GeCKOv2 sgRNA library of 114,123 sgRNAs targeting 19,031 protein-coding genes (~6 sgRNAs/gene) and selected in puromycin for 5-7 days. To evaluate sgRNA diversity in the HepG2-CD81-GeCKOv2 library, we PCR-amplified the integrated sgRNA cassettes from genomic DNA extracted from transduced cells and subjected the amplified library to Illumina sequencing. At the gene level, sgRNAs targeting all but 15 of 19,031 (99.92%) protein-coding genes were observed. Twelve to fourteen days after post-transduction, we infected forty million puromycin-resistant cells with a green fluorescent protein (GFP) expressing-Plasmodium yoelii at a multiplicity of infection (MOI) of 0.3. After 24 h of infection, cells were sorted into infected and bystander cell populations by GFP signal intensity with fluorescence-activated cell sorting (FACS). Separately, a parallel culture of uninfected cells was also maintained to normalize the sgRNA frequency distributions. We obtained four independent biological replicates with library generation and sequencing occurring in parallel. Genes with significantly enriched sgRNAs were identified for both the bystander and infected populations when compared to uninfected cells. Cells that harbor genetic alterations restricting P. yoelii development (i.e., sgRNAs that target host genes important for infection) were expected to be enriched in the uninfected bin; we termed this group ‘putative positive regulators of infection’. We categorized sgRNAs enriched in the infected cells as ‘putative negative regulators of infection’. In this initial screen, we identified 242 sgRNAs that were statistically enriched in infected or bystander groups after accounting for multiple hypotheses. There were 67 sgRNAs significantly enriched in the infected cells compared to uninfected cells and 175 genes were significantly enriched in the bystander bin relative to the uninfected bin. \n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-27T07:31:54.012Z","url":"https://data.mendeley.com/datasets/75brhkh25r","data_type":"dataset","access":"open","doi":["10.17632/75brhkh25r"],"contributors":[{"first_name":"Kamalakannan","last_name":"Vijayan","orcid":null},{"first_name":"Nadia","last_name":"Arang","orcid":null},{"first_name":"Ling ","last_name":"Wei","orcid":null},{"first_name":"Robert","last_name":"Morrison","orcid":null},{"first_name":"Rechel ","last_name":"Geiger","orcid":null},{"first_name":"Rachael ","last_name":"Parks","orcid":null},{"first_name":"Adam J ","last_name":"Lewis","orcid":null},{"first_name":"Fred D ","last_name":"Mast ","orcid":null},{"first_name":"Alyse N ","last_name":"Douglass","orcid":null},{"first_name":"Heather S ","last_name":"Kain","orcid":null},{"first_name":"John D","last_name":"Aitchison ","orcid":null},{"first_name":"Jarrod S ","last_name":"Johnson","orcid":null},{"first_name":"Alan ","last_name":"Aderem","orcid":null},{"first_name":"Alexis","last_name":"Kaushansky","orcid":null}],"funders":[],"categories":["CRISPR/Cas9"],"journal_issn":[]},{"id":"gptx4bd7ss","title":"Reprogramming host d-mannose metabolism for reduced virus replication and elevated tolerance of inflammatory damage ","description":"Host survival during acute viral infections depends on the elimination of pathogens and mitigation of tissue damage otherwise antivirals or immunomodulatory treatments are essential. One mechanism affecting tolerance is the intensity of an immune response. An overly exuberant immune response can cause collateral damage through immune effectors and because of the energy allocated away from other physiological functions. Herein, we report that the modulation of d-mannose flux, rewires the virus-triggered immunometabolic response cascade, thus ameliorating tissue damage. The beneficial role of d-mannose is achievable via competing with glucose for the same transporter GLUT and same hexokinase. Such alterations impair glucose metabolism by raising intracellular mannose-6-phosphate levels, and result in the suppression of succinate-mediated hypoxia-inducible factor-1α (HIF-1α) activation, imposing a consequent reduction of virus-induced proinflammatory cytokines production including interleukin-1β. As expected, combinatorial treatment of the mannose and FDA-approved antiviral monotherapy exhibits in vivo synergy, particularly in a delayed treatment setting. We found that phosphomannose isomerase (PMI) activity dictates the host response to mannose. Ectopic overexpression of PMI and/or supplement of downstream PMI metabolite fructose 6-phosphate diminish the protective role of mannose. We also found that PMI is a druggable target with broad-spectrum potential. Both genetic depletion and pharmacological inhibition of PMI suppress a panel of virus replication. Mechanistically, PMI inhibition affects viral surface protein glycosylation thus blocks virus entry. These results highlight a mannose-centered and dual therapeutic strategy for therapeutic cure of viral diseases, that is the PMI-glycosylation axis for pathogen clearance, and HIF1α-IL1β axis for inflammation control.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-18T07:42:07.501Z","url":"https://data.mendeley.com/datasets/gptx4bd7ss","data_type":"dataset","access":"open","doi":["10.17632/gptx4bd7ss"],"contributors":[{"first_name":"Shuofeng","last_name":"Yuan","orcid":null},{"first_name":"Peng","last_name":"Luo","orcid":null}],"funders":[],"categories":["Virus"],"journal_issn":[]}],"total_records":137542,"page":1,"page_size":10,"execution_time":163,"aggregations":{"data_type_stats":{"dataset":137542,"collection":0},"access_type_stats":{"open":136948,"restricted":67,"embargoed":527},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2273},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":670},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":507},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":478},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":441},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":434},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":414},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":377},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":328},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":273}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":134896},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1909},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":182},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":135},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":75},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":59},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":42},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":31},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":28}],"top_institutions_stats":[{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":585},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":518},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":409},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":368},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":360}]}}