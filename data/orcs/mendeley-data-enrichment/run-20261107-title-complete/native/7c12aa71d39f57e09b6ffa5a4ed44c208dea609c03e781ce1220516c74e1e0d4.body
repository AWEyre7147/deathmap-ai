{"records":[{"id":"wph373m86f","title":"RNA-seq (FPKM), RT-qPCR, and qPCR datasets of host responses in Orientia tsutsugamushi-infected mouse macrophages","description":"This dataset contains gene expression and validation data derived from primary mouse macrophages infected with Orientia tsutsugamushi. The primary dataset consists of a genome-wide RNA-seq expression matrix reported as FPKM (Fragments Per Kilobase of transcript per Million mapped reads) values for 28,000+ genes, aligned to the Mus musculus reference genome (mm10). The matrix includes genomic annotations (gene ID, chromosome, genomic coordinates) and normalized expression values across multiple experimental conditions and biological replicates.\nIn addition to the RNA-seq dataset, the file includes qRT-PCR validation data for selected host genes (Figures 1, 4, and 5), with expression levels normalized to Gapdh. The dataset also contains bacterial burden measurements quantified by qPCR targeting the 47-kDa gene, expressed as gene copy number per sample.\nTogether, these data provide both transcriptome-wide expression profiles (FPKM) and targeted validation of host response and bacterial load under different infection conditions.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-20T15:01:42.653Z","url":"https://data.mendeley.com/datasets/wph373m86f","data_type":"dataset","access":"open","doi":["10.17632/wph373m86f"],"contributors":[{"first_name":"Dario","last_name":"Villacreses","orcid":null}],"funders":[{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":"AI193808"},{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":"AI132674"},{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":"AI007526"},{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":"AI060549"},{"id":"https://ror.org/016tfm930","name":"The University of Texas Medical Branch at Galveston","grant_id":null}],"categories":["Immunology","RNA Sequencing","Host Defense","Innate Immunity"],"journal_issn":[]},{"id":"d3nyr5j9zy","title":"Data for: Rifamycin derivatives active against pathogenic rapidly-growing mycobacteria","description":"MIC and Zone of inhibition data for a series of C25 Carbamate derivatives against a panel of clinical isolates of RGM including Mycobacterium abscessus","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-08-08T20:10:27.551Z","url":"https://data.mendeley.com/datasets/d3nyr5j9zy","data_type":"dataset","access":"open","doi":["10.17632/d3nyr5j9zy"],"contributors":[{"first_name":"Keith","last_name":"Combrink","orcid":null}],"funders":[],"categories":["Microbiology","Pharmaceutical Chemistry"],"journal_issn":["0960894X"]},{"id":"sgdcys9b82","title":"Mycobacterium-Host Screening Identifies Novel Lysosomal Escape Pathways","description":"This dataset explores intracellular survival mechanisms of Mycobacterium leprae. Using clinical lesion proteomics, we identified 14 highly expressed T7SS effectors. Genome-wide yeast two-/three-hybrid screening against a macrophage interactome revealed 132 host targets and mapped the first global M. leprae effector–host interaction network. Functional validation defined two conserved lysosomal escape pathways: PPE68–Coro1A preventing phagosome–lysosome fusion, and EsxA–EsxB–CCDC115 disrupting V-ATPase assembly. Comparative M. marinum models confirmed their essential role in survival and pathogenesis. The dataset includes proteomic profiles, interaction matrices, and validation assays, which can be used to investigate host–pathogen interactions and identify therapeutic targets.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-09-29T07:59:18.944Z","url":"https://data.mendeley.com/datasets/sgdcys9b82","data_type":"dataset","access":"open","doi":["10.17632/sgdcys9b82"],"contributors":[{"first_name":"Bingqing","last_name":"Li","orcid":null},{"first_name":"xiaojie","last_name":"Liao","orcid":null},{"first_name":"Yongyu","last_name":"Wang","orcid":null},{"first_name":"Longyun ","last_name":"Chen","orcid":null},{"first_name":"Rongxian","last_name":"Xie","orcid":null},{"first_name":"Haihong","last_name":"Jia","orcid":null},{"first_name":"Yuzhen","last_name":"Wang","orcid":null},{"first_name":"Xiaoyu","last_name":"Liu","orcid":null},{"first_name":"Nannan","last_name":"Song","orcid":null},{"first_name":"玮玮","last_name":"王","orcid":null},{"first_name":"Zhongrui","last_name":"Ma","orcid":null},{"first_name":"Yinjie","last_name":"Lin","orcid":null},{"first_name":"Peidian","last_name":"Shi","orcid":null},{"first_name":"Wenchao","last_name":"Li","orcid":null},{"first_name":"Yuanqiang","last_name":"Sun","orcid":null},{"first_name":"Zhenzhen","last_name":"Wang","orcid":null},{"first_name":"Xuechao","last_name":"Chen","orcid":null},{"first_name":"Jianwen","last_name":"Wang","orcid":null},{"first_name":"Zhe","last_name":"Wang","orcid":null},{"first_name":"Zihao","last_name":"Mi","orcid":null},{"first_name":"Hong","last_name":"Liu","orcid":null},{"first_name":"Furen","last_name":"Zhang","orcid":null}],"funders":[],"categories":["Microbiology","Bacterial Pathogenesis"],"journal_issn":[]},{"id":"579hs6zm8x","title":"M.abscessus MALDI TOF raw data","description":"MALDI TOF MS Raw data of M.abscessus sumitting with study title \"MALDI-TOF mass spectrometry discriminates drug-susceptible and -resistant strains in Mycobacterium abscessus\" ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-03-18T15:43:14.649Z","url":"https://data.mendeley.com/datasets/579hs6zm8x","data_type":"dataset","access":"open","doi":["10.17632/579hs6zm8x"],"contributors":[{"first_name":"Thai","last_name":"Tran Duong Quoc","orcid":null}],"funders":[],"categories":["Database"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"zhpg8xshp9","title":"Lawrence et al., PNAS 2026","description":"Data from “Lawrence et al., 2026 A Genome-Wide Screen Identifies that PLCG2 Restrains Lysosomal GCase Activity.\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-22T18:23:16.389Z","url":"https://data.mendeley.com/datasets/zhpg8xshp9","data_type":"dataset","access":"open","doi":["10.17632/zhpg8xshp9"],"contributors":[{"first_name":"Baris","last_name":"Bingol","orcid":null}],"funders":[],"categories":["Natural Sciences"],"journal_issn":[]},{"id":"nyn84yyms7","title":"Phenome-wide and eQTL Associations of COVID-19 Genetic Risk Loci. Moon et al","description":"While several genes and clinical traits have been associated with higher risk of severe COVID-19, how host genetic variants may interact with these parameters and contribute to severe disease is still unclear. Herein, we performed phenome-wide association study (PheWAS), tissue and immune-cell specific expression/splicing quantitative trait loci (eQTL/sQTL), and colocalization analyses for genetic risk loci suggestively associated with severe COVID-19 with respiratory failure. Thirteen phenotypes/traits were associated with the severe COVID-19-associated loci at the genome-wide significance threshold, including monocyte counts, fat metabolism traits, and fibrotic idiopathic interstitial pneumonia. In addition, we identified tissue and immune subtype-specific eQTL associations affecting 48 genes, including several that may directly impact host immune responses, colocalized with the severe COVID-19 GWAS associations, and showed altered expression in single-cell transcriptomes. Collectively, our work demonstrates that host genetic variations associated with multiple genes and traits show genetic pleiotropy with severe COVID-19 and may inform disease etiology.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-05-13T02:58:02.651Z","url":"https://data.mendeley.com/datasets/nyn84yyms7","data_type":"dataset","access":"open","doi":["10.17632/nyn84yyms7"],"contributors":[{"first_name":"Chang","last_name":"Moon","orcid":null},{"first_name":"Brian","last_name":"Schilder","orcid":null},{"first_name":"Towfique","last_name":"Raj","orcid":null},{"first_name":"Kuan-lin","last_name":"Huang ","orcid":null}],"funders":[],"categories":["Genetics","COVID-19"],"journal_issn":[]},{"id":"8xhv88c7wt","title":"Genome-wide screening in human kidney organoids identifies developmental and disease-related aspects of nephrogenesis","description":"Human organoids allow the study of proliferation, lineage specification, and three-dimensional tissue development. Here, we present a genome-wide CRISPR screen in iPSC-derived kidney organoids. The combination of inducible genome editing, longitudinal sampling and endpoint sorting of tubular and stromal cells generated a complex, high-quality dataset uncovering a broad spectrum of insightful biology from early development to ‘adult’ epithelial morphogenesis. Our functional dataset allows improving mesoderm induction by ROCK inhibition, contains monogenetic and complex trait kidney disease genes, confirms two additional CAKUT genes (CCDC170 and MYH7B), and provides a large candidate list of ciliopathy-related genes. Finally, the identification of a cis-inhibitory effect of Jagged1 controlling epithelial proliferation shows how mosaic knockouts in pooled CRISPR screening can discover ways of communication between heterogeneous cell populations in complex tissues. Collectively, these data serve both as a rich resource for the kidney community and as a benchmark for future iPSC-derived organoid CRISPR screens.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-29T13:48:59.335Z","url":"https://data.mendeley.com/datasets/8xhv88c7wt","data_type":"dataset","access":"open","doi":["10.17632/8xhv88c7wt"],"contributors":[{"first_name":"Rosemarie","last_name":"Ungricht","orcid":null},{"first_name":"Philipp","last_name":"Hoppe","orcid":null}],"funders":[],"categories":["Screening","CRISPR"],"journal_issn":[]},{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"9x47wzy8x7","title":"A study of \"Genome-wide CRISPR screens reveal host factors critical for SARS-CoV-2 infection\" by Wei et al. Cell 2020","description":"Identification of host genes essential for SARS-CoV-2 infection may reveal novel therapeutic targets and inform our understanding of COVID-19 pathogenesis. Here, we performed genome-wide CRISPR screens in Vero-E6 cells with SARS-CoV-2, MERS-CoV, bat coronavirus HKU5 expressing the SARS-CoV-1 spike, and VSV expressing the SARS-CoV-2 spike. Together this identifies potential therapeutic targets for SARS-CoV-2 and reveals SARS-lineage specific and pan-coronavirus host factors that regulate susceptibility to highly pathogenic coronaviruses.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-15T21:29:14.06Z","url":"https://data.mendeley.com/datasets/9x47wzy8x7","data_type":"dataset","access":"open","doi":["10.17632/9x47wzy8x7"],"contributors":[{"first_name":"Craig","last_name":"Wilen","orcid":null}],"funders":[],"categories":["CRISPR","Middle East Respiratory Syndrome-Related Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]}],"total_records":142496,"page":1,"page_size":10,"execution_time":140,"aggregations":{"data_type_stats":{"dataset":142496,"collection":0},"access_type_stats":{"open":141732,"restricted":70,"embargoed":694},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2352},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1387},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":696},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":482},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":455},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":440},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":424},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":395},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":335},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":277}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":139830},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1914},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":188},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":140},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":80},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":59},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":43},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":31},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":25}],"top_institutions_stats":[{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":898},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":850},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":534},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":408},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":372}]}}