{"records":[{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"fm4h3mphcr","title":"NGS, confocal microscopy and flow cytometry data of CRISPR/Cas9-edited ARE1 and KAT2 genes in transgenic maize in vitro tissues exposed to chromatin modifiers","description":"This dataset contains raw NGS reads (NGS_data folder), fluorescence microscopy photos (Fig7B Microscopy Originals.lif) and flow cytometry data (@Fig6 FACS original data.zip) derived from transgenic maize (Zea mays L.) in vitro tissues exposed to chromatin modifiers. They are presented in research article ˝Variable Alterations in Frequencies of CRISPR/Cas9-Induced Nucleotide Deletion and Insertion in Transgenic Maize Callus Tissues Exposed to Chromatin Modifiers˝.\nStable transgenic maize lines harboring active CRISPR/Cas9 vector systems targeting either the abnormal cytokinin response 1 (ARE1) gene or the potassium channel gene (KAT2) were used. Mutagenic events following exposure to elevated temperatures (37 °C for 48 h) and various chromatin-modifying compounds were quantified. As a novel approach, the mutagenic potential of combining chromatin-modifying agents with heat exposure was examined.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-09-24T23:17:12.229Z","url":"https://data.mendeley.com/datasets/fm4h3mphcr","data_type":"dataset","access":"open","doi":["10.17632/fm4h3mphcr"],"contributors":[{"first_name":"Bettina","last_name":"Nagy","orcid":null},{"first_name":"Györgyi","last_name":"Ferenc","orcid":null},{"first_name":"Ferhan","last_name":"Ayaydin","orcid":"0000-0003-4450-0667"},{"first_name":"Divya","last_name":"Teja","orcid":"0009-0001-0210-7878"},{"first_name":"Dénes","last_name":"Dudits","orcid":null},{"first_name":"Zoltán","last_name":"Zombori","orcid":null},{"first_name":"Nikolett","last_name":"Laszlo","orcid":null},{"first_name":"Aysha","last_name":"Jameel","orcid":null},{"first_name":"Gábor","last_name":"Horváth","orcid":null}],"funders":[{"id":null,"name":"EU’s Horizon 2020 Research and Innovation Program","grant_id":" 739593"},{"id":"https://ror.org/03g2am276","name":"National Research, Development and Innovation Office","grant_id":"RRF 2.3.1–21-2022- 00007 grant for the ‘National Laboratory Program of Agrobiotechnology and Precision Plant Breeding to Support Food Safety’"}],"categories":["Confocal Microscopy","Flow Cytometry","Next Generation Sequencing"],"journal_issn":[]},{"id":"wp9fht9k3k","title":"Retinol Binding Protein 4 reactivates latent HIV-1  by triggering canonical NF-κB, JAK/STAT5 and JNK signalling","description":"Reactivation of the latent viral reservoirs is crucial for a cure of HIV/AIDS. However, current latency reversing agents are inefficient and the endogenous factors that have the potential to reactivate HIV in vivo remain poorly understood. To identify natural activators of latent HIV-1, we screened a comprehensive peptide/protein library derived from human hemofiltrate, representing the entire blood peptidome, using J-Lat cell lines harboring transcriptionally silent HIV-1 GFP reporter viruses.  Fractions potently reactivating HIV-1 from latency contained human Retinol Binding Protein 4 (RBP4), the carrier of retinol (vitamin A). We found that retinol-bound holo-RBP4 but not retinol-free apo-RBP4 strongly reactivates HIV-1 in a variety of latently infected T cell lines. Functional analyses indicate that this reactivation involves activation of the canonical NF-B pathway and is complemented by JAK/STAT5 and JNK signalling but does not require retinoic acid production. High levels of RBP4 were detected in plasma from both healthy individuals and people living with HIV-1. Physiological concentrations of RBP4 induced significant viral reactivation in latently infected cells from individuals on long-term antiretroviral therapy with undetectable viral loads. As a potent natural HIV-1 latency-reversing agent, RBP4 offers a novel approach to activating the latent reservoirs and bringing us closer to a cure.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-08-26T17:18:07.605Z","url":"https://data.mendeley.com/datasets/wp9fht9k3k","data_type":"dataset","access":"open","doi":["10.17632/wp9fht9k3k"],"contributors":[{"first_name":"Chiara","last_name":"Pastorio","orcid":null},{"first_name":"Khumoekae","last_name":"Richard","orcid":null},{"first_name":"Shariq","last_name":"Usmani","orcid":null},{"first_name":"Ann-Kathrin","last_name":"Kissmann","orcid":null},{"first_name":"Grigory","last_name":"Bolotnikov","orcid":null},{"first_name":"Guillermo","last_name":"Gosálbez","orcid":null},{"first_name":"Manuel","last_name":"Hayn","orcid":null},{"first_name":"Lennart","last_name":"Koepke","orcid":null},{"first_name":"Andrea","last_name":"Preising","orcid":null},{"first_name":"Alina","last_name":"Sauertnik","orcid":null},{"first_name":"Nico","last_name":"Preising","orcid":null},{"first_name":"Ludger","last_name":"Ständker","orcid":null},{"first_name":"Matthew","last_name":"Fair","orcid":null},{"first_name":"Jessicamarie","last_name":"Morris","orcid":null},{"first_name":"Emmanouil","last_name":"Papasavvas","orcid":null},{"first_name":"Qin","last_name":"Liu","orcid":null},{"first_name":"Honghong","last_name":"Sun","orcid":null},{"first_name":"Armando","last_name":"Rodríguez","orcid":null},{"first_name":"Karam","last_name":"Mounzer","orcid":null},{"first_name":"Sebastian","last_name":"Wiese","orcid":null},{"first_name":"Pablo","last_name":"Tebas","orcid":null},{"first_name":"Yangzhu","last_name":"Du","orcid":null},{"first_name":"Gregory","last_name":"M. Laird","orcid":null},{"first_name":"Markus","last_name":"Jaritz","orcid":null},{"first_name":"Frank","last_name":"Rosenau","orcid":null},{"first_name":"Moritz M.","last_name":"Gaidt","orcid":null},{"first_name":"Konstantin M. J.","last_name":"Sparrer","orcid":null},{"first_name":"Luis J.","last_name":"Montaner","orcid":null},{"first_name":"Frank","last_name":"Kirchhoff","orcid":null}],"funders":[],"categories":["Virology","HIV/AIDS","Clinical Virology","Bioactive Peptides","Molecular Virology"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"3rjx6fsdmz","title":"Demethylation of the protein phosphatase PP2A promotes demethylation of histones to enable their function as a methyl group sink","description":"Dysregulation of chromatin methylation is associated with defects in cellular differentiation as well as a variety of cancers. How cells regulate the opposing activities of histone methyltransferase and demethylase enzymes to set the methylation status of the epigenome for proper control of gene expression and metabolism remains poorly understood. Here, we show that loss of methylation of the major phosphatase PP2A in response to methionine starvation activates the demethylation of histones through hyperphosphorylation of specific demethylase enzymes. In parallel, this regulatory mechanism enables cells to preserve SAM by increasing SAH to limit SAM consumption by methyltransferase enzymes. Mutants lacking the PP2A methyltransferase or the effector H3K36 demethylase Rph1 exhibit elevated SAM levels and are dependent on cysteine due to reduced capacity to sink the methyl groups of SAM. Therefore, PP2A directs the methylation status of histones by regulating the phosphorylation status of histone demethylase enzymes in response to SAM levels.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-01-18T02:10:18.489Z","url":"https://data.mendeley.com/datasets/3rjx6fsdmz","data_type":"dataset","access":"open","doi":["10.17632/3rjx6fsdmz"],"contributors":[{"first_name":"Cunqi","last_name":"Ye","orcid":null},{"first_name":"Benjamin","last_name":"Tu","orcid":null}],"funders":[],"categories":["Methylation","Phosphatases","Metabolism","Histone Modification","S-Adenoysylmethionine"],"journal_issn":[]},{"id":"4mb5kjywkj","title":"Western Blot raw data of the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\"","description":"The raw images of WB is for the reviewers' request when reviewing the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-04T00:26:32.621Z","url":"https://data.mendeley.com/datasets/4mb5kjywkj","data_type":"dataset","access":"open","doi":["10.17632/4mb5kjywkj"],"contributors":[{"first_name":"Mingang","last_name":"Hao","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"s7thkp9z4r","title":"The CBL-LSD1-CXCL8 Axis Regulates Methionine Metabolism in Glioma","description":"We found that CXCL8 expression was significantly increased in a methionine restricted environment due to the upregulation of H3K4 methylation. Mechanistically, the E3 ubiquitin ligase CBL mediated the ubiquitinated degradation of histone demethylase LSD1, reducing LSD1 protein stability and enhancing H3K4me1 modification of the CXCL8 gene.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-24T09:21:30.923Z","url":"https://data.mendeley.com/datasets/s7thkp9z4r","data_type":"dataset","access":"open","doi":["10.17632/s7thkp9z4r"],"contributors":[{"first_name":"jie","last_name":"chang","orcid":null}],"funders":[],"categories":["Metabolism","Glioma","Methionine"],"journal_issn":[]},{"id":"nnxh5d35nd","title":"Genome-wide CRISPR-Cas9 screen identified KLF11 as a druggable suppressor for sarcoma cancer stem cells","description":"The original, unprocessed data alongside the paper","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-05-31T01:39:45.722Z","url":"https://data.mendeley.com/datasets/nnxh5d35nd","data_type":"dataset","access":"open","doi":["10.17632/nnxh5d35nd"],"contributors":[{"first_name":"Le","last_name":"Qu","orcid":null}],"funders":[],"categories":["Cancer"],"journal_issn":[]},{"id":"gfcn2wmrpf","title":"Dataset for the paper entitled \"A genetic map of the response to DNA damage in human cells\" by Olivieri M et al. Cell 2020","description":"We used pooled CRISPR/Cas9 screens in the human RPE1-hTERT p53-/- cell line against 27 genotoxic agents. The Dataset herein make the primary data available. The files are:\n\n* Additional genes of interest (discussion and data relating to TMEM2, ESD, USP37, PHF12, BTAF1 and DRAP1)\n* Supplementary Raw Data: Data used to make all the graphs in the manuscript\n* Folder \"CRISPR screen readcount files\". Readcounts for the screens undertaken as part of this study.\n* Folder \"Raw images for immunoblots\": uncropped images for all the blots in the manuscript\n* Folder: \"Additional QC analyses of CRISPR screens\": Additional analyses that measure the quality of the screens using Presion-Recall curves of essential genes and an estimate of genes that scored as hits due to batch effects.\n* Folder \"Data_Analysis_Code\" R markdown file along with data files\n* File: \"Additional Genes of Interests\" contains a short discussion of genes we found noteworthy after analysis of our screen data.\n\nVersion 2 note: this version differs from Version 1 by a single file (FDRPos_31screens.csv) which has a tab error fixed.\n\n\n\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-07-07T14:26:40.176Z","url":"https://data.mendeley.com/datasets/gfcn2wmrpf","data_type":"dataset","access":"open","doi":["10.17632/gfcn2wmrpf"],"contributors":[{"first_name":"Daniel","last_name":"Durocher","orcid":null},{"first_name":"Michele","last_name":"Olivieri","orcid":null}],"funders":[],"categories":["Data Quality","Primary Data"],"journal_issn":[]},{"id":"r79ngfdb56","title":"High-throughput sequencing of Precise CRISPR/Cas9-targeted Recessive Dystrophic Epidermolysis Bullosa immortalised keratinocytes (Ion Torrent)","description":"In this study, the COL7A1 on-target (exon 73) was analysed for precise CRISPR/Cas9 activity. \nNGS data was assessed in CRISPR/Cas9-treated immortalised patient keratinocytes\nDespite high on-target activity, high homgeneity of DSB repair outcomes was observed at the nuclease target site. This should result in efficient reframing of the gene, with minimal divergence from the wild-type sequence.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-09-20T10:54:06.313Z","url":"https://data.mendeley.com/datasets/r79ngfdb56","data_type":"dataset","access":"open","doi":["10.17632/r79ngfdb56"],"contributors":[{"first_name":"Oliver","last_name":"March","orcid":null}],"funders":[],"categories":["Next Generation Sequencing"],"journal_issn":[]}],"total_records":129485,"page":1,"page_size":10,"execution_time":107,"aggregations":{"data_type_stats":{"dataset":129485,"collection":0},"access_type_stats":{"open":129047,"restricted":66,"embargoed":372},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2208},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":642},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":470},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":434},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":427},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":405},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":365},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":350},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":304},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":269}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":126871},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1905},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":180},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":131},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":70},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":56},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":41},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":30},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":25}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":500},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":401},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":400},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":359},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":330}]}}