rant_id":"PJT 173542"},{"id":"https://ror.org/000az4664","name":"Canada Foundation for Innovation","grant_id":"39977"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE09-011"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE011-006"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-180285"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-GMX-463531"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2024-08-02"},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","grant_id":"DFG Bi 2086/1-1"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG005084"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2022-02"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG00583"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"T32GM008347"},{"id":null,"name":"NIH/NCI Ruth L. Kirschstein National Research F30 Award","grant_id":"5F30CA257227"}],"categories":["Genetics","Biological Network"],"journal_issn":[]},{"id":"8zg72dh86w","title":"Combinatorial gene essentiality and pharmacological profiling uncovers enhancer-mediated synthetic lethal interactions with Mediator Kinase","description":"This datasets contain all the original western blots published in \"Combinatorial gene essentiality and pharmacological profiling uncovers enhancer-mediated synthetic lethal interactions with Mediator Kinase\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-12-15T13:01:12.712Z","url":"https://data.mendeley.com/datasets/8zg72dh86w","data_type":"dataset","access":"open","doi":["10.17632/8zg72dh86w"],"contributors":[{"first_name":"Claire","last_name":"Sun","orcid":null},{"first_name":"Ron","last_name":"Firestein","orcid":null},{"first_name":"Dhanya","last_name":"Sooraj","orcid":null},{"first_name":"Aleks","last_name":"Guanizo","orcid":null},{"first_name":"Chunhua","last_name":"Wan","orcid":null},{"first_name":" Marius","last_name":"Dannappel ","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"bf934g5cdm","title":"Supplemental Materials for \"Increased risk of sepsis-caused death in Black patients with primary cutaneous T-cell lymphoma and Burkitt lymphoma: A population study of the US SEER registry","description":"Supplemental Figure 1. Flowchart of the study. Results of univariate comparison analyses between sepsis deaths and non-sepsis deaths among CTCL patients or between CTCL sepsis deaths and non-CTCL NHL sepsis deaths were shown in Table 1. SEER, Surveillance, Epidemiology, and End Results; NHL, non-Hodgkin lymphoma; ICD-O, International Classification of Diseases for Oncology; CTCL, cutaneous T-cell lymphoma; MF, Mycosis fungoides; PC-ALCL, Primary cutaneous anaplastic large cell lymphoma; SS, Sezary syndrome; SPTCL, Subcutaneous panniculitis-like T-cell lymphoma; PC-γδTCL, Primary cutaneous gamma-delta T-cell lymphoma; CTLC, NOS, cutaneous T-cell lymphoma, not otherwise specified.\nSupplemental Table 1. The specified number of patients and sepsis-caused deaths for each subtype of all non-Hodgkin lymphomas excluding primary cutaneous T-cell lymphomas.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-08-22T03:14:47.364Z","url":"https://data.mendeley.com/datasets/bf934g5cdm","data_type":"dataset","access":"open","doi":["10.17632/bf934g5cdm"],"contributors":[{"first_name":"Yijun","last_name":"Wu","orcid":null}],"funders":[],"categories":["Cutaneous T-Cell Lymphoma"],"journal_issn":[]},{"id":"69my4hnj2y","title":"Exhaustive circulating tumor DNA sequencing reveals genomic landscape of Hodgkin lymphoma and facilitates ultrasensitive residual disease detection","description":"Supplementary tables for manuscript: \"Exhaustive circulating tumor DNA sequencing reveals genomic landscape of Hodgkin lymphoma and facilitates ultrasensitive residual disease detection\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-12-19T18:15:43.781Z","url":"https://data.mendeley.com/datasets/69my4hnj2y","data_type":"dataset","access":"open","doi":["10.17632/69my4hnj2y"],"contributors":[{"first_name":"Sven","last_name":"Borchmann","orcid":null}],"funders":[],"categories":["Genomics","Cancer"],"journal_issn":[]},{"id":"6t7298zrb2","title":"BETi/HDACi treatment of CTCL cells induces significant alterations of transcripts regulating CTCL apoptosis","description":"Based on our prior efficacy and toxicity studies, we selected 125nM birabresib (OTX015) (BETi) and 1nM romidepsin (HDACi) for all experiments in this report (Zhao et al., 2019). Gene expression was analyzed in triplicate on HH, Hut78, MyLa, SeAx and SZ4 CTCL lines at 0, 6, 48 and 96 hours post-treatment and normalized to housekeeping genes. Analysis was enriched for pro- and anti-apoptotic, oncogenic and tumor suppressor genes. \n\nReference\nZhao L, Ohkovat J-P, Hong EK, Kim YH, Wood GS. Preclinical studies support combined inhibition of BET family proteins and histone deacetylases as epigenetic therapy for cutaneous T-cell lymphoma. Neoplasia 21: 82-92, 2019.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-05-12T08:50:35.598Z","url":"https://data.mendeley.com/datasets/6t7298zrb2","data_type":"dataset","access":"open","doi":["10.17632/6t7298zrb2"],"contributors":[{"first_name":"Lei","last_name":"Zhao","orcid":null},{"first_name":"Gary","last_name":"Wood","orcid":"0000-0001-5449-2432"}],"funders":[],"categories":["Expression Array"],"journal_issn":[]},{"id":"ft63v4p2cp","title":"A specific form of cPRC1 containing CBX4 is co-opted to mediate oncogenic gene repression in diffuse midline glioma","description":"Diffuse midline glioma (DMG) is a fatal childhood brain tumour characterised primarily by mutant histone H3 (H3K27M). H3K27M causes a global reduction in Polycomb Repressive Complex 2 (PRC2)-mediated H3K27me3. Paradoxically, PRC2 is essential in DMG cells, although the downstream molecular mechanisms are poorly understood. Here, we’ve discovered a specific form of canonical PRC1 (cPRC1) containing CBX4 and PCGF4 drives oncogenic gene repression downstream of H3K27me3 in DMG cells. Via a novel functional region, CBX4 preferentially associates with PCGF4 containing cPRC1. The characteristic H3K27me3 landscape in DMG rewires the distribution of cPRC1 complexes, with CBX4/PCGF4-cPRC1 accumulating at H3K27me3 enriched CpG islands. Despite comprising <5% of cPRC1 in DMG cells, the unique repressive functions of CBX4/PCGF4-cPRC1 are essential for DMG growth. Our findings link the altered distribution of H3K27me3 to imbalanced cPRC1 function, which drives oncogenic gene repression in DMG, highlighting potential therapeutic opportunities for this incurable childhood brain cancer.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-04-23T09:04:34.191Z","url":"https://data.mendeley.com/datasets/ft63v4p2cp","data_type":"dataset","access":"open","doi":["10.17632/ft63v4p2cp"],"contributors":[{"first_name":"Eimear","last_name":"Lagan","orcid":null},{"first_name":"Dáire","last_name":"Gannon","orcid":null},{"first_name":"AJ","last_name":"Silva","orcid":null},{"first_name":"Peter","last_name":"Bibawi","orcid":null},{"first_name":"Anthony ","last_name":"Doherty","orcid":null},{"first_name":"Darragh","last_name":"Nimmo","orcid":null},{"first_name":"Rachel","last_name":"McCole","orcid":null},{"first_name":"Craig ","last_name":"Monger","orcid":null},{"first_name":"Giovani","last_name":"Genesi","orcid":null},{"first_name":"Aurelie","last_name":"Vanderlinden","orcid":null},{"first_name":"James","last_name":"Innes","orcid":null},{"first_name":"Charlotte","last_name":"Jones","orcid":null},{"first_name":"Lu","last_name":"Yang","orcid":null},{"first_name":"Bryan","last_name":"Chen","orcid":null},{"first_name":"Guido","last_name":"van Mierlo","orcid":null},{"first_name":"Pascal","last_name":"Jansen","orcid":null},{"first_name":"Chinmayi","last_name":"Pednekar","orcid":null},{"first_name":"Alexander","last_name":"von Kriegsheim","orcid":null},{"first_name":"Keiran ","last_name":"Wynne","orcid":null},{"first_name":"Francisco","last_name":"Sánchez-Rivera","orcid":null},{"first_name":"Yadira","last_name":"Soto-Feliciano","orcid":null},{"first_name":"Michiel","last_name":"Vermeulen","orcid":null},{"first_name":"Giorgio","last_name":"Oliviero","orcid":null},{"first_name":"Chun-Wei","last_name":"Chen","orcid":null},{"first_name":"Richard","last_name":"Phillips","orcid":null},{"first_name":"Adrian","last_name":"Bracken","orcid":null},{"first_name":"Gerard","last_name":"Brien","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"3hy54433kw","title":"Multimodal imaging for diagnosis and follow-up of primary vitreoretinal lymphoma: A systematic review and meta-analysis.","description":"To evaluate the imaging findings for diagnosis and monitoring of primary vitreoretinal lymphoma (PVRL).","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-07-07T16:23:26.636Z","url":"https://data.mendeley.com/datasets/3hy54433kw","data_type":"dataset","access":"open","doi":["10.17632/3hy54433kw"],"contributors":[{"first_name":"Farhad","last_name":"Salari","orcid":null},{"first_name":"Fariba","last_name":"Ghassemi","orcid":null}],"funders":[],"categories":["Ocular Oncology"],"journal_issn":[]},{"id":"dby7kdtzk8","title":"Cutaneous Epstein-Barr Virus-Positive Diffuse Large B-cell Lymphoma, not otherwise specified: A systematic review and comparative analysis with Epstein-Barr Virus-negative, leg type","description":"Supplement 1. PRISMA flow diagram of literature search and study selection. \nEBV+ DLBCL, NOS, Epstein-Barr Virus-positive diffuse large B-cell lymphoma, not otherwise specified; PRISMA, Preferred Reporting Items for Systematic Reviews and Meta-Analyses.\n\nSupplement 2. Histopathological features of cutaneous Epstein-Barr Virus-positive diffuse large B-cell lymphoma, not otherwise specified. (A) Pleomorphic atypical large cells in a background rich in reactive cells such as lymphohistiocytes and plasma cells (hematoxylin and eosin, x200). (B) Monotonous sheets of immunoblast-like large cells (hematoxylin and eosin, x200). Atypical large lymphoid cells of cutaneous Epstein-Barr Virus-positive diffuse large B-cell lymphoma, not otherwise specified highlighted by (C) MUM-1 (x200), (D) BCL-2 (x200), and (E) CD30 (x200); Epstein-Barr Virus infection detected by (F) positive Epstein-Barr encoding region in situ hybridization (x200).\n\nSupplement 3. Survival analysis of cutaneous Epstein-Barr Virus-positive diffuse large B-cell lymphoma, not otherwise specified (EBV+ DLBCL, NOS). (A) Difference in overall survival between primary cutaneous EBV+ DLBCL, NOS and primary cutaneous Epstein-Barr Virus-negative diffuse large B-cell lymphoma, leg type (EBV- DLBCL, leg type). (B) Comparison in survival between primary cutaneous EBV+ DLBCL, NOS and concurrent cutaneous and extracutaneous EBV+ DLBCL, NOS.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-01-27T07:21:33.083Z","url":"https://data.mendeley.com/datasets/dby7kdtzk8","data_type":"dataset","access":"open","doi":["10.17632/dby7kdtzk8"],"contributors":[{"first_name":"Woo Jin ","last_name":"Lee","orcid":null}],"funders":[],"categories":["Lymphoma","Lymphoma of the Skin"],"journal_issn":[]},{"id":"x3k65sxcg3","title":"Replication package for \"Aggregate Risk and Social Security in the United States\"","description":"- Paper Title: Aggregate Risk and Social Security in the United States\n- Author: Shantanu Bagchi\n- Overview of the replication package: four folders, containing models organized as\n\t- Riskless\n\t\t- Primary executable code\n\t\t- Associated function files (dependencies)\n\t- Stochastic\n\t\t- Primary executable code\n\t\t- Associated function files (dependencies)\n\t\t- Data folder\n\t\t\t- Formatted text file with equilibrium object values\n\t\t\t- Formatted text file with coefficients of forecast functions\n\t- Riskless with exogenous labor\n\t\t- Primary executable code\n\t\t- Associated function files (dependencies)\n\t- Stochastic with exogenous labor\n\t\t- Primary executable code\n\t\t- Associated function files (dependencies)\n\t\t- Data folder\n\t\t\t- Formatted text file with equilibrium object values\n\t\t\t- Formatted text file with coefficients of forecast functions\n- Software needed: MATLAB 2023 or above, with \n\t- Statistics toolbox\n\t- Paul Fackler's CompEcon toolbox (available at https://github.com/PaulFackler/CompEcon)\n- Replication procedure:\n\t- Download each folder into your local storage location\n\t- Start MATLAB 2023 or above in your computer\n\t- Ensure that the CompEcon toolbox is added to MATLAB's path\n\t- Open the primary executable file in \"Editor\" \n\t- Select the appropriate experiment code (guidelines provided in the comments), and compile by clicking \"Run\"\n\t- After completing, the command window will display the results with appropriate labels for economic variables\n\t","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-22T14:27:43.187Z","url":"https://data.mendeley.com/datasets/x3k65sxcg3","data_type":"dataset","access":"open","doi":["10.17632/x3k65sxcg3"],"contributors":[{"first_name":"Shantanu","last_name":"Bagchi","orcid":null}],"funders":[],"categories":["Macroeconomic Aspect of Public Finance","Business Cycle","Government Expenditure on Social Security"],"journal_issn":[]}],"total_records":132719,"page":1,"page_size":10,"execution_time":159,"aggregations":{"data_type_stats":{"dataset":132719,"collection":0},"access_type_stats":{"open":131995,"restricted":68,"embargoed":656},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2246},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":666},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":468},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":421},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":414},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":402},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":396},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":328},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":267},{"id":"https://ror.org/05r0vyz12","name":"Ministerio de Ciencia, Innovación y Universidades","count":222}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":130089},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1900},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":187},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":132},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":75},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":56},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce01