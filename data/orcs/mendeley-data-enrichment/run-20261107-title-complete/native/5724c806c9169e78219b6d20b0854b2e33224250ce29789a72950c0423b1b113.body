{"records":[{"id":"7fpxmtzzxp","title":"The End-Joining factor Ku acts in the end-resection of double strand break-free arrested replication forks","description":"original cell imaging pictures, Immuno-blot  and 2DGE data, for \"The End-Joining factor Ku acts in the end-resection of double strand break-free arrested replication forks\" by Teixeira-Silva et al. .","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2017-10-23T12:05:46.29Z","url":"https://data.mendeley.com/datasets/7fpxmtzzxp","data_type":"dataset","access":"open","doi":["10.17632/7fpxmtzzxp"],"contributors":[{"first_name":"sarah AE","last_name":"Lambert","orcid":null}],"funders":[],"categories":["Health Sciences"],"journal_issn":[]},{"id":"drsrg8xtdm","title":"The Splicing Factor CCAR1 Regulates the Fanconi Anemia/BRCA Pathway. Naoya Harada et al.","description":"Raw data files for the manuscript titled - \"The Splicing Factor CCAR1 Regulates the Fanconi Anemia/BRCA Pathway\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-07-09T10:05:19.876Z","url":"https://data.mendeley.com/datasets/drsrg8xtdm","data_type":"dataset","access":"open","doi":["10.17632/drsrg8xtdm"],"contributors":[{"first_name":"Divya","last_name":"Iyer","orcid":null}],"funders":[],"categories":["Alternative Splicing","RNA Sequencing","Exon Structure","Fanconi Anemia"],"journal_issn":[]},{"id":"pz7nnrvcw9","title":"The APE2 nuclease is essential for DNA double strand break repair by microhomology-mediated end-joining. Fleury et al.","description":"Source data for \"The APE2 nuclease is essential for DNA double strand break repair by microhomology-mediated end-joining.\" Fleury et al. 2023","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-02-27T11:29:28.526Z","url":"https://data.mendeley.com/datasets/pz7nnrvcw9","data_type":"dataset","access":"open","doi":["10.17632/pz7nnrvcw9"],"contributors":[{"first_name":"Nausica","last_name":"Arnoult","orcid":null}],"funders":[],"categories":["Fish","Western Blot","Immunohistochemistry","Gel"],"journal_issn":[]},{"id":"3nw4bztjns","title":"NAR - Marker-free Quantification of Repair Pathway Utilization at Cas9-induced Double-Strand Breaks","description":"Genome integrity and genome engineering require efficient repair of DNA double-strand breaks (DSBs) by non-homologous end joining (NHEJ), homologous recombination (HR), or alternative end-joining pathways. Here we describe two complementary methods for marker-free quantification of DSB repair pathway utilization at Cas9-targeted chromosomal DSBs in mammalian cells. The first assay features the analysis of amplicon next-generation sequencing data using ScarMapper, an iterative break-associated alignment algorithm to classify individual repair products based on deletion size, microhomology usage, and insertions.  The second assay uses repair pathway-specific droplet digital PCR assays (“PathSig-dPCR”) for absolute quantification of signature DSB repair outcomes. We show that ScarMapper and PathSig-dPCR enable comprehensive assessment of repair pathway utilization in different cell models, after a variety of experimental perturbations.  We use these assays to measure the differential impact of DNA end resection on NHEJ, HR, and polymerase theta-mediated end joining (TMEJ) repair.  These approaches are adaptable to any cellular model system and genomic locus where Cas9-mediated targeting is feasible.  Thus, ScarMapper and PathSig-dPCR allow for systematic fate mapping of a targeted DSB with facile and accurate quantification of DSB repair pathway choice at endogenous chromosomal loci.  ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-31T17:09:21.062Z","url":"https://data.mendeley.com/datasets/3nw4bztjns","data_type":"dataset","access":"open","doi":["10.17632/3nw4bztjns"],"contributors":[{"first_name":"Wanjuan","last_name":"Feng","orcid":null},{"first_name":"Dennis","last_name":"Simpson","orcid":null},{"first_name":"Jang Eun ","last_name":"Cho","orcid":null},{"first_name":"Juan ","last_name":"Carvajal-Garcia","orcid":null},{"first_name":"Chelsea ","last_name":"Smith","orcid":null},{"first_name":"Kathryn","last_name":"Headley","orcid":null},{"first_name":"Nate","last_name":"Hathaway","orcid":null},{"first_name":"Dale","last_name":"Ramsden","orcid":null},{"first_name":"Gaorav","last_name":"Gupta","orcid":null}],"funders":[],"categories":["DNA Repair","Next Generation Sequencing"],"journal_issn":[]},{"id":"79tc545wyp","title":"Mechanisms of insertions at a DNA double strand break","description":"Mechanisms of insertions at a DNA double strand break\nhttps://doi.org/10.1016/j.molcel.2023.06.016","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-27T19:25:07.808Z","url":"https://data.mendeley.com/datasets/79tc545wyp","data_type":"dataset","access":"open","doi":["10.17632/79tc545wyp"],"contributors":[{"first_name":"Jaewon","last_name":"Min","orcid":null}],"funders":[],"categories":["DNA Repair"],"journal_issn":[]},{"id":"vfj43k8h29","title":"Phosphorylated Y14 condensates as a scaffold for DNA double strand break repair ","description":"The immunoblotting images in \"Phosphorylated Y14 condensates as a scaffold for DNA double strand break repair\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-06-16T22:21:35.975Z","url":"https://data.mendeley.com/datasets/vfj43k8h29","data_type":"dataset","access":"open","doi":["10.17632/vfj43k8h29"],"contributors":[{"first_name":"蘇","last_name":"俊豪","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"9syc9p829m","title":"SUMO4 promotes SUMO deconjugation required for DNA double-strand break rep