{"records":[{"id":"t6mwtjcy5j","title":"Adaptor protein HIP-55-mediated signalosome controls cardiomyocyte fate in myocardial infarction","description":"The original data of the manuscript of adaptor protein HIP-55-mediated signalosome controls cardiomyocyte fate in myocardial infarction.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-07-16T08:24:27.556Z","url":"https://data.mendeley.com/datasets/t6mwtjcy5j","data_type":"dataset","access":"open","doi":["10.17632/t6mwtjcy5j"],"contributors":[{"first_name":"Yunqi","last_name":"Jiang","orcid":null}],"funders":[],"categories":["Cell Signaling","Myocardial Infarction","Kinase Signaling"],"journal_issn":[]},{"id":"wpmz74sscf","title":"LINF_240005000","description":"clathrin coat assembly protein\nLeishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-12-09T10:13:31.352Z","url":"https://data.mendeley.com/datasets/wpmz74sscf","data_type":"dataset","access":"open","doi":["10.17632/wpmz74sscf"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"6jv8456d6f","title":"LINF_290020600","description":"clathrin coat assembly protein ap19 | sigma adaptin\nLeishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-06-23T11:45:08.5Z","url":"https://data.mendeley.com/datasets/6jv8456d6f","data_type":"dataset","access":"open","doi":["10.17632/6jv8456d6f"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"ccb5mkpkz5","title":"qPCR data for reference gene selection in tomato leaf tissue infected with Tomato curly stunt virus","description":"qPCR data for Actin7 (ACT), Β-6 Tubulin (TUB), Ubiquitin 3 (UBI), Clathrin adaptor complexes medium subunit (CAC), Phytoene desaturase (PDS), Expressed protein (EXP), Glyceraldehyde-3-phosphate dehydrogenase(GAPDH), Adenine phosphoribosyl transferase-like protein (APT1), TAP42-interacting protein (TIP41) and Elongation factor 1-alpha (EF1α) , measure in tomato leaf tissue infected with Tomato curly stunt virus.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-01-23T07:28:22.965Z","url":"https://data.mendeley.com/datasets/ccb5mkpkz5","data_type":"dataset","access":"open","doi":["10.17632/ccb5mkpkz5"],"contributors":[{"first_name":"Farhahna","last_name":"Allie","orcid":null},{"first_name":"Imanu","last_name":"Mwaba","orcid":null},{"first_name":"Mamokete","last_name":"Bokhale","orcid":null}],"funders":[],"categories":["Molecular Biology","Plant-Pathogen Interaction","Plant Diseases"],"journal_issn":[]},{"id":"cnt3fmbz68","title":"Dynamin 2 orchestrates YAP/TAZ mechanotransduction via cortical actin remodeling","description":"Mechanotransduction, the process by which cells sense and respond to mechanical stimuli, relies on cell adhesion, actin cytoskeleton remodeling, and biochemical signal integration. Here, we demonstrate that dynamin 2 (DNM2), clathrin plaques and surrounding branched actin filaments are mechanotransduction platforms that regulate YAP/TAZ signaling. We show that branched actin filaments surrounding clathrin plaques recruit TAZ, whereas contractile stress fibers associated with focal adhesions promote YAP localization. DNM2, the actin capping protein gelsolin, YAP and TAZ organize the cortical actin network around clathrin plaques while actin disorganization due to DNM2 or clathrin depletion delocalize both YAP and TAZ. In centronuclear myopathy models, DNM2 mutations impair actin remodeling, leading to aberrant YAP/TAZ nuclear translocation and altered gene expression of their transcriptional targets. Importantly, allele-specific mutant DNM2 silencing restores YAP/TAZ balance, actin organization and normalizes gene expression. Our findings establish clathrin plaques and DNM2 as central regulators of YAP/TAZ-mediated mechanotransduction.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-05-06T05:30:34.759Z","url":"https://data.mendeley.com/datasets/cnt3fmbz68","data_type":"dataset","access":"open","doi":["10.17632/cnt3fmbz68"],"contributors":[{"first_name":"Marion","last_name":"Benoist","orcid":"0009-0004-8951-1970"},{"first_name":"Kévin","last_name":"Milliet","orcid":null},{"first_name":"Agathe","last_name":"Franck","orcid":null},{"first_name":"Satish","last_name":"Moparthi","orcid":null},{"first_name":"Anaïs","last_name":"Fongy","orcid":null},{"first_name":"Gilles","last_name":"Moulay","orcid":null},{"first_name":"Emmanuelle","last_name":"Lacene","orcid":null},{"first_name":"Kamel","last_name":"Mamchaoui","orcid":null},{"first_name":"Solenne","last_name":"Chardonnet","orcid":null},{"first_name":"Florent","last_name":"Dingli","orcid":null},{"first_name":"Damarys","last_name":"Loew","orcid":null},{"first_name":"Teresinha","last_name":"Evangelista","orcid":null},{"first_name":"Catherine","last_name":"Coirault","orcid":null},{"first_name":"Delphine","last_name":"Trochet","orcid":null},{"first_name":"Marc","last_name":"Bitoun","orcid":null},{"first_name":"stéphane","last_name":"vassilopoulos","orcid":null}],"funders":[],"categories":["Physiopathology","Cellular Mechanism","Mechanotransduction"],"journal_issn":[]},{"id":"wj26np94mc","title":"Microbial community assembly mediated by soil organic carbon stability in aggregates under long-term enclosure alpine meadows","description":"Microbial community assembly mediated by soil organic carbon stability in aggregates under long-term enclosure alpine meadows","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external