{"records":[{"id":"3ctpx4k6jp","title":"Porcine reproductive and respiratory syndrome virus upregulates SMPDL3B to promote viral replication by modulating lipid metabolism","description":"We generated a collection of porcine genome-scale CRISPR/Cas9 knockout (PigGeCKO) cells on a PAM background.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-26T18:53:54.241Z","url":"https://data.mendeley.com/datasets/3ctpx4k6jp","data_type":"dataset","access":"open","doi":["10.17632/3ctpx4k6jp"],"contributors":[{"first_name":"huanh","last_name":"Shen","orcid":null}],"funders":[],"categories":["Agricultural Biotechnology"],"journal_issn":[]},{"id":"zy36wcykns","title":"Supplementary material: A prospective cross-sectional study of squalene epoxidase mutations in U.S. onychomycosis patients: implications for management – our troubles are just beginning","description":"supplementary materials for article 'A prospective cross-sectional study of squalene epoxidase mutations in U.S. onychomycosis patients: implications for management – our troubles are just beginning'.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-12-23T23:00:42.905Z","url":"https://data.mendeley.com/datasets/zy36wcykns","data_type":"dataset","access":"open","doi":["10.17632/zy36wcykns"],"contributors":[{"first_name":"Aditya","last_name":"Gupta","orcid":null}],"funders":[],"categories":["Supplementation"],"journal_issn":[]},{"id":"xvk2gk4hw3","title":"Data of Murine Trophoblast Organoids as a Model for Trophoblast Development and CRISPR/Cas9 Screening","description":"Raw data for figures in Murine Trophoblast Organoids as a Model for Trophoblast Development and CRISPR/Cas9 Screening","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-25T15:27:04.321Z","url":"https://data.mendeley.com/datasets/xvk2gk4hw3","data_type":"dataset","access":"open","doi":["10.17632/xvk2gk4hw3"],"contributors":[{"first_name":"Qian","last_name":"Mao","orcid":null}],"funders":[],"categories":["Developmental Biology"],"journal_issn":[]},{"id":"z4ht3txn2k","title":"Accompanying Files for paper entitled: \"Genome-scale mapping of DNA damage suppressors through phenotypic CRISPR/Cas9 screens\" - Zhao et al. Molecular Cell 2023","description":"Accompanying Files for paper entitled: \"Genome-scale mapping of DNA damage suppressors through phenotypic CRISPR/Cas9 screens\" - Zhao et al. Molecular Cell 2023. This dataset contains Source and additional Data for all figures.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-06T07:16:19.286Z","url":"https://data.mendeley.com/datasets/z4ht3txn2k","data_type":"dataset","access":"open","doi":["10.17632/z4ht3txn2k"],"contributors":[{"first_name":"Daniel","last_name":"Durocher","orcid":null},{"first_name":"Yichao","last_name":"Zhao","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":null}],"categories":["DNA Replication","DNA Repair","Flow Cytometry","Cancer Chemotherapy","DNA Damage","Functional Genomics","CRISPR/Cas9"],"journal_issn":[]},{"id":"835fcfbvhs","title":"Preparation of CRISPR/Cas9 and gRNA plasmids","description":"Human genome engineering has been transformed by the introduction of the CRISPR (clustered regularly interspaced short palindromic repeats)/Cas (CRISPR-associated) system found in most bacteria and archaea. Type II CRISPR/Cas systems have been engineered to induce RNA-guided genome editing in human cells, where small RNAs function together with Cas9 nucleases for sequence-specific cleavage of target sequences. Here we describe the protocol for Cas9-mediated human genome engineering, including construct building and transfection methods necessary for delivering Cas9 and guide RNA (gRNA) into human-induced pluripotent stem cells (hiPSCs) and HEK293 cells. Following genome editing, we also describe methods to assess genome editing effi- ciency using next-generation sequencing and isolate monoclonal hiPSCs with the desired modifications for downstream applications. Keywords: genome engineering • CRISPR • human stem cells","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2016-12-12T12:58:15.307Z","url":"https://data.mendeley.com/datasets/835fcfbvhs","data_type":"dataset","access":"open","doi":["10.17632/835fcfbvhs"],"contributors":[{"first_name":"George","last_name":"Church","orcid":null}],"funders":[],"categories":["Experimental Method"],"journal_issn":[]},{"id":"cc3v4szzs6","title":"Detection of Squalene Epoxidase Mutations in U.S. Onychomycosis Patients: Implications for Management - Supporting Information and Datasets","description":"Datasets and Supporting Information for Article Accepted in Journal of Investigative Dermatology (JID-2023-0092.R1) - Detection of Squalene Epoxidase Mutations in U.S. Onychomycosis Patients: Implications for Management","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-05-16T14:55:53.548Z","url":"https://data.mendeley.com/datasets/cc3v4szzs6","data_type":"dataset","access":"open","doi":["10.17632/cc3v4szzs6"],"contributors":[{"first_name":"Aditya","last_name":"Gupta","orcid":null},{"first_name":"Liz","last_name":"Cooper","orcid":null},{"first_name":"Tong","last_name":"Wang","orcid":null},{"first_name":"Shruthi ","last_name":"Polla Ravi","orcid":null},{"first_name":"Sara","last_name":"Lincoln","orcid":null},{"first_name":"Vincent","last_name":"Piguet","orcid":null},{"first_name":"Laurence","last_name":"McCarthy","orcid":null},{"first_name":"Wayne","last_name":"Bakotic","orcid":null}],"funders":[],"categories":["Supplementation"],"journal_issn":[]},{"id":"5z7ppzwpcw","title":"Genome-scale CRISPR/Cas9 screening of the deubiquitinase subfamily identifies USP49 as a protein stabilizer of PAX9 and MSX1 regulating odontogenesis","description":"Deubiquitination of proteins by DUBs has emerged as a key regulator of protein stability and has been shown to be critically involved in signal transduction cascades. However, the function and regulation of individual DUBs are not well understood at the molecular level. Several screening approaches to identify DUBs and their target protein substrates in diverse cellular functions have been reported previously. For example, shRNA/siRNA libraries targeting different DUBs or overexpression of ectopically introduced DUBs have been used to investigate the impact of DUB function on target substrate protein stability. These conventional methods have several limitations, such as the limitation of RNAi or shRNA-based methods to transcripts, and these techniques often result in partial repression or restoration of gene functions in a few generations, with temporary effects.  The results obtained from these methods may not be accurate and might lead to misinterpretations of the data. To overcome this, we developed a loss-of-function study based on individually generated single cell-derived biallelic DUB knockout clones in mammalian cells and provide an alternate and improved model to explore the molecular mechanism of DUBs.\n\nIn this study, we used CRISPR/Cas9 (clustered regularly interspaced short palindromic repeats/CRISPR-associated) mediated DUB knockout screening kit based on genome-scale knockout of the entire set of genes that encode human ubiquitin-specific proteases (USPs), which are the largest subfamily of DUBs (>50 genes), and then we systematically applied the panel to screen DUB candidates that might regulate PAX9 and MSX1 proteins. PAX9 and MSX1 are critical for the transition in odontogenic potential from epithelium to mesenchyme. Although genetic mutations in PAX9 and MSX1 cause tooth agenesis, the regulation of PAX9 and MSX1 protein levels by deubiquitinating enzymes (DUBs) might be a crucial factor during tooth development. Our screening system identified USP49 as a key regulator of PAX9 and MSX1 protein stability. USP49 interacts and deubiquitinates PAX9 and MSX1 protein and upregulates several odontogenic transcription factors in human dental pulp stem cells (hDPSCs). In animal models, USP49 depletion was correlated with downregulation of Pax9 and Msx1 protein expression resulting in several morphological defects in calcified tissues such as reduced dentin growth, reduced enamel space, abnormal enamel formation, and irregular mineralization. Thus, the depletion of USP49 leads to an inadequate transition from bud to cap stage in the early stages of tooth development. This novel finding suggests that the USP49-PAX9-MSX1 axis could serve as a prognostic marker and novel regulatory target in odontogenesis and can serve as a catalyst for bioengineering tooth implant research to improve clinical care.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-05-08T12:30:21.375Z","url":"https://data.mendeley.com/datasets/5z7ppzwpcw","data_type":"dataset","access":"open","doi":["10.17632/5z7ppzwpcw"],"contributors":[{"first_name":"Suresh","last_name":"Ramakrishna","orcid":null}],"funders":[],"categories":["Molecular Biology","Cell Biology","Stem Cell","Animal Development","Tooth Enamel","Tooth Development"],"journal_issn":[]},{"id":"33tm3dd9dw","title":"FAME-CRISPR: Improved CRISPR-Cas9 Genome Editing via HDAC Inhibition and Engineered Virus-Like Particle Delivery ","description":"Raw data deposited for \"FAME-CRISPR: Improved CRISPR-Cas9 Genome Editing via HDAC Inhibition and Engineered Virus-Like Particle Delivery\" by Djamshidi et al-Cell Reports Methods","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-09-25T15:53:30.358Z","url":"https://data.mendeley.com/datasets/33tm3dd9dw","data_type":"dataset","access":"open","doi":["10.17632/33tm3dd9dw"],"contributors":[{"first_name":"Mahbod","last_name":"Djamshidi","orcid":null}],"funders":[],"categories":["Sanger Sequencing","Immunofluorescence"],"journal_issn":[]},{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"6v2dwwcgs3","title":"MC-16-01889 Yamada, Watanabe et al.","description":"Image data related to Yamada, Watanabe et al., Crystal Structure of the Minimal Cas9 from Campylobacter jejuni Reveals the Molecular Diversity in the CRISPR-Cas9 Systems. Mol Cell (2017) 65, 1109-1121.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2017-03-17T03:00:10.911Z","url":"https://data.mendeley.com/datasets/6v2dwwcgs3","data_type":"dataset","access":"open","doi":["10.17632/6v2dwwcgs3"],"contributors":[{"first_name":"Hiroshi","last_name":"Nishimasu","orcid":null}],"funders":[],"categories":["Biochemistry"],"journal_issn":["10972765"]}],"total_records":141026,"page":1,"page_size":10,"execution_time":116,"aggregations":{"data_type_stats":{"dataset":141026,"collection":0},"access_type_stats":{"open":140325,"restricted":69,"embargoed":632},"top_fund