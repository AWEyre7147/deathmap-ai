[{"id":"cbceb427-ed6f-431c-9b8f-6808c3fdb44a","name":"Figure 3I","description":"ZMAT3 and p53 protein levels analyzed by Western blotting with GAPDH loading control (n ≥3)","created_date":"2020-08-24T19:18:23.317"},{"id":"383b86c5-63da-41f1-9847-316a0207b333","name":"Figure 4C","description":"tdTomato expression in Lenti-sgNC/Cre or Lenti-sgp53/Cre mouse lungs. ","created_date":"2020-08-27T20:17:25.501"},{"id":"557a8849-ba81-416d-9c2a-303a9be455fe","name":"Figure 4D","description":"Lenti-sgp53/Cre and Lenti-sgNC/Cre representative H&E-stained lung sections. ","created_date":"2020-09-25T20:33:24.509"},{"id":"cb48edf3-e199-4273-995c-c7020da427cb","name":"Figure 4E","description":"tdTomato expression in Lenti-sgNC/Cre or Lenti-sgZmat3/Cre mouse lungs.","created_date":"2020-09-25T20:25:05.577"},{"id":"0f23f1c0-2ca7-4b23-91ea-58f82426a167","name":"Figure 4F","description":" Lenti-sgZmat3/Cre and Lenti-sgNC/Cre representative H&E-stained lung sections. ","created_date":"2020-09-25T20:34:03.061"},{"id":"daeac51c-e859-4127-92db-97f05d0f86f9","name":"Figure 4I","description":"Representative IHC for Ki67 in tumors.","created_date":"2020-10-01T18:06:16.59"},{"id":"cae1943d-f8de-4234-b1d8-5dfa505dd5d2","name":"Figure 4J","description":"Representative IHC for Ki67 in tumors.","created_date":"2020-10-01T18:06:45.89"},{"id":"f8edd363-e99e-4c14-8da4-f13445b5341a","name":"Figure 4N","description":"H&E of representative liver tumors or normal liver for sgChrom8.","created_date":"2020-09-28T18:53:10.703"},{"id":"78d3c30e-360d-40f2-b179-66d213357b7a","name":"Figure 7B","description":"Semi-quantitative PCR analysis of the alternative splicing depicted in Mdm4 and Mdm2, with Gapdh control. Primers were designed to flank the alternatively spliced exon. ","created_date":"2020-10-01T17:25:27.468"},{"id":"b95afc24-f416-4f55-973f-c379001199f7","name":"Figure 7D","description":"Western blot analysis of MDM4 in E1A;HrasG12V;Cas9 MEFs expressing sgZmat3 or sgNC with alpha-TUBULIN loading control. ","created_date":"2020-10-01T17:18:17.466"},{"id":"31a40ab5-2717-44c8-a3e7-3eb0fce51b5d","name":"Figure 7E","description":"Semi-quantitative PCR analysis of alternative splicing in Dhx9, Hnrnpdl, and Dlg1 with Gapdh control. Primers were designed to flank the alternatively spliced exons.","created_date":"2020-10-01T17:29:08.114"},{"id":"de74a0d9-c301-490e-b35b-f2d3c8b6f07b","name":"Figure S1H","description":"Representative colony images for the quantification in Figure 1E.","created_date":"2020-10-06T16:57:34.207"},{"id":"b298fc4f-7f90-48fc-9a95-5118a777f1a3","name":"Figure S4C","description":"Tumors from mice infected with Lenti-sgZmat3/Cre or Lenti-sgNC/Cre do not display apoptotic cells, based on the apoptosis marker Cleaved Caspase 3 (CC3). Representative immunohistochemistry for CC3 on tumors induced by lentiviruses expressing the indicated sgRNAs. A section of an embryo with hyperactivated p53 serves as a positive control for the apoptosis assay, and arrowheads indicate CC3 positive cells. ","created_date":"2020-10-01T18:21:36.442"},{"id":"b323eaba-0552-493a-86ec-5e2c52bb42ee","name":"Figure S5D","description":"H23 cells were transfected with HA-tagged GFP, p53, wild-type ZMAT3 or ZMAT3 R99Q. Twenty-four hours after transfection the cells were pulsed with BrdU for 4 hours, then BrdU incorporation was analyzed in HA-positive cells by immunofluorescence.","created_date":"2020-10-09T17:10:09.401"},{"id":"a1bbae80-cc6e-40b4-ae83-b67e43b2dbb8","name":"Figure S6B","description":"Generating Zmat3-deficient cells for RNA-seq. E1A;HrasG12V;Cas9 MEFs were transduced with sgRNAs targeting Zmat3 or with negative control sgRNAs. Cell extracts were analyzed by immunoblot with ZMAT3 and p53 antibodies. GAPDH serves as a loading control.","created_date":"2020-10-06T16:16:10.92"},{"id":"65999f1b-1174-4ef2-b67f-679c7c3c7b41","name":"Figure S7E","description":"Semi-quantitative PCR to identify splice isoforms of Dhx9, Hnrnpdl, and Dlg1. Primers were designed to flank the alternatively spliced exon, and the PCR was run\nfor 32 cycles.","created_date":"2020-10-01T17:44:37.498"}]