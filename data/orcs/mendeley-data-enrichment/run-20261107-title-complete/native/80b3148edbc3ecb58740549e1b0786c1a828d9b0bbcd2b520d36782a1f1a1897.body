{"records":[{"id":"v87yvmynmn","title":"Uncropped Western Blots for Obesity-induced Pyroptotic Adipocyte Death Leads to TREM2-Dependent Macrophage Dysfunction and Adipose Tissue Inflammation","description":"Original Western Blot data for manuscript entitle \"Obesity-induced Pyroptotic Adipocyte Death Leads to TREM2-Dependent Macrophage Dysfunction and Adipose Tissue Inflammation\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-11-20T13:11:54.654Z","url":"https://data.mendeley.com/datasets/v87yvmynmn","data_type":"dataset","access":"open","doi":["10.17632/v87yvmynmn"],"contributors":[{"first_name":"Cheoljun","last_name":"Choi","orcid":null},{"first_name":"Yun-Hee","last_name":"Lee","orcid":null}],"funders":[],"categories":["Inflammation","Obesity","Adipose Tissue"],"journal_issn":[]},{"id":"ds6smymmx2","title":"Uncropped Western Blots for Obesity-induced Pyroptotic Adipocyte Death Leads to TREM2-Dependent Macrophage Dysfunction and Adipose Tissue Inflammation","description":"Original Western Blot data for manuscript entitle \"Obesity-induced Pyroptotic Adipocyte Death Leads to TREM2-Dependent Macrophage Dysfunction and Adipose Tissue Inflammation\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-11-05T10:45:35.355Z","url":"https://data.mendeley.com/datasets/ds6smymmx2","data_type":"dataset","access":"open","doi":["10.17632/ds6smymmx2"],"contributors":[{"first_name":"Cheoljun","last_name":"Choi","orcid":null},{"first_name":"Yun-Hee","last_name":"Lee","orcid":null}],"funders":[],"categories":["Inflammation","Adipose Tissue"],"journal_issn":[]},{"id":"vpynbgwkh3","title":"Leukotriene B4 receptor 2 governs macrophage migration during tissue inflammation","description":"Prism file containing data within manuscript","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-11-07T07:21:53.521Z","url":"https://data.mendeley.com/datasets/vpynbgwkh3","data_type":"dataset","access":"open","doi":["10.17632/vpynbgwkh3"],"contributors":[{"first_name":"Raghavendra","last_name":"Mirmira","orcid":null}],"funders":[{"id":"https://ror.org/05aq6yn88","name":"Office of Extramural Research","grant_id":null}],"categories":["Life Sciences"],"journal_issn":[]},{"id":"6c2sbrfycw","title":"SAMHD1 Attenuates Acute Inflammation by Maintaining Mitochondrial Function in Macrophages via Interaction with VDAC1","description":"Abstract:   Background: Over-activation of Toll-like receptor 4 (TLR4) is the key mechanism in Gram-negative bacterial infection-induced sepsis. SAM and HD domain-containing deoxynucleoside triphosphate triphosphohydrolase 1 (SAMHD1) inhibits multiple virus-es  , but whether it plays a role during bacterial invasion remains unelucidated. Methods: Monocyte-macrophage specific Samhd1   knockout (Samhd1−/−) mice and Samhd1−/− macrophage cell line RAW264.7 were constructed and used as research models to evaluate the role of SAMHD1 in TLR4-activated inflammation. Results: In vivo  , LPS-challenged Samhd1−/− mice showed higher serum inflammatory factors, accompanied with more severe inflammation infiltration and lower survival rate. In vitro, Samhd1−/− peritoneal macrophages had more activated TLR4 pathway upon LPS-stimulation, accompanied with mitochondrial depolarization and dysfunction and a higher tendency to be M1-polarized. These results could be rescued by overexpressing full-length wild-type SAMHD1 or its phospho-mimetic T634D mutant into Samhd1−/− RAW264.7 cells, whereas the mutants, dNTP hydrolase-function-deprived H238A and phos-pho-ablative T634A, did not exert the same effect. Lastly, co-IP and immunofluorescence assays confirmed that SAMHD1 interacted with an outer mitochondrial membrane-localized protein, voltage-dependent anion channel-1 (VDAC1). Conclusion: SAMHD1 inhibits TLR4-induced acute inflammation and M1 polarization of macrophages by interacting with VDAC1 and maintaining mitochondria function, which outlines a novel regulatory mechanism of TLR signaling upon LPS stimulation.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-04-28T13:04:28.973Z","url":"https://data.mendeley.com/datasets/6c2sbrfycw","data_type":"dataset","access":"open","doi":["10.17632/6c2sbrfycw"],"contributors":[{"first_name":"Bowen","last_name":"Xu","orcid":null}],"funders":[{"id":"https://ror.org/027s68j25","name":"Ministry of Science and Technology of the People's Republic of China","grant_id":"2018YFA0507401"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"82071762"}],"categories":["Inflammation","Sepsis","Mitochondrion","Macrophage"],"journal_issn":[]},{"id":"wrx5pbhr6z","title":"Data on age related plasma biomarkers","description":"Cross-sectional plasma biomarkers of neuronal death (UCH-L1),  neuronal axonal damage (NfL),  and astrogliosis/brain inflammation (GFAP)  across the lifespan of normal control individuals, individuals with Alzheimer's Disease and individuals with Mild Cognitive Impairment was determined by SIMOA. Results show that plasma concentrations of UCH-L1 and NfL rise exponentially from age 2 through age 85, plasma GFAP rises exponentially from age 40. MCI and/or AD diagnosis increase plasma biomarkers of neuronal death/damage nd inflammation.  SC treatment of AD trial participants with granulocyte macrophage colony stimulating factor  (GM-CSF) reduces plawma UCH-L1 levels to that found in average five year old controls.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-12-11T00:55:44.124Z","url":"https://data.mendeley.com/datasets/wrx5pbhr6z","data_type":"dataset","access":"open","doi":["10.17632/wrx5pbhr6z"],"contributors":[{"first_name":"Huntington","last_name":"Potter","orcid":null}],"funders":[{"id":"https://ror.org/0375f4d26","name":"Alzheimer's Association","grant_id":"PTC C-16-422172 "},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01AG071151, 01AI50305"},{"id":"https://ror.org/00kpb0908","name":"Global Down Syndrome Foundation","grant_id":null}],"categories":["Proteomics"],"journal_issn":[]},{"id":"fddtsyvv6m","title":"Data for: The nuclear transcription factor FoxG1 affects the sensitivity of mimetic aging hair cells to inflammation by regulating autophagy pathways","description":"Inflammation is a self-defense response to protect individuals from infection and tissue damage, but excessive or persistent inflammation can have adverse effects on cell survival. Many individuals become especially susceptible to chronic- inflammation-induced sensorineural hearing loss as they age, but the intrinsic molecular mechanism behind aging individuals' increased risk of hearing loss remains unclear. FoxG1 (forkhead box transcription factor G1) is a key transcription factor that plays important roles in hair cell survival through the regulation of mitochondrial function, but how the function of FoxG1 changes during aging and under inflammatory conditions is unknown. In this study, we first found that FoxG1 expression and autophagy both increased gradually in the low concentration lipopolysaccharide (LPS)-induced inflammation model, while after high concentration of LPS treatment both FoxG1 expression and autophagy levels decreased as the concentration of LPS increased. We then used siRNA to downregulate Foxg1 expression in hair cell-like OC-1 cells and found that cell death and apoptosis were significantly increased after LPS injury. Furthermore, we used D-galactose (D-gal) to create an aging model with hair cell-like OC-1 cells and cochlear explant cultures in vitro and found that the expression of Foxg1 and the level of autophagy were both decreased after D-gal and LPS co-treatment. Lastly, we knocked down the expression of Foxg1 under aged inflammation conditions and found increased numbers of dead and apoptotic cells. Together these results suggest that FoxG1 affects the sensitivity of mimetic aging hair cells to inflammation by regulating autophagy pathways.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-11-12T15:03:14.041Z","url":"https://data.mendeley.com/datasets/fddtsyvv6m","data_type":"dataset","access":"open","doi":["10.17632/fddtsyvv6m"],"contributors":[{"first_name":"Weijia","last_name":"Kong","orcid":null},{"first_name":"Hai-ying","last_name":"Sun","orcid":null},{"first_name":"Yu","last_name":"Sun","orcid":null},{"first_name":"Zuhong","last_name":"He","orcid":null},{"first_name":"Xiao-xiang","last_name":"Xu","orcid":null},{"first_name":"Sen","last_name":"Chen","orcid":null},{"first_name":"Dan","last_name":"Li","orcid":null},{"first_name":"Xia","last_name":"Wu","orcid":null},{"first_name":"Ming","last_name":"Li","orcid":null},{"first_name":"renjie","last_name":"chai","orcid":null},{"first_name":"Xue-yan","last_name":"Zhao","orcid":null},{"first_name":"Sheng-yu","last_name":"Zou","orcid":null},{"first_name":"Yu-juan","last_name":"Hu","orcid":null},{"first_name":"Fu-ling","last_name":"Liao","orcid":null}],"funders":[],"categories":["Biological Sciences","Inflammation","Cell","Apoptosis","Aging","Autophagy","Molecules","Reactive Oxygen Species"],"journal_issn":["22132317"]},{"id":"57pzvbk48c","title":"Vegetation restoration hierarchically governs labile organic carbon fractions and bacterial communities in eroded soils: Evidence from a subtropical red soil profile","description":"Vegetation restoration hierarchically governs labile organic carbon fractions and bacterial communities in eroded soils: Evidence from a subtropical red soil profile","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-05-26T11:44:28.865Z","url":"https://data.mendeley.com/datasets/57pzvbk48c","data_type":"dataset","access":"open","doi":["10.17632/57pzvbk48c"],"contributors":[{"first_name":"Jinshi","last_name":"Lin","orcid":null}],"funders":[],"categories":["Forest Soil"],"journal_issn":[]},{"id":"wz6s96x2c4","title":"Rhinovirus triggers distinct host responses through differential engagement of epithelial innate immune signaling - Donor information","description":"Donor metadata of primary human nasal epithelial cells used in the study.\n\nIn this study:  We used single cell sequencing of the organotypic air-liquid interface culture model to reveal innate defense responses of the human nasal epithelium to rhinovirus, the most frequent cause of common colds and a major cause of serious respiratory illness in high-risk groups (e.g. smokers and asthmatics). We found that the epithelial interferon response restricts RV infection to <2% of cells. However, inhibiting the interferon response by blocking IRF3 activation increases the proportion of infected cells to >30%, and leads to a distinct NFKB- and NLRP1-dependent pro-inflammatory response, with production of neutrophil-attracting chemokines, increased mucus, and IL-1b. Inhibiting both IRF3 and NFKB increases cell death, ER stress and squamous metaplasia. Overall, this study demonstrates how epithelial innate immune signaling impacts RV-induced inflammation and reveals potential therapeutic targets. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-01-15T19:25:39.501Z","url":"https://data.mendeley.com/datasets/wz6s96x2c4","data_type":"dataset","access":"open","doi":["10.17632/wz6s96x2c4"],"contributors":[{"first_name":"Bao","last_name":"Wang","orcid":null},{"first_name":"Ellen","last_name":"Foxman","orcid":"0000-0001-9767-9942"}],"funders":[{"id":"https://ror.org/03v76x132","name":"Yale University","grant_id":null},{"id":"https://ror.org/0515k5w36","name":"Rita Allen Foundation","grant_id":null},{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":null}],"categories":["Metadata","Donor"],"journal_issn":[]},{"id":"jwkc5t6r55","title":"CAF‒macrophage crosstalk in tumor microenvironments governs the response to immune checkpoint blockade in gastric cancer peritoneal metastases","description":"scRNA-seq was performed on 5 surgical resection and biopsy GCPM samples, 2 primary GC samples, 1 peritumoral gastric normal (GN) samples and 1 peritoneal normal (PE) sample. The samples were derived from 3 GC patients without ICB therapy. The samples were sequenced using the GEXSCOPE platforms to fetch scRNA-seq data. The data were combined with a previously published scRNA-seq GC atlas to enrich the data on primary GC and GN and provide additional three cases of GCPM (GSE183904). The processed data of these two cohorts were currently provided in Mendeley repository. Besides, the 10X genomics raw data of patients receiving immunotherapy are deposited in the Genome Sequence Archive for Human database (ID: HRA009064; details in https://ngdc.cncb.ac.cn/gsa-human/browse/HRA009064).","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-11-07T14:07:57.441Z","url":"https://data.mendeley.com/datasets/jwkc5t6r55","data_type":"dataset","access":"open","doi":["10.17632/jwkc5t6r55"],"contributors":[{"first_name":"Yongqiang","last_name":"Zheng","orcid":null},{"first_name":"Hui-Yan","last_name":"Luo","orcid":null},{"first_name":"Ze-Xian","last_name":"Liu","orcid":null}],"funders":[],"categories":["Stomach Cancer","Metastasis","Single-Cell RNA Sequencing"],"journal_issn":[]},{"id":"sn3cdcw9mp","title":"Role of trimethylamine metabolite in colon inflammation reveals toxicity at cellular levels","description":"The data shows the effects of gut bacterial metabolite, TMA, on intestinal epithelial cell lines (HCT116 and HT29) and animal model. TMA causes compromised membrane integrity, cell cycle arrest and apoptosis in chronic exposure in cell lines and severe inflammation, and damage to the epithelial lining of mice, shortening the large intestine and strengthening the view that TMA is deleterious and might be the contributing factor in microbiota-induced intestinal diseases. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-11-02T19:22:04.954Z","url":"https://data.mendeley.com/datasets/sn3cdcw9mp","data_type":"dataset","access":"open","doi":["10.17632/sn3cdcw9mp"],"contributors":[{"first_name":"Anil","last_name":"Kumar","orcid":null},{"first_name":"Minakshi ","last_name":"Sharma","orcid":null},{"first_name":"Rekha","last_name":"Rekha","orcid":null},{"first_name":"Govind","last_name":"Makharia","orcid":null}],"funders":[],"categories":["Microbiology","Cancer Pathobiology"],"journal_issn":[]}],"total_records":135714,"page":1,"page_size":10,"execution_time":156,"aggregations":{"data_type_stats":{"dataset":135714,"collection":0},"access_type_stats":{"open":134959,"restricted":69,"embargoed":686},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2273},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":690},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":472},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":426},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":416},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":407},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":399},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":337},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":273},{"id":"https://ror.org/05r0vyz12","name":"Ministerio de Ciencia, Innovación y Universidades","count":227}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":133073},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1904},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":186},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":137},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":76},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":57},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":37},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":27}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":520},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":408},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":359},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":359},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":308}]}}