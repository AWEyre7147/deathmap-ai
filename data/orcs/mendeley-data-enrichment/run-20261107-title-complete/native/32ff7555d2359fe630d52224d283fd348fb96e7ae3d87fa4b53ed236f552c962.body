{"records":[{"id":"6r6zyjd986","title":"Non-response of basal cell carcinomas to immune checkpoint inhibition therapy for melanoma: A Case Series","description":"Supplemental figures for \"Non-response of basal cell carcinomas to immune checkpoint inhibition therapy for melanoma: A Case Series\" in JAAD Case Reports.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-01-19T20:13:15.616Z","url":"https://data.mendeley.com/datasets/6r6zyjd986","data_type":"dataset","access":"open","doi":["10.17632/6r6zyjd986"],"contributors":[{"first_name":"Elizabeth","last_name":"Sher","orcid":null},{"first_name":"Ata","last_name":"Moshiri","orcid":null},{"first_name":"Ian","last_name":"Tattersall","orcid":null}],"funders":[],"categories":["Dermatology","Basal Cell Carcinoma","Immunotherapy"],"journal_issn":[]},{"id":"mk7z7st438","title":"ATR restrains DNA synthesis and mitotic catastrophe in response to CDC7 inhibition. Rainey et al","description":"Background:\nCDC7 kinase is required for activation of licensed origins of replication during the process of DNA duplication. CDC7 kinase inhibitors interfere with this process, limiting both DNA synthesis and cell proliferation.\n\nAim:\nIdentify genes responsible for limiting cell proliferation in response to inhibition of CDC7 using small molecule ATP-competitive inhibitors.\n\nStrategy:\nA CRISPR/Cas9 loss of function screen was performed to identify genes that upon loss allow bypass of a proliferation blockade imposed by the CDC7 inhibitor, XL413.\n\nData:\nRepresents source data for main figures and supplemental items in support of the Manuscript 'ATR restrains DNA synthesis and mitotic catastrophe in response to CDC7 inhibition', Rainey et al.\n\nData collection, interpretation and findings are addressed in the manuscript.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-19T20:26:38.851Z","url":"https://data.mendeley.com/datasets/mk7z7st438","data_type":"dataset","access":"open","doi":["10.17632/mk7z7st438"],"contributors":[{"first_name":"Michael","last_name":"Rainey","orcid":null}],"funders":[],"categories":["Cancer","DNA Replication","Cell Signaling","Genetic Screening"],"journal_issn":[]},{"id":"y5v4m38nbb","title":"Inhibition IRE1α protects against renal injury via blocking p38 MAPK pathway and M1 macrophage activation in renal fibrosis","description":"The original data of western blot in “Inhibition IRE1α protects against renal injury via blocking p38 MAPK pathway and M1 macrophage activation in renal fibrosis” .","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-04-16T12:54:50.517Z","url":"https://data.mendeley.com/datasets/y5v4m38nbb","data_type":"dataset","access":"open","doi":["10.17632/y5v4m38nbb"],"contributors":[{"first_name":"Zichan","last_name":"Guo","orcid":null}],"funders":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"82371748"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"82071848"}],"categories":["Western Blot"],"journal_issn":[]},{"id":"byp827tmcy","title":"Synthesis and Biological Evaluation of a Caffeic acid phenethyl ester Derivatives as Anti-Hepatocellular Carcinoma Agents via Inhibition of Mitochondrial Respiration and Disruption of Cellular Metabolism","description":"The data in this dataset is related to the paper \"Synthesis and Biological Evaluation of a Caffeic acid phenyl ester Derivatives as Anti hypertensive Carcinomas Agents via Inhibition of Mitochondria Respiration and Disruption of Cellular Metabolism\" for possible reference","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-12-05T00:06:44.516Z","url":"https://data.mendeley.com/datasets/byp827tmcy","data_type":"dataset","access":"open","doi":["10.17632/byp827tmcy"],"contributors":[{"first_name":"Hao","last_name":"Dong","orcid":null}],"funders":[],"categories":["Hepatocellular Carcinoma","Antitumor Effector Cell"],"journal_issn":[]},{"id":"9yzyy8z5sz","title":"Dataset for Systematic Review on Contrast-Induced Nephropathy: Risk Factors, Prevention, and Management","description":"This dataset contains the comprehensive data extraction matrix generated during the systematic review on Contrast-Induced Nephropathy (CIN) / Contrast-Induced Acute Kidney Injury (CI-AKI). The collected data are made available in their entirety for open access and public consultation on Mendeley Data. The dataset synthesizes information from 168 scientific articles and systematic studies, categorized across key clinical and pathophysiological dimensions:Article Citation: Reference and authors.\n\nMain Subject: Core topic addressed in the study.\n\nMain Findings: Summary of principal conclusions.\n\nPathophysiology: Mechanisms including renal vasoconstriction, medullary hypoxia, oxidative stress, and direct tubular toxicity.\n\nRisk Factors: Pre-existing conditions such as Chronic Kidney Disease (CKD), Diabetes Mellitus, advanced age, volume/type of contrast, and hypotension.\n\nHydration Strategies: Protocols and solutions used for renal protection.\n\nPharmacological Interventions: Evaluation of antioxidants, NAC, statins, and other pharmacological therapies.\n\nContrast Media Details: Contrast type, osmolarity, and volume administered.\n\nRenal Outcomes: Incidence of CI-AKI, dialytic requirements, biomarkers (e.g., NGAL, Cystatin C), and mortality","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-07-30T10:18:04.583Z","url":"https://data.mendeley.com/datasets/9yzyy8z5sz","data_type":"dataset","access":"open","doi":["10.17632/9yzyy8z5sz"],"contributors":[{"first_name":"Alexander","last_name":"Reyes Lobo","orcid":"0000-0002-1756-1053"},{"first_name":"Nathalia","last_name":"Jácome","orcid":"0000-0003-0883-6008"},{"first_name":"Julieth Andrea","last_name":"Galvis Rodríguez","orcid":"0009-0001-3440-3217"},{"first_name":"Elias","last_name":"Ordoñez","orcid":"0009-0000-4445-5662"},{"first_name":"Santiago","last_name":"Ramirez-Figueroa","orcid":"0000-0001-7577-8237"}],"funders":[],"categories":["Radiology","Internal Medicine","Nephrology","Contrast Medium Complications","Utilization of Contrast"],"journal_issn":[]},{"id":"pm5v6pwkkg","title":"Genome-wide screens implicate loss of cullin ring ligase 3 in persistent proliferation and genome instability in TP53 deficient cells","description":"TP53 deficiency is the most common alteration in cancer, however, alone is typically insufficient to drive tumorigenesis. To identify genes promoting tumorigenesis in combination with TP53 deficiency, we performed genome-wide CRISPR/Cas9 knockout screens coupled with proliferation and transformation assays in isogenic cell lines. Loss of several known tumor suppressor genes enhanced cellular proliferation and transformation. Surprisingly, loss neddylation pathway genes, promoted uncontrolled proliferation exclusively in TP53-deficient cells. CUL3 coupled with TP53 loss results in an oncogenic transcriptional program governed by the NFκB, AP-1 and TGF-β pathways. This program maintains persistent cellular proliferation, induces partial epithelial to mesenchymal transition, increases DNA damage, genomic instability, and the rate chromosomal rearrangements. Our findings reveal CUL3 loss as a key event stimulating persistent proliferation in TP53 deficient cells. These findings may be clinically relevant, since TP53-CUL3 deficient cells are highly sensitive to ATM inhibition, exposing a vulnerability that could be exploited for cancer treatment. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-11-06T17:31:10.704Z","url":"https://data.mendeley.com/datasets/pm5v6pwkkg","data_type":"dataset","access":"open","doi":["10.17632/pm5v6pwkkg"],"contributors":[{"first_name":"Alexandros","last_name":"Drainas","orcid":null}],"funders":[],"categories":["Western Blot","Cellular Imaging"],"journal_issn":[]},{"id":"x64s7p7cb7","title":"The expression changes of hepatic proteasome proteins across different feeding regimens","description":"Our transcriptional data showed that the expression of the hepatic genes encoding proteasome subunits switched at the time after fasting or refeeding for 16 hours. Since the amount of proteasomes in Mammalia is reported to be regulated at the transcriptional level, we suspect the expression of hepatic proteasome proteins will be sensitive to feeding behavior. To verify this hypothesis, we performed a Western blot analysis of three hepatic proteasome proteins (PSMB3, PSMA4, PSMB6) across different feeding regimens. The data confirmed our hypothesis.\n\nACTB, actin beta; AF, acute fasting; AL, ad libitum; AR, refeeding after acute fasting; BAT, brown adipose tissue; EODF, every other day fasting; EODR, every other day refeeding; PSMA4, proteasome 20S subunit Alpha 4; PSMB3, proteasome 20S subunit beta 3; PSMB6, proteasome 20S subunit beta 6.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-10-26T11:20:32.687Z","url":"https://data.mendeley.com/datasets/x64s7p7cb7","data_type":"dataset","access":"open","doi":["10.17632/x64s7p7cb7"],"contributors":[{"first_name":"Guolin","last_name":"Li","orcid":null},{"first_name":"Fang","last_name":"Wei","orcid":"0000-0001-5535-0073"},{"first_name":"Lijun","last_name":"Gong","orcid":"0000-0001-8247-1217"}],"funders":[],"categories":["Protein","Proteasome","Expression Analysis"],"journal_issn":[]},{"id":"dj69m2zh93","title":"Meta-analysis: Sulforaphane reno-protective effects in animal models of kidney diseases","description":"Research question: Does Sulforaphane present any reno-protective effects in pre-clinical animal models of kidney disease ?\n\nContext and rationale: Chronic kidney disease (CKD) is characterized by the occurrence of kidney damage and progressive and irreversible\nloss of kidney function. CKD constitutes an important public health problem worldwide since its prevalence is estimated\nto be 10-16% in the World’s adult population. Many pharmacological strategies are being studied to improve the clinical\npicture of these patients and prevent kidney failure. The Keap1-Nrf2 pathway is the major regulator of cytoprotective\nresponses to oxidative and cytotoxic stress. Keap1 (Kelch ECH associating protein 1), a repressor protein binds to Nrf2\nand promotes its degradation by the ubiquitin proteasome pathway. The Keap1-Nrf2 pathway have received extensive\nattention in the context of renal failure. In recent years, clinical studies were performed with bardoxolone methyl, a\npotent inhibitor of Keap1, that proved to be efficient to prevent the decline of renal function in patients with diabetic\nkidney disease, but unfortunately trials were stopped due to an increase in cardiovascular mortality. There is therefore a\ngrowing interest to find other activator of Nrf2 system. Some natural compounds such as sulforaphane, present in many\nvegetables such as cruciferous, are potent activator of Nrf2 pathway. Sulforaphane (SFN), a naturally-occurring\nisothiocyanate enriched in cabbage and broccoli, has been tested in various animal models of kidney failure. This\nsystematic review intends to summarize the knowledges on this field and, if possible, meta-analyze the impact of\nsulforaphane on renal outcomes especially biomarkers of renal function, in animal models of kidney disease. Evidencing\nwith the highest level of evidence the beneficial effects of sulforaphane on renal function in preclinical models could\nstimulate the clinical interest for this compound and promote the implementation of clinical trials in patients with kidney\nfailure.\n\nThe present protocol was pre-registered  on the open-access international prospective register of systematic reviews PROSPERO (https://www.crd.york.ac.uk/prospero/) under the registration number # CRD42022364229.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-01-20T10:25:30.072Z","url":"https://data.mendeley.com/datasets/dj69m2zh93","data_type":"dataset","access":"open","doi":["10.17632/dj69m2zh93"],"contributors":[{"first_name":"Elisa","last_name":"Bernardes Monteiro","orcid":"0000-0003-2495-0054"},{"first_name":"Matheus","last_name":"Lima","orcid":"0000-0002-3667-6315"},{"first_name":"Milena Barcza","last_name":"Stockler-Pinto","orcid":"0000-0003-0131-2033"},{"first_name":"Fitsum","last_name":"Guebre-Egziabher","orcid":"0000-0002-1478-6898"},{"first_name":"Julio","last_name":"Daleprane","orcid":"0000-0002-3493-1386"},{"first_name":"Christophe","last_name":"SOULAGE","orcid":"0000-0002-8800-2144"}],"funders":[{"id":"https://ror.org/03kk0s825","name":"Fundação Carlos Chagas Filho de Amparo à Pesquisa do Estado do Rio de Janeiro","grant_id":"FAPERJ nº 01/2022 (Programa de mobilidade internacional FAPERJ/França- 2022)"}],"categories":["Medicine","Nephrology","Life Sciences","Nutrition","Acute Kidney Injury","Chronic Kidney Disease","Pre-Clinical Translational Research"],"journal_issn":[]},{"id":"2fp6hy6m39","title":"Protein mechanical resistance dataset","description":"The mechanical unfolding of globular proteins upon pulling their amino acid chain (similar to that occurs upon proteasome engagement) has been addressed by Atomic Force Microscopy experiments and by computer simulations. We have collected the peak unfolding force data for pulling the amino acid chain at a given speed for both AFM and simulations, this data is provided here along with all the references.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-04-06T08:50:46.345Z","url":"https://data.mendeley.com/datasets/2fp6hy6m39","data_type":"dataset","access":"open","doi":["10.17632/2fp6hy6m39"],"contributors":[{"first_name":"Sudip","last_name":"Kundu","orcid":null},{"first_name":"Saurav","last_name":"Mallik","orcid":null}],"funders":[],"categories":["Protein Degradation","Proteins","Molecular Mechanics with Molecular Dynamics","Atomic Force Microscopy","Protein Unfolding"],"journal_issn":[]},{"id":"rjtsyp7vv3","title":"Cockayne’s syndrome A and B proteins regulate transcription arrest after genotoxic stress by promoting ATF3 degradation","description":"This data represent the original western blots covering the in vitro data and original ChIP assays with % to input data from the \"Cockayne syndrome A and B proteins regulate the timing of transcription arrest upon genotoxic stress through a ubiquitin/proteasome degradation process\" publication.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2017-11-15T15:37:56.366Z","url":"https://data.mendeley.com/datasets/rjtsyp7vv3","data_type":"dataset","access":"open","doi":["10.17632/rjtsyp7vv3"],"contributors":[{"first_name":"Alexey","last_name":"Epanchintsev","orcid":null},{"first_name":"Federico","last_name":"Costanzo","orcid":null},{"first_name":"Marc-Alexander","last_name":"Rauschendorf","orcid":null},{"first_name":"Manuela","last_name":"Caputo","orcid":null},{"first_name":"Luca","last_name":"Proietti De Santis","orcid":null},{"first_name":"Tao","last_name":"Ye","orcid":null},{"first_name":"Lise-Marie","last_name":"Donnio","orcid":null},{"first_name":"Frédéric ","last_name":"Coin","orcid":null},{"first_name":"Vincent","last_name":"Laugel","orcid":null},{"first_name":"Jean-Marc","last_name":"Egly","orcid":null}],"funders":[],"categories":["Paper (Organic Polymer)"],"journal_issn":[]}],"total_records":127300,"page":1,"page_size":10,"execution_time":144,"aggregations":{"data_type_stats":{"dataset":127300,"collection":0},"access_type_stats":{"open":126715,"restricted":67,"embargoed":518},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2171},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":672},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":446},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":409},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":406},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":398},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":387},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":312},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":264},{"id":"https://ror.org/05r0vyz12","name":"Ministerio de Ciencia, Innovación y Universidades","count":216}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":124753},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1837},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":181},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":133},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":73},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":65},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":52},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":37},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":26}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":481},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":406},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":358},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":330},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":294}]}}