04-428eba58696e","created_date":"2020-05-10T22:18:21.616"},{"id":"be2c941f-920f-4fea-9977-b3a5c31d95a9","name":"Western_blot_n=2","parent_id":"89d8510f-98f9-4788-8504-428eba58696e","created_date":"2020-05-10T22:18:22.924"},{"id":"5fadb943-2474-4706-8d06-4e985c8f354d","name":"DMSO","parent_id":"b4a863a3-56a6-40d7-a034-f8e299604067","created_date":"2020-05-10T21:56:49.693"},{"id":"768412ef-fbc1-4d45-842e-59809a7f60dc","name":"HU","parent_id":"b4a863a3-56a6-40d7-a034-f8e299604067","created_date":"2020-05-10T21:56:53.359"},{"id":"d19c4c40-d05e-4064-9de6-47845e658623","name":"PTS","parent_id":"b4a863a3-56a6-40d7-a034-f8e299604067","created_date":"2020-05-10T21:56:53.993"},{"id":"bd15c29a-4cae-41d8-a90e-fc27ad63bf9d","name":"RSV","parent_id":"b4a863a3-56a6-40d7-a034-f8e299604067","created_date":"2020-05-10T21:56:54.569"},{"id":"878b936f-5461-4486-81bc-27ef7e4b2242","name":"n=1","parent_id":"e08d1172-46d2-45f2-82cc-d5d546f8dcbe","created_date":"2020-05-10T21:37:33.84"},{"id":"b4a863a3-56a6-40d7-a034-f8e299604067","name":"n=2","parent_id":"e08d1172-46d2-45f2-82cc-d5d546f8dcbe","created_date":"2020-05-10T21:37:34.093"},{"id":"31055a90-da6f-483c-b176-e3063f1e05d4","name":"n=1","parent_id":"ff0148d5-8b0f-487b-87bd-bcd56e37f55f","created_date":"2020-05-10T22:08:16.082"},{"id":"2093719d-b40b-4a23-bbc4-71a14e893064","name":"Benslimane_Figure_2B","description":"Figure 2B: (n=1) Samples were electrophoresed on a 10% w/v SDS-PAGE gel and blotted with the phospho-CHK1 antibody, followed by HRP quenching with hydrogen peroxide and re-blotting with the total CHK1 antibody. (n=2) Samples were electrophoresed on a 10% w/v SDS-PAGE gel, membranes were cut above the 75 kDa marker and blotted with the phospho-CHK1 antibody followed by re-blotting with the GAPDH antibody. Blots were treated with hydrogen peroxide to quench HRP followed by blotting with the total CHK1 antibody. All gels included Precision Plus protein Dual Color standards (BioRad, Cat# 1610374) (see corresponding White-Light images).\n","created_date":"2020-05-10T21:24:31.425"},{"id":"bc5f77de-48ae-4c62-964f-5d63f96cd1d1","name":"Benslimane_Figure_2C","description":"Figure 2C: Excel table with the raw luminescence values, relative proliferation and Bliss synergy scores used to prepare Figure 2C.\n","created_date":"2020-05-10T21:24:43.615"},{"id":"e08d1172-46d2-45f2-82cc-d5d546f8dcbe","name":"Benslimane_Figure_3C_3D","description":"Raw microscopy images used for DNA fiber length analysis in Figure 3C, 3D (see methods for data acquisition). \n","created_date":"2020-05-10T21:24:59.508"},{"id":"640aa102-5b6d-4a5e-9530-0354fdd0b06b","name":"Benslimane_Figure_S4A","description":"Sequencing chromatograms of the NALM-6 knockout populations (genotypes as indicated) used as inputs for indel decomposition and quantification with the TIDE algorithm.","created_date":"2020-05-10T21:25:30.744"},{"id":"ff0148d5-8b0f-487b-87bd-bcd56e37f55f","name":"Benslimane_Figure_S4B","description":"Figure S4B: Samples were electrophoresed on 8% w/v SDS-PAGE gel and blotted with the RECQL5 antibody followed by re-blotting with the α-Tubulin antibody. Gels included Precision Plus protein Dual Color standards (BioRad, Cat# 1610374) (see corresponding White-Light images).","created_date":"2020-05-10T21:25:43.717"},{"id":"5f01c5c3-f3ea-448b-85cb-b19c43e5e1bf","name":"Benslimane_Figure_S4C","description":"Figure S4C: (n=1) Samples were electrophoresed on a 10% w/v SDS-PAGE gel and blotted with the SLFN11 antibody, followed by re-blotting with the GAPDH antibody. (n=2) Samples were electrophoresed on a 8% w/v SDS-PAGE gel and blotted with the SLFN11 antibody, followed by re-blotting with the α-Tubulin antibody. Gels included Precision Plus protein Dual Color standards (BioRad, Cat# 1610374) (see corresponding White-Light images).","created_date":"2020-05-10T21:25:55.967"},{"id":"3185e38b-3bdf-481f-9630-2016c2b06add","name":"Benslimane_Figure_S4E","description":"Figure S4E: Sequencing chromatograms of the Jurkat knockout populations (genotypes as indicated) used as inputs for indel decomposition and quantification with the TIDE algorithm. ","created_date":"2020-05-10T21:26:05.935"},{"id":"73c98e26-f419-4d20-a0d9-6580650ebe68","name":"Benslimane_Figure_S4F_S4G","description":"Figure S4F, S4G: Sequencing chromatograms of the NALM-6 clonal knockouts (genotypes as indicated) used as inputs for the indel decomposition and genotyping with the TIDE algorithm. The GenBank sequence file of the pHAGE-RECQL5-P2A-EGFP plasmid cloned in this study. Western blot samples were electrophoresed on a 8% w/v SDS-PAGE gel and blotted with the RECQL5 antibody followed by re-blotting with the α-Tubulin antibody (n=1, n=2). Gels included Precision Plus protein Dual Color standards (BioRad, Cat# 1610374) (see corresponding White-Light images).","created_date":"2020-05-10T21:26:23.34"},{"id":"89d8510f-98f9-4788-8504-428eba58696e","name":"Benslimane_Figure_S4H","description":"Figure S4H: Sequencing chromatograms of the NALM-6 clonal knockouts (genotypes as indicated) used as inputs for the indel decomposition and genotyping with the TIDE algorithm. Western blot samples were electrophoresed on a 10% w/v SDS-PAGE gel and blotted with the SIRT1 antibody followed by re-blotting with the GAPDH antibody (n=1, n=2). Gels included Precision Plus protein Dual Color standards (BioRad, Cat# 1610374) (see corresponding White-Light images).","created_date":"2020-05-10T21:26:42.144"}]