{"records":[{"id":"fkbfsms225","title":"Raw, uncropped supporting Western blot files for: Rona G. ... Pagano M. “CDK-independent role of D-type cyclins in regulating DNA mismatch repair”","description":"Raw, uncropped supporting Western blot files for: Rona G., Miwatani-Minter B., Zhang Q., Goldberg H., Kerzhnerman M., Howard J., Simoneschi D., Lane E., Hobbs J., Sassani E., Wang A., Keegan S., Laverty D., Piett C., Pongor L., Xu L., Andrade J., Thomas A., Sicinski P., Askenazi M., Ueberheide B., Fenyö D., Nagel Z., and Pagano M. CDK-independent role of D-type cyclins in regulating DNA mismatch repair","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-02-27T16:13:28.2Z","url":"https://data.mendeley.com/datasets/fkbfsms225","data_type":"dataset","access":"open","doi":["10.17632/fkbfsms225"],"contributors":[{"first_name":"Michele","last_name":"Pagano","orcid":null},{"first_name":"Gergely","last_name":"Rona","orcid":null}],"funders":[],"categories":["Biochemistry","Western Blot"],"journal_issn":[]},{"id":"w4skgvc83f","title":"Source Code for: The master virulence regulator PhoP dictates carbon metabolism by controlling cyclic AMP synthesis in Salmonella","description":"Source code for \"The master virulence regulator PhoP dictates carbon metabolism by controlling cyclic AMP synthesis in Salmonella\" authored by Nick D. Pokorzynski, Elisabeth C. Sams-Dodd, Chris Esneault, Katarina A. Jones, Shawn R. Campagna, and Eduardo A. Groisman","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-12-05T01:42:54.582Z","url":"https://data.mendeley.com/datasets/w4skgvc83f","data_type":"dataset","access":"open","doi":["10.17632/w4skgvc83f"],"contributors":[{"first_name":"Nick","last_name":"Pokorzynski","orcid":null}],"funders":[{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"AI49561"},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","grant_id":"CHE-1710175 "}],"categories":["Cyclic Adenosine Monophosphate","Metabolism","Magnesium","Bacterial Virulence","Salmonella typhimurium"],"journal_issn":[]},{"id":"f7nnvgmdb7","title":"Source Data for: The master virulence regulator PhoP dictates carbon metabolism by controlling cyclic AMP synthesis in Salmonella","description":"Source Data for \"The master virulence regulator PhoP dictates carbon metabolism by controlling cyclic AMP synthesis in Salmonella\" authored by Nick D. Pokorzynski, Elisabeth C. Sams-Dodd, Chris Esneault, Katarina A. Jones, Shawn R. Campagna, and Eduardo A. Groisman","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-12-05T01:42:20.818Z","url":"https://data.mendeley.com/datasets/f7nnvgmdb7","data_type":"dataset","access":"open","doi":["10.17632/f7nnvgmdb7"],"contributors":[{"first_name":"Nick","last_name":"Pokorzynski","orcid":null}],"funders":[{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","grant_id":"CHE-1710175"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"AI49561"}],"categories":["Metabolism","Salmonella"],"journal_issn":[]},{"id":"s8y5dgv5h8","title":"TDP-43 is a master regulator of paraspeckle condensation. Hodgson, Huang et al.","description":"The paraspeckle is a stress-inducible condensate assembled from NEAT1_2 lncRNA ribonucleoprotein particles (RNPs) by FUS protein. Paraspeckles are suppressed in normal tissues but are rapidly yet transiently upregulated under stress. We demonstrate that TDP-43 inhibits the condensation of NEAT1 RNPs into the paraspeckle via polymerisation on NEAT1_2 UG-repeats, in a concentration-dependent manner. This condensation defect can be rescued by FUS supplementation. Below the disruptive concentration, TDP-43 partitions into paraspeckles as non-liquid clusters demixed from the FUS microphase. In stressed cells, TDP-43 sequestration into de novo nuclear condensates alleviates paraspeckle suppression and increases their dynamism. NEAT1_2 middle-part UG-repeats mediate co-transcriptional TDP-43 recruitment and paraspeckle condensation control, whereas the 3’-end UG-repeat contributes to paraspeckle regulation post-assembly. ExpansionHunter analysis in ~5000 amyotrophic lateral sclerosis patients linked longer 3’-end repeats to shorter survival. Thus, TDP-43 acts as a molecular switch between paraspeckle low- and high-assembly states and fine-tunes their properties – a mechanism dysregulated in neurodegeneration.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-10-16T12:03:48.666Z","url":"https://data.mendeley.com/datasets/s8y5dgv5h8","data_type":"dataset","access":"open","doi":["10.17632/s8y5dgv5h8"],"contributors":[{"first_name":"Tatyana","last_name":"Shelkovnikova","orcid":null}],"funders":[{"id":"https://ror.org/03x94j517","name":"Medical Research Council","grant_id":"MR/W004615/1"},{"id":"https://ror.org/00cwqg982","name":"Biotechnology and Biological Sciences Research Council","grant_id":"BB/V014110/1 "},{"id":"https://ror.org/03x94j517","name":"Medical Research Council","grant_id":"MR/W028522/1"}],"categories":["Cell Biology","RNA","Biomolecular Condensates"],"journal_issn":[]},{"id":"32xwssfzbd","title":"TET1 as a master ferroptosis regulator in cancer","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-01-27T08:08:37.201Z","embargo_date":"2035-01-28T23:59:59Z","url":"https://data.mendeley.com/datasets/32xwssfzbd","data_type":"dataset","access":"embargoed","doi":["10.17632/32xwssfzbd"],"contributors":[{"first_name":"lingling","last_name":"yang","orcid":null}]},{"id":"b3sh9b3th6","title":"DYT6 mutated THAP1 is a cell type dependent regulator of the SP1 family","description":"Supplementary data of a research project","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-10-29T12:44:25.422Z","url":"https://data.mendeley.com/datasets/b3sh9b3th6","data_type":"dataset","access":"open","doi":["10.17632/b3sh9b3th6"],"contributors":[{"first_name":"Fubo","last_name":"Cheng","orcid":null}],"funders":[],"categories":["Statistical Analysis"],"journal_issn":[]},{"id":"9xwvvvcsz6","title":"Glucose-induced CRL4COP1-p53 degradation axis amplifies glycometabolism to drive tumorigenesis ","description":"The diabetes-cancer association remains under-explained. Here, we describe a glucose signaling axis that reinforces glucose uptake and glycolysis to consolidate the Warburg effect and overcome tumor suppression. Specifically, glucose-dependent CK2 O-GlcNAcylation impedes its phosphorylation of CSN2, a modification required for the deneddylase CSN to sequester Cullin RING Ligase 4 (CRL4). Glucose therefore elicits CSN-CRL4 dissociation to assemble the CRL4^COP1 E3 ligase, which targets p53 to derepress glycolytic enzymes. Genetic or pharmacologic disruption of the O-GlcNAc-CK2-CSN2-CRL4^COP1 axis abrogates glucose-induced p53 degradation and cancer cell proliferation. Diet-induced overnutrition up-regulates the CRL4^COP1-p53 axis to promote PyMT-induced mammary tumorigenesis in wildtype but not mammary gland-specific p53 knockout mice. These effects of overnutrition are reversed by P28, an investigational peptide inhibitor of COP1-p53 interaction. Thus, glycometabolism self-amplifies via a glucose-induced post-translational modification cascade culminating in CRL4^COP1-mediated p53 degradation. Such mutation-independent p53 checkpoint bypass may represent the carcinogenic origin and targetable vulnerability of hyperglycemia-driven cancer. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-06T07:19:12.339Z","url":"https://data.mendeley.com/datasets/9xwvvvcsz6","data_type":"dataset","access":"open","doi":["10.17632/9xwvvvcsz6"],"contributors":[{"first_name":"Feng","last_name":"Rao","orcid":null},{"first_name":"Yang","last_name":"Su","orcid":null},{"first_name":"Yifan","last_name":"Luo","orcid":null}],"funders":[],"categories":["Life Sciences"],"journal_issn":[]},{"id":"kjdy3r2twp","title":"A master regulator of lipid metabolism acting through protein denitrosylation, Venetos et al.","description":"Lipid homeostasis is subject to control by master regulators such as sirtuin deacetylases that reverse CoA-dependent acetylation. Here we show that a mammalian denitrosylase (SCoR2), which counteracts CoA-dependent S-nitrosylation, serves as a major regulator of both fat storage and lipogenesis to control metabolic health. In mice, SCoR2 expression correlates with body mass, and deleting or drugging SCoR2 prevents both diet-induced obesity and fatty liver (MASLD). Loss of SCoR2 in adipocytes promotes S-nitrosylation of Myosin 9, inhibiting transcription factors PPAR, SREBP1 and CEBP to limit fat storage, while in hepatocytes, SCoR2-regulated S-nitrosylation of lipogenic enzymes reduces fat synthesis and induces fat oxidation. In humans, an obesity-linked polymorphism increases SCoR2 expression, and in patient adipose and liver tissues, SCoR2 expression level directly correlates with adipocyte size and MASLD. SCoR2 is therefore a key regulator of nutrient metabolism, akin to sirtuins, and a potential drug target for obesity and MASLD.\n\nRaw data files for publication figures and for proteomics","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-10-14T08:09:47.838Z","url":"https://data.mendeley.com/datasets/kjdy3r2twp","data_type":"dataset","access":"open","doi":["10.17632/kjdy3r2twp"],"contributors":[{"first_name":"Nicholas","last_name":"Venetos","orcid":null},{"first_name":"Richard","last_name":"Premont","orcid":"0000-0002-8053-5026"},{"first_name":"Jonathan","last_name":"Stamler","orcid":"0000-0002-6866-1572"}],"funders":[{"id":"https://ror.org/00adh9b73","name":"National Institute of Diabetes and Digestive and Kidney Diseases","grant_id":"DK119506"},{"id":"https://ror.org/00adh9b73","name":"National Institute of Diabetes and Digestive and Kidney Diseases","grant_id":"DK128944"},{"id":"https://ror.org/04q48ey07","name":"National Institute of General Medical Sciences","grant_id":"5T32 GM007250-43"}],"categories":["Enzymology","Obesity","Nitric Oxide","Metabolism","Nitrosothiols"],"journal_issn":[]},{"id":"bsj2fc65tp","title":"TET1 as a master regulator controlling GPX4-dependent and -independent ferroptosis surveillance in acute myeloid leukemia","description":"This folder supports the research article titled “TET1 as a master regulator controlling GPX4-dependent and  -independent ferroptosis surveillance in acute myeloid leukemia.” It contains the data and output files (including tables and figures) used in the study.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-12-08T12:14:12.398Z","url":"https://data.mendeley.com/datasets/bsj2fc65tp","data_type":"dataset","access":"open","doi":["10.17632/bsj2fc65tp"],"contributors":[{"first_name":"lingling","last_name":"yang","orcid":null}],"funders":[],"categories":["Acute Myelogenous Leukemia"],"journal_issn":[]},{"id":"md44b9h2r5","title":"Dietary sugars silence the master regulator of carbohydrate utilization in human gut Bacteroides species","description":"Raw data for all figures in \"Dietary sugars silence the master regulator of carbohydrate utilization in human gut Bacteroides species\". These data include western blot quantification, in vivo competition assays, and qPCR data. In this study we address how a global transcription factor governs the synthesis of important colonization proteins and the effect of sugar consumption on this mechanism. All data analysis is outlined in the materials and methods section of the manuscript.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-04-14T20:49:13.096Z","url":"https://data.mendeley.com/datasets/md44b9h2r5","data_type":"dataset","access":"open","doi":["10.17632/md44b9h2r5"],"contributors":[{"first_name":"Victoria","last_name":"Pearce","orcid":null},{"first_name":"Guy ","last_name":"Townsend","orcid":"0000-0002-8231-3769"}],"funders":[],"categories":["Microbiology","Transcription","Gut Microbiota"],"journal_issn":[]}],"total_records":131803,"page":1,"page_size":10,"execution_time":162,"aggregations":{"data_type_stats":{"dataset":131803,"collection":0},"access_type_stats":{"open":131259,"restricted":64,"embargoed":480},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2178},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1472},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":600},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":455},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":439},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":415},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":407},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":361},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":293},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":261}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":129194},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1901},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository",