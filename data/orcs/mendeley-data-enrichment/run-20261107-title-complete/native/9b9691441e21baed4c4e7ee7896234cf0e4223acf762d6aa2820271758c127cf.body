rst_name":"Olga","last_name":"Sizova","orcid":null},{"first_name":"David","last_name":"Thomson Taylor","orcid":null},{"first_name":"Maria","last_name":"Tereshchenko","orcid":null},{"first_name":"David","last_name":"Tieu","orcid":null},{"first_name":"Jacob","last_name":"Turowec","orcid":null},{"first_name":"Tajinder","last_name":"Ubhi","orcid":null},{"first_name":"Sylvia","last_name":"Varland","orcid":null},{"first_name":"Kyle E.","last_name":"Wang","orcid":null},{"first_name":"Zi Yang","last_name":"Wang","orcid":null},{"first_name":"Jiarun","last_name":"Wei","orcid":null},{"first_name":"YUXI","last_name":"XIAO","orcid":null},{"first_name":"Philipp G.","last_name":"Maass","orcid":null},{"first_name":"Bruno","last_name":"Reversade","orcid":null},{"first_name":"Grant W.","last_name":"Brown","orcid":null},{"first_name":"Bejamin F.","last_name":"Cravatt","orcid":null},{"first_name":"Scott","last_name":"Dixon","orcid":null},{"first_name":"Haley D. M.","last_name":"Wyatt","orcid":null},{"first_name":"Hannes L.","last_name":"Röst","orcid":null},{"first_name":"Frederick P.","last_name":"Roth","orcid":null},{"first_name":"Tian","last_name":"Xia","orcid":null},{"first_name":"Gary D.","last_name":"Bader","orcid":null},{"first_name":"Robbie","last_name":"Loewith","orcid":null},{"first_name":"Nicholas G.","last_name":"Davis","orcid":null},{"first_name":"Brenda","last_name":"Andrews","orcid":null},{"first_name":"Chad","last_name":"Myers","orcid":null},{"first_name":"Jason","last_name":"Moffat","orcid":null},{"first_name":"Charles","last_name":"Boone","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"MOP_142735"},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","grant_id":"MCB1818293"},{"id":"https://ror.org/01h531d29","name":"Natural Sciences and Engineering Research Council of Canada","grant_id":"RGPIN-2020-04180"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT 173542"},{"id":"https://ror.org/000az4664","name":"Canada Foundation for Innovation","grant_id":"39977"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE09-011"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE011-006"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-180285"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-GMX-463531"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2024-08-02"},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","grant_id":"DFG Bi 2086/1-1"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG005084"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2022-02"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG00583"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"T32GM008347"},{"id":null,"name":"NIH/NCI Ruth L. Kirschstein National Research F30 Award","grant_id":"5F30CA257227"}],"categories":["Genetics","Biological Network"],"journal_issn":[]},{"id":"8xhv88c7wt","title":"Genome-wide screening in human kidney organoids identifies developmental and disease-related aspects of nephrogenesis","description":"Human organoids allow the study of proliferation, lineage specification, and three-dimensional tissue development. Here, we present a genome-wide CRISPR screen in iPSC-derived kidney organoids. The combination of inducible genome editing, longitudinal sampling and endpoint sorting of tubular and stromal cells generated a complex, high-quality dataset uncovering a broad spectrum of insightful biology from early development to ‘adult’ epithelial morphogenesis. Our functional dataset allows improving mesoderm induction by ROCK inhibition, contains monogenetic and complex trait kidney disease genes, confirms two additional CAKUT genes (CCDC170 and MYH7B), and provides a large candidate list of ciliopathy-related genes. Finally, the identification of a cis-inhibitory effect of Jagged1 controlling epithelial proliferation shows how mosaic knockouts in pooled CRISPR screening can discover ways of communication between heterogeneous cell populations in complex tissues. Collectively, these data serve both as a rich resource for the kidney community and as a benchmark for future iPSC-derived organoid CRISPR screens.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-29T13:48:59.335Z","url":"https://data.mendeley.com/datasets/8xhv88c7wt","data_type":"dataset","access":"open","doi":["10.17632/8xhv88c7wt"],"contributors":[{"first_name":"Rosemarie","last_name":"Ungricht","orcid":null},{"first_name":"Philipp","last_name":"Hoppe","orcid":null}],"funders":[],"categories":["Screening","CRISPR"],"journal_issn":[]},{"id":"gfcn2wmrpf","title":"Dataset for the paper entitled \"A genetic map of the response to DNA damage in human cells\" by Olivieri M et al. Cell 2020","description":"We used pooled CRISPR/Cas9 screens in the human RPE1-hTERT p53-/- cell line against 27 genotoxic agents. The Dataset herein make the primary data available. The files are:\n\n* Additional genes of interest (discussion and data relating to TMEM2, ESD, USP37, PHF12, BTAF1 and DRAP1)\n* Supplementary Raw Data: Data used to make all the graphs in the manuscript\n* Folder \"CRISPR screen readcount files\". Readcounts for the screens undertaken as part of this study.\n* Folder \"Raw images for immunoblots\": uncropped images for all the blots in the manuscript\n* Folder: \"Additional QC analyses of CRISPR screens\": Additional analyses that measure the quality of the screens using Presion-Recall curves of essential genes and an estimate of genes that scored as hits due to batch effects.\n* Folder \"Data_Analysis_Code\" R markdown file along with data files\n* File: \"Additional Genes of Interests\" contains a short discussion of genes we found noteworthy after analysis of our screen data.\n\nVersion 2 note: this version differs from Version 1 by a single file (FDRPos_31screens.csv) which has a tab error fixed.\n\n\n\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-07-07T14:26:40.176Z","url":"https://data.mendeley.com/datasets/gfcn2wmrpf","data_type":"dataset","access":"open","doi":["10.17632/gfcn2wmrpf"],"contributors":[{"first_name":"Daniel","last_name":"Durocher","orcid":null},{"first_name":"Michele","last_name":"Olivieri","orcid":null}],"funders":[],"categories":["Data Quality","Primary Data"],"journal_issn":[]},{"id":"sxrvzkr4hh","title":"Pooled in vitro and in vivo CRISPR-Cas9 screening identifies tumor suppressors in human colon organoids","description":"UMI validation screen, original data from in vivo tumor suppressor CRISPR/Cas9 screening experiment. Figure 6.\nExperimental setup: 281 tumor suppressor gRNAs, positive controls, neutral controls and gRNAs targeting essential genes were introduced into the CRISPR-UMI lentivirus (Michlits et al., 2017). Transduced AK organoids (APC-KO and KRASG12D) were transplanted subcutaneously in NSG mice followed by barcode sequencing of the tumor pool (from 10 mice) and 5 individual tumors. Clone and read number were determined by next generation sequencing. The conventional gRNA enrichment analysis was compared to UMI-CRISPR-screening with outlier removal.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-04-20T15:46:17.868Z","url":"https://data.mendeley.com/datasets/sxrvzkr4hh","data_type":"dataset","access":"open","doi":["10.17632/sxrvzkr4hh"],"contributors":[{"first_name":"Henner","last_name":"Farin","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"mk7z7st438","title":"ATR restrains DNA synthesis and mitotic catastrophe in response to CDC7 inhibition. Rainey et al","description":"Background:\nCDC7 kinase is required for activation of licensed origins of replication during the process of DNA duplication. CDC7 kinase inhibitors interfere with this process, limiting both DNA synthesis and cell proliferation.\n\nAim:\nIdentify genes responsible for limiting cell proliferation in response to inhibition of CDC7 using small molecule ATP-competitive inhibitors.\n\nStrategy:\nA CRISPR/Cas9 loss of function screen was performed to identify genes that upon loss allow bypass of a proliferation blockade imposed by the CDC7 inhibitor, XL413.\n\nData:\nRepresents source data for main figures and supplemental items in support of the Manuscript 'ATR restrains DNA synthesis and mitotic catastrophe in response to CDC7 inhibition', Rainey et al.\n\nData collection, interpretation and findings are addressed in the manuscript.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-19T20:26:38.851Z","url":"https://data.mendeley.com/datasets/mk7z7st438","data_type":"dataset","access":"open","doi":["10.17632/mk7z7st438"],"contributors":[{"first_name":"Michael","last_name":"Rainey","orcid":null}],"funders":[],"categories":["Cancer","DNA Replication","Cell Signaling","Genetic Screening"],"journal_issn":[]},{"id":"fm6dngb7wz","title":"Senescence focused gene arrays in MSC under different oxygen pressures","description":"Expression of senescence associated genes (N=84) was screened in cultures of mesenchymal stromal cells from human healthy donors (N=4) simultaneously isolated and expanded in different oxygen pressure (5% and19.95%). We hypothesized that higher oxygen pressure would increase the expression of genes involved in cellular senescence. RNA from passage 3 cultures at 70% confluence during growth log phase  RNA (Qiagen RNeasy) was transcribed using Qiagen RT2 First Strand kit, followed by amplification using Qiagen RT2 Profiler PCR Array focused on cellular senescence and Qiagen SBR Green PCR master mix. Data analysis was performed using the  RT2 PCR Profiler PCR Array Data Analysis software provided by Qiagen. Data analysis was based on the ΔΔCT method with normalization of the raw data to housekeeping genes.We found only four genes that were differentially expressed (CDK4, MYC, P53BP1 and SOD2) with 2 fold change (p value less than 0.05). The array did not identify a specific senescence pathway. The samples were from primary cultures and in a small number, therefore data require validation using larger number of donors.   ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-02-14T13:30:15.259Z","url":"https://data.mendeley.com/datasets/fm6dngb7wz","data_type":"dataset","access":"open","doi":["10.17632/fm6dngb7wz"],"contributors":[{"first_name":"Maria","last_name":"Cabreira","orcid":null}],"funders":[],"categories":["Cellular Senescence","Differential Gene Expression","Bone Marrow Stromal Cell"],"journal_issn":[]},{"id":"839nknw58h","title":"Supplementary Data (Signature changes in the expressions of protein-coding genes, lncRNAs and repeat elements in early and late cellular senescence)","description":"Supplementary Data of the research article: \n\"Signature changes in the expressions of protein-coding genes, lncRNAs and repeat elements in early and late cellular senescence.\"\nTurkish Journal of Biology\nDOI: 10.3906/biy-2005-21\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-12-07T23:46:15.51Z","url":"https://data.mendeley.com/datasets/839nknw58h","data_type":"dataset","access":"open","doi":["10.17632/839nknw58h"],"contributors":[{"first_name":"Gökhan","last_name":"Karakülah","orcid":null},{"first_name":"Cihangir","last_name":"Yandım","orcid":null}],"funders":[],"categories":["Genomics","Principal Component Analysis","RNA Sequencing","Fibroblast","Cellular Senescence","Gene Ontology","DNA Repeated Sequence","Long Noncoding RNA"],"journal_issn":[]},{"id":"79bggkk6xs","title":"Identification of MMP14 and FOS as Key Regulators of Vascular Smooth Muscle Cell Senescence in Diabetic Kidney Disease: A Combined Bioinformatics and Experimental Study","description":"To investigate vascular smooth muscle cell (VSMC) senescence in diabetic kidney disease (DKD), this study integrated bioinformatics and machine learning to analyze DKD and VSMC aging transcriptomic datasets. Key genes MMP14 and FOS were identified through differential expression, WGCNA, and random forest analyses. They were significantly associated with cellular senescence and immune infiltration, demonstrating diagnostic value. Regulatory network analysis suggested potential ceRNA mechanisms and transcription factors. In a hyperglycemia-induced VSMC senescence model, experimental validation showed that overexpressing MMP14 or suppressing FOS promoted cell proliferation and alleviated senescence and apoptosis. This study identifies MMP14 and FOS as crucial regulators of VSMC senescence, providing new potential targets for DKD diagnosis and therapy.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-12-15T15:11:57.627Z","url":"https://data.mendeley.com/datasets/79bggkk6xs","data_type":"dataset","access":"open","doi":["10.17632/79bggkk6xs"],"contributors":[{"first_name":"Bo","last_name":"Qu","orcid":null}],"funders":[],"categories":["Nephrology"],"journal_issn":[]},{"id":"ngvnm5tty7","title":"SIRT7 regulates NUCKS1 chromatin binding to elicit metabolic and inflammatory gene expression in senescence and liver aging","description":"Sirtuins enzymes are heavily implicated in senescence and aging. The regulation of sirtuin proteins is tightly controlled but how sirtuin levels are regulated during aging and how they elicit tissue-specific cellular changes are unclear. We demonstrate that SIRT7 is targeted for degradation during senescence and is regulated by E3 Ligase TRIP12. We identified transcription factor NUCKS1 interacts with SIRT7 and is recruited onto chromatin during senescence. This is mediated by SIRT7 loss and subsequent increase of NUCKS1 acetylation. NUCKS1 depletion delayed senescence leading to reduced inflammatory gene expression associated with RELA, and CEBP. In Sirt7 KO mouse and aged livers, NUCKS1 was bound at promoters and enhancers of age-related genes and these regions gain accessibility during aging. Overall, our results uncover NUCKS1 as a interactor of SIRT7 and proteosomal loss of SIRT7 during senescence and liver aging promotes NUCKS1 acetylation and chromatin binding to induce metabolic and inflammatory genes.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-05-21T07:45:23.871Z","url":"https://data.mendeley.com/datasets/ngvnm5tty7","data_type":"dataset","access":"open","doi":["10.17632/ngvnm5tty7"],"contributors":[{"first_name":"Khoa","last_name":"Tran","orcid":null}],"funders":[],"categories":["Western Blot","Cellular Imaging"],"journal_issn":[]}],"total_records":144734,"page":1,"page_size":10,"execution_time":208,"aggregations":{"data_type_stats":{"dataset":144734,"collection":0},"access_type_stats":{"open":143850,"restricted":73,"embargoed":811},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2370},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1395},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":709},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":478},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":457},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":442},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":428},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":403},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":337},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":278}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":142059},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1911},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":189},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":143},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":80},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":59},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":44},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":27}],"top_institutions_stats":[{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":905},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":846},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":546},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":409},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":374}]}}