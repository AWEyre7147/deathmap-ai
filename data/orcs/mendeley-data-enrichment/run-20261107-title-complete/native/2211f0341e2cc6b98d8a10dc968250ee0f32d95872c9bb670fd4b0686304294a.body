{"records":[{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"9x47wzy8x7","title":"A study of \"Genome-wide CRISPR screens reveal host factors critical for SARS-CoV-2 infection\" by Wei et al. Cell 2020","description":"Identification of host genes essential for SARS-CoV-2 infection may reveal novel therapeutic targets and inform our understanding of COVID-19 pathogenesis. Here, we performed genome-wide CRISPR screens in Vero-E6 cells with SARS-CoV-2, MERS-CoV, bat coronavirus HKU5 expressing the SARS-CoV-1 spike, and VSV expressing the SARS-CoV-2 spike. Together this identifies potential therapeutic targets for SARS-CoV-2 and reveals SARS-lineage specific and pan-coronavirus host factors that regulate susceptibility to highly pathogenic coronaviruses.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-15T21:29:14.06Z","url":"https://data.mendeley.com/datasets/9x47wzy8x7","data_type":"dataset","access":"open","doi":["10.17632/9x47wzy8x7"],"contributors":[{"first_name":"Craig","last_name":"Wilen","orcid":null}],"funders":[],"categories":["CRISPR","Middle East Respiratory Syndrome-Related Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"4mb5kjywkj","title":"Western Blot raw data of the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\"","description":"The raw images of WB is for the reviewers' request when reviewing the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-04T00:26:32.621Z","url":"https://data.mendeley.com/datasets/4mb5kjywkj","data_type":"dataset","access":"open","doi":["10.17632/4mb5kjywkj"],"contributors":[{"first_name":"Mingang","last_name":"Hao","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"zhpg8xshp9","title":"Lawrence et al., PNAS 2026","description":"Data from “Lawrence et al., 2026 A Genome-Wide Screen Identifies that PLCG2 Restrains Lysosomal GCase Activity.\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-22T18:23:16.389Z","url":"https://data.mendeley.com/datasets/zhpg8xshp9","data_type":"dataset","access":"open","doi":["10.17632/zhpg8xshp9"],"contributors":[{"first_name":"Baris","last_name":"Bingol","orcid":null}],"funders":[],"categories":["Natural Sciences"],"journal_issn":[]},{"id":"nxvdzybwhf","title":"Illuminating host-mycobacterial interactions with genome-wide CRISPR knockout and CRISPRi screens","description":"The data deposited here contains genome-wide CRISPR knockout and CRISPRi screen data, including the positive hits, the negative hits, and non-targeting controls. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-30T11:32:01.108Z","url":"https://data.mendeley.com/datasets/nxvdzybwhf","data_type":"dataset","access":"open","doi":["10.17632/nxvdzybwhf"],"contributors":[{"first_name":"Yong","last_name":"Lai","orcid":null}],"funders":[],"categories":["Functional Genomics","High-Throughput Sequencing","Tuberculosis"],"journal_issn":[]},{"id":"v4zbbbsr5t","title":"VPS33A and VPS18 orchestrate porcine epidemic diarrhea virus replication by modulating autophagic flux","description":"Completion of autophagy through autophagosome-lysosome fusion represents a critical regulatory checkpoint that is frequently manipulated during viral infection, yet how coronaviruses exploit this terminal step remains incompletely understood. Porcine epidemic diarrhea virus (PEDV), a highly pathogenic alphacoronavirus, has been reported to induce autophagy, but whether and how complete autophagic flux contributes to viral replication is unclear. Here, using a genome-wide CRISPR/Cas9 knockout screen in Vero cells, we identify the HOPS complex subunits VPS33A and VPS18 as essential host factors for PEDV infection. Genetic ablation of either VPS33A or VPS18 profoundly suppresses viral progeny production and arrests autophagic flux at the autophagosome stage, demonstrating that PEDV replication is associated with HOPS-mediated autolysosome formation. Domain-mapping analyses further reveal that the structural integrity of VPS33A and the α-solenoid plus RING domains of VPS18 are indispensable for both autophagosome-lysosome fusion and efficient viral replication. Mechanistically, we show that PEDV non-structural proteins nsp3 and nsp4 physically interact with VPS33A and VPS18. While either protein alone initiates autophagosome formation, their coordinated action contributes to drive complete autophagy in a HOPS-dependent manner. Collectively, our findings uncover a coronavirus strategy that actively promotes autophagic completion through VPS33A and VPS18, two core subunits of the HOPS complex, to support replication, thereby establishing autolysosome formation as a critical host process exploited by PEDV.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-05-18T15:12:38.75Z","url":"https://data.mendeley.com/datasets/v4zbbbsr5t","data_type":"dataset","access":"open","doi":["10.17632/v4zbbbsr5t"],"contributors":[{"first_name":"liang","last_name":"guo","orcid":null}],"funders":[{"id":null,"name":"the National Key Research and Development Program of China","grant_id":"2023YFC3404301, 2023YFF1000204, and 2021YFA0805901"},{"id":null,"name":"the Hainan Provincial Natural Science Foundation of China","grant_id":"323QN261"}],"categories":["Virus","Animal"],"journal_issn":[]},{"id":"ztg7pxr6ch","title":"STT3A is essential for Wnt signaling and represents a target for cancers driven by RNF43 deficiency","description":"This dataset contains the original raw and analyzed data supporting the manuscript “STT3A is essential for Wnt signaling and represents a target for cancers driven by RNF43 deficiency”. The study identifies STT3A as an essential regulator of the Wnt signaling pathway and a potential therapeutic target for RNF43-deficient cancers. Included data were generated from key experiments, including Wnt reporter assays (DDT), Western blotting (WB), and CRISPR screen, and other experiments central to the study","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-10-13T11:26:58.874Z","url":"https://data.mendeley.com/datasets/ztg7pxr6ch","data_type":"dataset","access":"open","doi":["10.17632/ztg7pxr6ch"],"contributors":[{"first_name":"Zhengjin","last_name":"He","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"nnxh5d35nd","title":"Genome-wide CRISPR-Cas9 screen identified KLF11 as a druggable suppressor for sarcoma cancer stem cells","description":"The original, unprocessed data alongside the paper","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-05-31T01:39:45.722Z","url":"https://data.mendeley.com/datasets/nnxh5d35nd","data_type":"dataset","access":"open","doi":["10.17632/nnxh5d35nd"],"contributors":[{"first_name":"Le","last_name":"Qu","orcid":null}],"funders":[],"categories":["Cancer"],"journal_issn":[]}],"total_records":139418,"page":1,"page_size":10,"execution_time":163,"aggregations":{"data_type_stats":{"dataset":139418,"collection":0},"access_type_stats":{"open":138804,"restricted":66,"embargoed":548},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2326},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1694},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":659},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":476},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":451},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":436},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":421},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":380},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":307},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":273}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":136769},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1908},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":186},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":136},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":77},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":59},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Ba