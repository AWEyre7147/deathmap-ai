{"records":[{"id":"77s5zvgffj","title":"WB data_PP","description":"Western Blotting and qPCR data for iPSC-derived astrocytes in X-ALD.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-02-27T11:02:48.96Z","url":"https://data.mendeley.com/datasets/77s5zvgffj","data_type":"dataset","access":"open","doi":["10.17632/77s5zvgffj"],"contributors":[{"first_name":"Parveen","last_name":"Parasar","orcid":null},{"first_name":"Navtej","last_name":"Kaur","orcid":null},{"first_name":"Laila","last_name":"Poisson","orcid":null},{"first_name":"Jaspreet ","last_name":"Singh","orcid":null}],"funders":[{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R21NS114775 and R01NS114245 "}],"categories":["Western Blot","Real-Time Polymerase Chain Reaction"],"journal_issn":[]},{"id":"8mf35ntz9z","title":"Severe reactive astrocytes precipitate pathological hallmarks of Alzheimer’s disease via H2O2-production","description":"Although pathological contributions of reactive astrocytes have been implicated in Alzheimer’s disease (AD), their in vivo functions remain elusive due to the lack of appropriate experimental model and precise molecular mechanisms. Here, we showed have shown the importance of astrocytic reactivity on the pathogenesis of AD, using GiD, a newly developed animal model of reactive astrocytes, in which the reactivity of astrocytes can be manipulated as mild (GiDm) or severe (GiDs). Mechanistically, excessive H2O2 originated from monoamine oxidase B (MAO-B) in severe reactive astrocytes caused glial activation, tauopathy, neuronal death, brain atrophy, cognitive impairment and eventual death, which were significantly prevented by AAD-2004, a potent H2O2 scavenger. These H2O2-induced pathological features of AD in GiDs were consistently recapitulated in 3D-culture AD model, virus-infected APP/PS1 mice and human AD brain. Our study identifies H2O2 from the severe reactive astrocytes, but not mild reactive astrocytes, as a key determinant of neurodegeneration in AD.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-05T20:25:01.331Z","url":"https://data.mendeley.com/datasets/8mf35ntz9z","data_type":"dataset","access":"open","doi":["10.17632/8mf35ntz9z"],"contributors":[{"first_name":"Heejung","last_name":"Chun","orcid":null},{"first_name":"Hyeonjoo","last_name":"Im","orcid":null},{"first_name":"You Jung","last_name":"Kang","orcid":null},{"first_name":"Yunha","last_name":"Kim","orcid":null},{"first_name":"Jin Hee","last_name":"Shin","orcid":null},{"first_name":"Woojin","last_name":"Won","orcid":null},{"first_name":"Jiwoon","last_name":"Lim","orcid":null},{"first_name":"Yeonha","last_name":"Ju","orcid":null},{"first_name":"Yongmin Mason ","last_name":"Park","orcid":null},{"first_name":"Sunpil","last_name":"Kim","orcid":null},{"first_name":"Seung Eun","last_name":"Lee","orcid":null},{"first_name":"Jaekwang","last_name":"Lee","orcid":null},{"first_name":"Junsung","last_name":"Woo","orcid":null},{"first_name":"Yujin","last_name":"Hwang","orcid":null},{"first_name":"Hyeseon","last_name":"Cho","orcid":null},{"first_name":"Seonmi","last_name":"Jo","orcid":null},{"first_name":"Jong-Hyun","last_name":"Park","orcid":null},{"first_name":"Daesoo","last_name":"Kim","orcid":null},{"first_name":"Doo Yeon","last_name":"Kim","orcid":null},{"first_name":"Jung-Seon","last_name":"Seo","orcid":null},{"first_name":"Byoung Joo","last_name":"Gwag","orcid":null},{"first_name":"YoungSoo","last_name":"Kim","orcid":null},{"first_name":"Ki Duk","last_name":"Park","orcid":null},{"first_name":"Bong-Kiun","last_name":"Kaang","orcid":null},{"first_name":"Hansang","last_name":"Cho","orcid":null},{"first_name":"Hoon","last_name":"Ryu","orcid":null},{"first_name":"C. Justin","last_name":"Lee","orcid":null}],"funders":[],"categories":["Statistical Database"],"journal_issn":[]},{"id":"wwwrzhbz59","title":"RNA Seq data of iPSC-derived astrocytes from Progressive Supranuclerar (PSP) patients  and controls","description":"RNA seq data of iPSC-derived astrocytes from Progressive Supranuclear Palsy (PSP) patients and controls: number of reads and differentially expressed genes tables. Progressive Supranuclear Palsy patients (PK01, PK02, PK04, PK08, PK09) controls (PK03, PK05, PK06, CQ16)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-04-21T07:24:47.329Z","url":"https://data.mendeley.com/datasets/wwwrzhbz59","data_type":"dataset","access":"open","doi":["10.17632/wwwrzhbz59"],"contributors":[{"first_name":"Patricia","last_name":"de Carvalho Aguiar","orcid":null},{"first_name":"Felipe","last_name":"Ravagnani","orcid":"0000-0002-2551-8207"},{"first_name":"Jersey Heitor","last_name":"Maues","orcid":"0000-0001-5570-3158"},{"first_name":"Renato David","last_name":"Puga","orcid":"0000-0002-6366-0765"},{"first_name":"Karina","last_name":"Griesi-Oliveira","orcid":"0000-0002-0975-666X"}],"funders":[{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","grant_id":"2017/24022-4 "}],"categories":["Neurodegenerative Disorder","RNA","Induced Pluripotent Stem Cell","Astrocyte","Progressive Supranuclear Palsy","Transcriptomics"],"journal_issn":[]},{"id":"t6g8bfpgvk","title":"M. Jost et al,. Mol Cell 2017 - Figure 5D - Combined CRISPRi/a-based chemical genetic screens reveal that rigosertib is a microtubule-destabilizing agent","description":"Microscopy files used for the analysis of data presented in figure 5D of\r\nM. Jost et al., Combined CRISPRi/a-based chemical genetic screens reveal that rigosertib is a microtubule-destabilizing agent. 2017","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2017-08-29T10:28:07.227Z","url":"https://data.mendeley.com/datasets/t6g8bfpgvk","data_type":"dataset","access":"open","doi":["10.17632/t6g8bfpgvk"],"contributors":[{"first_name":"Lenno","last_name":"Krenning","orcid":null},{"first_name":"Ankit","last_name":"Rai","orcid":null},{"first_name":"Anna","last_name":"Akhmanova","orcid":null}],"funders":[],"categories":["Microscopy","In Vitro Techniques"],"journal_issn":["10972765"]},{"id":"dfdxy4ksh3","title":"Figure 4 - Combined CRISPRi/a-based chemical genetic screens reveal that rigosertib is a microtubule-destabilizing agent","description":"Microscopy files used for the analysis of data presented in figures 4 and S4 of\r\nM. Jost et al., Combined CRISPRi/a-based chemical genetic screens reveal that rigosertib is a microtubule-destabilizing agent. 2017","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2017-07-18T06:50:43.254Z","url":"https://data.mendeley.com/datasets/dfdxy4ksh3","data_type":"dataset","access":"open","doi":["10.17632/dfdxy4ksh3"],"contributors":[{"first_name":"Lenno","last_name":"Krenning","orcid":null},{"first_name":"Marvin","last_name":"Tanenbaum","orcid":null}],"funders":[],"categories":["Cell Biology","Microscopy"],"journal_issn":["10972765"]},{"id":"tm22dtht9x","title":"M. Jost et al,. Mol Cell 2017 - Figure 5A - Combined CRISPRi/a-based chemical genetic screens reveal that rigosertib is a microtubule-destabilizing agent","description":"Microscopy files used for the analysis of data presented in figure 5A of\r\nM. Jost et al., Combined CRISPRi/a-based chemical genetic screens reveal that rigosertib is a microtubule-destabilizing agent. Mol. Cell. 2017","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2017-08-29T10:27:52.938Z","url":"https://data.mendeley.com/datasets/tm22dtht9x","data_type":"dataset","access":"open","doi":["10.17632/tm22dtht9x"],"contributors":[{"first_name":"Lenno","last_name":"Krenning","orcid":null}],"funders":[],"categories":["Microscopy","In Vitro Techniques"],"journal_issn":["10972765"]},{"id":"fgswr9ctcr","title":"Dataset for 'GBA1 deficiency differentially affects endolysosomal trafficking in neurons versus astrocytes'","description":"This dataset contains the raw data supporting all main and supplementary figures in the manuscript 'GBA1 deficiency differentially affects endolysosomal trafficking in neurons versus astrocytes' intended for submission to Neurobiology of Disease. The dataset includes analyses of endolysosomal trafficking and alpha-synuclein pathology in dopaminergic neurons and astrocytes differentiated from iPSCs generated from an individual with Parkinson's disease carrying the GBA1 pathogenic variant GBA1 c.115+1 G>A, also known as IVS2+1 G>A, and an unrelated sex- and age-matched healthy control. The dataset also includes transcriptomic analysis of GBA1 deficient iPSC-neurons and astrocytes compared to GBA1-wildtype iPSC-neurons and astrocytes. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-01-14T17:00:11.93Z","url":"https://data.mendeley.com/datasets/fgswr9ctcr","data_type":"dataset","access":"open","doi":["10.17632/fgswr9ctcr"],"contributors":[{"first_name":"Anna","last_name":"Park","orcid":null},{"first_name":"Sarah","last_name":"Fish","orcid":null},{"first_name":"Colby","last_name":"Samstag","orcid":null},{"first_name":"Minsuh","last_name":"Kim","orcid":null},{"first_name":"Jeremy","last_name":"Weiss","orcid":null},{"first_name":"Selina","last_name":"Yu","orcid":null},{"first_name":"Malia","last_name":"Callier","orcid":null},{"first_name":"Ella","last_name":"Chiu","orcid":null},{"first_name":"Joshua","last_name":"Weiss","orcid":null},{"first_name":"Christiane","last_name":"Hampe","orcid":"0000-0001-9111-6671"},{"first_name":"Raja","last_name":"Estes","orcid":"0000-0002-7427-101X"},{"first_name":"Bernice","last_name":"Lin","orcid":"0000-0002-3262-5043"},{"first_name":"Arnav","last_name":"Khera","orcid":"0009-0004-9790-2285"},{"first_name":"Dora","last_name":"Yearout","orcid":"0000-0002-0306-8356"},{"first_name":"Leo","last_name":"Pallanck","orcid":"0000-0002-5943-9339"},{"first_name":"Cyrus","last_name":"Zabetian","orcid":"0000-0002-7739-4306"},{"first_name":"Marie","last_name":"Davis","orcid":"0000-0003-2502-6293"}],"funders":[{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R01 NS119897-01"},{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R21 NS118476-01A1 "},{"id":"https://ror.org/05rsv9s98","name":"United States Department of Veterans Affairs","grant_id":"I01CX001702"},{"id":"https://ror.org/01tv7v957","name":"John H. Tietze Foundation Trust","grant_id":"2020 John H. Tietze Stem Cell Scientist Award"},{"id":"https://ror.org/05mx85j86","name":"Parkinson's Foundation","grant_id":"PF-CRA-1891"}],"categories":["Lysosome","Astrocyte","Endosome","Synuclein","Dopaminergic Neuron"],"journal_issn":[]},{"id":"8xhv88c7wt","title":"Genome-wide screening in human kidney organoids identifies developmental and disease-related aspects of nephrogenesis","description":"Human organoids allow the study of proliferation, lineage specification, and three-dimensional tissue development. Here, we present a genome-wide CRISPR screen in iPSC-derived kidney organoids. The combination of inducible genome editing, longitudinal sampling and endpoint sorting of tubular and stromal cells generated a complex, high-quality dataset uncovering a broad spectrum of insightful biology from early development to ‘adult’ epithelial morphogenesis. Our functional dataset allows improving mesoderm induction by ROCK inhibition, contains monogenetic and complex trait kidney disease genes, confirms two additional CAKUT genes (CCDC170 and MYH7B), and provides a large candidate list of ciliopathy-related genes. Finally, the identification of a cis-inhibitory effect of Jagged1 controlling epithelial proliferation shows how mosaic knockouts in pooled CRISPR screening can discover ways of communication between heterogeneous cell populations in complex tissues. Collectively, these data serve both as a rich resource for the kidney community and as a benchmark for future iPSC-derived organoid CRISPR screens.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-29T13:48:59.335Z","url":"https://data.mendeley.com/datasets/8xhv88c7wt","data_type":"dataset","access":"open","doi":["10.17632/8xhv88c7wt"],"contributors":[{"first_name":"Rosemarie","last_name":"Ungricht","orcid":null},{"first_name":"Philipp","last_name":"Hoppe","orcid":null}],"funders":[],"categories":["Screening","CRISPR"],"journal_issn":[]},{"id":"55zfpf5t73","title":"iPSC-derived ITGA6-positive cells restore aqueous humor outflow in glaucoma eyes","description":"Decreased trabecular meshwork (TM) cellularity, which is a critical pathological cause of primary open-angle glaucoma (POAG), lacks effective regenerative therapies. Here, we used multi-modal RNA sequencing to investigate regeneration mechanisms of induced pluripotent stem cell-derived TM cells (iPSC-TM). We identified a distinct iPSC-derived alpha6 integrin-positive (iPSC-ITGA6+) cell population with unique transcriptional signatures absent in primary TM cells. Particularly, iPSC-ITGA6+ cells demonstrated superior capacity to induce TM proliferation, restore aqueous humor outflow, and repopulate damaged ocular drainage tissues. Furthermore, we uncovered paraspeckle assembly as the key molecular mechanism enabling rejuvenation of endogenous cells, establishing a novel menRNA-based strategy for TM regeneration.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-10-14T14:22:18.034Z","url":"https://data.mendeley.com/datasets/55zfpf5t73","data_type":"dataset","access":"open","doi":["10.17632/55zfpf5t73"],"contributors":[{"first_name":"xiaoyan","last_name":"zhang","orcid":null}],"funders":[],"categories":["Regenerative Medicine"],"journal_issn":[]},{"id":"wztthm46fb","title":"Treatment Case Series of Dementia","description":"An effective hydrogen peroxide scavenger enhances cognitive function in cases of impairment in highly reactive astrocytes.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-09-26T03:06:21.271Z","url":"https://data.mendeley.com/datasets/wztthm46fb","data_type":"dataset","access":"open","doi":["10.17632/wztthm46fb"],"contributors":[{"first_name":"Jong hoon","last_name":"Lee","orcid":null}],"funders":[],"categories":["Myeloperoxidase","Dementia","Astrocyte","Hemolytic Anemia"],"journal_issn":[]}],"total_records":135039,"page":1,"page_size":10,"execution_time":126,"aggregations":{"data_type_stats":{"dataset":135039,"collection":0},"access_type_stats":{"open":134352,"restricted":67,"embargoed":620},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2265},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1330},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":652},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":474},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":440},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":416},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":403},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":382},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":323},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":269}