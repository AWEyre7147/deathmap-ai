{"records":[{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"4mb5kjywkj","title":"Western Blot raw data of the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\"","description":"The raw images of WB is for the reviewers' request when reviewing the manuscript titled \"In vivo CRISPR knockout screen identifies p47 as a suppressor for HER2+ breast cancer metastasis by regulating NEMO trafficking and autophagy flux\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-04T00:26:32.621Z","url":"https://data.mendeley.com/datasets/4mb5kjywkj","data_type":"dataset","access":"open","doi":["10.17632/4mb5kjywkj"],"contributors":[{"first_name":"Mingang","last_name":"Hao","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"hh46ymyxkk","title":"CRISPR amplicon sequencing of human TAP1 gene of CRISPR/Cas9-edited mono-allelic HLA class I-expressing cell lines","description":"TAP-deficient monoallelic HLA class I-expressing cell lines were generated by sequential transduction of the HLA-null human B cell line 721.221 with lentiviral expression constructs encoding (i) Cas9 protein linked to blasticidin resistance gene via a self-cleaving P2A peptide, (ii) 18 distinct HLA class I alleles that provided >99% global coverage (A*0101, A*0201, A*0301, A*2402, B*0702, B*0801, B*1402, B*1501, B*2705, B*3501, B*3901, B*4001, B*4402, B*5201, B*5701, B*5801, B*8101 and Cw*0701) under puromycin resistance linked via an internal ribosome entry sequence (IRES), and (iii) a single guide RNA (sgRNA) directed towards human TAP1 under neomycin/G418 resistance linked via an IRES. Successful CRISPR/Cas9 editing of the TAP1 gene was confirmed by amplicon sequencing of genomic DNA for each mono-allelic cell line. Amplicon sequencing was carried out by the MGH DNA Sequencing Core Facility. \n\n\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-29T06:17:42.059Z","url":"https://data.mendeley.com/datasets/hh46ymyxkk","data_type":"dataset","access":"open","doi":["10.17632/hh46ymyxkk"],"contributors":[{"first_name":"Anusha","last_name":"Nathan","orcid":null}],"funders":[],"categories":["Immunology","Vaccine","Human Immunodeficiency Virus","COVID-19"],"journal_issn":[]},{"id":"nnxh5d35nd","title":"Genome-wide CRISPR-Cas9 screen identified KLF11 as a druggable suppressor for sarcoma cancer stem cells","description":"The original, unprocessed data alongside the paper","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-05-31T01:39:45.722Z","url":"https://data.mendeley.com/datasets/nnxh5d35nd","data_type":"dataset","access":"open","doi":["10.17632/nnxh5d35nd"],"contributors":[{"first_name":"Le","last_name":"Qu","orcid":null}],"funders":[],"categories":["Cancer"],"journal_issn":[]},{"id":"r79ngfdb56","title":"High-throughput sequencing of Precise CRISPR/Cas9-targeted Recessive Dystrophic Epidermolysis Bullosa immortalised keratinocytes (Ion Torrent)","description":"In this study, the COL7A1 on-target (exon 73) was analysed for precise CRISPR/Cas9 activity. \nNGS data was assessed in CRISPR/Cas9-treated immortalised patient keratinocytes\nDespite high on-target activity, high homgeneity of DSB repair outcomes was observed at the nuclease target site. This should result in efficient reframing of the gene, with minimal divergence from the wild-type sequence.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-09-20T10:54:06.313Z","url":"https://data.mendeley.com/datasets/r79ngfdb56","data_type":"dataset","access":"open","doi":["10.17632/r79ngfdb56"],"contributors":[{"first_name":"Oliver","last_name":"March","orcid":null}],"funders":[],"categories":["Next Generation Sequencing"],"journal_issn":[]},{"id":"fm4h3mphcr","title":"NGS, confocal microscopy and flow cytometry data of CRISPR/Cas9-edited ARE1 and KAT2 genes in transgenic maize in vitro tissues exposed to chromatin modifiers","description":"This dataset contains raw NGS reads (NGS_data folder), fluorescence microscopy photos (Fig7B Microscopy Originals.lif) and flow cytometry data (@Fig6 FACS original data.zip) derived from transgenic maize (Zea mays L.) in vitro tissues exposed to chromatin modifiers. They are presented in research article ˝Variable Alterations in Frequencies of CRISPR/Cas9-Induced Nucleotide Deletion and Insertion in Transgenic Maize Callus Tissues Exposed to Chromatin Modifiers˝.\nStable transgenic maize lines harboring active CRISPR/Cas9 vector systems targeting either the abnormal cytokinin response 1 (ARE1) gene or the potassium channel gene (KAT2) were used. Mutagenic events following exposure to elevated temperatures (37 °C for 48 h) and various chromatin-modifying compounds were quantified. As a novel approach, the mutagenic potential of combining chromatin-modifying agents with heat exposure was examined.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-09-24T23:17:12.229Z","url":"https://data.mendeley.com/datasets/fm4h3mphcr","data_type":"dataset","access":"open","doi":["10.17632/fm4h3mphcr"],"contributors":[{"first_name":"Bettina","last_name":"Nagy","orcid":null},{"first_name":"Györgyi","last_name":"Ferenc","orcid":null},{"first_name":"Ferhan","last_name":"Ayaydin","orcid":"0000-0003-4450-0667"},{"first_name":"Divya","last_name":"Teja","orcid":"0009-0001-0210-7878"},{"first_name":"Dénes","last_name":"Dudits","orcid":null},{"first_name":"Zoltán","last_name":"Zombori","orcid":null},{"first_name":"Nikolett","last_name":"Laszlo","orcid":null},{"first_name":"Aysha","last_name":"Jameel","orcid":null},{"first_name":"Gábor","last_name":"Horváth","orcid":null}],"funders":[{"id":null,"name":"EU’s Horizon 2020 Research and Innovation Program","grant_id":" 739593"},{"id":"https://ror.org/03g2am276","name":"National Research, Development and Innovation Office","grant_id":"RRF 2.3.1–21-2022- 00007 grant for the ‘National Laboratory Program of Agrobiotechnology and Precision Plant Breeding to Support Food Safety’"}],"categories":["Confocal Microscopy","Flow Cytometry","Next Generation Sequencing"],"journal_issn":[]},{"id":"cszpw4c66t","title":"Structural insights into Cas9-mediated prespacer selection in CRISPR-Cas adaptation. Gaizauskaite et al.","description":"During CRISPR-Cas adaptation, prokaryotic cells become immunized by the insertion of foreign DNA fragments, termed spacers, into the host genome to serve as templates for RNA-guided immunity. Spacer acquisition relies on the Cas1-Cas2 integrase and accessory proteins, which select DNA sequences flanked by the protospacer adjacent motif (PAM) and insert them into the CRISPR array. It has been shown that in type II-A systems selection of PAM-proximal prespacers is mediated by the effector nuclease Cas9, which forms a ‘supercomplex’ with the Cas1-Cas2 integrase and the Csn2 protein. Here, we present cryo-electron microscopy structures of the type II-A prespacer selection supercomplex in the DNA-scanning and two distinct PAM-bound configurations, providing insights into the mechanism of Cas9-mediated prespacer selection in type II-A CRISPR-Cas systems. Repurposing of Cas9 by the CRISPR adaptation machinery for prespacer selection characterized here demonstrates Cas9 plasticity and expands our knowledge of the Cas9 biology.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-02-20T09:45:34.481Z","url":"https://data.mendeley.com/datasets/cszpw4c66t","data_type":"dataset","access":"open","doi":["10.17632/cszpw4c66t"],"contributors":[{"first_name":"Ugne","last_name":"Gaizauskaite","orcid":"0009-0008-9137-5428"},{"first_name":"Giedre","last_name":"Tamulaitiene","orcid":"0000-0002-9794-3544"},{"first_name":"Arunas","last_name":"Silanskas","orcid":"0000-0002-6385-6928"},{"first_name":"Giedrius","last_name":"Gasiunas","orcid":"0000-0003-2509-9054"},{"first_name":"Virginijus","last_name":"Siksnys","orcid":"0000-0003-1983-2096"},{"first_name":"Giedrius","last_name":"Sasnauskas","orcid":"0000-0002-3185-2682"}],"funders":[{"id":"https://ror.org/02gs16m83","name":"Lietuvos Mokslo Taryba","grant_id":"S-MIP-19-32"}],"categories":["Biochemistry"],"journal_issn":[]},{"id":"xvk2gk4hw3","title":"Data of Murine Trophoblast Organoids as a Model for Trophoblast Development and CRISPR/Cas9 Screening","description":"Raw data for figures in Murine Trophoblast Organoids as a Model for Trophoblast Development and CRISPR/Cas9 Screening","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-25T15:27:04.321Z","url":"https://data.mendeley.com/datasets/xvk2gk4hw3","data_type":"dataset","access":"open","doi":["10.17632/xvk2gk4hw3"],"contributors":[{"first_name":"Qian","last_name":"Mao","orcid":null}],"funders":[],"categories":["Developmental Biology"],"journal_issn":[]},{"id":"4g722x4jfg","title":"Western blot","description":"Western blot of CRISPR-Cas9-mediated nontargeting (NT) versus BACH2 knockout 3 days after CRISPR-Cas9-gRNA nucleofection of human gut cells.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-07-02T21:20:55.966Z","url":"https://data.mendeley.com/datasets/4g722x4jfg","data_type":"dataset","access":"open","doi":["10.17632/4g722x4jfg"],"contributors":[{"first_name":"Yulong","last_name":"Wei","orcid":null}],"funders":[],"categories":["Gut","Western Blot","T Cell","CRISPR/Cas9"],"journal_issn":[]}],"total_records":87620,"page":1,"page_size":10,"execution_time":106,"aggregations":{"data_type_stats":{"dataset":87620,"collection":0},"access_type_stats":{"open":87370,"restricted":49,"embargoed":201},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":1446},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":436},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":345},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":322},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":307},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":294},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":269},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":224},{"id":"https://ror.org/00k4n6c32","name":"European Commission","count":171},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":166}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":85368},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1725},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":145},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":81},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":57},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":53},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":46},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":25},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":25},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":24}],"top_institutions_stats":[{"id":"0ad97c43-5173-56e6-bbe6-46dad