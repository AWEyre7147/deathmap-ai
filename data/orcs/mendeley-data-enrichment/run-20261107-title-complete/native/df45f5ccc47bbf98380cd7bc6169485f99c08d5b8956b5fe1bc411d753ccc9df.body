{"records":[{"id":"6phjx8s467","title":"Data for: Enhanced antitumor effects of CD123/CD33 dual-antibody modified liposome targeting to acute myeloid leukemia cells with reduced the antigen-negative escape","description":"A dual-targeting drug delivery system was  developoed to enhance the therapeutic efficacy of chemotherapeutics and reduce the antigen-negative escape for Acute myeloid leukemia. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-07-18T23:35:51.324Z","url":"https://data.mendeley.com/datasets/6phjx8s467","data_type":"dataset","access":"open","doi":["10.17632/6phjx8s467"],"contributors":[{"first_name":"ShengJun","last_name":"Mao","orcid":null}],"funders":[],"categories":["Drug Delivery","Pharmaceutics","Acute Leukemia"],"journal_issn":["03785173"]},{"id":"rm8kjxkkjv","title":"Original blots","description":"Original blots related to \"SUCLG1 Deficiency-Induced Histone Succinylation Impairs Oncogene Expression in Acute Myeloid Leukemia\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-07-24T16:04:21.305Z","url":"https://data.mendeley.com/datasets/rm8kjxkkjv","data_type":"dataset","access":"open","doi":["10.17632/rm8kjxkkjv"],"contributors":[{"first_name":"Mengqing","last_name":"Gao","orcid":null}],"funders":[],"categories":["Acute Myelogenous Leukemia","Histone Modification"],"journal_issn":[]},{"id":"rdkg26mfjw","title":"CD37 a safe Chimeric Antigen Receptor target to treat acute myeloid leukemia","description":"CD37 a safe Chimeric Antigen Receptor target to treat acute myeloid leukemia - Raw data","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-04-19T10:40:12.702Z","url":"https://data.mendeley.com/datasets/rdkg26mfjw","data_type":"dataset","access":"open","doi":["10.17632/rdkg26mfjw"],"contributors":[{"first_name":"Sandy","last_name":"Joaquina","orcid":null}],"funders":[],"categories":["Data Access"],"journal_issn":[]},{"id":"hx4nwr8yyd","title":"Data for: Therapy-related acute myeloid leukemia developing 14 years after allogeneic stem cell transplantation, from a persistent R882H-DNMT3A mutated clone of patient origin.","description":"Supplementary (DOCX  2.34MB): \nMaterials and methods. \nFig. S1. TP53 mutation found in the lung carcinoma cells taken from the patient in 2012. \nFig. S2. Karyotype illustrating the metaphases of the 2015 therapy-related myelodysplastic syndrome cells. \nFig. S3. Paint of chromosome 15 (green) by fluorescent in situ hybridization. \nFig. S4. Analysis of the chimerism (Mentype® Chimera® software, Biotype) at 2015 therapy-related acute myeloid leukemia diagnosis. \nFig. S5. IDH1, DNMT3A and NPM1 mutations found at the time of the acute myeloid leukemia diagnosis in 2001. \nFig. S6. DNMT3A and TP53 mutations found at the time of the therapy-related acute myeloid leukemia diagnosis in 2015. \nFig. S7. Standard curve for the ASO-qPCR. \nFig. S8. Sensitivity assay for quantitative ASO-qPCR. \n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-07-18T12:28:12.179Z","url":"https://data.mendeley.com/datasets/hx4nwr8yyd","data_type":"dataset","access":"open","doi":["10.17632/hx4nwr8yyd"],"contributors":[{"first_name":"Iván","last_name":"Martín","orcid":null},{"first_name":"Felipe J","last_name":"Chaves","orcid":null},{"first_name":"Rosario","last_name":"Abellán","orcid":null},{"first_name":"Francisca","last_name":"García","orcid":null},{"first_name":"Mar","last_name":"Tormo","orcid":null},{"first_name":"Carlos","last_name":"Solano","orcid":null},{"first_name":"Juan-Carlos","last_name":"Hernandez-Boluda","orcid":null},{"first_name":"María Dolores","last_name":"Olivares","orcid":null},{"first_name":"Eva","last_name":"Villamón","orcid":null},{"first_name":"Fernando","last_name":"Domingo","orcid":null},{"first_name":"Blanca","last_name":"Navarro","orcid":null},{"first_name":"Marisa","last_name":"Calabuig","orcid":null},{"first_name":"Paula","last_name":"Amat","orcid":null},{"first_name":"Alicia","last_name":"Serrano","orcid":null}],"funders":[],"categories":["Molecular Biology","Cytogenetics"],"journal_issn":["00144800"]},{"id":"2gpjp3mbs6","title":"SETDB1 suppresses NK cell-mediated immunosurveillance in acute myeloid leukemia with granulo-monocytic differentiation","description":"The data include full immunoblot images for \"SETDB1 suppresses NK cell-mediated immunosurveillance in acute myeloid leukemia with granulo-monocytic differentiation\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-05-15T07:05:55.464Z","url":"https://data.mendeley.com/datasets/2gpjp3mbs6","data_type":"dataset","access":"open","doi":["10.17632/2gpjp3mbs6"],"contributors":[{"first_name":"Yu-Hsuan","last_name":"Chang","orcid":null}],"funders":[],"categories":["Hematology","Leukemia","Western Blot","Epigenetics"],"journal_issn":[]},{"id":"48s882jvnr","title":"Case report-CARE Checklist","description":"Care checklist for case report-Metachronous Presentation of BCL2-Positive Lung Adenocarcinoma and Acute Myeloid Leukemia: a case presentation and review of the literature","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-04-28T08:34:58.817Z","url":"https://data.mendeley.com/datasets/48s882jvnr","data_type":"dataset","access":"open","doi":["10.17632/48s882jvnr"],"contributors":[{"first_name":"Bo","last_name":"Zheng","orcid":null}],"funders":[],"categories":["Data Access"],"journal_issn":[]},{"id":"3df2cj3v9z","title":"AMI-M1","description":"AML-M1 (Acute Myeloid Leukemia, French-American-British Classification M1)\nDefinition:\nAML-M1 is a subtype of acute myeloid leukemia characterized by a proliferation of myeloblasts (immature white blood cells) with minimal maturation. It is classified under the FAB (French-American-British) system as M1, which means “without maturation.”\n\nKey Features:\n\nBone marrow and blood contain ≥ 20% myeloblasts with minimal differentiation into mature cells.\n\nMyeloblasts typically lack significant granulocytic maturation beyond the blast stage.\n\nCommon markers: CD13, CD33 are usually positive, HLA-DR often positive.\n\nClinical symptoms: fatigue, anemia, infections, bleeding tendencies due to bone marrow failure.\n\nDiagnosis:\n\nBone marrow biopsy showing ≥ 20% myeloblasts.\n\nImmunophenotyping showing expression of myeloid markers such as CD13, CD33.\n\nCytogenetic and molecular testing to identify mutations (e.g., FLT3, NPM1) that guide prognosis and treatment.\n\nTreatment:\n\nTypically involves intensive chemotherapy aimed at inducing remission.\n\nMay include consolidation chemotherapy and hematopoietic stem cell transplantation in eligible patients.\n\nPrognosis:\n\nPrognosis depends on various factors including genetic mutations, patient age, and response to treatment.\n\nAML-M1 has a variable prognosis; patients with favorable mutations have better outcomes.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-07-07T17:10:45.234Z","url":"https://data.mendeley.com/datasets/3df2cj3v9z","data_type":"dataset","access":"open","doi":["10.17632/3df2cj3v9z"],"contributors":[{"first_name":"Eldirdiri Fadol Ibrahim","last_name":"Ibrahim","orcid":null}],"funders":[],"categories":["Hematological Cancer","Chemical Treatment","Science, Technology, Engineering and Mathematics"],"journal_issn":[]},{"id":"vwx3b7h7f9","title":"LEUKEMIA IN ERYTHROID BLAST CRISIS AND AUTOIMMUNE HEMOLYTIC ANEMIA: A CASE REPORT","description":"Introduction: Chronic myeloid leukemia is a chronic myeloproliferative neoplasm characterized by the uncontrolled proliferation of myeloid precursors and autoimmune hemolytic anemia is an unregulated immune reaction towards the antigens themselves that are on the surface of the membrane of red blood cells. The combination of these diseases is extremely rare and even greater when chronic myeloid leukemia is in an erythroid blast crisis.\n\nObjective: To describe a case with the coexistence of chronic myeloid leukemia in erythroid blast crisis and autoimmune hemolytic anemia.\n\nClinical case: Patient with a history of chronic myeloid leukemia who presents an erythroid blast crisis and develops autoimmune hemolytic anemia due to warm IgG antibodies. The treatment for both diseases will be administered. After a clinical improvement of the autoimmune hemolytic anemia, he maintained the erythroid blast crisis and was administered an intensive chemotherapy regimen where complications occurred and he died.\n\nConclusions:\n\nThe treatment with steroids in autoimmune hemolytic anemia in patients with chronic myeloid leukemia is effective when they are in the chronic phase of the disease, but is little responsive when they are in blast crisis, as was the case we present, and the fatal outcome in the patient was multifactorial.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-05-31T06:11:11.436Z","url":"https://data.mendeley.com/datasets/vwx3b7h7f9","data_type":"dataset","access":"open","doi":["10.17632/vwx3b7h7f9"],"contributors":[{"first_name":"Yamilé Quintero ","last_name":"Sierra ","orcid":"0000-0002-6872-4326"},{"first_name":"Carlos Hernández  ","last_name":"Padrón","orcid":"0000-0002-7625-1864"},{"first_name":"Yusleidy Concepción ","last_name":"Fernández ","orcid":"0000-0003-1916-2336"},{"first_name":"Adrián Romero ","last_name":"González ","orcid":"0000-0002-5029-9616"}],"funders":[],"categories":["Health Profession","Blood Biochemistry","Medical Biology","Health","Medical Student Education"],"journal_issn":[]},{"id":"55v76yw529","title":"Deubiquitinases: Pro-oncogenic Activity and Therapeutic Targeting in Acute Leukemia","description":"Dysregulation of kinase signaling pathways via mutations favors tumor cell survival and resistance to therapy and it is common in cancer. In our work we reveal a novel mechanism of posttranslational regulation of kinase signaling and nuclear receptor activity via deubiquitination in acute leukemia. We observed that the ubiquitin specific protease 7 (USP7) forms a complex with USP11 to deubiquitinate oncogenic lymphocyte cell-specific protein tyrosine kinase (LCK). Deubiquitination of LCK controls its activity, thereby altering T cell receptor signaling. Impairment of LCK activity leads to increased expression of the glucocorticoid receptor (GR) transcript, culminating into transcriptional activation of pro-apoptotic target genes and sensitizes cells to glucocorticoids in primary T cell acute lymphoblastic leukemia (T-ALL) patient samples. The transcriptional activation of pro-apoptotic target genes, such as BCL2L11, is orchestrated by the deubiquitinase activity and mediated via an increase in enhancer-promoter interaction intensity. Our data unveil how dysregulated deubiquitination controls signaling pathways, leading to cancer cell survival and drug non-response, and suggest novel therapeutic combinations towards targeting leukemia.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-16T20:51:22.317Z","url":"https://data.mendeley.com/datasets/55v76yw529","data_type":"dataset","access":"open","doi":["10.17632/55v76yw529"],"contributors":[{"first_name":"Blanca","last_name":"Gutierrez","orcid":null}],"funders":[],"categories":["Biochemistry","Protein-Tyrosine Kinase","Ubiquitylation","Acute Leukemia"],"journal_issn":[]},{"id":"fz7d6x4bwx","title":"Artificial Intelligence Reveals the Predictions of Hematological Indexes in Children with Acute Leukemia","description":"Childhood leukemia is a prevalent form of pediatric cancer, with acute lymphoblastic leukemia (ALL) and acute myeloid leukemia (AML) being the primary manifestations. Timely treatment has significantly enhanced survival rates for children with acute leukemia. This study aimed to develop an early and comprehensive predictor for hematologic malignancies in children by examining nutritional markers, key leukemia indicators, and granulocytes in patients' blood. Using a machine learning algorithm and ten indices, 826 pediatric patients with ALL and 255 children with AML were analyzed, comparing them with a control group of 200 healthy children. The study revealed notable differences, including higher indicators in boys compared to girls and significant variations in most biochemical indicators between leukemia patients and healthy children. Employing a random forest model resulted in an Area Under the Curve (AUC) of 0.950 for predicting leukemia subtypes and an AUC of 0.909 for forecasting AML. This research introduces an efficient diagnostic tool for early screening of childhood blood cancers and underscores the potential of artificial intelligence in modern healthcare.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-02-11T03:29:59.307Z","url":"https://data.mendeley.com/datasets/fz7d6x4bwx","data_type":"dataset","access":"open","doi":["10.17632/fz7d6x4bwx"],"contributors":[{"first_name":"Haiyang","last_name":"Li","orcid":null}],"funders":[],"categories":["Coding in Methodology"],"journal_issn":[]}],"total_records":81389,"page":1,"page_size":10,"execution_time":88,"aggregations":{"data_type_stats":{"dataset":81389,"collection":0},"access_type_stats":{"open":81251,"restricted":43,"embargoed":95},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":1349},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":410},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":340},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":296},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":291},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":290},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":250},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":242},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":164},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":155}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":79421},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1478},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":149},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":82},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":48},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":45},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":28},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":27},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":25},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":24}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":369},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":356},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":344},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":206},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":187}]}}