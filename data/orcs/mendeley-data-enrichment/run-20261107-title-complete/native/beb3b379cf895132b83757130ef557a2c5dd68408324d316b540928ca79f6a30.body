{"records":[{"id":"vtvxykv2cr","title":"2020_Cell reports resubmission tables","description":"All tables associated with our paper titled \"High throughput CRISPR screening identifies genes involved in macrophage viability and inflammatory pathways\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-12-15T08:44:50.23Z","url":"https://data.mendeley.com/datasets/vtvxykv2cr","data_type":"dataset","access":"open","doi":["10.17632/vtvxykv2cr"],"contributors":[{"first_name":"Susan","last_name":"Carpenter","orcid":null}],"funders":[],"categories":["Macrophage","Immunity","Innate Immunity","Screening","Pooled Analysis","CRISPR"],"journal_issn":[]},{"id":"8xhv88c7wt","title":"Genome-wide screening in human kidney organoids identifies developmental and disease-related aspects of nephrogenesis","description":"Human organoids allow the study of proliferation, lineage specification, and three-dimensional tissue development. Here, we present a genome-wide CRISPR screen in iPSC-derived kidney organoids. The combination of inducible genome editing, longitudinal sampling and endpoint sorting of tubular and stromal cells generated a complex, high-quality dataset uncovering a broad spectrum of insightful biology from early development to ‘adult’ epithelial morphogenesis. Our functional dataset allows improving mesoderm induction by ROCK inhibition, contains monogenetic and complex trait kidney disease genes, confirms two additional CAKUT genes (CCDC170 and MYH7B), and provides a large candidate list of ciliopathy-related genes. Finally, the identification of a cis-inhibitory effect of Jagged1 controlling epithelial proliferation shows how mosaic knockouts in pooled CRISPR screening can discover ways of communication between heterogeneous cell populations in complex tissues. Collectively, these data serve both as a rich resource for the kidney community and as a benchmark for future iPSC-derived organoid CRISPR screens.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-29T13:48:59.335Z","url":"https://data.mendeley.com/datasets/8xhv88c7wt","data_type":"dataset","access":"open","doi":["10.17632/8xhv88c7wt"],"contributors":[{"first_name":"Rosemarie","last_name":"Ungricht","orcid":null},{"first_name":"Philipp","last_name":"Hoppe","orcid":null}],"funders":[],"categories":["Screening","CRISPR"],"journal_issn":[]},{"id":"9x47wzy8x7","title":"A study of \"Genome-wide CRISPR screens reveal host factors critical for SARS-CoV-2 infection\" by Wei et al. Cell 2020","description":"Identification of host genes essential for SARS-CoV-2 infection may reveal novel therapeutic targets and inform our understanding of COVID-19 pathogenesis. Here, we performed genome-wide CRISPR screens in Vero-E6 cells with SARS-CoV-2, MERS-CoV, bat coronavirus HKU5 expressing the SARS-CoV-1 spike, and VSV expressing the SARS-CoV-2 spike. Together this identifies potential therapeutic targets for SARS-CoV-2 and reveals SARS-lineage specific and pan-coronavirus host factors that regulate susceptibility to highly pathogenic coronaviruses.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-15T21:29:14.06Z","url":"https://data.mendeley.com/datasets/9x47wzy8x7","data_type":"dataset","access":"open","doi":["10.17632/9x47wzy8x7"],"contributors":[{"first_name":"Craig","last_name":"Wilen","orcid":null}],"funders":[],"categories":["CRISPR","Middle East Respiratory Syndrome-Related Coronavirus","Severe Acute Respiratory Syndrome Coronavirus 2","COVID-19"],"journal_issn":[]},{"id":"cg2w69gpdf","title":"Machine Learning-Optimized Metabolic Biomarker Panel for Precision Screening of Early-Stage Pancreatic Cancer in New-Onset Diabetes","description":"Machine Learning-Optimized Metabolic Biomarker Panel for Precision Screening of Early-Stage Pancreatic Cancer in New-Onset DiabetesMachine Learning-Optimized Metabolic Biomarker Panel for PrecisionMachine Learning-Optimized Metabolic Biomarker Panel for Precision Screening of Early-Stage Pancreatic Cancer in New-Onset Diabetes Screening of Early-Stage Pancreatic Cancer in New-Machine Learning-Optimized Metabolic Biomarker Panel for Precision Screening of Early-Stage Pancreatic Cancer in New-Onset DiabetesOnset DiabetesMachine Learning-Optimized Metabolic Biomarker Panel for Precision Screening of Early-Stage Pancreatic Cancer in New-Onset Diabetes","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-11-25T09:47:07.381Z","url":"https://data.mendeley.com/datasets/cg2w69gpdf","data_type":"dataset","access":"open","doi":["10.17632/cg2w69gpdf"],"contributors":[{"first_name":"Zhiyuan","last_name":"Cheng","orcid":null}],"funders":[],"categories":["Cancer Diagnosis"],"journal_issn":[]},{"id":"z4n3sbszgb","title":"Supplementary Data for \"Population structure of multidrug resistant Klebsiella oxytoca within the UK and Ireland identifies sharing of virulence and resistance genes with K. pneumoniae\"","description":"Supplemental Data for \"Population structure of multidrug resistant Klebsiella oxytoca within the UK and Ireland identifies sharing of virulence and resistance genes with K. pneumoniae\"\n\nDanesh Moradigaravand, Veronique Martin, Sharon J. Peacock and Julian Parkhill\n\n1- Multi-fasta files of genes in pan-genome\n2- Metadata of genes in pan-genome ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2016-08-25T11:27:46.652Z","url":"https://data.mendeley.com/datasets/z4n3sbszgb","data_type":"dataset","access":"open","doi":["10.17632/z4n3sbszgb"],"contributors":[{"first_name":"Danesh","last_name":"Moradigaravand","orcid":null}],"funders":[],"categories":["Bioinformatics","Medical Genomics"],"journal_issn":[]},{"id":"kczfm6pjw2","title":"Repositioning mifepristone as leukaemia inhibitory factor receptor antagonist for the treatment of pancreatic adenocarcinoma ","description":"Pancreatic cancer is leading cause of cancer mortality and is projected to become the second cause of cancer mortality in the next decade. While gene wide association studies and next generation sequencing analyses have identified molecular patterns and transcriptome profiles with prognostic relevance, therapeutic opportunities remain limited. Among the genes that were upregulated in pancreatic ductal adenocarcinomas (PDAC) the leukaemia inhibitory factor (LIF) has emerged as potential therapeutic candidate. Since there are no LIFR antagonists available for clinical use, we have developed an in-silico strategy to identify potential LIFR antagonists and drug reposition as LIFR antagonists. The results of these studies allowed the identification of mifepristone, a progesterone/glucocorticoid antagonist, clinical used in medical abortion, as potent LIFR antagonist.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-09-08T15:05:36.8Z","url":"https://data.mendeley.com/datasets/kczfm6pjw2","data_type":"dataset","access":"open","doi":["10.17632/kczfm6pjw2"],"contributors":[{"first_name":"Cristina","last_name":"Di Giorgio","orcid":null},{"first_name":"silvia","last_name":"marchianò","orcid":null},{"first_name":"Michele","last_name":"Biagioli","orcid":null},{"first_name":"Stefano","last_name":"Fiorucci","orcid":null}],"funders":[],"categories":["Gene Expression Profiling"],"journal_issn":[]},{"id":"pm5v6pwkkg","title":"Genome-wide screens implicate loss of cullin ring ligase 3 in persistent proliferation and genome instability in TP53 deficient cells","description":"TP53 deficiency is the most common alteration in cancer, however, alone is typically insufficient to drive tumorigenesis. To identify genes promoting tumorigenesis in combination with TP53 deficiency, we performed genome-wide CRISPR/Cas9 knockout screens coupled with proliferation and transformation assays in isogenic cell lines. Loss of several known tumor suppressor genes enhanced cellular proliferation and transformation. Surprisingly, loss neddylation pathway genes, promoted uncontrolled proliferation exclusively in TP53-deficient cells. CUL3 coupled with TP53 loss results in an oncogenic transcriptional program governed by the NFκB, AP-1 and TGF-β pathways. This program maintains persistent cellular proliferation, induces partial epithelial to mesenchymal transition, increases DNA damage, genomic instability, and the rate chromosomal rearrangements. Our findings reveal CUL3 loss as a key event stimulating persistent proliferation in TP53 deficient cells. These findings may be clinically relevant, since TP53-CUL3 deficient cells are highly sensitive to ATM inhibition, exposing a vulnerability that could be exploited for cancer treatment. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-11-06T17:31:10.704Z","url":"https://data.mendeley.com/datasets/pm5v6pwkkg","data_type":"dataset","access":"open","doi":["10.17632/pm5v6pwkkg"],"contributors":[{"first_name":"Alexandros","last_name":"Drainas","orcid":null}],"funders":[],"categories":["Western Blot","Cellular Imaging"],"journal_issn":[]},{"id":"czfx2rbb86","title":"Comet x 19058M","description":"Filtered GBS data from a bi-parental mapping population between the hop powdery mildew resistant cultivar 'Comet' and susceptible USDA male line \"64035M\". Illumina based sequencing on a Nextseq 2000 using 150-bp sequence length was used to generate 1.3 x 10^6 SNP markers. All offspring were screened in the greenhouse for susceptibility levels to powdery mildew. Genome-wide analysis using MLM as well as QTL analyses identified one 6-Mb region on Chromosome 6 (position 308 - 314 Mb) with significant association to powdery mildew resistance. This region contains multiple clusters of resistance genes, stress response genes and other disease resistance related genes that may provide the polygenic resistance to powdery mildew.   ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-09T05:42:01.916Z","url":"https://data.mendeley.com/datasets/czfx2rbb86","data_type":"dataset","access":"open","doi":["10.17632/czfx2rbb86"],"contributors":[{"first_name":"John","last_name":"Henning","orcid":null},{"first_name":"David","last_name":"Hendrix","orcid":null},{"first_name":"David","last_name":"Gent","orcid":null},{"first_name":"Michele","last_name":"Wiseman","orcid":null},{"first_name":"Lillian","last_name":"Padgitt-cobb","orcid":null}],"funders":[],"categories":["Genomics","Quantitative Trait Locus","Plant Disease Resistance","Hops (Field Crops)"],"journal_issn":[]},{"id":"9w4g54bv43","title":"Genome-wide screens reveal that resveratrol induces replicative stress in human cells","description":"Resveratrol is a natural product associated with wide-ranging effects in animal and cellular models including lifespan extension. To identify the genetic target of resveratrol in human cells, we conducted genome-wide CRISPR-Cas9 screens to pinpoint genes that confer sensitivity or resistance to resveratrol. An extensive network of DNA damage response and replicative stress genes exhibited genetic interactions with resveratrol and its analog pterostilbene. These genetic profiles showed similarity to the response to hydroxyurea, an inhibitor of ribonucleotide reductase that causes replicative stress. Resveratrol, pterostilbene and hydroxyurea caused similar depletion of nucleotide pools, inhibition of replication fork progression and induction of replicative stress. The ability of resveratrol to inhibit cell proliferation and S phase transit was independent of the histone deacetylase Sirtuin 1, which has been implicated in lifespan extension by resveratrol. These results establish that a primary impact of resveratrol on human cell proliferation is the induction of low-level replicative stress.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-04T14:56:19.488Z","url":"https://data.mendeley.com/datasets/9w4g54bv43","data_type":"dataset","access":"open","doi":["10.17632/9w4g54bv43"],"contributors":[{"first_name":"Yahya","last_name":"Benslimane","orcid":null},{"first_name":"Thierry","last_name":"Bertomeu","orcid":null},{"first_name":"Jasmin","last_name":"Coulombe-Huntington","orcid":null},{"first_name":"Mary","last_name":"McQuaid","orcid":null},{"first_name":"María","last_name":"Sánchez-Osuna","orcid":null},{"first_name":"David","last_name":"Papadopoli","orcid":null},{"first_name":"Daina","last_name":"Avizonis","orcid":null},{"first_name":"Mariana","last_name":"De Sa Tavares Russo","orcid":null},{"first_name":"Caroline","last_name":"Huard","orcid":null},{"first_name":"Ivan","last_name":"Topisirovic","orcid":null},{"first_name":"Hugo","last_name":"Wurtele","orcid":null},{"first_name":"Mike","last_name":"Tyers","orcid":null},{"first_name":"Lea","last_name":"Harrington","orcid":null}],"funders":[],"categories":["DNA Replication","High-Throughput Screening","High-Throughput Sequencing"],"journal_issn":[]},{"id":"2rrn8ngvsz","title":"Tumor-Associated Schwann Cell Remodeling under Metabolic Stress via Lactate Sensing Orchestrates","description":"Diabetes mellitus (DM) is a known risk factor for pancreatic cancer, but the underlying mechanisms remain elusive. Using in vivo models of diabetes-driven pancreatic tumorigenesis and metabolomics analysis, we demonstrate that metabolic stress induced by DM promotes pancreatic cancer progression by remodeling tumor-associated Schwann cells (TASs), impairing CD8+ T cell function. We discover that Mettl16+ Cd276+ Nectin2+ Schwann cells play a crucial role in mediating the pro-carcinogenic effects of lactate. Remodeled METTL16+ Schwann cells secret immune evasion factors (CD276, NECTIN2), contributing to anti-PD1 resistance. Furthermore, rosuvastatin was identified in this study as a novel METTL16 inhibitor for pancreatic cancer under metabolic stress. In conclusion, our study underscores the critical role of lactate in the metabolic reprogramming of pancreatic cancer mediated by Schwann cell remodeling, revealing novel pathways for therapeutic intervention.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-10-01T10:24:44.344Z","url":"https://data.mendeley.com/datasets/2rrn8ngvsz","data_type":"dataset","access":"open","doi":["10.17632/2rrn8ngvsz"],"contributors":[{"first_name":"Baiyong","last_name":"Shen","orcid":null}],"funders":[],"categories":["Tumor","Metabolism"],"journal_issn":[]}],"total_records":136311,"page":1,"page_size":10,"execution_time":115,"aggregations":{"data_type_stats":{"dataset":136311,"collection":0},"access_type_stats":{"open":135555,"restricted":69,"embargoed":687},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2275},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":695},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":472},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":438},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":425},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":415},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":399},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":336},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":273},{"id":"https://ror.org/05r0vyz12","name":"Ministerio de Ciencia, Innovación y Universidades","count":231}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":133667},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1906},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":187},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":137},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":76},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":57},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":37},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":32},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":27}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":525},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":408},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":361},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":359},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":316}]}}