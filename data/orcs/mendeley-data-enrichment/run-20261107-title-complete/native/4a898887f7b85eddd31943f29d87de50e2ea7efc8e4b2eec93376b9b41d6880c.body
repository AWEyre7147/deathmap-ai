{"records":[{"id":"n4jc4pj7hs","title":"LINF_010008400","description":"Mitochondrial pyruvate carrier","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-12T14:30:24.296Z","url":"https://data.mendeley.com/datasets/n4jc4pj7hs","data_type":"dataset","access":"open","doi":["10.17632/n4jc4pj7hs"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein"],"journal_issn":[]},{"id":"7cy8ktcr6m","title":"LDHU3_01.0380","description":"Mitochondrial pyruvate carrier | MPC1; Leishmania donovani","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-31T16:56:40.618Z","url":"https://data.mendeley.com/datasets/7cy8ktcr6m","data_type":"dataset","access":"open","doi":["10.17632/7cy8ktcr6m"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null},{"first_name":"Esther","last_name":"Camacho","orcid":null},{"first_name":"Jose C.","last_name":"Solana","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"txvdm8pbwf","title":"LDHU3_14.1940","description":"Mitochondrial pyruvate carrier protein 2 | MPC2; Leishmania donovani (HU3 strain)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-07-08T16:34:22.702Z","url":"https://data.mendeley.com/datasets/txvdm8pbwf","data_type":"dataset","access":"open","doi":["10.17632/txvdm8pbwf"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","grant_id":"PID2020-117916RB-I00/AEI/10.13039/501100011033"}],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"2995xcfspv","title":"LINF_140021100","description":"Mitochondrial pyruvate carrier protein 2 | MPC2; Leishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-04-28T07:54:48.656Z","url":"https://data.mendeley.com/datasets/2995xcfspv","data_type":"dataset","access":"open","doi":["10.17632/2995xcfspv"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","grant_id":"PID2020-117916RB-I00/AEI/10.13039/501100011033"}],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"v8yjx594cs","title":"Proteasome Inhibitors Bortezomib and Carfilzomib Induce CIPN through Different Molecular Mechanisms - Raw data","description":"20S proteasome inhibitors have been approved for the treatment of multiple myeloma but induce chemotherapy-related neurotoxicity. Here, we compared the neurotoxicity of bortezomib (BTZ) and carfilzomib (CFZ), a less neurotoxic drug, by investigating preclinical models and dissecting the underlying molecular mechanisms using a multidimensional approach.\nWe developed a new mouse model of CFZ-induced neuropathy and compared it to an established BTZ model using behavioral, morphological/morphometric, and proteomic analyses showing that the more severe neurotoxicity correlated with loss of nerve fibers and protein expression changes.\nMoreover, mitotoxicity and cytoskeleton alterations were comparatively investigated in terms of onset of altered mitochondrial morphology, functionality, and trafficking, alongside cytoskeletal proteins expression and axonal degeneration in cultured mouse dorsal root ganglion neurons. Both compounds significantly altered mitochondrial network organization and energy production after 24 hours of treatment. However, only BTZ increased microtubule hyper-stabilization by accumulation of tubulin post-translational modifications and induced early axonal degeneration within the first 10 hours, severely impacting mitochondrial trafficking after 24 hours.\nTaken together, these results point at mitochondrial toxicity as a common downstream effect of both treatments, while BTZ-specific off-target activity on tubulin hyper-stability may initiate early mitochondrial trafficking alterations, a new knowledge helping to inform future mitigation approaches.\n\n\nData refer to each figure in the article describing the in vivo and in vitro effects of the treatment with proteasome inhibitors Bortezomib and Carfilzomib.","source":{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","external":false},"publication_date":"2025-06-10T14:38:39.746Z","url":"https://board.unimib.it/datasets/v8yjx594cs","data_type":"dataset","access":"open","doi":["10.17632/v8yjx594cs"],"contributors":[{"first_name":"Federico ","last_name":"Iseppon","orcid":"0000-0002-1981-1204"}],"funders":[{"id":"https://ror.org/01gb56c55","name":"Fondazione Cariplo","grant_id":"2019-1482"}],"categories":["Neuroscience","Toxicology","Proteomics","Animal Models in Neurobiology","Microtubule","Mitochondrial Transport","Mitochondrial Toxicity"],"journal_issn":[]},{"id":"zbngwgtdw5","title":"The Proteasome Component PSMD14 Drives Myelomagenesis through a Histone Deubiquitinase Activity ","description":"The 19S regulatory particle (RP) of the proteasome is emerging as a promising target for the treatment of myeloma that are resistant to bortezomib, a selective inhibitor of the 20S core particle. However, the molecular basis underlying the targeting of the 19S RP for myeloma therapy remains to be elucidated. Here we report that, unexpectedly, the 19S RP component PSMD14 is physically associated with the myeloma driver, NSD2 on chromatin independent of 19S RP. We find that PSMD14 is a histone deubiquitinase acting on H2AK119, and that PSMD14-catalyzed H2AK119 deubiquitination facilitates NSD2-directed H3K36 di-methylation. Integrative genomic and epigenomic analyses reveal that the functional coordination between PSMD14 and NSD2 is associated with transcription activation of a cohort of genes including RELA that are critically involved in myelomagenesis. We show that RELA, in turn, transactivates PSMD14, establishing a positive feedback regulatory loop that explains well the long-reported clinical behaviours of myeloma. Chemical inhibition of PSMD14 sensitizes myeloma cells to bortezomib and confers a synergistic anti-myeloma activity with bortezomib, lenalidomide and dexamethasone. Importantly, the expression of PSMD14 is increasingly elevated as asymptomatic pre-malignant myeloma progresses to multiple myeloma, and its level of expression is inversely correlated with the overall survival and bortezomib-based therapeutic response of myeloma patients. Our study uncovers an unappreciated function of PSMD14 as an epigenetic regulator and a myeloma driver, supporting the pursuit of this proteasome constituent as a therapeutic target to overcome the treatment limitation of myeloma. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-04T09:10:01.79Z","url":"https://data.mendeley.com/datasets/zbngwgtdw5","data_type":"dataset","access":"open","doi":["10.17632/zbngwgtdw5"],"contributors":[{"first_name":"Lin","last_name":"He","orcid":null}],"funders":[],"categories":["Molecular Biology","Cancer Epigenetics"],"journal_issn":[]},{"id":"pyr8t5ng6r","title":"Mitochondrial complex IV defects induce metabolic and signaling perturbations that expose potential vulnerabilities in HCT116 cells","description":"Mutations in genes encoding cytochrome c oxidase (COX; mitochondrial complex IV) subunits and assembly factors (e.g., SCO1, SCO2, COA6) are linked to severe metabolic syndromes. Notwithstanding that SCO2 is under transcriptional control of tumour suppressor p53, the role of mitochondrial complex IV dysfunction in cancer metabolism remains obscure. Herein, we demonstrate that the loss of SCO2 in HCT116 colorectal cancer cells leads to significant metabolic and signaling perturbations. Specifically, abrogation of SCO2 increased NAD+ regenerating reactions and decreased glucose oxidation through citric acid cycle while enhancing pyruvate carboxylation. This was accompanied by a reduction in amino acid levels and the accumulation of lipid droplets. In addition, SCO2 loss resulted in hyperactivation of IGF1R/AKT axis with paradoxical downregulation of mTOR signaling which was accompanied by increased AMPK activity. Accordingly, abrogation of SCO2 expression appears to increase the sensitivity of cells to IGF1R and AKT, but not mTOR inhibitors. Finally, the loss of SCO2 was associated with reduced proliferation and enhanced migration of HCT116 cells. Collectively, herein we describe potential adaptive signaling and metabolic perturbations triggered by mitochondrial complex IV dysfunction.  ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-02-24T16:52:46.031Z","url":"https://data.mendeley.com/datasets/pyr8t5ng6r","data_type":"dataset","access":"open","doi":["10.17632/pyr8t5ng6r"],"contributors":[{"first_name":"Oro","last_name":"Uchenunu","orcid":null},{"first_name":"Alexander","last_name":"Zhdanov","orcid":null},{"first_name":"Phillipe","last_name":"Hutton","orcid":null},{"first_name":"Predrag","last_name":"Jovanovic","orcid":null},{"first_name":"Ye","last_name":"Wang","orcid":null},{"first_name":"Dmitry","last_name":"Andreev","orcid":null},{"first_name":"Laura","last_name":"Hulea","orcid":null},{"first_name":"David","last_name":"Papadopoli","orcid":null},{"first_name":"Daina","last_name":"Avizonis","orcid":null},{"first_name":"Pavel","last_name":"Baranov","orcid":null},{"first_name":"Michael","last_name":"Pollak","orcid":null},{"first_name":"Dmitri","last_name":"Papkovsky","orcid":null},{"first_name":"Ivan","last_name":"Topisirovic","orcid":null}],"funders":[],"categories":["Cancer","Cell Signaling","Mitochondrial Disorder","Metabolism"],"journal_issn":[]},{"id":"wxyb4wt7j2","title":"Identification of a drug-response gene in multiple myeloma through  longitudinal single-cell transcriptome sequencing. Masuda et al.","description":"Despite recent therapeutic advances for multiple myeloma (MM), relapse is very common. Here, we conducted longitudinal single-cell transcriptome sequencing (scRNA-seq) of MM cells from a patient with relapsed MM, treated with multiple anti-myeloma drugs. We observed five subclusters of MM cells, which appeared and/or disappeared in response to the therapeutic pressure, and identified cluster 3 which emerged during lenalidomide treatment and disappeared after proteasome inhibitor treatment. Among the differentially expressed genes in cluster 3, we found a candidate drug-response gene; pellino E3 ubiquitin protein ligase family member 2 (PELI2), which is responsible for PI-induced cell death in in vitro assay. Kaplan-Meier survival analysis of database revealed that higher expression of PELI2 is associated with better prognosis. Our integrated strategy combining longitudinal scRNA-seq analysis, in vitro functional assay, and database analysis would facilitate the understanding of clonal dynamics of MM in response to anti-myeloma drugs and identification of drug response genes.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-08-08T15:49:05.059Z","url":"https://data.mendeley.com/datasets/wxyb4wt7j2","data_type":"dataset","access":"open","doi":["10.17632/wxyb4wt7j2"],"contributors":[{"first_name":"Toru","last_name":"Masuda","orcid":null}],"funders":[],"categories":["In Vitro Study"],"journal_issn":[]},{"id":"vdtjzmdgkk","title":"Ubiquitin receptor PSMD4/Rpn10 is a novel therapeutic target in multiple myeloma","description":"Abstract: PSMD4/Rpn10 is a subunit of the 19S proteasome unit that is involved with feeding target proteins into the catalytic machinery of the proteasome. Given that inhibiting the proteasome is a common therapeutic strategy in multiple myeloma (MM), we investigated Rpn10 and found that it is highly expressed in MM cells, compared to PBMCs, and its expression is inversely correlated with overall survival and positively correlated with disease progression in MM patients. Inducible knockout or knockdown of Rpn10 decreased MM cell viability both in vitro and in vivo by triggering the accumulation of polyubiquitinated proteins, MM cell cycle arrest, and MM cell death through caspase-dependent- and unfolded-protein-response-related apoptosis. Proteomic analysis revealed that inhibiting Rpn10 in MM increased autophagy, antigen presentation and the activation of CD4+ T cells and NK cells. We then developed an in vitro AlphaScreen binding assay for high-throughput screening and identified a novel Rpn10 inhibitor, SB699551. Treating MM cell lines, leukemic cell lines, and primary MM patient cells with SB699551 significantly decreased cell viability without affecting the viability of normal PBMCs. SB699551 inhibited the proliferation of MM cells even in the presence of microenvironmental cells and without blocking the catalytic activity of the 20S proteasome unit or the deubiquitinating activity of the 19S unit. Rpn10 blockade by SB699551 triggered MM cell death via similar pathways as the genetic strategy. Xenograft animal models found that SB699551 was well-tolerated, inhibited tumor growth, and prolonged survival. Our data suggests that inhibiting Rpn10 will enhance cytotoxicity and overcome proteasome-inhibitor resistance in MM, providing the basis for further optimization studies of Rpn10 inhibitors for clinical application.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-12-06T17:30:02.085Z","url":"https://data.mendeley.com/datasets/vdtjzmdgkk","data_type":"dataset","access":"open","doi":["10.17632/vdtjzmdgkk"],"contributors":[{"first_name":"ting","last_name":"du","orcid":null}],"funders":[],"categories":["Multiple Myeloma","Proteasome"],"journal_issn":[]},{"id":"t2pmyzzt6n","title":"Ubiquitin receptor PSMD4/Rpn10 is a novel therapeutic target in multiple myeloma","description":"PSMD4/Rpn10 is a subunit of the 19S proteasome unit that is involved with feeding target proteins into the catalytic machinery of the proteasome. Given that inhibiting the proteasome is a common therapeutic strategy in multiple myeloma (MM), we investigated Rpn10 and found that it is highly expressed in MM cells, compared to PBMCs, and its expression is inversely correlated with overall survival and positively correlated with disease progression in MM patients. Inducible knockout or knockdown of Rpn10 decreased MM cell viability both in vitro and in vivo by triggering the accumulation of polyubiquitinated proteins, MM cell cycle arrest, and MM cell death through caspase-dependent- and unfolded-protein-response-related apoptosis. Proteomic analysis revealed that inhibiting Rpn10 in MM increased autophagy, antigen presentation and the activation of CD4+ T cells and NK cells. We then developed an in vitro AlphaScreen binding assay for high-throughput screening and identified a novel Rpn10 inhibitor, SB699551. Treating MM cell lines, leukemic cell lines, and primary MM patient cells with SB699551 significantly decreased cell viability without affecting the viability of normal PBMCs. SB699551 inhibited the proliferation of MM cells even in the presence of microenvironmental cells and without blocking the catalytic activity of the 20S proteasome unit or the deubiquitinating activity of the 19S unit. Rpn10 blockade by SB699551 triggered MM cell death via similar pathways as the genetic strategy. Xenograft animal models found that SB699551 was well-tolerated, inhibited tumor growth, and prolonged survival. Our data suggests that inhibiting Rpn10 will enhance cytotoxicity and overcome proteasome-inhibitor resistance in MM, providing the basis for further optimization studies of Rpn10 inhibitors for clinical application.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-12-06T17:30:06.304Z","url":"https://data.mendeley.com/datasets/t2pmyzzt6n","data_type":"dataset","access":"open","doi":["10.17632/t2pmyzzt6n"],"contributors":[{"first_name":"ting","last_name":"du","orcid":null}],"funders":[],"categories":["Multiple Myeloma"],"journal_issn":[]}],"total_records":139926,"page":1,"page_size":10,"execution_time":189,"aggregations":{"data_type_stats":{"dataset":139926,"collection":0},"access_type_stats":{"open":139202,"restricted":68,"embargoed":656},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2344},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1500},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":688},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":482},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":444},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":427},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":413},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":393},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":334},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":277}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":137270},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1910},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":188},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":138},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":79},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":58},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":41},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":31},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":25}],"top_institutions_stats":[{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":1041},{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":948},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":530},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":408},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":362}]}}