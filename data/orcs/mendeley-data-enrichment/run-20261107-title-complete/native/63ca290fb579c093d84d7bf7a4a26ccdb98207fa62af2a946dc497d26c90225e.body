{"records":[{"id":"33tm3dd9dw","title":"FAME-CRISPR: Improved CRISPR-Cas9 Genome Editing via HDAC Inhibition and Engineered Virus-Like Particle Delivery ","description":"Raw data deposited for \"FAME-CRISPR: Improved CRISPR-Cas9 Genome Editing via HDAC Inhibition and Engineered Virus-Like Particle Delivery\" by Djamshidi et al-Cell Reports Methods","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-09-25T15:53:30.358Z","url":"https://data.mendeley.com/datasets/33tm3dd9dw","data_type":"dataset","access":"open","doi":["10.17632/33tm3dd9dw"],"contributors":[{"first_name":"Mahbod","last_name":"Djamshidi","orcid":null}],"funders":[],"categories":["Sanger Sequencing","Immunofluorescence"],"journal_issn":[]},{"id":"835fcfbvhs","title":"Preparation of CRISPR/Cas9 and gRNA plasmids","description":"Human genome engineering has been transformed by the introduction of the CRISPR (clustered regularly interspaced short palindromic repeats)/Cas (CRISPR-associated) system found in most bacteria and archaea. Type II CRISPR/Cas systems have been engineered to induce RNA-guided genome editing in human cells, where small RNAs function together with Cas9 nucleases for sequence-specific cleavage of target sequences. Here we describe the protocol for Cas9-mediated human genome engineering, including construct building and transfection methods necessary for delivering Cas9 and guide RNA (gRNA) into human-induced pluripotent stem cells (hiPSCs) and HEK293 cells. Following genome editing, we also describe methods to assess genome editing effi- ciency using next-generation sequencing and isolate monoclonal hiPSCs with the desired modifications for downstream applications. Keywords: genome engineering • CRISPR • human stem cells","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2016-12-12T12:58:15.307Z","url":"https://data.mendeley.com/datasets/835fcfbvhs","data_type":"dataset","access":"open","doi":["10.17632/835fcfbvhs"],"contributors":[{"first_name":"George","last_name":"Church","orcid":null}],"funders":[],"categories":["Experimental Method"],"journal_issn":[]},{"id":"3ctpx4k6jp","title":"Porcine reproductive and respiratory syndrome virus upregulates SMPDL3B to promote viral replication by modulating lipid metabolism","description":"We generated a collection of porcine genome-scale CRISPR/Cas9 knockout (PigGeCKO) cells on a PAM background.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-26T18:53:54.241Z","url":"https://data.mendeley.com/datasets/3ctpx4k6jp","data_type":"dataset","access":"open","doi":["10.17632/3ctpx4k6jp"],"contributors":[{"first_name":"huanh","last_name":"Shen","orcid":null}],"funders":[],"categories":["Agricultural Biotechnology"],"journal_issn":[]},{"id":"z4ht3txn2k","title":"Accompanying Files for paper entitled: \"Genome-scale mapping of DNA damage suppressors through phenotypic CRISPR/Cas9 screens\" - Zhao et al. Molecular Cell 2023","description":"Accompanying Files for paper entitled: \"Genome-scale mapping of DNA damage suppressors through phenotypic CRISPR/Cas9 screens\" - Zhao et al. Molecular Cell 2023. This dataset contains Source and additional Data for all figures.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-06-06T07:16:19.286Z","url":"https://data.mendeley.com/datasets/z4ht3txn2k","data_type":"dataset","access":"open","doi":["10.17632/z4ht3txn2k"],"contributors":[{"first_name":"Daniel","last_name":"Durocher","orcid":null},{"first_name":"Yichao","last_name":"Zhao","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":null}],"categories":["DNA Replication","DNA Repair","Flow Cytometry","Cancer Chemotherapy","DNA Damage","Functional Genomics","CRISPR/Cas9"],"journal_issn":[]},{"id":"hzr4fnvc88","title":"Rapid two-step target capture ensures efficient CRISPR-Cas9-guided genome editing. Shi, Al-Sayyad, & Wasko et al.","description":"Raw experimental data from experiments detailed in \"Rapid two-step target capture ensures efficient CRISPR-Cas9-guided genome editing.\" by Shi, Al-Sayyad, & Wasko et al.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-04-15T13:22:36.896Z","url":"https://data.mendeley.com/datasets/hzr4fnvc88","data_type":"dataset","access":"open","doi":["10.17632/hzr4fnvc88"],"contributors":[{"first_name":"Kevin","last_name":"Wasko","orcid":null}],"funders":[],"categories":["Biochemistry","Enzymatic Activity","Genome Editing","Molecular Biophysics"],"journal_issn":[]},{"id":"ptx3dzs926","title":"NGS data of CRISPR/dCas9 activation screen with CDK4/6 inhibitor Palbociclib in bladder cancer","description":"We used a genome-scale functional genomics approach to determine the mechanisms of resistance to PD0332991. Transcriptional activation was performed using the synergistic activation mediator (SAM) CRISPR-dCas9 library. Work flow: a) T24 cells with stably transduced SAM components. b) Low MOI lentiviral transduction of  amplified sgRNA library.  c)antibiotic selection for transduced  cells. e) divide cells into control(vehicle) and PD 7 days treatment. f) NGS of PCR amplicons. g) Comparison of sgRNA counts in control and treatment conditions.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-06-01T04:24:44.789Z","url":"https://data.mendeley.com/datasets/ptx3dzs926","data_type":"dataset","access":"open","doi":["10.17632/ptx3dzs926"],"contributors":[{"first_name":"Zhichao","last_name":"Tong","orcid":null}],"funders":[],"categories":["CRISPR/Cas9"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"cszpw4c66t","title":"Structural insights into Cas9-mediated prespacer selection in CRISPR-Cas adaptation. Gaizauskaite et al.","description":"During CRISPR-Cas adaptation, prokaryotic cells become immunized by the insertion of foreign DNA fragments, termed spacers, into the host genome to serve as templates for RNA-guided immunity. Spacer acquisition relies on the Cas1-Cas2 integrase and accessory proteins, which select DNA sequences flanked by the protospacer adjacent motif (PAM) and insert them into the CRISPR array. It has been shown that in type II-A systems selection of PAM-proximal prespacers is mediated by the effector nuclease Cas9, which forms a ‘supercomplex’ with the Cas1-Cas2 integrase and the Csn2 protein. Here, we present cryo-electron microscopy structures of the type II-A prespacer selection supercomplex in the DNA-scanning and two distinct PAM-bound configurations, providing insights into the mechanism of Cas9-mediated prespacer selection in type II-A CRISPR-Cas systems. Repurposing of Cas9 by the CRISPR adaptation machinery for prespacer selection characterized here demonstrates Cas9 plasticity and expands our knowledge of the Cas9 biology.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-02-20T09:45:34.481Z","url":"https://data.mendeley.com/datasets/cszpw4c66t","data_type":"dataset","access":"open","doi":["10.17632/cszpw4c66t"],"contributors":[{"first_name":"Ugne","last_name":"Gaizauskaite","orcid":"0009-0008-9137-5428"},{"first_name":"Giedre","last_name":"Tamulaitiene","orcid":"0000-0002-9794-3544"},{"first_name":"Arunas","last_name":"Silanskas","orcid":"0000-0002-6385-6928"},{"first_name":"Giedrius","last_name":"Gasiunas","orcid":"0000-0003-2509-9054"},{"first_name":"Virginijus","last_name":"Siksnys","orcid":"0000-0003-1983-2096"},{"first_name":"Giedrius","last_name":"Sasnauskas","orcid":"0000-0002-3185-2682"}],"funders":[{"id":"https://ror.org/02gs16m83","name":"Lietuvos Mokslo Taryba","grant_id":"S-MIP-19-32"}],"categories":["Biochemistry"],"journal_issn":[]},{"id":"pv8t3hbg4t","title":"Proteasome-Bound UCH37 Debranched Ubiquitin Chains to Promote Degradation. Deol et al. ","description":"The following documents show sequencing data confirming CRISPR/Cas9 genome editing of cell lines, all gels used for analysis, and mass spectrometric chromatograms and LC traces. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-10-09T23:09:46.22Z","url":"https://data.mendeley.com/datasets/pv8t3hbg4t","data_type":"dataset","access":"open","doi":["10.17632/pv8t3hbg4t"],"contributors":[{"first_name":"Eric","last_name":"Strieter","orcid":null},{"first_name":"Kirandeep","last_name":"Deol","orcid":null},{"first_name":"Sean","last_name":"Crowe","orcid":null},{"first_name":"Jiale","last_name":"Du","orcid":null},{"first_name":"Heather ","last_name":"Bisbee","orcid":null},{"first_name":"Robert","last_name":"Guenette","orcid":null}],"funders":[],"categories":["Mass Spectrometry","Gel","CRISPR/Cas9"],"journal_issn":[]},{"id":"4r55hvz87r","title":"Negative DNA supercoiling induces genome-wide Cas9 off-target activity. Newton MD et al","description":"CRISPR/Cas9 is a powerful gene-editing technology, however off-target activity remains an important consideration for therapeutic applications. We have previous-ly shown that force stretching DNA induces off-target activity and hypothesised that distortions of the DNA topology in vivo, such as negative DNA supercoiling, could reduce Cas9 specificity. Using single-molecule optical-tweezers, we demonstrate that negative supercoiling λ-DNA induces sequence-specific Cas9 off-target bind-ing at multiple sites, even at low forces. Using an adapted CIRCLE-seq approach, we detect over 10,000 negative supercoiling induced Cas9 off-target double-strand breaks genome wide, caused by increased mismatch tolerance. We further demon-strate in vivo that directed local DNA distortion increases off-target activity in cells and that induced off-target events can be detected during Cas9 genome-editing. These data demonstrate that Cas9 off-target activity is regulated by DNA topology in vitro and in vivo, suggesting that cellular processes, such as transcription and replication, could induce off-target activity at previously overlooked sites. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-03-12T08:20:22.495Z","url":"https://data.mendeley.com/datasets/4r55hvz87r","data_type":"dataset","access":"open","doi":["10.17632/4r55hvz87r"],"contributors":[{"first_name":"Matt","last_name":"Newton","orcid":null}],"funders":[],"categories":["Biochemistry","Molecular Biology","Single Molecule Imaging","Next Generation Sequencing","CRISPR/Cas9","Genome Editing"],"journal_issn":[]}],"total_records":61829,"page":1,"page_size":10,"execution_time":83,"aggregations":{"data_type_stats":{"dataset":61829,"collection":0},"access_type_stats":{"open":61683,"restricted":35,"embargoed":111},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":1085},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":412},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":262},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":236},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":234},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":212},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":211},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":195},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":188},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":164}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":60212},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1192},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":133},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":65},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":44},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":42},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":30},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":23},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":22},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":21}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":284},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":257},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":254},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":174},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":147}]}}