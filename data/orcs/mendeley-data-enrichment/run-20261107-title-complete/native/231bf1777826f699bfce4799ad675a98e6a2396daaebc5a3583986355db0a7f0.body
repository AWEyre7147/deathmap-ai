{"records":[{"id":"mynvsfb2yj","title":"Integrated Proteomics and Metabolomics Analysis Reveals the Mechanisms of SFYC Decoction in Regulating Airway Inflammation in Asthma","description":"This dataset contains the complete raw and processed data supporting the study entitled “Integrative Proteomics and Metabolomics Analysis Reveals the Anti-Inflammatory Mechanisms of Soufeng Yuchuan Decoction in Asthma”.In vivo data (ovalbumin-induced asthmatic rat model):Hematoxylin-eosin (H&E) stained histopathological images of rat lung tissue; Original Western blot images and quantitative data of key ferroptosis-related proteins: glutathione peroxidase 4 (GPX4), solute carrier family 7 member 11 (SLC7A11), solute carrier family 3 member 2 (SLC3A2), glutamate-cysteine ligase catalytic subunit (GCLC), glutathione synthetase (GSS), and voltage-dependent anion channel 2 (VDAC2); Levels of IgE, IL-6, and IL-13 in bronchoalveolar lavage fluid (BALF); Biochemical assay results: reduced glutathione (GSH) levels in lung tissue and serum.\nIn vitro data (erastin-induced ferroptosis model in BEAS-2B human bronchial epithelial cells):\nRaw data of cell viability measured by Cell Counting Kit-8 (CCK-8); Fluorescence images and quantitative data of 5-ethynyl-2′-deoxyuridine (EdU) cell proliferation assay; ELISA results for malondialdehyde (MDA), superoxide dismutase (SOD), total iron content, and GSH/GSSG ratio; Original Western blot images, quantitative data, and RT-qPCR raw Ct values with normalized expression of GPX4, GCLC, GSS, SLC7A11, SLC3A2, and VDAC2\nThe dataset enables full reproduction and independent verification of all in vivo and in vitro experimental results presented in the associated manuscript.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-02-09T05:06:20.096Z","url":"https://data.mendeley.com/datasets/mynvsfb2yj","data_type":"dataset","access":"open","doi":["10.17632/mynvsfb2yj"],"contributors":[{"first_name":"Yu-jing","last_name":"ZHANG","orcid":null}],"funders":[{"id":"https://ror.org/058p20n09","name":"Henan Science and Technology Department","grant_id":"252300421274"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":" 81973903"},{"id":"https://ror.org/058p20n09","name":"Henan Science and Technology Department","grant_id":" 252102310482)"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"82174438"}],"categories":["Asthma","Chinese Herbal Medicine"],"journal_issn":[]},{"id":"3p64dm6m43","title":"Solute Carrier Family 1 Member 4 (SLC1A4) Is A Powerful Prognostic Marker and Correlated With Immune Infiltrates in Pancreatic Cancer","description":"The datasets used or analysed during the current study are available from the corresponding author on reasonable request.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-01-31T18:10:02.61Z","url":"https://data.mendeley.com/datasets/3p64dm6m43","data_type":"dataset","access":"open","doi":["10.17632/3p64dm6m43"],"contributors":[{"first_name":"Xinmin","last_name":"Jin","orcid":null},{"first_name":"Jinhuan","last_name":"Wang","orcid":null}],"funders":[],"categories":["RNA Gene"],"journal_issn":[]},{"id":"3ps7b35w6t","title":"Targeted metabolomics in control or PERKKO AML cells incubated with vehicle or GSK621","description":"Related to Figure 3. Results are provided as amounts of metabolites in pmol/106 cells. ATP: adenosine triphosphate; ADP: adenosine diphorphate; AMP: adenosine monophosphate; G6P: glucose-6-phosphate; FBP: fructose 1,6 biphosphate; 23BPG: 2,3 biphosphoglyceric acid; PEP: phosphoenolpyruvic acid; 6PG: 6-phosphogluconate; P5P: ribose_ribulose_xylulose 5-phosphate; SED7P: Sedoheptulose 7-phosphate; AKG: alpha ketoglutarate; \tGMP: guanosine monophosphate; GDP: guanosine diphosphate; CMP: cytosine monophosphate; CDP: cytosine diphosphate; CTP: cytosine triphosphate; UMP: uridine monpphosphate; UDP: uridine biphosphate; UTP: uridine triphosphate; UDP gLC: UDP-glucose; UDP AcGlnc: UDP-N-acetylglucosamine; G3P: Glycerol 3-phosphate; MAN 6P: mannose 6-phosphate.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-30T12:50:25.504Z","url":"https://data.mendeley.com/datasets/3ps7b35w6t","data_type":"dataset","access":"open","doi":["10.17632/3ps7b35w6t"],"contributors":[{"first_name":"Jerome","last_name":"Tamburini","orcid":null}],"funders":[],"categories":["Metabolomics"],"journal_issn":[]},{"id":"gsrr4pr746","title":"Biological activity and molecular mechanism of Origanum onites and Ocimum gratissimum plant essential oils against Haemaphysalis doenitzi (Acari: Ixodidae)","description":"ATP-binding cassette sub-family E member 1 [Haemaphysalis doenitzi]","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-03-19T15:34:55.418Z","url":"https://data.mendeley.com/datasets/gsrr4pr746","data_type":"dataset","access":"open","doi":["10.17632/gsrr4pr746"],"contributors":[{"first_name":"songbo","last_name":"zhang","orcid":null}],"funders":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"31472050"}],"categories":["ABC Transporter"],"journal_issn":[]},{"id":"7ckt6r2mb5","title":"Supplementary Information - Next-Generation Moisturizing Glove: N-Acetylneuraminic Acid Coating for Prolonged Skin Hydration","description":"This document provides supplementary details on the latex compounding formulation used in the study titled \"Next-Generation Moisturizing Glove: N-Acetylneuraminic Acid Coating for Prolonged Skin Hydration\", along with results and discussions on the surface morphology of the coated films analyzed via FE-SEM and their tensile properties assessed using a universal testing machine.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-03-20T15:33:48.119Z","url":"https://data.mendeley.com/datasets/7ckt6r2mb5","data_type":"dataset","access":"open","doi":["10.17632/7ckt6r2mb5"],"contributors":[{"first_name":"Sher Wei","last_name":"How","orcid":null},{"first_name":"Janarthanan","last_name":"Supramaniam","orcid":null},{"first_name":"Thet Htar","last_name":"Thet","orcid":null},{"first_name":"Sivakumar","last_name":"Manickam","orcid":null},{"first_name":"Bey Hing ","last_name":"Goh","orcid":null},{"first_name":"Siah Ying","last_name":"Tang","orcid":null}],"funders":[],"categories":["Polymer","Dermatology","Occupational Disease"],"journal_issn":[]},{"id":"8v74vsjdr8","title":"LINF_330008900","description":"ATP-binding cassette sub-family F member 3 | ABCF3\nLeishmania infantum (strain JPCM5)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-10-07T10:30:27.535Z","url":"https://data.mendeley.com/datasets/8v74vsjdr8","data_type":"dataset","access":"open","doi":["10.17632/8v74vsjdr8"],"contributors":[{"first_name":"Jose M.","last_name":"Requena","orcid":null}],"funders":[],"categories":["Gene","Protein","Leishmania"],"journal_issn":[]},{"id":"z5s9xnkx6n","title":"Original WB Li and Kang et. al. Developmental Cell","description":"The neurotransmitter GABA has been thought to be involved in the development of some types of cancer. Yet, the de novo synthesis of GABA and how it functions in hepatocellular carcinoma (HCC) remain unclear. Here, we report that SLC6A12 acts as a transporter of GABA and ALDH9A1 (aldehyde dehydrogenase 9 family member A1), not GAD1 (glutamate decarboxylase 1), generates GABA in human HCC. Interestingly, SLC6A12 and ALDH9A1 are upregulated during lung metastases of HCC, and depletion of either of them leads to impaired HCC metastasis. Mechanistically, GABA directly binds and stabilizes β-catenin, resulting in activated Wnt/β-catenin signaling, and thereby enhanced HCC metastasis. Reciprocally, β-catenin transcriptionally upregulates SLC6A12 to import more GABA to stabilize β-catenin. Thus, our findings identify ALDH9A1 is the major GABA synthetase in HCC, demonstrate a positive-feedback regulatory mechanism for sustaining Wnt/β-catenin signaling, and find a role for β-catenin in sensing GABA that contributes to HCC metastasis.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-11-26T18:16:58.604Z","url":"https://data.mendeley.com/datasets/z5s9xnkx6n","data_type":"dataset","access":"open","doi":["10.17632/z5s9xnkx6n"],"contributors":[{"first_name":"Li","last_name":"Li","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"9dcskyxb85","title":"Uridine Cytidine Kinase 1 Promotes Phosphatidylcholine Biosynthesis Facilitating SARS-CoV-2 infection","description":"Raw imaging/microscopy data for paper Uridine Cytidine Kinase 1 Promotes Phosphatidylcholine Biosynthesis Facilitating SARS-CoV-2 infection","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-11T06:31:28.394Z","url":"https://data.mendeley.com/datasets/9dcskyxb85","data_type":"dataset","access":"open","doi":["10.17632/9dcskyxb85"],"contributors":[{"first_name":"Guangda","last_name":"Shi","orcid":null}],"funders":[],"categories":["Pyrimidine Nucleoside","Cell Metabolism","Phospholipid Metabolism","Confocal Microscopy","Western Blot","Coronavirus"],"journal_issn":[]},{"id":"2mtbt3bnpn","title":"Proteomics and RNA-seq of TGP-200c and LNA-200c in MIN6 cells","description":"Global Proteomics: The effect of LNA-200c (100 nM) on the proteome was studied.  Amongst 3,016 proteins detected, 29 were significantly affected (10 down-regulated and 19 up-regulated.  Interestingly, none of these 29 proteins overlapped with those significantly affected by TGP-200c.  Unlike TGP-200c, where global upregulation of miR-200c target proteins was observed, no significant general up-regulation of these proteins was observed as they fall below the false discovery rate of 1%, although an increase in abundance was observed for the direct target Vitamin K Epoxide Reductase Complex Subunit 1 Like 1 (VKORC1L1).  Other proteins regulated by the miR-200 family, namely miR-200a and miR-249, were also affected, such as Dolichyl Pyrophosphate phosphatase 1 (DOLPP1), Mitogen Activated Protein Kinase 1 (MAPK1), Translin Associated Factor X (TSNAX), and Solute Carrier Family 7 Member 30 (SLC30A7); MAPK1 appears to function in cell survival in T2D (Favaro et al., 2012; Granata et al., 2007).  Notably, proteomics analysis for LNA-200c could be confounded by the downregulation of all mature miR-200 family members by the oligonucleotide.  Pathway analysis, however, showed that similar networks were affected by LNA-200c and TGP-200c, for example the regulation of macromolecule metabolism, apoptosis, metabolism, and insulin signaling. \n\nRNA-seq analysis: Among the 15,737 genes that were detected, only 23 transcripts (0.15%) were significantly affected by TGP-200c (with >2-fold change and p < 0.05; 10 down-regulated and 13 up-regulated).  Among these 23 significantly affected transcripts, two, Evi2b and Gpr174,  are predicted mRNA targets for miR-200c-5p (by TargetScan) (Agarwal et al., 2015) .  For LNA-200c, 45 transcripts (0.29%) were significantly affected upon treatment (25 down-regulated and 20 up-regulated; Figure S6A).  Among these 45, five mRNAs,  Msln, Gm14288, Evi2b, Cldn2, Sox6, are predicted by TargetScan to be direct targets of miR-200c-3p (n = 1) or -5p (n = 4) (Agarwal et al., 2015).  Of the 23 transcripts modulated by TGP-200c and the 45 affected by LNA-200c, five overlap: Evi2b (direct target of miR-200c), Gm15387, Gm6169, Gm4353, and Gm19680.  Evidently, structure-binding ligands can have specificities competitive with modalities that recognize sequence.  ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-06-25T14:10:24.874Z","url":"https://data.mendeley.com/datasets/2mtbt3bnpn","data_type":"dataset","access":"open","doi":["10.17632/2mtbt3bnpn"],"contributors":[{"first_name":"Hafeez","last_name":"Haniff","orcid":null},{"first_name":"Xiaohui","last_name":"Liu","orcid":null},{"first_name":"Yuquan","last_name":"Tong","orcid":null},{"first_name":"Daniel","last_name":"Abegg","orcid":null},{"first_name":"Samantha ","last_name":"Meyer","orcid":null},{"first_name":"Alexander ","last_name":"Adibekian","orcid":null},{"first_name":"Matthew","last_name":"Disney","orcid":null}],"funders":[],"categories":["RNA Sequencing","Expression Proteomics"],"journal_issn":[]},{"id":"gc2mpw74z8","title":"Datasets for Marine Geology","description":"Datasets related to: Geochemistry of vent fluids from the Daxi Vent Field, Carlsberg Ridge, Indian Ocean: Constraints on subseafloor processes beneath a non-transform offset.\nTable 1: Information on the fluid samples.\nTable 2: Measured and calculated end-member (EM) compositions of vent fluids collected at the chimney orifices of Buddha’s Hands and A1. \nTable 3:Molar element/Cl ratios for end-member fluids from Buddha’s Hands, A1, and bottom seawater. \nTable 4: REE concentrations (Conc.), corresponding end-member (EM) concentrations in picomol/l (pM), and chondrite-normalized (/Chon.) REE for vent fluids collected at the chimney orifices of Buddha’s Hands and A1, respectively.\nTable 5: Metal content of precipitates collected from the samplers at Buddha’s Hands and A1, respectively.  \nTable 6: Endmember composition of vent fluids from Buddha’s Hands and A1, compared those from other vent fields in different geological setting.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-07-26T20:16:11.195Z","url":"https://data.mendeley.com/datasets/gc2mpw74z8","data_type":"dataset","access":"open","doi":["10.17632/gc2mpw74z8"],"contributors":[{"first_name":"XUETING","last_name":"WU","orcid":null}],"funders":[],"categories":["Marine Geology","Hydrothermal Vent"],"journal_issn":[]}],"total_records":135408,"page":1,"page_size":10,"execution_time":159,"aggregations":{"data_type_stats":{"dataset":135408,"collection":0},"access_type_stats":{"open":134715,"restricted":68,"embargoed":625},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2232},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":700},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":612},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":462},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":431},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":411},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":406},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":394},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":334},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":268}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":132814},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1869},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":177},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":137},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":77},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c