e":"Ermira","last_name":"Shuteriqi","orcid":null},{"first_name":"Olga","last_name":"Sizova","orcid":null},{"first_name":"David","last_name":"Thomson Taylor","orcid":null},{"first_name":"Maria","last_name":"Tereshchenko","orcid":null},{"first_name":"David","last_name":"Tieu","orcid":null},{"first_name":"Jacob","last_name":"Turowec","orcid":null},{"first_name":"Tajinder","last_name":"Ubhi","orcid":null},{"first_name":"Sylvia","last_name":"Varland","orcid":null},{"first_name":"Kyle E.","last_name":"Wang","orcid":null},{"first_name":"Zi Yang","last_name":"Wang","orcid":null},{"first_name":"Jiarun","last_name":"Wei","orcid":null},{"first_name":"YUXI","last_name":"XIAO","orcid":null},{"first_name":"Philipp G.","last_name":"Maass","orcid":null},{"first_name":"Bruno","last_name":"Reversade","orcid":null},{"first_name":"Grant W.","last_name":"Brown","orcid":null},{"first_name":"Bejamin F.","last_name":"Cravatt","orcid":null},{"first_name":"Scott","last_name":"Dixon","orcid":null},{"first_name":"Haley D. M.","last_name":"Wyatt","orcid":null},{"first_name":"Hannes L.","last_name":"Röst","orcid":null},{"first_name":"Frederick P.","last_name":"Roth","orcid":null},{"first_name":"Tian","last_name":"Xia","orcid":null},{"first_name":"Gary D.","last_name":"Bader","orcid":null},{"first_name":"Robbie","last_name":"Loewith","orcid":null},{"first_name":"Nicholas G.","last_name":"Davis","orcid":null},{"first_name":"Brenda","last_name":"Andrews","orcid":null},{"first_name":"Chad","last_name":"Myers","orcid":null},{"first_name":"Jason","last_name":"Moffat","orcid":null},{"first_name":"Charles","last_name":"Boone","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"MOP_142735"},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","grant_id":"MCB1818293"},{"id":"https://ror.org/01h531d29","name":"Natural Sciences and Engineering Research Council of Canada","grant_id":"RGPIN-2020-04180"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT 173542"},{"id":"https://ror.org/000az4664","name":"Canada Foundation for Innovation","grant_id":"39977"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE09-011"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE011-006"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-180285"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-GMX-463531"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2024-08-02"},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","grant_id":"DFG Bi 2086/1-1"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG005084"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2022-02"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG00583"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"T32GM008347"},{"id":null,"name":"NIH/NCI Ruth L. Kirschstein National Research F30 Award","grant_id":"5F30CA257227"}],"categories":["Genetics","Biological Network"],"journal_issn":[]},{"id":"6kggw28x8m","title":"Two new plasmid post-segregational killing mechanisms for the implementation of synthetic gene networks in E. coli. Fedorec et. al.","description":"Data from publication \"Two new plasmid post-segregational killing mechanisms for the implementation of synthetic gene networks in E. coli.\" Fedorec et. al. iScience 2019","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-03-29T12:17:32.478Z","url":"https://data.mendeley.com/datasets/6kggw28x8m","data_type":"dataset","access":"open","doi":["10.17632/6kggw28x8m"],"contributors":[{"first_name":"Chris","last_name":"Barnes","orcid":null},{"first_name":"Alex","last_name":"Fedorec","orcid":null}],"funders":[],"categories":["Microscopy","Flow Cytometry","Real-Time Polymerase Chain Reaction","Microplate"],"journal_issn":[]},{"id":"d58cv549v6","title":"The chemotherapeutic drug CX-5461 is a potent mutagen in cultured human cells","description":"The chemotherapeutic agent CX-5461, or pidnarulex, has been fast-tracked by the United States Food and Drug Administration for early-stage clinical studies of BRCA1-, BRCA2- and PALB2-mutated cancers. It is under investigation in phase I and II trials. Here, we find that, although CX-5461 exhibits synthetic lethality in BRCA1-/BRCA2-deficient cells, it also causes extensive, nonselective, collateral mutagenesis in all three cell lines tested, to magnitudes that exceed known environmental carcinogens.\n\nDeposited here are the de novo mutation lists from the experimental samples included in the study. Whole-genome sequencing short reads were aligned to GRCh38/hg38 using BWA-MEM. Post-processing filters were applied to improve the specificity of mutation-calling. Specifically, for single nucleotide variant calls by CaVEMan, we used CLPM == 0 and ASMD >= 140. To reduce false positive calls by Pindel, we used QUAL >= 250 and REP < 10. Rearrangements were not assessed as they were too few to be informative. A filter for variant allele frequency (> 0.2) was applied to substitutions and indels. De novo substitutions and indels in subclones were obtained by subtracting from respective parental clone whenever available, or by removing mutations shared among subclones.\n\nTwinStrand duplex sequencing data were analysed with the TwinStrand DuplexSeq Mutagenesis App, hosted on DNAnexus. The Mutagenesis App performed error-correction and generated Duplex Consensus alignment and variant calls for both germline and ultra-rare somatic variants. Only variants with variant allele frequency < 0.01 were considered to be the result of mutagenesis (i.e., mutation), and included for subsequent mutation burden and signature analysis. Provided here are the mutation calls from both iPS and HAP1 cells.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-10-24T18:10:52.577Z","url":"https://data.mendeley.com/datasets/d58cv549v6","data_type":"dataset","access":"open","doi":["10.17632/d58cv549v6"],"contributors":[{"first_name":"gene","last_name":"koh","orcid":null}],"funders":[],"categories":["Cancer","Genome"],"journal_issn":[]},{"id":"3k2tpx9ssr","title":"Redefined indel taxonomy reveals insights into mutational signatures ","description":"Despite their deleterious effects, small insertions and deletions (indels) have received far less attention than substitutions1,2. Recent computational advances have surmounted previous technical challenges, enabling the study of mutational processes driving indel formation. Here we generated isogenic CRISPR-edited human cellular models of post-replicative repair dysfunction (PRRd), including individual and combined gene-edits of mismatch repair (MMR) and replicative polymerases (POLE and POLD1). Unique, diverse mutational footprints of MMR deficiency and polymerase dysfunction were revealed. However, the prevailing indel classification framework1 falls short in discriminating these indel signatures from background mutagenesis and among each other, as it condenses important biological signals into predominantly two indel subclasses, limiting signature analyses. To address this, we propose a novel classification system that considers the 5’ and 3’ nucleobases flanking an indel, as with substitution signatures, resulting in 89 indel subclasses. Our new indel classification enhances the disambiguation of experimental signatures, and through analysis of 4,775 cancer whole genomes from the 100,000 Genomes Project3, we uncover 37 indel signatures (InDs); 27 are new. Further, we develop a classifier – PRRDetect, which outperforms approved biomarkers, such as Tumor Mutational Burden (TMB), for immunotherapy. This re-defined indel taxonomy advances our understanding of mutagenesis and heralds potential clinical applications.\n\nDeposited here are the de novo mutation lists from the experimental samples included in the study. Whole-genome sequencing short reads were aligned to GRCh38/hg38 using BWA-MEM. Post-processing filters were applied to improve the specificity of mutation-calling. Specifically, for single nucleotide variant calls by CaVEMan, we used CLPM == 0 and ASMD >= 140. To reduce false positive calls by Pindel, we used QUAL >= 250 and REP < 10. Rearrangements were not assessed as they were too few to be informative. De novo substitutions and indels in subclones were obtained by subtracting from respective parental clone whenever available, or by removing mutations shared among subclones.\t\n\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-02-14T16:14:25.866Z","url":"https://data.mendeley.com/datasets/3k2tpx9ssr","data_type":"dataset","access":"open","doi":["10.17632/3k2tpx9ssr"],"contributors":[{"first_name":"gene","last_name":"koh","orcid":null}],"funders":[],"categories":["Cancer","Mutation","Genome Sequencing"],"journal_issn":[]},{"id":"gvmfhyfpvs","title":"Integrated multi-omics analysis of zinc finger proteins uncovers roles in RNA regulation","description":"Unprocessed microscopy image files for figure S5B","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-06-19T09:17:00.468Z","url":"https://data.mendeley.com/datasets/gvmfhyfpvs","data_type":"dataset","access":"open","doi":["10.17632/gvmfhyfpvs"],"contributors":[{"first_name":"Gene","last_name":"Yeo","orcid":null}],"funders":[],"categories":["Microscopy"],"journal_issn":[]},{"id":"8kb3twbbf6","title":"Diaz and Klaper, 2025_PhenotypicProfilingData_ESNano","description":"Data for the article, Phenotypic profiling reveals polystyrene nanoplastics elicit sublethal and lethal effects on cellular morphology in rainbow trout gill epithelial cells, including CellProfiler pipelines and cellular images are available here. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-02-04T17:51:37.421Z","url":"https://data.mendeley.com/datasets/8kb3twbbf6","data_type":"dataset","access":"open","doi":["10.17632/8kb3twbbf6"],"contributors":[{"first_name":"Lissett","last_name":"Diaz","orcid":null},{"first_name":"Rebecca","last_name":"Klaper","orcid":null}],"funders":[{"id":"https://doi.org/10.13039/100016795","name":"Center for Sustainable Nanotechnology","grant_id":"CHE-2001611"}],"categories":["Aquatic Toxicology"],"journal_issn":[]},{"id":"bdhtkt2wpn","title":"Bioinformatics results of exosomal miRNA analysis in MAP-infected goats","description":"Supplementary bioinformatics data for exosomal miRNA profiling in Johne’s disease\n\nThis folder contains supplementary bioinformatics analysis results from the study titled\n“Exosomal microRNA profiling reveals candidate biomarkers and regulatory signatures associated with Johne’s disease progression in goats”.\n\nAll files were generated using exosomal small RNA sequencing data. Analyses were performed using IPA (Qiagen) and statistical tools such as DESeq2 (R).\n\nIncluded files:\n\nDEmiRs_analysis_results.xlsx: Differentially expressed miRNAs across disease stages, including log2 fold changes and adjusted p-values.\n\nDiseases_and_Functions_results.xlsx: Functional enrichment and disease category predictions associated with altered miRNAs.\n\nUpstream_Regulators_results.xlsx: Predicted upstream regulators based on expression patterns and regulatory networks.\n\nNetwork_Analysis_results.xlsx: Molecular interaction network visualization based on key miRNAs and target genes.\n\nmiRNA_mRNA_pairing_results.xlsx: Predicted miRNA–mRNA interactions with pairing confidence and gene annotation details.\n\nLicense: CC BY 4.0\nCorresponding author: \nJae Kyeom Kim, MS, PhD\nDepartment of Food and Biotechnology, Korea University, Sejong 30019, Republic of Korea\nDepartment of Health Behavior and Nutrition Sciences, University of Delaware, Newark, DE 19711, USA\nE-mail: jkkim@udel.edu or nutrigenomics@korea.ac.kr\nRelated manuscript: Submitted to Developmental and Comparative Immunology (DOI pending)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-05-23T07:13:40.141Z","url":"https://data.mendeley.com/datasets/bdhtkt2wpn","data_type":"dataset","access":"open","doi":["10.17632/bdhtkt2wpn"],"contributors":[{"first_name":"Kim","last_name":"Tae Yoon","orcid":null}],"funders":[],"categories":["Infectious Disease","Genomics","Bioinformatics","microRNA","Veterinary Biologics"],"journal_issn":[]}],"total_records":124216,"page":1,"page_size":10,"execution_time":138,"aggregations":{"data_type_stats":{"dataset":124216,"collection":0},"access_type_stats":{"open":123641,"restricted":63,"embargoed":512},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2134},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":646},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":444},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":407},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":399},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":392},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":387},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":306},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":241},{"id":"https://ror.org/00k4n6c32","name":"European Commission","count":212}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":121778},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1738},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":179},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":125},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":73},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":52},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":37},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":31},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":26}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":470},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":406},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":353},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":316},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":282}]}}