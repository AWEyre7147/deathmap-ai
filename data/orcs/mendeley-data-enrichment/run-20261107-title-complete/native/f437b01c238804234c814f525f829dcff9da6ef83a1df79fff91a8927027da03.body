{"records":[{"id":"8zg72dh86w","title":"Combinatorial gene essentiality and pharmacological profiling uncovers enhancer-mediated synthetic lethal interactions with Mediator Kinase","description":"This datasets contain all the original western blots published in \"Combinatorial gene essentiality and pharmacological profiling uncovers enhancer-mediated synthetic lethal interactions with Mediator Kinase\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-12-15T13:01:12.712Z","url":"https://data.mendeley.com/datasets/8zg72dh86w","data_type":"dataset","access":"open","doi":["10.17632/8zg72dh86w"],"contributors":[{"first_name":"Claire","last_name":"Sun","orcid":null},{"first_name":"Ron","last_name":"Firestein","orcid":null},{"first_name":"Dhanya","last_name":"Sooraj","orcid":null},{"first_name":"Aleks","last_name":"Guanizo","orcid":null},{"first_name":"Chunhua","last_name":"Wan","orcid":null},{"first_name":" Marius","last_name":"Dannappel ","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"c58c2f5b4t","title":"Supplementary Table 1.  The information of library (genes and sgRNAs) generated in this study","description":"This is the Supplementary Table 1 for the protocol of \"Fast and Efficient Generation of Dual-gRNA Library Facilitates Combinatorial CRISPR Screen for Discovering Synthetic Lethal Gene Pairs\" published at STAR Protocols.","source":{"id":"a6f239d0-5c78-4dcf-a8a0-aa9aaedb9fd1","name":"Mendeley Data","external":false},"publication_date":"2022-05-30T06:50:04.46Z","url":"https://data.mendeley.com/datasets/c58c2f5b4t","data_type":"dataset","access":"open","doi":["10.17632/c58c2f5b4t"],"contributors":[{"first_name":"Shan","last_name":"Tang","orcid":null}],"funders":[{"id":null,"name":"NA","grant_id":null}],"categories":["Cancer Systems Biology","Combinatorial Library","Synergism","Genomic Library","CRISPR"],"journal_issn":[]},{"id":"btv7g7n9ys","title":"mDLC_Spatial_Analysis_2023","description":"This dataset is associated with the study:\n“Spatial molecular profiling of mixed invasive ductal-lobular breast\ncancers reveals heterogeneity in intrinsic molecular subtypes, oncogenic\nsignatures, and mutations”.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-04T09:10:27.918Z","url":"https://data.mendeley.com/datasets/btv7g7n9ys","data_type":"dataset","access":"open","doi":["10.17632/btv7g7n9ys"],"contributors":[{"first_name":"Osama Shiraz","last_name":"Shah","orcid":null}],"funders":[],"categories":["Pathology","RNA Sequencing","DNA Mutation","Tumor Histology","Spatial Transcriptomics"],"journal_issn":[]},{"id":"bpcpfns6vb","title":"Global genetic interaction network of a human cell maps conserved principles and informs functional interpretation of gene co-essentiality profiles. Billmann et al.","description":"Deciphering how genes interact within human cells is essential for understanding their functional wiring and the development of targeted therapeutic strategies. In this study, we present a genome-scale map of genetic interactions in the human haploid cell line HAP1, based on CRISPR-based perturbation of ~ 4 million gene pairs. The resulting network comprises ~89,000 high-confidence gene-gene interactions, organizing genes into hierarchical modules corresponding to protein complexes and pathways, biological processes, and cellular compartments, mirroring principles observed in yeast and highlighting the functional architecture of a human cell. This large-scale genetic network complements the DepMap gene co-essentiality network by capturing unique functional information, uncovering roles of previously uncharacterized genes, and identifying molecular determinants of cancer cell line-specific genetic dependencies. This study presents a general data-driven strategy analysis for systematically exploring the roles of genes and their functional connections in human cell lines.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-18T10:15:12.084Z","url":"https://data.mendeley.com/datasets/bpcpfns6vb","data_type":"dataset","access":"open","doi":["10.17632/bpcpfns6vb"],"contributors":[{"first_name":"Maximilian","last_name":"Billmann","orcid":null},{"first_name":"Michael","last_name":"Costanzo","orcid":null},{"first_name":"Xiang","last_name":"Zhang","orcid":null},{"first_name":"Arshia Z.","last_name":"Hassan","orcid":null},{"first_name":"Mahfuzur","last_name":"Rahman","orcid":null},{"first_name":"Kevin R.","last_name":"Brown","orcid":null},{"first_name":"Katherine S.","last_name":"Chan","orcid":null},{"first_name":"Amy Hin Yan","last_name":"Tong","orcid":null},{"first_name":"Carles","last_name":"Pons","orcid":null},{"first_name":"Henry N.","last_name":"Ward","orcid":null},{"first_name":"Catherine","last_name":"Ross","orcid":null},{"first_name":"Jolanda","last_name":"van Leeuwen","orcid":null},{"first_name":"Michael","last_name":"Aregger","orcid":null},{"first_name":"Keith A.","last_name":"Lawson","orcid":null},{"first_name":"Barbara","last_name":"Mair","orcid":null},{"first_name":"Amy F.","last_name":"Roth","orcid":null},{"first_name":"Nesli E.","last_name":"Sen","orcid":null},{"first_name":"Duncan T.","last_name":"Forster","orcid":null},{"first_name":"Guihong","last_name":"Tan","orcid":null},{"first_name":"Patricia","last_name":"Mero","orcid":null},{"first_name":"Sanna N.","last_name":"Masud","orcid":null},{"first_name":"Yoonkyu","last_name":"Lee","orcid":null},{"first_name":"Magali","last_name":"Aguilera-Uribe","orcid":null},{"first_name":"Matej","last_name":"Usaj","orcid":null},{"first_name":"Sylvia M. T.","last_name":"Almeida","orcid":null},{"first_name":"Kamaldeep","last_name":"Aulakh","orcid":null},{"first_name":"Urvi","last_name":"Bhojoo","orcid":null},{"first_name":"Saba","last_name":"Birkadze","orcid":null},{"first_name":"Nathaniel","last_