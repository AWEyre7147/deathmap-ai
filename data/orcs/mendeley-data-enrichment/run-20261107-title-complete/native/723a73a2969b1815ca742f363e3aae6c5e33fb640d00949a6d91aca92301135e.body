{"records":[{"id":"2gpjp3mbs6","title":"SETDB1 suppresses NK cell-mediated immunosurveillance in acute myeloid leukemia with granulo-monocytic differentiation","description":"The data include full immunoblot images for \"SETDB1 suppresses NK cell-mediated immunosurveillance in acute myeloid leukemia with granulo-monocytic differentiation\".","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-05-15T07:05:55.464Z","url":"https://data.mendeley.com/datasets/2gpjp3mbs6","data_type":"dataset","access":"open","doi":["10.17632/2gpjp3mbs6"],"contributors":[{"first_name":"Yu-Hsuan","last_name":"Chang","orcid":null}],"funders":[],"categories":["Hematology","Leukemia","Western Blot","Epigenetics"],"journal_issn":[]},{"id":"mh32mymh62","title":"Pharmacologic inhibition of nonsense-mediated decay induces anti-tumour immunogenicity in ex vivo patient tumours","description":"Data and code for: Pharmacologic inhibition of nonsense-mediated decay induces anti-tumour immunogenicity in ex vivo patient tumours","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-02-05T06:29:38.029Z","url":"https://data.mendeley.com/datasets/mh32mymh62","data_type":"dataset","access":"open","doi":["10.17632/mh32mymh62"],"contributors":[{"first_name":"Roberto","last_name":"Vendramin","orcid":null}],"funders":[],"categories":["Biomedical Research"],"journal_issn":[]},{"id":"d2gynzkj42","title":"SMPaeds","description":"This collection provides processed data of the paper \"Stratified Medicine Paediatrics: Cell free DNA and serial tumour sequencing identifies subtype specific cancer evolution and epigenetic states\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-02-13T12:20:39.659Z","url":"https://data.mendeley.com/datasets/d2gynzkj42","data_type":"dataset","access":"open","doi":["10.17632/d2gynzkj42"],"contributors":[{"first_name":"Claire","last_name":"Lynn","orcid":null}],"funders":[],"categories":["Pediatric Oncology"],"journal_issn":[]},{"id":"234bfts2tb","title":"Raw, uncropped supporting Western blot files for: Moro L. et al. ... Pagano M., Epigenetic silencing of the ubiquitin ligase subunit FBXL7 impairs c-SRC degradation and promotes epithelial-to-mesenchymal transition and metastasis. Nature Cell Biol 2020","description":"Raw, uncropped supporting Western blot files for: Moro L. et al. ... Pagano M., Epigenetic silencing of the ubiquitin ligase subunit FBXL7 impairs c-SRC degradation and promotes epithelial-to-mesenchymal transition and metastasis. Nature Cell Biol 2020","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-09-26T05:45:13.782Z","url":"https://data.mendeley.com/datasets/234bfts2tb","data_type":"dataset","access":"open","doi":["10.17632/234bfts2tb"],"contributors":[{"first_name":"Michele","last_name":"Pagano","orcid":null},{"first_name":"Loredana","last_name":"Moro","orcid":null}],"funders":[],"categories":["Biochemistry","Cell Biology","Cancer","Western Blot"],"journal_issn":[]},{"id":"pch8nz49rc","title":"JMJD6-Mediated Epigenetic Silencing of Innate Immunity Promotes Pseudorabies Virus Replication","description":"Jumonji domain-containing protein 6 (JMJD6) has been implicated in epigenetic regulation. Here, we demonstrated that JMJD6 was upregulated during pseudorabies virus (PRV) infection and critically enhanced viral replication by promoting virion release. Mechanistically, JMJD6 suppressed PRV-induced histone H4K16 acetylation, a modification associated with chromatin relaxation and DNA damage response activation. This epigenetic modulation attenuated the cGAS–STING-mediated innate immune signaling pathway, leading to reduced interferon production and enhanced viral propagation. Furthermore, we identified METTL23 as a nuclear interactor of JMJD6 upon viral infection, revealing a cooperative role between these proteins in facilitating immune evasion. Importantly, administration of the JMJD6-specific inhibitor JMJD6-IN-1 potently activated innate immunity and restricted PRV replication in mice. Our findings unveil a novel epigenetic strategy employed by PRV to evade host antiviral responses and highlight JMJD6 as a potential therapeutic target for combating herpesvirus infections.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-22T14:10:39.018Z","url":"https://data.mendeley.com/datasets/pch8nz49rc","data_type":"dataset","access":"open","doi":["10.17632/pch8nz49rc"],"contributors":[{"first_name":"shengli","last_name":"ming","orcid":null}],"funders":[],"categories":["Virus"],"journal_issn":[]},{"id":"623s8b9vb4","title":"Aberrant epigenetic silencing of amplified genomic regions in ovarian cancer","description":"DCPM_analysis_BonitoEtAl2019.R: R script for data import and analysis\nSupplementaryAnalysis_BonitoEtAl2019.R: R script for analysis to produce supplementary figures and tables\nclinical_slide_all_ov.txt: TCGA cellularity data\nfull450k.rds: Illumina HumanMethylation450k annotation\nICGC_OV-AU_CNVbyCpG.rds: ICGC copy-number data matrix\nICGC_OV-AU_GX.rds: ICGC gene expression data matrix\nICGC_OV-AU_Meth.rds: ICGC DNA methylation data matrix\nIllumina27k_annotation2.rds: Illumina HumanMethylation27k detailed annotation\nIllumina27k_annotation.rds: Illumina HumanMethylation27k basic annotation\nsample.OV-AU.tsv: ICGC cellularity data (and sample ID table)\nTCGA_OV_CBS.rds: TCGA copy-number data matrix\nTCGA_OV_GX.rds: TCGA gene expression data matrix\nTCGA_OV_meth.rds: TCGA DNA methylation data matrix","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-06-14T11:24:33.371Z","url":"https://data.mendeley.com/datasets/623s8b9vb4","data_type":"dataset","access":"open","doi":["10.17632/623s8b9vb4"],"contributors":[{"first_name":"Ed","last_name":"Curry","orcid":null}],"funders":[],"categories":["Genomics","Ovarian Cancer","Transcriptomics","Epigenetics"],"journal_issn":[]},{"id":"f7dvb6232d","title":"Non-Thermal Atmospheric Pressure Plasma Induces Epigenetic Modifications that Activate the Expression of Various Cytokines and Growth Factors in Human Adipose Tissue-Derived Stem Cells","description":"In this study, by analyzing the whole genome expression profiles of NTAPP-activated ASCs with RNA-seq, we investigated the mechanism by which NTAPP increases the proliferation of ASCs in order to deduce the common mechanism underlying the physiological effects of NTAPP. We demonstrated that NTAPP increases the expression of genes associated with the activity of various cytokines and growth factors, and downregulates the genes involved in the intrinsic apoptotic pathway by inducing epigenetic modifications. We also showed that nitric oxide (NO) generated from NTAPP is a main component of epigenetic modification by NTAPP. The physiological mechanism of NTAPP proven in this study supports the development of NTAPP as an efficient tool for regenerative medicine.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-10-05T04:37:41.547Z","url":"https://data.mendeley.com/datasets/f7dvb6232d","data_type":"dataset","access":"open","doi":["10.17632/f7dvb6232d"],"contributors":[{"first_name":"Jeongyeon","last_name":"Park","orcid":null},{"first_name":"Kiwon","last_name":"Song","orcid":null}],"funders":[],"categories":["Plasma Application"],"journal_issn":[]},{"id":"wfm74g24d7","title":"miRRN_MEN1_GEP_NT","description":"\"MicroRNAs Regulatory Network governing the epigenetic landscape of MEN1 gastroenteropancreatic neuroendocrine tumour: a case report.\"\n\nSUPPLEMENTARY DATA TABLES\n\nTable 1: Raw_miRNA_counts.xls\nTable containing all the raw mature miRNA counts (according to miRBase 22.1) of the samples used in the current study.\n\nTable 2: Tumour_vs_Ctrl.xls\nTable containing the output results of differential expression analysis performed with DESeq2 by comparing tumour (gastrinomas+pNETs) and control MEN1 pancreas. Referred to Figure 4.\n\nTable 3: Gas_vs_Ctrl.xls\nTable containing the output results of differential expression analysis performed with DESeq2 by comparing gastrinomas and control MEN1 pancreas. Referred to Figure S1.\n\nTable 4: pNET_vs_Ctrl.xls\nTable containing the output results of differential expression analysis performed with DESeq2 by comparing pNETs and control MEN1 pancreas. Referred to Figure S2.\n\nTable 5: miRWalk_GSEA_results.xls\nTable containing the results of GSEA (Gene Set Enrichment Analysis) performed on the predicted targets of miRNA regulatory network hubs by miRWalk 3.0.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-24T09:20:42.675Z","url":"https://data.mendeley.com/datasets/wfm74g24d7","data_type":"dataset","access":"open","doi":["10.17632/wfm74g24d7"],"contributors":[{"first_name":"Luca","last_name":"Pandolfini","orcid":null},{"first_name":"Ettore","last_name":"Luzi","orcid":null}],"funders":[],"categories":["Bioinformatics","MicroRNA","Neuroendocrine Tumor"],"journal_issn":[]},{"id":"98ywc24xv7","title":"The histone acetyltransferase Mst2 protects active chromatin from epigenetic silencing by acetylating the ubiquitin ligase Brl1. Flury et al.","description":"Raw data Flury et al, Molecular Cell, 2017\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-12-17T17:15:39.923Z","url":"https://data.mendeley.com/datasets/98ywc24xv7","data_type":"dataset","access":"open","doi":["10.17632/98ywc24xv7"],"contributors":[{"first_name":"Marc","last_name":"Buehler","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"z5b6zzr44g","title":"Hypoxia stabilizes SETDB1 to maintain genome stability","description":"Unprocessed data of 'Hypoxia stabilizes SETDB1 to maintain genome stability'","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-08T12:55:45.861Z","url":"https://data.mendeley.com/datasets/z5b6zzr44g","data_type":"dataset","access":"open","doi":["10.17632/z5b6zzr44g"],"contributors":[{"first_name":"Sungryul","last_name":"Park","orcid":null}],"funders":[],"categories":["Molecular Biology"],"journal_issn":[]}],"total_records":43241,"page":1,"page_size":10,"execution_time":58,"aggregations":{"data_type_stats":{"dataset":43241,"collection":0},"access_type_stats":{"open":43167,"restricted":29,"embargoed":45},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":814},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":317},{"id":"https://ror.org/03ha2q922","name":"National Science Centre","count":210},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":186},{"id":"https://ror.org/03swz6y49","name":"Conselho Nacional de Desenvolvimento Científico e Tecnológico","count":168},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":164},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":161},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":146},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":131},{"id":"https://ror.org/00k4n6c32","name":"European Commission","count":97}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":42179},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":732},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":104},{"id"