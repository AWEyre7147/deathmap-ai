t_name":"Ira","last_name":"Horecka","orcid":null},{"first_name":"Kristin","last_name":"Kantautas","orcid":null},{"first_name":"Fenghu","last_name":"Ji","orcid":null},{"first_name":"Dae-Kyum","last_name":"Kim","orcid":null},{"first_name":"Seon Yong","last_name":"Lee","orcid":null},{"first_name":"Wendy","last_name":"Liang","orcid":null},{"first_name":"Hyobin Julianne","last_name":"Lim","orcid":null},{"first_name":"Kevin","last_name":"Lin","orcid":null},{"first_name":"Xueyibing","last_name":"Lu","orcid":null},{"first_name":"Michael","last_name":"Maier","orcid":null},{"first_name":"Babak","last_name":"Nami","orcid":null},{"first_name":"Allison","last_name":"Nixon","orcid":null},{"first_name":"Nicholas","last_name":"Mikolajewicz","orcid":null},{"first_name":"Milad","last_name":"Mokhtaridoost","orcid":null},{"first_name":"Lyudmila","last_name":"Nedyalkova","orcid":null},{"first_name":"Thomas","last_name":"Rohde","orcid":null},{"first_name":"Maria","last_name":"Sartori Rodrigues","orcid":null},{"first_name":"Martin","last_name":"Soste","orcid":null},{"first_name":"Eric","last_name":"Schultz","orcid":null},{"first_name":"Wen","last_name":"Wang","orcid":null},{"first_name":"Ashwin","last_name":"Seetharaman","orcid":null},{"first_name":"Ermira","last_name":"Shuteriqi","orcid":null},{"first_name":"Olga","last_name":"Sizova","orcid":null},{"first_name":"David","last_name":"Thomson Taylor","orcid":null},{"first_name":"Maria","last_name":"Tereshchenko","orcid":null},{"first_name":"David","last_name":"Tieu","orcid":null},{"first_name":"Jacob","last_name":"Turowec","orcid":null},{"first_name":"Tajinder","last_name":"Ubhi","orcid":null},{"first_name":"Sylvia","last_name":"Varland","orcid":null},{"first_name":"Kyle E.","last_name":"Wang","orcid":null},{"first_name":"Zi Yang","last_name":"Wang","orcid":null},{"first_name":"Jiarun","last_name":"Wei","orcid":null},{"first_name":"YUXI","last_name":"XIAO","orcid":null},{"first_name":"Philipp G.","last_name":"Maass","orcid":null},{"first_name":"Bruno","last_name":"Reversade","orcid":null},{"first_name":"Grant W.","last_name":"Brown","orcid":null},{"first_name":"Bejamin F.","last_name":"Cravatt","orcid":null},{"first_name":"Scott","last_name":"Dixon","orcid":null},{"first_name":"Haley D. M.","last_name":"Wyatt","orcid":null},{"first_name":"Hannes L.","last_name":"Röst","orcid":null},{"first_name":"Frederick P.","last_name":"Roth","orcid":null},{"first_name":"Tian","last_name":"Xia","orcid":null},{"first_name":"Gary D.","last_name":"Bader","orcid":null},{"first_name":"Robbie","last_name":"Loewith","orcid":null},{"first_name":"Nicholas G.","last_name":"Davis","orcid":null},{"first_name":"Brenda","last_name":"Andrews","orcid":null},{"first_name":"Chad","last_name":"Myers","orcid":null},{"first_name":"Jason","last_name":"Moffat","orcid":null},{"first_name":"Charles","last_name":"Boone","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"MOP_142735"},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","grant_id":"MCB1818293"},{"id":"https://ror.org/01h531d29","name":"Natural Sciences and Engineering Research Council of Canada","grant_id":"RGPIN-2020-04180"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT 173542"},{"id":"https://ror.org/000az4664","name":"Canada Foundation for Innovation","grant_id":"39977"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE09-011"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE011-006"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-180285"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-GMX-463531"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2024-08-02"},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","grant_id":"DFG Bi 2086/1-1"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG005084"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2022-02"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG00583"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"T32GM008347"},{"id":null,"name":"NIH/NCI Ruth L. Kirschstein National Research F30 Award","grant_id":"5F30CA257227"}],"categories":["Genetics","Biological Network"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"835fcfbvhs","title":"Preparation of CRISPR/Cas9 and gRNA plasmids","description":"Human genome engineering has been transformed by the introduction of the CRISPR (clustered regularly interspaced short palindromic repeats)/Cas (CRISPR-associated) system found in most bacteria and archaea. Type II CRISPR/Cas systems have been engineered to induce RNA-guided genome editing in human cells, where small RNAs function together with Cas9 nucleases for sequence-specific cleavage of target sequences. Here we describe the protocol for Cas9-mediated human genome engineering, including construct building and transfection methods necessary for delivering Cas9 and guide RNA (gRNA) into human-induced pluripotent stem cells (hiPSCs) and HEK293 cells. Following genome editing, we also describe methods to assess genome editing effi- ciency using next-generation sequencing and isolate monoclonal hiPSCs with the desired modifications for downstream applications. Keywords: genome engineering • CRISPR • human stem cells","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2016-12-12T12:58:15.307Z","url":"https://data.mendeley.com/datasets/835fcfbvhs","data_type":"dataset","access":"open","doi":["10.17632/835fcfbvhs"],"contributors":[{"first_name":"George","last_name":"Church","orcid":null}],"funders":[],"categories":["Experimental Method"],"journal_issn":[]},{"id":"xn3vv2cdnk","title":"High-throughput CRISPR screens to dissect macrophage-Shigella interactions","description":"The positive hits, negative hits, and non-targeting controls of genome-wide CRISPR screens; Supplemental Tables.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-07-23T06:18:30.182Z","url":"https://data.mendeley.com/datasets/xn3vv2cdnk","data_type":"dataset","access":"open","doi":["10.17632/xn3vv2cdnk"],"contributors":[{"first_name":"Yong","last_name":"LAI","orcid":null}],"funders":[],"categories":["Genetic Screening","Host-Pathogen Interaction","CRISPR"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"hfbhym45fz","title":"CRISPR screening reveals a requirement for ribosome recycling in efficient SARS-CoV-2 programmed ribosomal frameshifting and viral replication. Rehfeld et al.","description":"Supplemental Table S1. Results of SARS-CoV-2 programmed ribosomal frameshifting genome-wide CRISPR screens (MAGeCK analysis).\nSupplemental Table S2. Oligonucleotides.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-01-19T12:17:58.922Z","url":"https://data.mendeley.com/datasets/hfbhym45fz","data_type":"dataset","access":"open","doi":["10.17632/hfbhym45fz"],"contributors":[{"first_name":"Joshua","last_name":"Mendell","orcid":null},{"first_name":"Frederick","last_name":"Rehfeld","orcid":null}],"funders":[{"id":"https://ror.org/0003xa228","name":"Cancer Prevention and Research Institute of Texas","grant_id":"RP220309"},{"id":"https://ror.org/00np6vq88","name":"Welch Foundation","grant_id":"I-1961-20210327"},{"id":"https://ror.org/006w34k90","name":"Howard Hughes Medical Institute","grant_id":null}],"categories":["Oligonucleotide","CRISPR"],"journal_issn":[]},{"id":"wjdntc39sp","title":"Genome assembly, quality-control, annotation, and phylogenomic data for Pediococcus acidilactici strain AP1 isolated from common carp","description":"Description\nThis dataset contains quality-control reports, genome assembly files, structural and functional genome annotations, CRISPR-Cas analysis results, and genome-based phylogenetic data for Pediococcus acidilactici strain AP1. Strain AP1 was isolated from the intestinal tract of a healthy common carp (Cyprinus carpio) collected from a fish farm in the Tashkent region, Uzbekistan. Whole-genome sequencing was performed using the Illumina MiSeq i100 Plus platform with paired-end sequencing. Reads were quality assessed using FastQC and filtered using fastp. De novo assembly was performed using SPAdes. Assembly quality was evaluated using QUAST, BUSCO, and\nCheckM2. Structural and functional annotation was performed using PGAP, Prokka, RAST, eggNOG-mapper, and InterProScan. CRISPR-Cas loci were evaluated using CRISPRCasFinder, and genome-based phylogenetic analysis was performed using TYGS.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-09-11T00:06:05.284Z","url":"https://data.mendeley.com/datasets/wjdntc39sp","data_type":"dataset","access":"open","doi":["10.17632/wjdntc39sp"],"contributors":[{"first_name":"Murodali","last_name":"Boboqulov","orcid":null},{"first_name":"Fazliddin","last_name":"Kobilov","orcid":null}],"funders":[],"categories":["Genome Annotation"],"journal_issn":[]},{"id":"nxvdzybwhf","title":"Illuminating host-mycobacterial interactions with genome-wide CRISPR knockout and CRISPRi screens","description":"The data deposited here contains genome-wide CRISPR knockout and CRISPRi screen data, including the positive hits, the negative hits, and non-targeting controls. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-30T11:32:01.108Z","url":"https://data.mendeley.com/datasets/nxvdzybwhf","data_type":"dataset","access":"open","doi":["10.17632/nxvdzybwhf"],"contributors":[{"first_name":"Yong","last_name":"Lai","orcid":null}],"funders":[],"categories":["Functional Genomics","High-Throughput Sequencing","Tuberculosis"],"journal_issn":[]}],"total_records":139185,"page":1,"page_size":10,"execution_time":144,"aggregations":{"data_type_stats":{"dataset":139185,"collection":0}