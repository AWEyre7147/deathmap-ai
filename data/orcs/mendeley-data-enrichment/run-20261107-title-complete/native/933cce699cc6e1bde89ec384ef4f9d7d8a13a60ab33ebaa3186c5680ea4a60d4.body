{"records":[{"id":"st7hsjzfw6","title":"PQQ","description":"This data is for article “Pyrroloquinoline quinone production with methanol as substrate by Hyphomicrobium sp. CGX1 screened based on high-throughput fluorescence-activated cell sorting”","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-12-18T07:36:56.045Z","url":"https://data.mendeley.com/datasets/st7hsjzfw6","data_type":"dataset","access":"open","doi":["10.17632/st7hsjzfw6"],"contributors":[{"first_name":"Daoyang","last_name":"Zhu","orcid":null}],"funders":[],"categories":["Fermentation"],"journal_issn":[]},{"id":"h8kty9jmf7","title":"Surfaces with instant and persistent antimicrobial efficacy against bacteria and SARS-CoV-2. Dhyani et al.","description":"Movie S1. Fluorescence microscopy. High-speed disinfection of E. coli on PU+35%AT in comparison to polyurethane control. The live E. coli cells appear green, while the deal E. coli cells appear red.\n\nMovie S2. Cell phone contamination experiment. Cell phone screen coated with PU+35%AT (thickness = 200 ± 50 μm) maintains its touch screen functionality.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-08-08T15:56:26.551Z","url":"https://data.mendeley.com/datasets/h8kty9jmf7","data_type":"dataset","access":"open","doi":["10.17632/h8kty9jmf7"],"contributors":[{"first_name":"Abhishek","last_name":"Dhyani","orcid":null},{"first_name":"Taylor","last_name":"Repetto","orcid":null},{"first_name":"Dylan","last_name":"Bartikofsky","orcid":null},{"first_name":"Carmen","last_name":"Mirabelli","orcid":null},{"first_name":"Zoe","last_name":"Gao","orcid":null},{"first_name":"Sarah","last_name":"Snyder","orcid":null},{"first_name":"Catherine","last_name":"Snyder","orcid":null},{"first_name":"Geeta","last_name":"Mehta","orcid":null},{"first_name":"Christiane","last_name":"Wobus","orcid":null},{"first_name":"J. Scott","last_name":"VanEpps","orcid":null},{"first_name":"Anish","last_name":"Tuteja","orcid":null}],"funders":[],"categories":["Bacteria","Fluorescence Microscopy","Antimicrobial"],"journal_issn":[]},{"id":"n3b6vwyt7b","title":"Gene expression profile at single cell level of fibroblasts from untreated (UT) and imiquimod (IMQ)-induced mouse skin.","description":"We used single-cell RNA sequencing (scRNA-seq) to analyze the heterogeneity of dermal fibroblasts in homeostasis and skin inflammation. Dermal fibroblasts of the UT/IMQ-induced PdgfraDreER-tdTomato mice were isolated by Fluorescence-activated cell sorting (FACS) according to the presence or absence of tdTomato signal and analyzed using scRNA-seq.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-01-15T16:02:55.562Z","url":"https://data.mendeley.com/datasets/n3b6vwyt7b","data_type":"dataset","access":"open","doi":["10.17632/n3b6vwyt7b"],"contributors":[{"first_name":"Xiaojie","last_name":"Cai","orcid":null}],"funders":[],"categories":["Fibroblast","Pathophysiology of Psoriasis","Single-Cell Transcriptomics"],"journal_issn":[]},{"id":"h6vzp3vwnh","title":"SP6_RNAP_FADS_FCS-files","description":"FCS files for fluorescence activated droplet sorting of SP6 RNA polymerase variants","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-18T10:40:13.32Z","url":"https://data.mendeley.com/datasets/h6vzp3vwnh","data_type":"dataset","access":"open","doi":["10.17632/h6vzp3vwnh"],"contributors":[{"first_name":"Naohiro","last_name":"Terasaka","orcid":null}],"funders":[],"categories":["Screening","Droplet","Cell Sorter"],"journal_issn":[]},{"id":"d5z3gt7xs9","title":"High-speed single molecule imaging of membrane proteins in rat basophilic leukemia cells. ","description":"A high-speed fluorescence microscope operating at a 490 Hz frame rate was used to image two different membrane proteins- the high-affinity IgE receptor FcεRI, a transmembrane protein, and an outer-leaflet GPI-anchored protein. The IgE receptor was imaged via IgE labeled with Janelia Fluor 646 and the GPI-anchored protein was imaged using a GPI-GFP fusion protein and an ATTO647N labeled anti-GFP nanobody. Data was collected for both proteins in untreated cells and cells that had actin stabilized by phalloidin.  ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-03-02T16:01:30.143Z","url":"https://data.mendeley.com/datasets/d5z3gt7xs9","data_type":"dataset","access":"open","doi":["10.17632/d5z3gt7xs9"],"contributors":[{"first_name":"Keith","last_name":"Lidke","orcid":null}],"funders":[],"categories":["Biophysics"],"journal_issn":[]},{"id":"4fjy5c4ng3","title":"Data for Strain localization in hydraulic fracturing of granite specimens based on DIC method","description":"The high-speed camera images of HY-30-90-A used in this paper, including the reference image, region of interest and other 177 images in sequence inTIF format. The image numbered 68545 is the first frame with macro cracks. The original data collected by the high-speed camera is too large to include, and is available upon request.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-10-11T17:40:50.505Z","url":"https://data.mendeley.com/datasets/4fjy5c4ng3","data_type":"dataset","access":"open","doi":["10.17632/4fjy5c4ng3"],"contributors":[{"first_name":"Jinquan","last_name":"Xing","orcid":null}],"funders":[],"categories":["Hydraulic Fracturing","Rock"],"journal_issn":[]},{"id":"h72f6mf6z9","title":"Additional SI item","description":"Additional SI item. Scheme of neurite and synapse quantification. Related to Figure 4.\n(A) Representative image of Tuj-1 immunofluorescence and DAPI staining. (B) Binary neuron image converted from the Tuj-1 fluorescence image by thresholding. (C) Binary nuclear image converted from the DAPI fluorescence image by thresholding. (D) Magnified views of the boxed area in panel A. (E) Merged image of the original and segmented neurites. (F) Binary image of neurons that was skeletonized to obtain a neurite image. (G) Schematic of the segmentation of the synapse adjoining neurons; neuron and synapse were segmented from cytosol-expressing mCherry and synapsin fluorescence image. Synapses were selected by synapse puncta adjoining neurons. (H) Fluorescence image of neurons expressing mCherry. (I) Fluorescence image of the synapse marker synapsin. (J) Merged image of mCherry and synapsin fluorescence. (K) Merged image of original and segmented neurites (blue) and synapses adjoining neurons (black dots with a yellow outline). Scale bars: 200 μm (A), 40 μm (D) and 50 μm (H).\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-10-17T08:39:58.171Z","url":"https://data.mendeley.com/datasets/h72f6mf6z9","data_type":"dataset","access":"open","doi":["10.17632/h72f6mf6z9"],"contributors":[{"first_name":"Ryu","last_name":"Yamanaka","orcid":null},{"first_name":"Yutaka","last_name":"Shindo","orcid":null},{"first_name":"Kohji","last_name":"Hotta","orcid":null},{"first_name":"Koji","last_name":"Suzuki","orcid":null},{"first_name":"Kotaro","last_name":"Oka","orcid":null}],"funders":[],"categories":["Neuroscience","Cell Biology"],"journal_issn":["09609822"]},{"id":"y6f2tm669y","title":"Diagnostic accuracy of two-photon fluorescence microscopy in Mohs surgery of basal cell carcinomas","description":"This is supplementary data for the manuscript \"Diagnostic accuracy of two-photon fluorescence microscopy in Mohs surgery of basal cell carcinomas\" published in the Journal of the American Academy of Dermatology, including a list of specimens analyzed and direct links to the image data.  ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-05-05T12:50:04.378Z","url":"https://data.mendeley.com/datasets/y6f2tm669y","data_type":"dataset","access":"open","doi":["10.17632/y6f2tm669y"],"contributors":[{"first_name":"Michael","last_name":"Giacomelli","orcid":null},{"first_name":"Beverly","last_name":"Faulkner-Jones","orcid":null},{"first_name":"Daihung","last_name":"Do","orcid":null}],"funders":[{"id":"https://ror.org/040gcmg81","name":"National Cancer Institute","grant_id":"K22-CA226035, R01-CA178636, R37-CA258376"}],"categories":["Two-Photon Microscopy","Non-Melanoma Skin Cancer"],"journal_issn":[]},{"id":"vbpdtyxbtn","title":"Data for: Antiparallel dimer structure of CELSR cadherin in solution revealed by high-speed atomic force microscopy","description":"The data set includes raw data of image files of human CELSR2 cadherin ectodomains acquired by high-speed atomic force microscope in solution, image files of bead aggregation assay, and numerical data analyzed from these images.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-03-20T21:08:50.322Z","url":"https://data.mendeley.com/datasets/vbpdtyxbtn","data_type":"dataset","access":"open","doi":["10.17632/vbpdtyxbtn"],"contributors":[{"first_name":"Shigetaka","last_name":"Nishiguchi","orcid":null},{"first_name":"Rinshi S.","last_name":"Kasai","orcid":null},{"first_name":"Takayuki","last_name":"Uchihashi","orcid":null}],"funders":[],"categories":["Atomic Force Microscopy"],"journal_issn":[]},{"id":"6xjzvcj774","title":"Data for: Multiple dimeric structures and strand-swap dimerization of E-cadherin in solution visualized by high-speed atomic force microscopy","description":"The data set includes raw data of image files of mouse E-cadherin ectodomains acquired by high-speed atomic force microscope in solution, pseudo-AFM image files of cadherins and numerical data analyzed from these images.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","exter