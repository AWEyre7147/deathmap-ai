{"records":[{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"nnxh5d35nd","title":"Genome-wide CRISPR-Cas9 screen identified KLF11 as a druggable suppressor for sarcoma cancer stem cells","description":"The original, unprocessed data alongside the paper","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-05-31T01:39:45.722Z","url":"https://data.mendeley.com/datasets/nnxh5d35nd","data_type":"dataset","access":"open","doi":["10.17632/nnxh5d35nd"],"contributors":[{"first_name":"Le","last_name":"Qu","orcid":null}],"funders":[],"categories":["Cancer"],"journal_issn":[]},{"id":"65pfcj4j4m","title":"Protocol of CRISPR-Cas9 knockout screens for identifying ferroptosis regulators","description":"Ferroptosis, an iron-dependent programmed cell death triggered by excessive lipid peroxidation, has shown promising therapeutic potentials in human diseases. Here, we describe a protocol of a CRISPR-Cas9 loss-of-function screen to identify regulators in response to different inducers of ferroptosis. We emphasize the steps of library amplification, drug treatment, high-throughput sequencing preparation, and bioinformatics analysis using Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK). We also present a method to discover the regulators of ferroptosis and verify the potential targets efficiently.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-24T01:46:48.793Z","url":"https://data.mendeley.com/datasets/65pfcj4j4m","data_type":"dataset","access":"open","doi":["10.17632/65pfcj4j4m"],"contributors":[{"first_name":"Xin","last_name":"Yang","orcid":null},{"first_name":"Wei","last_name":"Gu","orcid":null}],"funders":[],"categories":["CRISPR/Cas9","Ferroptosis"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"s3jtdhjdbs","title":"Supplementary data for Michaelis et al., 'Protein import motor complex reacts to mitochondrial misfolding by reducing protein import and activating mitophagy'","description":"Supplementary data for Michaelis et al., 'Mitochondrial import loss induces mitophagy without membrane depolarization'. We hypothesized that inhibition of mitochondrial protein import induced mitophagy independent of mitochondrial depolarization. This dataset contains raw Illumina sequencing data for all samples from a genome-wide CRISPR/Cas9 screen for mitophagy regulators. The genome-wide library is Brunello from Doench et al Nat Biotechnol. 2016. We found that the pre-sequence translocase-associated motor complex PAM controls mitophagy induction. Loss of PAM caused a loss in protein import and was sufficient to induce mitophagy without depolarization.\nThe samples have been sequenced on an Illumina NextSeq 500 in single end mode with 75+8 cycles. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-08-05T15:38:53.752Z","url":"https://data.mendeley.com/datasets/s3jtdhjdbs","data_type":"dataset","access":"open","doi":["10.17632/s3jtdhjdbs"],"contributors":[{"first_name":"Jonas","last_name":"Michaelis","orcid":null},{"first_name":"Melinda","last_name":"Brunstein","orcid":null},{"first_name":"Süleyman","last_name":"Bozkurt","orcid":null},{"first_name":"Ludovico","last_name":"Alves","orcid":null},{"first_name":"Martin","last_name":"Wegner","orcid":null},{"first_name":"Manuel","last_name":"Kaulich","orcid":null},{"first_name":"Christian","last_name":"Pohl","orcid":null},{"first_name":"Christian","last_name":"Münch","orcid":null}],"funders":[],"categories":["Proteomics","Mitochondrion","Mitophagy","Genetic Screening","Next Generation Sequencing","CRISPR/Cas9"],"journal_issn":[]},{"id":"zhpg8xshp9","title":"Lawrence et al., PNAS 2026","description":"Data from “Lawrence et al., 2026 A Genome-Wide Screen Identifies that PLCG2 Restrains Lysosomal GCase Activity.\"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-22T18:23:16.389Z","url":"https://data.mendeley.com/datasets/zhpg8xshp9","data_type":"dataset","access":"open","doi":["10.17632/zhpg8xshp9"],"contributors":[{"first_name":"Baris","last_name":"Bingol","orcid":null}],"funders":[],"categories":["Natural Sciences"],"journal_issn":[]},{"id":"66ms37y66x","title":"Data for: A genome-wide CRISPR/Cas9 screen reveals that riboflavin regulates hydrogen peroxide entry into HAP1 cells  ","description":"CRISPR screen data for hydrogen peroxide mediated cell death","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-02-13T14:30:16.414Z","url":"https://data.mendeley.com/datasets/66ms37y66x","data_type":"dataset","access":"open","doi":["10.17632/66ms37y66x"],"contributors":[{"first_name":"surachai","last_name":"supattapone","orcid":null},{"first_name":"Kenneth","last_name":"Mark","orcid":null},{"first_name":"Tamutenda","last_name":"Chidawanyika","orcid":null}],"funders":[],"categories":["Oxidative Stress"],"journal_issn":[]},{"id":"nxvdzybwhf","title":"Illuminating host-mycobacterial interactions with genome-wide CRISPR knockout and CRISPRi screens","description":"The data deposited here contains genome-wide CRISPR knockout and CRISPRi screen data, including the positive hits, the negative hits, and non-targeting controls. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-30T11:32:01.108Z","url":"https://data.mendeley.com/datasets/nxvdzybwhf","data_type":"dataset","access":"open","doi":["10.17632/nxvdzybwhf"],"contributors":[{"first_name":"Yong","last_name":"Lai","orcid":null}],"funders":[],"categories":["Functional Genomics","High-Throughput Sequencing","Tuberculosis"],"journal_issn":[]},{"id":"75brhkh25r","title":"A genome-wide hepatocyte CRISPR-CAS9 screen to identify host factors essential for optimal Plasmodium liver stage development. ","description":"To identify host genes critical for Plasmodium LS development, we used the GeCKOv2 sgRNA pool to generate a whole-genome knockout library in HepG2-CD81 cells (Sanjana et al., 2014; Shalem et al., 2014). HepG2-CD81 cells were transduced with lentivirus containing the pooled GeCKOv2 sgRNA library of 114,123 sgRNAs targeting 19,031 protein-coding genes (~6 sgRNAs/gene) and selected in puromycin for 5-7 days. To evaluate sgRNA diversity in the HepG2-CD81-GeCKOv2 library, we PCR-amplified the integrated sgRNA cassettes from genomic DNA extracted from transduced cells and subjected the amplified library to Illumina sequencing. At the gene level, sgRNAs targeting all but 15 of 19,031 (99.92%) protein-coding genes were observed. Twelve to fourteen days after post-transduction, we infected forty million puromycin-resistant cells with a green fluorescent protein (GFP) expressing-Plasmodium yoelii at a multiplicity of infection (MOI) of 0.3. After 24 h of infection, cells were sorted into infected and bystander cell populations by GFP signal intensity with fluorescence-activated cell sorting (FACS). Separately, a parallel culture of uninfected cells was also maintained to normalize the sgRNA frequency distributions. We obtained four independent biological replicates with library generation and sequencing occurring in parallel. Genes with significantly enriched sgRNAs were identified for both the bystander and infected populations when compared to uninfected cells. Cells that harbor genetic alterations restricting P. yoelii development (i.e., sgRNAs that target host genes important for infection) were expected to be enriched in the uninfected bin; we termed this group ‘putative positive regulators of infection’. We categorized sgRNAs enriched in the infected cells as ‘putative negative regulators of infection’. In this initial screen, we identified 242 sgRNAs that were statistically enriched in infected or bystander groups after accounting for multiple hypotheses. There were 67 sgRNAs significantly enriched in the infected cells compared to uninfected cells and 175 genes were significantly enriched in the bystander bin relative to the uninfected bin. \n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-27T07:31:54.012Z","url":"https://data.mendeley.com/datasets/75brhkh25r","data_type":"dataset","access":"open","doi":["10.17632/75brhkh25r"],"contributors":[{"first_name":"Kamalakannan","last_name":"Vijayan","orcid":null},{"first_name":"Nadia","last_name":"Arang","orcid":null},{"first_name":"Ling ","last_name":"Wei","orcid":null},{"first_name":"Robert","last_name":"Morrison","orcid":null},{"first_name":"Rechel ","last_name":"Geiger","orcid":null},{"first_name":"Rachael ","last_name":"Parks","orcid":null},{"first_name":"Adam J ","last_name":"Lewis","orcid":null},{"first_name":"Fred D ","last_name":"Mast ","orcid":null},{"first_name":"Alyse N ","last_name":"Douglass","orcid":null},{"first_name":"Heather S ","last_name":"Kain","orcid":null},{"first_name":"John D","last_name":"Aitchison ","orcid":null},{"first_name":"Jarrod S ","last_name":"Johnson","orcid":null},{"first_name":"Alan ","last_name":"Aderem","orcid":null},{"first_name":"Alexis","last_name":"Kaushansky","orcid":null}],"funders":[],"categories":["CRISPR/Cas9"],"journal_issn":[]},{"id":"835fcfbvhs","title":"Preparation of CRISPR/Cas9 and gRNA plasmids","description":"Human genome engineering has been transformed by the introduction of the CRISPR (clustered regularly interspaced short palindromic repeats)/Cas (CRISPR-associated) system found in most bacteria and archaea. Type II CRISPR/Cas systems have been engineered to induce RNA-guided genome editing in human cells, where small RNAs function together with Cas9 nucleases for sequence-specific cleavage of target sequences. Here we describe the protocol for Cas9-mediated human genome engineering, including construct building and transfection methods necessary for delivering Cas9 and guide RNA (gRNA) into human-induced pluripotent stem cells (hiPSCs) and HEK293 cells. Following genome editing, we also describe methods to assess genome editing effi- ciency using next-generation sequencing and isolate monoclonal hiPSCs with the desired modifications for downstream applications. Keywords: genome engineering • CRISPR • human stem cells","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2016-12-12T12:58:15.307Z","url":"https://data.mendeley.com/datasets/835fcfbvhs","data_type":"dataset","access":"open","doi":["10.17632/835fcfbvhs"],"contributors":[{"first_name":"George","last_name":"Church","orcid":null}],"funders":[],"categories":["Experimental Method"],"journal_issn":[]}],"total_records":121491,"page":1,"page_size":10,"execution_time":154,"aggregations":{"data_type_stats":{"dataset":121491,"collection":0},"access_type_stats":{"open":121012,"restricted":59,"embargoed":420},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":1914},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":606},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":431},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":387},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":380},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":369},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":347},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":309},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":305},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":219}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":118972},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1862},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":159},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":121},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":66},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":65},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":52},{"id":"b121dfec-bb51-4f19-