{"records":[{"id":"hnyv7cy4tm","title":"KAP1 regulates regulatory T cell function and proliferation in both Foxp3-dependent and -independent manner","description":"We found that KAP1 is a co-factor of Foxp3 in mouse regulatory T cells. Treg specific KAP1 deficient mouse developed the inflammatory disease spontaneously. the data here is the unprocessed data which were used in the paper.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2017-11-13T22:32:13.745Z","url":"https://data.mendeley.com/datasets/hnyv7cy4tm","data_type":"dataset","access":"open","doi":["10.17632/hnyv7cy4tm"],"contributors":[{"first_name":"Shigeru","last_name":"Tanaka","orcid":null},{"first_name":"Steven","last_name":"Ziegler","orcid":null}],"funders":[],"categories":["Polymerase Chain Reaction"],"journal_issn":[]},{"id":"trjgk9nmrk","title":"Tri-Functional CRISPR Screen Reveals Overexpression of QDR2 and QDR3 Transporters Increase Fumaric Acid Production in Kluyveromyces marxianus ","description":"Dataset for the manuscript \"Tri-Functional CRISPR Screen Reveals Overexpression of QDR2 and QDR3 Transporters Increase Fumaric Acid Production in Kluyveromyces marxianus \"","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-11-24T15:11:41.893Z","url":"https://data.mendeley.com/datasets/trjgk9nmrk","data_type":"dataset","access":"open","doi":["10.17632/trjgk9nmrk"],"contributors":[{"first_name":"Mackenzie","last_name":"Thornbury","orcid":null},{"first_name":"Raha","last_name":"Parvizi Omran","orcid":"0000-0002-8166-4268"},{"first_name":"Lalit","last_name":"Kumar","orcid":"0009-0002-1392-2859"},{"first_name":"Adrien","last_name":"Knoops","orcid":"0000-0002-6250-906X"},{"first_name":"Raghad","last_name":"Abushahin","orcid":null},{"first_name":"Malcolm","last_name":"Whiteway","orcid":"0000-0001-6619-7983"},{"first_name":"Vincent","last_name":"Martin","orcid":"0000-0001-7511-115X"}],"funders":[],"categories":["Synthetic Biology","Yeast","Metabolic Engineering","Organic Acid","Kluyveromyces","CRISPR"],"journal_issn":[]},{"id":"b4wczz76gf","title":"Comprehensive mapping of key regulatory networks that drive oncogene expression","description":"Raw data deposit for manuscript \"Comprehensive mapping of key regulatory networks that drive oncogene expression\" including:\n1. CRISPR screen raw .fastq files\n2. Orignal gel images\n3. Raw datasets and statistics analysis for all bar plots\n4. TCGA datasets for plotting\nFor CRISPR screen raw read counts, MAGeCK processed comparisons and code deposit, please refer to the supplementary documents of the publication.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-11-16T17:38:30.826Z","url":"https://data.mendeley.com/datasets/b4wczz76gf","data_type":"dataset","access":"open","doi":["10.17632/b4wczz76gf"],"contributors":[{"first_name":"Lin","last_name":"Lin","orcid":null}],"funders":[],"categories":["Big Data","Screening","Guide RNA","CRISPR/Cas9"],"journal_issn":[]},{"id":"2btzwwvyy5","title":"Molecular and cellular composition changes after neoadjuvant letrozole and palbociclib in early luminal breast cancer","description":"The NeoPAL trial compares neoadjuvant letrozole-palbociclib (LP) with chemotherapy (CT) in 103 patients with high-risk early luminal breast cancer. At surgery, the Nanostring BC360™ proliferation score and Ki67 expression are reduced in both arms, together with upregulation of immune-related signatures. Overall, there is very little difference in the changes observed with LP as compared to CT, even in signatures related to response to estrogen - CDK4/6 manipulation. Deconvolution of bulk RNA-seq data reveals high content at baseline in cancer cells, immunosuppressive cancer-associated fibroblasts, FOXP3+ CD4+ regulatory T lymphocytes and TREM2+ macrophages. In contrast, myoepithelial cells, normal-like fibroblasts, FOLR2+ macrophages and SELL+ CD4+ T lymphocytes accumulate after treatment in both arms. A low-ROR score is observed at surgery in 63.3% and 43.5% of patients in LP and CT arms, respectively. No 3-year breast cancer-specific survival event is observed in these patients. These data provide a rationale for chemotherapy-sparing trials in this setting","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-11-11T21:48:42.289Z","url":"https://data.mendeley.com/datasets/2btzwwvyy5","data_type":"dataset","access":"open","doi":["10.17632/2btzwwvyy5"],"contributors":[{"first_name":"Paul","last_name":"COTTU","orcid":null}],"funders":[],"categories":["Cyclin-Dependent Kinase","Estrogen-Receptor-Positive Breast Cancer"],"journal_issn":[]},{"id":"w24t4trkv5","title":"A dataset on NFKB1/NFKB2 knockout Jurkat cells and primary CD4+ T cells generated by CRISPR/Cas9 mediated gene disruption. ","description":"Specific biological roles of non-canonical nuclear factor-kappa B (NFKB) signaling in human T cells remain unclear. Therefore, we genetically modified Jurkat leukemic cells using the clustered regularly interspaced palindromic repeat (CRISPR)/CRISPR-associated protein 9 technology to better understand the NFKB signaling mechanisms. IKAROS family zinc finger-2 levels were downregulated in NFKB2-knocked-out cells but upregulated in NFKB1-knocked-out cells. To further understand the biological roles of NFKB signaling in CD4+ T cells, NFKB1/NFKB2 loci of human primary CD4+ T cells were genetically edited using the CRISPR/CRISPR-associated protein 9 technology. Quantitative polymerase chain reaction and fluorescence-activated cell sorting revealed the similar phenotypes and gene expression profiles of NFKB1/NFKB2-knocked-out human CD4+ T cells.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-01-06T16:44:39.354Z","url":"https://data.mendeley.com/datasets/w24t4trkv5","data_type":"dataset","access":"open","doi":["10.17632/w24t4trkv5"],"contributors":[{"first_name":"Yohei","last_name":"Sato","orcid":null}],"funders":[],"categories":["Immunology","Biotechnology","Genome Editing"],"journal_issn":[]},{"id":"7g3t3cjj7f","title":"Raw WB membrane images for Figure S3 of the paper \"Inferring upstream regulatory genes of FOXP3 in human regulatory T cells\"","description":"In Supplementary Figure 3, we analyzed the effect of knocking down NRBF2 on protein expression of FOXP3 in human primary Tregs with Western blotting (WB) approaches. We here provided the original unprocessed WB membrane Tiff images. Although the manuscript includes both computational and experimental arms, we here only listed the authors contributing to the latter.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-05-02T21:57:23.695Z","url":"https://data.mendeley.com/datasets/7g3t3cjj7f","data_type":"dataset","access":"open","doi":["10.17632/7g3t3cjj7f"],"contributors":[{"first_name":"Christophe Michael","last_name":"Capelle","orcid":null},{"first_name":"Vera","last_name":"Tslaf","orcid":null},{"first_name":"Alexandre","last_name":"Baron","orcid":null},{"first_name":"Ni","last_name":"Zeng","orcid":null},{"first_name":"Feng","last_name":"HeFeng","orcid":null}],"funders":[],"categories":["Immunology","Human T Regulatory Cell"],"journal_issn":[]},{"id":"dhcr77nft5","title":"E Badami et al. \"Activation-induced cell death of self-reactive regulatory T cells drives autoimmunity\"","description":"Activation of self-reactive T cells is a major driver to autoimmunity and is suppressed by mechanisms of regulation. In a humanized model of autoimmune thyroiditis, we investigated the mechanism underlying break of tolerance. Here we found that a human TCR specific for the self-antigen thyroid peroxidase (TPO) is positively selected in the thymus of RAG KO mice on both T effector (Teff) and T regulatory (Treg) CD4+Foxp3+ cells.. In vivo Teff are present in all immune organs whereas the TPO-specific Treg are present in all lymphoid organs with the exception of the thyroid draining lymph nodes.  We suggest that the presence of TPO in the thyroid draining lymph nodes induces the activation of Teff and the depletion of Treg via activation induced cells death (AICD). Our findings provide new insights on the failure of the mechanisms of immune tolerance, with potential implications in designing immunotherapeutic strategies.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-11-25T10:06:33.223Z","url":"https://data.mendeley.com/datasets/dhcr77nft5","data_type":"dataset","access":"open","doi":["10.17632/dhcr77nft5"],"contributors":[{"first_name":"Ester","last_name":"Badami","orcid":null}],"funders":[],"categories":["Immunology","Autoimmunity","Mouse T Regulatory Cell"],"journal_issn":[]},{"id":"wvfgwv6rzt","title":"CRISPR Screen in mouse BV2 cells against RVFV","description":"STARS file from the original data analysis","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-02-02T20:00:56.856Z","url":"https://data.mendeley.com/datasets/wvfgwv6rzt","data_type":"dataset","access":"open","doi":["10.17632/wvfgwv6rzt"],"contributors":[{"first_name":"Gaya","last_name":"Amarasinghe","orcid":"0000-0002-0418-9707"},{"first_name":"Safder","last_name":"Ganaie","orcid":null},{"first_name":"Amy","last_name":"Hartman","orcid":null},{"first_name":"Daisy","last_name":"Leung","orcid":null}],"funders":[{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":"R01AI169850"},{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":"R01AI178378 "},{"id":"https://ror.org/043z4tv69","name":"National Institute of Allergy and Infectious Diseases","grant_id":"R01AI161765"}],"categories":["CRISPR/Cas9"],"journal_issn":[]},{"id":"pnbjdtdkfg","title":"A genome-scale gain-of-function CRISPR screen in CD8 T cells identifies proline metabolism as a means to enhance CAR-T therapy ","description":"CyTOF raw data.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-02-14T13:21:30.568Z","url":"https://data.mendeley.com/datasets/pnbjdtdkfg","data_type":"dataset","access":"open","doi":["10.17632/pnbjdtdkfg"],"contributors":[{"first_name":"Lupeng","last_name":"Ye","orcid":null},{"first_name":"Jonathan","last_name":"Park","orcid":null},{"first_name":"Sidi","last_name":"Chen","orcid":null}],"funders":[],"categories":["Immunology"],"journal_issn":[]},{"id":"x7jmxr2497","title":"Plasmid map for STAR Protocol","description":"This file contains plasmid map and sequence for protocol named“Efficient generation of locus-specific CAR-T cells with CRISPR/cCas12a ” which has been published in STAR Protocol.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-03-21T18:14:35.882Z","url":"https://data.mendeley.com/datasets/x7jmxr2497","data_type":"dataset","access":"open","doi":["10.17632/x7jmxr2497"],"contributors":[{"first_name":"Xinyu","last_name":"Ling","orcid":null}],"funders":[],"categories":["Plasmid"],"journal_issn":[]}],"total_records":135030,"page":1,"page_size":10,"execution_time":168,"aggregations":{"data_type_stats":{"dataset":135030,"collection":0},"access_type_stats":{"open":134343,"restricted":67,"embargoed":620},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2265},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1364},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":651},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":473