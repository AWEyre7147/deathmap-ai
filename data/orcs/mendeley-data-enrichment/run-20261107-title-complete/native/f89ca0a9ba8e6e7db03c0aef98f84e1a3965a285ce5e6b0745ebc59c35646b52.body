{"records":[{"id":"3cy28w7v9k","title":"RNA-seq profiling of 634T murine KP NSCLC cells deleted for AMPK subjected to no glucose conditions","description":"This dataset was generated for the paper, \"Genetic analysis reveals AMPK is required to support tumor growth in murine Kras-dependent lung cancer models.\"  Murine Kras mutant, p53 null (KP) 634T NSCLC cells were subjected to the CRISPR/Cas9 system including either a control gRNA (“WT”), or a gRNA targeting both AMPKalpha1 and AMPKalpha2 resulting in AMPK knockout in a polyclonal pooled cell population (“KO”). \"R1\" indicates Replicate 1, \"R2\" indicates Replicate 2. These cells were subjected to no glucose (0mM, \"NG\") conditions for 16 hours, and profiled by RNA-sequencing. \n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-01-10T16:47:21.29Z","url":"https://data.mendeley.com/datasets/3cy28w7v9k","data_type":"dataset","access":"open","doi":["10.17632/3cy28w7v9k"],"contributors":[{"first_name":"Lillian","last_name":"Eichner","orcid":null},{"first_name":"Reuben","last_name":"Shaw","orcid":null}],"funders":[],"categories":["Lung Cancer","RNA Sequencing"],"journal_issn":[]},{"id":"3tygtgw7mz","title":"RNA-seq profiling of 368T1 murine KP NSCLC cells deleted for AMPK with AMPKa1 add-back subjected to no glucose conditions, Replicate 2","description":"This dataset was generated for the paper, \"Genetic analysis reveals AMPK is required to support tumor growth in murine Kras-dependent lung cancer models.\"  Murine Kras mutant, p53 null (KP) 368T1 NSCLC cells were deleted for AMPK using the CRISPR/Cas9 system and subsequently stably infected with control vector (\"KO\") or AMPKalpha1 cDNA (\"A1\") add-back. These cells were subjected to no glucose (0mM, \"NG\") conditions for 12 or 18 hours, and profiled by RNA-sequencing. Replicate 2 High Glucose (HG) and No Glucose (NG) conditions were generated simultaneously and analyzed together. Analysis of a single dataset was performed using Replicate 1 (\"R1\"), and both replicates (\"R1\" and \"R2\") were analyzed together as indicated.   ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-11-02T22:56:00.303Z","url":"https://data.mendeley.com/datasets/3tygtgw7mz","data_type":"dataset","access":"open","doi":["10.17632/3tygtgw7mz"],"contributors":[{"first_name":"Lillian","last_name":"Eichner","orcid":null},{"first_name":"Reuben","last_name":"Shaw","orcid":null}],"funders":[],"categories":["Lung Cancer","RNA Sequencing"],"journal_issn":["15504131"]},{"id":"gj763hyrny","title":"RNA-seq profiling of 368T1 murine KP NSCLC cells deleted for AMPK with AMPKa1 add-back subjected to high glucose conditions, Replicate 1","description":"This dataset was generated for the paper, \"Genetic analysis reveals AMPK is required to support tumor growth in murine Kras-dependent lung cancer models.\"  Murine Kras mutant, p53 null (KP) 368T1 NSCLC cells were deleted for AMPK using the CRISPR/Cas9 system and subsequently stably infected with control vector (\"KO\") or AMPKalpha1 cDNA (\"A1\") add-back. These cells were subjected to high glucose (25mM, \"HG\") conditions for 12 or 18 hours, and profiled by RNA-sequencing. Replicate 1 High Glucose (HG) and No Glucose (NG) conditions were generated simultaneously and analyzed together. Analysis of a single dataset was performed using Replicate 1 (\"R1\"), and both replicates (\"R1\" and \"R2\") were analyzed together as indicated.   ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-01-10T16:46:02.47Z","url":"https://data.mendeley.com/datasets/gj763hyrny","data_type":"dataset","access":"open","doi":["10.17632/gj763hyrny"],"contributors":[{"first_name":"Lillian","last_name":"Eichner","orcid":null},{"first_name":"Reuben","last_name":"Shaw","orcid":null}],"funders":[],"categories":["Lung Cancer","RNA Sequencing"],"journal_issn":[]},{"id":"fvy29f2ptz","title":"RNA-seq profiling of 368T1 murine KP NSCLC cells deleted for AMPK with AMPKa1 add-back subjected to high glucose conditions, Replicate 2","description":"This dataset was generated for the paper, \"Genetic analysis reveals AMPK is required to support tumor growth in murine Kras-dependent lung cancer models.\"  Murine Kras mutant, p53 null (KP) 368T1 NSCLC cells were deleted for AMPK using the CRISPR/Cas9 system and subsequently stably infected with control vector (\"KO\") or AMPKalpha1 cDNA (\"A1\") add-back. These cells were subjected to high glucose (25mM, \"HG\") conditions for 12 or 18 hours, and profiled by RNA-sequencing. Replicate 2 High Glucose (HG) and No Glucose (NG) conditions were generated simultaneously and analyzed together. Analysis of a single dataset was performed using Replicate 1 (\"R1\"), and both replicates (\"R1\" and \"R2\") were analyzed together as indicated.   ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-11-02T22:56:14.317Z","url":"https://data.mendeley.com/datasets/fvy29f2ptz","data_type":"dataset","access":"open","doi":["10.17632/fvy29f2ptz"],"contributors":[{"first_name":"Lillian","last_name":"Eichner","orcid":null},{"first_name":"Reuben","last_name":"Shaw","orcid":null}],"funders":[],"categories":["Lung Cancer","RNA Sequencing"],"journal_issn":["15504131"]},{"id":"725vfwk8v3","title":"RNA-seq profiling of 368T1 murine KP NSCLC cells deleted for AMPK with AMPKa1 add-back subjected to no glucose conditions, Replicate 1","description":"This dataset was generated for the paper, \"Genetic analysis reveals AMPK is required to support tumor growth in murine Kras-dependent lung cancer models.\"  Murine Kras mutant, p53 null (KP) 368T1 NSCLC cells were deleted for AMPK using the CRISPR/Cas9 system and subsequently stably infected with control vector (\"KO\") or AMPKalpha1 cDNA (\"A1\") add-back. These cells were subjected to no glucose (0mM, \"NG\") conditions for 12 or 18 hours, and profiled by RNA-sequencing. Replicate 1 High Glucose (HG) and No Glucose (NG) conditions were generated simultaneously and analyzed together. Analysis of a single dataset was performed using Replicate 1 (\"R1\"), and both replicates (\"R1\" and \"R2\") were analyzed together as indicated.   ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2018-11-02T22:56:28.901Z","url":"https://data.mendeley.com/datasets/725vfwk8v3","data_type":"dataset","access":"open","doi":["10.17632/725vfwk8v3"],"contributors":[{"first_name":"Lillian","last_name":"Eichner","orcid":null},{"first_name":"Reuben","last_name":"Shaw","orcid":null}],"funders":[],"categories":["Lung Cancer","RNA Sequencing"],"journal_issn":["15504131"]},{"id":"9w4g54bv43","title":"Genome-wide screens reveal that resveratrol induces replicative stress in human cells","description":"Resveratrol is a natural product associated with wide-ranging effects in animal and cellular models including lifespan extension. To identify the genetic target of resveratrol in human cells, we conducted genome-wide CRISPR-Cas9 screens to pinpoint genes that confer sensitivity or resistance to resveratrol. An extensive network of DNA damage response and replicative stress genes exhibited genetic interactions with resveratrol and its analog pterostilbene. These genetic profiles showed similarity to the response to hydroxyurea, an inhibitor of ribonucleotide reductase that causes replicative stress. Resveratrol, pterostilbene and hydroxyurea caused similar depletion of nucleotide pools, inhibition of replication fork progression and induction of replicative stress. The ability of resveratrol to inhibit cell proliferation and S phase transit was independent of the histone deacetylase Sirtuin 1, which has been implicated in lifespan extension by resveratrol. These results establish that a primary impact of resveratrol on human cell proliferation is the induction of low-level replicative stress.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-04T14:56:19.488Z","url":"https://data.mendeley.com/datasets/9w4g54bv43","data_type":"dataset","access":"open","doi":["10.17632/9w4g54bv43"],"contributors":[{"first_name":"Yahya","last_name":"Benslimane","orcid":null},{"first_name":"Thierry","last_name":"Bertomeu","orcid":null},{"first_name":"Jasmin","last_name":"Coulombe-Huntington","orcid":null},{"first_name":"Mary","last_name":"McQuaid","orcid":null},{"first_name":"María","last_name":"Sánchez-Osuna","orcid":null},{"first_name":"David","last_name":"Papadopoli","orcid":null},{"first_name":"Daina","last_name":"Avizonis","orcid":null},{"first_name":"Mariana","last_name":"De Sa Tavares Russo","orcid":null},{"first_name":"Caroline","last_name":"Huard","orcid":null},{"first_name":"Ivan","last_name":"Topisirovic","orcid":null},{"first_name":"Hugo","last_name":"Wurtele","orcid":null},{"first_name":"Mike","last_name":"Tyers","orcid":null},{"first_name":"Lea","last_name":"Harrington","orcid":null}],"funders":[],"categories":["DNA Replication","High-Throughput Screening","High-Throughput Sequencing"],"journal_issn":[]},{"id":"k6wm46g4tw","title":"Data set for the paper entitled \"CRISPR-enabled genetic screens identify synthetic lethal targets across frequently altered cancer drivers\" by Desjardins, Bowlan, et al. (2026)","description":"We undertook a series of genome-wide CRISPR screens using functionally validated isogenic cell lines and mapped SL interactions across 15 genetic alterations characteristic of diseases with high incidence and unmet clinical need: FBXW7, CCNE1, CDK12, ARID1A, KMT2D, DNMT3A, TET2, KEAP1, STK11, IDH1, SF3B1, SRSF2, U2AF1, chromosome 18q loss, and chromosome 13q loss. The data deposited here make the raw read count files available for all CRISPR screens conducted in the study. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-01-26T11:43:11.208Z","url":"https://data.mendeley.com/datasets/k6wm46g4tw","data_type":"dataset","access":"open","doi":["10.17632/k6wm46g4tw"],"contributors":[{"first_name":"Jordan","last_name":"Young","orcid":null},{"first_name":"Alejandro","last_name":"Álvarez-Quilón","orcid":null},{"first_name":"Jessica","last_name":"Desjardins","orcid":null},{"first_name":"Julian","last_name":"Bowlan","orcid":null}],"funders":[],"categories":["Primary Data"],"journal_issn":[]},{"id":"8xhv88c7wt","title":"Genome-wide screening in human kidney organoids identifies developmental and disease-related aspects of nephrogenesis","description":"Human organoids allow the study of proliferation, lineage specification, and three-dimensional tissue development. Here, we present a genome-wide CRISPR screen in iPSC-derived kidney organoids. The combination of inducible genome editing, longitudinal sampling and endpoint sorting of tubular and stromal cells generated a complex, high-quality dataset uncovering a broad spectrum of insightful biology from early development to ‘adult’ epithelial morphogenesis. Our functional dataset allows improving mesoderm induction by ROCK inhibition, contains monogenetic and complex trait kidney disease genes, confirms two additional CAKUT genes (CCDC170 and MYH7B), and provides a large candidate list of ciliopathy-related genes. Finally, the identification of a cis-inhibitory effect of Jagged1 controlling epithelial proliferation shows how mosaic knockouts in pooled CRISPR screening can discover ways of communication between heterogeneous cell populations in complex tissues. Collectively, these data serve both as a rich resource for the kidney community and as a benchmark for future iPSC-derived organoid CRISPR screens.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-29T13:48:59.335Z","url":"https://data.mendeley.com/datasets/8xhv88c7wt","data_type":"dataset","access":"open","doi":["10.17632/8xhv88c7wt"],"contributors":[{"first_name":"Rosemarie","last_name":"Ungricht","orcid":null},{"first_name":"Philipp","last_name":"Hoppe","orcid":null}],"funders":[],"categories":["Screening","CRISPR"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"t8mryvs8b7","title":"Genome-wide DNA Methylation Landscape of NSCLC","description":"Genome-wide DNA methylation profiling using Reduced Representation Bisulfite Sequencing (RRBS) on 260 methylomes from paired tumour and adjacent non-cancerous lung tissues of 130 NSCLC patients - 54 adenocarcinoma (AC), 72 squamous cell carcinoma (SCC). Snap-frozen tumour and matched non-malignant tissues (260 samples) were processed for DNA extraction (DNeasy Blood & Tissue Kit, Qiagen) and quality control. Genomic DNA (1.2 µg) was used for RRBS (Reduced Representation Bisulfite Sequencing) library preparation (NEXTflex Bisulfite-Seq Kit, BIOO Scientific) and sequenced on Illumina HiSeq 4000 (Illumina, San Diego, USA) in paired-end (PE) mode (2 × 76 cycles). FASTQ files were generated with bcl2fastq (Illumina, San Diego, USA), quality-checked with FastQC (Babraham Institute) and MultiQC, and cleaned with BBduk (DOE JGI, USA) with RRBS-specific parameters. Reads were aligned to GRCh37 (Ensembl 75) using Bismark (Babraham Institute)15 in PE mode, and CpG methylation calls extracted in no-overlap mode after M-bias evaluation. Dataset represent DNA methylation calls in CpG regions with coverage >=10x in bedgraph file with combined samles from tumor (T) and non-cancerous (N) samples. There are three datasets: 1) all NSCLC patients, 2) only adenocarcinoma (AC) patients, 3) only squamous cell carcinoma (SCC) patients.\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-06-01T08:08:33.561Z","url":"https://data.mendeley.com/datasets/t8mryvs8b7","data_type":"dataset","access":"open","doi":["10.17632/t8mryvs8b7"],"contributors":[{"first_name":"Karolina","last_name":"Chwiałkowska","orcid":null}],"funders":[{"id":"https://ror.org/05pwfyy15","name":"National Centre for Research and Development","grant_id":"STRATEGMED2/266484/2/NCBR/2015"}],"categories":["DNA Methylation"],"journal_issn":[]}],"total_records":135032,"page":1,"page_size":10,"execution_time":168,"aggregations":{"data_type_stats":{"dataset":135032,"collection":0},"access_type_stats":{"open":134343,"restricted":67,"embargoed":622},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2266},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1330},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":654},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":474},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":439},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":416},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":403},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":381},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":323},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":269}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":132400},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1901},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":185},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":136},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":77},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":64},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":56},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":40},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":31},{"id":"5f1edf21-7948-4d82-894f-c0ed4b1e8f52","name":"Teesside University","count":25}],"top_institutions_stats":[{"id":"ecb64011-71f0-5223-b4e4-4d27d5f51d83","name":"Universidad Autonoma de Madrid Centro de Biologia Molecular Severo Ochoa","count":866},{"id":"9d63ad1d-c391-5c35-a12e-cafe17017098","name":"Universidad Autonoma de Madrid","count":783},{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":518},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":405},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":360}]}}