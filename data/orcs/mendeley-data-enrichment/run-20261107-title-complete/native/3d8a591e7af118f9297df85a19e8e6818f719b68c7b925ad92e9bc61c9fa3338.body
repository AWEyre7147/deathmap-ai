{"records":[{"id":"yb7wftjchk","title":"Merkel Cell Carcinoma Supplementary Data","description":"Supplementary Materials for Comparative response patterns to immune checkpoint inhibition in Merkel cell carcinoma: A Merkel cell polyomavirus-stratified systematic review\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-12-18T07:50:32.167Z","url":"https://data.mendeley.com/datasets/yb7wftjchk","data_type":"dataset","access":"open","doi":["10.17632/yb7wftjchk"],"contributors":[{"first_name":"Andy","last_name":"Lee","orcid":null}],"funders":[],"categories":["Medicine"],"journal_issn":[]},{"id":"r3gphxxs3b","title":"Merkel cell polyomavirus T-antigens regulate DICER1 mRNA stability and translation through HSC70 ","description":"These are the source data and uncropped Western blot images for study, Merkel cell polyomavirus T-antigens regulate DICER1 mRNA stability and translation through HSC70.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-10-18T10:42:35.798Z","url":"https://data.mendeley.com/datasets/r3gphxxs3b","data_type":"dataset","access":"open","doi":["10.17632/r3gphxxs3b"],"contributors":[{"first_name":"Jiwei","last_name":"Gao","orcid":null},{"first_name":"Hao","last_name":"Shi","orcid":null},{"first_name":"C. Christofer","last_name":"Juhlin","orcid":null},{"first_name":"Catharina","last_name":"Larsson","orcid":null},{"first_name":"Weng-Onn","last_name":"Lui","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"svwgf3m4t6","title":"Data on empirical estimation of the relationship between firm risk and non-executive directors in Vietnamese listed companies (2007-2016)","description":"Our data are collected by reviewing annual reports of 151 non-financial companies listed on Vietnamese stock markets from 2007-2016. They are available in the official websites of the two Vietnamese stock exchanges, HOSE (Ho Chi Minh City Stock Exchange) and HNX (Hanoi Stock Exchange). The financial companies such as banks, insurance, and financial services are excluded from the sample because they act as market makers, and more specifically, the board structure of these companies must comply with some regulations from the state bank","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2019-12-07T23:25:45.327Z","url":"https://data.mendeley.com/datasets/svwgf3m4t6","data_type":"dataset","access":"open","doi":["10.17632/svwgf3m4t6"],"contributors":[{"first_name":"To","last_name":"Anh Tho","orcid":null}],"funders":[],"categories":["Corporate Governance"],"journal_issn":[]},{"id":"fvx9bts9rh","title":"GenAI","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-09-03T21:08:59.412Z","embargo_date":"2027-12-31T23:59:59Z","url":"https://data.mendeley.com/datasets/fvx9bts9rh","data_type":"dataset","access":"embargoed","doi":["10.17632/fvx9bts9rh"],"contributors":[{"first_name":"Wai Ming","last_name":"To","orcid":null}]},{"id":"j4hvybnz97","title":"Quantitative NMR Data of Isolated Compounds (1-7)","description":"NMR Data of Compounds (1-7) isolated from Scutellaria indica","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-01-04T21:56:42.874Z","url":"https://data.mendeley.com/datasets/j4hvybnz97","data_type":"dataset","access":"open","doi":["10.17632/j4hvybnz97"],"contributors":[{"first_name":"Dao-Cuong","last_name":"To","orcid":null}],"funders":[],"categories":["Bioorganic Chemistry"],"journal_issn":[]},{"id":"jzxcj7jdjw","title":"Quantitative NMR Data of Isolated Compounds (1-12)","description":"Physicochemical characterization and NMR data of isolated Compounds (1-12)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-09-18T03:59:26.638Z","url":"https://data.mendeley.com/datasets/jzxcj7jdjw","data_type":"dataset","access":"open","doi":["10.17632/jzxcj7jdjw"],"contributors":[{"first_name":"Dao-Cuong","last_name":"To","orcid":null}],"funders":[],"categories":["Isolated Molecule"],"journal_issn":[]},{"id":"xxxb82xy4k","title":"Study area, Selection criteria, Investigation time, and Data analysis","description":"Study area, Selection criteria, Investigation time, and Data analysis","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-10-06T06:51:36.363Z","url":"https://data.mendeley.com/datasets/xxxb82xy4k","data_type":"dataset","access":"open","doi":["10.17632/xxxb82xy4k"],"contributors":[{"first_name":"Dao-Cuong","last_name":"To","orcid":null}],"funders":[],"categories":["Dioxin"],"journal_issn":[]},{"id":"j26n3rjbv6","title":"NMR data of isolated compounds (1-12)","description":"NMR spectra of quercetin (1), kaempferol (2), rhamnetin (3), quercitrin (4), hyperoside (5), reynoutrin (6), guaijaverin (7), afzelin (8), astragalin (9), rutin (10), kaempferol-3-O-rutinoside (11), and rhamnetin-3-O-rutinoside (12)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-09-11T17:33:36.898Z","url":"https://data.mendeley.com/datasets/j26n3rjbv6","data_type":"dataset","access":"open","doi":["10.17632/j26n3rjbv6"],"contributors":[{"first_name":"Dao-Cuong","last_name":"To","orcid":null}],"funders":[],"categories":["NMR Imaging"],"journal_issn":[]},{"id":"smrknsnbsp","title":"BAS chromatin remodeler mediates controls brassinosteroid-induced transcriptional activation and plant growth in Arabidopsis (Western blot)","description":"Brassinosteroid (BR) signaling leads to the nuclear accumulation of the BRASSINAZOLE-RESISTANT 1 (BZR1) transcription factor, which plays dual roles in activating or repressing the expression of thousands of genes. BZR1 represses gene expression by recruiting histone deacetylases, but how it activates transcription of BR-induced genes remains unclear elusive. Here, we show that BR reshapes genome-wide chromatin accessibility landscape, increasing the accessibility of BR-induced genes, and reducing the accessibility of BR-repressed genes in Arabidopsis. BZR1 physically interacts with BRAHMA (BRM), the ATPase subunit of BRAHMA-Associated SWI/SNF (BAS) chromatin-remodeling complex, on the genome and selectively recruits the BAS complex to BR-activated genes. Depletion of BAS abrogates the capacities of BZR1 to increase chromatin accessibility, activate gene expression, and promote cell elongation, without affecting BZR1’s ability to reduce chromatin accessibility and expression of BR-repressed genes. Together, these data identify reveal that BZR1 recruits the BAS complex to open chromatin and to mediate BR-induced transcriptional activation of growth-promoting genes.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-01-22T08:43:48.168Z","url":"https://data.mendeley.com/datasets/smrknsnbsp","data_type":"dataset","access":"open","doi":["10.17632/smrknsnbsp"],"contributors":[{"first_name":"tao","last_name":"zhu","orcid":null}],"funders":[],"categories":["Arabidopsis thaliana"],"journal_issn":[]},{"id":"mhy5rwdyv8","title":"Merkel cell polyomavirus oncoprotein promotes BAG3-mediated aggresome formation_Additional data","description":"Full original immunoblots of cropped images","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-16T17:22:21.722Z","url":"https://data.mendeley.com/datasets/mhy5rwdyv8","data_type":"dataset","access":"open","doi":["10.17632/mhy5rwdyv8"],"contributors":[{"first_name":"Xiaohao","last_name":"Wang","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]}],"total_records":123381,"page":1,"page_size":10,"execution_time":9