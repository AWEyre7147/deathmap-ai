{"records":[{"id":"5cdnt4t7xz","title":"Targeting mutant NPM1-expressing AML with T-cell receptor-like antibodies","description":"Abstract\nMutant NPM1 protein accumulation is a hallmark of acute myeloid leukemia (AML). Although intracellular proteins are generally inaccessible to antibody-based therapies, proteasomal degradation of mutant NPM1 results in the generation of peptides on the tumor cell surface via major histocompatibility complex (MHC) class I molecules. Enhanced presentation of NPM1 mutant A-derived peptides (NPM1mutA283-291-CLAVEEVSL) on HLA-A*02:01-positive tumor cells distinguishes malignant cells from healthy cells. Here, we report the development of an antibody, 2E2, that specifically targets the NPM1 mutant A peptide bound to HLA-A*02:01. We modified 2E2, including chimeric antibodies and bispecific antibodies. Modified antibodies selectively recognize mutant NPM1-expressing cells and mediate antibody-dependent cellular cytotoxicity (ADCC) in vitro. Moreover, bispecific antibodies derived from 2E2 redirect CD3+ T cells and NK cells to mutant NPM1-expressing cells, suppressing tumor growth both in vitro and in vivo. These findings underscore the potential of NPM1 peptide‒MHC complexes as novel immunotherapeutic targets in AML.\n\nKeywords: TCR-like antibody, Acute myeloid leukemia, Tumor immunotherapy, NPM1, HLA","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-27T15:21:17.055Z","url":"https://data.mendeley.com/datasets/5cdnt4t7xz","data_type":"dataset","access":"open","doi":["10.17632/5cdnt4t7xz"],"contributors":[{"first_name":"Jianda","last_name":"Hu","orcid":null}],"funders":[{"id":null,"name":"Joint Funds for the Innovation of Science and Technology, Fujian Province","grant_id":"2021Y9086, 2022Y4013, 2023Y9153"},{"id":null,"name":"Special Fund from Fujian Provincial Department of Finance","grant_id":"CZBZ202301"},{"id":null,"name":"Natural Science Foundation of Fujian Province","grant_id":"2024J01583, 2022J01240"},{"id":null,"name":"the Talent Scientific Research Project of the First Affiliated Hospital of Fujian Medical University","grant_id":"YJRC4415"},{"id":null,"name":"Scientific Research Foundation of State Key Laboratory of Vaccines for Infectious Diseases, Xiang An Biomedicine Laboratory","grant_id":"2023XAKJ0102057"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"82470173, U23A20419, U2005204"},{"id":null,"name":"the Project of Fujian Province Department of Science & Technology","grant_id":"2023Y9079"}],"categories":["Immunotherapy of Leukemia"],"journal_issn":[]},{"id":"f7btcr6x6d","title":"A non-canonical function of glutathione to suppress ferroptosis via FSP1","description":"Whole genome-wide CRISPR KO screen","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-10-02T11:41:52.925Z","url":"https://data.mendeley.com/datasets/f7btcr6x6d","data_type":"dataset","access":"open","doi":["10.17632/f7btcr6x6d"],"contributors":[{"first_name":"BO","last_name":"CHU","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"y8dndzn3mg","title":"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication","description":"These data are part of the Supplemental Items associated with the manuscript entitled \"Genome-scale CRISPR screen identifies TMEM41B as a critical host factor required for coronavirus replication\". These files include Supplementary Data file 1-4.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-03-16T10:34:13.579Z","url":"https://data.mendeley.com/datasets/y8dndzn3mg","data_type":"dataset","access":"open","doi":["10.17632/y8dndzn3mg"],"contributors":[{"first_name":"Limeng","last_name":"Sun","orcid":null}],"funders":[],"categories":["Virus","Screening","CRISPR/Cas9"],"journal_issn":[]},{"id":"sxrvzkr4hh","title":"Pooled in vitro and in vivo CRISPR-Cas9 screening identifies tumor suppressors in human colon organoids","description":"UMI validation screen, original data from in vivo tumor suppressor CRISPR/Cas9 screening experiment. Figure 6.\nExperimental setup: 281 tumor suppressor gRNAs, positive controls, neutral controls and gRNAs targeting essential genes were introduced into the CRISPR-UMI lentivirus (Michlits et al., 2017). Transduced AK organoids (APC-KO and KRASG12D) were transplanted subcutaneously in NSG mice followed by barcode sequencing of the tumor pool (from 10 mice) and 5 individual tumors. Clone and read number were determined by next generation sequencing. The conventional gRNA enrichment analysis was compared to UMI-CRISPR-screening with outlier removal.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-04-20T15:46:17.868Z","url":"https://data.mendeley.com/datasets/sxrvzkr4hh","data_type":"dataset","access":"open","doi":["10.17632/sxrvzkr4hh"],"contributors":[{"first_name":"Henner","last_name":"Farin","orcid":null}],"funders":[],"categories":["Cell Biology"],"journal_issn":[]},{"id":"2gwd5xfmyh","title":"Raw data from LACV whole genome CRISPR activation screen in BE(2)C cells by Francomacaro et al","description":"\nFASTQ files from control BE(2)C cells harboring whole-genome Calabrese CRISPR activation library (replicate 2)\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-07T01:47:15.794Z","url":"https://data.mendeley.com/datasets/2gwd5xfmyh","data_type":"dataset","access":"open","doi":["10.17632/2gwd5xfmyh"],"contributors":[{"first_name":"surachai","last_name":"supattapone","orcid":null}],"funders":[{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R37NS125431"}],"categories":["Virus","Cell Death"],"journal_issn":[]},{"id":"xbx248k5ft","title":"DYRK1A-TGFβ Signaling Axis Determines Sensitivity to OXPHOS Inhibition in Hepatocellular Carcinoma","description":"Intervening in mitochondrial OXPHOS has emerged as a potential therapeutic strategy for certain types of cancers. Employing kinome-based CRISPR screen, we find that knockout of DYRK1A synergizes with OXPHOS inhibitor IACS-010759 in liver cancer cells. Targeting DYRK1A combined with OXPHOS inhibitors activates TGFβ signaling, which is crucial for OXPHOS inhibition-triggered cell death. Mechanistically, upregulation of glutamine transporter SLC1A5 transcription compensates for the increased glutamine requirement upon OXPHOS inhibition. DYRK1A directly phosphorylates SMAD3 Thr132, thereby suppressing the negative impact of TGFβ signaling on transcription of SLC1A5, leading to intrinsic resistance of liver cancer cells to OXPHOS inhibition. Moreover, we demonstrate the therapeutic efficacy of IACS-010759 in combination with DYRK1A inhibition in multiple liver cancer models, including xenograftes, patient-derived xenograftes and spontaneous tumor model. Our study elucidates how the DYRK1A-TGFβ signaling axis controls the response of tumor cells to OXPHOS inhibition and provides valuable insights into targeting OXPHOS for liver cancer therapy. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-12-13T15:22:10.239Z","url":"https://data.mendeley.com/datasets/xbx248k5ft","data_type":"dataset","access":"open","doi":["10.17632/xbx248k5ft"],"contributors":[{"first_name":"ying","last_name":"cao","orcid":null}],"funders":[],"categories":["Western Blot"],"journal_issn":[]},{"id":"ygpjshs8js","title":"Raw data from LACV whole genome CRISPR activation screen in BE(2)C cells by Francomacaro et al","description":"FASTQ files from control BE(2)C cells harboring whole-genome Calabrese CRISPR activation library (replicate 1)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-07T01:47:23.408Z","url":"https://data.mendeley.com/datasets/ygpjshs8js","data_type":"dataset","access":"open","doi":["10.17632/ygpjshs8js"],"contributors":[{"first_name":"surachai","last_name":"supattapone","orcid":null},{"first_name":"Lisa","last_name":"Francomacaro","orcid":null}],"funders":[{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R37NS125431"}],"categories":["Virus","Cell Death"],"journal_issn":[]},{"id":"zmymsrxtkd","title":"Raw data from LACV whole genome CRISPR activation screen in BE(2)C cells by Francomacaro et al","description":"FASTQ files from control BE(2)C cells harboring whole-genome Calabrese CRISPR activation library (replicate 3)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-13T09:52:34.145Z","url":"https://data.mendeley.com/datasets/zmymsrxtkd","data_type":"dataset","access":"open","doi":["10.17632/zmymsrxtkd"],"contributors":[{"first_name":"surachai","last_name":"supattapone","orcid":null},{"first_name":"LIsa","last_name":"Francomacaro","orcid":null}],"funders":[{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R37NS125431"}],"categories":["Virus","Cell Death"],"journal_issn":[]},{"id":"nxvdzybwhf","title":"Illuminating host-mycobacterial interactions with genome-wide CRISPR knockout and CRISPRi screens","description":"The data deposited here contains genome-wide CRISPR knockout and CRISPRi screen data, including the positive hits, the negative hits, and non-targeting controls. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-08-30T11:32:01.108Z","url":"https://data.mendeley.com/datasets/nxvdzybwhf","data_type":"dataset","access":"open","doi":["10.17632/nxvdzybwhf"],"contributors":[{"first_name":"Yong","last_name":"Lai","orcid":null}],"funders":[],"categories":["Functional Genomics","High-Throughput Sequencing","Tuberculosis"],"journal_issn":[]},{"id":"8tpj5b47nn","title":"Raw data from LACV whole genome CRISPR activation screen in BE(2)C cells by Francomacaro et al","description":"FASTQ files from LACV-infected BE(2)C cells harboring whole-genome Calabrese CRISPR activation library (replicate 1)","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2026-04-13T09:08:46.565Z","url":"https://data.mendeley.com/datasets/8tpj5b47nn","data_type":"dataset","access":"open","doi":["10.17632/8tpj5b47nn"],"contributors":[{"first_name":"surachai","last_name":"supattapone","orcid":null},{"first_name":"Lisa","last_name":"Francomacaro","orcid":null}],"funders":[{"id":"https://ror.org/01s5ya894","name":"National Institute of Neurological Disorders and Stroke","grant_id":"R37NS125431"}],"categories":["Virus","Cell Death"],"journal_issn":[]}],"total_records":122007,"page":1,"page_size":10,"execution_time":148,"aggregations":{"data_type_stats":{"dataset":122007,"collection":0},"access_type_stats":{"open":121546,"restricted":60,"embargoed":401},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2042},{"id":"https://ror.org/003x0zc53","name":"Agencia Estatal de Investigación","count":1326},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":550},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":440},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":417},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":380},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":378},{"id":"https://ror.org/021nxhr62","name":