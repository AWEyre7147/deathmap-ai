{"records":[{"id":"nzzhcypcyr","title":"Incidence and risk factors for hypoglycemia in patients with hepatocellular carcinoma：A cross-sectional study","description":"This data investigates the occurrence of hypoglycemia  with hepatocellular carcinoma in patients to obtain the incidence of hypoglycemia in patients with hepatocellular carcinoma, and through the study of related influencing factors, finds out the relevant factors and independent risks that lead to hypoglycemia in patients with hepatocellular carcinoma factor.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-11-01T14:26:13.125Z","url":"https://data.mendeley.com/datasets/nzzhcypcyr","data_type":"dataset","access":"open","doi":["10.17632/nzzhcypcyr"],"contributors":[{"first_name":"xiumei","last_name":"Chen","orcid":null},{"first_name":"Xiaojing ","last_name":"Zheng","orcid":null},{"first_name":"Honghong","last_name":"Yan","orcid":null},{"first_name":"Bin","last_name":"Gan","orcid":null},{"first_name":"Xiaoting","last_name":"Qiu","orcid":null},{"first_name":"Jie","last_name":"Qiu","orcid":null},{"first_name":"Jing","last_name":"Zhang","orcid":null},{"first_name":"Xiaoming","last_name":"Chen","orcid":null},{"first_name":"Cuijuan","last_name":"Huang","orcid":null}],"funders":[],"categories":["Hepatocellular Carcinoma","Hypoglycemia"],"journal_issn":[]},{"id":"pth6kt7x9t","title":"A network meta-analysis on the efficacy of different mycotoxin binders to reduce aflatoxin M1 in milk after aflatoxin B1 challenge in dairy cows..","description":"A network meta-analysis on the efficacy of different mycotoxin binders to reduce aflatoxin M1 in milk after aflatoxin B1 challenge in dairy cows. It contains the Prisma chart and the list of the selected papers included in the metaanalysis","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-05-16T15:09:22.339Z","url":"https://data.mendeley.com/datasets/pth6kt7x9t","data_type":"dataset","access":"open","doi":["10.17632/pth6kt7x9t"],"contributors":[{"first_name":"Sergio","last_name":"Calsamiglia","orcid":null},{"first_name":"Maria","last_name":"Rodriguez Prado","orcid":null},{"first_name":"abdelhacib","last_name":"kihal","orcid":null}],"funders":[],"categories":["Aflatoxin","Dairy Cattle"],"journal_issn":[]},{"id":"4ysv5stvps","title":"In vitro detoxification of aflatoxin B1 by aqueous extracts of medicinal herbs ","description":"Detoxification of aflatoxin B1 by aqueous extracts of medicinal herbs","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2022-02-21T12:31:27.965Z","url":"https://data.mendeley.com/datasets/4ysv5stvps","data_type":"dataset","access":"open","doi":["10.17632/4ysv5stvps"],"contributors":[{"first_name":"Al-Owaisi","last_name":"Arwa ","orcid":null},{"first_name":"Al-Sadi","last_name":"Abdullah Mohammed ","orcid":null},{"first_name":"Al-Sabahi","last_name":"Jamal Nasser ","orcid":null},{"first_name":"Sathish Babu","last_name":"S.P.","orcid":null},{"first_name":"Ali Al-Harrasi","last_name":"Majida Mohammed ","orcid":null},{"first_name":"Al-Mahmooli ","last_name":"Issa Hashil ","orcid":null},{"first_name":"Velazhahan","last_name":"Rethinasamy","orcid":null}],"funders":[],"categories":["Natural Sciences"],"journal_issn":[]},{"id":"nh6wynznc3","title":"JDS.A network meta-analysis on the efficacy of different mycotoxin binders to reduce aflatoxin M1 in milk after aflatoxin B1 challange in dairy cows. By Kihal et al.","description":"Supplementary Tables and Figures from paper \"A network meta-analysis on the efficacy of different mycotoxin binders to reduce aflatoxin M1 in milk after aflatoxin B1 challenge in dairy cows\" submitted to J. Dairy Sci in 2023, by A. Kihal, M. Rodríguez-Prado, and S. Calsamiglia\n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-01-17T12:47:37.144Z","url":"https://data.mendeley.com/datasets/nh6wynznc3","data_type":"dataset","access":"open","doi":["10.17632/nh6wynznc3"],"contributors":[{"first_name":"Sergio","last_name":"Calsamiglia","orcid":null},{"first_name":"abdelhacib","last_name":"kihal","orcid":null},{"first_name":"Maria","last_name":"Rodriguez Prado","orcid":null}],"funders":[],"categories":["Dairy Cattle"],"journal_issn":[]},{"id":"d84224w393","title":" Treatment of Hepatocellular Carcinoma at Special Sites with Ultrasound-Guided Pulsed Microwave Ablation","description":"Pictorial data on the treatment of hepatocellular carcinoma at specific sites with ultrasound-guided pulsed microwave ablation","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2025-02-17T17:40:36.377Z","url":"https://data.mendeley.com/datasets/d84224w393","data_type":"dataset","access":"open","doi":["10.17632/d84224w393"],"contributors":[{"first_name":"Zeyang","last_name":"Dong","orcid":null}],"funders":[],"categories":["Cancer","Ultrasound","Microwave"],"journal_issn":[]},{"id":"kmy9k9ptms","title":"TRAF2 Expression and Its Prognostic Significance in Tumor Microenvironments: A Comprehensive Analysis","description":"Tumor necrosis factor (TNF) receptor associated factor-2 (TRAF2) is an E3 ubiquitin ligase and scaffolding protein known to contribute to the progression of various malignant tumors. However, the relationship between TRAF2 expression and gene methylation, cancer prognosis, and immune responses in the tumor microenvironment is unclear. We found that TRAF2 is significantly overexpressed in 17 different cancer types and is strongly associated with a poor prognosis. In addition, TRAF2 was found to be strongly associated with immune cell infiltration in the tumor microenvironment and the efficacy of immunotherapy, specifically in terms of a strong association with T cells. The results of our in vitro experimental studies confirmed that the loss of TRAF2 function inhibits the malignant biological behavior of HepG2 cells in hepatocellular carcinoma. This study emphasizes the potential of TRAF2 as a promising prognostic biomarker and a potential target for cancer immunotherapy, especially benefiting patients with hepatocellular carcinoma.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2024-08-27T21:09:27.611Z","url":"https://data.mendeley.com/datasets/kmy9k9ptms","data_type":"dataset","access":"open","doi":["10.17632/kmy9k9ptms"],"contributors":[{"first_name":"Jianxin","last_name":"Guo","orcid":null}],"funders":[{"id":null,"name":"Hebei Province Traditional Chinese Medicine Scientific Research Subjects Programme","grant_id":"2024110"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"H2023209036"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"H2023206137"},{"id":null,"name":"Hebei Province Young Top Talents Programme","grant_id":"BJK2024036"},{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","grant_id":"8227150213"}],"categories":["Hepatocellular Carcinoma"],"journal_issn":[]},{"id":"symzczbkbk","title":"Supplementary Figure, Paper A network meta-analysis on the efficacy of different mycotoxin binders  to reduce aflatoxin M1 in milk after aflatoxin B1 challenge in dairy cows, by Kihal et al., J. Dairy Sci 2023","description":"Supplementary material for paper “A network meta-analysis on the efficacy of different mycotoxin binders to reduce aflatoxin M1 in milk after aflatoxin B1 challenge in dairy cows” by Kihal, Rodriguez-Prado and Calsamiglia, in the Journal of Dairy Sciences 2023\n\nFigure 1S: Prisma diagram representing the inclusion summary of papers for the network meta-analysis. \n","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-05-16T15:07:46.567Z","url":"https://data.mendeley.com/datasets/symzczbkbk","data_type":"dataset","access":"open","doi":["10.17632/symzczbkbk"],"contributors":[{"first_name":"Sergio","last_name":"Calsamiglia","orcid":null},{"first_name":"Maria","last_name":"Rodriguez Prado","orcid":null},{"first_name":"abdelhacib","last_name":"kihal","orcid":null}],"funders":[],"categories":["Aflatoxin","Dairy Cattle"],"journal_issn":[]},{"id":"tx3tw29p62","title":"In Vivo effects of aflatoxin B1 and benzo[a]pyrene on the heart muscle of chicken embryos ","description":"The purpose of the present study was to evaluate the effects of aflatoxin B1 and benzo[a]pyrene on the heart muscle of chicken embryos of the broiler line Ross 308. ","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2021-10-26T12:52:32.31Z","url":"https://data.mendeley.com/datasets/tx3tw29p62","data_type":"dataset","access":"open","doi":["10.17632/tx3tw29p62"],"contributors":[{"first_name":"Nikola","last_name":"Knizatova","orcid":null}],"funders":[],"categories":["Chicken","Heart","Aflatoxin"],"journal_issn":[]},{"id":"k6djr385tf","title":"Apoptotic vesicles rebalance glycolytic metabolism to boost anti-PD-1 therapy for liver cancer","description":"TCGA datasets of 371 hepatocellular carcinoma analysis","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2023-11-27T20:09:12.819Z","url":"https://data.mendeley.com/datasets/k6djr385tf","data_type":"dataset","access":"open","doi":["10.17632/k6djr385tf"],"contributors":[{"first_name":"jinyang","last_name":"wang","orcid":null}],"funders":[],"categories":["Data Analysis"],"journal_issn":[]},{"id":"gz2fgbkw4c","title":"fatty_DM","description":"MetabMetabolic Risk Factors and Hepatocellular Carcinoma in Fatty Liver Disease","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date"