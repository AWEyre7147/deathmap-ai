,"orcid":null},{"first_name":"Babak","last_name":"Nami","orcid":null},{"first_name":"Allison","last_name":"Nixon","orcid":null},{"first_name":"Nicholas","last_name":"Mikolajewicz","orcid":null},{"first_name":"Milad","last_name":"Mokhtaridoost","orcid":null},{"first_name":"Lyudmila","last_name":"Nedyalkova","orcid":null},{"first_name":"Thomas","last_name":"Rohde","orcid":null},{"first_name":"Maria","last_name":"Sartori Rodrigues","orcid":null},{"first_name":"Martin","last_name":"Soste","orcid":null},{"first_name":"Eric","last_name":"Schultz","orcid":null},{"first_name":"Wen","last_name":"Wang","orcid":null},{"first_name":"Ashwin","last_name":"Seetharaman","orcid":null},{"first_name":"Ermira","last_name":"Shuteriqi","orcid":null},{"first_name":"Olga","last_name":"Sizova","orcid":null},{"first_name":"David","last_name":"Thomson Taylor","orcid":null},{"first_name":"Maria","last_name":"Tereshchenko","orcid":null},{"first_name":"David","last_name":"Tieu","orcid":null},{"first_name":"Jacob","last_name":"Turowec","orcid":null},{"first_name":"Tajinder","last_name":"Ubhi","orcid":null},{"first_name":"Sylvia","last_name":"Varland","orcid":null},{"first_name":"Kyle E.","last_name":"Wang","orcid":null},{"first_name":"Zi Yang","last_name":"Wang","orcid":null},{"first_name":"Jiarun","last_name":"Wei","orcid":null},{"first_name":"YUXI","last_name":"XIAO","orcid":null},{"first_name":"Philipp G.","last_name":"Maass","orcid":null},{"first_name":"Bruno","last_name":"Reversade","orcid":null},{"first_name":"Grant W.","last_name":"Brown","orcid":null},{"first_name":"Bejamin F.","last_name":"Cravatt","orcid":null},{"first_name":"Scott","last_name":"Dixon","orcid":null},{"first_name":"Haley D. M.","last_name":"Wyatt","orcid":null},{"first_name":"Hannes L.","last_name":"Röst","orcid":null},{"first_name":"Frederick P.","last_name":"Roth","orcid":null},{"first_name":"Tian","last_name":"Xia","orcid":null},{"first_name":"Gary D.","last_name":"Bader","orcid":null},{"first_name":"Robbie","last_name":"Loewith","orcid":null},{"first_name":"Nicholas G.","last_name":"Davis","orcid":null},{"first_name":"Brenda","last_name":"Andrews","orcid":null},{"first_name":"Chad","last_name":"Myers","orcid":null},{"first_name":"Jason","last_name":"Moffat","orcid":null},{"first_name":"Charles","last_name":"Boone","orcid":null}],"funders":[{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"MOP_142735"},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","grant_id":"MCB1818293"},{"id":"https://ror.org/01h531d29","name":"Natural Sciences and Engineering Research Council of Canada","grant_id":"RGPIN-2020-04180"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT 173542"},{"id":"https://ror.org/000az4664","name":"Canada Foundation for Innovation","grant_id":"39977"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE09-011"},{"id":"https://ror.org/051639p85","name":"Ontario Research Foundation","grant_id":"RE011-006"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-180285"},{"id":"https://ror.org/01gavpb45","name":"Canadian Institutes of Health Research","grant_id":"PJT-GMX-463531"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2024-08-02"},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","grant_id":"DFG Bi 2086/1-1"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG005084"},{"id":null,"name":"McLauglin Centre Accelerator","grant_id":"MC-2022-02"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"R01HG00583"},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","grant_id":"T32GM008347"},{"id":null,"name":"NIH/NCI Ruth L. Kirschstein National Research F30 Award","grant_id":"5F30CA257227"}],"categories":["Genetics","Biological Network"],"journal_issn":[]},{"id":"2v5jg2zksj","title":"TMEM79/MATTRIN defines a pathway for Frizzled regulation and is required for Xenopus embryogenesis","description":"Absctract\nWnt signaling through the Frizzled (FZD) family of serpentine receptors is essential for embryogenesis and homeostasis, and stringent control of the FZD protein level is critical for stem cell regulation. Through CRISPR/Cas9 genome-wide screening in human cells, we identified TMEM79/MATTRIN, an orphan multi-span transmembrane protein, as a specific inhibitor of Wnt/FZD signaling. TMEM79 interacts with FZD during biogenesis and promotes FZD degradation independent of ZNRF3/RNF43 ubiquitin ligases (R-spondin receptors). TMEM79 interacts with ubiquitin-specific protease 8 (USP8), whose activating mutations underlie human tumorigenesis. TMEM79 specifically inhibits USP8 deubiquitination of FZD, thereby governing USP8 substrate specificity and promoting FZD degradation. Tmem79 and Usp8 genes have a pre-bilaterian origin, and Tmem79 inhibition of Usp8 and Wnt signaling is required for anterior neural development and gastrulation in Xenopus embryos. TMEM79 is a predisposition gene for Atopic dermatitis, suggesting deregulation of Wnt/FZD signaling a possible cause for this most common yet enigmatic inflammatory skin disease.","source":{"id":"7377952c-6404-4428-bbfc-77242cfc301e","name":"Mendeley Data","external":false},"publication_date":"2020-09-26T05:47:58.606Z","url":"https://data.mendeley.com/datasets/2v5jg2zksj","data_type":"dataset","access":"open","doi":["10.17632/2v5jg2zksj"],"contributors":[{"first_name":"Maorong","last_name":"Chen","orcid":null},{"first_name":"Nathalia","last_name":"Amado","orcid":null},{"first_name":"Jieqiong","last_name":"Tan","orcid":null},{"first_name":"Alice ","last_name":"Reis","orcid":null},{"first_name":"Mengxu","last_name":"Ge","orcid":null},{"first_name":"Jose","last_name":"Abreu","orcid":null},{"first_name":"Xi","last_name":"He","orcid":null}],"funders":[],"categories":["Biochemistry","Molecular Biology"],"journal_issn":[]}],"total_records":131334,"page":1,"page_size":10,"execution_time":397,"aggregations":{"data_type_stats":{"dataset":131334,"collection":0},"access_type_stats":{"open":130682,"restricted":64,"embargoed":588},"top_funders_stats":[{"id":"https://ror.org/01h0zpd94","name":"National Natural Science Foundation of China","count":2210},{"id":"https://ror.org/01cwqze88","name":"National Institutes of Health","count":676},{"id":"https://ror.org/03ha2q922","name":"National Science Center","count":468},{"id":"https://ror.org/02ddkpn78","name":"Fundação de Amparo à Pesquisa do Estado de São Paulo","count":404},{"id":"https://ror.org/00x0ma614","name":"Coordenação de Aperfeicoamento de Pessoal de Nível Superior","count":401},{"id":"https://ror.org/03swz6y49","name":"National Council for Scientific and Technological Development","count":388},{"id":"https://ror.org/021nxhr62","name":"U.S. National Science Foundation","count":380},{"id":"https://ror.org/018mejw64","name":"Deutsche Forschungsgemeinschaft","count":327},{"id":"https://ror.org/00hhkn466","name":"Japan Society for the Promotion of Science","count":270},{"id":"https://ror.org/00k4n6c32","name":"European Commission","count":222}],"source_stats":[{"id":"MENDELEY_DATA","name":"Mendeley Data","count":128700},{"id":"f881433a-b1cd-40d2-ab9f-4fd501f2d14b","name":"Elsevier Data Repository","count":1904},{"id":"a191461c-0227-403f-a1e9-621e0e0429cc","name":"San Raffaele Open Research Data Repository","count":183},{"id":"b07018a5-fee6-4df1-9d43-ff0d81ad75ed","name":"Bicocca Open Archive Research Data","count":133},{"id":"df228bbb-ac66-410f-8c66-f61608d63d95","name":"University of South Florida","count":78},{"id":"2a9d1b7d-e447-466f-888f-aa6f84e575e4","name":"Digital Commons Data@Becker","count":66},{"id":"72c28c45-627f-446b-8a48-af7c0a51a357","name":"Università Cattolica del Sacro Cuore","count":55},{"id":"b121dfec-bb51-4f19-a2f6-bc9ce0197286","name":"Babeș-Bolyai University","count":37},{"id":"7e51a2dd-133e-43c6-a220-12c1958e202a","name":"University of Canberra","count":31},{"id":"f2ed6517-7fb4-4e02-8cef-95e75e9f0c9d","name":"Embry-Riddle Aeronautical University","count":28}],"top_institutions_stats":[{"id":"3bfef41a-d03e-5722-bd55-dd245235fa78","name":"Bina Nusantara University","count":488},{"id":"0ad97c43-5173-56e6-bbe6-46dad5323862","name":"Daffodil International University","count":405},{"id":"55ba66b2-f276-5204-a3d8-acfa499794e0","name":"The University of Manchester","count":366},{"id":"f58d7a83-6efa-5d8a-a6c2-b9e78ee14783","name":"Maharishi Markandeshwar Institute of Physiotherapy and Rehabilitation","count":354},{"id":"48c8fa0f-965c-5cbf-a859-a5363432478b","name":"Universidade de Sao Paulo","count":291}]}}