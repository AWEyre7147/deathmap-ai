  } ],
  "section" : {
    "accno" : "s-E-MTAB-9482",
    "type" : "Study",
    "attributes" : [ {
      "name" : "Title",
      "value" : "In vivo CRISPR/Cas9 screen to identify candidate therapeutic gene targets to enhance docetaxel efficacy in prostate cancer"
    }, {
      "name" : "Study type",
      "value" : "DNA-seq",
      "valqual" : [ {
        "name" : "Ontology",
        "value" : "EFO"
      }, {
        "name" : "TermId",
        "value" : "EFO_0002693"
      } ]
    }, {
      "name" : "Study type",
      "value" : "Animal - High-throughput sequencing"
    }, {
      "name" : "Organism",
      "value" : "Mus musculus"
    }, {
      "name" : "Description",
      "value" : "Docetaxel chemotherapy in metastatic prostate cancer offers only a modest survival benefit due to emerging resistance. To identify candidate therapeutic gene targets, we applied a murine prostate cancer orthograft model that recapitulates clinical invasive prostate cancer in a genome-wide CRISPR/Cas9 screen under docetaxel treatment pressure."
    } ],
    "links" : [ [ {
      "url" : "E-MTAB-9484",
      "attributes" : [ {
        "name" : "Type",
        "value" : "Biostudies"
      } ]
    } ], [ {
      "url" : "ERP123631",
      "attributes" : [ {
        "name" : "Type",
        "value" : "ENA"
      } ]
    } ] ],
    "subsections" : [ [ {
      "accno" : "P-MTAB-100416",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-100416"
      }, {
        "name" : "Type",
        "value" : "normalization data transformation protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0003816"
        } ]
      }, {
        "name" : "Description",
        "value" : "Collected sgRNA read counts were normalised by total read counts (--norm-method total) and only sgRNAs with an average expression higher than 100 reads across the treatment groups (either vehicle or docetaxel), and genes with at least 2 sgRNAs detected were kept for further analysis."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-100415",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-100415"
      }, {
        "name" : "Type",
        "value" : "nucleic acid sequencing protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0004170"
        } ]
      }, {
        "name" : "Description",
        "value" : "Libraries for the different samples were pooled and sequenced on an Illumina NextSeq500."
      }, {
        "name" : "Hardware",
        "value" : "NextSeq 500"
      } ]
    }, {
      "accno" : "P-MTAB-100413",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-100413"
      }, {
        "name" : "Type",
        "value" : "nucleic acid extraction protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0002944"
        } ]
      }, {
        "name" : "Description",
        "value" : "DNA was extracted from 100mg of ground tumour (or entire tumour if weight under 100mg) using QIAamp DNA Mini kit (Qiagen) as per the manufacturer’s instructions."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-100414",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-100414"
      }, {
        "name" : "Type",
        "value" : "nucleic acid library construction protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0004184"
        } ]
      }, {
        "name" : "Description",
        "value" : "DNA was prepared for deep sequencing by conducting a two-step PCR. The initial PCR amplified a region of the gRNA cassette to maintain library representation, while the second PCR added the primers required for sequencing. PCR was repeated 35 times for 100 fold library representation. All PCR products per sample were combined and used in the second PCR round to add the primers required for sequencing. PCR products from each sample were again combined and concentrated using a QIAquick PCR Purification Kit (Qiagen) as per the manufacturer’s instructions. Each sample was run on a 1.5% agarose gel. Bands were excised and DNA purified using a QIAquick Gel Extraction Kit before sending for sequencing."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-100412",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-100412"
      }, {
        "name" : "Type",
        "value" : "sample collection protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0005518"
        } ]
      }, {
        "name" : "Description",
        "value" : "DNA was extracted from each whole tumour using the Blood and Cell Culture DNA Maxi kit (Qiagen) according to the manufacturer’s instructions."
      }, {
        "name" : "Hardware"
      } ]
    } ], {
