{
  "accno" : "E-MTAB-8125",
  "attributes" : [ {
    "name" : "Title",
    "value" : "Genome-scale CRISPR-Cas9 knockout screens for enterovirus D68 and rhinovirus C15"
  }, {
    "name" : "ReleaseDate",
    "value" : "2019-07-10"
  }, {
    "name" : "RootPath",
    "value" : "E-MTAB-8125"
