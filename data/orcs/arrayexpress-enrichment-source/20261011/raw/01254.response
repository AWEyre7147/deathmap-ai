{
  "accno" : "E-GEOD-75189",
  "attributes" : [ {
    "name" : "Title",
    "value" : "High-Resolution CRISPR Screens Reveal Fitness Genes and Genotype-Specific Cancer Liabilities"
  }, {
    "name" : "ReleaseDate",
    "value" : "2015-11-25"
  }, {
    "name" : "RootPath",
    "value" : "E-GEOD-75189"
  }, {
