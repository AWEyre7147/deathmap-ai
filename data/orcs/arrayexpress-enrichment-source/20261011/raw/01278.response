    "attributes" : [ {
      "name" : "Title",
      "value" : "Functional genomic screens in human cells to identify host factors for SARS-CoV-2 and common cold coronaviruses"
    }, {
      "name" : "Study type",
      "value" : "Cell line - High-throughput sequencing"
    }, {
      "name" : "Study type",
      "value" : "genotyping by high throughput sequencing",
      "valqual" : [ {
        "name" : "Ontology",
        "value" : "EFO"
      }, {
        "name" : "TermId",
        "value" : "EFO_0002771"
      } ]
    }, {
      "name" : "Organism",
      "value" : "Homo sapiens"
    }, {
      "name" : "Description",
      "value" : "We performed genome-wide CRISPR KO screens in human Huh7.5.1 cells to select for mutations that render host cells resistant to viral infection by SARS-CoV-2, human coronavirus 229E and OC43."
    } ],
    "links" : [ [ {
      "url" : "ERP124350",
      "attributes" : [ {
        "name" : "Type",
        "value" : "ENA"
      } ]
    } ] ],
    "subsections" : [ [ {
      "accno" : "P-MTAB-101835",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-101835"
      }, {
        "name" : "Type",
        "value" : "nucleic acid extraction protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0002944"
        } ]
      }, {
        "name" : "Description",
        "value" : "Genomic DNA extraction using QIAamp DNA Blood Maxi Kit (Qiagen) or Quick-DNA Midiprep Plus (Zymo)."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-101834",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-101834"
      }, {
        "name" : "Type",
        "value" : "sample collection protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0005518"
        } ]
      }, {
        "name" : "Description",
        "value" : "~60 million cells of unselected library cells were trypsinized and pelleted or 10-20 millions cells of virus selected cells were trypsinized and pelleted."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-101837",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-101837"
      }, {
        "name" : "Type",
        "value" : "nucleic acid sequencing protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0004170"
        } ]
      }, {
        "name" : "Description",
        "value" : "Pooled libraries were sequenced on an Illumina NextSeq 500 using a custom sequencing primer. Sequencing was performed using single-ed read for 25 cycles, and two index reads for 8 cycles."
      }, {
        "name" : "Hardware",
        "value" : "NextSeq 550"
      } ]
    }, {
      "accno" : "P-MTAB-101836",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-101836"
      }, {
        "name" : "Type",
        "value" : "nucleic acid library construction protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0004184"
        } ]
      }, {
        "name" : "Description",
        "value" : "The sgRNA expression cassettes were amplified from gDNA in a two-step nested PCR using KAPA HiFi HotStart ReadyMixPCR Kit (Kapa Biosystems). For PCR1, 40 reactions (for control samples) and 10-16 reactions (for virus selected samples) containing 4 μg gDNA were set up and amplified for 16 cycles. Reactions were pooled, mixed and 200 μl were cleaned up using QIAquick PCR Purification kit (Qiagen). For PCR2, 3 reactions containing 5 μl PCR1 product were amplified for 12 cycles using indexed primers. PCR products were gel purified using QIAquick Gel Extraction Kit (Qiagen)."
      }, {
        "name" : "Hardware"
      } ]
    } ], {
      "type" : "Author",
      "attributes" : [ {
        "name" : "Name",
        "value" : "Andreas Puschnik S"
