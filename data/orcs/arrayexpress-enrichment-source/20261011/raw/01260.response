      "value" : "DNA-seq",
      "valqual" : [ {
        "name" : "Ontology",
        "value" : "EFO"
      }, {
        "name" : "TermId",
        "value" : "EFO_0002693"
      } ]
    }, {
      "name" : "Organism",
      "value" : "Homo sapiens"
    }, {
      "name" : "Description",
      "value" : "Synthetic lethal CRISPR screen in MCF10A FBXW7 isogenic models"
    } ],
    "links" : [ [ {
      "url" : "ERP147176",
      "attributes" : [ {
        "name" : "Type",
        "value" : "ENA"
      } ]
    } ] ],
    "subsections" : [ [ {
      "accno" : "P-MTAB-132807",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-132807"
      }, {
        "name" : "Type",
        "value" : "sample collection protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0005518"
        } ]
      }, {
        "name" : "Description",
        "value" : "Inducible SpCas9 expressing cells were seeded for 1000x representation per sgRNA, and infected at a multiplicity of infection (MOI) of 0.3, to avoid multiple sgRNA infections per cell, using the previously published and validated genome-wide human lentiviral library (Kosuke Yusa Human GW CRISPR guide RNA library V1). After puromycin selection (1 µg/mL), cells were exposed to doxycycline for 3 days and harvested at day 0 (T0) and on day 14 (T1)."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-132808",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-132808"
      }, {
        "name" : "Type",
        "value" : "nucleic acid extraction protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0002944"
        } ]
      }, {
        "name" : "Description",
        "value" : "Genomic DNA was extracted from the T=0 and T=1 samples using DNeasy Blood and Tissue Kit (Qiagen) as per manufacturers instructions."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-132809",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-132809"
      }, {
        "name" : "Type",
        "value" : "nucleic acid library construction protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0004184"
        } ]
      }, {
        "name" : "Description",
        "value" : "sgRNA sequence were amplified with Q5 polymerase (NEB) with the following primers Forward 5’- ACACTCTTTCCCTACACGACGCTCTTCCGATCTCTTGTGGAAAGGACGAAACA and Reverse 5’- TCGGCATTCCTGCTGAACCGCTCTTCCGATCTCTAAAGCGCATGCTCCAGAC."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-132810",
