    "accno" : "s-E-MTAB-8646",
    "type" : "Study",
    "attributes" : [ {
      "name" : "Title",
      "value" : "Genome-wide CRISPR knockout screen in Huh7.5.1 human hepatocytes for the identification of host factors of hepatitis A virus"
    }, {
      "name" : "Study type",
      "value" : "genotyping by high throughput sequencing",
      "valqual" : [ {
        "name" : "Ontology",
        "value" : "EFO"
      }, {
        "name" : "TermId",
        "value" : "EFO_0002771"
      } ]
    }, {
      "name" : "Study type",
      "value" : "Cell line - High-throughput sequencing"
    }, {
      "name" : "Organism",
      "value" : "Homo sapiens"
    }, {
      "name" : "Description",
      "value" : "A knockout cell library in Huh7.5.1 cells was generated by introducing a genome-scale CRISPR library (GeCKOv2, Addgene #1000000049) and subjected to hepatitis A virus infection (HM175/18f) to isolate virus-resistant mutant cells. Genomic DNA was isolated from the original and virus-selected mutant cell populations and abundance of guideRNA encoding sequences were measured by sequencing on an Illumina NextSeq (High Output)."
    } ],
    "links" : [ [ {
      "url" : "ERP119273",
      "attributes" : [ {
        "name" : "Type",
        "value" : "ENA"
      } ]
    } ] ],
    "subsections" : [ [ {
      "accno" : "P-MTAB-92495",
