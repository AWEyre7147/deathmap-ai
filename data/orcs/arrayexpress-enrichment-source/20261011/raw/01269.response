        "name" : "Name",
        "value" : "P-MTAB-92495"
      }, {
        "name" : "Type",
        "value" : "nucleic acid sequencing protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0004170"
        } ]
      }, {
        "name" : "Description",
        "value" : "Libraries for the different samples were pooled and sequenced on an Illumina NextSeq (High Output)."
      }, {
        "name" : "Hardware",
        "value" : "NextSeq 550"
      } ]
    }, {
      "accno" : "P-MTAB-92494",
