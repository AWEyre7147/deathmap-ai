          "value" : "EFO_0004184"
        } ]
      }, {
        "name" : "Description",
        "value" : "Guide RNA encoding DNA sequences were amplified in a two-step nested PCR using KAPA HiFi HotStart ReadyMixPCR Kit (Kapa Biosystems)."
      }, {
