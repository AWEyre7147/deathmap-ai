        } ]
      }, {
        "name" : "Description",
        "value" : "Genomic DNA from control and virus-selected cell populations were extracted using QIAamp DNA Blood Maxi Kit (Qiagen)."
      }, {
        "name" : "Hardware"
      } ]
    }, {
      "accno" : "P-MTAB-92492",
      "type" : "Protocols",
      "attributes" : [ {
        "name" : "Name",
        "value" : "P-MTAB-92492"
      }, {
        "name" : "Type",
        "value" : "sample collection protocol",
        "valqual" : [ {
          "name" : "Ontology",
          "value" : "EFO"
        }, {
          "name" : "TermId",
          "value" : "EFO_0005518"
        } ]
      }, {
        "name" : "Description",
        "value" : "A total of 60 million mutagenized cells for each sublibrary (A and B) were collected for genomic DNA extraction 10 days post-transduction with CRISPR libraries and used as control. A total of 45 million mutagenized cells for each sublibrary were infected with hepatitis A virus for 12 days and surviving cells were collected."
      }, {
        "name" : "Hardware"
      } ]
