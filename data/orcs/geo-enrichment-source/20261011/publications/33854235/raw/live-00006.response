^SERIES = GSE10846
!Series_title = Prediction of survival in diffuse large B cell lymphoma treated with chemotherapy plus Rituximab
!Series_geo_accession = GSE10846
!Series_status = Public on Nov 28 2008
!Series_submission_date = Mar 14 2008
!Series_last_update_date = Mar 25 2019
!Series_pubmed_id = 19038878
!Series_pubmed_id = 21546504
!Series_summary = Gene expression profiling of DLBCL patient samples was performed to investigate, whether molecular gene expression signatures retain their prognostic significance in patients treated with chemotherapy plus Rituximab. The lymphnode, germinal center signature and a new angiogenesis signature were combined to a final multivariate model which defined quartile groups among Rituximab-CHOP-treated patients with distinct 3-year overall survival rates.
!Series_summary = Keywords: clinical history design
!Series_overall_design = The retrospective study included 181 clinical samples from CHOP-treated patients and 233 clinical samples from Rituximab-CHOP-treated patients.
!Series_type = Expression profiling by array
