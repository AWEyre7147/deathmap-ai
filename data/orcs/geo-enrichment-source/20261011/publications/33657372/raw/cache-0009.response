^SERIES = GSE154545
!Series_title = RNA-seq profiling of A549 cells with sgRNA knockouts that confer prexasertib resistance
!Series_geo_accession = GSE154545
!Series_status = Public on Feb 24 2021
!Series_submission_date = Jul 16 2020
!Series_last_update_date = Mar 23 2021
!Series_pubmed_id = 33657372
!Series_summary = A549 cells with FOXM1 or LIN54 sgRNA knockout, which confers resistance to the CHK1 inhibitor prexasertib, were generated. These cells and control (empty vector) cells were synchronized in S phase, released for 1 hour and treated with 100 nM prexasertib or DMSO (vehicle) for 2 hours. RNA-seq profiling was performed to identify drug-induced perturbations in gene expression in these cells.
!Series_overall_design = RNA-seq profiling of A549 cells with sgRNA knockouts that confer prexasertib resistance, compared to control A549 cells, with or without prexasertib treatment
!Series_type = Expression profiling by high throughput sequencing
