^SERIES = GSE145308
!Series_title = Pooled CRISPR screens in human intestinal organoids [RNA-seq]
!Series_geo_accession = GSE145308
!Series_status = Public on Feb 26 2020
!Series_submission_date = Feb 14 2020
!Series_last_update_date = Jun 11 2020
!Series_pubmed_id = 32142663
!Series_summary = We performed CRISPR screens on both a sub-library and a genome-wide scale in human intestinal organoids to discover cancer driver genes. We investigated the Wnt and the TGFB pathway and used both WT, APC-mutant and APC-TP53-mutant organoids.
!Series_overall_design = To investigate how the identified SWI/SNF screening hits confer TGFB resistance, we assessed changes in gene expression upon ARID1A or SMARCA4 perturbation and TGFB treatment using RNA-seq
!Series_type = Expression profiling by high throughput sequencing
