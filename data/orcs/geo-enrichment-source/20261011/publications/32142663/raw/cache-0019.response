^SERIES = GSE145184
!Series_title = Pooled CRISPR screens in human intestinal organoids [CRISPR screens]
!Series_geo_accession = GSE145184
!Series_status = Public on Feb 26 2020
!Series_submission_date = Feb 12 2020
!Series_last_update_date = May 05 2020
!Series_pubmed_id = 32142663
!Series_summary = We performed CRISPR screens on both a sub-library and a genome-wide scale in human intestinal organoids to discover cancer driver genes. We investigated the Wnt and the TGFB pathway and used both WT, APC-mutant and APC-TP53-mutant organoids.
!Series_overall_design = We used lentiviral transduction of CRISPR-Cas9-sgRNA libraries in human intestinal organoids. After selection, we amplified sgRNA sequences and performed amplicon sequencing.
