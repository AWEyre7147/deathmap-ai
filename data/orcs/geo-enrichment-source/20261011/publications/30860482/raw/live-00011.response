^SERIES = GSE64019
!Series_title = Mouse Smarcb1-deficient models recapitulate subtypes of human rhabdoid tumors.
!Series_geo_accession = GSE64019
!Series_status = Public on Jan 27 2016
!Series_submission_date = Dec 09 2014
!Series_last_update_date = Mar 26 2019
!Series_pubmed_id = 26818002
!Series_summary = Rhabdoid Tumors (RT) are highly aggressive tumors that are frequently localized in the central nervous system (CNS) where they are termed atypical teratoid and rhabdoid tumors (ATRT). We generated conditional Smarcb1-deficient mouse model leads to CNS Smarcb1-deficient tumors.
!Series_summary = We used microarrays to compared gene expression profilings of various human and mouse tumors. Our data demonstrate that the Smarcb1-deficient mouse model recapitulates the diversity of human RT.
!Series_overall_design = [human mRNA] 20 human MRT ( < 5 years), 30 human ATRT ( < 5 years), 4 human MB SHH.
!Series_overall_design = [mouse mRNA] 8 Smarcb1-deficient mouse brain tumors, 15 Smarcb1-deficient T-Cell lymphomas, 3 Mb Shh  mouse tumors.
!Series_type = Expression profiling by array
!Series_contributor = Franck,,Bourdeaut
!Series_contributor = Wilfrid,,Richer
!Series_contributor = Zhi-Yan,,Han
