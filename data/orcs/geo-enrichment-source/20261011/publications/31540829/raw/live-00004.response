ks","Tags":["related_data"],"SectionLinkCount":1,"Linklist":{"Link":[{"ObtainedBy":"ext_links","PublicationDate":"04-10-2023","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"https://www.glygen.org/publication/MED/31540829","IDScheme":"URL","IDURL":"https://www.glygen.org/publication/MED/31540829"},"Title":"Protein - P47224","Publisher":{"Name":"GlyGen glycoinformatics resource"}}}]}}]},{"Name":"Mouse Genome Informatics (MGI)","CategoryLinkCount":1,"Section":[{"ObtainedBy":"ext_links","Tags":["related_data"],"SectionLinkCount":1,"Linklist":{"Link":[{"ObtainedBy":"ext_links","PublicationDate":"17-06-2025","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"https://www.informatics.jax.org/reference/31540829","IDScheme":"URL","IDURL":"https://www.informatics.jax.org/reference/31540829"},"Publisher":{"Name":"Mouse Genome Informatics (MGI)"}}}]}}]},{"Name":"Protein Families","NameLong":"Protein families in InterPro","CategoryLinkCount":5,"Section":[{"ObtainedBy":"submission","Tags":["related_data"],"SectionLinkCount":5,"CollectionURL":"http://www.ebi.ac.uk/interpro/search?q=31540829","Linklist":{"Link":[{"ObtainedBy":"submission","PublicationDate":"11-02-2026","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"IPR056742","IDScheme":"InterPro","IDURL":"http://www.ebi.ac.uk/interpro/entry/IPR056742"},"Title":"['This entry represents the C-terminal region of a group of very long eukaryotic proteins, including the human BLTP1 and similar animal sequences. Bridge-like lipid transfer protein family member 1 (BLTP1, formerly known as Tweek/KIAA1109/FSA in human) is a tube-forming lipid transport protein which provides phosphatidylethanolamine for glycosylphosphatidylinositol (GPI) anchor synthesis in the endoplasmic reticulum. It plays a role in endosomal trafficking and endosome recycling and it is also ","Publisher":{"Name":"InterPro"}}},{"ObtainedBy":"submission","PublicationDate":"18-03-2026","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"PF25039","IDScheme":"InterPro","IDURL":"http://www.ebi.ac.uk/interpro/entry/PF25039"},"Title":"['This entry represents the middle region of a group of very long eukaryotic proteins, including the human BLTP1 (also known as KIAA1109) protein. These proteins are tube-forming lipid transport proteins that belong to the RBG (repeating beta-groove) superfamily. They consist of long hydrophobic grooves made of multiple repeating modules of five beta-sheets followed by a loop [[PMID:35491307],[PMID:35015055]]. BLTP1 is a tube-forming lipid transport protein which provides phosphatidylethanolamin","Publisher":{"Name":"InterPro"}}},{"ObtainedBy":"submission","PublicationDate":"11-02-2026","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"IPR047104","IDScheme":"InterPro","IDURL":"http://www.ebi.ac.uk/interpro/entry/IPR047104"},"Title":"['This entry represents the N-terminal domain of BLTP1 from animals  [[PMID:35015055]]. Bridge-like lipid transfer protein family member 1 (BLTP1, formerly known as Tweek/KIAA1109/FSA in human) is a tube-forming lipid transport protein which provides phosphatidylethanolamine for glycosylphosphatidylinositol (GPI) anchor synthesis in the endoplasmic reticulum. It plays a role in endosomal trafficking and endosome recycling and it is also involved in the actin cytoskeleton and cilia structural dyn","Publisher":{"Name":"InterPro"}}},{"ObtainedBy":"submission","PublicationDate":"11-02-2026","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"IPR056741","IDScheme":"InterPro","IDURL":"http://www.ebi.ac.uk/interpro/entry/IPR056741"},"Title":"['This entry represents the middle region of a group of very long animal proteins, including human BLTP1. Bridge-like lipid transfer protein family member 1 (BLTP1, formerly known as Tweek/KIAA1109/FSA in human) is a tube-forming lipid transport protein which provides phosphatidylethanolamine for glycosylphosphatidylinositol (GPI) anchor synthesis in the endoplasmic reticulum. It plays a role in endosomal trafficking and endosome recycling and it is also involved in the actin cytoskeleton and ci","Publisher":{"Name":"InterPro"}}},{"ObtainedBy":"submission","PublicationDate":"18-03-2026","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"PF25040","IDScheme":"InterPro","IDURL":"http://www.ebi.ac.uk/interpro/entry/PF25040"},"Title":"['This entry represents the C-terminal region of a group of very long eukaryotic proteins, including the human BLTP1 (also known as KIAA1109) protein. These proteins are tube-forming lipid transport proteins that belong to theRBG (repeating beta-groove) superfamily. They consist of long hydrophobic grooves made of multiple repeating modules of five beta-sheets followed by a loop [[PMID:35491307],[PMID:35015055]]. BLTP1 is a tube-forming lipid transport protein which provides phosphatidylethanola","Publisher":{"Name":"InterPro"}}}]}}]},{"Name":"iPTMnet","NameLong":"Protein post-translational modifications in iPTMnet","CategoryLinkCount":1,"Section":[{"ObtainedBy":"ext_links","Tags":["related_data"],"SectionLinkCount":1,"Linklist":{"Link":[{"ObtainedBy":"ext_links","PublicationDate":"30-11-2022","LinkProvider":{"Name":"Europe PMC"},"RelationshipType":{"Name":"IsReferencedBy"},"Source":{"Type":{"Name":"literature"},"Identifier":{"ID":"31540829","IDScheme":"PMID"}},"Target":{"Type":{"Name":"dataset"},"Identifier":{"ID":"http://research.bioinformatics.udel.edu/iptmnet/pmid/31540829/","IDScheme":"URL","IDURL":"http://research.bioinformatics.udel.edu/iptmnet/pmid/31540829/"},"Title":"iPTMnet","Publisher":{"Name":"iPTMnet"}}}]}}]}]}}