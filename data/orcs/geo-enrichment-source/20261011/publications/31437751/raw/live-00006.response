^SERIES = GSE10971
!Series_title = Gene expression data from non-malignant fallopian tube epithelium and high grade serous carcinoma.
!Series_geo_accession = GSE10971
!Series_status = Public on May 31 2008
!Series_submission_date = Mar 28 2008
!Series_last_update_date = Mar 25 2019
!Series_pubmed_id = 18593983
!Series_pubmed_id = 21263043
!Series_summary = The purpose of this study was to identify molecular alterations potentially involved in predisposition to adnexal serous carcinoma (SerCa) in the non-malignant fallopian tube epithelium   (FTE) of BRCA1/2-mutation carriers, given recent evidence implicating the distal FTE as a common source for SerCa.
!Series_summary = Keywords: disease state analysis
!Series_overall_design = We obtained and compared gene expression profiles of laser capture microdissected non-malignant distal FTE from 12 known BRCA1/2-mutation carriers (FTEb) and 12 control women  (FTEn) during the luteal and follicular phase, as well as 13 high grade tubal and ovarian SerCa.
!Series_type = Expression profiling by array
