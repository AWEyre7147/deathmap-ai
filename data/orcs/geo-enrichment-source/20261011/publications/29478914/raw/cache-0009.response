^SERIES = GSE107288
!Series_title = RNA-seq data of effects of DCPS inhibition in mouse AML cells (CALM/AF10) and in normal GMP cells. Overall mRNA profiles of CALM/AF10 (#1/#2) and MLL/AF9 (#1/#2).
!Series_geo_accession = GSE107288
!Series_status = Public on Nov 22 2018
!Series_submission_date = Nov 22 2017
!Series_last_update_date = May 15 2019
!Series_pubmed_id = 29478914
!Series_summary = Purpose: The goals of this study are to assess the possibility whether DCPS inhibition would impair pre-mRNA splicing in AML cells/normal GMP, and to assess overall effects of DCPS inhibition.
!Series_overall_design = Methods: mRNA profiles of AML (CALM/AF10) and normal GMP cells at 0h, 6h and 10h after RG3039 treatment were generated by deep sequencing, in triplicate, using NextSeq. RNA-seq data were analyzed using a bioinformatic pipeline enabling quantification of exon-exon junctions without predetermining alternative aplicing models of annotating splice junctions as described (Darman et al., 2015).
!Series_overall_design = Methods: RNA-seq experiments were performed using 4 indicated AML lines.
!Series_type = Expression profiling by high throughput sequencing
