^SERIES = GSE24863
!Series_title = B lymphocyte activation induces DNA methylation reprogramming and establishes a common epigenetic signature in memory B and plasma cell compartments [gene expression profiling]
!Series_geo_accession = GSE24863
!Series_status = Public on Aug 13 2013
!Series_submission_date = Oct 21 2010
!Series_last_update_date = Nov 12 2013
!Series_pubmed_id = 24013550
!Series_summary = DNA methylation profiling of human B cell populations representing a developmental series before and after immune activation.
!Series_summary = The B cells are derived from inflamed tonsils.  The B cells were already activated in vivo in patients, therefore there was no need to stimulate the B cells after isolation.
!Series_summary = Gene expression profiling was also performed from the same samples.
!Series_overall_design = Four B cell subsets:  Naïve, germinal center B cells (GC), memory B cells, and plasma cells (PC) were purified by FACS ex vivo from tonsils of 8 human subjects.  Methylated CpG island Recovery assay (MIRA) was utilized to enrich for methylated DNA fragments from each sample for microarray analysis.  RNA was copurified from the same cell samples for gene expression profiling on microarray.
!Series_overall_design = *** This Series reports gene expression profiling data. ***
!Series_type = Expression profiling by array
