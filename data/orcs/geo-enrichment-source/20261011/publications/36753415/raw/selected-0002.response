0378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D000086382" MajorTopicYN="Y">COVID-19</DescriptorName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D018388" MajorTopicYN="N">Codon, Terminator</DescriptorName><QualifierName UI="Q000235" MajorTopicYN="N">genetics</QualifierName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D058873" MajorTopicYN="N">Pandemics</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D014779" MajorTopicYN="N">Virus Replication</DescriptorName><QualifierName UI="Q000235" MajorTopicYN="N">genetics</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D012270" MajorTopicYN="N">Ribosomes</DescriptorName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D012367" MajorTopicYN="N">RNA, Viral</DescriptorName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading></MeshHeadingList><KeywordList Owner="NOTNLM"><Keyword MajorTopicYN="N">ABCE1</Keyword><Keyword MajorTopicYN="N">CP: Microbiology</Keyword><Keyword MajorTopicYN="N">CP: Molecular biology</Keyword><Keyword MajorTopicYN="N">DENR</Keyword><Keyword MajorTopicYN="N">DOHH</Keyword><Keyword MajorTopicYN="N">EIF5A</Keyword><Keyword MajorTopicYN="N">SARS-CoV-2</Keyword><Keyword MajorTopicYN="N">coronavirus</Keyword><Keyword MajorTopicYN="N">diphthamide</Keyword><Keyword MajorTopicYN="N">host factors</Keyword><Keyword MajorTopicYN="N">programmed ribosomal frameshifting</Keyword><Keyword MajorTopicYN="N">ribosome recycling</Keyword></KeywordList><CoiStatement>Declaration of interests J.T.M. is a scientific advisor for Ribometrix, Inc., and owns equity in Orbital Therapeutics, Inc.</CoiStatement></MedlineCitation><PubmedData><History><PubMedPubDate PubStatus="received"><Year>2022</Year><Month>7</Month