^SERIES = GSE40632
!Series_title = Genome-wide analysis of the Integrator complex (HTS)
!Series_geo_accession = GSE40632
!Series_status = Public on Sep 09 2014
!Series_submission_date = Sep 05 2012
!Series_last_update_date = Sep 11 2023
!Series_pubmed_id = 25201415
!Series_pubmed_id = 36920904
!Series_summary = We investigated the genomic occupancy of INTS11, in normal condition and after stimulation of EGF. Total RNAPII was profiled in the presence or absence of INTS11, along with the Super Elongation Complex proteins AFF4 and ELL2. Additionally, we extensively examined the transcriptional response to EGF, before and after depletion of INTS11, using RNA-seq on ribosome-depleted total RNA and Global Run-on sequencing (GRO-seq).
!Series_overall_design = Comparison of the genome-wide profiles of INTS11 and RNAPII in HeLa cells.
!Series_type = Genome binding/occupancy profiling by high throughput sequencing
!Series_type = Expression profiling by high throughput sequencing
