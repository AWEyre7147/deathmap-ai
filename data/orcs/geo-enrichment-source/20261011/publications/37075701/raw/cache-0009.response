^SERIES = GSE203362
!Series_title = A kinome-wide CRISPR screen identifies CK1α as a novel target to overcome enzalutamide resistance of prostate cancer
!Series_geo_accession = GSE203362
!Series_status = Public on Mar 10 2023
!Series_submission_date = May 19 2022
!Series_last_update_date = Jun 09 2023
!Series_pubmed_id = 37075701
!Series_web_link = https://pubmed.ncbi.nlm.nih.gov/37075701/
!Series_summary = Utilizing a kinome-wide CRISPR-Cas9 knockout screen, we identified casein kinase 1 alpha (CK1α) as a novel therapeutic target to overcome enzalutamide resistance. To dissect the underlying mechanisms of targeting CK1α to sensitize cancer cells to ENZA, we performed RNA sequencing of 22Rv1 cells upon CK1α knockout or overexpression. We found that CK1α regulated double-strand break (DSB)-response signaling.
!Series_overall_design = 1, CRISPR screen identifies novel targets to overcome enzalutamide resistance. 2, RNA sequening to address the mechanisms of targeiting the target to overcome enzalutamide resistance.
!Series_type = Expression profiling by high throughput sequencing
!Series_type = Other
