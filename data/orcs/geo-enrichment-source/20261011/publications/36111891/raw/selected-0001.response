</LastName><ForeName>Jeffery</ForeName><Initials>J</Initials><Identifier Source="ORCID">0000-0001-9885-3527</Identifier><AffiliationInfo><Affiliation>Department of Oncology, St. Jude Children's Research Hospital, Memphis, TN.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Ribeiro</LastName><ForeName>Raul</ForeName><Initials>R</Initials><Identifier Source="ORCID">0000-0002-9956-5647</Identifier><AffiliationInfo><Affiliation>Department of Oncology, St. Jude Children's Research Hospital, Memphis, TN.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Downing</LastName><ForeName>James</ForeName><Initials>J</Initials><AffiliationInfo><Affiliation>Department of Pathology, St. Jude Children's Research Hospital, Memphis, TN.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Cao</LastName><ForeName>Xueyuan</ForeName><Initials>X</Initials><AffiliationInfo><Affiliation>University of Tennessee Health Science Center, Memphis, TN.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Pounds</LastName><ForeName>Stanley B</ForeName><Initials>SB</Initials><AffiliationInfo><Affiliation>Department of Biostatistics, St. Jude Children's Research Hospital, Memphis, TN.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Vulpe</LastName><ForeName>Christopher D</ForeName><Initials>CD</Initials><AffiliationInfo><Affiliation>UF Health Cancer Center, Gainesville, FL.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Lamba</LastName><ForeName>Jatinder K</ForeName><Initials>JK</Initials><Identifier Source="ORCID">0000-0003-0411-0007</Identifier><AffiliationInfo><Affiliation>Department of Pharmacotherapy and Translational Research and Center for Pharmacogenomics and Precision Medicine, College of Pharmacy, University of Florida, Gainesville, FL.</Affiliation></AffiliationInfo></Author></AuthorList><Language>eng</Language><GrantList CompleteYN="Y"><Grant><GrantID>R01 CA132946</Grant