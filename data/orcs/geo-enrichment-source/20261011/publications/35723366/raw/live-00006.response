^SERIES = GSE189405
!Series_title = A genome-wide CRISPR/Cas9 screen identifies therapeutic targets required for  the tumorigenesis of ovarian clear cell carcinoma (OCCC).
!Series_geo_accession = GSE189405
!Series_status = Public on Jun 08 2022
!Series_submission_date = Nov 23 2021
!Series_last_update_date = Jul 07 2022
!Series_pubmed_id = 35377528
!Series_summary = To identify genes critical for the proliferation of ovarian clear cell carcinoma (OCCC), we performed CRISPR/CAS9 screens against the OCCC cell lines OVICE, ES2, TOV21G and JHOC5 using the TKOv3 sgRNA library.
!Series_overall_design = Genome-wide CRISPR/Cas9  screen of OVISE, TOV21G, ES2 and JHOC5 (ovarian cancer cell) using the Toronto KnockOut (TKO) CRISPR Library (TKOv3). 2 biological replicates (OVISE, TOV21G, ES2) and 1 biological replicate (JHOC5).
