^SERIES = GSE220614
!Series_title = Systematic interrogation of tumor cell resistance to chimeric antigen receptor T cell therapy in pancreatic cancer
!Series_geo_accession = GSE220614
!Series_status = Public on Dec 15 2022
!Series_submission_date = Dec 09 2022
!Series_last_update_date = Mar 16 2023
!Series_pubmed_id = 36548402
!Series_summary = TFAP4 scored strongly in our screen for MSLN CAR T cell resistance; to interogate its function, we performed RNAseq following TFAP4 knockdown and overexpression in HupT3 pancreatic cancer cells.
!Series_overall_design = For TFAP4 knockdown experiments, we compared gene expression in control HupT3 cells (generated using two different intergenic guides ) to TFAP4 knockout HupT3 cells (generated using two different TFAP4 guides) (all samples in triplicate)
!Series_overall_design = For TFAP4 overexpression experiments, we compared gene expression in HupT3 cells following overexpression of control (eGFP) or TFAP4  (all samples in triplicate)
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Hahn,,William
