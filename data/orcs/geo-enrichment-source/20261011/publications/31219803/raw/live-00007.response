^SERIES = GSE3790
!Series_title = Human cerebellum, frontal cortex [BA4, BA9] and caudate nucleus HD tissue experiment
!Series_geo_accession = GSE3790
!Series_status = Public on Feb 08 2006
!Series_submission_date = Dec 08 2005
!Series_last_update_date = Aug 29 2019
!Series_pubmed_id = 16467349
!Series_pubmed_id = 16623940
!Series_summary = Post mortem human brain tissue comparison between HD patients and controls from 3 brain regions - cerebellum, frontal cortex [BA4, BA9] and caudate nucleus.  Gene expression analysed using linear models from LIMMA package in Bioconductor suite.
!Series_summary = Keywords: disease state analysis
!Series_overall_design = Large sample sizes were used to examine brain tissue gene expression at various stages of HD pathology.  Three brain regions were profiled, compared and analysed for differential gene expression.  The broad aim was to capture early stage gene expression changes in HD brains.
!Series_type = Expression profiling by array
