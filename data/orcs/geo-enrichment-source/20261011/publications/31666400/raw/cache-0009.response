^SERIES = GSE136032
!Series_title = Effect of venetoclax, tedizolid, and combination treatment on gene expression in a venetoclax-resistant AML cell line
!Series_geo_accession = GSE136032
!Series_status = Public on Aug 20 2019
!Series_submission_date = Aug 19 2019
!Series_last_update_date = Nov 19 2019
!Series_pubmed_id = 31666400
!Series_summary = The goal of this study was to profile the changes in gene expression in an AML cell line with acquired resistance to venetoclax in response to treatment with venetoclax, tedizolid, or combination of the 2 drugs.
!Series_overall_design = Venetoclax-resistant MOLM13 cells (designated MOLM13-R2) were treated with DMSO (vehicle control), venetoclax alone (500 nM), tedizolid alone (5 uM), or combination of the two drugs for 4 days. Total RNA was extracted from each sample and subjected to RNA-seq analysis. Two technical replicates for each treatment condition.
!Series_type = Expression profiling by high throughput sequencing
