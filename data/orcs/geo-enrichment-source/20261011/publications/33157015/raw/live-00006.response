^SERIES = GSE145430
!Series_title = Identifying differentially expressed genes in Zmat3 knockout cells
!Series_geo_accession = GSE145430
!Series_status = Public on Nov 06 2020
!Series_submission_date = Feb 18 2020
!Series_last_update_date = Nov 06 2020
!Series_summary = The goal of the study was to identify genes whose expression is Zmat3 depedent using RNA-seq.
!Series_overall_design = We used CRISPR/Cas9 to knockout Zmat3 in Cas9+ E1A;HrasG12V mouse embryonic fibroblasts (MEFs).  After selection for Zmat3 or negative control sgRNAs, cells were cultured for 10 days, and then RNA was collected for RNA-seq, using Illumina TruSeq v2.
!Series_type = Expression profiling by high throughput sequencing
