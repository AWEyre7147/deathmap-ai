^SERIES = GSE129607
!Series_title = Genome-wide analysis of MAFG binding in astrocytes during EAE [ChIP-seq]
!Series_geo_accession = GSE129607
!Series_status = Public on Feb 12 2020
!Series_submission_date = Apr 10 2019
