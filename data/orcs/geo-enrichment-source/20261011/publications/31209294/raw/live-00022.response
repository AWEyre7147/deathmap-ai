^SERIES = GSE85766
!Series_title = Cellular model of colon cancer progression reveals signatures of mRNAs, miRNA, lncRNAs and epigenetic modifications associated with metastasis.
!Series_geo_accession = GSE85766
!Series_status = Public on Mar 28 2017
!Series_submission_date = Aug 17 2016
!Series_last_update_date = May 15 2019
!Series_pubmed_id = 28130225
!Series_summary = H3K4me3, H3K27me3, and H3K79me3 profiling of a cellular model of colorectal cancer progression, which is based on four defined derivates of a CRC cell line that resulted from EMT/MET transitions and phenotypically recapitulate the metastatic cascade: epithelial-like primary tumor, mesenchymal-like tumor cells growing in soft agar or as colonospheres, and mouse xenografts of the latter resulting in lung-metastasis comprised of epithelial-state cells.
!Series_overall_design = H3K4me3, H3K27me3, and H3K79me3
!Series_type = Genome binding/occupancy profiling by high throughput sequencing
