^SERIES = GSE105771
!Series_title = Transcriptional profile of human STAT1-/- fibroblasts expressing IFI6 or empty control vector
!Series_geo_accession = GSE105771
!Series_status = Public on Dec 01 2018
!Series_submission_date = Oct 23 2017
!Series_last_update_date = May 15 2019
!Series_pubmed_id = 30224801
!Series_summary = Detection of viral infection by pattern-recognition receptors triggers production of interferon. Secreted interferon binds to cognate receptors, triggering JAK/STAT signaling, resulting in the transcription and production of hundreds of interferon-stimulated genes (ISGs). Our lab identified interferon alpha inducible protein 6 (IFI6) as an ISG that potently suppresses replication of viruses from the Flavivirus genus. To test whether the inhibitory effects of IFI6 were due to activating expression of other antiviral ISGs, we overexpressed IFI6 and a control vector and examined global transcription using RNA-Seq.
!Series_overall_design = Human STAT1-deficient fibroblasts stably expressing IFI6 or empty control vector in biological triplicate.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = R,B,Richardson
