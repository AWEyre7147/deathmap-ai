^SERIES = GSE165252
!Series_title = RNA sequencing of the phase II PERFECT trial combining a PD-L1 inhibitor (atezolizumab) with neoadjuvant chemoradiotherapy in resectable esophageal adenocarcinoma patients.
!Series_geo_accession = GSE165252
!Series_status = Public on Feb 04 2021
!Series_submission_date = Jan 21 2021
!Series_last_update_date = Feb 08 2021
!Series_pubmed_id = 33504550
!Series_summary = We performed bulk RNA sequencing of tumor biopsies from patients before treatment, on-treatment and in case a poor response was suspected from the resection specimen. At baseline we found in responding patients a higher six-gene IFNy score compared to non-responders. On-treatment non-responders showed either high expression of co-inhibitory checkpoints with a high number of cytotoxic lymphocytes or low expression and a low number of cytotoxic lymphocytes.
!Series_overall_design = RNA sequencing of esophageal tumor biopsies at baseline from patients, on-treatment (3rd week) and at resection.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Tom,,van den Ende
!Series_contributor = Mark,P,Dings
!Series_contributor = Maarten,F,Bijlsma
