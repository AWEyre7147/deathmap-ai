^SERIES = GSE87455
!Series_title = Assessment of tumor pathological and transcriptional biomarkers in pre- and on-treatment core biopsies predictive of response and outcome after neoadjuvant chemotherapy plus Bevacizumab in patients with HER2-negative breast cancer
!Series_geo_accession = GSE87455
!Series_status = Public on Sep 01 2017
!Series_submission_date = Sep 28 2016
!Series_last_update_date = Jun 13 2019
