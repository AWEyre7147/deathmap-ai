</LastName><ForeName>Gary A</ForeName><Initials>GA</Initials><AffiliationInfo><Affiliation>Department of Pediatrics, Washington University School of Medicine, St. Louis, MO 63110.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Virgin</LastName><ForeName>Herbert W</ForeName><Initials>HW</Initials><Identifier Source="ORCID">0000-0001-8580-7628</Identifier><AffiliationInfo><Affiliation>Department of Pathology and Immunology, Washington University School of Medicine, St. Louis, MO 63110; aorvedahl@wustl.edu svirgin@vir.bio.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Department of Molecular Microbiology, Washington University School of Medicine, St. Louis, MO 63110.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Department of Medicine, Washington University School of Medicine, St. Louis, MO 63110.</Affiliation></AffiliationInfo></Author></AuthorList><Language>eng</Language><GrantList CompleteYN="Y"><Grant><GrantID>U19 AI109725</GrantID><Acronym>AI</Acronym><Agency>NIAID NIH HHS</Agency><Country>United States</Country></Grant><Grant><GrantID>R01 DK104946</GrantID><Acronym>DK</Acronym><Agency>NIDDK NIH HHS</Agency><Country>United States</Country></Grant><Grant><GrantID>T32 AI106688</GrantID><Acronym>AI</Acronym><Agency>NIAID NIH HHS</Agency><Country>United States</Country></Grant><Grant><GrantID>R00 DK116666</GrantID><Acronym>DK</Acronym><Agency>NIDDK NIH HHS</Agency><Country>United States</Country></Grant><Grant><GrantID>P30 CA091842</GrantID><Acronym>CA</Acronym><Agency>NCI NIH HHS</Agency><Country>United States</Country></Grant><Grant><GrantID>U19 AI142784</GrantID><Acronym>AI</Acronym><Agency>NIAID NIH HHS</Agency><Country>United States</Country></Grant><Grant><GrantID>K99 DK116666</GrantID><Acronym>DK</Acronym><Agency>NIDDK NIH HHS</Agency><Country>United States</Country></Grant><Grant><GrantID>R01 DK114047</GrantID><Acronym>DK</Acronym><Agency>NIDDK NIH HHS</Agency><Country>United States</Country></Grant></GrantL