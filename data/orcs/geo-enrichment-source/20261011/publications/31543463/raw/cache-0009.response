^SERIES = GSE128563
!Series_title = Genetic determinants of venetoclax resistance
!Series_geo_accession = GSE128563
!Series_status = Public on Sep 25 2019
!Series_submission_date = Mar 19 2019
!Series_last_update_date = Sep 25 2019
!Series_pubmed_id = 31543463
!Series_summary = Resistance to the first approved BCL-2 inhibitor venetoclax is emerging in lymphoid malignancies. The study aimed to identify the genetic determinants of such resistance. From genome-scale screens we determined the genes influencing the sensitivity to BCL-2 inhibition. The present set of data is related to expression changes (assessed by RNA sequencing) observed in the resistant OCI-Ly1 lymphoma cell line as well as those resulting from genetic perturbation (using CRISPR-Cas9) targeting the genes highlighted in our genome-scale screen.
!Series_overall_design = Expression changes (RNA sequencing data) of 32 engineered OCI-Ly1 cell lines (duplicates for each): venetoclax resistant, parental and CRISPR-Cas9 manipulated cell lines with 2 different sgRNA per target (non-targeting sgRNA, ID3-KO, NFKBIA-KO, IKZF5-KO, OTUD5-KO, UBR5-KO, EP300-KO).
!Series_overall_design = ATAC-seq of the ID3 OCI-Ly1 knockout (vs control) lines and of the OCI-Ly1-R vs OCI-Ly1-S (duplicates for each).
!Series_type = Expression profiling by high throughput sequencing
!Series_type = Genome binding/occupancy profiling by high throughput sequencing
!Series_contributor = Romain,,Guieze
!Series_contributor = Catherine,J,Wu
!Series_contributor = Matthew,,Lawlor
!Series_contributor = Christopher,,Ott
