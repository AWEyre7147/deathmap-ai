^SERIES = GSE148729
!Series_title = Gene expression profiling of SARS-CoV-1/2 infected human cell lines at bulk and single-cell level
!Series_geo_accession = GSE148729
!Series_status = Public on May 04 2020
!Series_submission_date = Apr 15 2020
!Series_last_update_date = Mar 29 2021
!Series_pubmed_id = 33585804
!Series_summary = To identify human genes and cellular pathways influencing SARS-CoV-1 and SARS-CoV-2 infection, we performed genome-wide measurements of different aspects of gene expression at the bulk and single-cell level.
!Series_overall_design = Different human cell lines were infected with SARS-CoV-1 and SARS-CoV-2 and harvested at different time points. Gene expression profiling was measured using bulk and single-cell polyA RNA-sequencing, smallRNA sequencing, and totalRNA sequencing.
!Series_overall_design = 
!Series_overall_design = Raw data are not provided for AEC samples due to patient privacy concerns.
!Series_type = Expression profiling by high throughput sequencing
!Series_type = Non-coding RNA profiling by high throughput sequencing
