^SERIES = GSE89307
!Series_title = Transcriptome analysis of tumor-specific CD8 T cells in murine solid tumors
!Series_geo_accession = GSE89307
!Series_status = Public on May 17 2017
!Series_submission_date = Oct 29 2016
!Series_last_update_date = May 15 2019
!Series_pubmed_id = 28514453
!Series_summary = RNAseq analysis of CD8 T cells becoming dysfunctional in progressing tumors. The overall goal of this study was to elucidate the molecular program that mediates functional unresponsiveness in tumor-specific CD8 T cells. In comparison, we also investigated CD8 T cells differentiating to functional effector and memory T cells during an acute listeria infection.
!Series_overall_design = T cells were sorted by flow cytometry and RNA-seq was performed.
!Series_type = Expression profiling by high throughput sequencing
