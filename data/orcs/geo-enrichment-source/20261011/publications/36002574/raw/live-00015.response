^SERIES = GSE89308
!Series_title = Epigenetic analysis of tumor-specific CD8 T cells in murine and solid tumors
!Series_geo_accession = GSE89308
!Series_status = Public on May 17 2017
!Series_submission_date = Oct 29 2016
!Series_last_update_date = May 15 2019
!Series_pubmed_id = 28514453
!Series_summary = ATACseq analysis of dysfunctional CD8 T cells in progressing tumors. The overall goal of this study was to elucidate chromatin states associated with functional unresponsiveness in tumor-specific CD8 T cells in the context of mouse and human tumors. As comparison we also investigated chromatin state dynamics associated with CD8 T cells differentiation to functional effector and memory T cells during an acute listeria infection.
!Series_overall_design = CD8 T cells were sorted by flow cytometry and ATAC-seq was performed.
!Series_type = Genome binding/occupancy profiling by high throughput sequencing
!Series_type = Other
