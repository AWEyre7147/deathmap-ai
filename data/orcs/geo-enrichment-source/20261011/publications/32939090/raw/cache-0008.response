^SERIES = GSE148297
!Series_title = RNA-sequencing and Exome-sequencing analysis of ferroptosis-resistant 786-O GPX4-null carcinoma cells following in vivo selection
!Series_geo_accession = GSE148297
!Series_status = Public on Sep 16 2020
!Series_submission_date = Apr 08 2020
!Series_last_update_date = Sep 16 2020
!Series_summary = We have used in vivo selection to isolate GPX4 knockout 786-O cells that have evaded ferroptosis in vivo in mouse xenograft experiments. RNA-seq and Exome-seq profiling were performed to characterize the mechanisms underlying ferroptosis evasion in these in vivo-derived ferroptosis resistant cells.
!Series_overall_design = Two tumor cell lines were isolated from GPX4 wildtype 786-O tumors. Four GPX4-null 786-O cell lines were isolated from overt GPX4-knockout tumors growing on two mice. Two replicates of each cell line were performed in the RNA-Seq experiment. One replicate of each cell line was performed in the Exome-seq experiment.
!Series_overall_design = 
!Series_overall_design = WTL: (GPX4) wildtype, left tumor
!Series_overall_design = WTR: (GPX4) wildtype, right tumor
!Series_overall_design = FR2aL: Secondary ferroptosis-resistant line from mouse1 (a), left tumor
!Series_overall_design = FR2aR: Secondary ferroptosis-resistant line from mouse1 (a), right tumor
!Series_overall_design = FR2dL: Secondary ferroptosis-resistant line from mouse2 (or "d"), left tumor
!Series_overall_design = FR2dR: Secondary ferroptosis-resistant line from mouse2 (or "d"), right tumor
!Series_type = Expression profiling by high throughput sequencing
