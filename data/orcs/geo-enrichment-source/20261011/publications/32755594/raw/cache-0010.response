^SERIES = GSE150232
!Series_title = Genome-wide screens reveal that resveratrol induces replicative stress in human cells
!Series_geo_accession = GSE150232
!Series_status = Public on Aug 04 2020
!Series_submission_date = May 11 2020
!Series_last_update_date = Nov 03 2020
!Series_pubmed_id = 32755594
!Series_summary = Using genome-wide CRISPR-Cas9 screens and other cell-based assays, we show that the pro-longevity agent resveratrol and its analogue pterostilbene induce a genetic signature of replicative stress that is similar to hydroxyurea
!Series_overall_design = Genome-wide CRISPR-Cas9 screens were conducted in two cell lines: NALM-6 cells treated with resveratrol (16 µM), pterostilbene (16 µM), or hydroxyurea (100 µM), and Jurkat cells treated with resveratrol (25 µM), compared to their respective DMSO-treated controls.
