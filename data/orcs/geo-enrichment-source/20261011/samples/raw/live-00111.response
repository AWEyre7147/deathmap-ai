^SAMPLE = GSM7165819
!Sample_title = anti-ZNF800, rep1
!Sample_geo_accession = GSM7165819
!Sample_status = Public on Oct 26 2023
!Sample_submission_date = Apr 13 2023
!Sample_last_update_date = Oct 26 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Human small intestinal organoids
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: Human small intestinal organoids
!Sample_characteristics_ch1 = chip antibody: anti-ZNF800 (Atlas)
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Organoids were briefly dissociated with TrypLE (Thermo Fisher), fixed with formaldehyde (final concentration: 1%) and quenched by Glycine (final concentration: 0.125M). Chromatin was extracted by two-step lysis protocol in the presence of protease inhibitors: leupeptin hemisulfate, pepstatin A and phenylmethylsulfonyl fluoride. Chromatin was further sheared by sonication using Bioruptor Pico (Diagenode) with 7 cycles of 30s “ON” and 30s “OFF”.
!Sample_extract_protocol_ch1 = Sequencing libraries for ChIP-seq were constructed by using NEBNext Ultra II DNA Library Prep kit for Illumina (NEB) and NEBNext Multiplex Oligos for Illumina (Dual Index Primers Set 1) (NEB)
!Sample_data_processing = Read mapping to the human genome (hg38) was done with Bowtie2 (2.4.1) using parameters: -q -N 0 -L 22 -X 500 --no-unal.
!Sample_data_processing = Unmapped reads, low mapping quality reads (Q<30) were discarded.
!Sample_data_processing = Peak calling was performed by using MACS2’s callpeak function (2.2.6) with a cutoff of q<0.01
!Sample_data_processing = Assembly: hg38
!Sample_data_processing = Supplementary files format and content: bigWig (except for Input sample)
!Sample_platform_id = GPL30173
