^SAMPLE = GSM38155
!Sample_title = MGUS-005
!Sample_geo_accession = GSM38155
!Sample_status = Public on Feb 08 2005
!Sample_submission_date = Dec 27 2004
!Sample_last_update_date = May 27 2005
!Sample_type = RNA
!Sample_channel_count = 1
!Sample_source_name_ch1 = CD138+ plasma cells obtained from bone marrow of MGUS patient
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_molecule_ch1 = total RNA
!Sample_description = gene expression profiles of purified plasma cells (PCs) obtained from a monoclonal gammopathy of undetermined significance (MGUS). PCs were purified from bone marrow samples, after red blood cell lysis with 0.86% ammonium chloride, using CD138 immunomagnetic microbeads. The purity of the positively selected PCs (92%) was assessed by morphology and flow cytometry. 5 micrograms of total RNA was processed and hybridized to the Affymetrix HG-U133A chip following the manufacturer's instructions. After scanning, the image was processed using Affymetrix MicroArray Suite (MAS) 5.0 software to generate gene expression intensity values. Arrays normalization was performed normalizing the signals to the target intensity of TGT=100.
!Sample_description = Keywords = Gene expression profiling
