!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM3763nnn/GSM3763426/suppl/GSM3763426_SUM159_JQ1_BRD4_R1_ds0.bw
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM3763nnn/GSM3763426/suppl/GSM3763426_SUM159_JQ1_BRD4_R1_ds0_peaks.narrowPeak.gz
