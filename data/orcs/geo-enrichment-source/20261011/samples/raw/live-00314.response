^SAMPLE = GSM5536212
!Sample_title = A1_WT_mCherry_rep1
!Sample_geo_accession = GSM5536212
!Sample_status = Public on Nov 01 2021
!Sample_submission_date = Aug 25 2021
!Sample_last_update_date = Nov 01 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = WT_mCherry
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: BLaER1
!Sample_characteristics_ch1 = genotype: WT
!Sample_treatment_protocol_ch1 = 1.4 million BLaER1 cells per well of a 6-well plate were trans-differentiated into monocytes for 5 days in medium containing 10 ng/ml of hrIL-3, 10 ng/ml hr-CSF-1 (M-CSF) (both PeproTech) and 100 nM β-Estradiol (Sigma-Aldrich) and  stimulated with 1µg/ml doxycycline hyclate (Sigma-Aldrich) for 24h.
!Sample_growth_protocol_ch1 = BLaER1 cells were cultured in RPMI Medium 1640 supplemented with L-glutamine, sodium pyruvate, 100U/ml penicillin-streptomycin (Thermo Fisher) and 10% (v/v) FCS (Omega Scientific).
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = RNA from 2.8 million trans-differentiated BLaER1 monocytes was isolated using TRIzol™ Reagent (Thermo Fisher). DNA was removed with RQ1 RNase-free DNase (Promega) in the presence of RNasin plus Ribonuclease Inhibitor (Promega) and RNA isolated with Agencourt AMPure XP beads (Beckman Coulter).
!Sample_extract_protocol_ch1 = mRNA-seq libraries were prepared from poly-A-enriched mRNA using a KAPA mRNA HyperPrep Kit (Roche) and sequenced on an Illumina Novaseq S4 150PE.
!Sample_description = MG_A1_S1_L004
!Sample_description = Replicate 1 for RNA-seq 5 days of trans-differentiation
!Sample_data_processing = Sequencing quality of fastq files was evaluated with FASTQC
!Sample_data_processing = RNA-seq reads were aligned to the reference genome (GRCh38.83) using Bowtie2
!Sample_data_processing = Transcript and gene counts were quantified using RSEM with the parameter ‘strandedness’ set to ‘reverse’.
!Sample_data_processing = Genome_build: GRCh38.83
!Sample_data_processing = Supplementary_files_format_and_content: abundances_tpm, counts
!Sample_platform_id = GPL24676
