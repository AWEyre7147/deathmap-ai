!Sample_characteristics_ch1 = bm blast %: 85
!Sample_characteristics_ch1 = cytogenetics: t(15;17)
!Sample_characteristics_ch1 = cytogenetic risk: favorable
!Sample_characteristics_ch1 = npm1c: NA
!Sample_characteristics_ch1 = flt3-itd: NA
