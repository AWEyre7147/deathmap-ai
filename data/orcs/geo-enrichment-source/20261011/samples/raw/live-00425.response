!Sample_characteristics_ch1 = fab: M0
!Sample_characteristics_ch1 = wbc: 16.9
!Sample_characteristics_ch1 = bm blast %: 90
!Sample_characteristics_ch1 = cytogenetics: 46,XX
!Sample_characteristics_ch1 = cytogenetic risk: intermediate
!Sample_characteristics_ch1 = npm1c: NA
!Sample_characteristics_ch1 = flt3-itd: NA
