^SAMPLE = GSM5049105
!Sample_title = CUTLL1_DMSO_rep1
!Sample_geo_accession = GSM5049105
!Sample_status = Public on Oct 25 2021
!Sample_submission_date = Jan 28 2021
!Sample_last_update_date = Oct 25 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = human T-ALL cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = treatment: DMSO
!Sample_characteristics_ch1 = cell line: CUTLL1
!Sample_treatment_protocol_ch1 = CUTLL1 cells were treated with either DMSO or gamma-secretase inhibitor (Compound E, Alexis Bioscience, ALX-270-415-C250) for 72 hours.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Small RNA was extracted using the MicroRNA purification kit from Norgen (Catalog no: 21300) folllowing manufacturer's guidelines.
!Sample_extract_protocol_ch1 = Library construction was performed using universal primers compatible with Illumina platform. Primers are unqiely matching annotated human tRNA genes.
!Sample_extract_protocol_ch1 = custom tRNA-specific sequencing
!Sample_description = tRNAseq_CUTLL1_CPM.tsv
!Sample_data_processing = Adapter trimming: Adapters were trimmed off on both sides of the sgRNA in the read sequence using cutadapt. This left a 20bp potential sgRNA sequence.
!Sample_data_processing = Counting: Trimmed reads were matched exactly to the library's sgRNA sequences and counted.
!Sample_data_processing = Normalization: Raw counts were processed in edgeR, using the functions “calcNormFactors” and “estimateTagwiseDisp” functions for intra- and inter-sample normalization, reporting CPM values per tRNA and sample. Additional length normalization, such as FPKM, is not applicable because all sequencing read fragments reflecting tRNAs are of the same length.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: tsv-table of CPM values
