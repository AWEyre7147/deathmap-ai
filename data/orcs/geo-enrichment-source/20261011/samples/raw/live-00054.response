^SAMPLE = GSM2279942
!Sample_title = Sorted-GFPpos-ATAC-rep1
!Sample_geo_accession = GSM2279942
!Sample_status = Public on Mar 31 2017
!Sample_submission_date = Aug 15 2016
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = mouse embryonic stem cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: mouse embryonic stem cells (in 2i media)
!Sample_characteristics_ch1 = transgene: mDuxCA
!Sample_characteristics_ch1 = 3xha-tag: 3xHA-tag
!Sample_characteristics_ch1 = condition: 24hr dox-induction; FACS-sorted
!Sample_treatment_protocol_ch1 = Cells were kept under constant drug selection (Puromycin, G418) and induced with doxycycline for 24 hrs prior to FACS.
!Sample_growth_protocol_ch1 = mESCs containing two stably integrated transgenes (TRE::3xHA-mDux; MERVL::EGFP) were cultured on gelatin in ES-DMEM supplemented with serum, leukemia Inhibitory Factor, and 2i (CHIR99021, PD0325901).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Immediately following FACS, the cells were lysed in cold lysis buffer (10 mM Tris-HCl, pH 7.4, 10 mM NaCl, 3 mM MgCl2 and 0.1% IGEPAL CA-630) and the nuclei were pelleted.
!Sample_extract_protocol_ch1 = The Tn5 transposition reaction was carried out for 30 minutes at 37°C. Following DNA purification, the Nextera libraries were amplified for 12 cycles using the NEBnext PCR master mix and purified using the Qiagen PCR cleanup kit.
!Sample_description = 30k cells
!Sample_description = mDUX-GFPpos_ATAC.bw
!Sample_data_processing = Library strategy: ATAC-Seq
!Sample_data_processing = Raw read squences were trimmed to remove low quality bases and adapter sequences (Trim Galore!) before aligning to mm10 using Bowtie2 (v2.2.6) with the following parameters: (-t –q –N1 –L 25 –X 2000 –no-mixed –no-discordant) (*non-unique reads assigned to 1 location).
!Sample_data_processing = Replicates were merged and a single, read-normalized bedgraph file was generated with MACS2 callpeak (-B -SPMR --nomodel --nolambda --shift -100 --extsize 200).
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: The read normalize bedGraph file was then converted into bigwig format for genome browser visulization.
!Sample_platform_id = GPL17021
!Sample_contact_name = Peter,G,Hendrickson
!Sample_contact_email = peter.hendrickson@hci.utah.edu
!Sample_contact_laboratory = Bradley R. Cairns
!Sample_contact_department = HHMI/Oncological Sciences
!Sample_contact_institute = University of Utah
!Sample_contact_address = 2000 Circle of Hope Dr.
!Sample_contact_city = Salt Lake City
!Sample_contact_state = UT
!Sample_contact_zip/postal_code = 84112
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN05578243
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX2023778
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE85624
!Sample_series_id = GSE85632
