^SAMPLE = GSM5706915
!Sample_title = Control 1 [C1]
!Sample_geo_accession = GSM5706915
!Sample_status = Public on Aug 22 2022
!Sample_submission_date = Nov 29 2021
!Sample_last_update_date = Aug 24 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = pancreatic ductal adenocarcinoma cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: MIA PaCa-2
!Sample_characteristics_ch1 = cell type: pancreatic ductal adenocarcinoma cells
!Sample_characteristics_ch1 = treatment: Untreated
!Sample_characteristics_ch1 = treatment time: None
!Sample_treatment_protocol_ch1 = Control cells were the MIA PaCa-2 cultured under normal conditions. Torin1-treated cells were MIA PaCa-2 treated with Torin 1 (100nM) for 9 days. Persister cells were collected following combined treatment with gemcitabine (100nM) plus Torin 1 (100nM) for 9 days. The recovery cells were the persister cells further cultured in drug-free normal media for 12 days.
!Sample_growth_protocol_ch1 = MIA PaCa-2 cells were cultured in DMEM media supplemented with 10% fetal bovine serum and 1% penicillin/streptomycin in a 5% CO2 humidified incubator.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA samples were extracted using Qiagen RNeasy Plus kit (QIAGEN)
!Sample_extract_protocol_ch1 = Library construction and RNA sequencing were performed by Novogene as a service. Briefly, ribosomal RNA was removed from total RNA by rRNA removal kit, and rRNA free residue was cleaned up by ethanol precipitation. After fragmentation, the first strand cDNA was synthesized using random hexamer primers. Then the second strand cDNA was synthesized and dUTPs were replaced with dTTPs in the reaction buffer. The directional library was ready after end repair, A-tailing, adapter ligation, size selection, USER enzyme digestion, amplification, and purification.
!Sample_data_processing = kallisto (version 0.46.2) was used to pseudoalign paired-end reads to a reference transcriptome under default settings.
!Sample_data_processing = Genome_build: The reference transcriptome used to build the kallisto index consisted of the "Protein-coding transcript sequences" and "Long non-coding RNA transcript sequences" FASTA files from Human Release 38 (GRCh38.p13) of GENCODE.
!Sample_data_processing = Supplementary_files_format_and_content: Tab-delimited text files containing trascript IDs and transcript-level estimated counts and TPMs.
!Sample_platform_id = GPL24676
!Sample_contact_name = Yulin,,Li
!Sample_contact_email = yli@houstonmethodist.org
!Sample_contact_institute = Houston Methodist Research Institute
!Sample_contact_address = 6670 Bertner Avenue
!Sample_contact_city = Houston
!Sample_contact_state = Texas
!Sample_contact_zip/postal_code = 77030
!Sample_contact_country = USA
