^SAMPLE = GSM1706452
!Sample_title = first round replicate 1
!Sample_geo_accession = GSM1706452
!Sample_status = Public on Jul 05 2015
!Sample_submission_date = Jun 08 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = 293FT cell
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: HEK 293FT
!Sample_treatment_protocol_ch1 = 293FT cells were infected with lentivirus expressing a certain sgRNA at MOI 0.05. After 72h culture, the cells were then sorted on a FACSAria II cell sorter, and it was confirmed that >90% of the sorted cells were GFP-positive. Approximately 5x106 cells were recovered, which was expanded to 2x107 cells.   Cells (2x107) harboring the sgRNA library were transfected with the pX261–dU6 plasmid using Lipofectamine 2000 (Life Technologies), according to the manufacturer’s instructions. The transfected cells were infected with the WNV-B956 strain at MOI=2 and incubated for 12 days.
!Sample_growth_protocol_ch1 = 293 FT cell was cultured in DMEM with 10% FBS and 1X PS.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted from the surviving cells using DNeasy Blood and Tissue Kit (QIAGEN)
!Sample_extract_protocol_ch1 = The library construction follows Illumina’s TruSeq method. Briefly, sgRNA sequences were amplified by nested PCR with the first pair of primers, GATAGGCTTGGATTTCTATAAG (forward) and CTGCTGGAATCTCGTGAAG (reverse), followed by amplification with the second pair of primers, AATGATACGGCGACCACCGAGATCTACACTCTTTCCCTACACGACGCTCTTCCGATCTNNNNNCTTGGAGAAAAGCCTTGTT (forward) and CAAGCAGAAGACGGCATACGAGATXXXXXXGTGACTGGAGTTCAGACGTGTGCTCTTCCGATCGCTATTTCTAGCTCTAAAAC (reverse, where XXXXXX indicates index sequences). The indexes for first round screen are: replicate1: CAGATC; replicate2: TGCTCA; replicate3: CAGTAG. For the second round screen, the indexes are: replicate1: GCTGAT; replicate2: CTGAGT; replicate3: TCGACT.
!Sample_data_processing = Fastq quality filter by fastq_illumina_filter
!Sample_data_processing = Trimed the sequences missing 3' adaptor
!Sample_data_processing = Trimed the sequences missing 5' adaptor
!Sample_data_processing = Trimed the sequences that is shorter than 15bp
!Sample_data_processing = Trimed the sequences contains "N"
!Sample_data_processing = Merged reads
!Sample_data_processing = Removed the reads with <5 copies
!Sample_data_processing = Reads align to gRNA
!Sample_data_processing = Supplementary_files_format_and_content: table containing the raw read counts and sequences for each sample
!Sample_platform_id = GPL15520
!Sample_contact_name = Haoquan,,wu
!Sample_contact_email = haoquan.wu@ttuhsc.edu
!Sample_contact_phone = 915-2154243
!Sample_contact_laboratory = COE-ID
!Sample_contact_department = Biomedical Scienes
!Sample_contact_institute = Texas Tech Health Sciences Center El Paso
!Sample_contact_address = 5001 El Paso Dr
!Sample_contact_city = El Paso
!Sample_contact_state = Texas
!Sample_contact_zip/postal_code = 79905
!Sample_contact_country = USA
!Sample_instrument_model = Illumina MiSeq
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN03765184
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX1053710
