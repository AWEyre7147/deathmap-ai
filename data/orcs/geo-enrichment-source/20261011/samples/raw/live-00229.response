^SAMPLE = GSM410555
!Sample_title = Hypoxia-HIF1-1
!Sample_geo_accession = GSM410555
!Sample_status = Public on Jun 02 2009
!Sample_submission_date = May 29 2009
!Sample_last_update_date = Jun 01 2009
!Sample_type = genomic
!Sample_channel_count = 2
!Sample_source_name_ch1 = IP: HepG2 cells under hypoxic condition (0.5%O2, 4 hours)
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: HepG2
!Sample_characteristics_ch1 = cell type: hepatocellular carcinoma
!Sample_characteristics_ch1 = cell tissue: liver
!Sample_characteristics_ch1 = antibody: HIF-1 polyclonal
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = HepG2 cells were cultured under normoxic (ambient) or hypoxic (0.5% O2, 4 h) conditions. Cells were cross-linked with 1% formaldehyde for 10 minutes at 37ºC, washed with cold PBS, and lysed with 0.5% SDS Buffer. Chromatins were then sonicated in 0.5% SDS Buffer using 3 x 10 second pulses on setting 5 with a Fisher Scientific Sonic Dismembrator (model 100) into 500bp~1kb fragments. Lysates were then diluted with dilution buffer into final SDS concentration being 0.1%. Three ChIP biological replicates were performed for both normoxic and hypoxic samples with HIF-1a pAb (Novus, NB 100-134). A small aliquot for each biological sample are reserved for an input control. Both Chiped DNA and Input samples were amplified by LM-PCR.
!Sample_label_ch1 = biotin
!Sample_label_protocol_ch1 = Amplified ChIP and Input samples were fragmented with DNase to 50~100bp size and labeled using the Terminal transferase (TdT, Promega) to add biotinylated-ddATP to the ends of the fragments.
!Sample_source_name_ch2 = Input: HepG2 cells under hypoxic condition (0.5%O2, 4 hours)
!Sample_organism_ch2 = Homo sapiens
!Sample_taxid_ch2 = 9606
!Sample_characteristics_ch2 = cell line: HepG2
!Sample_characteristics_ch2 = cell type: hepatocellular carcinoma
!Sample_characteristics_ch2 = cell tissue: liver
!Sample_characteristics_ch2 = antibody: none
!Sample_molecule_ch2 = genomic DNA
!Sample_extract_protocol_ch2 = HepG2 cells were cultured under normoxic (ambient) or hypoxic (0.5% O2, 4 h) conditions. Cells were cross-linked with 1% formaldehyde for 10 minutes at 37ºC, washed with cold PBS, and lysed with 0.5% SDS Buffer. Chromatins were then sonicated in 0.5% SDS Buffer using 3 x 10 second pulses on setting 5 with a Fisher Scientific Sonic Dismembrator (model 100) into 500bp~1kb fragments. Lysates were then diluted with dilution buffer into final SDS concentration being 0.1%. Three ChIP biological replicates were performed for both normoxic and hypoxic samples with HIF-1a pAb (Novus, NB 100-134). A small aliquot for each biological sample are reserved for an input control. Both Chiped DNA and Input samples were amplified by LM-PCR.
!Sample_label_ch2 = biotin
!Sample_label_protocol_ch2 = Amplified ChIP and Input samples were fragmented with DNase to 50~100bp size and labeled using the Terminal transferase (TdT, Promega) to add biotinylated-ddATP to the ends of the fragments.
!Sample_hyb_protocol = Approximately 2ug of DNA was hybridzed per array.
!Sample_scan_protocol = Both hybridization and scan were performed by Microarray Core at Dana-Farber Cancer Institute.
!Sample_description = HIF-1 ChIP Hypoxia Biological Rep 1-3, Affymetrix Human Tiling 2.0R Set, Array 1
!Sample_data_processing = The model-based analysis of tiling-array (MAT) algorithm was used to identify regions enriched by ChIP-chip (‘‘hits’’) on Affymetrix whole-genome or promoter tiling arrays. MAT was used to identify probe intensity peaks comparing triplicate hypoxic ChIP vs. hypoxic input (‘‘Hypoxic’’) and normoxic ChIP vs. normoxic input (‘‘Normoxic’’). MAT was run with the same parameters for each: bandwidth = 200, maximum gap = 400, minimum probes  = 10, and P value cutoff  = 1e - 5. Hits appearing solely in the hypoxic samples were retained as hypoxia-unique. In cases where hypoxic and normoxic hits overlapped, hits for which the MAT score of hypoxic subtracted by that of normoxic samples were above the cutoff were also retained. The MAT library and mapping files were based on the March 2006 Human Genome Assembly (HG18). Hits flagged by MAT as mapping to repeat  regions were excluded from consideration.
!Sample_platform_id = GPL4910
!Sample_contact_name = Xiaobo,,Xia
!Sample_contact_email = Xiaobo_Xia@dfci.harvard.edu
!Sample_contact_laboratory = Dr. Andrew Kung
!Sample_contact_department = Pediatric Oncology
!Sample_contact_institute = Dana-Farber Cancer Institute
!Sample_contact_address = 44 Binney St, Mayer 649
!Sample_contact_city = Boston
!Sample_contact_state = MA
!Sample_contact_zip/postal_code = 02115
!Sample_contact_country = USA
!Sample_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM410nnn/GSM410555/suppl/GSM410555_Hypo_HIF1C3A.CEL.gz
!Sample_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM410nnn/GSM410555/suppl/GSM410555_Hypo_HIF1C5A.CEL.gz
