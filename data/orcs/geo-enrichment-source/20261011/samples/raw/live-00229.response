^SAMPLE = GSM410560
!Sample_title = Hypoxia-HIF1-6
!Sample_geo_accession = GSM410560
!Sample_status = Public on Jun 02 2009
!Sample_submission_date = May 29 2009
!Sample_last_update_date = Jun 01 2009
!Sample_type = genomic
!Sample_channel_count = 2
!Sample_source_name_ch1 = IP: HepG2 cells under hypoxic condition (0.5%O2, 4 hours)
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: HepG2
!Sample_characteristics_ch1 = cell type: hepatocellular carcinoma
!Sample_characteristics_ch1 = cell tissue: liver
!Sample_characteristics_ch1 = antibody: HIF-1 polyclonal
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = HepG2 cells were cultured under normoxic (ambient) or hypoxic (0.5% O2, 4 h) conditions. Cells were cross-linked with 1% formaldehyde for 10 minutes at 37ºC, washed with cold PBS, and lysed with 0.5% SDS Buffer. Chromatins were then sonicated in 0.5% SDS Buffer using 3 x 10 second pulses on setting 5 with a Fisher Scientific Sonic Dismembrator (model 100) into 500bp~1kb fragments. Lysates were then diluted with dilution buffer into final SDS concentration being 0.1%. Three ChIP biological replicates were performed for both normoxic and hypoxic samples with HIF-1a pAb (Novus, NB 100-134). A small aliquot for each biological sample are reserved for an input control. Both Chiped DNA and Input samples were amplified by LM-PCR.
!Sample_label_ch1 = biotin
!Sample_label_protocol_ch1 = Amplified ChIP and Input samples were fragmented with DNase to 50~100bp size and labeled using the Terminal transferase (TdT, Promega) to add biotinylated-ddATP to the ends of the fragments.
