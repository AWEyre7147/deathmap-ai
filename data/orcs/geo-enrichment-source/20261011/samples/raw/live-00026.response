^SAMPLE = GSM3436751
!Sample_title = Drop-seq 0H collected cells
!Sample_geo_accession = GSM3436751
!Sample_status = Public on Apr 12 2019
!Sample_submission_date = Oct 18 2018
!Sample_last_update_date = Apr 14 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = 0H collected cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: 129/Ola
!Sample_characteristics_ch1 = cell line: ES-E14TG2a
!Sample_characteristics_ch1 = cell type: embryonic stem cell
!Sample_characteristics_ch1 = dux induction: No
!Sample_characteristics_ch1 = time: 0H
!Sample_treatment_protocol_ch1 = Doxycycline is added to induce Dux transgene. CRISPR knockdown is performed as described in "Shalem O*, Sanjana NE*, Hartenian E, Shi X, Scott DA, Mikkelsen T, Heckl D, Ebert BL, Root DE,Doench JG, Zhang F (2014). Science, 343, 83-7. DOI: 10.1126/science.1247005".
!Sample_growth_protocol_ch1 = ES-E14TG2a cells were cultured with medium consisted of DMEM (Gibco, Cat. # 11995) with 15% FBS (Sigma, Cat. #F6178), 1000 U/ml mouse leukemia inhibitory factor (Millipore, Cat. #ESG1107), 0.1 mM non-essential amino acids (Gibco, Cat. # 11140), 0.1mM β-mercaptoethanol (Gibco, Cat. # 21986023), 1 mM Glutamine-max (Gibco, Cat. # 25030), 1 mM sodium pyruvate (Gibco, Cat. # 11360)) and penicillin/streptomycin (100 U/ml) (Gibco, Cat, #15140).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Cellular RNA and DNA was harvested using Qiagen Allprep RNA/DNA mini kit (Qiagen, Cat 80204).
!Sample_extract_protocol_ch1 = The bulk RNA-seq library was prepared using NEBNext® Ultra™ Directional RNA Library Prep Kit for Illumina (NEB, Cat E7420S). Drop-seq was performed as described in "Chen, R., Wu, X., Jiang, L. & Zhang, Y. Single-Cell RNA-Seq Reveals Hypothalamic Cell Diversity. Cell Rep 18, 3227-3241 (2017)." RRBS: DNA (1 ng) with 0.5% nonmethylated λ DNA spike-in was digested by MspI for 3.5 hours. DNA was then end-repaired, dA-tailed, and ligated with methylated adaptors. Bisulfite conversion was carried out using an EpiTect fast bisulfite conversion kit (Qiagen) according to the manufacturer’s instructions. Bisulfite-converted DNA was then amplified with five PCR cycles to obtain the final library.
!Sample_description = Drop-seq_0H
!Sample_data_processing = Read1 = Technical (Barcode position (bp): 1 - 12, UMI position (bp): 13-20)
!Sample_data_processing = Read2 = Biological
!Sample_data_processing = Quantification: For gene expression quantification in Drop-seq, the raw Drop-seq data were processed using dropseq tools. Reads were mapped against the mm10 genome (GRCm38) and the Ensemble GRCm38.85 transcriptome was used for gene annotation. Initially, the gene expression of the top 2,000 abundant cell barcodes was generated (DigitalExpression command of dropseq tools with the option NUM_CORE_BARCODES=2000). To estimate the repeats expression, the bam tag “XF” added by the dropseq tools’ TagReadWithGeneExon was used to extract non-mapped reads and reads mapping to intronic and intergenic. The extracted reads were mapped to the repeats pseudo-genome using dropseq tools. The expression matrix of the top 2,000 enriched cell barcodes were generated. For each time point, the expression matrix of the cell barcode detected in both the reads and genes were generated.
!Sample_data_processing = Analysis: Seurat R package (v2.3.0) was then used to load and pool all the dataset together. We filtered out cells with <800 detected transcripts and cells in which the mitochondrial transcriptome occupies >10% of the total transcripts. Genes expressed in less than 3 cells were excluded.
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: counts.csv (reporting raw counts) and meta.csv
!Sample_platform_id = GPL17021
!Sample_contact_name = Mohamed Nadhir,,Djekidel
!Sample_contact_email = djek.nad@gmail.com
!Sample_contact_laboratory = Maternal and Child Health Division
!Sample_contact_department = Translational Medicine Department
!Sample_contact_institute = Sidra Medicine
!Sample_contact_address = Gharafa
!Sample_contact_city = Doha
!Sample_contact_state = Doha
!Sample_contact_zip/postal_code = 26999
!Sample_contact_country = Qatar
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN10255954
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX4902289
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM3436nnn/GSM3436751/suppl/GSM3436751_0H_counts.csv.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM3436nnn/GSM3436751/suppl/GSM3436751_0H_meta.csv.gz
!Sample_series_id = GSE121457
!Sample_series_id = GSE121459
!Sample_data_row_count = 0
