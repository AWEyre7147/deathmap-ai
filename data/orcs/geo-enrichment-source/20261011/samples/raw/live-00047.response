^SAMPLE = GSM6914871
!Sample_title = initial_rep1
!Sample_geo_accession = GSM6914871
!Sample_status = Public on Jan 20 2023
!Sample_submission_date = Jan 03 2023
!Sample_last_update_date = Jan 20 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = 293T
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: 293T
!Sample_characteristics_ch1 = cell type: Kidney
!Sample_characteristics_ch1 = genotype: wild type
!Sample_characteristics_ch1 = treatment: cells stably expressing the ERGFP_K20 reporter were infected with GeckoV2 libraries (A, B)
!Sample_characteristics_ch1 = sorting: GFP low
!Sample_treatment_protocol_ch1 = Cells were infected with the GeckoV2 libraries (A, B) in duplicates.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted from each cell population using a QIAGEN Blood Maxi kit (for GFP low cells) or QIAGEN Blood Midi kit (for GFP high cells).
!Sample_extract_protocol_ch1 = sgRNAs sequences were amplified from genomic DNA samples using the Herculase II Fusion DNA Polymerase (Agilent Technologies) in two PCR steps as follows. In the first PCR, the genomic region containing sgRNAs were amplified from 130 µg total DNA using the following primers: Forward: 5’-AATGGACTATCATATGCTTACCGTAACTTGAAAGTATTTCG-3’; Reverse: 5’-CTTTAGTTTGTATGTCTGTTGCTATTATGTCTACTATTCTTTCC-3’. In total, 13 PCR reactions were performed in parallel, with 10 µg genomic DNA in each reaction using Herculase II Fusion DNA Polymerase (Agilent) for 18 cycles and the resulting PCR products were combined. In the second step PCR, 5 µl of first PCR product was used in a 100 µl reaction volume and 24 PCR cycles was used. The primers used for the second PCR include stagger sequences of variable lengths and a 6bp barcode for multiplexing of different biological samples. The 2nd step PCR primers were used as the following: Forward: 5’-AATGATACGGCGACCACCGAGATCTACACTCTTTCCCTACACGACGCTCTTCCGATCT (1-9bp variable length sequence)-(6bp barcode)tcttgtggaaaggacgaaacaccg-3’; Reverse: 5’-CAAGCAGAAGACGGCATACGAGATGTGACTGGAGTTCAGACGTGTGCTCTTCCGATCT tctactattctttcccctgcactgt-3’.
!Sample_extract_protocol_ch1 = sgRNAs amplified from genomic DNA
!Sample_description = Lihui_Counts_2020_03_05
!Sample_description = ER_K20_GFP high.gene_summary
!Sample_data_processing = sgRNA sequences were obtained per sample by extracting 20 bps followed by the index sequence of “TTGTGGAAAGGACGAAACACCG” on the de-multiplexed FASTQ files from Illumina’s NGS sequencer using the Cutadapt software, version 2.8
!Sample_data_processing = FASTQC, version 0.11.9 was used to assess the sequencing quality.
!Sample_data_processing = MAGeCK, version 0.5.9, was used to quantify and to identify differentially expressed sgRNAs.
!Sample_data_processing = MAGeCK count command was run on the merged two-half libraries of A and B to quantify.
!Sample_data_processing = Differentially expressed sgRNAs with statistical significance were determined by running the MAGeCK test command in paired mode.
!Sample_data_processing = Assembly: library_A_B
!Sample_data_processing = Supplementary files format and content: Lihui_Counts_2020_03_05.xlsx: MS Excel file and it contains raw and normalized counts
!Sample_data_processing = Supplementary files format and content: ER_K20_GFP high.gene_summary.xlsx: MS Excel file and it contains deregulated genes with fold change, p-values and adjusted p-values
!Sample_platform_id = GPL24676
!Sample_contact_name = Yihong,,Ye
!Sample_contact_email = yihongy@niddk.nih.gov
!Sample_contact_phone = 12023138129
!Sample_contact_institute = NIH
!Sample_contact_address = 5 Center Drive
!Sample_contact_city = Bethesda
!Sample_contact_state = MD
!Sample_contact_zip/postal_code = 20892
!Sample_contact_country = China
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN32547034
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX18920254
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE222104
!Sample_data_row_count = 0
