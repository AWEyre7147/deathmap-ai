!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX393151
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM1290nnn/GSM1290667/suppl/GSM1290667_bAPE17_rpm.bedGraph.gz
