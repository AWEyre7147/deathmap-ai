^SAMPLE = GSM3760096
!Sample_title = SUM149_DMSO_P25_1_S1_R1_001
!Sample_geo_accession = GSM3760096
!Sample_status = Public on Mar 30 2020
!Sample_submission_date = May 10 2019
!Sample_last_update_date = Jan 30 2026
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = breast cancer cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: SUM149
!Sample_characteristics_ch1 = agent: DMSO
!Sample_characteristics_ch1 = passage: 25
!Sample_characteristics_ch1 = replicate: 1
!Sample_treatment_protocol_ch1 = Barcoded cells were treated with JQ1. The control groups were treated with 0.1% DMSO. Each group was cultured in quadruplicate.
!Sample_growth_protocol_ch1 = Cells were barcoded by lentiviral infection using high-complexity barcode library, ClonTracer. After a 24 h incubation with virus, infected cells were selected with 2 μg ml−1 puromycin. To ensure that the majority of cells were labeled with a single barcode per cell, for lentival infection we used a target m.o.i. of approximately 0.2, corresponding to 20% infectivity after puromycin selection. Infected cell populations were expanded in culture for the minimal time period to obtain a sufficient number of cells to set up replicate experiments. Cells were cultured in SUM medium for increasing dose of JQ1 and their corresponding control.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted from the frozen cell populations with a QIAamp DNA Midi Kit (Qiagen).
!Sample_extract_protocol_ch1 = We used PCR to amplify the barcode sequence for NGS by introducing Illumina adaptors and 5-bp-long index sequences.
!Sample_data_processing = Library strategy: Barcode-seq
!Sample_data_processing = We followed the method used in Bhang et al. 2015 with small modifications. In details, all sequencing reads are trimmed by using 3 prime adaptor sequence: AGCAGAGCTACGCACTCTATGCTAGTGCTAGAGATCGGAAGAGCACACGTCTGAACTCCAGTCACTCACGATCGTATCTCGTATGCCGTCTTCTGCTTG with minimum alignment length of 40-nt. The trimmed reads with Ns or less than 30-nt or without the WS x 15 pattern are removed. Then the 30-nt barcode sequences are extracted from the 3 prime end of the trimmed sequences. Barcodes with an estimated Phred quality score of at least 10 for all nucleotides and with an average Phred quality score greater than 30 are kept as qualified barcodes. The barcodes with only one count are excluded from the analyses to avoid the noise derived from the sequencing error.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: tsv files contain the abundant of each barcode
!Sample_platform_id = GPL11154
!Sample_contact_name = Kornelia,,Polyak
!Sample_contact_email = Kornelia_Polyak@dfci.harvard.edu
!Sample_contact_institute = Dana-Farber Cancer Institute
!Sample_contact_address = 450 Brookline Ave. S1070
!Sample_contact_city = Boston
!Sample_contact_zip/postal_code = 02215
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2000
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
