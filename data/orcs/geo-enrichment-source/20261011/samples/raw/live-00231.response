!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN27280103
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX14719812
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6008nnn/GSM6008396/suppl/GSM6008396_PREP0118_ESint11979_F8v1_G957_barcodes.tsv.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6008nnn/GSM6008396/suppl/GSM6008396_PREP0118_ESint11979_F8v1_G957_features.tsv.gz
!Sample_supplementary_file_3 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6008nnn/GSM6008396/suppl/GSM6008396_PREP0118_ESint11979_F8v1_G957_matrix.mtx.gz
