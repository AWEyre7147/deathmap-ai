!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6008nnn/GSM6008391/suppl/GSM6008391_PREP0061_ESint11168A_B4v1_84_features.tsv.gz
