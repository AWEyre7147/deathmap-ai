^SAMPLE = GSM1544798
!Sample_title = SpeciesMix_ThousandSTAMPs_50cellspermicroliter
!Sample_geo_accession = GSM1544798
!Sample_status = Public on May 20 2015
!Sample_submission_date = Nov 13 2014
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = HEK and 3T3 mix
!Sample_organism_ch1 = Homo sapiens
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 9606
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: HEK and 3T3 mix at final droplet concentration of 50 cells per microliter.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Single cell suspensions were processed through Drop-Seq to generate single-cell cDNA libraries attached to microbeads
!Sample_extract_protocol_ch1 = Microbeads were counted, and amplified (estimated 1000 cells for sample 1, or 100 cells for sample 2) by PCR, and the 3' end of the cDNA prepared for sequencing using a modified Nextera XT protocol.
!Sample_description = This experiment was sequenced at a mean depth of 69,004 reads per cell. We estimated 1000 STAMPs by counting the beads; the actual number we uncovered in analysis is 1020
!Sample_data_processing = Base calls performed with bcl2fastq2.15
!Sample_data_processing = Read 2 was aligned with Star v2.4.0
!Sample_data_processing = Each aligned read was tagged with its mate-pair UMI and cell barcode, and barcodes collapsed by ED=1 using custom software available at the Drop-Seq portal.
!Sample_data_processing = Each aligned exonic read was tagged with a gene name
!Sample_data_processing = A digital expression matrix was built by counting the number of unique UMIs per gene within each cell; columns are cells, and rows are genes.  Gene expression from each organism is listed in a separate file.
!Sample_data_processing = Genome_build: mm10 and hg19 (dual reference)
!Sample_platform_id = GPL19415
!Sample_contact_name = Evan,,Macosko
