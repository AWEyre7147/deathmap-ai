^SAMPLE = GSM6945639
!Sample_title = Jurkat LAI HIVDEP gDNA Rep1
!Sample_geo_accession = GSM6945639
!Sample_status = Public on Jan 26 2023
!Sample_submission_date = Jan 20 2023
!Sample_last_update_date = Jan 26 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Jurkat-CCR5-ZapKO
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: Jurkat-CCR5-ZapKO
!Sample_characteristics_ch1 = cell type: Human T lymphocyte
!Sample_characteristics_ch1 = treatment: Pooled KO cells containing HIVDEP library infected with LAI and gDNA extracted 3dpi (Replicate 1)
!Sample_characteristics_ch1 = group: Jurkat LAI HIVDEP
!Sample_treatment_protocol_ch1 = 3 x 10^6 (>500X coverage) Jurkat-CCR5 ZAP KO cells were each transduced with the TKOv3, HuEpi, PIKA, or HIVDEP libraries (MOI<1) and selected in  0.4 ug/mL puromycin for 10-14 days. Knockout cell pools were infected with viral strains LAI, VSV-G psuedotyped LAI, LAIΔVpr, Q23.BG505, or CH470 TF . Each condition is performed with two replicates. After the treatment, cells and viral supernatants were harvested.
!Sample_growth_protocol_ch1 = Jurkat-CCR5 ZAP KO cells are grown in RPMI-1640 supplemented with 10% FBS, 10nM HEPES, and Pen/Strep. Cells are passaged between 2 x 10^5 cells/mL and 2 x 10^6 cells/mL.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted using a QIAamp DNA Blood Midi kit (Qiagen, Cat No 51183)
!Sample_extract_protocol_ch1 = Described in samples section on a per sample basis.
!Sample_extract_protocol_ch1 = Genomic DNA (gDNA) or reverse-transcribed viral RNA (vRNA) were amplified by a two-step PCR (PCR1: 12 cycles, PCR2: 20 cycles) to amplify 20bp sgRNA sequences in the HIV-CRISPR vector. All vRNA was amplified for each sample where appropriate. For gDNA samples, a total of 500-fold coverage of the sgRNAs were amplified (10^6 cells were estimated to contain 6.6μg gDNA) with a maximum of 2μg gDNA per PCR reaction. For each sample, PCR1 reactions were pooled, cleaned up over a QIAquick PCR purification Kit (2 columns per sample), pooled again and used as template for PCR2. For vRNA, all PCR1 was amplified in the second round. For gDNA, 10 uL of pooled PCR1 was used as input for PCR2 (PCR2 primers include Illumina barcodes and adaptor sequences). Amplicons from PCR2 were pooled, purified by double-sided bead cleanup (AMPureXP, Beckman Coulter), quantified with a Qubit dsDNA HS assay and pooled for sequencing.
!Sample_description = HIVDEP library developed by Emerman lab. It contains 527 genes of interest and 210 non-targeting controls.
!Sample_description = Jurkat_HIVDEP_201231.anno.txt
!Sample_data_processing = For the HiSeq2500 datasets, image analysis and base calling were performed using Illumina's Real Time Analysis v1.18 software followed by generation of  fastq files using Illumina's bcl2fastq Conversion Software v1.8.4. For the NextSeq2000 datasets Real Time Analysis v3.7.17 was used, followed by bcl2fastq v2.20.
!Sample_data_processing = Samples were demultiplexed using FASTX toolkit. Specifically, FASTX barcode splitter was used to separate reads by barcode matching.
!Sample_data_processing = HiSeq dataset reads were trimmed and aligned to the respective guide libraries using Bowtie v1.0.0, followed by tabulation of read counts using R. Guide-level quantification for the NextSeq data was performed using Liu lab's MAGeCK software.
!Sample_data_processing = Liu lab's CRISPR analysis tool, Model-based Analysis of Genome-wide CRISPR/Cas9 Knockout (MAGeCK), was used to perform differential guide analysis between various groups of interest. PMID: 25476604.
!Sample_data_processing = Assembly: Described in samples section on a per sample basis. [description field]
!Sample_data_processing = Supplementary files format and content: Tab delimited files with read counts for each guide sequence
!Sample_data_processing = Library strategy: CRISPR
!Sample_platform_id = GPL16791
!Sample_contact_name = Vanessa,,Montoya
!Sample_contact_email = vmontoya@fredhutch.org
!Sample_contact_laboratory = Emerman
!Sample_contact_institute = Fred Hutchinson Cancer Center
!Sample_contact_address = 1100 Fairview Ave
!Sample_contact_city = SEATTLE
!Sample_contact_state = Washington
!Sample_contact_zip/postal_code = 98109
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN32810550
