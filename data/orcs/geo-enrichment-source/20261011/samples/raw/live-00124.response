^SAMPLE = GSM3738266
!Sample_title = Y.Kosuke Plasmid Library  [YUSAplasmid]
!Sample_geo_accession = GSM3738266
!Sample_status = Public on Apr 30 2019
!Sample_submission_date = Apr 29 2019
!Sample_last_update_date = Jan 08 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Library plasmid sequencing
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = sample type: Library plasmid sequencing
!Sample_treatment_protocol_ch1 = Puromycin was applied at 2mg/ml concentration for 5 days. Venetoclax (1microMolar) or DMSO were applied to 30 million cells in single flask
!Sample_growth_protocol_ch1 = MOLM13 cells were grown in RPMI-1640, supplemented with 20% serum, pen/strep, fungizone.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = 10e6 cells were collected for DMSO day 0, 30 miln cells were collected for Venetoclax/DMSO days 7,14. DNA was extracted by desalting method
!Sample_extract_protocol_ch1 = 50 microgramms of DNA were used to PCR amplify library using Herculase II enzyme following published protocols and instructions supplied by authors on Addgene  (Shalem, et al Science 2014. 343(6166): p. 84-87, Tzelepis et al, Cell Rep, 2016. 17(4): p. 1193-1205)
!Sample_extract_protocol_ch1 = Shalem et al Science 2014. 343(6166): p. 84-87
!Sample_description = PCR library sequencing
!Sample_description = LIB171004JT_YUSAplasmid_S1_L005
!Sample_data_processing = Sequences were trimmed using cutadapt version 1.10 called with parameters "cutadapt -n 2 -g {adapter5} -a {adapter3}" where adapter3 = GTTTAAGAGC and adapter5 = ACGAAACACCG
!Sample_data_processing = Trimmed reads were aligned using bowtie2 called with parameters "bowtie2 -p 8 --norc -U"
!Sample_data_processing = Formatting was done using samtools called as "samtools view -bS"
!Sample_data_processing = Filtering was performed using samtools called as "samtools view -bq 10"
!Sample_data_processing = MAGeCK( version 0.5.6) count command was executed.
!Sample_data_processing = Genome_build: custom reference created from CRISPR library (yusa4bowtie2.fasta) PMID:27760321
!Sample_data_processing = Supplementary_files_format_and_content: Raw read counts sgRNA x sample matrix .tsv format
