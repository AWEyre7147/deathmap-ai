^SAMPLE = GSM5751592
!Sample_title = RNA-seq_ESCs_siRNA_ctrl_rep1
!Sample_geo_accession = GSM5751592
!Sample_status = Public on Feb 11 2023
!Sample_submission_date = Dec 23 2021
!Sample_last_update_date = Feb 11 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = ES cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell line: ES-E14TG2a
!Sample_characteristics_ch1 = strain: 129/Ola
!Sample_characteristics_ch1 = sirna: non-targeting control
!Sample_treatment_protocol_ch1 = ES cells were transfected with ON-TARGETplus SMART pool siRNAs using lipofectamine 2000, and cells were harvested 72 hours after transfection for nucleic acid extraction.
!Sample_growth_protocol_ch1 = Mouse embryonic stem cell line E14TG2a was cultured in DMEM Glutamax supplemented with 15% FBS, 1,000 U/mL of LIF, 0.1 mM of non-essential amino acids, 50 U/mL of penicillin and streptomycin and 0.1 mM of 2-mercaptoethanol.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA samples were extracted using the NucleoSpin RNA purification kit and NucleoSpin RNA/DNA Buffer Set for parallel RNA and DNA purification (Macherey-Nagel) according to the manufacturer's instructions.
!Sample_extract_protocol_ch1 = RNA-seq libraries were prepared from 400 ng total RNA using the TruSeq Stranded Total RNA Library Prep Gold kit with Ribo-Zero rRNA removal and TruSeq RNA Single Indexes kits A and B (Illumina), according to the manufacturer's instructions. The final libraries were generated with 12 cycles of PCR amplification and purified using AMPure XP beads (Beckman-Coulter).
!Sample_data_processing = Reads were aligned to the mouse mm10 genome with TopHat2 v2.0.13 using default parameters and a RefSeq transcriptome index.
!Sample_data_processing = For data visualization, bigWig files were generated using bam2wig.py from the RSeQC package v2.6.4 using the parameters -u -t 5000000000.
!Sample_data_processing = We provide bigWig files for visualization of RNA-seq tracks.
!Sample_platform_id = GPL21103
!Sample_contact_name = Michael,,Weber
!Sample_contact_department = UMR7242 Biotechnology and Cell Signalling
!Sample_contact_institute = CNRS
!Sample_contact_address = 300 Bd Sebastien Brant
!Sample_contact_city = Illkirch
!Sample_contact_zip/postal_code = 67412
!Sample_contact_country = France
