^SAMPLE = GSM6774888
!Sample_title = B80T5 replicate A
!Sample_geo_accession = GSM6774888
!Sample_status = Public on Mar 08 2023
!Sample_submission_date = Dec 01 2022
!Sample_last_update_date = Mar 10 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Breast
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Breast
!Sample_characteristics_ch1 = cell line: B80T5
!Sample_characteristics_ch1 = cell type: Mammary epithelial
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Cells were counted using the Countess II automated cell counter (Thermo Scientific) and fixed with 2% formaldehyde using the Arima HiC+ Kit (Arima, A101020). HiChIP libraries were generated with the Arima HiChIP kit using an antibody against H3K27ac (Active Motif AbFlex: 91193). 1e6 fixed cells were used in restriction enzyme digest, biotin end filling ligation reactions to the manufacturer’s protocol.
!Sample_extract_protocol_ch1 = Libraries were prepared using the KAPA Kit (KAPA, KK2620), according to the Arima-HiC kit protocol. Libraries were indexed using the Swift Biosciences indexing kit then paired-end sequenced (150bp) with Illumina Novaseq 6000 to generate >500M raw reads per library.
!Sample_data_processing = Raw reads for individual replicates were processed with HiC-Pro (v 2.11.4) and aligned to hg19.
!Sample_data_processing = Replicate samples for each cell type were quality controlled and checked for genome-wide signal correlation before merging with HiC-Pro.
!Sample_data_processing = Enriched regions representing H3K27ac peaks were detected using MACS2.
!Sample_data_processing = Chromatin loops were detected in each cell type-specific dataset using FitHiChIP v8.1 at 2 kb resolution limiting to 2 Mb interaction distance.
!Sample_data_processing = Peak-to-all loops were used for background modeling and a q < 0.01 threshold set to determine significant interactions.
!Sample_data_processing = Assembly: hg19
!Sample_data_processing = Supplementary files format and content: tab-delimited text file output from FitHiChIP including statistically significant chromatin interaction scores for each sample
!Sample_data_processing = Library strategy: Hi-ChIP
!Sample_platform_id = GPL24676
!Sample_contact_name = Jonathan,,Beesley
!Sample_contact_email = jonathan.beesley@qimrberghofer.edu.au
!Sample_contact_institute = QIMR Berghofer
!Sample_contact_address = 300 Herston Rd Herston
!Sample_contact_city = Brisbane
!Sample_contact_state = QLD
!Sample_contact_zip/postal_code = 4006
!Sample_contact_country = Australia
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN31972774
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX18451461
