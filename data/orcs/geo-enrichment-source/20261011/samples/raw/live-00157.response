^SAMPLE = GSM5934778
!Sample_title = WT screen
!Sample_geo_accession = GSM5934778
!Sample_status = Public on Mar 27 2022
!Sample_submission_date = Mar 04 2022
!Sample_last_update_date = Mar 27 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Calu 3 + SARS-CoV-2
!Sample_organism_ch1 = Homo sapiens
!Sample_organism_ch1 = Severe acute respiratory syndrome coronavirus 2
!Sample_taxid_ch1 = 9606
!Sample_taxid_ch1 = 2697049
!Sample_characteristics_ch1 = cell line: Calu 3 (ATCC HTB-55)
!Sample_characteristics_ch1 = infection: WT SARS-CoV-2
!Sample_characteristics_ch1 = days post infection: 7
!Sample_characteristics_ch1 = crispr library: GeCKO
!Sample_treatment_protocol_ch1 = Calu-3 cells were transduced with lentivirus of human Brunello Human CRISPR library, two days post-transduction, 5 ug/ml puromycin was added to the media and transduced cells were selected for seven days. Twenty-four hours prior to infection with SARS-CoV-2, 1.5*10^7 Calu-3 library-cells were seeded in 75-cm2 flasks. For viability screen, mock cells were harvested 7 days after seeding and served as a control for the depletion of genes that are essential for cell survival. Three screens, using 3 variants of SARS-CoV-2, were performed with 3*10^7 cells in each screen which is sufficient for the representation of each sgRNA into ~400 unique cells. For SARS-CoV-2 infection cells were washed once with RPMI without FBS and infected with SARS-CoV-2 virus, at a MOI of 0.02 to 0.04, in the presence of 20 μg per ml TPCK trypsin and 2% FBS. Flasks were incubated for 1 hour at 37 °C to allow viral adsorption. Then, RPMI medium supplemented with 2% FBS, was added to each well. Nine days post infection with SARS-CoV-2 cells were collected. All screens were performed in duplicate.
!Sample_growth_protocol_ch1 = Calu-3 cells (ATCC HTB-55) were cultured in Dulbecco’s Modified Eagle Medium (DMEM) with 10% heat-inactivated fetal bovine serum (FBS), 10 mM non-essential amino acids (NEAA), 2 mM L-Glutamine, 1 mM Sodium pyruvate and 1% Penicillin/Streptomycin (all from Biological Industries, Israel) at 37◦C, 5% CO2.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Cell pellets were dissolved in 10% triton and boiled for 30 minutes. Genomic DNA was extracted using a QIAamp DNA mini kit.
!Sample_extract_protocol_ch1 = sgRNA sequences were amplified by one-step PCR using primers with Illumina adapters and the gDNA as a template.
!Sample_description = sgRNAs from Calu-3 cells 7 days post infection with WT SARS-CoV-2.
!Sample_description = PCR amplicon
!Sample_data_processing = MAGeCK v0.5.6 was used to count sgRNA from FASTQ files.
!Sample_data_processing = MAGeCK v0.5.6 was used to analyze the selection effect of genes based on the change in sgRNA distribution, using the robust rank aggregation (RRA) algorithm with normalization to total reads.
!Sample_data_processing = Genome_build: The GeCKO library was used as reference for sgRNA counts.
!Sample_data_processing = Supplementary_files_format_and_content: sgRNA_counts.txt: Matrix table with raw counts for every sgRNA and every sample.
!Sample_platform_id = GPL30234
!Sample_contact_name = Noam,,Stern-Ginossar
!Sample_contact_email = noam.stern-ginossar@weizmann.ac.il
!Sample_contact_laboratory = Noam Stern-Ginossar
!Sample_contact_department = Molecular Genetics
!Sample_contact_institute = Weizmann Institute
!Sample_contact_address = 234 herzel
!Sample_contact_city = Rehovot
!Sample_contact_zip/postal_code = 7610001
!Sample_contact_country = Israel
!Sample_instrument_model = Illumina MiSeq
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN26442454
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX14372891
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE197962
!Sample_data_row_count = 0
