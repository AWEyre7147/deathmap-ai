^SAMPLE = GSM3573397
!Sample_title = MOLM-13_Par_RNA-seq_rep1
!Sample_geo_accession = GSM3573397
!Sample_status = Public on May 03 2019
!Sample_submission_date = Jan 21 2019
!Sample_last_update_date = May 03 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = MOLM-13 parental cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: MOLM-13
!Sample_characteristics_ch1 = cell type: human acute myeloid leukemia (AML) cells
!Sample_characteristics_ch1 = treatment: none
!Sample_characteristics_ch1 = genotype/variation: parental cells
!Sample_treatment_protocol_ch1 = For samples 1 and 2, MOLM-13 cells were cultured in DMSO or increasing doses of Venetoclax (from 5nM to 1000nM) for over eight weeks. For samples 3-8, sgRNAs targeting CLPB or control (Rosa) were transduced into MOLM-13-Cas9-dBSD cells by spin infection. Media were replenished every other day for 6 or 8 day during which puromycin (1ng/ml) selection was performed.
!Sample_growth_protocol_ch1 = MOLM-13 human leukemia cells were cultured in RPMI medium supplemented with 10% FBS and 1% penicillin/streptomycin.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = MOLM-13 cells were harvested at indicated time points and washed with 1x PBS. Total RNA was extracted using RNeasy Plus Mini Kit (Qiagen) and QIAshredder (Qiagen). We isolated poly(A) mRNA using magnetic isolation method (NEXTFLEX, Bioo Scientific) using ~1 ug of total mRNA.
!Sample_extract_protocol_ch1 = To generate RNA-Sequencing libraries, we used NEXTFLEX Rapid Directional RNA-Seq Library Prep Kit (Bioo Scientific) and NEXTFLEX RNA-Seq barcodes (Bioo Scientific), which were carried out according to manufacturer’s protocol.
!Sample_extract_protocol_ch1 = RNA-Seq barcoded libraries were then sequenced using Hi-Seq 4000 (single end, 50 cycles).
!Sample_description = NEXTflex Rapid Directional RNA-Seq Kit from Bioo Scientific (Catalog no: 5138-07)
!Sample_data_processing = Read alignment: STAR aligner version 2.5.0c was used to map reads against the reference genome hg19. Only uniquely mapping reads were kept (specific parameters: --trim5p=13, --outFilterMultimapNmax 1, --outFilterMismatchNoverLmax 0.05)
!Sample_data_processing = Deduplication: Duplicated reads were excluded using picard-tools version 2.6.0.
!Sample_data_processing = Read counting: Reads were counted on a stranded gene-basis within annotated exons downloaded from Ensembl Genes V75 using the ngsutils tool bamutils count (special paramters: -uniq, -multiple complete, -library RF).
!Sample_data_processing = Normalization: edgeR version 3.14.0 was used to normalize read counts per sample and genes were filtered for counts-per-million > 1. CDS length from Ensembl Genes V75 was used to calculate FPKM values for filtered genes.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: FPKM table
!Sample_platform_id = GPL20301
!Sample_contact_name = Xufeng,,Chen
!Sample_contact_email = Xufeng.Chen@nyulangone.org
!Sample_contact_phone = 3472775664
!Sample_contact_institute = NYU Langone Medical Center
!Sample_contact_address = 550 First Avenue, Smilow 1307
!Sample_contact_city = new york
!Sample_contact_state = NY
!Sample_contact_zip/postal_code = 10016
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN10785347
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX5274243
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE125403
!Sample_data_row_count = 0
