!Sample_submission_date = Jan 25 2021
!Sample_last_update_date = Feb 04 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = endoscopic tumor biopsy
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: esophageal adenocarcinoma
!Sample_characteristics_ch1 = treatment: neoadjuvant chemoradiotherapy + atezolizumab
!Sample_characteristics_ch1 = response: non-responder
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Snap frozen tumor biopsies were cut into smaller pieces on the cryostat. One section was used for haematoxylin and eosin staining to determine the tumor cell percentage in the biopsy, which was performed by an experienced pathologist. Total RNA was isolated using the Qiagen AllPrep DNA/RNA/miRNA universal kit. The NanoDrop (Thermo Fisher) was used to measure RNA concentration (ng/ul). Biopsies were sent for bulk RNA sequencing in case the tumor % was ≥ 30% and RNA concentration was not lower than 20 ng/ul.
!Sample_extract_protocol_ch1 = RNA libraries were prepared for sequencing using standard Illumina protocols
!Sample_description = TE2004-47-atr
!Sample_data_processing = The samples were sequenced on an Illumina HiSeq4000 with a single read consisting of 50bp and 100.000.000 reads per sample.
!Sample_data_processing = Data went through quality control using FastQC.
!Sample_data_processing = RNAseq reads were aligned to the human reference genome (NCBI37/hg19) using STAR v2.7.1, and annotated with Gencode v32.
!Sample_data_processing = Count files were converted into DESeq_vst values using DESeq2 in R Bioconductor.
!Sample_data_processing = DESeq libraries were used for differential expression analysis using the normalized counts in the R2 genome analysis and visualization platform (http://r2.amc.nl).
!Sample_data_processing = Genome_build: (NCBI37/hg19)
