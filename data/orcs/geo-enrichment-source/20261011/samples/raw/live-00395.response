!Sample_contact_email = t.vandenende@amsterdamumc.nl
!Sample_contact_institute = Amsterdam UMC
!Sample_contact_address = Meibergdreef 9
!Sample_contact_city = Amsterdam
!Sample_contact_zip/postal_code = 1105 AZ
!Sample_contact_country = Netherlands
