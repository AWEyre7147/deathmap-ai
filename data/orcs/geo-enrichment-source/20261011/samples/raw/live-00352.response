!Sample_contact_city = San Diego
!Sample_contact_state = California
!Sample_contact_zip/postal_code = 92121
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN16232006
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX9163046
!Sample_supplementary_file_1 = NONE
