^SAMPLE = GSM3721791
!Sample_title = Acute_replicate1
!Sample_geo_accession = GSM3721791
!Sample_status = Public on Feb 12 2020
!Sample_submission_date = Apr 12 2019
!Sample_last_update_date = Feb 13 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Acute_Flow cytometry sorted astrocytes
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: C57Bl/6
!Sample_characteristics_ch1 = genotype/variation: wild type
!Sample_characteristics_ch1 = Sex: Male
!Sample_characteristics_ch1 = age: P122
!Sample_characteristics_ch1 = mouse status: EAE peak phase
!Sample_characteristics_ch1 = cell type: Flow cytometry sorted astrocytes based on TdTomato fluorscence
!Sample_treatment_protocol_ch1 = Induction of EAE in mice. EAE was induced by injecting 150 µg of MOG35-55 diluted in 100 µL of PBS emulsified in 100 µL of CFA per mouse.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Each CNS was isolated per mouse. A cell suspension was generated by papain digestion, neutralization, and 70um filtration of cell extract. Cells were centrifuged, resuspended in 30% Percoll, centrifuged, and washed in PBS. Cells were sorted by flow cytometry based on TdTomato fluorescence. Post-sort, cells were suspended in PBS and 16% Opti-prep.
!Sample_extract_protocol_ch1 = Libraries were created according to the Drop-seq protocol in Macosko et al. Cell 2015. Following reverse transcription, exonuclease I treatment, and PCR, cDNA libraries were quantified and 600 pg of cDNA was tagmented using Nextera XT library prep kit.
!Sample_description = 1_HCYTGDMXX.1.CGTACTAG
!Sample_data_processing = Reads were processed using the DropSeq analysis pipeline developed by the McCarroll lab (http://mccarrolllab.com/dropseq/)
!Sample_data_processing = Individual cells were tagged with barcodes, and transcripts within each cell were tagged with distinct UMIs (Unique Molecular Identifiers).
!Sample_data_processing = Reads were trimmed at 3' end to remove poly(A) tails with length greater than 5 and at the 5' end for adapters
!Sample_data_processing = Reads with barcode base quality less than 10 were filtered out..
!Sample_data_processing = Raw reads were aligned to mouse  (GRCm38) genome by STAR (v2.4.0) with default settings
!Sample_data_processing = UMI counts expression matrix were generated using Dropseq Tools software (v1.13.1)
!Sample_data_processing = Genome_build: GRCm38
!Sample_data_processing = Supplementary_files_format_and_content: Tab-delimited text file consisting of UMI gene counts for cells with minimum 100 genes.
!Sample_platform_id = GPL24247
!Sample_contact_name = Michael,,Wheeler
!Sample_contact_email = mwheeler0@bwh.harvard.edu
!Sample_contact_department = Neurology
!Sample_contact_institute = Brigham and Women's Hospital
!Sample_contact_address = 60 Fenwood Rd.
!Sample_contact_city = Boston
!Sample_contact_state = MA
!Sample_contact_zip/postal_code = 02115
!Sample_contact_country = USA
