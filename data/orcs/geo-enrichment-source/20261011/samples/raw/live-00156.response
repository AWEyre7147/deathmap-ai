!Sample_submission_date = Jun 16 2021
!Sample_last_update_date = Jun 05 2024
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Nalm-6 pre-B lymphoid cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: Nalm-6
!Sample_characteristics_ch1 = cell type: pre-B lymphoid cell line
!Sample_characteristics_ch1 = treatment/time point: EMI1 70nM
!Sample_characteristics_ch1 = experiment type: pooled sgRNA library
!Sample_characteristics_ch1 = molecule subtype: sgRNAs PCR-amplified from genomic DNA
!Sample_treatment_protocol_ch1 = A Nalm-6 clone with inducible expression of Cas9 was thawed, and Cas9 expression induced with doxycycline at 2 µg/mL for 8 days (see Bertomeu et al., 2017 for details). The pooled EKO library was split in different T-75 flasks, compounds added, and propagated for 8 days. Fresh media and compound was added at each cell passage. The untreated control sample with multiple collected time-points was grown in T-175 spinner flasks.
!Sample_growth_protocol_ch1 = Nalm-6 cells were grown in 10% FBS (v/v) (Wisent) RPMI 1640 medium (Wisent) at 5% (v/v) CO2 and 37°C.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted and purified using the Gentra Cell Puregene kit (QIAGEN, cat. # 158388).
!Sample_extract_protocol_ch1 = sgRNA libraries were prepared by PCR amplification to add sequencing adapters and indices followed by SPRI beads purification of sequencing-ready amplicons.
!Sample_description = EGFR_inhibitor_EMI1_0_07uM_S10
!Sample_data_processing = Reads were aligned using Bowtie2.2.5 in the forward direction only (--norc option) with otherwise default parameters and total read counts per sgRNA were tabulated.
!Sample_data_processing = Read counts from different sequencing lanes for the same sample were summed and reads from all untreated and DMSO-treated control samples were summed to generate a single control sgRNA distribution.
!Sample_data_processing = Supplementary_files_format_and_content: sgRNA read counts per sample as a tab-delimited text file
!Sample_platform_id = GPL18573
!Sample_contact_name = Micheal,D,Tyers
