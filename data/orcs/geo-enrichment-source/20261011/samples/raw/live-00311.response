^SAMPLE = GSM3967075
!Sample_title = T cell CTCF rep1 (ChIP-seq)
!Sample_geo_accession = GSM3967075
!Sample_status = Public on Aug 04 2019
!Sample_submission_date = Jul 24 2019
!Sample_last_update_date = Aug 04 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Peripheral blood T cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Peripheral blood
!Sample_characteristics_ch1 = disease state: Healthy T cells
!Sample_characteristics_ch1 = treatment: N/A
!Sample_characteristics_ch1 = chip antibody: CTCF (D31H2; Catalog no: 3418)
!Sample_treatment_protocol_ch1 = CUTLL1 cells were treated with gamma-secretase inhibitor (1 uM) for 72 hours or BET inhibitor (JQ1, 500 nM) for 24h or CDK7 inhibitor (THZ1, 100 mM) for 24 hours.
!Sample_growth_protocol_ch1 = CUTLL1 cells were grown in RPMI medium with 10% FBS ; Primary T-ALL cells isolated from the peripheral blood of T-ALL patients were xenogroafted in immunocompromised NOD SCID gamma mice (NSG) . Following xenograft, and when the tumor bueden in pheripheral blood reached 80%, the mice were sacrificed and the spleen was harvested and splenocytes were used for the Chip-Seq analysis;  Healthy T cells were purchased from Lonza (catlog no: 2W-200)
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Lysates were clarified from sonicated nuclei and histone-DNA complexes were isolated with antibody.
!Sample_extract_protocol_ch1 = libraries were prepared using Kapa Hyper prep kit (Catalog no: KK8500) following manufacturer's guidelines
!Sample_description = Tcells_CTCF_narrow-peaks.bed
!Sample_description = Tcells_CTCF_FE.bw
!Sample_data_processing = Read alignment: Reads were aligned against the reference sequence hg19 with bowtie2 (version 2.3.1) with standard parameters and only uniquely mapped reads were kept with MAPQ > 20.
!Sample_data_processing = Deduplication: Aligned reads were filtered for duplicated reads using picard-tools version 2.6.0.
!Sample_data_processing = Peak-calling: Peak calling for CTCF and H3K27ac was performed using MACS2 (version 2.0.1) using narrow (CTCF) and broad (--broad; H3K27ac) option (sepcial parameters: --no-model).
!Sample_data_processing = Differential binding: To identify differentially bound peaks, we performed diffBind (version 2.2.12) analysis, using the normalization option DBA_EDGER.
!Sample_data_processing = Bigwig: For visualization purposes, we generated fold-enrichment bigwig files by applying MACS2 (version 2.0.1) bdgcmp over input (-m FE)
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: bigwig, peak (bed)
!Sample_platform_id = GPL16791
