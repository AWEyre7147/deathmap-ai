^SAMPLE = GSM2515759
!Sample_title = Luciferase-D4ChIP-rep1
!Sample_geo_accession = GSM2515759
!Sample_status = Public on Mar 31 2017
!Sample_submission_date = Feb 28 2017
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = ChIP-seq in hiPSCs
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: human induced pluripotent stem cells
!Sample_characteristics_ch1 = transgene: Luciferase
!Sample_characteristics_ch1 = condition: 18hr dox-induction
!Sample_treatment_protocol_ch1 = Cells were kept under constant drug selection (Puromycin) and induced with doxycycline for 18hrs.
!Sample_growth_protocol_ch1 = hiPSCs were cultured on Matrigel in mTeSR1 supplemented with ROCK inhibitor.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Cells were crosslinked in 1% formaldehyde for 10 minutes. Cells were then washed in PBS (x2) and resuspended in lysis buffer (10mM Tris,100mM NaCl, 1mM EDTA, 0.5mM EGTA, 0.1% Na-Deoxycholate, 0.5% N-lauroylsarcosine) to extract chromatin. Lysates were then sonicated using a BioRuptor, centrifuged to pellet cellular debris, and immunoprecipitated.
!Sample_extract_protocol_ch1 = After reversing crosslinks, libraries were prepped using the NEBnext DNA Library Prep Kit (NEB, E7370L). Adapter ligated DNA was size selected and purified using AMPure XP beads (Beckman Coulter, A63881) before sequencing.
!Sample_description = Antibody: abcam124699
!Sample_data_processing = Raw read squences were trimmed to remove low quality bases and adapter sequences (Trim Galore!) before aligning to hg19 using Bowtie2 (v2.2.6) with the following parameters: (-t –q –N1 –L 25 –X 2000 –no-mixed –no-discordant) (*non-unique reads assigned to 1 location).
!Sample_data_processing = A read-normalized bedgraph file for each ChIP library was generated with MACS2 callpeak (-f BAMPE -B -SPMR).
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: The read normalized bedGraph files were  converted into bigwig format for genome browser visulization.
!Sample_platform_id = GPL16791
!Sample_contact_name = Peter,G,Hendrickson
!Sample_contact_email = peter.hendrickson@hci.utah.edu
!Sample_contact_laboratory = Bradley R. Cairns
!Sample_contact_department = HHMI/Oncological Sciences
!Sample_contact_institute = University of Utah
!Sample_contact_address = 2000 Circle of Hope Dr.
!Sample_contact_city = Salt Lake City
!Sample_contact_state = UT
!Sample_contact_zip/postal_code = 84112
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = ChIP
!Sample_library_source = genomic
!Sample_library_strategy = ChIP-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN06471265
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX2599522
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM2515nnn/GSM2515759/suppl/GSM2515759_Luciferase-rep1.bw
!Sample_series_id = GSE85632
!Sample_series_id = GSE95515
