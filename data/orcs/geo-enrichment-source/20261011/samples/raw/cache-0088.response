^SAMPLE = GSM4502469
!Sample_title = LK.zrsr2_wt.1
!Sample_geo_accession = GSM4502469
!Sample_status = Public on Feb 09 2021
!Sample_submission_date = Apr 27 2020
!Sample_last_update_date = Feb 09 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Hematopoietic stem/progenitor cells (DAPI- lineage-negative c-Kit+ cells)
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: C57Bl/6 (BF1)
!Sample_characteristics_ch1 = genotype/variation: Zrsr2-wt
!Sample_characteristics_ch1 = cell type: Hematopoietic stem/progenitor cells (DAPI- lineage-negative c-Kit+ cells)
!Sample_treatment_protocol_ch1 = The Zrsr2 allele was deleted by targeting exon 4. Two LoxP sites flanking exon 4 and an Frt-flanked neomycin selection cassette were inserted in the downstream intron.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = RNA was extracted using RNeasy columns (Qiagen) per manufacturer’s instructions.
!Sample_extract_protocol_ch1 = RNA was Poly(A)-selected, and unstranded Illumina libraries were prepared with the standard TruSeq protocol. To select for fragments <400 bp, 0.5× AMPure XP beads were added to the library followed by 1× AMPure XP beads to select for fragments >100 bp. These fragments were then amplified by PCR (15 cycles) and separated by gel electrophoresis (2% agarose).
!Sample_description = Method of Zrsr2 deletion: LoxP sites flanking Zrsr2 exon 4 and an Frt-flanked neomycin selection cassette.
!Sample_description = processed data file: Mx1_Cre_Zrsr2_cKO_Psi_values.xlsx
!Sample_data_processing = Gene annotations from UCSC knownGene track, Ensembl71, and MISO v2.0 were merged.
!Sample_data_processing = RNA-seq reads were mapped to the transcriptome with RSEM v1.2.4, modified to invoke Bowtie v1.0.0 with the ‘-v 2’ option.
!Sample_data_processing = Remaining unaligned reads were mapped to the genome as well as a database of possible splice junctions, consisting of all possible combinations of 5' and 3' splice sites annotated for each gene, using TopHat v2.0.8b.
!Sample_data_processing = Isoform ratios were quantified with MISO v2.0.
!Sample_data_processing = Psi (percent spliced in) values for all intron retention (ri) events were determined for individual samples: LK.zrsr2_wt.1, LK.zrsr2_wt.2, LK.zrsr2_wt.3, LK.zrsr2_ko.1, LK.zrsr2_ko.2, and LK.zrsr2_ko3.
!Sample_data_processing = Genome_build: mm10 (GRCm38)
!Sample_data_processing = Supplementary_files_format_and_content: Mx1_Cre_Zrsr2_cKO_Psi_values.xlsx: Excel file contains isoform ratio measurements (Psi) for splicing events (retained intron, ri) with a minimum of 20 supporting reads.
!Sample_platform_id = GPL17021
!Sample_contact_name = Jacob,Tyler,Polaski
!Sample_contact_email = jpolaski@fredhutch.org
!Sample_contact_department = Public Health Sciences/Basic Sciences
!Sample_contact_institute = Fred Hutchinson Cancer Research Center
!Sample_contact_address = 1100 Fairview Ave. N.
!Sample_contact_city = Seattle
!Sample_contact_state = Washington
!Sample_contact_zip/postal_code = 98109
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN14739385
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX8182604
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE149455
!Sample_data_row_count = 0
