!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4987nnn/GSM4987770/suppl/GSM4987770_3-scr-INTS6_S2_R1_001.fastq.gz.sam.sorted.bam.rmdup.bam.cpm.bw
