!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4987nnn/GSM4987764/suppl/GSM4987764_4-scr-CDK9_S3_R1_001.fastq.gz.sam.sorted.bam.rmdup.bam.cpm.bw
