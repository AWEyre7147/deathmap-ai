^SAMPLE = GSM4987771
!Sample_title = THP-1 sgSCR CDK9i INTS6
!Sample_geo_accession = GSM4987771
!Sample_status = Public on May 23 2021
!Sample_submission_date = Dec 24 2020
!Sample_last_update_date = May 23 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Acute myeloid leukemia cell line expressing Cas9 and non-targeting (Scramble) sgRNA
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: THP-1 cell line
!Sample_characteristics_ch1 = genotype: expressing Cas9 and non-targeting (Scramble) sgRNA
!Sample_characteristics_ch1 = chip antibody: DICE1 (INTS6) clone H-6 (Santa Cruz, sc-376524)
!Sample_characteristics_ch1 = treatment: CDK9i (AZ5576) 170nM 2 hours
!Sample_treatment_protocol_ch1 = Cells were treated with DMSO (untreated control), CDK9i (AZ5576, 100nM or 170nM 2 hours) or DBK-1154 (10µM 2 hours 15 minutes)
!Sample_growth_protocol_ch1 = THP-1 cells were cultured in RPMI-1640 supplemented with 10-20 percent heat-inactivated fetal bovine serum, 100U/mL penicillin, 100µg/mL streptomycin and 2mM GlutaMAX at 37 degrees celciuus and 5 percent carbon dioxide. S2 cells were cultured in Schneider's Drosophila medium supplemented with 10 percent heat-inactivated fetal bovine serum, 100U/mL penicillin, 100µg/mL streptomycin and 2mM GlutaMAX at room temperature and atmospheric carbon dioxide
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Cells were cross-linked with formaldehyde solution, nuclei were extracted and sonicated using a Covaris. Protein-bound chromatin was isolated using indicated antibody and decrosslinked DNA was isolated using the Zymogen ChIP DNA Clean and Concentrator Kit
!Sample_extract_protocol_ch1 = ChIP-seq librarys were prepared using the NEBNext Ultra II DNA Library Prep Kit for Illumina (NEB E7645) and 200 - 500 base pair fragments were selected using a Pippin Prep (1.5% agarose, Sage Science)
!Sample_data_processing = Sequenced reads were demultiplexed using bcl2fastq (v2.17.1.14)
!Sample_data_processing = Basic QC performed on fastq files using FASTQC (v0.11.6)
!Sample_data_processing = Fastq files were aligned to a Hg19 or dm3 reference genome performed with Bowtie2 (v2.3.4.1) to generate SAM files
!Sample_data_processing = SAM files converted to BAM files using Samtools (v1.9) using view command. BAM files were sorted, indexed and potential PCR duplicates removed using rmdup function
!Sample_data_processing = bigWig files were generated from sorted, indexd BAM files using the Deeptools (v3.0.0) BamCoverage function (--normalize using CPM, --smoothLength 150 --binSize 50 -e 200 scaleFactor 1)
!Sample_data_processing = Average read density across defined genomic regions were defined using the Deeptools computeMatrix function and plotHeatmap function was used to generate chromatin occupancy heatmaps
!Sample_data_processing = Subread (v2.0.0) featureCounts function (-O -M -T 16 -F SAF) was used to count reads within TSS and gene body regions using bedtools (v2.27.1) slop function using UCSC Hg19 or dm3 chromosome sizes
!Sample_data_processing = Read density was calculated as RPKM in Rstudio (v3.6.1) using limma (v3.40.6) and edgeR (v.3.26.8) and visualized using ggplot2 (v3.3.1)
!Sample_data_processing = Genome_build: Hg19 or dm3
!Sample_data_processing = Supplementary_files_format_and_content: bigWig files of RNAPII, CDK9, INTS11, INTS6, BRD4 and RNAPII phospho-ser 2 occupancy across the genome in CPM
!Sample_platform_id = GPL18573
