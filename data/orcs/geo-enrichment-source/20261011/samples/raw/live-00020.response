^SAMPLE = GSM4141791
!Sample_title = T-ALL1_WGS
!Sample_geo_accession = GSM4141791
!Sample_status = Public on Oct 29 2019
!Sample_submission_date = Oct 28 2019
!Sample_last_update_date = Oct 29 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Peripheral blood primary T-ALL cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue source: Peripheral blood
!Sample_characteristics_ch1 = subject status: T cell acute lymphoblastic leukemia patient
!Sample_characteristics_ch1 = xenografted cell type: Primary T-ALL cells
!Sample_characteristics_ch1 = host strain: immunocompromised NOD SCID gamma mice (NSG)
!Sample_characteristics_ch1 = cell type: splenocytes
!Sample_treatment_protocol_ch1 = N/A
!Sample_growth_protocol_ch1 = Primary T-ALL cells isolated from the peripheral blood of T-ALL patients were xenogroafted in immunocompromised NOD SCID gamma mice (NSG) . Following xenograft and when the tumor burden in pheripheral blood reached 80% the mice were the spleen was harvested and splenocytes were used for the Whole Genome Sequencing (WGS) analysis.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Nuclear extraction and DNA purification using QIAmp DNA extraction kit from Qiagen
!Sample_extract_protocol_ch1 = Libraries were prepared by GeneWiz using NEBNext Ultra DNA library preparation kit for Illumina.
!Sample_description = processed data file:
!Sample_description = TALL_CNV.hg19.combined.sort.tsv
!Sample_description = TALL_SV.hg19.combined.sort.tsv
!Sample_description = TALL_SNV.hg19.combined.sort.tsv
!Sample_description = TALL_INV.hg19.combined.sort.tsv
!Sample_description = TALL_BND.hg19.combined.sort.tsv
!Sample_data_processing = library strategy: Whole Genome Sequencing
!Sample_data_processing = Read alignment: Paired-end reads were aligned against the reference genome sequence GRCh38/hg38 using iSAAC (version 03.16.02.19).
!Sample_data_processing = Copy number variants: CNVs were called using Canvas (version 1.3.1)
!Sample_data_processing = Structural variants: SVs (including indels, tandem-duplications and inversion) were called using Manta (version 0.28.0)
!Sample_data_processing = Single-nucleotide variants: SNVs were called using Starling variant caller (version 2.4.6). SNVs were filtered for a 1000genome project reported GMAF<1%
!Sample_data_processing = Translocations: Intra- and inter-chromosomal translocations were called with Manta (version 0.28.0) and delly (version XX) simultanously, and only results detected with both algorithms were kept.
!Sample_data_processing = Liftover: all results were lift-over to hg19 using UCSC liftOver
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: tsv - custom
!Sample_platform_id = GPL20301
!Sample_contact_name = Andreas,,Kloetgen
!Sample_contact_department = Department for Computational Biology of Infection Research
!Sample_contact_institute = Helmholtz Centre for Infection Research
!Sample_contact_address = Inhoffenstr 7
!Sample_contact_city = Braunschweig
!Sample_contact_state = NI
!Sample_contact_zip/postal_code = 38124
!Sample_contact_country = Germany
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN13136331
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX7063938
!Sample_supplementary_file_1 = NONE
