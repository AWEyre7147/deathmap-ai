^SAMPLE = GSM4146148
!Sample_title = Tumor 1
!Sample_geo_accession = GSM4146148
!Sample_status = Public on Nov 01 2019
!Sample_submission_date = Oct 31 2019
!Sample_last_update_date = Nov 01 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = gallbladder tissue
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = diagnosis: gallbladder cancer
!Sample_characteristics_ch1 = tissue: gallbladder tumor
!Sample_characteristics_ch1 = individual: 1
!Sample_treatment_protocol_ch1 = The tissues were lysed in Trizol directly and do total RNA extraction.
!Sample_growth_protocol_ch1 = The fresh tumorous tissues and matched normal tissue were obtained from surgery.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted from tissue by Trizol reagent (Invitrogen) separately. The RNA quality was checked by Bioanalyzer 2200 (Agilent) and kept at -80℃. The RNA with RIN >8.0 is right for cDNA library construction.
!Sample_extract_protocol_ch1 = RNA libraries were prepared for sequencing using standard Illumina protocols.
!Sample_description = processed data file: all.rpkm.txt
!Sample_data_processing = Reads filtering under criteria removing reads with 20% of the base quality lower than 13.
!Sample_data_processing = HISAT2.1.0 mapping to reference genome.
!Sample_data_processing = Reads Per Kilobase of exon per Megabase of library size (RPKM) were calculated using a protocol from Chepelev et al., Nucleic Acids Research, 2009. In short, exons from all isoforms of a gene were merged to create one meta-transcript. The number of reads falling in the exons of this meta-transcript were counted and normalized by the size of the meta-transcript and by the size of the library.
!Sample_data_processing = Genome_build: GRCh38
!Sample_data_processing = Supplementary_files_format_and_content: all.rpkm.txt: Tab-delimited text file includes RPKM values for each Sample.
!Sample_platform_id = GPL20795
