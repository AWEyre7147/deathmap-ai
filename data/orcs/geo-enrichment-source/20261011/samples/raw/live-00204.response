!Sample_channel_count = 1
!Sample_source_name_ch1 = acute myeloid leukemia
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: MOLM-13
!Sample_characteristics_ch1 = treatment: : day 5 after sgSTK35-sgPDIK1L bi-cistronic vector encoding two guideRNAs infection
!Sample_treatment_protocol_ch1 = Cells were lentivirally infected with sgSTK35-sgPDIK1L bi-cistronic vector encoding two guideRNAs coupled to the blasticidin resistance gene for simultaneous knockout of STK35 and PDIK1L, 1 μg/mL blasticidin was added 24 hours post-infection, cells were harvested on day 5 post-infection
!Sample_growth_protocol_ch1 = Cells were cultured in RPMI with 10% FBS and penicillin/streptomycin
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted using TRIzol following the manufacture's protocol
!Sample_extract_protocol_ch1 = RNA-seq library was prepared using Illumina TruSeq sample prep kit v2 according to the manufacture's protocol. Briefly, polyA RNA was selected and fragmented enzymatically. First strand of cDNA was synthesized using Super Script II reverse transcriptase, and then second strand was synthesized. Double-stranded cDNA was end-repaired, 3'-adenylated, ligated with indexed adaptor, and then PCR-amplified.
!Sample_description = 210311_Salmon_tpm_MOLM13_SCP4_STK35PDIK1L.txt
!Sample_description = 200701_DeSeq2_MOLM13_dgSTK35_PDIK1L.txt
!Sample_description = 210203_Kallisto_MOLM13_dgSTK35_PDIK1L_vs_sgROSA_Polyanskaya.csv
!Sample_data_processing = Sequencing reads were mapped onto reference human genome hg19 using STAR v.2.5.2b-1
!Sample_data_processing = The mapped reads were assigned to genes using HTSeq-Count v.0.6.1p1
!Sample_data_processing = The differential expression gene analysis was performed using DESeq2, with four replicates for each sample
!Sample_data_processing = Pesudo-alignment to the reference human transcriptome (gencode v.35), assignment of reads to genes, and TPM calculation were all performed using Salmon (v.1.0)
!Sample_data_processing = This, GSE109491, and GSE104308 datasets raw data were re-analyzed together using Kallisto pipeline
!Sample_data_processing = This, GSE109491, and GSE104308 datasets were aligned (pseudo-alignment) using Kallisto to hg38, bootstrap 100
!Sample_data_processing = The differential expression gene analysis was performed using DESeq2, with [MOLM13_sgROSA_rep1; MOLM13_sgROSA_rep2; MOLM13_sgROSA_rep3; MOLM13_sgROSA_rep4]; [MOLM13_sgSCP4_rep1; MOLM13_sgSCP4_rep2; MOLM13_sgSCP4_rep3; MOLM13_sgSCP4_rep4]; [MOLM13_dgSTK35-PDIK1L_rep1; MOLM13_dgSTK35-PDIK1L_rep2; MOLM13_dgSTK35-PDIK1L_rep3; MOLM13_dgSTK35-PDIK1L_rep4]; [GSM2944342; GSM2944341]; [GSM2944348; GSM2944347]; [GSM2944344; GSM2944343]; [GSM2794837; GSM2794836]; [GSM2794841;GSM2794840]; [GSM2794839; GSM2794838] treated as replicates.
!Sample_data_processing = Genome_build: hg19; hg38
