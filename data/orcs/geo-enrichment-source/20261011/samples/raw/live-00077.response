^SAMPLE = GSM4052460
!Sample_title = MUTU I Rep1
!Sample_geo_accession = GSM4052460
!Sample_status = Public on May 04 2020
!Sample_submission_date = Aug 29 2019
!Sample_last_update_date = May 04 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = MUTU I Burkitt Lymphoma cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: MUTU I Burkitt Lymphoma cells
!Sample_treatment_protocol_ch1 = No specific treatment
!Sample_growth_protocol_ch1 = MUTU I and MUTU III cells were cultured in GIBCO RPMI 1650 medium (Life Technologies) with 10% fetal calf serum (FCS) and 10 mM HEPES in a humidified chamber at 37 degrees Celcius with 5% CO2.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Total RNAs were subsequently isolated using PureLink RNA Mini Kit (Thermo Fisher Scientific) following the manufacturer’s manual. An in-column DNA digestion step was included to remove any residual genomic DNA contamination
!Sample_extract_protocol_ch1 = To construct RNA-seq libraries, 500 ng total RNA was used for polyA mRNA-selection using NEBNext Poly(A) mRNA Magnetic Isolation Module (#E7490, New England Biolabs, Inc.  Ipswich, MA), followed by library construction via NEBNext Ultra RNA Library Prep Kit for Illumina (#E7530, New England Biolabs, Inc., Ipswich, MA).
!Sample_description = mutu1 
!Sample_data_processing = Adaptor-trimmed Illumina reads for each individual library were mapped back to the human GRCh37.83 transcriptome assembly using STAR v2.5.2b
!Sample_data_processing = featureCounts v1.5.1 was used to estimate the number of reads mapped to each contig. Only transcripts with at least 5 cumulative mapping counts were used in this analysis.
!Sample_data_processing = DESeq2 v1.14.1 was used to evaluate gene differential expression (DE)
!Sample_data_processing = Each DE analysis was composed of a pairwise comparison between experimental group and the control group. Differentially expressed genes were identified after a correction for false discovery rate (FDR 0.05).
!Sample_data_processing = Genome_build: GRCh37.83
!Sample_data_processing = Supplementary_files_format_and_content: tab-delimited text files include Log2FoldChange value (experimental v.s. control), p value and FDR corrected p value (padj). Separate tab-delimited text files are also provided for raw counts and normalized counts of genes, respectively
!Sample_platform_id = GPL18573
!Sample_contact_name = Rui,,Guo
!Sample_contact_email = rui.guo@tufts.edu
!Sample_contact_laboratory = Guo lab
!Sample_contact_department = School of Medicine
!Sample_contact_institute = Tufts University
!Sample_contact_address = 150 Harrison Ave.
!Sample_contact_city = Boston
!Sample_contact_state = Massachusetts
!Sample_contact_zip/postal_code = 02111
!Sample_contact_country = USA
