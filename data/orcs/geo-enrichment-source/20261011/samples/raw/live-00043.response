^SAMPLE = GSM5589334
!Sample_title = NT_rep1
!Sample_geo_accession = GSM5589334
!Sample_status = Public on Jul 13 2022
!Sample_submission_date = Sep 20 2021
!Sample_last_update_date = Jul 14 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = NT_rep1
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: CD34+ HSPCs
!Sample_characteristics_ch1 = treatment: NT sgRNA
!Sample_treatment_protocol_ch1 = CD34+ HSPCs cells eletroporated with NT or VHL sgRNA1 RNP complex.
!Sample_growth_protocol_ch1 = Erythroid differentiation of CD34+ cells was performed using a three-phase culture protocol. For phase 1 (days 0-7), cells were maintained at a density of 1-4 × 105 /mL in IMDM supplemented with 2% human AB plasma, 3% human AB serum, 1% penicillin-streptomycin, 3 IU/mL heparin, 10 μg/mL insulin, 200 μg/mL holo-transferrin, 1 IU erythropoietin, 10 ng/mL SCF, and 1 ng/mL interleukin-3 (IL-3). For phase 2 (days 8-12), IL-3 was omitted from the medium. Cells were maintained at a density of 0.2-0.8 × 106/mL. For phase 3 (days 12-18), IL-3 and SCF were omitted, the holo-transferrin concentration was increased to 1 mg/mL, and the cells were maintained at a density of 1-2 × 106/mL.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA from approximately 0.5 to 1 million cells was extracted using the RNeasy Plus Kit (QIAGEN).
!Sample_extract_protocol_ch1 = The TruSeq Stranded mRNA Library Prep Kit (Illumina) was used to enrich for polyA+ RNA and create libraries for HiSeq4000 sequencing (Illumina).
!Sample_description = RNA-seq
!Sample_data_processing = gene expression quantification was performed using Kallisto (v0.43.1).
!Sample_platform_id = GPL20301
!Sample_contact_name = Mitchell,J,Weiss
!Sample_contact_email = mitch.weiss@stjude.org
!Sample_contact_phone = 9015958351
!Sample_contact_institute = St. Jude Children's Research Hospital
!Sample_contact_address = 262 Danny Thomas Place
!Sample_contact_city = Memphis
!Sample_contact_state = TN
!Sample_contact_zip/postal_code = 38105
!Sample_contact_country = USA
