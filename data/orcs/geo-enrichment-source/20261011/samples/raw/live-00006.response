^SAMPLE = GSM3444308
!Sample_title = CRISPR library uninfected control cells
!Sample_geo_accession = GSM3444308
!Sample_status = Public on Oct 25 2018
!Sample_submission_date = Oct 23 2018
!Sample_last_update_date = Oct 25 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Huh7.5
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: Huh7.5
!Sample_characteristics_ch1 = crispr library: Brunello human library
!Sample_characteristics_ch1 = treatment: none
!Sample_characteristics_ch1 = infection: uninfected
!Sample_treatment_protocol_ch1 = Huh7.5 cells were treated with CRISPR-library lentivirus for 2 days, then selected with media containing 4 ug/mL puromycin for 3 days. Cells were plated into 15cm dishes, then infected the next morning with YFV-17D-venus for 24hrs. The infected cells were harvested and prepared for flow cytometry. By FACS, GFP-positive gated cells were collected, pelleted, and lysed for genomic DNA extraction.
!Sample_growth_protocol_ch1 = Human Huh7.5 cells were grown in DMEM supplemented with 10% FBS, 1X non-essential amino acids, and selected for lentivirus transduction with 4 ug/mL puromycin.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted by phenol:chloroform:isoamyl alcohol and purified by ethanol precipitation.
!Sample_extract_protocol_ch1 = Six to ten micrograms of total genomic DNA were used per PCR reaction with barcoded primers to produce a CRISPR amplicon library for each sample. Amplicon library samples were purified with AmpureXP beads and tested for purity by Agilent Bioanalyzer and qPCR with sequencing specific primers. Samples were quantified by Qubit, pooled, then sequenced on an Illumina NextSeq 500.
!Sample_description = Brunello_500x_A04
!Sample_description = CRISPR-transduced Huh7.5 cells, uninfected.
!Sample_description = PCR amplicon
!Sample_description = Liver
!Sample_description = processed data file: JS.count.txt
!Sample_data_processing = Bcl files were demultiplexed using bcl2fastq (v2.20).
!Sample_data_processing = sgRNA sequences were trimmed using an inhouse script.
!Sample_data_processing = Enriched genes and normalized read counts were identified via MAGeCK (v0.5.4), Model-based Analysis of Genome-wide CRISPR/Cas9 Knockout (MAGeCK) method for prioritizing single-guide RNAs, genes and pathways in genome-scale CRISPR/Cas9 knockout screens.
!Sample_data_processing = Genome_build: Human CRISPR Knockout Pooled Library (Brunello).
!Sample_data_processing = Supplementary_files_format_and_content: JS.count.txt: Tab-delimited text file that includes the raw counts for each sgRNA.
!Sample_platform_id = GPL18573
!Sample_contact_name = John,,Schoggins
