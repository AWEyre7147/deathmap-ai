!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: CUTLL1
!Sample_characteristics_ch1 = treatment: DMSO
!Sample_characteristics_ch1 = drug release: N/A
!Sample_treatment_protocol_ch1 = CUTLL1 cells were treated with gamma-secretase inhibitor (1 uM) for 72 hours, and followed after release of the drug for 10 hours.
!Sample_growth_protocol_ch1 = CUTLL1 cells were grown in RPMI medium with 10% FBS.
!Sample_molecule_ch1 = nuclear RNA
!Sample_extract_protocol_ch1 = Trizol, phenol/chloroform
!Sample_extract_protocol_ch1 = TruSeq Small RNA Library Preparation Kit was used as by manufacturers instructions.
!Sample_description = GROseq_FPKM_table.tsv
!Sample_description = DMSO_1
!Sample_description = DMSO_forward.bw
!Sample_description = DMSO_reverse.bw
!Sample_data_processing = library strategy: GRO-seq
!Sample_data_processing = Read alignment: Reads were aligned against hg19 using bowtie with standard parameters. Only uniquely mapped reads with MAPQ > 20 were kept.
!Sample_data_processing = Read counting: All remaining aligned reads were counted in a stranded-manner on a gene-basis for all annotated genes in Ensembl Genes V75 using bamutils count of the ngsutils package (version 0.5.7). Specific options were -uniq -multiple complete -library RF.
!Sample_data_processing = Normalization: Read counts were normalized with edgeR (version 3.14.0; functions calcNormFactors and estimateTagwiseDisp). FPKM normalization was applied with edgeR using CDS length downloaded from Ensembl Genes V75.
!Sample_data_processing = Visualization: Aligned sequencing reads were used to generate bigwig tracks per genomic strand using bedtools (version 2.27.1; options -fs 250) after normalizing for sequencing depth and fragment length.
!Sample_data_processing = Genome_build: hg19
