^SAMPLE = GSM5267256
!Sample_title = Control ISG-KO A549-ACE2 cells (not infected with SARS-CoV-2)
!Sample_geo_accession = GSM5267256
!Sample_status = Public on May 06 2021
!Sample_submission_date = Apr 27 2021
!Sample_last_update_date = May 06 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = lung epithelial cells A549-ACE2
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: A549-ACE2
!Sample_characteristics_ch1 = cell type: lung epithelial cells
!Sample_characteristics_ch1 = facs: control
!Sample_characteristics_ch1 = infection: non-infected
!Sample_treatment_protocol_ch1 = To generate ISG KO library cells, 36x10^6 A549-ACE2 cells were seeded in 6 well plates (10^6 cells per well) 24h before transduction. For each well, 100 µL of concentrated lentivector was diluted in 500 µL of serum-free DMEM, supplemented with 10 µg/mL of DEAE dextran (Sigma #D9885). After 48h, transduced cells were selected by puromycin treatment for 20 days (1 µg/mL ; Sigma #P8833). 4x10^7 A549-ACE2 cells were treated with IFN (200U/mL). 16h later, cells were infected at a MOI of 1 in serum-free media complemented with TPCK-trypsin and IFN alpha (200 U/mL). After 90 min, the viral inoculum was removed and cells were maintained in DMEM containing 5% FBS and IFN (200 U/mL). After 24h, cells were harvested and fixed for 15 min in Formalin 1%. Fixed cells were washed in cold FACS buffer containing PBS, 2% Bovine Serum Albumin (Sigma-Aldrich #A2153-100G), 2 mM EDTA (Invitrogen #15575-038) and 0.1% Saponin (Sigma-Aldrich #S7900-100G). Cells were incubated for 30 min at 4°C under rotation with primary antibody diluted in FACS buffer. Incubation with the secondary antibody was performed during 30 min at 4°C under rotation. Stained cells were resuspended in cold sorting buffer containing PBS, 2% FBS, 25 mM Hepes (Sigma-Aldrich #H0887-100ML) and 5 mM EDTA. Infected cells were sorted on a BD FACS Aria Fusion.
!Sample_growth_protocol_ch1 = A549-ACE2 (ATCC #CCL-185) were grown in DMEM (Gibco #31966021) supplemented with 10% FBS (Gibco #A3160801), and penicillin/streptomycin (100 U/mL and 100 µg/mL, Gibco # 15140122). Blasticidin (10 µg/mL, Sigma-Aldrich #SBR00022-10ML) was added for selection of A549-ACE2. All cells were maintained at 37°C in a 5% CO2 atmosphere.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Sorted and control (non-infected, not IFN-treated) cells were centrifugated (20 min, 2,000g) and resuspended in lysis buffer (NaCI 300 mM, SDS 0.1%, EDTA 10 mM, EGTA 20 mM, Tris 10 mM) supplemented with 1% Proteinase K (Qiagen #19133) and 1% RNAse A/T1 (ThermoFisher #EN0551) and incubated overnight at 65°C. Two consecutive phenol-chloroform (Sigma #P3803-100ML) extractions were performed and DNA was recovered by ethanol precipitation.
!Sample_extract_protocol_ch1 = Nested PCR was performed using the Herculase II Fusion DNA Polymerase (Agilent, #600679). PCR1 products were purified using QIAquick PCR Purification kit (Qiagen #28104). PCR2 products were purified using Agencourt AMPure XP Beads (Beckman Coulter Life Sciences #A63880). DNA concentration was determined using Qubit dsDNA HS Assay Kit (Thermo Fisher #Q32854) and adjusted to 2 nM prior to sequencing.
!Sample_description = ISG CRISPR/Cas9 knockout sgRNA region
!Sample_data_processing = library strategy: PCR amplicon sequencing
!Sample_data_processing = Reads were demultiplexed using bcl2fastq Conversion Software v2.20 (Illumina) and fastx_toolkit v0.0.13.
!Sample_data_processing = Sequencing adapters were removed using cutadapt v1.9.1.
!Sample_data_processing = The reference library was built using bowtie2 v2.2.9.
!Sample_data_processing = Read mapping was performed with bowtie2 allowing 1 seed mismatch in --local mode and samtools v1.9.
!Sample_data_processing = Genome_build: Reference sequences sgRNA_multifasta_map_ref.fasta
!Sample_data_processing = Supplementary_files_format_and_content: Read count table provided in read_count_table.txt is composed of the following columns sgRNA, gene, Lib_isg_ctrl (showing a total number of reads mapping to sgRNA sequence in the non-infected sample), Lib_isg_sort (showing a total number of reads mapping to sgRNA sequence in the infected sample).
!Sample_platform_id = GPL18573
!Sample_contact_name = Artem,,Baidaliuk
!Sample_contact_email = artembaidaliuk.94@gmail.com
!Sample_contact_institute = Institut Pasteur
!Sample_contact_address = 25-28 rue Dr. Roux
!Sample_contact_city = PARIS 15
!Sample_contact_zip/postal_code = 75015
!Sample_contact_country = France
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN18879737
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX10687547
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE173418
!Sample_data_row_count = 0
