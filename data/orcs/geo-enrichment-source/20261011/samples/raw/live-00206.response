!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: BLaER1
!Sample_characteristics_ch1 = genotype: WT
!Sample_treatment_protocol_ch1 = 1.4 million BLaER1 cells per well of a 6-well plate were trans-differentiated into monocytes for 5 days in medium containing 10 ng/ml of hrIL-3, 10 ng/ml hr-CSF-1 (M-CSF) (both PeproTech) and 100 nM β-Estradiol (Sigma-Aldrich).
!Sample_growth_protocol_ch1 = BLaER1 cells were cultured in RPMI Medium 1640 supplemented with L-glutamine, sodium pyruvate, 100U/ml penicillin-streptomycin (Thermo Fisher) and 10% (v/v) FCS (Omega Scientific).
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = RNA from 2.8 million trans-differentiated BLaER1 monocytes was isolated using TRIzol™ Reagent (Thermo Fisher). DNA was removed with RQ1 RNase-free DNase (Promega) in the presence of RNasin plus Ribonuclease Inhibitor (Promega) and RNA isolated with Agencourt AMPure XP beads (Beckman Coulter).
!Sample_extract_protocol_ch1 = mRNA-seq libraries were prepared from poly-A-enriched mRNA using a KAPA mRNA HyperPrep Kit (Roche) and sequenced on an Illumina Novaseq S4 150PE.
!Sample_description = MG_A10_S10_L004
!Sample_description = Replicate 1 for RNA-seq 5 days of trans-differentiation
