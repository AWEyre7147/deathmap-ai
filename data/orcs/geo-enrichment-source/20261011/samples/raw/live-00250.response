^SAMPLE = GSM5106818
!Sample_title = TALL2_8g_valine_total_RNA
!Sample_geo_accession = GSM5106818
!Sample_status = Public on Oct 25 2021
!Sample_submission_date = Feb 25 2021
!Sample_last_update_date = Oct 25 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = mouse secondary transplant of T-ALL
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: secondary transplant of T-ALL
!Sample_characteristics_ch1 = valine concentration: 8g/kg valine diet (control)
!Sample_characteristics_ch1 = rna fraction: total RNA
!Sample_characteristics_ch1 = mouse strain: C57BL/6
!Sample_treatment_protocol_ch1 = Mice secondrary transplanted with NOTCH-delta E tumors were fed either valine proficient control diet or valine deficient diet or valine defiecinet diet substituted with either 0.8g/L or 0.4g/L valine in drinking water. Mice were sacrificed 3 weeks in different diets and leuekmic cells were sorted from spleen using GFP as a marker and used for RNA isolation.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA and Ribosome protected RNA was extracted using True Ribo-Seq profile kit from Illumina folllowing manufacturer's guidelines.
!Sample_extract_protocol_ch1 = Libraries from Total RNA and Ribosome protected RNA was generated using  True Ribo-Seq profile kit from Illumina folllowing manufacturer's guidelines.
!Sample_data_processing = Library strategy: Ribo-Seq
!Sample_data_processing = Trimming: Adatper sequences were first removed from each sequencing read using cutadapt version 1.18, keeping reads longer than 15bp (parameters: -m 15 -q 25).
!Sample_data_processing = ncRNA alignment: In order to remove ncRNA sequences, trimmed reads were first aligned against an ncRNA database downloaded from Ensembl Genes V85 using bowtie2 version 2.3.4. Only non-aligned reads were kept for further analyses.
!Sample_data_processing = Genome alignment: Remaining reads were aligned against the mouse reference genome sequence mm10/GRCm38 with STAR aligner version 2.5.0c
!Sample_data_processing = Read counting: Reads were counted per annotated gene exon with the STAR integrated counts function (-quantMode GeneCounts) using annotations from Ensembl Genes V85.
!Sample_data_processing = Normalization: Read counts were normalized using edgeR version 3.14.0 with the rpkm function and gene length information from Ensembl Genes V85.
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: tsv - FPKM list
!Sample_platform_id = GPL21103
!Sample_contact_name = Andreas,,Kloetgen
!Sample_contact_department = Department for Computational Biology of Infection Research
!Sample_contact_institute = Helmholtz Centre for Infection Research
!Sample_contact_address = Inhoffenstr 7
!Sample_contact_city = Braunschweig
!Sample_contact_state = NI
!Sample_contact_zip/postal_code = 38124
!Sample_contact_country = Germany
