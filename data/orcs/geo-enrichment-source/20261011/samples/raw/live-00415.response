!Sample_title = MUS_28_Renca-HA T16 A
!Sample_geo_accession = GSM4518262
!Sample_status = Public on Jul 31 2020
!Sample_submission_date = May 06 2020
!Sample_last_update_date = Jul 31 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Renca cell line + haemagglutinin antigen
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell line: Renca
!Sample_characteristics_ch1 = treatment: T cell (drop-out)
!Sample_characteristics_ch1 = crispr library: mTKO
!Sample_characteristics_ch1 = time point: T16
!Sample_characteristics_ch1 = sequenced molecule: gRNA amplicon
!Sample_treatment_protocol_ch1 = Cells were repeatedly exposed (2-3 times for ~12-48 hours) to IFNa [10ng/ml], TNFa [10ng/ml] or cytotoxic T-lymphocytes [variable effector to target ratios]
!Sample_growth_protocol_ch1 = Cells were cultured in RPMI media supplemented with 10% FBS and 1% Penicillin/Streptomycin and serially passaged for ~18-35 days (propagated in biological triplicates)
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted using the Wizard Genomic DNA Purification kit (Promega) according to manufacturer’s instructions
!Sample_extract_protocol_ch1 = For each tumor sample, the gRNA cassette was amplified directly from genomic DNA using primers harboring Illumina TruSeq adaptors with i5 and i7 barcodes. The resulting sequencing libraries were pooled and gel-purified.
!Sample_data_processing = Library strategy: CRISPR screen
!Sample_data_processing = FASTQ files were pre-processed to extract Cas9 guide sequence using a bespoke Perl script.
!Sample_data_processing = The Cas9 guide sequence was extracted from read1 files as the 20 bases preceeding 'CGGTGTTT'.
!Sample_data_processing = Trimmed FASTQ files were then aligned to the mTKO or mValidation FASTA file using bowtie v0.12.1 using the following command line parameters:   -p 16 -v 3 -l 18 --chunkmbs 256 -t <library_file> --un unmapped.fastq --al mapped.fastq -1 <trimmed_read1.fastq> aligned.sam
!Sample_data_processing = The number of reads aligning to each guide sequence was enumerated for each aligned .sam file, and alignment statistics were recorded.  Guide IDs and counts were written to individual count files.
!Sample_data_processing = All individual count files were merged along with library annotations in R.
!Sample_data_processing = Supplementary_files_format_and_content: tab-delimited read count matrix
