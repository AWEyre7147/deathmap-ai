^SAMPLE = GSM1126945
!Sample_title = p53 ChIP-seq_Sample 1
!Sample_geo_accession = GSM1126945
!Sample_status = Public on Apr 21 2013
!Sample_submission_date = Apr 20 2013
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = mouse embryo fibroblasts_p53 ChIP-seq_wt dox
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: 129/Sv
!Sample_characteristics_ch1 = cell type: mouse embryo fibroblast (MEF)
!Sample_characteristics_ch1 = genotype/variation: wild-type
!Sample_characteristics_ch1 = chip antibody: CM-5 (Vector labs, VP-P956)
!Sample_characteristics_ch1 = treatment: 0.2ug/ml doxorubicin for 6h
!Sample_treatment_protocol_ch1 = untreated or 0.2ug/ml doxorubicin for 6h
!Sample_growth_protocol_ch1 = DMEM with 10% FCS, for ChIP-seq 4x106 cells were plated on 15 cm dish one day prior to treatment, for RNA-seq 1.5x 106 cells were plated on 10 cm dish
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = For ChIP-seq, samples were prepared according to Myers lab ChIP-seq protocol: cells were cross-linked with 1% formaldehyde at room temperature for 10 min, cells were extracted with Farnham and RIPA buffers, and chromatin was fragmented by sonication.
!Sample_extract_protocol_ch1 = For ChIP-Seq, libraries were prepared according to the Illumina ChIP-seq library preparation protocol: ChIP DNA was blunt ended, ligated to Solexa adaptors, amplified using adaptor primers and size-selected on agarose gel.
!Sample_description = Processed data file: ChIP-seq_peaks_p53_binding_sites.txt (linked as supplementary file on Series record)
!Sample_data_processing = ChIP-seq and RNA-seq reads were aligned to the mm9 genome assembly using DNAnexus.
!Sample_data_processing = For ChIP-seq: Peaks were called using the DNAnexus ChIP-seq analyses tool with the following specifications: peak enrichment >20, peak-to background enrichment >3, a minimum ratio between uniquely and repetitively mapped reads of 3:1, a kernel bandwith of 30.0, FDR calculation enabled. Background was combined input  reads and reads from p53 ChIP in p53-/- MEFs.
!Sample_data_processing = For RNA-seq: Tag counts were derived using the DNAnexus 3SEQ transcriptome-based quantification tool with the following specifications: Sense only, RefSeq genes. The DESeq library was used to normalize tag counts between samples and to call differentially expressed genes.
!Sample_data_processing = Genome_build: mm9
!Sample_data_processing = Supplementary_files_format_and_content: ChIP-seq: Processed data files are tab-delimited text files containing 1) Chromosome name, 2) Position (summit of the peak), 3) enrichment (based on background reads), 4) neg_log10_qvalue (negative log of q-value of peak) and 5) peak rank.
!Sample_data_processing = Supplementary_files_format_and_content: RNA-seq: Processed files are tab-delimited text files containing normalized gene expression, obtained using DESeq.
!Sample_platform_id = GPL9185
!Sample_contact_name = Stephano,,Spano Mello
!Sample_contact_laboratory = Attardi lab
!Sample_contact_institute = Stanford University
!Sample_contact_address = 269 Campus Drive
!Sample_contact_city = Stanford
!Sample_contact_state = CA
!Sample_contact_zip/postal_code = 94305
!Sample_contact_country = USA
!Sample_instrument_model = Illumina Genome Analyzer
!Sample_library_selection = ChIP
!Sample_library_source = genomic
!Sample_library_strategy = ChIP-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN02054307
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX270554
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE46240
!Sample_data_row_count = 0
