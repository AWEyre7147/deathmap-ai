^SAMPLE = GSM1873337
!Sample_title = circ-RNAseq: si-Ctrl rep1
!Sample_geo_accession = GSM1873337
!Sample_status = Public on Sep 28 2017
!Sample_submission_date = Sep 09 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Prostate cancer cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: LNCaP
!Sample_treatment_protocol_ch1 = LNCaP cells were transfected with 20 nM siRNA oligos of si-Ctrl, si-HNRNPL, si-LARP, respectively using RNAiMax reagent (Life Technology).
!Sample_growth_protocol_ch1 = LNCaP cells were cultured in RPMI 1640 medium supplemented with 10% fetal bovine serum (FBS).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted with Trizol reagent (Life Technology). The Ribominus kit (Life Technology) was employed to remove rRNA. RNase R treatment was performed with 20U RNase R (Epicenter) per μg RNA at 37°C for 15 min. RNAs with or without RNase R treatment were purified and subjected to library preparation and next generation sequencing.
!Sample_extract_protocol_ch1 = RNA-seq libraries were constructed with TruSeq Stranded mRNA Library Prep Kit from Illumina according to the manufacturer’s manual.
!Sample_description = circRNA-Seq
!Sample_data_processing = Illumina Casava1.7 software used for basecalling.
!Sample_data_processing = The circular RNA was identified using the CIRCexplorer (Zhang et al., 2014). Briefly, RNA-seq reads were first mapped using TopHat 2.0.9 (parameters: -a 6 --microexon-search -m 2) against the hg19 human reference genome with the UCSC known gene transcript annotation. Unmapped reads were then extracted and mapped onto the relevant reference genome using TopHat-Fusion (TopHat 2.0.9, parameters:--fusion-search --keep-fasta-order --bowtie1 --no-coverage-search). Back-spliced junction reads were extracted and further realigned against existing gene annotations to determine the precise positions of donor or acceptor splice site for each back-spliced event. Junction reads with shifted alignments against canonical splice sites were adjusted to the correct positions and reads with alignments on different genes or non-canonical splice sites were discarded.
!Sample_data_processing = Genome_build: hg19
!Sample_platform_id = GPL11154
!Sample_contact_name = Yiwen,,Chen
!Sample_contact_email = ychen26@mdanderson.org
!Sample_contact_laboratory = Yiwen Chen
!Sample_contact_department = Bioinformatics and Computational Biology
!Sample_contact_institute = University of Texas MD Anderson Cancer Center
!Sample_contact_address = 1400 Pressler Street
!Sample_contact_city = Houston
!Sample_contact_state = TX
!Sample_contact_zip/postal_code = 77030
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2000
!Sample_library_selection = size fractionation
!Sample_library_source = transcriptomic
!Sample_library_strategy = ncRNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN04044010
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX1212577
!Sample_supplementary_file_1 = NONE
