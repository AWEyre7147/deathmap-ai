^SAMPLE = GSM1375207
!Sample_title = H3_ChIPSeq_Human
!Sample_geo_accession = GSM1375207
!Sample_status = Public on May 19 2014
!Sample_submission_date = Apr 25 2014
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = H3_ChIPSeq_Human
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = donor age: adult
!Sample_characteristics_ch1 = cell type: sperm
!Sample_characteristics_ch1 = chip antibody: H3F3B
!Sample_characteristics_ch1 = chip antibody vendor: Abnova
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Lysates were clarified from sonicated nuclei and histone-DNA complexes were isolated with antibody.
!Sample_extract_protocol_ch1 = Libraries were prepared according to Illumina's instructions accompanying the DNA Sample Kit (Part# 0801-0303). Briefly, DNA was end-repaired using a combination of T4 DNA polymerase, E. coli DNA Pol I large fragment (Klenow polymerase) and T4 polynucleotide kinase. The blunt, phosphorylated ends were treated with Klenow fragment (32 to 52 exo minus) and dATP to yield a protruding 3- 'A' base for ligation of Illumina's adapters which have a single 'T' base overhang at the 3’ end. After adapter ligation DNA was PCR amplified with Illumina primers for 15 cycles and library fragments of ~250 bp (insert plus adaptor and PCR primer sequences) were band isolated from an agarose gel. The purified DNA was captured on an Illumina flow cell for cluster generation. Libraries were sequenced on the Illumina HiSeq 2000 following the manufacturer's protocols.
!Sample_description = processed data file: H3.3_EnrichedRegions.txt
!Sample_data_processing = ChIP-seq data processing and analysis was performed as previously described in Hammoud et al., 2009.  Briefly, differential enrichment between histone ChIP-seq dataset and mononucleosomal control datasets (from GSE15690) were determined with ScanSeqs (USeq), and statistically enriched peaks were called with EnrichedRegionMaker (USeq).
!Sample_data_processing = Genome_build: hg18
!Sample_data_processing = Supplementary_files_format_and_content: Enrichment were determined with ScanSeqs (USeq), and statistically enriched peaks were called with EnrichedRegionMaker (USeq). Useq files were generated as part of the USeq software collection ChIPseq pipeline.
!Sample_platform_id = GPL11154
!Sample_contact_name = Diana,HP,Low
!Sample_contact_email = dlow@imcb.a-star.edu.sg
!Sample_contact_laboratory = Chromatin, Epigenetics & Differentiation
!Sample_contact_institute = Institute of Molecular and Cell Biology
!Sample_contact_address = #03-06, 61 Biopolis Drive, Proteos
!Sample_contact_city = Singapore
!Sample_contact_zip/postal_code = 138673
!Sample_contact_country = Singapore
!Sample_instrument_model = Illumina HiSeq 2000
!Sample_library_selection = ChIP
!Sample_library_source = genomic
!Sample_library_strategy = ChIP-Seq
