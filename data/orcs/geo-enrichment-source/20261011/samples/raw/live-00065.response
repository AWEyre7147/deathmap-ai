^SAMPLE = GSM2515771
!Sample_title = Unsorted-plusDox-HAChIP-12hr-rep1
!Sample_geo_accession = GSM2515771
!Sample_status = Public on Mar 31 2017
!Sample_submission_date = Feb 28 2017
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = mouse embryonic stem cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: mouse embryonic stem cells (in 2i media)
!Sample_characteristics_ch1 = transgene: mDuxCA
!Sample_characteristics_ch1 = tag: 3xHA-tag
!Sample_characteristics_ch1 = condition: 12hr dox-induction
!Sample_treatment_protocol_ch1 = Cells were kept under constant drug selection (Puromycin, G418) and induced with doxycycline for 12 or 18hrs prior to crosslinking.
!Sample_growth_protocol_ch1 = mESCs containing two stably integrated transgenes (TRE::3xHA-mDux; MERVL::EGFP) were cultured on gelatin in ES-DMEM supplemented with serum, leukemia Inhibitory Factor, and 2i (CHIR99021, PD0325901).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Cells were crosslinked in 1% formaldehyde for 10 minutes. Cells were then washed in PBS (x2) and resuspended in lysis buffer (10mM Tris,100mM NaCl, 1mM EDTA, 0.5mM EGTA, 0.1% Na-Deoxycholate, 0.5% N-lauroylsarcosine) to extract chromatin. Lysates were then sonicated using a BioRuptor, centrifuged to pellet cellular debris, and immunoprecipitated.
!Sample_extract_protocol_ch1 = After reversing crosslinks, libraries were prepped using the NEBnext DNA Library Prep Kit (NEB, E7370L). Adapter ligated DNA was size selected and purified using AMPure XP beads (Beckman Coulter, A63881) before sequencing.
!Sample_description = Antibody: abcam9110
!Sample_description = mDUX-HA-rep1.bw
!Sample_data_processing = Raw read squences were trimmed to remove low quality bases and adapter sequences (Trim Galore!) before aligning to mm10 using Bowtie2 (v2.2.6) with the following parameters: (-t –q –N1 –L 25 –X 2000 –no-mixed –no-discordant) (*non-unique reads assigned to 1 location).
!Sample_data_processing = A read-normalized bedgraph file for the ChIPs and input control were generated with MACS2 callpeak (-B -SPMR). Replicates from the 12hr dox-induction and 18hr dox-induction were merged.
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: The read normalized bedGraph files were  converted into bigwig format for genome browser visulization.
!Sample_platform_id = GPL17021
!Sample_contact_name = Peter,G,Hendrickson
!Sample_contact_email = peter.hendrickson@hci.utah.edu
!Sample_contact_laboratory = Bradley R. Cairns
!Sample_contact_department = HHMI/Oncological Sciences
!Sample_contact_institute = University of Utah
!Sample_contact_address = 2000 Circle of Hope Dr.
!Sample_contact_city = Salt Lake City
!Sample_contact_state = UT
!Sample_contact_zip/postal_code = 84112
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = ChIP
!Sample_library_source = genomic
!Sample_library_strategy = ChIP-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN06471253
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX2599540
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE85632
!Sample_series_id = GSE95517
!Sample_data_row_count = 0
