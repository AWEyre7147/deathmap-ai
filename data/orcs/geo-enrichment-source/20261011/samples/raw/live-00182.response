^SAMPLE = GSM2938989
!Sample_title = MYC-1
!Sample_geo_accession = GSM2938989
!Sample_status = Public on May 01 2018
!Sample_submission_date = Jan 17 2018
!Sample_last_update_date = May 01 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = hTERT human mammary epithelial cells (hMEC)
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: cells overexpressing MYC
!Sample_characteristics_ch1 = sample type: pInducer-rtTA-Neo and pHAGE-TRE-BC-MYC
!Sample_treatment_protocol_ch1 = Cells plated at equal density, treated with 100 ng/ml dox for 96 hours.
!Sample_growth_protocol_ch1 = HMECs (Lonza cat # CC-2551) were immortalized with hTERT, and were maintained in MEGM (Lonza cat # CC-3150).
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Cells were lysed and RNA extracted using the Qiagen RNeasy kit per manufacturer’s instructions. Poly-A tailed mRNAs were enriched using the NEBNext® Poly(A) mRNA Magnetic Isolation Module per manufacturer’s instructions.
!Sample_extract_protocol_ch1 = Poly-A tailed mRNAs were then prepped into RNA-Seq libraries using NEBNext® Ultra™ RNA Library Prep Kit for Illumina. RNA-Seq libraries were amplified and indexed using NEBNext® Multiplex Oligos for Illumina® per manufacturer’s instructions.
!Sample_extract_protocol_ch1 = Libraries were sequenced on an Illumina HiSeq 2500.
!Sample_data_processing = HISAT2 (Kim et al., Nat Method, 2015)
!Sample_data_processing = Aligned reads were annotated using a matched build of all known gene transcripts and spliceforms.
!Sample_data_processing = Sorted bam files from this alignment were then assessed for transcript frequency using the featureCounts application of the Subread suite, defining features at the exon-level (Liao et al. Bioinformatics, 2014)
!Sample_data_processing = We filtered raw counts to remove transcripts that had less than 20 reads across all samples.
!Sample_data_processing = Counts were then normalized with Limma’s voom function and differential expression was determined with Limma’s general linear model.
!Sample_data_processing = Genome_build: hg38/GRCh38
!Sample_data_processing = Supplementary_files_format_and_content: txt files that include counts normalized with Limma’s voom function.
!Sample_platform_id = GPL16791
