^SAMPLE = GSM2279974
!Sample_title = Transient-mDUX-rep1
!Sample_geo_accession = GSM2279974
!Sample_status = Public on Mar 31 2017
!Sample_submission_date = Aug 15 2016
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = mESCs
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: mouse embryonic stem cells (in 2i media)
!Sample_characteristics_ch1 = transgene: mDuxCA
!Sample_characteristics_ch1 = 3xha-tag: None
!Sample_characteristics_ch1 = condition: Transient expression
!Sample_treatment_protocol_ch1 = Stable cells were kept under constant drug selection (Puromycin, G418) and induced with doxycycline for 24 hrs prior to nucleic acid isolation or FACS.
!Sample_growth_protocol_ch1 = mESCs were cultured on gelatin in ES-DMEM supplemented with serum, leukemia Inhibitory Factor, and 2i (CHIR99021, PD0325901).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was extracted using TRIzol and purified using the Direct-zol RNA MiniPrep Kit by Zymo Research
!Sample_extract_protocol_ch1 = Intact poly(A) RNA was purified from total RNA samples (100-500 ng) with oligo(dT) magnetic beads and stranded mRNA sequencing libraries were prepared as described using the Illumina TruSeq Stranded mRNA Library Preparation Kit (RS-122-2101, RS-122-2102).  Purified libraries were qualified on an Agilent Technologies 2200 TapeStation using a D1000 ScreenTape assay (cat# 5067-5582 and 5067-5583).  The molarity of adapter-modified molecules was defined by quantitative PCR using the Kapa Biosystems Kapa Library Quant Kit (cat#KK4824).  Individual libraries were normalized to 10 nM and equal volumes were pooled in preparation for Illumina sequence analysis. Sequencing libraries (25 pM) were chemically denatured and applied to an Illumina HiSeq v4 single- or paired-end flow cell using an Illumina cBot.  Hybridized molecules were clonally amplified and annealed to sequencing primers with reagents from an Illumina HiSeq SR Cluster Kit v4-cBot (GD-401-4001) or PE Cluster Kit v4-cBot (PE-401-4001).  Following transfer of the flowcell to an Illumina HiSeq 2500 instrument (HCS v2.2.38 and RTA v1.18.61), a 50 cycle single-read or a 125 cycle paired-end sequence run was performed using HiSeq SBS Kit v4 sequencing reagents (FC-401-4003).
!Sample_description = NA
!Sample_data_processing = Raw RNA sequencing reads were aligned to a custom genome index using Novoalign (v2.8, Novocraft).
!Sample_data_processing = Splice junction alignments were converted to genomic coordinates and low quality and non-unique reads were removed using the SamTranscriptomeParser application (USeq package, v8.8.8).
!Sample_data_processing = Raw reads were counted across all individual exons and repeat elements and subsequently merged by corresponsing ensembl gene or repeat masker subfamily annotation. Differential gene and subfamily expression was called using DESeq2.
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: Excel file contains 3 tabs corresponding to each RNA-seq experiment (Transient, unsorted, and sorted).  Each tab contains read coverage and DESeq2 differential expression statistics for all Ensemble genes (mm10) and repetitive elements (by subfamily annotation).
!Sample_platform_id = GPL17021
!Sample_contact_name = Peter,G,Hendrickson
!Sample_contact_email = peter.hendrickson@hci.utah.edu
!Sample_contact_laboratory = Bradley R. Cairns
!Sample_contact_department = HHMI/Oncological Sciences
!Sample_contact_institute = University of Utah
!Sample_contact_address = 2000 Circle of Hope Dr.
!Sample_contact_city = Salt Lake City
!Sample_contact_state = UT
!Sample_contact_zip/postal_code = 84112
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN05578239
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX2023799
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE85627
!Sample_series_id = GSE85632
!Sample_data_row_count = 0
