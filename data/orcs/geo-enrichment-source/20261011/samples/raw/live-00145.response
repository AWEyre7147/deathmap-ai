^SAMPLE = GSM2515763
!Sample_title = Luciferase_14hrs_rep1
!Sample_geo_accession = GSM2515763
!Sample_status = Public on Mar 31 2017
!Sample_submission_date = Feb 28 2017
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = RNA-seq in hiPSCs
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: human induced pluripotent stem cells
!Sample_characteristics_ch1 = transgene: Luciferase
!Sample_characteristics_ch1 = condition: 14hr dox-induction
!Sample_treatment_protocol_ch1 = Cells were kept under constant drug selection (Puromycin) and induced with doxycycline for 14 or 24 hrs prior to RNA isolation.
!Sample_growth_protocol_ch1 = hiPSCs were cultured on Matrigel in mTeSR1 supplemented with ROCK inhibitor.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was extracted using TRIzol
!Sample_extract_protocol_ch1 = RNA libraries were prepared using oligo-dT selection and sequenced on the Illumina HiSeq 2500 according to the manufacturer's instructions.
!Sample_data_processing = Raw RNA sequencing reads were aligned to a custom hg19 genome index using Novoalign (v2.8, Novocraft).
!Sample_data_processing = Splice junction alignments were converted to genomic coordinates and low quality and non-unique reads were removed using the SamTranscriptomeParser application (USeq package, v8.8.8).
!Sample_data_processing = Raw reads were counted across all individual exons and repeat elements and subsequently merged by corresponsing ensembl gene or repeat masker subfamily annotation. Differential gene and subfamily expression was called using DESeq2.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: Excel file contains 2 tabs corresponding to genes and repeat elements (by subfamily annotation). Each tab contains read coverage and DESeq2 differential expression statistics at 14hrs and 24hrs post dox-induction.
!Sample_platform_id = GPL16791
!Sample_contact_name = Peter,G,Hendrickson
!Sample_contact_email = peter.hendrickson@hci.utah.edu
!Sample_contact_laboratory = Bradley R. Cairns
