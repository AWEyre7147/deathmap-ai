^SAMPLE = GSM4796722
!Sample_title = GeCKOv2 plasmid library
!Sample_geo_accession = GSM4796722
!Sample_status = Public on Oct 24 2020
!Sample_submission_date = Sep 21 2020
!Sample_last_update_date = Oct 25 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = plasmid
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: GeCKOv2 plasmid library
!Sample_treatment_protocol_ch1 = A549-ACE2 cells were infected with SARS-CoV-2 at MOI of 0.01 or 0.3.
!Sample_growth_protocol_ch1 = A549-ACE2 cells were grown in DMEM supplemented with 10% FBS.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA (gDNA) was extracted using a previously described protocol (Chen et al., 2015). For the first PCR reaction, we used all gDNA available for each sample.
!Sample_extract_protocol_ch1 = We performed 2 PCR reactions. PCR1 was performed using Taq-B polymerase (Enzymatics) and used multiple reactions where each reaction contained up to 10 µg gDNA per 100 mL PCR reaction. PCR1 products for each sample were pooled and used for amplification with barcoded PCR2 primers. For each sample, we performed 12 PCR2 reactions (using 5 µL of the pooled PCR1 product per PCR2 reaction) with Q5 polymerase (NEB). PCR2 products were pooled and then normalized within each biological sample before combining uniquely-barcoded separate biological samples. The pooled product was then gel-purified from a 2% E-gel EX (Life Technologies) using the QiaQuick gel extraction kit (Qiagen). The purified, pooled library was then quantified with Tapestation 4200 (Agilent Technologies). PCR products were run on a 2% agarose gel and the correct size band was extracted. Sequencing was performed on the NextSeq 550 instrument using the HighOutput Mode v2 with 75 bp paired-end reads (Illumina). All PCR1 and PCR2 primer sequences, including full barcodes, are listed on the GeCKO website (http://genome-engineering.org/gecko ).
!Sample_description = guide RNA was recovered from plasmid by PCR.
!Sample_data_processing = Sequencing reads were demultiplexed upon sequencing based on Illumina i7 barcodes present in PCR2 reverse primers using Illumina BaseSpace.
!Sample_data_processing = Adaptor trimming was performed by treating the hU6 promoter sequence as a 5’ adapter, using cutadapt v1.13 [-e 0.2 -O 5 -m 20 -g TCTTGTGGAAAGGACGAAACACCG].
!Sample_data_processing = Processed guide RNA sequences were aligned to the GeCKOv2 reference allowing for up to 1 mismatch using bowtie v1.1.2  [-a --best --strata -v 1 –norc] with alignment rates of 81% to 86%.
!Sample_data_processing = Genome_build: The reference sequence for each guide is available here: https://www.addgene.org/pooled-library/zhang-human-gecko-v2/
!Sample_data_processing = Supplementary_files_format_and_content: Raw guide counts per gene per sample.
!Sample_platform_id = GPL21697
!Sample_contact_name = Zharko,,Daniloski
!Sample_contact_email = zd315@nyu.edu
!Sample_contact_department = Biology
!Sample_contact_institute = New York University
!Sample_contact_address = 1 Washington square village, 2P
!Sample_contact_city = New York City
!Sample_contact_state = New York
!Sample_contact_zip/postal_code = 10012
!Sample_contact_country = USA
!Sample_instrument_model = NextSeq 550
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN16231955
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX9162980
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4796nnn/GSM4796722/suppl/GSM4796722_GeckoV2plasmid.counts.txt.gz
!Sample_series_id = GSE158298
!Sample_data_row_count = 0
