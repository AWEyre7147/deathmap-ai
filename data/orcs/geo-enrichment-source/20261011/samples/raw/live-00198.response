^SAMPLE = GSM4880582
!Sample_title = AAVS1 non-targeting sgRNA knockout clone 1
!Sample_geo_accession = GSM4880582
!Sample_status = Public on Mar 04 2021
!Sample_submission_date = Nov 04 2020
!Sample_last_update_date = Mar 04 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Nalm-6 pre-B lymphoid cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = genotype/variation: AAVS1 non-targeting sgRNA knockout
!Sample_treatment_protocol_ch1 = Gene disruptions in NALM-6 cells were carried out using CRISPR-Cas9 editing using sgRNAs as described in this study. Clonal isolates of AAVS1 non-tarteting controls (NT), TERT-disrupted (TERT KO) or TAPR1-disrupted cells (TAPR1 KO) were isolated by single cell sorting. Indel efficiency and clonal genotyping was performed on genomic DNA using target locus PCR amplification and sanger sequencing.
!Sample_growth_protocol_ch1 = Nalm-6 cells were grown in 10% FBS (v/v) (Wisent) RPMI 1640 medium (Wisent) at 5% (v/v) CO2 and 37°C. Nalm-6 cells were grown in 10% FBS (v/v) (Wisent) RPMI 1640 medium (Wisent) at 5% (v/v) CO2 and 37°C.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA from 1 million clonal NALM-6 cells of the indicated genotypes was extracted using the QIAGEN Mini Rneasy kit according to the manufacturer's protocol. RNA purity was assessed using a nanodrop spectrophotometer (260/280 nm) and RNA was quantified by QuBit (ABI). RNA quality was assessed with a Bioanalyzer RNA 6000 Nano assay on a 2100 Bioanalyzer (Agilent Technologies).
!Sample_extract_protocol_ch1 = One microgram of total RNA was used for library preparation, which was carried out using the KAPA mRNAseq Hyperprep kit (KAPA, #KK8581). Libraries were quantified using QuBit and Bioanalyzer instruments, and diluted to 10 nM before normalization by qPCR using the KAPA library quantification kit (KAPA, #KK4973). Libraries were then pooled to equimolar concentration.
!Sample_description = RNA_seq_read_counts.txt
!Sample_data_processing = Reads were aligned using Bowtie2.2.5, with default parameters, to all RefSeq transcripts (as at April, 2018). Alignments with fewer than 2 inserted or deleted bases and a maximum edit distance of 5 (i.e. the sum of inserted, deleted, or mismatched bases) were counted to generate read counts per transcript, and reads mapping to transcripts produced from the same gene locus were summed together to generate read counts per gene.
!Sample_data_processing = Read counts from different sequencing lanes for the same sample were summed.
!Sample_data_processing = The tabulated read counts per gene in cells of a given knockout line (e.g. TERT-disrupted or TAPR1-disrupted) were analyzed for differential expression relative to non-targetting controls using the DESeq2 pipeline with the SARtools package on R.
!Sample_data_processing = Genome_build: GRCh38
!Sample_data_processing = Supplementary_files_format_and_content: Raw read counts per gene
!Sample_platform_id = GPL18573
!Sample_contact_name = Lea,,Harrington
!Sample_contact_laboratory = Institute for Research in Immunology and Cancer
!Sample_contact_department = Department of Medicine
!Sample_contact_institute = University of Montreal
!Sample_contact_address = 2950 chemin de Polytechnique, Pavillon Marcelle-Coutu
!Sample_contact_city = Montreal
!Sample_contact_state = Quebec
!Sample_contact_zip/postal_code = H3T1J4
!Sample_contact_country = Canada
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN16667045
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX9434953
!Sample_supplementary_file_1 = NONE
