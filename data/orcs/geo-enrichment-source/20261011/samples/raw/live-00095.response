^SAMPLE = GSM5536198
!Sample_title = WT_rep1  [RVMG021_A_ATAC-seq]
!Sample_geo_accession = GSM5536198
!Sample_status = Public on Nov 01 2021
!Sample_submission_date = Aug 25 2021
!Sample_last_update_date = Nov 01 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = WT_ATAC-seq
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: BLaER1
!Sample_characteristics_ch1 = genotype: IFNAR1-/- IFNAR2-/-
!Sample_characteristics_ch1 = molecule subtype: Tn5 transposed DNA
!Sample_treatment_protocol_ch1 = 1.4 million BLaER1 cells per well of a 6-well plate were trans-differentiated into monocytes for 5 days in medium containing 10 ng/ml of hrIL-3, 10 ng/ml hr-CSF-1 (M-CSF) (both PeproTech).
!Sample_growth_protocol_ch1 = BLaER1 cells were cultured in RPMI Medium 1640 supplemented with L-glutamine, sodium pyruvate, 100U/ml penicillin-streptomycin (Thermo Fisher) and 10% (v/v) FCS (Omega Scientific).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = 50,000 BLaER1 monocytes were washed with PBS and lysed in 50 µL of cold lysis buffer (10 mM Tris-HCl, pH 7.4, 10 mM NaCl, 3 mM MgCl2, 0.1% IGEPAL CA-630). Nuclei were harvested by centrifugation and resuspended in 50 µl TD Buffer (Illumina, FC-121-1030) with 2.5 µL Tn5 Transposase (Illumina, FC-121-1030). The reaction was incubated for 30 min at 37°C and DNA was isolated with a MinElute Kit (Qiagen).
!Sample_extract_protocol_ch1 = Transposed DNA fragments were amplified to reach 30% of maximal amplification and sequenced on an Illumina Nova-Seq SP 50PE.
!Sample_description = Replicate 1 for ATAC-seq 5 days of trans-differentiation
!Sample_data_processing = FASTQC version 0.11.5 was used to assess quality of ATAC-seq reads.
!Sample_data_processing = Adaptor sequences were removed using Cutadapt version 2.10 using a default error rate of 0.1. Reads shorter than 5 were discarded.
!Sample_data_processing = Reads were aligned to the hg19 reference genome using bowtie 2 version 2.3.2 and discordant alignments were removed. Reads with mapping quality less than 30 were removed using SAMtools version 1.3.1 and duplicates were removed using Picard Tools version 2.5.0.
!Sample_data_processing = Regions overlapping black list regions, identified from the ENCODE consortium, were removed. Blacklist regions were downloaded from ENCODE (accession ENCFF000KJP).
!Sample_data_processing = ATAC-seq reads aligned to the positive strand were shifted +4bp and reads aligned to the negative strand were shifted -5bp to adjust read start sites to represent the center of the transposase binding event. Peaks were called on shifted reads using MACS2 version 2.2.7.1, setting the FDR to 0.05 and the default human genome size.
!Sample_data_processing = Peaks from all samples were combined by taking the union of all peaks. Counts representing peak strength for all samples were obtained by counting the number of cut sites that overlapped each peak for each sample.
!Sample_data_processing = Genome_build: GRCh37.p13
!Sample_data_processing = Supplementary_files_format_and_content: Tn5_cut_sites.tsv
!Sample_platform_id = GPL24676
!Sample_contact_name = Nir,,Yosef
!Sample_contact_institute = University of California, Berkeley
!Sample_contact_address = 629 Soda Hall
!Sample_contact_city = Berkeley
!Sample_contact_state = CA
!Sample_contact_zip/postal_code = 94709
!Sample_contact_country = USA
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = other
!Sample_library_source = genomic
