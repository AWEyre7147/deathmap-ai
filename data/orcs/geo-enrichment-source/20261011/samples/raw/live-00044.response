^SAMPLE = GSM5643081
!Sample_title = sgControl_1
!Sample_geo_accession = GSM5643081
!Sample_status = Public on Oct 27 2021
!Sample_submission_date = Oct 20 2021
!Sample_last_update_date = Oct 27 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = OT-I T cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: T cells
!Sample_characteristics_ch1 = strain: C57BL/6
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Cas9-expressing OT-I cells expressing indicated sgRNAs were injected into wild-type mice via tail vein. At 7 days post-activation, Thy1.1+ cells from spleen were sorted using a S3e cell sorter. Total RNA was extracted with RNAprep pure Cell Kit (TIANGEN BIOTECH Cat# DP430) according to manufacturer’s protocol.
!Sample_extract_protocol_ch1 = mRNAs were purified from total RNA using oligo(dT) attached magnetic beads and fragmented into small pieces using fragmentation reagent. cDNAs were generated by reverse transcription and PCR to produce libraries for sequencing.
!Sample_data_processing = Basecalls performed using Zebracall version 1.2.1
!Sample_data_processing = Data were filtered using SOAPnuke v1.5.2 with parameters -l 15 -q 0.5 -n 0.1
!Sample_data_processing = Sequenced reads were aligned to the GCF_000001635.25_GRCm38.p genome using Bowtie2 v2.2.5 with parameters -q --phred64 --sensitive --dpad 0 --gbar 99999999 --mp 1,1 --np 1 --score-min L,0,-0.1 -p 16 -k 200
!Sample_data_processing = Genome_build: GCF_000001635.25_GRCm38.p (NCBI)
!Sample_data_processing = Supplementary_files_format_and_content: Tab-delimited text file include reads and normalized expression for every gene and every sample
!Sample_platform_id = GPL23479
!Sample_contact_name = Hanfei,,Zhao
!Sample_contact_email = zhf17@mails.tsinghua.edu.cn
!Sample_contact_department = School of Medicine
!Sample_contact_institute = Tsinghua University
!Sample_contact_address = Haidian District
!Sample_contact_city = Beijing
!Sample_contact_state = Beijing
!Sample_contact_zip/postal_code = 100084
!Sample_contact_country = China
!Sample_instrument_model = BGISEQ-500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN22443292
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX12709557
!Sample_supplementary_file_1 = NONE
