!Sample_last_update_date = Nov 20 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = CD8+ T-cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: GP33-Tetramer+ CD44+PD-1+ CD8+ T cells isolated from spleens
!Sample_characteristics_ch1 = agent: LCMV Cl13
!Sample_characteristics_ch1 = time point: 28 days post-infection
!Sample_characteristics_ch1 = strain: C57BL/6
!Sample_characteristics_ch1 = isolation of cd8+ t cells: CD8+ MACS negative selection (Miltenyi) followed by FACS
!Sample_treatment_protocol_ch1 = Mice were not treated
!Sample_growth_protocol_ch1 = C57BL/6 mice were infected with 2 x 10^6 pfu LCMV Clone 13 via IV injection. On day 28 after infection, mice were sacrificed and spleens removed for CD8+ T cell isolation
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = CD8+ MACS negative selection was performed on single-cell suspensions of splenocytes from chronically infected mice, followed by FACS. Purifed cells were loaded onto the 10x device (10x Genomics)
!Sample_extract_protocol_ch1 = Library construction was performed as per standard 10x protocol (Manual CG00052 Rev B)
!Sample_extract_protocol_ch1 = 10X single-cell 3' RNA-seq v2
!Sample_data_processing = Sample demultiplexing, barcode processing, alignment, filtering, UMI counting, and aggregation of multiple sequencing runs were performed using the Cell Ranger analysis pipeline (v1.2)
!Sample_data_processing = Data normalization, dimension reduction, and differential expression analysis were performed using the Seurat R package (v2.2.0)
!Sample_data_processing = Single cell signatures scoring was performed using the FastProject software (v1.1.0)
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: matrix.mtx file is count matrix in sparse matrix format; barcodes.tsv is list of barcodes for each sample; genes.tsv is list of genes detected in samples
