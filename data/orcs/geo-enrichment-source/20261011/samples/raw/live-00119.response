^SAMPLE = GSM3375483
!Sample_title = D1_NoStim_10x
!Sample_geo_accession = GSM3375483
!Sample_status = Public on Sep 06 2018
!Sample_submission_date = Sep 05 2018
!Sample_last_update_date = Sep 06 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = CD8+ T cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: CD8+ T cells
!Sample_characteristics_ch1 = agent: none
!Sample_treatment_protocol_ch1 = Two conditions: with TCR stimulus or without.
!Sample_growth_protocol_ch1 = Cells were infected with the library, electroporated with Cas9 protein and Puro selected.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = ChromiumTM Single Cell 3’ v2 Protocol (CG00052)
!Sample_extract_protocol_ch1 = ChromiumTM Single Cell 3’ v2 Protocol (CG00052)
!Sample_description = raw data from Cell Ranger
!Sample_data_processing = Fastq files from 10x library were processed with Cell Ranger 2.0, using default parameters.
!Sample_data_processing = (1) For U6 reamplification sample, Read2 fastq files were match to U6 TGGAAAGGACGAAACACCG using matchPattern (ShortRead R package), (2) Cell BC for matched R2 reads was extracted from R1 files.
!Sample_data_processing = No technical replicates in this dataset. D1 and D2 are two unrelated human donors, which we consider as biological replicates. The ReAmp fastq files are targeted amplicon re-sequencing of the sgRNA transcripts captured in the 10x pipeline. The design for the re-amplification is unchanged from 10x V2:    Read 1 (26bp): Cell Barcode (16bp) - UMI (8bp)  Index read (8bp): i7 index   Read 2 (58bp): 3' end of the captured polyA transcripts, for successful amplicons should start  the U6 sequence TTGTGGAAAGGACGAAACACCG.
!Sample_data_processing = Genome_build: GRCh38
!Sample_data_processing = Supplementary_files_format_and_content: For each sample, tar file contains matrix.mtx, barcodes.tsv and genes.tsv, output from CellRanger 2.0, post QC filter. These have UMI counts for all genes and cell barcodes identified.
!Sample_platform_id = GPL20301
!Sample_contact_name = Eric,,Shifrut
!Sample_contact_laboratory = Alexander Marson
!Sample_contact_institute = University of California, San Franscisco
!Sample_contact_address = 513 Parnassus Ave, HSW 1033
!Sample_contact_city = San Francisco
!Sample_contact_state = CA
!Sample_contact_zip/postal_code = 94143
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
