^SAMPLE = GSM3579849
!Sample_title = CDKN2A wide type bait1
!Sample_geo_accession = GSM3579849
!Sample_status = Public on Dec 17 2019
!Sample_submission_date = Jan 25 2019
!Sample_last_update_date = Dec 17 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = B cell precursor leukemia
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: B cell precursor leukemia
!Sample_characteristics_ch1 = cell line: SEM
!Sample_characteristics_ch1 = group: CDKN2A promoter probe
!Sample_growth_protocol_ch1 = SEM cells were maintained in RPMI-1640 containing 10% fetal bovine serum (FBS) (HyClone), 2 mM glutamine (Sigma), and 1% penicillin/streptomycin (Invitrogen). All cells were maintained at 37°C in a 5% CO2 atmosphere and 95% humidity.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Suspension cells (SEM) cells were collected at 1X107 cells per reaction while adherent cells (IMR90, HCT116 and human iPS) were trypsinized before collection. Cells were fixed and lysed in 15 mL conical tubes before storage in -80°C for up to 1 month before library construction. Cells were thawed on ice and spun down for 5 minutes at 4000rpm, 4°C. The remaining lysis buffer was removed and discarded. The pellets were re-suspended in 1 mL of 1x DpnII buffer and transferred to a 2 mL tube for homogenization with a pestle. The homogenized samples were then centrifuged for 14,000 rpm at 5 mins in 4°C. The supernatant was removed and discarded. After decrosslinking, phenol-chloroform-isoamylalcohol DNA extraction, and sodium acetate precipitation, a small portion of DNA was run on a gel to check for digest and ligation efficiency. Once the 3C library was construction was complete, 5-6ug of the 3C DNA in a total volume of 130ug per covaris tube (microTUBE AFA Fiber Crimp-Cap 6X16mm, catalog). Each 2ug of 3C library generated one Capture.NEBNext Ultra II DNA library kit for Illumina (NEB 7645S) was used for end-repair, adaptor ligation, and PCR enrichment of adaptor ligated DNA. NEBNext Mulitplex Oligos (Dual Index Primers Set 1) was used for indexing for four cycles.The Nimblegen SeqCap EZ Hybridization and Wash Buffer Kit (Roche) was used for subsequent hybridization and wash steps. Constructed library was sequenced on Miseq for paired-end 150bp.
!Sample_extract_protocol_ch1 = NEBNext Ultra II DNA library kit for Illumina (NEB 7645S) was used for end-repair, adaptor ligation, and PCR enrichment of adaptor ligated DNA. NEBNext Mulitplex Oligos (Dual Index Primers Set 1) was used for indexing for four cycles. Agencourt AMPure XP beads were used at 0.8x for all cleanup steps.
!Sample_data_processing = Library strategy: Capture-C
!Sample_data_processing = The paired-end reads were reconstructed into single reads with FLASH1.2.11
!Sample_data_processing = Digested in silico with the DpnII2E.pl script
!Sample_data_processing = aligned to the human genome using Bowtie 1.0.0 (http://bowtie-bio.sourceforge.net/index.shtml).
!Sample_data_processing = Interaction frequencies were determined using CCanalyser2.pl (https://github.com/telenius/captureC/releases).
!Sample_data_processing = Genome_build: hg19, mm9
!Sample_platform_id = GPL15520
!Sample_contact_name = Chunliang,,Li
!Sample_contact_email = Chunliang.Li@STJUDE.ORG
!Sample_contact_institute = St.Jude Children's Research Hospital
!Sample_contact_address = 262 Danny Thomas Place
!Sample_contact_city = Memphis
!Sample_contact_state = TN
!Sample_contact_zip/postal_code = 38105
!Sample_contact_country = USA
!Sample_instrument_model = Illumina MiSeq
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
