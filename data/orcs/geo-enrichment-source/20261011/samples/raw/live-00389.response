^SAMPLE = GSM3752617
!Sample_title = RRBS_D1WT_Rep1
!Sample_geo_accession = GSM3752617
!Sample_status = Public on May 20 2020
!Sample_submission_date = May 06 2019
!Sample_last_update_date = May 20 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = RRBS_D1WT_E8.5 whole embryos
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain background: C57BL/6J
!Sample_characteristics_ch1 = genotype/variation: wild type
!Sample_characteristics_ch1 = developmental stage: E8.5
!Sample_characteristics_ch1 = gender: Male
!Sample_characteristics_ch1 = tissue/cell type: whole embryos
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted with the AllPrep DNA/RNA Mini Kit (Qiagen).
!Sample_extract_protocol_ch1 = RRBS libraries were prepared as described in Auclair et al., Genome Biol 15:545 (2014). Briefly, we digested genomic DNA 5 hours with MspI (ThermoFisher Scientific), followed by end-repair and A-tailing with 5 U Klenow-fragment exo- (ThermoFisher Scientific) and ligation to methylated adapters overnight at 16°C with 30 U T4 DNA ligase (ThermoFisher Scientific) in Tango 1X buffer. Fragments between 150 and 400 bp were excised from a 3% agarose 0.5X TBE gel with the MinElute kit (Qiagen) and bisulfite-converted with the EpiTect Bisulfite kit (Qiagen) using two consecutive rounds of conversion. Final RRBS libraries were amplified with 14-16 cycles of PCR. The libraries were purified using Ampure XP beads (Beckman Coulter).
!Sample_data_processing = Reads were cleaned with Trim Galore v0.4.2 using the parameters --rrbs --paired -r1 30 -r2 30 -q 20 --length 20 --stringency 5 --retain_unpaired. Reads were aligned to the mouse mm10 genome with BSMAP v2.74 using the parameters -v 2 -w 100 -r 1 -x 400 -m 30 -D C-CGG -n 1. Methylation percent values were extracted with methratio.py from BSMAP v2.74 using the parameters -z -u -g. CGs were filtered to have a minimum sequencing depth of 8X using custom developped scripts in R.
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: IGV files containing methylation scores for all CGs with at least 8X sequencing depth.
!Sample_platform_id = GPL21103
!Sample_contact_name = Michael,,Weber
!Sample_contact_department = UMR7242 Biotechnology and Cell Signalling
!Sample_contact_institute = CNRS
!Sample_contact_address = 300 Bd Sebastien Brant
!Sample_contact_city = Illkirch
!Sample_contact_zip/postal_code = 67412
!Sample_contact_country = France
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = Reduced Representation
!Sample_library_source = genomic
!Sample_library_strategy = Bisulfite-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN11580850
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX5795083
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM3752nnn/GSM3752617/suppl/GSM3752617_RRBS_D1WT_Rep1.igv.gz
!Sample_series_id = GSE130735
