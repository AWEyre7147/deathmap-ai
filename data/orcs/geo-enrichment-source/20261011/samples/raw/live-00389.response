!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4558nnn/GSM4558218/suppl/GSM4558218_RRBS_MEF_D1cKO_d5_Tam_Rep3.igv.gz
!Sample_series_id = GSE130735
