!Sample_status = Public on Jan 19 2021
!Sample_submission_date = Jan 18 2021
!Sample_last_update_date = Jan 19 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Calu-3
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = antibody: IgG
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = CUT&RUN was performed with 1 million Calu-3 cells. Cells were removed from the plate by treatment with Versene (Life Technologies 15040066) for 20 minutes and resuspended in fresh media. They were spun down and washed twice with DPBS before proceeding with the CUTANA CUT&RUN kit (Epicypher 14-0050)
!Sample_extract_protocol_ch1 = The experiment was performed with the included IgG and H3K4Me control antibodies and the BRD2 antibody (abcam 197865) as well as E.coli spike-in DNA according to the kit protocol.
!Sample_description = CUT & RUN
!Sample_data_processing = Library strategy: CUT & RUN
!Sample_data_processing = Paired-end reads were mapped to the human genome GRCh38 using Bowtie2 (v2.3.4.1) with options: --end-to-end --very-sensitive --no-unal --no-mixed --no-discordant --phred33 -I 10 -X 1000.
!Sample_data_processing = Sparse Enrichment Analysis for CUT&RUN (SEACR, https://seacr.fredhutch.org/) was used for peak calling
!Sample_data_processing = Genome_build: GRCh38
!Sample_data_processing = Supplementary_files_format_and_content: Peaks calling data files are in bed format. Raw singal files are in bedgraph format
!Sample_platform_id = GPL20301
