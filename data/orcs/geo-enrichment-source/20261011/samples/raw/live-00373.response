!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Blood
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Blood
!Sample_characteristics_ch1 = genotype: RASA2KO
!Sample_characteristics_ch1 = cell type: T cells
!Sample_characteristics_ch1 = subject id: Donor1
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = T cells were subjected to the repeated stimulation assay in 24-well plates, transferring T cells to freshly seeded cancer cells every 48 hours. Cultured T cells were sorted after each stimulation using BD FACSAria Fusion to obtain a pure population of NY-ESO-1 multimer positive cells T cells from the co-cultures with target cancer cells, and resuspended in TRI Reagent (Sigma, Cat.# T9424). Total RNA was extracted using Direct-zol RNA MicroPrep kit (Zymo research, Cat.# R2061)
!Sample_extract_protocol_ch1 = For paired-end samples, RNA-seq libraries were prepared by Oligo dT enrichment followed by a stranded Illumina library prep protocol with the KAPA mRNA HyperPrep kit (Kapa Biosystems, KK8580). Libraries were checked for quality on an AATI Fragment analyzer (Agilent, DNF-935–1000), quantified using the Illumina Quant Universal qPCR Mix (Kapa Biosystems, KK4824), and pooled evenly at 3nM. For single read samples (RASA2KO and CTRL Stim5), batch-Tag-seq protocol was used (PMID 27037501).
!Sample_description = RASA2KO_Stim1_countmatrix.tsv
!Sample_data_processing = To analyze the gene expression, reads were mapped to the human reference transcriptome (GRCh38 Ensembl release 96) using Kallisto v0.46.1 with default parameters. Genes with zero counts in more than 80% of the samples were filtered out.
!Sample_data_processing = Assembly: GRCh38 Ensembl release 96
!Sample_data_processing = Supplementary files format and content: Count matrix file with named columns as listed in "description" field.
