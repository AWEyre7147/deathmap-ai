^SAMPLE = GSM4987758
!Sample_title = THP-1 sgINTS6 CDK9i 6 hours replicate 2
!Sample_geo_accession = GSM4987758
!Sample_status = Public on May 23 2021
!Sample_submission_date = Dec 24 2020
!Sample_last_update_date = May 23 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Acute myeloid leukemia cell line expressing Cas9 and INTS6 targeting sgRNA
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: THP-1 cell line
!Sample_characteristics_ch1 = genotype: expressing Cas9 and INTS6 targeting sgRNA
!Sample_characteristics_ch1 = treatment: CDK9i (AZ5576) 170nM for 6 hours, 500µM 4-thiouridine for final 30 minutes
!Sample_characteristics_ch1 = spike-in: Drosophila melanogaster spike-in
!Sample_treatment_protocol_ch1 = THP-1 cells were treated with DMSO for 6 hours (untreated control; CDK9i 0 hours) or CDK9i (AZ5576) 170nM for 2 hours and 6 hours; cells were labelled with 4-thiouridine during the final 30 minutes of CDK9i treatment. S2 cells were labelled with 4-thiouridine for 30 minutes.
!Sample_growth_protocol_ch1 = THP-1 cells were cultured in RPMI-1640 supplemented with 10-20 percent heat-inactivated fetal bovine serum, 100U/mL penicillin, 100µg/mL streptomycin and 2mM GlutaMAX at 37 degrees celciuus and 5 percent carbon dioxide. S2 cells were cultured in Schneider's Drosophila medium supplemented with 10 percent heat-inactivated fetal bovine serum, 100U/mL penicillin, 100µg/mL streptomycin and 2mM GlutaMAX at room temperature and atmospheric carbon dioxide
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was isolated by phenol-chloroform extraction and isopropanol precipitation. 4-thiouridine labelled RNA was isolated from total RNA of THP-1 (human) and S2 (Drosophila; 5 percent) cells following biotinylation with EZ-Link HPDP Biotin (ThermoFisher Scientific) and strepavidin µMACs enrichment (Miltenyi). Biotin-enriched 4-thiouridine labelled nascent RNA was isolated using the Qiagen RNAeasy MinElute kit.
!Sample_extract_protocol_ch1 = RNA libraries were prepared using the NEBNext Ultra II Directional RNA Library Prep kit for Illumina (NEB E7760S)
!Sample_description = 5-T6-2
!Sample_description = featureCounts_output_hg19-dm3.txt
!Sample_description = 201202_4sUseq_SpikeIn_normalisedCounts.csv
!Sample_data_processing = library strategy: 4sU-seq
!Sample_data_processing = Sequenced reads were demultiplexed using bcl2fastq (v2.17.1.14)
!Sample_data_processing = Basic QC performed on fastq files using FASTQC (v0.11.6)
!Sample_data_processing = Fastq files were aligned to a combined Hg19/dm3 genome performed with Bowtie2 (v2.3.4.1) to generate SAM filles
!Sample_data_processing = SAM files converted to BAM files using Samtools (v1.9) using view command. BAM files were sorted and indexed
!Sample_data_processing = For normalization of hg19 reads to Drosophila spike-in, reads mapping to Hg19 and dm3 genomes were calculated using Subread (v2.0.0) featureCounts function. A scale factor was determined by calculating the proportion of reads mapping to the dm3 genome relative to the combined Hg19/dm3 genome
!Sample_data_processing = bigWig files were generated from sorted, indexd BAM files using the Deeptools (v3.0.0) BamCoverage function (--normalize using CPM, --smoothLength 150 --binSize 50 -e 200) using the appropriate scaleFactor
!Sample_data_processing = Scaled bigWig files were visualized in IGV and analyzed using the Deeptools (v3.0.0) bigwigCompare function
!Sample_data_processing = Data was visualized in Rstudio using ggplot2 (v3.3.1), ggrepel (v3.3.1) and ggfortify (v0.4.10)
!Sample_data_processing = Genome_build: Hg19 / dm3
