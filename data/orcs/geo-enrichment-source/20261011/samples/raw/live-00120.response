^SAMPLE = GSM3436755
!Sample_title = RRBS_sgDnmt1_D0_Rep1
!Sample_geo_accession = GSM3436755
!Sample_status = Public on Apr 12 2019
!Sample_submission_date = Oct 18 2018
!Sample_last_update_date = Apr 14 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = RRBS_sgDnmt1_D0
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: 129/Ola
!Sample_characteristics_ch1 = cell line: ES-E14TG2a
!Sample_characteristics_ch1 = cell type: embryonic stem cell
!Sample_characteristics_ch1 = dux induction: No
!Sample_treatment_protocol_ch1 = Doxycycline is added to induce Dux transgene. CRISPR knockdown is performed as described in "Shalem O*, Sanjana NE*, Hartenian E, Shi X, Scott DA, Mikkelsen T, Heckl D, Ebert BL, Root DE,Doench JG, Zhang F (2014). Science, 343, 83-7. DOI: 10.1126/science.1247005".
!Sample_growth_protocol_ch1 = ES-E14TG2a cells were cultured with medium consisted of DMEM (Gibco, Cat. # 11995) with 15% FBS (Sigma, Cat. #F6178), 1000 U/ml mouse leukemia inhibitory factor (Millipore, Cat. #ESG1107), 0.1 mM non-essential amino acids (Gibco, Cat. # 11140), 0.1mM β-mercaptoethanol (Gibco, Cat. # 21986023), 1 mM Glutamine-max (Gibco, Cat. # 25030), 1 mM sodium pyruvate (Gibco, Cat. # 11360)) and penicillin/streptomycin (100 U/ml) (Gibco, Cat, #15140).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Cellular RNA and DNA was harvested using Qiagen Allprep RNA/DNA mini kit (Qiagen, Cat 80204).
!Sample_extract_protocol_ch1 = The bulk RNA-seq library was prepared using NEBNext® Ultra™ Directional RNA Library Prep Kit for Illumina (NEB, Cat E7420S). Drop-seq was performed as described in "Chen, R., Wu, X., Jiang, L. & Zhang, Y. Single-Cell RNA-Seq Reveals Hypothalamic Cell Diversity. Cell Rep 18, 3227-3241 (2017)." RRBS: DNA (1 ng) with 0.5% nonmethylated λ DNA spike-in was digested by MspI for 3.5 hours. DNA was then end-repaired, dA-tailed, and ligated with methylated adaptors. Bisulfite conversion was carried out using an EpiTect fast bisulfite conversion kit (Qiagen) according to the manufacturer’s instructions. Bisulfite-converted DNA was then amplified with five PCR cycles to obtain the final library.
!Sample_data_processing = DNA (1 ng) with 0.5% nonmethylated λ DNA spike-in was digested by MspI for 3.5 hours. DNA was then end-repaired, dA-tailed, and ligated with methylated adaptors. Bisulfite conversion was carried out using an EpiTect fast bisulfite conversion kit (Qiagen) according to the manufacturer’s instructions. Bisulfite-converted DNA was then amplified with five PCR cycles to obtain the final library. The RRBS libraries were subjected to pair-end (2 × 110 bp) sequencing on a HiSeq 2500 (Illumina). Raw reads were first trimmed using TrimGalor with paramters “--three_prime_clip_R1 2 --length 35” then mapped the mm10 genome using Bismark and bowtie2. Reads mapping to the positive and negative strand were extracted separately using samtools then the methylation levels were estimated using bismark_methylation_extractor. CpG sites overlapping with known SNPs were removed and sites with at least 5x coverage were used for the down-stream analysis. Promoters were defined as TSS ± 1kb and only promoters harboring at least 3CpG sites were considered.
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: bed
!Sample_platform_id = GPL17021
!Sample_contact_name = Mohamed Nadhir,,Djekidel
!Sample_contact_email = djek.nad@gmail.com
