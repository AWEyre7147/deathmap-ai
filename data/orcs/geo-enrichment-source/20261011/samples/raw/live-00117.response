^SAMPLE = GSM3967106
!Sample_title = T-ALL1 (RNA-seq)
!Sample_geo_accession = GSM3967106
!Sample_status = Public on Aug 04 2019
!Sample_submission_date = Jul 24 2019
!Sample_last_update_date = Nov 01 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Peripheral blood primary T-ALL cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Peripheral blood
!Sample_characteristics_ch1 = cell type: primary T-ALL cells
!Sample_characteristics_ch1 = disease state: T cell acute lymphoblastic leukemia
!Sample_treatment_protocol_ch1 = N/A
!Sample_growth_protocol_ch1 = Primary T-ALL cells isolated from the peripheral blood of T-ALL patients were xenogroafted in immunocompromised NOD SCID gamma mice (NSG) . Following xenograft and when the tumor bueden in pheripheral blood reached 80% the mice were the spleen was harvested and splenocytes were used for the RNA-Seq analysis.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was extracted using the RNeasy Mini Kit using Qiagen kit (Catalog no: 74106) folllowing manufacturer's guidelines.
!Sample_extract_protocol_ch1 = The libraries were prepared using NEXTflex Rapid Directional RNA-Seq Kit from Bioo Scientific (Catalog no: 5138-07) folllowing manufacturer's guidelines.
!Sample_data_processing = Read alignment: STAR aligner version 2.5.0c was used to map reads against the reference genome hg19. Only uniquely mapping reads were kept (specific parameters: --trim5p=13, --outFilterMultimapNmax 1, --outFilterMismatchNoverLmax 0.05)
!Sample_data_processing = Deduplication: Duplicated reads were excluded using picard-tools version 2.6.0.
!Sample_data_processing = Read counting: Reads were counted on a stranded gene-basis within annotated exons downloaded from Ensembl Genes V75 using the ngsutils tool bamutils count (special paramters: -uniq, -multiple complete, -library RF).
!Sample_data_processing = Normalization: edgeR version 3.14.0 was used to normalize read counts per sample and genes were filtered for counts-per-million > 1. CDS length from Ensembl Genes V75 was used to calculate FPKM values for filtered genes.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: FPKM table
!Sample_platform_id = GPL16791
!Sample_contact_name = Andreas,,Kloetgen
!Sample_contact_department = Department for Computational Biology of Infection Research
!Sample_contact_institute = Helmholtz Centre for Infection Research
!Sample_contact_address = Inhoffenstr 7
!Sample_contact_city = Braunschweig
!Sample_contact_state = NI
!Sample_contact_zip/postal_code = 38124
!Sample_contact_country = Germany
