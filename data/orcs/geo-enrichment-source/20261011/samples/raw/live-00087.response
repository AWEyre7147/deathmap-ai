!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Embryonic stem cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: E14tg2a
!Sample_characteristics_ch1 = knockdown: siControl
!Sample_characteristics_ch1 = gfp status: n/a
!Sample_treatment_protocol_ch1 = ESCs and 2CLCs were sorted by FACS Aria according to the GFP signal 48h after transfection of siRNA.
!Sample_growth_protocol_ch1 = Mouse E14 ES cell lines were cultured in DMEM with GlutaMAX (Invitrogen) containing 15% FCS, LIF, penicillin/streptomycin, 0.1 mM 2-mercaptoethanol, 3 mM CHIR99021 (a GSK3b inhibitor) and 1 mM PD0325901 (a MEK inhibitor) on the gelatin-coated plate
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted with PicoPure RNA Isolation Kit, treated with DNase and the quality was checked by the bioanalyzer..
!Sample_extract_protocol_ch1 = Libraries were prepared with Truseq Stranded Total RNA with Ribo-Zero Gold Prep kit (Illumina).
!Sample_data_processing = Illumina Casava1.7 software used for basecalling.
!Sample_data_processing = Sequenced reads were trimmed for adaptor sequence, and masked for low-complexity or low-quality sequence, then mapped to reference genome mm9 using STAR
!Sample_data_processing = Transcript abundance was calculated using Htseq
!Sample_data_processing = Genome_build: mm9
