^SAMPLE = GSM612814
!Sample_title = S1_2yrs_F_GC
!Sample_geo_accession = GSM612814
!Sample_status = Public on Aug 13 2013
!Sample_submission_date = Oct 25 2010
!Sample_last_update_date = Aug 13 2013
!Sample_type = genomic
!Sample_channel_count = 2
!Sample_source_name_ch1 = MIRA-enriched DNA
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = sample type: methylated DNA fraction
!Sample_characteristics_ch1 = subject: 1
!Sample_characteristics_ch1 = age: 2
!Sample_characteristics_ch1 = gender: F
!Sample_characteristics_ch1 = cell type: tonsils
!Sample_characteristics_ch1 = cell type: GC
!Sample_treatment_protocol_ch1 = FACS purified
!Sample_growth_protocol_ch1 = isolated ex vivo from tonsil
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was purified using Allprep DNA/RNA/protein columns (Qiagen).  Purified genomic DNA was sonicated using a Bioruptor (Diagenode) to generate 200-500 bp fragments.  Methylated CpG DNA fragments were enriched from 200 ng of sonicated DNA using the MethylCollector Ultra Kit (Actif Motif) following the manufacturer’s protocol.  20 ng of input and enriched DNA fractions were amplified twice with WGA2 (Sigma).
!Sample_label_ch1 = cy5
!Sample_label_protocol_ch1 = Amplified input and methylated CpG DNA fragments labeled with Cy3 and Cy5 random nonomers (Trilink Biotechnologies) following NimbleGen’s protocol.
!Sample_source_name_ch2 = Input DNA
!Sample_organism_ch2 = Homo sapiens
!Sample_taxid_ch2 = 9606
!Sample_characteristics_ch2 = sample type: input DNA
!Sample_characteristics_ch2 = subject: 1
!Sample_characteristics_ch2 = age: 2
!Sample_characteristics_ch2 = gender: F
!Sample_characteristics_ch2 = cell type: GC
!Sample_treatment_protocol_ch2 = FACS purified
!Sample_growth_protocol_ch2 = isolated ex vivo from tonsil
!Sample_molecule_ch2 = genomic DNA
!Sample_extract_protocol_ch2 = Genomic DNA was purified using Allprep DNA/RNA/protein columns (Qiagen).  Purified genomic DNA was sonicated using a Bioruptor (Diagenode) to generate 200-500 bp fragments.  Methylated CpG DNA fragments were enriched from 200 ng of sonicated DNA using the MethylCollector Ultra Kit (Actif Motif) following the manufacturer’s protocol.  20 ng of input and enriched DNA fractions were amplified twice with WGA2 (Sigma).
!Sample_label_ch2 = cy3
!Sample_label_protocol_ch2 = Amplified input and methylated CpG DNA fragments labeled with Cy3 and Cy5 random nonomers (Trilink Biotechnologies) following NimbleGen’s protocol.
!Sample_hyb_protocol = Samples were hybridized onto a NimbleGen 2.1M Deluxe Human Promoter Array following NimbleGen’s protocol.
!Sample_scan_protocol = The microarray slides were scanned using the Agilent G2565BA DNA Microarray Scanner.  Images were processed using the NimbleScan software.
!Sample_description = This is GC MIRA-chip sample from subject 1
!Sample_data_processing = The log2(Cy5) values were normalized using Lowess curve fitting conditioning on GC content as described in BMC Bioinformatics 2009, 10:173. These signal values were further quantile normalized to adjust for between sample variations.
!Sample_data_processing = DETAILS: The GC Lowess method utilizes both 'log2(Cy3)' and 'log2(Cy5)' values as following:
!Sample_data_processing = * Classify probes into bins according to CG content (proportion of number of C and G nucleotides in probe sequence)
!Sample_data_processing = * For each CG content bin (k), we fit lowess regression to predict log2(Cy5)_k value using log2(Cy3)_k value
!Sample_data_processing = * Compute normalized value  = sigma_bar *(observed log2(Cy5)_k - predicted log2(Cy5)_k)/sigma_k, where sigma_k is mean absolute deviation of (observed log2(Cy5)_k - predicted log2(Cy5)_k) and sigma_bar is geometric mean of all sigma_k's.
!Sample_data_processing = This normalization corrects for both dye bias and CG bias simultaneously.
!Sample_platform_id = GPL10671
!Sample_contact_name = Deepak,,Mav
!Sample_contact_institute = Sciome LLC
!Sample_contact_address = 2 Davis Drive
!Sample_contact_city = Research Triangle Park
!Sample_contact_state = NC
!Sample_contact_zip/postal_code = 27709
!Sample_contact_country = USA
!Sample_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM612nnn/GSM612814/suppl/GSM612814_S1_GC_532.pair.gz
!Sample_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM612nnn/GSM612814/suppl/GSM612814_S1_GC_635.pair.gz
!Sample_series_id = GSE24918
!Sample_series_id = GSE24919
!Sample_data_row_count = 2173622
