!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN31437518
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX18012695
