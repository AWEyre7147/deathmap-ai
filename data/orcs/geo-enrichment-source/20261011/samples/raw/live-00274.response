!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN04421054
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX1534371
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM2041nnn/GSM2041507/suppl/GSM2041507_E12MK1.bismark.cov.txt.gz
!Sample_series_id = GSE76962
!Sample_series_id = GSE76973
