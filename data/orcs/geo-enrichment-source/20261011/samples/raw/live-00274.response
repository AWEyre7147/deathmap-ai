^SAMPLE = GSM2041508
!Sample_title = E12.5 male Tet1-KO PGC RRBS Replicate 2
!Sample_geo_accession = GSM2041508
!Sample_status = Public on Mar 07 2018
!Sample_submission_date = Jan 19 2016
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = E12.5 male Tet1-KO PGC
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = genetic background: Tet1-het GOF18∆PE-EGFP x Tet1-het GOF18∆PE-EGFP
!Sample_characteristics_ch1 = genotype: Tet1-KO
!Sample_characteristics_ch1 = age: E12.5
!Sample_characteristics_ch1 = gender: male
!Sample_characteristics_ch1 = cell type: PGC
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Total DNA from FACS-sorted PGCs isolated from individual Tet1-KO or wild type embryos was isolated using ZR-Duet DNA-RNA MiniPrep kit (Zymo), and DNA from between two to six embryos (equivalent to 1,000 to 8,000 cells) of the same genotype, stage and sex was pooled and concentrated to 26 µL final volume using the Savant SpeedVac Concentrator (Thermo) and following the manufacturer’s instructions.
!Sample_extract_protocol_ch1 = Genomic DNA was digested by 20 units of MspI enzyme (NEB) in NEB buffer 2 at 37°C for 3 hrs, and digested DNA was purified using AMPure XP beads (Beckman-Coulter). Libraries were made following the NEBNext Ultra DNA Library Prep protocol, with the following modifications: 1)  methylated adaptors were diluted 1:10 in nuclease free H2O to a final concentration of 1.5 µM; 2) following adaptor ligation, bisulphite conversion was carried out using the Imprint Modification Kit (Sigma), and following the two step protocol according to the manufacturer’s specifications; and 3) PCR enrichment was carried out for 18 cycles using the KAPA Uracil+ DNA polymerase master mix (KAPA Biosystems) and the NEBNext Library Prep universal and index primers (NEB). The libraries were purified by AMPure XP beads (Beckman-Coulter). Pooled libraries were sequenced on the Illumina HiSeq 2000 instrument.
!Sample_description = MspI-digested reduced representation bisulphite sequencing of primordial germ cells
!Sample_data_processing = Raw RRBS reads were first trimmed using Trim Galore (version 0.3.1, http://www.bioinformatics.babraham.ac.uk/projects/trim_galore/) with --rrbs parameter. Alignments were carried out to the mouse genome (mm9, NCBI build 37) with Bismark (version 0.13.0) with the -n 1 parameter. CpG methylation calls were extracted from the mapping output using the Bismark methylation extractor (version 0.13.0) with the –s --comprehensive --merge_non_CpG parameters. The number of methylated and unmethylated cytosines in a CpG context was extracted using bismark2bedGraph (default parameters).
!Sample_data_processing = Genome_build: mm9
!Sample_data_processing = Supplementary_files_format_and_content: Bismark cov file.  Columns: <chromosome>  <start position>  <end position>  <methylation percentage>  <count methylated> <count unmethylated>
!Sample_platform_id = GPL17021
