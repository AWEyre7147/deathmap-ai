^SAMPLE = GSM7165836
!Sample_title = hSIO - WT [scRNA-seq]
!Sample_geo_accession = GSM7165836
!Sample_status = Public on Oct 26 2023
!Sample_submission_date = Apr 13 2023
!Sample_last_update_date = Oct 26 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = human small intenstinal organoids
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: human small intenstinal organoids
!Sample_characteristics_ch1 = genotype: MUC2-mNeonGreen; DEFA5-IRES-dsRed; CHGA-IRES-iRFP670
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Organoids were removed from theCultrexBasement Membrane Extract (BME, Growth Factor Reduced, Type 2, R&D Systems), digested withTryplE(Thermo Fisher) for 10~15 mins into single cells, washed with ice-coldAdDMEM/F12 (GIBCO) and filtered into FACS tubes through cell strainer (Falcon) with Rho kinase inhibitor Y-27632 dihydrochloride (10 µM,AbmoleBioscience). Cells were co-stained with DAPI (Sigma) and DRAQ5 (Biostatus) and subjected for FACS sorting of live cells. FACS was performed on BD Influx™ cell sorter (BD Bioscience). 4,000 live cells per condition were subjected to droplet-based scRNA-seq using the 10x Genomics platform.
!Sample_extract_protocol_ch1 = Libraries were prepared using the 10x Genomics Chromium 3’ Gene Expression solution v3.1
!Sample_description = 10x Genomics
!Sample_description = LX197
!Sample_data_processing = Illumina output demultiplexed (bcl files) converted to fastq files using mkfastq (CellRanger v7.0.1)
!Sample_data_processing = Alignment, filtering, barcode and UMI counting done using cellranger count (CellRanger v7.0.1)
!Sample_data_processing = Assembly: Genome Reference Consortium Human Build 38 + transgene constructs (MUC2-mNeonGreen; DEFA5-IRES-dsRed; CHGA-IRES-iRFP670)
!Sample_data_processing = Supplementary files format and content: Per sample filtered_feature_bc_matrix output from CellRanger (v7.0.1); includes gene-barcode matrices, genes, barcodes
!Sample_platform_id = GPL24676
!Sample_contact_name = Jeff,,DeMartino
!Sample_contact_institute = Princess Maxima Center
!Sample_contact_address = Heidelberglaan 25
!Sample_contact_city = Utrecht
!Sample_contact_zip/postal_code = 3584 CS
!Sample_contact_country = Netherlands
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic single cell
!Sample_library_strategy = RNA-Seq
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX19950538
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN34164101
