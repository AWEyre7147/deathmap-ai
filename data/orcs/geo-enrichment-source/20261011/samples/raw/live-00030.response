^SAMPLE = GSM3671080
!Sample_title = CRISPR-Cas9 screening experiment1 WT
!Sample_geo_accession = GSM3671080
!Sample_status = Public on Apr 12 2019
!Sample_submission_date = Mar 14 2019
!Sample_last_update_date = Apr 12 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = ES-E14TG2a
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: 129/Ola
!Sample_characteristics_ch1 = cell line: ES-E14TG2a
!Sample_characteristics_ch1 = cell type: embryonic stem cell
!Sample_characteristics_ch1 = dux induction: Yes
!Sample_characteristics_ch1 = cell population: 2C-
!Sample_treatment_protocol_ch1 = CRISPR knockdown is performed as described in "Shalem O*, Sanjana NE*, Hartenian E, Shi X, Scott DA, Mikkelsen T, Heckl D, Ebert BL, Root DE, Doench JG, Zhang F (2014). Science, 343, 83-7. DOI: 10.1126/science.1247005".
!Sample_growth_protocol_ch1 = ES-E14TG2a cells were cultured with medium consisted of DMEM (Gibco, Cat. # 11995) with 15% FBS (Sigma, Cat. #F6178), 1000 U/ml mouse leukemia inhibitory factor (Millipore, Cat. #ESG1107), 0.1 mM non-essential amino acids (Gibco, Cat. # 11140), 0.1mM β-mercaptoethanol (Gibco, Cat. # 21986023), 1 mM Glutamine-max (Gibco, Cat. # 25030), 1 mM sodium pyruvate (Gibco, Cat. # 11360)) and penicillin/streptomycin (100 U/ml) (Gibco, Cat, #15140).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA of 2C-positive and negative cells were extracted through Qiagen DNeasy Blood & Tissue Kit (Cat. No. 69504).
!Sample_extract_protocol_ch1 = Around 1 million 2C-positive cells and 10 million 2C-negative cells were collected through FACS based on tdTomato reporter expression. Genomic DNA of 2C-positive and negative cells were extracted through Qiagen DNeasy Blood & Tissue Kit (Cat. No. 69504). gRNA sequences were then amplified using P5 primer (AATGATACGGCGACCACCGAGATCTACACTCTTT CCCTACACGACGCTCTTCCGATCTTTGTGGAAAGGACGAAACACCG) and P7 primer (5’CAAGCAGAAGACGGCATACGAGATNNNNNNNNGTGACTGGAGTTCAGACGTGTGCTCTTCCGATCTCCAATTCCCACTCCTTTCAAGACCT; NNNNNNNN refers to 8bp index) through KAPA HiFi HotStart ReadyMix (Cat. No. KK2602). For each sample, 4 parallel PCR reactions were set up, and mixed products from 4 reactions were then purified through AMPure XP reagents (1.0x) and sequenced by an Illumina HiSeq 2500 Sequencer. Two screen replicates (independent Dux induction and FACS isolation) were performed.
!Sample_description = CRISPR-Cas9
!Sample_description = processed data file: Screen1.count.txt.gz
!Sample_description = processed data file: Screen1.gene_summary.txt.gz
!Sample_data_processing = Library strategy: CRISPR-Cas9 screen
!Sample_data_processing = The sequencing results were analyzed by MAGeCK package, which took into consideration of the magnitude of enrichment/depletion and the consistency of multiple sgRNAs targeting the same gene, to rank positive/negative regulators.
!Sample_data_processing = The generation of the processed data was done using the following command (Screen1 as example):
!Sample_data_processing = mageck count -l gRNA_lib_for_mageck.txt -n Screen1 --sample-label WT,2C --fastq Screen1_WT.fastq Screen1_2C.fastq --trim-5 22 --norm-method median
!Sample_data_processing = mageck test -k Screen1.count.txt -t 2C -c WT -n Screen1 --norm-method median
!Sample_data_processing = Genome_build: mm10 (GRCm38)
!Sample_data_processing = Supplementary_files_format_and_content: *.count.txt: Tab-delimited text files.
!Sample_data_processing = Supplementary_files_format_and_content: *.gene_summary.txt: Tab-delimited text files.
!Sample_platform_id = GPL17021
!Sample_contact_name = Mohamed Nadhir,,Djekidel
!Sample_contact_email = djek.nad@gmail.com
!Sample_contact_laboratory = Maternal and Child Health Division
!Sample_contact_department = Translational Medicine Department
!Sample_contact_institute = Sidra Medicine
!Sample_contact_address = Gharafa
!Sample_contact_city = Doha
!Sample_contact_state = Doha
!Sample_contact_zip/postal_code = 26999
!Sample_contact_country = Qatar
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN11127112
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX5522014
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE121459
!Sample_series_id = GSE128307
!Sample_data_row_count = 0
