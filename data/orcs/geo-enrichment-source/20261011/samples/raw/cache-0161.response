^SAMPLE = GSM1873347
!Sample_title = RNAseq: si-Ctrl rep1
!Sample_geo_accession = GSM1873347
!Sample_status = Public on Sep 28 2017
!Sample_submission_date = Sep 09 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Prostate cancer cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: LNCaP
!Sample_treatment_protocol_ch1 = LNCaP cells were transfected with 20 nM siRNA oligos of si-Ctrl, si-HNRNPL, si-LARP, respectively using RNAiMax reagent (Life Technology).
!Sample_growth_protocol_ch1 = LNCaP cells were cultured in RPMI 1640 medium supplemented with 10% fetal bovine serum (FBS).
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = RNA was isolated using the RNeasy Mini Kit (Qiagen).
!Sample_extract_protocol_ch1 = RNA-seq libraries were constructed with TruSeq Stranded mRNA Library Prep Kit from Illumina according to the manufacturer’s manual.
!Sample_data_processing = Illumina Casava1.7 software used for basecalling.
!Sample_data_processing = The RNA-seq reads were aligned against the hg19 human reference genome with the UCSC known gene transcript annotation using TopHat v2.0.9. The RNA-seq read count of each gene was calculated using HTSeq-0.5.4p3 and differential gene expression analysis was performed using DESeq v1.9.12 (FDR≤0.05, fold change≥1.5). The differential alternative splicing analysis was performed using rMATS (Shen et al., 2014), a computational tool that allows for the analysis of replicate RNA-seq data.
!Sample_data_processing = Genome_build: hg19
!Sample_platform_id = GPL11154
