^SAMPLE = GSM5701078
!Sample_title = OVISE_D0_rep1
!Sample_geo_accession = GSM5701078
!Sample_status = Public on Jun 08 2022
!Sample_submission_date = Nov 23 2021
!Sample_last_update_date = Jun 08 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = OVISE_D0
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: OVISE
!Sample_characteristics_ch1 = sgrna library: TKOv3 library
!Sample_characteristics_ch1 = time: D0
!Sample_characteristics_ch1 = cell type: ovarian cancer cell
!Sample_treatment_protocol_ch1 = Pooled lentiviral libraries were transduced at the multiplicity of infection (MOI) 0.3 followed by selection with puromycin for 2 days. After selection, a sample of 2 x 10^7 cells was pelleted and frozen under liquid nitrogen as a Day 0 sample (file names are labeled with 'D0'). Cells were then passaged until they had undergone 8 doublings. To maintain sufficient sgRNA coverage, the total number of cells was maintained above 2 x 10^7 for the duration of the culture period. Cells cultured for 8 cell doublings from Day 0  were taken as a final time point sample (file names are labeled with 'Final').
!Sample_growth_protocol_ch1 = Human ovarian cancer OVISE and JHOC5 cells were cultured in DMEM and RPMI1640 medium supplemented with 10% fetal bovine serum (FBS), respectively. TOV21G cells were cultured in a 1:1 mixture of MCDB 105 medium and Medium 109 supplemented with 15% FBS. ES2 cells were grown in McCoy 5A supplemented with 10% FBS. All cell lines were cultured at 37°C under a 5% CO2 atmosphere.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted using a QIAGEN Blood and Cell Culture DNA Midi Kit (#13343) according to the manufacturer’s protocol.
!Sample_extract_protocol_ch1 = 125 μg of genomic DNA from each sample was split into 2.5 μg fractions and sgRNA sequences were amplified using Herculase II enzyme following published protocols and instructions supplied by authors on Addgene #90294 (Hart T et al., G3 (Bethesda) 2017. 7(8): 2719-2727). Reactions were measured for fragment size using the Agilent 2200 Tapestation, and quantified using the KAPA SYBR Fast qPCR Kit (KAPA Biosystems, #7959362001).
!Sample_description = sgRNA fragment library
!Sample_data_processing = FASTQ files were trimmed by "cutadapt -g TTGTGGAAAGGACGAAACACCG -O 24 -m 20 --trimmed-only -e 0.1 (Version 2.1)"
!Sample_data_processing = Reads for each sgRNA were counted by "mageck count --list-seq tkov3_guide_sequence.csv (Version 0.5.6)"
!Sample_data_processing = Genome_build: Human CRISPR Knockout Pooled Library (Toronto KnockOut (TKO) CRISPR Library -Version 3, TKOv3). A list of TKOv3 sgRNA sequences is deposited in Addgene #90294.
!Sample_data_processing = Supplementary_files_format_and_content: tab-delimited text file includes read counts per sgRNA for each target across all samples, together with the targeted gene name and sgRNA ID.
!Sample_platform_id = GPL16791
!Sample_contact_name = Tomoatsu,,Hayashi
!Sample_contact_email = hiroton-h@iqb.u-tokyo.ac.jp
!Sample_contact_phone = 81-3-58417835
!Sample_contact_institute = The University of Tokyo
!Sample_contact_address = 1-1-1
!Sample_contact_city = Yayoi, Bunkyo-ku
!Sample_contact_state = Tokyo
!Sample_contact_zip/postal_code = 113-0032
!Sample_contact_country = Japan
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN23407590
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX13207298
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE189405
!Sample_data_row_count = 0
