^SAMPLE = GSM4308132
!Sample_title = ARID1A_0min_cutnrun
!Sample_geo_accession = GSM4308132
!Sample_status = Public on Feb 25 2020
!Sample_submission_date = Feb 12 2020
!Sample_last_update_date = Feb 26 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Human Intestinal Organoids
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: organoids
!Sample_characteristics_ch1 = tissue: Human small intestine
!Sample_characteristics_ch1 = genotype: APC-KO, ARID1A-KO
!Sample_treatment_protocol_ch1 = For TGF-pathway activation, organoids were cultured without A83-01 and in 10 ng/ml recombinant TGFB1
!Sample_growth_protocol_ch1 = Culture medium of Human Intestinal Organoids contained Advanced DMEM/F12 supplemented with 10 mM HEPES, 1x Glutamax, 1% Penicillin/Streptomycin, 1x N2, 1x B27, 1.25 mM N-acetylcysteine, 50% WNT3A-conditioned medium (CM), 20% RSPO1-CM 20%, 10% NOGGIN-CM (all CM produced in-house), 10 mM Nicotinamide, 50 ng/ml human EGF, 10 nM Gastrin, 0.5 µM TGFß type I receptor inhibitor A83-01 and 10 µM p38-inhibitor SB202190
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = MNAse digest
!Sample_extract_protocol_ch1 = 200.000 single cells were harvested from human small intestinal organoids. After two washes, cells were bound to 10 µl of Concanavalin A-coated beads (Bangs Laboratories, cat. no. BP531), diluted in 1ml of binding buffer and rotated 10 min at RT. Cells were cleared on a magnetic rack and beads were resuspended in 50 µl antibody solution. The antibody anti-SMAD3 (1:50, abcam28379; RRID: AB_2192903) was used, and incubated on a rotator overnight at 4˚C. Beads were cleared on a magnetic rack and washed in digitonin buffer before resuspension in 50 µl of digitonin buffer with 700 ng/µl pA-MNase, in order to bind the fusion protein to the antibody. After 1h rotating at 4˚C, beads were cleared on a magnetic rack and washed twice. To activate MNase activity, beads were resuspended in 150 µl digitonin buffer and chilled down to 0˚C before 3 µl of 100 mM CaCl2 were added for 30 min at 0˚C. Reaction was stopped by adding 150 µl of 2X Stop buffer and tubes were incubated for 10 min at 37˚C to release chromatin. After centrifugation for 5 min at 4˚C at 16 000g, tubes were placed on a magnetic rack in order to remove beads. The supernatant was collected and purified using the NucleoSpin PCR clean up kit. DNA was stored at -20˚C before Illumina library preparation.
!Sample_description = CNR-SMAD3BDS-APC-ARID1A_noTGFb
!Sample_data_processing = library strategy: CUT&RUN
!Sample_data_processing = Quality control of fastq files was done using FastQC before analysis was started. After adapter and PCR duplicate removal reads were mapped to the human genome (GRCh38) using Bowtie2 with options “--local --very-sensitive-local --no-unal --no-mixed --no-discordant --phred33 -I 10 -X 700”.
!Sample_data_processing = Differential peaks in SMAD3 binding (Treated vs. Untreated) were called using MACS2, applying the following parameters: “--nomodal --extsize 160”
!Sample_data_processing = Profiles were displayed using IGV version 2.5.3. The peaks were annotated using HOMER.
!Sample_data_processing = Genome_build: GRCh38
!Sample_platform_id = GPL24676
!Sample_contact_name = giancarlo,,russo
!Sample_contact_email = giancarlo.russo@fgcz.ethz.ch
!Sample_contact_department = Functional Genomics Center Zurich
!Sample_contact_institute = ETH/University of Zurich
!Sample_contact_address = winterthurerstrasse 190
!Sample_contact_city = Zurich
!Sample_contact_state = Schweiz
!Sample_contact_zip/postal_code = 8057
!Sample_contact_country = Switzerland
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN14088502
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX7713662
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4308nnn/GSM4308132/suppl/GSM4308132_cnr_smad3_ARID1A_0h_peaks.narrowPeak.gz
