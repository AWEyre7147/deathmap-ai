!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM2572nnn/GSM2572332/suppl/GSM2572332_SHEP21_0HR_CTCF.chiprx.scaled.bedgraph.gz
