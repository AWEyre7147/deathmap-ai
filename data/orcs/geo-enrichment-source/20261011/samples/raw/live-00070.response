^SAMPLE = GSM3295136
!Sample_title = Control  cells Replicate 1
!Sample_geo_accession = GSM3295136
!Sample_status = Public on Jul 31 2019
!Sample_submission_date = Jul 20 2018
!Sample_last_update_date = Aug 02 2019
!Sample_type = RNA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Control  cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = gender: female
!Sample_characteristics_ch1 = cell line: MDA-MB 231-Br  (human breast cancer)
!Sample_characteristics_ch1 = passage: 4
!Sample_characteristics_ch1 = cell type: human breast cancer
!Sample_treatment_protocol_ch1 = Control 231-Br  cells with lentiviral vector transduction.  Briefly, pCDH-CMV-MCS-T2A-Puro lentivirus vector plasmid was co-transfected into 293T cells with pMD2.G (Addgene #12259) and psPAX2 (Addgene #12260) according to the standard protocol.  Lentivirus supernatant was concentrated by sediment centrifugation using a SW29 rotor at 50,000 x g for two hours. Concentrated viruses were added ton 231-BR cells at a multiplicity of infection (MOI) of 10.Stable cell lines were selected and maintained in puromycin 1mg/l.
!Sample_growth_protocol_ch1 = Cells were grown in Dulbecco’s modified Eagle’s medium (HyClone, Logan, UT, USA) with 10% fetal bovine serum (Biological Industries, Beit Haemek, Israel ) and 1% penicillin and streptomycin, and were maintained at 37°C and 5% CO2.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA extracted using Trizol following manufacturer's instructions
!Sample_label_ch1 = biotin
!Sample_label_protocol_ch1 = 10 µg of total RNA was primed with 2 µl of 100 µM T16N2 DNA primer at 70°C for 10 min, then reversed transcribed at 42°C for 1 h in the presence of 400 U SuperScript II RTase (Invitrogen), and 100 µM each dATP, dTTP, dGTP, with 25 µM dCTP, 25 µM Cy3-labe
!Sample_hyb_protocol = Oligoarray control targets and hybridization buffer were added, and samples were applied to Affymetrix GeneChip arrays.
!Sample_scan_protocol = After hybridization, slides were washed and scanned by GeneChip Scanner 3000.
!Sample_description = Biological replicate 1 of 3. Control  cells.
!Sample_data_processing = The Expression Console software also acquires and converts hybridization intensity data into a presence/absence call for each gene using appropriate algorithms.
!Sample_platform_id = GPL16686
!Sample_contact_name = Yong,,Zhu
!Sample_contact_email = YONG.ZHU@YALE.EDU
!Sample_contact_institute = Yal University
!Sample_contact_address = 60 College Street
!Sample_contact_city = New Haven
!Sample_contact_state = CT
!Sample_contact_zip/postal_code = 06510
!Sample_contact_country = USA
!Sample_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM3295nnn/GSM3295136/suppl/GSM3295136_Control-1_HuGene-2_0-st.CEL.gz
!Sample_series_id = GSE117453
