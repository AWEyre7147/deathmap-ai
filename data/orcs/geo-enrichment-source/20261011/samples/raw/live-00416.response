!Sample_title = LLC_TCR_profiling_tet-_rep1
!Sample_geo_accession = GSM4987066
!Sample_status = Public on Mar 18 2021
!Sample_submission_date = Dec 23 2020
!Sample_last_update_date = Mar 18 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Lewis lung carcinoma - in vivo
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: Lewis lung carcinoma - in vivo
!Sample_treatment_protocol_ch1 = 2*10^6 WT LLC cells were inoculated into both sides of the back of WT recipient mice and expanded in vivo for 14 or 18 days
!Sample_growth_protocol_ch1 = All cell lines were tested for mycoplasma and cultured in RPMI (VWR) or DMEM media (Gibco) supplemented with 10% fetal bovine serum (FBS) and antibiotics.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = tumors cell suspensions were generated using a Tumor Dissociation Kit (Miltenyi) and the gentleMACS Dissociator (Miltenyi) using the m-TDK-2 program. The resulting cell suspension then passed through a 70 micron filter before lymphocytes were isolated using Lympholyte M cell separation media (Cedarlane), per manufacturer’s instructions. Cells were then enriched for CD45+ cells using CD45 microbeads, mouse (Miltenyi) and the MultiMACS Cell24 Separator Plus (Miltenyi). Cells were then stained in PBS using Live/Dead Fixable Near-IR Dead Cell Stain Kit (1:100, ThermoFischer), H-2Kb MuLV p15E Tetramer (1:10, MBL International), and TrueStain FcX Plus (anti-mouse CD16/32) Antibody (1:1000, BioLegend). Samples were then stained for CD45 (1:100, Biolegend) and CD8 (1:10, MBL International) in MACS Buffer. Samples were pooled and analyzed using a MA900 FACS instrument (Sony), using single-colour compensation controls and fluorescence-minus-one controls for setting gates. Live, cD45+, CD8+, and p15E+ cells were sorted into a RMPI with 50% FBS solution. p15E- cells were also sorted. RNA was  isolated using an RNeasy Micro kit (Qiagen). TCR profiling from RNA was performed using the SMARTer Mouse TCR a/b Profiling Kit (Takara)
!Sample_extract_protocol_ch1 = llumina sequencing primers were added in a semi-nested approach during TCR amplification; libraries were purified, pooled and then sequenced on an illumina Miseq platform
!Sample_data_processing = fastq files were aligned and clonotypes assembled using mixcr analyze amplicon (version 3.0.13) using flags -s mmu --starting-material rna --5-end no-v-primers --3-end c-primers --adapters adapters-present
!Sample_data_processing = Mixcr .clonotypes.ALL.txt files of clonotype abundance
!Sample_data_processing = Genome_build: Grcm38
!Sample_data_processing = Base-calling was performed using bcl2fastq2-v2.20.0
