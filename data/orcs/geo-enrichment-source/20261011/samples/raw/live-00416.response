^SAMPLE = GSM4718325
!Sample_title = RNA-seq_LLC_KO_sg2_rep2
!Sample_geo_accession = GSM4718325
!Sample_status = Public on Mar 18 2021
!Sample_submission_date = Aug 10 2020
!Sample_last_update_date = Mar 18 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Lewis lung carcinoma  - in vitro
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = genotype: Setdb1 KO
!Sample_treatment_protocol_ch1 = CRISPR knock-out (KO) was performed via delivery of CAS9 and sgRNA to LLC cells.  When indicated, cells were selected using standard agents (blasticidin, puromycin, hygromycin). No additional treatments were administered.
!Sample_growth_protocol_ch1 = All cell lines were tested for mycoplasma and cultured in RPMI (VWR) or DMEM media (Gibco) supplemented with 10% fetal bovine serum (FBS) and antibiotics.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Approximately one million cells per sample were resuspended in RLT lysis buffer with ß-mercaptoethanol (1:100 dilution) and total RNA was isolated using an RNeasy Kit. 
!Sample_extract_protocol_ch1 = Poly(A)-enriched sequencing libraries were constructed with the NEBNext Ultra II Directional RNA Library Prep Kit (New England Biolabs).
