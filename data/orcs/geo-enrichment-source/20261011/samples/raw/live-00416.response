^SAMPLE = GSM4718290
!Sample_title = H3K9me3_ChIP-seq_LLC_control_rep1
!Sample_geo_accession = GSM4718290
!Sample_status = Public on Mar 18 2021
!Sample_submission_date = Aug 10 2020
!Sample_last_update_date = Mar 18 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Lewis lung carcinoma - in vitro
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = antibody: H3K9me3
!Sample_characteristics_ch1 = genotype: control
!Sample_treatment_protocol_ch1 = CRISPR knock-out (KO) was performed via delivery of CAS9 and sgRNA to LLC cells.  When indicated, cells were selected using standard agents (blasticidin, puromycin, hygromycin). No additional treatments were administered.
!Sample_growth_protocol_ch1 = All cell lines were tested for mycoplasma and cultured in RPMI (VWR) or DMEM media (Gibco) supplemented with 10% fetal bovine serum (FBS) and antibiotics.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Ten million cells per sample were cross-linked with 1% formaldehyde for 15 min, quenched with glycine, and subjected to two-step cell and nuclear lysis in the presence of protease inhibitors. Shearing of samples were optimized such that the final DNA length was approximately 400 base pairs using a Branson sonifier, and was followed by incubation with anti-H3K9me3 polyclonal antibody (Abcam, ab8898) overnight at 4˚C. Immunoprecipitation was performed with 50:50 mixes of magnetic dynabeads Protein A and G (Invitrogen).
!Sample_extract_protocol_ch1 = End-repair, A-tailing, adapter ligation, and library amplification were performed with the Kapa HyperPrep kit (Roche).
!Sample_data_processing = ChIP-seq reads  were first trimmed by Trim Galore (v0.4.5) to remove adapter sequences. The trimmed reads were aligned to mm9 by Bowtie (v2.2.2) with the parameters –N 1 –L 25 -X 2000 --no-mixed --no-discordant. All unmapped reads and PCR duplicates were removed. Non-uniquely mapped reads were assigned to the position with the best matched score. For downstream analyses, we normalized read counts by computing the numbers of reads per kilobase of bin per million of reads (RPKM). H3K9me3 peaks were identified by calculating RPKM in the 100bp bin first. According to the signal distribution, each bin with RPKM more than 0.15 was selected as the signal bin. Signal bins within 500bp of each other were merged and called as signals/peaks.
!Sample_data_processing = genome build: mm9
!Sample_data_processing = WIG
!Sample_data_processing = Base-calling was performed using bcl2fastq2-v2.20.0
!Sample_platform_id = GPL19057
!Sample_contact_name = Jingyi,,Wu
!Sample_contact_laboratory = Bernstein Lab
!Sample_contact_department = Department of Cancer Biology
!Sample_contact_institute = Dana-Farber Cancer Institute
!Sample_contact_address = 360 Longwood Ave
!Sample_contact_city = Boston
!Sample_contact_state = MA
!Sample_contact_zip/postal_code = 02215
!Sample_contact_country = USA
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = ChIP
!Sample_library_source = genomic
!Sample_library_strategy = ChIP-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN15775137
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX8918343
