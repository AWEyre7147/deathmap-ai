!Sample_data_processing = normalized abundance measurements
!Sample_data_processing = Base-calling was performed using bcl2fastq2-v2.20.0
!Sample_platform_id = GPL19057
!Sample_contact_name = Jingyi,,Wu
!Sample_contact_laboratory = Bernstein Lab
!Sample_contact_department = Department of Cancer Biology
!Sample_contact_institute = Dana-Farber Cancer Institute
!Sample_contact_address = 360 Longwood Ave
!Sample_contact_city = Boston
!Sample_contact_state = MA
!Sample_contact_zip/postal_code = 02215
!Sample_contact_country = USA
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN15775290
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX8918386
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE155972
!Sample_data_row_count = 0
^SAMPLE = GSM4718334
!Sample_title = RNA-seq_LLC_setdb1_sg4_Tx_rep_1
!Sample_geo_accession = GSM4718334
!Sample_status = Public on Mar 18 2021
!Sample_submission_date = Aug 10 2020
!Sample_last_update_date = Mar 18 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Lewis lung carcinoma tumors  - in vivo
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = genotype: Setdb1 KO
!Sample_treatment_protocol_ch1 = CRISPR knock-out (KO) was performed via delivery of CAS9 and sgRNA to LLC cells.  When indicated, cells were selected using standard agents (blasticidin, puromycin, hygromycin). Cells were then inoculated into the flanks of recipient WT mice, expanded in vivo for 15 days (+/- PD-1/CTLA-4 blockade), and then harvested.
!Sample_growth_protocol_ch1 = All cell lines were tested for mycoplasma and cultured in RPMI (VWR) or DMEM media (Gibco) supplemented with 10% fetal bovine serum (FBS) and antibiotics.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Approximately 40mg of tumor tissue per sample was submerged in RNAlater reagent, frozen, and homogenized via a TissueLyser II instrument.
!Sample_extract_protocol_ch1 = Poly(A)-enriched sequencing libraries were constructed with the NEBNext Ultra RNA Library Prep Kit (New England Biolabs).
!Sample_description = Invivo_LLC_counts_GRCm38.txt
!Sample_description = llc_setdb1_sg4_Tx_rep1
!Sample_data_processing = RNA-seq reads were trimmed using trimmomatic (version 0.36) with the following settings: ILLUMINACLIP:TruSeq3-PE-2.fa:2:30:10:1:TRUE LEADING:3 TRAILING:3 SLIDINGWINDOW:4:15 MINLEN:130. Paired and unpaired reads were aligned using salmon  (version 0.14.1) with parameters --gcBias --seqBias --validateMappings. Summary to gene level quantification was performed using Tximport (version 1.14.2)
!Sample_data_processing = genome build: Genome Reference Consortium Mouse Build 38 release 93
!Sample_data_processing = gene-by-sample raw count matrix
