!Sample_contact_department = Gladstone-UCSF Institute of Genomic Immunology
!Sample_contact_institute = J. David Gladstone Institutes
!Sample_contact_address = 1650 Owens St
!Sample_contact_city = San Francisco
!Sample_contact_state = CA
!Sample_contact_zip/postal_code = 94158
!Sample_contact_country = USA
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN19110406
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX10863206
!Sample_supplementary_file_1 = NONE
!Sample_series_id = GSE174284
!Sample_series_id = GSE174292
!Sample_data_row_count = 0
^SAMPLE = GSM5291014
!Sample_title = 08_Donor2_sgFOXQ1_Stim
!Sample_geo_accession = GSM5291014
!Sample_status = Public on May 13 2021
!Sample_submission_date = May 11 2021
!Sample_last_update_date = May 14 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Primary CD4+ T cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: Primary CD4+ T cells
!Sample_characteristics_ch1 = sgrna: FOXQ1 Transcriptional Start Site
!Sample_characteristics_ch1 = treatment: anti-CD3/CD28/CD2 Immunocult
!Sample_treatment_protocol_ch1 = One day after activation, Bulk T cells were transduced with mCherry-2A-dCas9-VP64 lentivirus. Two days after activation, T cells were split into two populations and transduced with either a non-targeting control, or FOXQ1 transcriptional start site targeting sgRNA lentivirus. The following day 2ug/ml puromycin was added to the culture medium and cells were passaged every two days maintaining a minimum concentration of 0.3e6cells/ml. Eight days after initial activation, cells were sorted into CD4+mCherry+ populations and resumed culture in X-VIVO 15 without supplements. The next day cells were treated with 6.25ul/ml anti-CD3/CD28/CD2 Immunocult (Stim) or left untreated (NoStim). Cells were harvest 24 hours after stimulation.
!Sample_growth_protocol_ch1 = Primary human bulk T cells were cultured in X-VIVO 15 (Lonza Bioscience cat 04-418Q) supplemented with 5% FCS, 55mM 2-mercaptoethanol, 4mM N-Acetyl L-Cysteine, and 500 IU/ml recombinant human IL-2 (Amerisource Bergen cat 10101641). Primary T cell activation was done by anti-humanCD3/CD28 CTS dynabeads (Fisher Scientific cat 40203D) at a 1:1 cell to bead ratio at 1e6 cells/ml.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Cells were lysed and RNA was purified using Quick-RNA Microprep kit (Zymo Research) without the optional in-well DNase treatment step. Purified RNA was treated with TURBO DNase (Thermofisher Scientific) to remove potential contaminating DNA. RNA was subsequently purified using RNA Clean & Concentrator-5 kit (Zymo Research). RNA quality control was performed using an RNA ScreenTape assay (Agilent), with all samples having a RNA integrity number > 7.
!Sample_extract_protocol_ch1 = RNA-seq libraries were prepared using the Illumina Stranded mRNA Prep kit, with 100ng of input RNA, following manufacturer's recommended protocol.
!Sample_data_processing = Adapters were trimmed from fastq files using cutadapt version 2.10 with default settings keeping a minimum read length of 20 bp.
!Sample_data_processing = Reads were mapped to the human genome GRCh38 keeping only uniquely mapping reads using STAR version 2.7.5b with the following settings “--outFilterMultimapNmax 1”.
!Sample_data_processing = Reads overlapping genes were then counted using featureCounts version 2.0.1 with the following settings “-s 2” and using the Gencode version 35 basic transcriptome annotation.
!Sample_data_processing = Genome_build: GRCh38
!Sample_data_processing = Supplementary_files_format_and_content: Matrix table with raw gene counts for every gene and every sample
!Sample_platform_id = GPL18573
