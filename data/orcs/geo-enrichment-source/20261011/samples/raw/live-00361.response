!Sample_title = OCI-Ly1-parental-01 [ATAC-seq]
!Sample_geo_accession = GSM3984193
!Sample_status = Public on Sep 25 2019
!Sample_submission_date = Jul 29 2019
!Sample_last_update_date = Sep 25 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = OCI-Ly1-parental
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: OCI-Ly1
!Sample_characteristics_ch1 = genotype/variation: OCI-Ly1
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = ATAC-seq was performed on 50,000 cells as described (Buenrostro et al., 2013).
!Sample_extract_protocol_ch1 = Transposition reactions were performed for 1 hr at 37° C, followed by purification and sample barcoding by PCR.
!Sample_description = Ly1_1
!Sample_description = 20170702_Ly1_ATAC_Ad2_1_1_CO4516_S1
!Sample_data_processing = Samples were sequenced on an Illumina NextSeq 500, 35 base pair cycles in paired-end mode. ATAC-seq reads in fastq format were trimmed to remove adapter sequences using skewer v0.2.2.
!Sample_data_processing = Trimmed reads were aligned to hg19 using bowtie2 v2.3.3.1 (Langmead and Salzberg, 2012)
!Sample_data_processing = Alignments were filtered using samtools v1.9 (Li and Durbin, 2009) to remove duplicate reads and retain only proper pairs with mapping quality greater than 30
!Sample_data_processing = Reads mapping to blacklisted regions were removed using samtools v1.9.
!Sample_data_processing = Reads were converted to bed format and reads on the forward and reverse strands were shifted +4 and -5 bp respectively.
!Sample_data_processing = MACS2 v2.1.1 (Zhang et al., 2008) was used to call peaks
!Sample_data_processing = IDR v2.0.4.2 was used to filter enriched regions at an IDR of less than 0.05 to produce high-confidence peak and summit sets. High-confidence summits were expanded to 500bp and a count matrix was generated with Rsubread v1.30.9 (Chen et al., 2016).
!Sample_data_processing = This matrix was imported to R and chromVAR (Schep et al., 2017) was used in conjunction with motifs in the JASPAR2018 (10.18129/B9.bioc.JASPAR2018) (Khan et al., 2018) and chromVARmotifs (https://github.com/GreenleafLab/chromVARmotifs) R packages to generate motif-level measures of differential accessibility.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: tab-separated values (differential accessibility z−score); bigwig containing 10bp binned Tn5 insertion counts normalized to millions of reads in peaks.
!Sample_platform_id = GPL18573
