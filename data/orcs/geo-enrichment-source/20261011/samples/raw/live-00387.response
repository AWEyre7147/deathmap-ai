^SAMPLE = GSM5342491
!Sample_title = WGBS_Hsap_fibro
!Sample_geo_accession = GSM5342491
!Sample_status = Public on Mar 23 2022
!Sample_submission_date = May 27 2021
!Sample_last_update_date = Mar 23 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Primary dermal fibroblasts
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = Sex: Female
!Sample_characteristics_ch1 = genome build: hg38
!Sample_characteristics_ch1 = treatment: No treatment
!Sample_characteristics_ch1 = tissue: Primary dermal fibroblasts
!Sample_growth_protocol_ch1 = Primary dermal fibroblasts were grown in DMEM-GlutaMax supplemented with 10% fetal bovine serum and 50U/mL penicillin-streptomycin in a humidified atmosphere containing 5% CO2 at 37°C.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted using the AllPrep DNA/RNA Mini Kit (Qiagen).
!Sample_extract_protocol_ch1 = 100 ng of genomic DNA were fragmented to 350 bp using a Covaris E220 sonicator. Bisulfite conversion was performed with the EZ DNA Methylation-Gold kit (Zymo), and WGBS libraries were prepared using the Accel-NGS Methyl-Seq DNA library Kit (Swift Biosciences) following the manufacturer’s instructions. 4 to 6 cycles were used for the final PCR amplification of the WGBS libraries. The libraries were purified using Agencourt AmpureXP beads (Beckman-Coulter).
!Sample_data_processing = Low quality bases as well as the first five bases of reads R1 and ten bases of reads R2 and adapter sequences were trimmed with Trim Galore v0.4.4 (parameters -q 20 --clip_R1 5 --clip_R2 10 --stringency 2).
!Sample_data_processing = Reads were mapped to the corresponding genome and cleaned for duplicates using Bismark v0.22.1 with default parameters. Reads with incomplete bisulfite conversion were removed using the filter_non_conversion tool in Bismark with the parameters --minimum_count 5 and --percentage_cutoff 50
!Sample_data_processing = Reads with incomplete bisulfite conversion were removed using the filter_non_conversion tool in Bismark v0.22.1 with the parameters --minimum_count 5 and --percentage_cutoff 50
!Sample_data_processing = Methylation calls were extracted as the ratio of the number of Cs over the total number of Cs and Ts using the Bismark_methylation_extractor. CGs were filtered to have a minimum sequencing depth of 5X.
!Sample_data_processing = genome build: hg38, mm10, oryCun2, canFam3, bosTau8, susScr11, galGal6
!Sample_data_processing = processed data files format and content: We provide IGV files containing methylation scores for all CGs with at least 5X sequencing depth.
!Sample_platform_id = GPL20301
!Sample_contact_name = Michael,,Weber
!Sample_contact_department = UMR7242 Biotechnology and Cell Signalling
!Sample_contact_institute = CNRS
!Sample_contact_address = 300 Bd Sebastien Brant
!Sample_contact_city = Illkirch
!Sample_contact_zip/postal_code = 67412
!Sample_contact_country = France
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = RANDOM
!Sample_library_source = genomic
!Sample_library_strategy = Bisulfite-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN19365316
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11003179
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5342nnn/GSM5342491/suppl/GSM5342491_WGBS_Hsap_fibro.igv.gz
