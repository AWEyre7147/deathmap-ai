^SAMPLE = GSM4942751
!Sample_title = Empty vector FLAG IP 1
!Sample_geo_accession = GSM4942751
!Sample_status = Public on Nov 26 2020
!Sample_submission_date = Nov 25 2020
!Sample_last_update_date = Nov 26 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = K562 cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = genetic tag: FLAG
!Sample_characteristics_ch1 = transgene: Empty vector FLAG
!Sample_characteristics_ch1 = index 1 sequence: CGCTCATT
!Sample_characteristics_ch1 = index 2 sequence: TAATCTTA
!Sample_treatment_protocol_ch1 = 10 million K562 cells expressing either a FLAG-tagged empty vector or N-terminal FLAG-tagged ZRSR2 were UV crosslinked at 400 mJoules/cm2 with 254 nm radiation and snap frozen.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Cells were lysed with RNase I to fragment RNA as previously described (Van Nostrand, E.L. et al. (2017) Methods Mol Biol). FLAG antibody (F-1084, Sigma-Aldrich) was then pre-coupled to Protein G Dynabeads (Thermo Fisher), added to lysate, and incubated overnight at 4 degrees Celcius. Prior to immunoprecipitation, 2% of the sample was taken as the paired input sample, with the remainder magnetically separated and washed with lysis buffer only.
!Sample_extract_protocol_ch1 = Library construction was performed by excising the area from ∼65 kDa to ∼140 kDa. RNA adapter ligation, IP-western, reverse transcription, DNA adapter ligation, and PCR amplification were performed as previously described (Van Nostrand, E.L. et al. (2017) Methods Mol Biol).
!Sample_extract_protocol_ch1 = Single-end Enhanced Crosslinking and Immunoprecipitation (seCLIP) by Eclipse Bioinnovations Inc (San Diego, www.eclipsebio.com) according to the published protocol (Van Nostrand, E.L. et al. (2017) Methods Mol Biol).
!Sample_description = IP for FLAG tag using empty vector (biological replicate 1)
!Sample_data_processing = Reads aligned to GRCh38/hg38 and GENCODE Release 32.
!Sample_data_processing = PCR duplicates and reads aligning to repetitive sequences were removed.
!Sample_data_processing = Genome_build: UCSC GRCh38/hg38
!Sample_data_processing = Supplementary_files_format_and_content: bigWig files show read coverage.
!Sample_platform_id = GPL20301
!Sample_contact_name = Robert,K.,Bradley
!Sample_contact_email = rbradley@fredhutch.org
