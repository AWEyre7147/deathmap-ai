!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Sperm_RNAseq
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = donor: adult donor 1
!Sample_characteristics_ch1 = tissue: sperm
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted using  Qiagen AllPrep DNA/RNA/Protein mini kit (Cat # 80004), ribosomal RNA was depleted using RiboZero kit.
!Sample_extract_protocol_ch1 = Directional RNA library was prepared according to Illumina's standard protocol. Detailed experimental procedures and bioinformatics analysis can be found in the supplemental method section of the paper.
!Sample_description = processed data file: D1D2_SPERM_RPKM_mRNA.txt
!Sample_data_processing = Basecalls performed using CASAVA
!Sample_data_processing = Reads were aligned to hg18 using Novoalign V2.07.09 allowing up to 10 alignments per read, using these parameters for mRNA-seq alignments: -FILMFQ -o SAM -m -l17 -t60 -rA 10 -a and these settings for smRNA-seq alignments: -FILMFQ -o SAM -m -l17 -h90 -t30 -rA 10 -a.
!Sample_data_processing = The novoalign index was made by combining hg18 fasta files (UCSC), Illumina adapter sequences, and splice junction fasta files made using MakeSpliceJunctionFasta (USeq version 6.0) with -s 34 as input radius and merged ensGene and knownGene table (from genome.ucsc.edu) as annotation.
!Sample_data_processing = Genome_build: hg18
