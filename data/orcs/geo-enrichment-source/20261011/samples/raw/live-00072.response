^SAMPLE = GSM3717007
!Sample_title = MafgKO_replicate1 [ATAC-seq]
!Sample_geo_accession = GSM3717007
!Sample_status = Public on Feb 12 2020
!Sample_submission_date = Apr 10 2019
!Sample_last_update_date = Feb 12 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = MafgKO_astrocytes
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: C57Bl/6
!Sample_characteristics_ch1 = genotype/variation: wild type
!Sample_characteristics_ch1 = Sex: Male
!Sample_characteristics_ch1 = age: P90
!Sample_characteristics_ch1 = sample group: undergoing EAE transduced with Mafg-targeting lentiviruses
!Sample_characteristics_ch1 = cell type: Flow cytometry sorted astrocytes
!Sample_treatment_protocol_ch1 = Induction of EAE in mice intracranially transduced with pLenti-U6-sgMafg-Gfap-Cas9-2A-EGFP-WPRE or pLenti-U6-sgScrmbl-Gfap-Cas9-2A-EGFP-WPRE. EAE was induced by injecting 25 µg of MOG35-55 diluted in 100 µL of PBS emulsified in 100 µL of CFA per mouse.
!Sample_growth_protocol_ch1 = N/A
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Each CNS was isolated per mouse. A cell suspension was generated by papain digestion, neutralization, and 70um filtration of cell extract. Cells were centrifuged, resuspended in 30% Percoll, centrifuged, washed in PBS, and stained with primary antibodies for flow cytometry. Once cells were sorted, cells were pelleted, washed, and tagmented according to the ATAC-seq protocol (Buenrostro et al., Nature Methods 2013).
!Sample_extract_protocol_ch1 = Nextera DNA Library Prep Kit
!Sample_description = 6_R*_001
!Sample_description = processed data: Mafg_merged_FE.bdg
!Sample_data_processing = Reads were trimmed using Cutadapt (v1.14) to remove adapters and low quality reads.
!Sample_data_processing = ATAC-seq paired-end reads were aligned using Bowtie2 (v2.3.0) with maximum fragment size 2000 (-X2000).
!Sample_data_processing = Duplicated reads were marked with Picard (v2.5.0).
!Sample_data_processing = Alignments were filtered with SAMtools (v1.3) to exclude reads with mapping quality <30, not properly paired, duplicated, aligned to mitochondrial genome, and/or aligned to ENCODE blacklist regions.
!Sample_data_processing = ATAC-Seq peaks were called for each replicate using MACS2, using --format BAMPE and --keep-dup all, and were selected with p<0.01
!Sample_data_processing = IDR (v2.0.2) was used to determine consistency of peak detection between individual replicates and peaks with FDR<0.10 were merged between replicates for downstream analysis.
!Sample_data_processing = Fold enrichment tracks were generated in MACS using bdgcmp and were visualized using IGV (v 2.3.59).
!Sample_data_processing = Genome_build: GRCm38
!Sample_data_processing = Supplementary_files_format_and_content: bedgraph file containing fold enrichment peaks provided by MACS2 bdgcmp
!Sample_platform_id = GPL21103
!Sample_contact_name = Michael,,Wheeler
!Sample_contact_email = mwheeler0@bwh.harvard.edu
!Sample_contact_department = Neurology
!Sample_contact_institute = Brigham and Women's Hospital
!Sample_contact_address = 60 Fenwood Rd.
!Sample_contact_city = Boston
!Sample_contact_state = MA
!Sample_contact_zip/postal_code = 02115
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 4000
