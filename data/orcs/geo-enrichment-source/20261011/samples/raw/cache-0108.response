^SAMPLE = GSM4202166
!Sample_title = Banf1 KO H3K27ac ChIP-seq
!Sample_geo_accession = GSM4202166
!Sample_status = Public on Dec 31 2020
!Sample_submission_date = Dec 03 2019
!Sample_last_update_date = Jan 01 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = BV1 Cells Banf1 KO
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = genotype/variation: Banf1 Knock Out
!Sample_characteristics_ch1 = chip antibody: H3K27ac ab Ab4729
!Sample_characteristics_ch1 = molecule subtype: DNA - chromatin Immunoprecipiation
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = For RNA-Seq, total RNA from 10^6 control BV2 cells, Banf1 gene-edited cells, and Banf1-complemented cells were extracted using RNeasy Mini Kit (Qiagen).   For native ChIP-Seq, aliquots of 10^5 cells were suspended in 20 µl of EZ nuclei isolation buffer (Sigma) and digested using 20 µl MNase (NEB MNase buffer, 1 µl MNase, and 3 mM DTT) for 5 min at 37°C, which was quenched by addition of 4.4 µl of 100 mM EDTA, and 4.4 µl of 1% Triton X-100 and 1% deoxycholate. Digested nucleosomes were diluted in complete ChIP immunoprecipitation buffer (20 mM Tris-HCL pH 8.0, 2 mM EDTA, 150 mM NaCl, 0.1% Triton X-100, 5 mM sodium butyrate, and protease inhibitors (Roche)), precleared using Dynabeads (Invitrogen) for 1 h at 4°C, and subjected to immunoprecipitation overnight at 4°C (0.1 µg H3K27ac, Abcam, ab4729). Bead chromatin complexes were washed sequentially using low-salt buffer (0.1% SDS, 1% Triton X-100, 2 mM EDTA, 20 mM Tris pH 8.0, 150 mM NaCl) and high-salt buffer (0.1% SDS, 1% Triton X-100, 2 mM EDTA, 20 mM Tris pH 8.0, 500 mM NaCl) and then eluted with 1% SDS and 100 mM NaHCO3 for 1 h at 65°C. DNA was purified using Maxtract tubes (QIAGEN) and precipitated overnight.
!Sample_extract_protocol_ch1 = The quality of the RNA samples was evaluated using Bioanalyzer 2100 (Agilent) and prepared using mRNA ribo-deplete.
!Sample_extract_protocol_ch1 = Libraries were sequenced on Illumina HiSeq2500 platforms (Genome Technology Access Center, Washington University).
!Sample_description = H3K27ac_Banf1KO
!Sample_data_processing = For RNA-seq, The reads were aligned to the mm9 build using Bowtie2 to map clean reads to reference gene. RPKM values were determined using STAR aligner. For ChIP-seq reads were aligned ot the mm9 genome assemply using NovaAlign with the following options:-r None -l 30 -e 100 -i 230 140.
!Sample_data_processing = duplicates were removed using Picard markDuplicates
!Sample_data_processing = peaks were called using MACS2 findpeaks --broad
!Sample_data_processing = The reads were aligned to the mm9 build using Bowtie2 to map clean reads to reference gene
!Sample_data_processing = Genome_build: mm9
!Sample_data_processing = Supplementary_files_format_and_content: . RPKM values were determined using STAR aligner.
!Sample_platform_id = GPL17021
!Sample_contact_name = Patrick,Leonard,Collins
!Sample_contact_email = patrick.collins@osumc.edu
!Sample_contact_phone = 6156683538
!Sample_contact_department = Microbial Infection and Immunity
!Sample_contact_institute = Ohio State University
!Sample_contact_address = 770 BRT,  460 W 12th Ave
!Sample_contact_city = Columbus
!Sample_contact_state = OH
!Sample_contact_zip/postal_code = 43210
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = ChIP
!Sample_library_source = genomic
!Sample_library_strategy = ChIP-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN13473245
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX7262721
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4202nnn/GSM4202166/suppl/GSM4202166_H3K27ac_Banf1KO.bw
!Sample_series_id = GSE141386
!Sample_data_row_count = 0
