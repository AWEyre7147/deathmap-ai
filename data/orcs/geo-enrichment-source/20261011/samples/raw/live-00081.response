^SAMPLE = GSM4151448
!Sample_title = GRN1_lo
!Sample_geo_accession = GSM4151448
!Sample_status = Public on Nov 07 2019
!Sample_submission_date = Nov 06 2019
!Sample_last_update_date = Nov 08 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = hippocampus
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: B6.129S4(FVB)-Grntm1.1Far/Mmja
!Sample_characteristics_ch1 = age: 10 month old
!Sample_characteristics_ch1 = Sex: male
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Primary microglia were isolated by gentle dounce homogenization of the brain, Percoll-based myelin removal, and FACS-purification of ~10,000 live CD11b+CD45lo cells. BODIPYlo (=lipid droplet-low) and BODIPYhi (=lipid droplet-high) microglia were sorted into RLT Plus buffer (Qiagen) containing beta-mercaptoethanol. RNA was extracted using a RNeasy Micro Plus kit (Qiagen) according to the manufacturer’s protocol.
!Sample_extract_protocol_ch1 = cDNA synthesis and amplification was performed using the SmartSeq v4 Ultra-low input kit (Takara), and libraries were tagmented, adaptor ligated, and indexed using the Nextera XT kit (Illumina).
!Sample_description = BODIPY-low microglia (lipid-droplet low)
!Sample_data_processing = Sequencing of isolated microglia was carried out with Novaseq 6000, paired end, 2x 100 bp depth sequencer.
!Sample_data_processing = The quality of fastq files was assessed using FASTQC (v 0.11.4).
!Sample_data_processing = Reads were mapped to mouse mm9 reference genome using STAR (v 2.5.3a).
!Sample_data_processing = Raw read counts were generated with STAR using the GeneCounts function.
!Sample_data_processing = Differential expression analysis was performed using DESeq2 with standard settings.
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: tab-delimited text files include RPKM values for each Sample
!Sample_platform_id = GPL24247
