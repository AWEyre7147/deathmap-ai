!Sample_title = CALU6 DMSO 24h-1
!Sample_geo_accession = GSM6850283
!Sample_status = Public on Jun 14 2023
!Sample_submission_date = Dec 16 2022
!Sample_last_update_date = Jun 14 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Lung
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Lung
!Sample_characteristics_ch1 = cell line: CALU6
!Sample_characteristics_ch1 = cell type: NSCLC
!Sample_characteristics_ch1 = genotype: WT
!Sample_characteristics_ch1 = treatment: DMSO
!Sample_treatment_protocol_ch1 = CALU6 cells were cultured in 6-well plates (2.5 x 10e5 cells/well) and treated with KI696 (1 µM) or vehicle control for 24 or 48 hrs.
!Sample_growth_protocol_ch1 = CALU6 cells were grown in RPMI-1640 (Corning) media containing 10% FBS (Corning), Penicillin-Streptomycin (100 mg/ml, Millipore) and 1% GlutaMax (Gibco).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was isolated by RNeasy Kit (Qiagen) following the manufacturer’s instructions and digested with DNase (Qiagen) from n=2 samples per condition.
!Sample_extract_protocol_ch1 = mRNA-seq libraries were prepared using NEBNext® Poly(A) mRNA Magnetic Isolation Module (NEB) kit according to manufacturer’s instructions. Libraries were then quantified by Kappa Library Quantification (Roche), pooled, and sequenced by single-end 75 base pairs using the Illumina NextSeq 500 platform.
!Sample_data_processing = FASTQ files were then processed using RNA Express module (Illumina) and raw counts were further processed in R (v.4.0.3) and edgeR to obtain relative gene expression.
!Sample_data_processing = Assembly: hg38
!Sample_data_processing = Supplementary files format and content: Excel file with normalized counts matrix of each sample
