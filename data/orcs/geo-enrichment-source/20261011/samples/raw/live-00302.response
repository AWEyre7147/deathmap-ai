!Sample_submission_date = Jan 13 2020
!Sample_last_update_date = Jun 17 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Quiescent Microglia
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = genotype/variation: wild type
!Sample_characteristics_ch1 = cell type: Primary Postnatal Microglia
!Sample_characteristics_ch1 = treatment: Control
!Sample_treatment_protocol_ch1 = Astrocytes were treated with PBS (control) or treated with 3ng/ml Il-1a, 30ng/ml TFNa, and 400ng/ml C1q (IL-1a (3ng/ml), TNFa (30ng/ml), and C1q (400ng/ml)). Microglia were treated with PBS  (control) or with 50ng/ml LPS (50ng/ml LPS).
!Sample_growth_protocol_ch1 = Astrocytes were cultured in defined, serum-free medium containing 50% neurobasal, 50% DMEM, 100 U/mL penicillin, 100 μg/mL streptomycin, 1 mM sodium pyruvate, 292 μg/mL L-glutamine, 1× SATO, 5 μg/mL of N acetyl cysteine, and 5ng/mL HBEGF (Peptrotech, 100-47). Microglia were cultured in a minimal, serum-free media consisting of DMEM/F12 (Gibco, 21041025) supplemented with 100 units/mL penicillin, 100 μg/mL streptomycin, 2mM glutamine, 5 μg/mL N-acetyl cysteine, 100 μg/mL apo-transferrin, 100 ng/mL sodium selenite, TGF-β2 (2 ng/mL, Peprotech), murine IL-34 (100 ng/mL, R&D Systems), ovine wool cholesterol (1.5 μg/mL, Avanti Polar Lipids), and heparan sulfate (1 μg/mL, Galen Laboratory Supplies).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA extracted using the Rneasy Mini Kit by Qiagen
!Sample_extract_protocol_ch1 = polyA enriched mRNA libraries (SureSelect Automated Strand-Specific RNA Library Prep, mRNA Library Prep for Illumina Paired-End Multiplexed Sequencing)
!Sample_description = processed data file:
