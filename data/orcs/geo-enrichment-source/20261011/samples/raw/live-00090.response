^SAMPLE = GSM4679556
!Sample_title = CtrlsgRNA_rep1
!Sample_geo_accession = GSM4679556
!Sample_status = Public on Oct 05 2020
!Sample_submission_date = Jul 20 2020
!Sample_last_update_date = Oct 05 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Vero-E6 sgCtrl
!Sample_organism_ch1 = Chlorocebus sabaeus
!Sample_taxid_ch1 = 60711
!Sample_characteristics_ch1 = cell line: Vero-E6
!Sample_characteristics_ch1 = cell type: african green monkey kidney cells
!Sample_characteristics_ch1 = condition: control sgRNA
!Sample_growth_protocol_ch1 = Vero-E6 cells were cultured in Dulbecco’s Modified Eagle Medium (DMEM) with 10% heat-inactivated fetal bovine serum (FBS), and 1% Penicillin/Streptomycin.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = 50,000 cells were treated with Transposase. Protocol as previously described in Corces et al (Nat.Methods 2017).
!Sample_extract_protocol_ch1 = DNA libraries were prepared as previously described in Corces et al (Nat.Methods 2017).
!Sample_data_processing = Basecalls performed using CASAVA version 1.8.2
!Sample_data_processing = Reads were trimmed of adapters using Trimmomatic v0.39
!Sample_data_processing = Trimmed reads were aligned using Bowtie2 v2.2.9 to chlSab2 using standard parameters and a maximum fragment length of 2000
!Sample_data_processing = Duplicate reads were determined using Picard tools v2.9.0
!Sample_data_processing = Bam files were filtered using samtools -F 1804
!Sample_data_processing = Reads were then processed where only the most 5' base pair for each read was kept and forward strand reads were shifted +4bp, and reverse strand reads were shifted -5bp.
!Sample_data_processing = For a consensus peak set, all bam files were merged using samtools and used for peak calling
!Sample_data_processing = Peak calling was performed using MACS2 v2.2.6 with parameters --nomodel --keep-dup all -s 1 --shift -75 --extsize 150.
!Sample_data_processing = featureCounts v1.6.2 was used to count reads from replicates that fall within the consensus peak set using default parameters
!Sample_data_processing = DEseq2 v1.32 was used to determine differential accessibility using counts.
!Sample_data_processing = Bigwig files were generated using deeptools v3.1.3 with parameter --normalizeUsing RPKM
!Sample_data_processing = Genome_build: chlSab2
!Sample_data_processing = Supplementary_files_format_and_content: bigwig (Merged rep1, rep2), bed (all ATAC peaks), txt (DESeq2 results), txt (raw counts)
!Sample_platform_id = GPL28895
