^SAMPLE = GSM6436806
!Sample_title = SK-N-DZ, lane 1, scRNAseq
!Sample_geo_accession = GSM6436806
!Sample_status = Public on Apr 10 2023
!Sample_submission_date = Aug 08 2022
!Sample_last_update_date = Apr 11 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Brain
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: Neuroblastoma
!Sample_characteristics_ch1 = tissue: Brain
!Sample_characteristics_ch1 = strain: SK-N-DZ
!Sample_characteristics_ch1 = age: 2 years
!Sample_growth_protocol_ch1 = Cells were maintained in DMEM (Gibco) with 10% FCS (Gibco), 1X HEPES (Gibco) and 100 U/ml penicillin/streptomycin at 37° C and 5 % CO2.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Ten days after transduction, puromycin-selected cells were washed twice with PBS and dissociated with accutase (37° C, 5 min). Cells were collected in PBS + 0.04 % BSA, counted and diluted to 10^6 cells/ml
!Sample_extract_protocol_ch1 = Single-cell libraries were constructed following the manufacter’s instructions (10x Genomics, Single Cell Gene Expression v3.1 protocol). Briefly, 20,000 SK-N-DZ cells per lane were resuspended in the master mix and loaded alongside the gel beads and the partitioning oil into the chip (G) to generate the GEMs. Polyadenylated mRNA in every single GEM was reverse-transcribed to cDNA with a oligo(dT) primer, that contains the illumina TruSeq Read 1 primer sequence, the 10x Barcode and Unique Molecular Identifiers (UMIs). The barcoded cDNA was pooled and cleaned up with Silane DynaBeads. Full-legnth cDNA was amplified by PCR. AFter enzymatic fragmentation, end repair, A-tailing and ligation, the apropiated sized fragments were selected with SPRIselect beads for subsequent library construction. During the final library construction, the Illumina TruSeq Read 2 primer sequence was introduced alongside a sample index (four per lane). Forty nanogram of full-length cDNA was used as input for the construction of gRNA enrichment libraries following a previously published hemi-nested PCR strategy (Hill et al., 2018)
!Sample_description = 10x Genomics 3' mRNA library. Read1 contains 16 nt cell barcode followed by 12 nt UMI. Read2 file contains transcript insert
!Sample_description = lane1
!Sample_data_processing = Single-cell reads were mapped to the GRCh 38 reference genome. Count matrices were generated using Cell Ranger (10X Genomoics, version 6.0.1). Single-cell sequencing data from the two lanes were combined using the aggregation function (cellranger aggr). Data normalization and downstream analysis were performed via Seurat (R package, version 4.0.1). Briefly, the count matrix was filtered for genes that were detected in at least 10 cells. UMI counts for each gene were divided by the total number of counts and multiplied by 10,000 and log-transformed. Guide RNA libraries were processed via fba. Briefly, cell barcode - gRNA assignments were made based on mapping the reads to the custom gRNA library and the whitelist of 10X barcode sequences thereby allowing two mismatches.
!Sample_data_processing = Assembly: GRCh 38
!Sample_data_processing = Supplementary files format and content: Comma-separated, tab-separated values files and matrix files
!Sample_platform_id = GPL24676
!Sample_contact_name = Umut,,Yildiz
!Sample_contact_email = umut.yildiz@embl.de
!Sample_contact_institute = European Molecular Biology Laboratory
!Sample_contact_address = Meyerhofstraße 1
!Sample_contact_city = Heidelberg
!Sample_contact_zip/postal_code = 69117
!Sample_contact_country = Germany
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic single cell
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN30196719
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX16982838
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6436nnn/GSM6436806/suppl/GSM6436806_lane1_barcodes.tsv.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6436nnn/GSM6436806/suppl/GSM6436806_lane1_features.tsv.gz
!Sample_supplementary_file_3 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6436nnn/GSM6436806/suppl/GSM6436806_lane1_matrix.mtx.gz
!Sample_series_id = GSE210762
!Sample_data_row_count = 0
