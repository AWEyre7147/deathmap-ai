^SAMPLE = GSM3477862
!Sample_title = d10_Tet
!Sample_geo_accession = GSM3477862
!Sample_status = Public on Nov 20 2018
!Sample_submission_date = Nov 19 2018
!Sample_last_update_date = Nov 20 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = CD8+ TIL
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell type: SIINFEKL Tetramer+ CD8+ T cells isolated from B16-OVA melanoma tumors day 10 after implantation
!Sample_characteristics_ch1 = strain: C57BL/6
!Sample_characteristics_ch1 = isolation of cd45+ cells from tumors: CD8+ MACS positive selection (Miltenyi) followed by FACS
!Sample_treatment_protocol_ch1 = Mice were not treated
!Sample_growth_protocol_ch1 = 3 x 10^5 B16-OVA tumor cells were injected subcutaneously into C57BL/6 mice. On day 10 or 20 after implantation, tumors were extracted and processed as noted below
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Tumors were dissected from the surrounding fascia, mechanically minced and treated with collagenase P and DNAse I for 10 minutes at 37C. Tumor-infiltrating leukocytes were enriched using Optiprep (Sigma) density gradient followed by CD8+ MACS positive selection (Miltenyi) and FACS isolation. Cells were counted and loaded onto the 10x device (10x Genomics).
!Sample_extract_protocol_ch1 = Library construction was performed as per standard 10x protocol (Manual CG00052 Rev B)
!Sample_extract_protocol_ch1 = 10X single-cell 3' RNA-seq v2
!Sample_data_processing = Sample demultiplexing, barcode processing, alignment, filtering, UMI counting, and aggregation of multiple sequencing runs were performed using the Cell Ranger analysis pipeline (v1.2)
!Sample_data_processing = Data normalization, dimension reduction, and differential expression analysis were performed using the Seurat R package (v2.2.0)
!Sample_data_processing = Single cell signatures scoring was performed using the FastProject software (v1.1.0)
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: matrix.mtx file is count matrix in sparse matrix format; barcodes.tsv is list of barcodes for each sample; genes.tsv is list of genes detected in samples
!Sample_platform_id = GPL19057
!Sample_contact_name = Kevin,,Bi
!Sample_contact_email = kevin_bi@dfci.harvard.edu
