^SAMPLE = GSM1576785
!Sample_title = Mock 72 hours replicate 1
!Sample_geo_accession = GSM1576785
!Sample_status = Public on Jan 06 2015
!Sample_submission_date = Jan 05 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Huh7.5
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: Huh7.5
!Sample_characteristics_ch1 = infection status: Mock
!Sample_treatment_protocol_ch1 = Cells were infected with WT or m15 HCV viruses at an MOI of 1-2. Virus inoculum was washed off 6hours post infection. Cells underwent harvest, with appropriate Mock infected controls at 72 and 96 hours, for WT and m15 HCV infections respectively.
!Sample_growth_protocol_ch1 = Cells were maintained in DMEM supplemented with 5%FBS and 1% Non-essential amino acids, under 5% Co@ at 37C.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was isolated via Trizol extraction, RQ1 DNAse treated, and re-extracted using phenol:chlorofom.
!Sample_extract_protocol_ch1 = RNA libraries were prepared for sequencing using standard Illumina protocols with polyA selection.
!Sample_description = polyA RNA
!Sample_data_processing = Fastq files were groomed for quality (min score 20) and aligned with bowtie allowing up to 2 mismatched and discarding reads with multiple hits.
!Sample_data_processing = Mapped read coordinates were then intersected with a meta-transcript file of the longest isoform of every coding gene in RefSeq and then counted. The resulting reads per gene count, for each RNA-Seq replicate then underwent statistical analysis and quantification using EdgeR (Robinson et al., 2009).
!Sample_data_processing = Genome_build: hg18
!Sample_data_processing = Supplementary_files_format_and_content: tab-delimited text file counts per gene matrix, fold change, counts per million and FDR values for virus versus mock infection comparisons.
!Sample_platform_id = GPL11154
