!Sample_instrument_model = Illumina HiSeq 2000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN06829274
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX2763380
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM2588nnn/GSM2588700/suppl/GSM2588700_siSumo2.2.fpkm_tracking.gz
!Sample_series_id = GSE97778
