!Sample_instrument_model = Illumina HiSeq 2000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN06829287
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX2763367
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM2588nnn/GSM2588687/suppl/GSM2588687_TE.1.fpkm_tracking.gz
!Sample_series_id = GSE97778
