!Sample_submission_date = Aug 17 2021
!Sample_last_update_date = Aug 25 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = hiPSC-derived astrocytes
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cytokine treatment: Vehicle
!Sample_characteristics_ch1 = library type: 10x RNA
!Sample_treatment_protocol_ch1 = iAstrocytes were treated with vehicle or IL1a (3 ng/mL) +TNF (30 ng/mL) + C1q (400 ng/mL) for 24 hours.
!Sample_growth_protocol_ch1 = iAstrocytes were plated at 20,000 cells/cm2 on Matrigel-coated plates and maintained in Astrocyte Media (ScienCell cat. no. 1801) for 5 days prior to cytokine treatment.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = 10x Next GEM v3.1
!Sample_data_processing = Alignment and quantification were performed on 10X single-cell RNA-seq libraries and sgRNA-enriched libraries using Cell Ranger (version 5.0.1) with default parameters and reference genome GRCh38-3.0.0.
!Sample_data_processing = Cellranger aggr was used to aggregate counts belonging to the same sample across different GEM wells.
!Sample_data_processing = sgRNA unique molecular identifier (UMI) counts for each cell barcode were obtained using the pipeline described in Hill et al. [PMID: 29457792]
!Sample_data_processing = sgRNAs were assigned to cells using demuxEM [PMID: 31266958]
!Sample_data_processing = Genome_build: GRCh38-3.0.0
!Sample_platform_id = GPL24676
