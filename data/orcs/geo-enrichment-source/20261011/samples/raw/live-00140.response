!Sample_last_update_date = Jun 23 2025
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Human Stomach
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Human Stomach
!Sample_characteristics_ch1 = genotype: WT
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = ATAC-seq assay and libraries were prepared at the MD Anderson Epigenomics Profiling Core
!Sample_extract_protocol_ch1 = ATAC-seq assay and libraries were prepared at the MD Anderson Epigenomics Profiling Core
!Sample_extract_protocol_ch1 = The resulting libraries were sequenced 2 x 75 bp on an Illumina NextSeq500.
!Sample_data_processing = Briefly, adapter sequences were removed using Cutadapt, and filtered reads were aligned to the hg38 reference genome using Bowtie2.
!Sample_data_processing = Picard was used to remove duplicated reads (https://broadinstitute.github.io/picard/), and reads with a quality score below 30 were filtered out. To verify data quality,
!Sample_data_processing = the insert size distribution was examined to confirm peaks around 50 bp and 200 bp. Peak calling was performed using MACS2, accounting for the specific 9 bp insertions introduced by the Tn5 transposase.
!Sample_data_processing = Finally, peaks were converted to BigWig format for visualization using IGV and downstream analyses.
!Sample_data_processing = Assembly: hg38
!Sample_data_processing = Supplementary files format and content: bigWig files are provided for each sample
!Sample_platform_id = GPL18573
