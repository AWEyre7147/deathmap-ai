^SAMPLE = GSM2563987
!Sample_title = G1S-CAS9-P1-S5
!Sample_geo_accession = GSM2563987
!Sample_status = Public on Apr 06 2017
!Sample_submission_date = Apr 05 2017
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = recombinant U2OS cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: G1S-CCMP-Cas9 U2OS cells
!Sample_characteristics_ch1 = tissue: bone osteosarcoma
!Sample_treatment_protocol_ch1 = Untreated
!Sample_growth_protocol_ch1 = G1S-CCMP-Cas9 U2OS cells were cultured at 37 °C/5% CO2 in McCOYS 5A medium (GE Healthcare HyClone, Cat #SH.30200.01) with 10% fetal bovine serum, 1% L-Glutamine and 500 µg/mL Genetecin (Gibco, Ref 10131-027).
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Total RNA from one million G1S-CCPM-Cas9 cells was collected using the RNeasy Mini Kit (Qiagen, #74106).
!Sample_extract_protocol_ch1 = RNA-seq libraries were prepared from the total RNA collected using the NEXTflex™ Rapid Directional mRNA-Seq Kit Bundle with RNA-Seq Barcodes and poly(A) beads (Bioo Scientific, #5138-10, 5138-11).
!Sample_data_processing = Read trimming for Illumina adapters using Trimmomatic v0.32
!Sample_data_processing = Read quality report from FastQC v0.11.2
!Sample_data_processing = Read mapping to human reference transcriptome using Tophat2 v2.0.13 and Bowtie2 v2.2.3
!Sample_data_processing = FPKM values using Cufflinks v2.2.1
!Sample_data_processing = Genome_build: Grch38
!Sample_data_processing = Supplementary_files_format_and_content: Excel files with two worksheets corresponding to the Cufflinks output files "genes.fpkm_tracking" and "isoforms.fpkm_tracking".  Columns include gene ID/transcript accession, genomic locus, and FPKM values.
