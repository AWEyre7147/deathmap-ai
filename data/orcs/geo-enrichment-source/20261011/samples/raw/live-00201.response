^SAMPLE = GSM5047921
!Sample_title = KOPTK1_DMSO_72h_rep1
!Sample_geo_accession = GSM5047921
!Sample_status = Public on Oct 25 2021
!Sample_submission_date = Jan 27 2021
!Sample_last_update_date = Oct 25 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = human T-ALL cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: KOPTK1
!Sample_characteristics_ch1 = treatment: DMSO
!Sample_treatment_protocol_ch1 = Human cell line KOPTK1 was either treated with DMSO control or gamma-secretase inhibitor (Compound E, Alexis Bioscience, ALX-270-415-C250) for 72h. For the in vivo experiments, mice secondrary transplanted with NOTCH-delta E tumors were fed either valine proficient control diet or valine deficient diet or valine defiecinet diet substituted with either 0.8g/L or 0.4g/L valine in drinking water. Mice were sacrificed after 3 weeks in different diets and leuekmic cells were sorted from spleen using GFP as a marker and used for RNA isolation.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was extracted using the RNeasy Mini Kit using Qiagen kit (Catalog no: 74106) folllowing manufacturer's guidelines.
!Sample_extract_protocol_ch1 = The libraries were prepared using NEXTflex Rapid Directional RNA-Seq Kit from Bioo Scientific (Catalog no: 5138-07) folllowing manufacturer's guidelines.
!Sample_description = KOPTK1_FPKM.tsv
!Sample_data_processing = Alignment: Sequencing reads were aligned against the reference genome sequences hg19 for human and mm10 for mouse using the STAR aligner. Only uniquely mapped reads were kept.
!Sample_data_processing = Read counting: STAR integrated function --quantMode GeneCounts was applied using Ensembl Genes V75 for human and Ensembl Genes V85 gene annotations. Only reverse-mapping read counts (RF) were utilized for downstream analyses.
!Sample_data_processing = Normalization: FPKM normalization was applied using edgeR after intra- and inter-sample normalization (“calcNormFactors” and “estimateTagwiseDisp”).
!Sample_data_processing = Genome_build: hg19 for human; mm10 for mouse
!Sample_data_processing = Supplementary_files_format_and_content: tsv-table of FPKM values
!Sample_platform_id = GPL20301
