!Sample_status = Public on Apr 30 2018
!Sample_submission_date = Sep 13 2017
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = embryonic stem cells, DSCC1 siRNA
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = source cell line: H9
!Sample_characteristics_ch1 = cell type: embryonic stem cells
!Sample_characteristics_ch1 = genotype/variation: Rex1-EGFP
!Sample_characteristics_ch1 = sirna: DSCC1
!Sample_treatment_protocol_ch1 = All genes were targeted with commercial pooled siRNAs to increase the specificity of the knockdown. esiRNAs for SALL4, DSCC1 and SEPHS1 and the control esiRNA for Renilla Luciferase were obtained from Sigma. siRNA for VRTN was obtained from GE Healthcare Dharmacon. Briefly, 30-50 nM siRNA was mixed with 1.4 µl of DharmaFECT 1 transfection reagent (GE Healthcare Dharmacon) in Opti-MEM I reduced serum media (Thermo Fisher Scientific) for 30 minutes. The transfection mix was then added to mTeSR 1 medium with ~30-50k hESCs and the cells were plated on a Matrigel-coated well of a 12-well plate. The cells were subsequently grown for 3-4 days and the mTeSR 1 medium was replaced every 24 hours.
!Sample_growth_protocol_ch1 = Cells were cultured at 37 C and 5% CO2 in feeder-free conditions on Matrigel-coated plates (Corning) in mTeSR1 (STEMCELL Technologies).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Cells were harvested 48 hours after transfection of siRNAs for SALL4 and VRTN and 72 hours for DSCC1 and SEPHS1. Total RNA was isolated from three independent biological replicates with RNeasy Mini or Micro Kit (QIAGEN).
!Sample_extract_protocol_ch1 = mRNA fraction of total RNA was enriched by pulldown of poly(A)-RNA. RNA sequencing libraries were generated using SENSE Total RNA-Seq Library Prep Kit (LEXOGEN) according to manufacturer’s protocol and sequenced using Illumina NextSeq 500 with 80 bp single-end reads.
!Sample_description = eGFP gene under Rex1 promoter.
!Sample_description = Processed data file: rawCounts.csv
!Sample_data_processing = Reads were mapped to the reference genome using STAR 2.4.0.1 software.
!Sample_data_processing = Reads were annotated using HTSeq 0.9.1 software.
!Sample_data_processing = Genome_build: GRCh38 reference genome
!Sample_data_processing = Supplementary_files_format_and_content: rawCounts.csv: Comma-separated values (csv) file contains raw transcript counts for each sample.
!Sample_platform_id = GPL18573
!Sample_contact_name = Mordecai,,Peretz
!Sample_contact_email = motti.peretz@mail.huji.ac.il
!Sample_contact_institute = Hebrew University of Jerusalem
!Sample_contact_address = The Edmond J. Safra Campus
!Sample_contact_city = Jerusalem
!Sample_contact_zip/postal_code = 9190401
!Sample_contact_country = Israel
