!Sample_source_name_ch1 = AEC
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = infection: mock
!Sample_characteristics_ch1 = moi: 0.5
!Sample_characteristics_ch1 = time point: 48h
!Sample_treatment_protocol_ch1 = Infections were done by adding the appropriate amount of virus stock solution (produced in Vero E6 cells) at an MOI of 0.5 directly to the cells. For mock infections, supernatant from non-infected Vero E6 cells was used. Two hours after adding the virus, growth mediu was supplemented with DMSO (solvent control) or 17-AAG as indicated.
!Sample_growth_protocol_ch1 = Airway epithelial cells (AEC) were prepared as described previously (Imai-Matsushima et al., 2018, doi: 10.1016/j.ebiom.2018.05.032)
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = For polyA/total/small RNA-seq, cells were lysed in Trizol and RNA extracted using standard methods.
!Sample_extract_protocol_ch1 = RNA was extracted using the RNA clean and concentrator kit (Zymo) and subjected to bulk polyA RNA-sequencing using the NebNext Ultra II Directional RNA Library (New England Biolabs).
!Sample_description = polyA RNA extracted from whole cells
!Sample_description = AEC_SARSCoV2_17AAG_readcounts.tsv.gz
!Sample_description = AECII_15_48h_DMSO-3
!Sample_data_processing = Sequencing reads were aligned to the human genome (version hg19) using hisat2 (Kim et al., 2015, doi: 10.1038/s41587-019-0201-4), and reads counted using quasR (Gaidatzis et al., 2015, doi: 10.1093/bioinformatics/btu781)
