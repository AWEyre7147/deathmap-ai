^SAMPLE = GSM4681396
!Sample_title = polyA RNA from Calu3 cells, Hsp90 Inhibitors Exp. 1 , DMSO treated, mock infected, replicate 3
!Sample_geo_accession = GSM4681396
!Sample_status = Public on Jul 22 2020
!Sample_submission_date = Jul 21 2020
!Sample_last_update_date = Jul 22 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Calu3 cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = infection: mock
!Sample_characteristics_ch1 = moi: NA
!Sample_characteristics_ch1 = time point: 16h
!Sample_treatment_protocol_ch1 = Infections were done by adding the appropriate amount of virus stock solution (produced in Vero E6 cells) at an MOI of 0.3  directly to the cells. For mock infections, supernatant from non-infected Vero E6 cells was used.
!Sample_growth_protocol_ch1 = H1299, Caco-2 and Calu-3 cells were grown in DMEM/10%FCS/PenStrep/non-essential amino acids/L-glutamine/pyruvate
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = For polyA/total/small RNA-seq, cells were lysed in Trizol and RNA extracted using standard methods. For single-cell RNA-sequencing, cells were fixed in methanol and stored at -80 degrees until further processing. Rehydration was done as described in Alles et al. 2017 (doi: 10.1186/s12915-017-0383-5)
!Sample_extract_protocol_ch1 = PolyA and total RNA-seq libraries were constructed using the NEB Ultra II Directional RNA Library Prep Kit. SmallRNA-seq libraries were constructed using the Clontech SMARTer smRNA-Seq Kit. Single-cell libraries were constructed using a a Nadia device (Dolomite Bio) according to version 1.8 of the manufacturer's protocol, except that the second-strand synthesis step as described in Hughes et al. 2019 (doi: doi.org/10.1101/689273) was included after the exonuclease step.
!Sample_description = polyA RNA extracted from whole cells
!Sample_description = Hsp90_gene_counts.tsv.gz
