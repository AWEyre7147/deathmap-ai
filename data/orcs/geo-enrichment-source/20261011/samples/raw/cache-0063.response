^SAMPLE = GSM1944747
!Sample_title = DLD1-Cas9
!Sample_geo_accession = GSM1944747
!Sample_status = Public on Nov 25 2015
!Sample_submission_date = Nov 19 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = DLD1
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = genotype/variation: Cas9 knock-in
!Sample_treatment_protocol_ch1 = HCT116, HeLa, DLD1, hTERT RPE1 and GBM514 cells were infected with virus carrying the Cas9-2A-Blasticidin expressing cassette and infected cells were selected with blasticidin (5 ug/ml). After 10 days of selection, single cells were sorted onto 96-well plates with a BD FACS Aria IIu cell sorter at low pressure (20 PSI) using a 100 micron nozzle or by manual seeding of a single cell suspension at 0.6 cells/96 well plates. Independent clones were isolated and FLAG-Cas9 expression was determined using Western blot analysis.
!Sample_growth_protocol_ch1 = HCT116 cells were maintained in McCoy’s 5A medium with L-glutamine (Life Technologies) supplemented with 10% FBS (Life Technologies) and 1% Penicillin/Streptomycin (Life Technologies). HeLa, DLD1, and hTERT RPE1 cells were maintained in DMEM with high glucose and pyruvate (Life Technologies) supplemented with 10% FBS (Life Technologies) and 1% Penicillin/Streptomycin (Life Technologies). The patient-derived GBM514 glioblastoma cell line was kindly provided by Peter Dirks’ laboratory at SickKids, Toronto. GBM cells were cultured as described in Pollard et al. 2009.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was extracted from Cas9-expressing cell lines using TriReagent (Sigma) according to manufacturer's instructions
!Sample_extract_protocol_ch1 = RNA sequencing libraries were prepared with Illumina TruSeq V2 RNA library preparation kit according to manufacturer's directions. Multiplexed libraries (HCT116 only) were sequenced on a single read High Output Illumina NextSeq500 flow cell (version 1 chemistry) with a read length of 61bp.
!Sample_description = RNAseq of Cas9 knock-in
!Sample_data_processing = TopHat v2.0.13
!Sample_data_processing = command line:  tophat --transcriptome-index gencode.v19.annotation -T hg19 [fastq file]
!Sample_data_processing = Cufflinks v2.0.2
!Sample_data_processing = command ine:  cufflinks -G gencode.v19.annotation.gtf accepted_hits.bam
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: Excel spreadsheet of log2(fpkm+0.01) for protein coding genes
!Sample_platform_id = GPL18573
!Sample_contact_name = Jason,,Moffat
!Sample_contact_email = j.moffat@utoronto.ca
!Sample_contact_laboratory = Moffat
!Sample_contact_department = CCBR
!Sample_contact_institute = University of Toronto
!Sample_contact_address = 160 College St
!Sample_contact_city = Toronto
!Sample_contact_state = ON
!Sample_contact_zip/postal_code = M5S 3E1
!Sample_contact_country = Canada
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN04279086
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX1438425
!Sample_supplementary_file_1 = NONE
