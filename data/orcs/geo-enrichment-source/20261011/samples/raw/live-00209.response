!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = HCT116
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: HCT116
!Sample_characteristics_ch1 = cell type: colon cancer cell line
!Sample_characteristics_ch1 = genotype: PRF-1 Clone #6
!Sample_characteristics_ch1 = treatment: Sorted: Top eGFP/mCherry
!Sample_treatment_protocol_ch1 = Transduced cells were selected with 1 µg/mL puromycin (Thermo Fisher Scientific)
!Sample_growth_protocol_ch1 = Cell lines were obtained from ATCC. HCT116 cells (male) were cultured in DMEM media (Thermo Fisher Scientific) supplemented with 10% fetal bovine serum (Sigma-Aldrich) and 1X Penicillin-Streptomycin (Gibco)
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was isolated from unsorted cells using the MasterPure Complete DNA Purification kit (Lucigen) and from sorted cells by phenol-chlorofom extraction
!Sample_extract_protocol_ch1 = Sequencing libraries were generated using two sequential rounds of PCR using Herculase II Fusion DNA polymerase (Agilent). In the first round of PCR, 5µg of genomic DNA from unsorted cells was used in each of 24 100 µl reactions, and all recovered genomic DNA from sorted cells was split into two 100 µl reactions. Following 18 cycles of PCR1 amplification, 5 µl from the pooled reaction product was used in the second round of PCR (11 – 13 cycles), using primers containing barcodes and Illumina sequencing adaptors
!Sample_extract_protocol_ch1 = OTHER: CRISPR screen custom DNA library
!Sample_data_processing = Raw data from machine are de-multiplexed and converted to fastq files using bcl2fastq
!Sample_data_processing = Galaxy: Clip adapter GTTTTAGA and CGGTGTTTC
!Sample_data_processing = Galaxy: Collapse sequences
!Sample_data_processing = Galaxy: FASTA-to-tabular
!Sample_data_processing = MAGeCK sgRNA enrichment
!Sample_data_processing = Assembly: hg38
!Sample_data_processing = Supplementary files format and content: Table of raw and normalized read counts of sgRNAs
