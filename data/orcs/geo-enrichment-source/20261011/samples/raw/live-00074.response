^SAMPLE = GSM3721913
!Sample_title = Scrmbl_rep1
!Sample_geo_accession = GSM3721913
!Sample_status = Public on Feb 12 2020
!Sample_submission_date = Apr 13 2019
!Sample_last_update_date = Feb 12 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Scrmbl_flow cytometry sorted astrocytes
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain background: C57Bl/6
!Sample_characteristics_ch1 = genotype/variation: sgScrmbl-targeted
!Sample_characteristics_ch1 = Sex: male
!Sample_characteristics_ch1 = age: P84
!Sample_characteristics_ch1 = cell type: Flow cytometry sorted astrocytes
!Sample_treatment_protocol_ch1 = Induction of EAE in mice. EAE was induced by injecting 25 µg of MOG35-55 diluted in 100 µL of PBS emulsified in 100 µL of CFA per mouse.
!Sample_growth_protocol_ch1 = N/A
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Each CNS was isolated per mouse. A cell suspension was generated by papain digestion, neutralization, and 70um filtration of cell extract. Cells were centrifuged, resuspended in 30% Percoll, centrifuged, and washed in PBS. Cells were sorted by flow cytometry based on a negative selection strategy for astrocytes.
!Sample_extract_protocol_ch1 = Libraries were prepared by the Broad Institute according to Smart-seq 2 protocol as described (Picelli et al., 2014)
!Sample_description = *_HMW5KBGX9.*.GTAGAGGA_ATAGAGAG
!Sample_data_processing = Reads were aligned against the GRCm38 mouse genome using STAR (v.2.5.3) with parameters --twopassMode Basic --alignIntronMax 1000000 --sjdbOverhang 37 --alignMatesGapMax 1000000
!Sample_data_processing = Reads were marked for duplicates using Picard (v.2.7.1)
!Sample_data_processing = Reads were removed for duplicates, mapping quality below 30, unmapped reads, mate unmapped, and multi-mapped.
!Sample_data_processing = Reads were counted using FeatureCounts from Subread (1.5.0) in pair-end mode
!Sample_data_processing = Genome_build: GRCm38
!Sample_data_processing = Supplementary_files_format_and_content: Tab-delimited file containing Gene IDs and number of reads mapping to that gene
!Sample_platform_id = GPL19057
!Sample_contact_name = Michael,,Wheeler
!Sample_contact_email = mwheeler0@bwh.harvard.edu
!Sample_contact_department = Neurology
!Sample_contact_institute = Brigham and Women's Hospital
!Sample_contact_address = 60 Fenwood Rd.
!Sample_contact_city = Boston
!Sample_contact_state = MA
!Sample_contact_zip/postal_code = 02115
!Sample_contact_country = USA
