!Sample_title = RNAseq_Baf_1
!Sample_geo_accession = GSM4551665
!Sample_status = Public on Jul 14 2020
!Sample_submission_date = May 13 2020
!Sample_last_update_date = Jul 14 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = HCT116 colon cancer cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: HCT116
!Sample_characteristics_ch1 = sgrna received: no
!Sample_characteristics_ch1 = sample type: NMD reporter
!Sample_growth_protocol_ch1 = HCT116 NMD reporter cells were treated with DMSO or 5 nM bafilomycin for 48 hours
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was isolated using the RNeasy Mini kit (Qiagen) and gDNA contamination was removed using the TURBO DNA-Free kit (ThermoFisher Scientific)
!Sample_extract_protocol_ch1 = RNA-seq libraries were prepared using the TruSeq Stranded Total RNA Library Prep Kit (Illumina) and sequenced using the 75 bp single-read protocol on a NextSeq 500 platform (Illumina).
!Sample_description = mRNA
!Sample_data_processing = Raw data from machine are de-multiplexed and converted to fastq files using bcl2fastq
!Sample_data_processing = The fastq files are checked for quality using fastqc (v0.11.2) and fastq_screen (v0.4.4)
!Sample_data_processing = Fastq files are mapped to hg19 reference genome (from igenomes) using STAR
!Sample_data_processing = Read counts are then generated using featureCounts
!Sample_data_processing = TMM normalization and differential expression analysis is performed using edgeR
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: a table of edgeR analysis of these RNA-seq data
