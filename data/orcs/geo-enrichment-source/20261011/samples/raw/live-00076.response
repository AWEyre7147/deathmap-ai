^SAMPLE = GSM4018707
!Sample_title = F4_Mafg_rep1
!Sample_geo_accession = GSM4018707
!Sample_status = Public on Feb 12 2020
!Sample_submission_date = Aug 08 2019
!Sample_last_update_date = Feb 13 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Flow cytometry sorted astrocytes
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: C57Bl/6
!Sample_characteristics_ch1 = Sex: Male
!Sample_characteristics_ch1 = age: P90
!Sample_characteristics_ch1 = tissue: astrocytes
!Sample_characteristics_ch1 = genotype: sgMafg-targeted
!Sample_treatment_protocol_ch1 = Induction of EAE in mice. EAE was induced by injecting 25 µg of MOG35-55 diluted in 100 µL of PBS emulsified in 100 µL of CFA per mouse.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Each CNS was isolated per mouse. A cell suspension was generated by papain digestion, neutralization, and 70um filtration of cell extract. Cells were centrifuged, resuspended in 30% Percoll, centrifuged, and washed in PBS. Cells were sorted by flow cytometry based on a negative selection strategy for astrocytes.
!Sample_extract_protocol_ch1 = Libraries were prepared by the Broad Institute according to the 3' DGE protocol as described (Soumillon et al., bioRxiv 2014)
!Sample_data_processing = DGE libraries were prepared by the Broad Technology Labs and sequenced by the Broad Genomics Platform.
!Sample_data_processing = Reads were first demulitplex using Picard (v.2.17.11) IlluminaBaseCallsToSam; with well indices CCGGCA (F4), CGCACC (F7), CGGACG (F10), CGTCCG (G1), GACGCC (G4), and GCCCAG (G7).
!Sample_data_processing = Reads were aligned using GRCh38 mouse genome with STAR (v2.4.2a) with default parameters
!Sample_data_processing = Duplicate reads are marked with Picard UmiAwareMarkDuplicatesWithMateCigar to identify duplicate reads based on UMI sequence and alignment start site.
!Sample_data_processing = Gene are then quantified using RSEM v1.2.21 with paired-end option and accessed for quality using RNA-SeQC.
!Sample_data_processing = Genome_build: GRCm38
!Sample_data_processing = Supplementary_files_format_and_content: txt format with gene ID, symbol, and RPKM
!Sample_platform_id = GPL19057
!Sample_contact_name = Michael,,Wheeler
!Sample_contact_email = mwheeler0@bwh.harvard.edu
!Sample_contact_department = Neurology
!Sample_contact_institute = Brigham and Women's Hospital
!Sample_contact_address = 60 Fenwood Rd.
!Sample_contact_city = Boston
!Sample_contact_state = MA
!Sample_contact_zip/postal_code = 02115
!Sample_contact_country = USA
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
