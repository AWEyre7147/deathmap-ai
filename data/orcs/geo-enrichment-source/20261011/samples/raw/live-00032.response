^SAMPLE = GSM3912860
!Sample_title = Ctrl
!Sample_geo_accession = GSM3912860
!Sample_status = Public on Nov 26 2019
!Sample_submission_date = Jul 01 2019
!Sample_last_update_date = Nov 26 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = KP lung tumors
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = genotye/variation: mouse NSCLC
!Sample_characteristics_ch1 = treatment: KP-WT
!Sample_characteristics_ch1 = tag: IgG (control)
!Sample_treatment_protocol_ch1 = KP-WT or KP-Asf1a KO tumors were treated with isotype IgG (control) or anti-PD-1 (clone 29F.1A12, 200 ug/mouse, three times a week) for one week.
!Sample_growth_protocol_ch1 = KP-WT or KP-Asf1a KO tumor cells were intravenously injected into B6 mice and lung tumor formation was monitored by MRI scan.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Mice were humanely euthanized, and mouse lungs were perfused using sterile PBS through heart perfusion from the left ventricle. The whole lung was cut and minced into small pieces followed by digestion in collagenase D (Sigma) and DNase I (Sigma) in Hank’s Balanced Salt Solution (HBSS) at 37°C for 30 minutes. After incubation, the digested tissue was subjected to a 70-μm cell strainer (ThermoFisher Scientific) to obtain single-cell suspensions. Live cell swere then sorted using DAPI  staining. Cells were then resuspended into single cells at a concentration of 1 x 106 per ml in 1X PBS with 0.4% BSA for 10x genomics processing.
!Sample_extract_protocol_ch1 = Single Cell 3’ Reagent Kits v2: Chromium™ Single Cell 3’ Library & Gel Bead Kit v2, PN-120237; Single Cell 3’ Chip Kit v2 PN-120236 and i7 Multiplex Kit PN-120262" (10x Genomics)
!Sample_data_processing = Base calling and demultiplexing was performed using Illumina bcl2fastq software.
!Sample_data_processing = Additional cell-level demultiplexing and alignment was performed with 10x Cell Ranger software.
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: Indexed BAM files containing position-sorted reads aligned to the genome and gene-barcode matrices.
!Sample_platform_id = GPL21103
!Sample_contact_name = Alireza,,Khodadadi-Jamayran
!Sample_contact_laboratory = Applied Bioinformatics Laboratories (ABL)
!Sample_contact_department = Division of Advanced Research Technologies (DART)
!Sample_contact_institute = New York University, NYU Langone Medical Center
!Sample_contact_address = 550 1st Ave, MSB 304
!Sample_contact_city = New York City
!Sample_contact_state = NY
!Sample_contact_zip/postal_code = 10016
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN12172811
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX6385463
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM3912nnn/GSM3912860/suppl/GSM3912860_1_Ctrl_matrix.mtx.gz
!Sample_series_id = GSE133604
!Sample_data_row_count = 0
