^SAMPLE = GSM856789
!Sample_title = Pre-immune control
!Sample_geo_accession = GSM856789
!Sample_status = Public on Feb 01 2012
!Sample_submission_date = Jan 05 2012
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = 786-O clear cell renal carcinoma cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: 786-O clear cell renal carcinoma cells
!Sample_characteristics_ch1 = chip antibody: control
!Sample_treatment_protocol_ch1 = Fixed with 1% formaldehyde for 10 minutes at 25 C, followed by 125 mM Glycine for 5 minutes at 25 C.
!Sample_growth_protocol_ch1 = 786-O cells were purchased from ATCC. Cell lines were grown in Dulbecco’s modified Eagle’s Medium, 100U/ml penicillin, 100μg/ml streptomycin and 10% fetal bovine serum (Sigma).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Lysates were clarified from sonicated whole cells and immunoprecipitated with andtibodies against HIF-2a (PM9), HIF-1beta (Novus Biologicals, NB100-110), or pre-immune serum. Libraries were prepared from immunoprecipitated chromatin using the Illumina ChIP-Seq kit.
!Sample_description = ChIP DNA
!Sample_data_processing = 5179_control_hg18.bigWig; genome build: hg18
!Sample_data_processing = Sequences were mapped to NCBI build 36 (hg18) using ELAND software. Subsequent assessment, 2-sample peak finding, motif analysis, and mapping of RCGTG motifs were undertaken using the CisGenome software suite (http://www.biostat.jhsph.edu/~hji/cisgenome/)
!Sample_platform_id = GPL9115
