^SAMPLE = GSM6777850
!Sample_title = ESC, shControl, rep1
!Sample_geo_accession = GSM6777850
!Sample_status = Public on Jan 01 2023
!Sample_submission_date = Dec 01 2022
!Sample_last_update_date = Jan 01 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = R1
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell line: R1
!Sample_characteristics_ch1 = cell type: embryonic stem cells
!Sample_characteristics_ch1 = genotype: WT
!Sample_characteristics_ch1 = treatment: Mouse ESCs were cultured on 0.2% gelatin-coated plates in the LIF/Serum medium.
!Sample_growth_protocol_ch1 = Mouse ESCs were cultured on 0.2% gelatin-coated plates in the indicated medium. LIF/serum culture: DMEM supplemented with 15% FBS, 2mM GlutaMAX, 1% MEM non-essential amino acids, 0.1mM β-mercaptoethanol (all from Invitrogen) and 10 ng/ml LIF (Millipore). 
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted from the tissue using TRIzol Reagent according the manufacturer’s instructions(Invitrogen) and genomic DNA was removed using DNase I (TaKara). Then RNA quality was determined using 2100 Bioanalyser (Agilent) and quantified using the ND-2000 (NanoDrop Technologies). High-quality RNA sample (OD260/280=1.8~2.2, OD260/230≥2.0, RIN≥6.5, 28S:18S≥1.0, >10μg) is used to construct sequencing library.
!Sample_extract_protocol_ch1 = RNA-seq transcriptome libraries were prepared following TruSeqTM RNA sample preparation Kit from Illumina (San Diego, CA), using 1μg of total RNA. Shortly, messenger RNA was isolated with polyA selection by oligo(dT) beads and fragmented using fragmentation buffer. cDNA synthesis, end repair, A-base addition and ligation of the Illumina-indexed adaptors were performed according to Illumina’s protocol.
!Sample_description = Control ESCs cultured in LIF/Serum culture
!Sample_description = 1NG5Z
!Sample_data_processing = Illumina Casava1.8 software used for basecalling
!Sample_data_processing = Sequenced reads were trimmed for adaptor sequence, and masked for low-complexity or low-quality sequence, then mapped to mm10 whole genome using Hisat2.
!Sample_data_processing = featureCount software was used to calculate gene expression from aligned bam files
!Sample_data_processing = R statistical package DESeq2 was used for differential expression analysis
!Sample_data_processing = Assembly: mm10
!Sample_data_processing = Supplementary files format and content: raw reads counts
!Sample_platform_id = GPL24247
!Sample_contact_name = Chen,,Zhang
!Sample_contact_email = zcsdnu@outlook.com
