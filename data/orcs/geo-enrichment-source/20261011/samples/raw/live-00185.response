^SAMPLE = GSM3498495
!Sample_title = TIL_Bulk_C2_TIM_S2
!Sample_geo_accession = GSM3498495
!Sample_status = Public on Dec 02 2018
!Sample_submission_date = Dec 01 2018
!Sample_last_update_date = Dec 03 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = TIL_Bulk_C2_TIM
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain background: C57BL/6
!Sample_characteristics_ch1 = cell type: CD8+ T-cells
!Sample_characteristics_ch1 = cell subtype: Slamf6-Tim3+SIINFEKL Tetramer+ CD44+PD-1+CD8+ T cells isolated from  B16-ova tumors 22 days post-inoculation after treatment with isotype control antibody on days 9 and 12
!Sample_characteristics_ch1 = isolation of cd8+ t cells: CD8+ MACS negative selection (Miltenyi) followed by FACS
!Sample_treatment_protocol_ch1 = LCMV-infected mice were not treated. Tumor inoculated mice were treated with 100mcg anti-PD-1 or isotype control antibody on days 9 and 12 after implantation
!Sample_growth_protocol_ch1 = For LCMV experiments, C57BL/6 mice were infected with 2 x 10^6 pfu LCMV Clone 13 via IV injection. On day 30 after infection, mice were sacrificed and spleens removed for CD8+ T cell isolation. For tumor experiments, C57BL/6 mice were injected subcutaneously with 3 x 10^5 B16-ova cells. Tumors were harvested on day 22 after implantation for CD8+ T cell isolation
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = CD8+ T cells were isolated from LCMV-infected mice by CD8+ MACS negative selection performed on single-cell suspensions of splenocytes, followed by FACS. CD8+ T cells were isolated from B16-ova tumors by dissecting tumors from the surrounding fascia, mechanically mincing and treating with collagenase P and DNAse I for 10 minutes at 37C. Tumor-infiltrating leukocytes were enriched by CD8+ MACS positive selection (Miltenyi) and FACS isolation. In both contexts, cells were sorted directly into PBS with 2% FBS.
!Sample_extract_protocol_ch1 = Library construction was performed as per standard ATAC-seq protocol, as outlined in Corces et al., Nature Genetics 2016
!Sample_description = TIL_Bulk_C2_TIM_S2
!Sample_description = processed data file: TIL_Bulk_TIM_0.001_peaks.narrowPeak
!Sample_data_processing = Quality trimming of Fastqs was performed using Trimmomatic
!Sample_data_processing = Trimmed reads were aligned to the mm9 mouse genome using Bowtie2
!Sample_data_processing = Aligned reads were sorted and biological replicates were merged for peak-calling with samtools
!Sample_data_processing = Peak-calling was performed on merged bams using MACS2
!Sample_data_processing = Union and merging of peaks across all condition was done using BEDtools
!Sample_data_processing = BEDtools was used to quantify raw ATAC cut-sites within each peak in universe for each biological replicate to obtain a raw counts matrix
!Sample_data_processing = Library size normalization was performed using DESeq2 to obtain a final normalized counts matrix
!Sample_data_processing = Genome_build: mm9
!Sample_platform_id = GPL19057
