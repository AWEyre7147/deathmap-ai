^SAMPLE = GSM1891661
!Sample_title = BisSeq_TKO
!Sample_geo_accession = GSM1891661
!Sample_status = Public on Dec 16 2015
!Sample_submission_date = Sep 23 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = embryonic stem cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: 159 (mixed 129-C57Bl/6)
!Sample_characteristics_ch1 = genotype: DNMT TKO
!Sample_characteristics_ch1 = growth condition: serum
!Sample_growth_protocol_ch1 = Mouse embryonic stem cells were cultivated without feeders on 0.2% gelatine-coated dishes in DMEM, supplemented with 15% fetal calf serum, 1× non-essential amino acids, 2 mM L-glutamine, LIF and 0.001% β-mercaptoethanol (37°C, 7% CO2).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = DNA was isolated by phenol chloroform extraction, followed by ethanol precipitation.
!Sample_extract_protocol_ch1 = Library Construction Protocol: 5 μg of sonicated genomic DNA were end repaired and 3′-end adenylated using the Illumina TruSeq DNA LT Sample Preparation kit (Illumina 15025064). Paired-end adapters were ligated to the DNA fragments and adaptor-ligated DNA was purified by 2% agarose gel electrophoresis. The gel-purified DNA was converted with the EpiTect Bisulfite kit (Qiagen). Converted libraries were enriched by 10 cycles of PCR using PfuTurbo Cx Hotstart DNA Polymerase (Agilent) and purified using AMPure XP beads. Quality of the libraries and size distribution was assessed on an Agilent 2100 Bioanalyzer (Agilent Technologies). Sequencing was performed on an Illumina HiSeq 2500 machine (100 bp read length, paired end) according to Illumina standards.
!Sample_data_processing = Basecalling was performed with the Illumina RTA 1.17.21.3 software with default parameters
!Sample_data_processing = Fastq files were generated with the Illumina bcl2fastq-1.8.4 software with options --use-bases-mask Y50n,I6n --fastq-cluster-count 100000000 --no-eamss
!Sample_data_processing = Bis-seq reads were processed with QuasR and positions covered by at least 10 reads were used.
!Sample_data_processing = Genome_build: mm9
!Sample_platform_id = GPL17021
!Sample_contact_name = Anais,Flore,Bardet
!Sample_contact_institute = IGBMC
!Sample_contact_address = 1 rue Laurent Fries
!Sample_contact_city = Illkirch
!Sample_contact_zip/postal_code = 67404
!Sample_contact_country = France
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = RANDOM
!Sample_library_source = genomic
!Sample_library_strategy = Bisulfite-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN04103868
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX1280454
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM1891nnn/GSM1891661/suppl/GSM1891661_BisSeq_TKO.tsv.gz
!Sample_series_id = GSE67867
!Sample_data_row_count = 0
^SAMPLE = GSM1891662
!Sample_title = BisSeq_to2i
!Sample_geo_accession = GSM1891662
!Sample_status = Public on Dec 16 2015
!Sample_submission_date = Sep 23 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = embryonic stem cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: 159 (mixed 129-C57Bl/6)
!Sample_characteristics_ch1 = genotype: WT
!Sample_characteristics_ch1 = growth condition: adaptation to 2i (> 3 weeks)
!Sample_growth_protocol_ch1 = Mouse embryonic stem cells were cultivated without feeders on 0.2% gelatine-coated dishes in DMEM, supplemented with 15% fetal calf serum, 1× non-essential amino acids, 2 mM L-glutamine, LIF and 0.001% β-mercaptoethanol (37°C, 7% CO2). Serum-free cultivation was performed in N2B27 medium, supplemented with 1× non-essential amino acids, 2 mM L-glutamine, LIF and 0.001% β-mercaptoethanol as well as MEK inhibitor PD0325901 (1 µM) and GSK3 inhibitor CHIR99021 (3 µM), together known as 2i. For reversal between culturing conditions, cells were cultured for at least three weeks under the new conditions prior to performing downstream experiments.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = DNA was isolated by phenol chloroform extraction, followed by ethanol precipitation.
!Sample_extract_protocol_ch1 = Library Construction Protocol: 5 μg of sonicated genomic DNA were end repaired and 3′-end adenylated using the Illumina TruSeq DNA LT Sample Preparation kit (Illumina 15025064). Paired-end adapters were ligated to the DNA fragments and adaptor-ligated DNA was purified by 2% agarose gel electrophoresis. The gel-purified DNA was converted with the EpiTect Bisulfite kit (Qiagen). Converted libraries were enriched by 10 cycles of PCR using PfuTurbo Cx Hotstart DNA Polymerase (Agilent) and purified using AMPure XP beads. Quality of the libraries and size distribution was assessed on an Agilent 2100 Bioanalyzer (Agilent Technologies). Sequencing was performed on an Illumina HiSeq 2500 machine (100 bp read length, paired end) according to Illumina standards.
!Sample_data_processing = Basecalling was performed with the Illumina RTA 1.17.21.3 software with default parameters
!Sample_data_processing = Fastq files were generated with the Illumina bcl2fastq-1.8.4 software with options --use-bases-mask Y50n,I6n --fastq-cluster-count 100000000 --no-eamss
!Sample_data_processing = Bis-seq reads were processed with QuasR and positions covered by at least 10 reads were used.
!Sample_data_processing = Genome_build: mm9
!Sample_platform_id = GPL17021
!Sample_contact_name = Anais,Flore,Bardet
!Sample_contact_institute = IGBMC
!Sample_contact_address = 1 rue Laurent Fries
!Sample_contact_city = Illkirch
!Sample_contact_zip/postal_code = 67404
!Sample_contact_country = France
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = RANDOM
!Sample_library_source = genomic
!Sample_library_strategy = Bisulfite-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN04103869
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX1280455
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM1891nnn/GSM1891662/suppl/GSM1891662_BisSeq_to2i.tsv.gz
!Sample_series_id = GSE67867
