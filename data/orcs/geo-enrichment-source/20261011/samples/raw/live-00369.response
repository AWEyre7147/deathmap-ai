!Sample_title = NRF1_CHIP_Over_1
!Sample_geo_accession = GSM1657384
!Sample_status = Public on Dec 16 2015
!Sample_submission_date = Apr 14 2015
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = embryonic stem cells
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: 159 (mixed 129-C57Bl/6)
!Sample_characteristics_ch1 = genotype: WT
!Sample_characteristics_ch1 = growth condition: serum
!Sample_characteristics_ch1 = chip antibody: NRF1 (Abcam, ab55744)
!Sample_treatment_protocol_ch1 = For transient overexpression of NRF1, a plasmid containing Nrf1 under the control of the CAG promoter was reverse transfected into 159 cells 12 h prior to harvesting
!Sample_treatment_protocol_ch1 = For transient overexpression of NRF1, a plasmid containing Nrf1 under the control of the CAG promoter was reverse transfected into 159 cells 12 h prior to harvesting
!Sample_growth_protocol_ch1 = Mouse embryonic stem cells were cultivated without feeders on 0.2% gelatine-coated dishes in DMEM, supplemented with 15% fetal calf serum, 1× non-essential amino acids, 2 mM L-glutamine, LIF and 0.001% β-mercaptoethanol (37°C, 7% CO2).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Chromatin immunoprecipitation (ChIP) was carried out essentially as previously described (Jermann et al. PNAS 2014).
!Sample_extract_protocol_ch1 = Library Construction Protocol: Libraries for ChIP-seq were prepared according to standard Illumina library preparation protocols. Twelve cycles of PCR (NEB Q5 Hot Start HiFi PCR) were performed on end-repaired, A-tailed and adapter-ligated DNA prior to gel size-selection. Quality of the libraries and size distribution was assessed on an Agilent 2100 Bioanalyzer (Agilent Technologies). Sequencing was performed on an Illumina HiSeq 2500 machine (50 bp read length, single end) according to Illumina standards.
!Sample_data_processing = Basecalling was performed with the Illumina RTA 1.17.21.3 software with default parameters
!Sample_data_processing = Fastq files were generated with the Illumina bcl2fastq-1.8.4 software with options --use-bases-mask Y50n,I6n --fastq-cluster-count 100000000 --no-eamss
!Sample_data_processing = Read mapping was performed using Bowtie version 1.0.0 with parameters -v 3 -m 1 --best --strata.
!Sample_data_processing = Bigwig files were generated by extending the reads to 200bp and calculating for each genomic position the read density normalized to one million reads in the library.
!Sample_data_processing = Genome_build: mm9
!Sample_platform_id = GPL17021
