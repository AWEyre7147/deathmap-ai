^SAMPLE = GSM4880278
!Sample_title = DMSO_control_0_1percent_d20
!Sample_geo_accession = GSM4880278
!Sample_status = Public on Mar 04 2021
!Sample_submission_date = Nov 04 2020
!Sample_last_update_date = Mar 04 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Nalm-6 pre-B lymphoid cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = sample type: pooled sgRNA library
!Sample_characteristics_ch1 = treatment: 0.1% v/v DMSO control 20 days
!Sample_treatment_protocol_ch1 = A Nalm-6 clone with inducible expression of Cas9 was thawed, and Cas9 expression induced with doxycycline at 2 µg/mL for 7 days (see Bertomeu et al., 2017 for details). The pooled EKO library was split in different T-75 flasks and compounds were added (20 µM BIBR1532 or DMSO 0.1% v/v) and propagated for 20 days. Fresh media and compound was added at each cell passage. Untreated controls (replicates A, B) were also propagated for 15 or 22 days respectively.
!Sample_growth_protocol_ch1 = Nalm-6 cells were grown in 10% FBS (v/v) (Wisent) RPMI 1640 medium (Wisent) at 5% (v/v) CO2 and 37°C. Nalm-6 cells were grown in 10% FBS (v/v) (Wisent) RPMI 1640 medium (Wisent) at 5% (v/v) CO2 and 37°C.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted and purified using the Gentra Cell Puregene kit (QIAGEN, cat. # 158388).
!Sample_extract_protocol_ch1 = sgRNA libraries were prepared by PCR amplification to add sequencing adapters and indices followed by SPRI beads purification of sequencing-ready amplicons.
!Sample_description = sgRNAs PCR-amplified from genomic DNA
!Sample_data_processing = Reads were aligned using Bowtie2.2.5 in the forward direction only (--norc option) with otherwise default parameters and total read counts per sgRNA were tabulated.
!Sample_data_processing = Read counts from different sequencing lanes for the same sample were summed.
!Sample_data_processing = Read counts from all control samples were summed.
!Sample_data_processing = Genome_build: For Nalm-6 screens: EKO sgRNA library (Bertomeu et al. 2017, PMID:29038160), using only the core RefSeq gene-targeting sgRNA set of of the library.
!Sample_data_processing = Supplementary_files_format_and_content: Tab-separated sgRNA read counts per sample
!Sample_platform_id = GPL18573
