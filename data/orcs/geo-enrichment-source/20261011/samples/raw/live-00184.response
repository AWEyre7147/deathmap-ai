!Sample_submission_date = Jul 02 2018
!Sample_last_update_date = Jul 03 2018
!Sample_type = RNA
!Sample_channel_count = 1
!Sample_source_name_ch1 = cancer cell line
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: colorectal cancer
!Sample_treatment_protocol_ch1 = cells were harvested without treatment
!Sample_growth_protocol_ch1 = HCT116 was cultured in McCoy’s 5A medium + 10% FCS. RKO, CaCo2 and HT55 were cultured in DMEM with 4 mM glutamine + 10% FCS. LoVo and SNU-C2A were cultured in RPMI + 10% FCS. GP2d and HCA-24 were cultured in DMEM with 2 mM glutamine + 10% FCS. WiDr was cultured in EMEM +10% FCS with 1% NEAA. CL-14 was cultured in DMEM / Ham's F12 (1:1 mixture) + 20% FCS and LIM2405 was cultured in RPMI + 10% FCS with 25 mM HEPES, 10 µM thioglycerol and 0,6 µg/ml insulin (all supplements from Sigma Aldrich, Waltham, USA).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Qiagen RNeasy Extraction Kit
!Sample_label_ch1 = biotin
!Sample_label_protocol_ch1 = The Affymetrix Gene Chip 3´IVT PLUS Reagent Kit is used to generate labeled single-stranded cRNA from input amounts of 100ng total RNA, Label: Biotin
!Sample_hyb_protocol = 11 ug of fragmented and labeled cRNA were hybridized for 17 hr at 45°C on Affymetrix GeneChip® Human Genome U133 Plus 2.0 Arrays according to user manual GeneChip® 3' IVT PLUS Reagent Kit, P/N 703210
!Sample_scan_protocol = Gene Expression Microarrays were scanned using the Affymetrix GeneChip® Scanner 3000 according to GeneChip® Expression Wash, Stain and Scan Manual for Cartridge Arrays (P/N 702731)
!Sample_description = replicate 1
!Sample_data_processing = Data were normalized using the 'affy' R/Bioconductor package. Normalization steps include background correction using the 'rma' method and quantile normalization.
