!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = ChIP:MPP8_Cell_mESC:WT
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = cell line: mESC
!Sample_characteristics_ch1 = cell type: Mouse embryonic stem cell lines
!Sample_characteristics_ch1 = genotype/variation: wild type
!Sample_characteristics_ch1 = chip antibody: MPP8 (16796-1-AP, Protein Technologies Inc)
!Sample_growth_protocol_ch1 = K562 cells (ATCC) were grown in Roswell Park Memorial Institute (RPMI) 1640 Medium (11875093, Life Technologies) supplemented with 10% Fetal Bovine Serum (Fisher, Cat# SH30910), 2 mM L-glutamine (Fisher, Cat# SH3003401) and 1% penicillin-streptomycin (Fisher, Cat#SV30010), and cultured at 37 C with 5% CO2. HeLa cells (ATCC) were grown in Dulbecco’s Modified Eagle’s Medium (Life Technologies, Cat# 11995073) supplemented with 10% FBS (Fisher, Cat# SH30910), 2 mM L-glutamine (Fisher, Cat# SH3003401), and 1% penicillin-streptomycin (Fisher, Cat# SV30010), and cultured at 37 C with 5% CO2. Human ES cells (H9 line) were expanded in feeder-free, serum-free medium mTeSR-1 from StemCell technologies. Cells were passaged 1:6 every 5–6 days by incubation with accutase (Invitrogen) and the resulting small cell clusters (50–200 cells) were subsequently re-plated on tissue culture dishes coated overnight with growth-factor-reduced matrigel (BD Biosciences). Cell cultures were routinely tested and found negative for mycoplasma infection (MycoAlert, Lonza).
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Lysates were clarified from sonicated nuclei and histone-DNA complexes were isolated with antibody. Total RNA was isolated from K562 cells using the RNAeasy kit (Qiagen # 74104) and treated with RNase-Free DNase Set (Qiagen # 79254) to remove genomic DNA, according to the manufacturer’s instructions.
!Sample_extract_protocol_ch1 = ChIP DNA, input DNA or cDNA were subject to end repair, A-tailing, adaptor ligation and cleavage with USER enzyme, followed by size selection to 250-500 bp and amplification with NEBNext sequencing primers. Libraries were purified, quantified, multiplexed and sequenced with 1x75bp single-end reads on an Illumina NEXT-seq (Stanford Functional Genomics Facility).
!Sample_data_processing = The base calling was done using bcl2fastq v2.17.1.14 (Illumina).
!Sample_data_processing = CasTLE analysis for the CRISPR screen was performed as previously described (Morgens et al, 2016)
!Sample_data_processing = Genome_build: human (hg38)
!Sample_data_processing = Supplementary_files_format_and_content: txt files including the name, location and function of identified genes, as well as their effect size and CasTLE scores
!Sample_platform_id = GPL19057
!Sample_contact_name = Nian,,Liu
!Sample_contact_email = liunian88@gmail.com
!Sample_contact_laboratory = Wysocka lab
!Sample_contact_department = Chemical and Systems Biology
!Sample_contact_institute = Stanford University
!Sample_contact_address = 265 Campus Drive, Rm. G3145
!Sample_contact_city = Palo Alto
!Sample_contact_state = CA
!Sample_contact_zip/postal_code = 94306
!Sample_contact_country = USA
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = ChIP
!Sample_library_source = genomic
!Sample_library_strategy = ChIP-Seq
