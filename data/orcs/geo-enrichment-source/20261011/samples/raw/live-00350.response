!Sample_last_update_date = Feb 12 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Remitting_Parenchyma
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = Sex: Female
!Sample_characteristics_ch1 = disease: Remitting
!Sample_characteristics_ch1 = region: Parenchyma
!Sample_characteristics_ch1 = molecule subtype: immunoprecipitated mRNA via HA-tagged Rpl22 ribosomal subunit
!Sample_treatment_protocol_ch1 = Induction of EAE in mice. EAE was induced by injecting 150 µg of MOG35-55 diluted in 100 µL of PBS emulsified in 100 µL of CFA per mouse.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Protocol largely derived from Sanz et al. 2009, PNAS. Each CNS region was microdissected and homogenized in supplemented homogenization buffer (HB-S). Debris was pelleted, and supernatant was immunoprecipitated with an anti-HA antibody (Sigma, #H9658, 1:150) overnight. Following washes, RNA was purifiied using a Qiagen RNeasy purification kit (Qiagen, #74106). mRNA was then isolated using mRNA DIRECT kit (Thermo Fisher, #61012).
!Sample_extract_protocol_ch1 = Libraries were prepared using a similar protocol as MARS-seq (Jaitin et al. Science 2014).
!Sample_data_processing = The right reads were trimmed using fastx (v0.0.13) fastx_trimmer.
!Sample_data_processing = Sequencing reads was aligned against the mm10 genome using STAR with default parameters and --quantMode geneCounts to count unique reads mapped
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: Tab-delimited gene counts generated from STAR geneCounts
