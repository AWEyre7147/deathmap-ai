^SAMPLE = GSM5018597
!Sample_title = AutophagyActivated-replicate1
!Sample_geo_accession = GSM5018597
!Sample_status = Public on May 11 2021
!Sample_submission_date = Jan 13 2021
!Sample_last_update_date = May 11 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = HEK293T
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = sorts: 4
!Sample_characteristics_ch1 = cell line: Homo sapiens
!Sample_characteristics_ch1 = sequenced molecule: Genomic DNA amplicon
!Sample_treatment_protocol_ch1 = Cells were resuspended with HBSS containing 10% FBS, penicillin and streptomycin. Autophagy-activated cells were collected using a cell sorter (MoFlo AstriosEQ; Beckman Coulter).
!Sample_growth_protocol_ch1 = HEK293T cells expressing the GFP-LC3-RFP autophagy flux reporter and Cas9 (HEK293T GFP-LC3-RFP cells) were cultured in 10% fetal bovine serum (S1820-500; biowest) supplemented DMEM (D6546; Sigma-Aldrich). HEK293T GFP-LC3-RFP cells were transfected the GeCKOv2 library at a multiplicity of infection (MOI) of 0.3–0.5 and selected with puromycin. Cells were cultured and expanded for two weeks, and sorted using a cell sorter (MoFlo AstriosEQ; Beckman Coulter). After sorting, the cells were expanded for roughly two weeks. The sorting was repeated four times.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Genomic DNA was extracted using Blood & Cell Culture Midi kit (13343; QIAGEN).
!Sample_extract_protocol_ch1 = A total of 100 - 240 µg genomic DNA (varying between replicates) was extracted, and sgRNA sequences were amplified by PCR using Herculase II Fusion DNA polymerase (600675; Agilent Technologies). Next, the amplicons were subjected to the second PCR to attach Illumina adaptors and barcode samples. The primers used in the first PCR were as follows: F1, 5'-AATGGACTATCATATGCTTACCGTAACTTGAAAGTATTTCG-3', and R1, 5'-CTTTAGTTTGTATGTCTGTTGCTATTATGTCTACTATTCTTTCC-3'. The primers used in the second PCR were as follows: F2, 5'-AATGATACGGCGACCACCGAGATCTACACTCTTTCCCTACACGACGCTCTTCCGATCT-(variable-length sequence, up to 8 bp)-TCTTGTGGAAAGGACGAAACACCG-3'  R2, 5'-CAAGCAGAAGACGGCATACGAGAT-(8-bp barcode)-GTGACTGGAGTTCAGACGTGTGCTCTTCCGATCTTCTACTATTCTTTCCCCTGCACTGT-3'. DNA was sequenced on a HiSeq 2500 (Illumina) sequencer. After data acquisition, the number of reads that completely matched the GeCKO v2 library sequence was calculated.
!Sample_data_processing = Library strategy: Amplicon sequencing
!Sample_data_processing = Basecalls performed using Illumina bcl2fastq version 1.8.4
!Sample_data_processing = Sequenced reads were trimmed for adaptor sequence and random primer sequences using in-house pipeline
!Sample_data_processing = The number of reads that completely matched the GeCKO v2 library sequence was calculated
!Sample_data_processing = Supplementary_files_format_and_content: tab-delimited text files include read count for each target
!Sample_platform_id = GPL16791
!Sample_contact_name = Noboru,,Mizushima
!Sample_contact_email = nmizu@m.u-tokyo.ac.jp
!Sample_contact_institute = The University of Tokyo
!Sample_contact_address = 7-3-1 Hongo
!Sample_contact_city = Tokyo
!Sample_contact_zip/postal_code = 113-0033
!Sample_contact_country = Japan
!Sample_instrument_model = Illumina HiSeq 2500
!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN17308943
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX9845452
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5018nnn/GSM5018597/suppl/GSM5018597_Autophagy-1_count.txt.gz
!Sample_series_id = GSE164778
!Sample_data_row_count = 0
