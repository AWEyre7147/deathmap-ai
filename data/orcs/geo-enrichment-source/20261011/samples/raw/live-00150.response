^SAMPLE = GSM3716987
!Sample_title = WT-1 [S1]
!Sample_geo_accession = GSM3716987
!Sample_status = Public on Feb 12 2020
!Sample_submission_date = Apr 10 2019
!Sample_last_update_date = Feb 13 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = WT_astrocytes
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: C57Bl/6
!Sample_characteristics_ch1 = genotype/variation: wild type
!Sample_characteristics_ch1 = Sex: male
!Sample_characteristics_ch1 = age: P90
!Sample_characteristics_ch1 = sample group: naïve
!Sample_characteristics_ch1 = cell type: Flow cytometry sorted astrocytes
!Sample_treatment_protocol_ch1 = Induction of EAE in mice intracranially transduced with pLenti-U6-sgMafg-Gfap-Cas9-2A-EGFP-WPRE or pLenti-U6-sgScrmbl-Gfap-Cas9-2A-EGFP-WPRE or non-transduced naive mice. EAE was induced by injecting 25 µg of MOG35-55 diluted in 100 µL of PBS emulsified in 100 µL of CFA per mouse.
!Sample_molecule_ch1 = genomic DNA
!Sample_extract_protocol_ch1 = Each CNS was isolated per mouse. A cell suspension was generated by papain digestion, neutralization, and 70um filtration of cell extract. Cells were centrifuged, resuspended in 30% Percoll, centrifuged, washed in PBS, and stained with primary antibodies for flow cytometry. Once cells were sorted, cells were pelleted, washed, and genomic DNA was isolated using the Qiagen DNeasy Blood & Tissue Kit kit (Qiagen, #69504).
!Sample_extract_protocol_ch1 = Bisulfite converted DNA libraries were generated by using the Zymo Pico-Methyl DNA kit (Zymo Research, #D5455) according to the manufacturer's protocol.
!Sample_description = LIB037963_GEN00140761_S1
!Sample_data_processing = Reads were trimmed using Cutadapt (v1.14) to remove adapters and low quality reads.
!Sample_data_processing = Trimmed reads were then aligned to GRCm38 genome using Bismark (v0.20.1) and Bowtie2 (v0.20.1) with default settings.
!Sample_data_processing = Duplicated reads were removed using paired end mode
!Sample_data_processing = Methylation counts and percentages were extracted using bismark_methylation_extractor
!Sample_data_processing = Percentage methylation were visualized using IGV (v2.3.59)
!Sample_data_processing = Genome_build: GRCm38
!Sample_data_processing = Supplementary_files_format_and_content: bedgraph file with percent methylation at each CpG position
