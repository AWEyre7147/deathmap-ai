!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain (genetic background): J1 129S4/SvJae
!Sample_characteristics_ch1 = genotype: Dnmt-TKO
!Sample_characteristics_ch1 = cell type: mESC
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = For study of mESCs, total RNA was isolated using ZR-Duet DNA-RNA MiniPrep kit (Zymo). cDNA synthesis and library prep was performed starting with 500 ng total RNA following manufacturer’s instructions using the NEBNext Ultra Library Prep Kit (NEB) and the NEBNext Poly(A) mRNA Magnetic Isolation Module (NEB). All libraries were purified by AMPure XP beads (Beckman-Coulter) and sequenced on the Illumina HiSeq 2500 instrument.
!Sample_description = RNA-Seq of mESCs
!Sample_description = mESC_GeneCounts_2.txt
!Sample_data_processing = RNA-Seq reads were aligned to the mouse genome (mm9, NCBI build 37) with Bowtie (version 0.12.8) and Tophat (version 2.0.2 with options -N 2 --b2-very-sensitive --b2-L 25. Annotations from Ensembl Gene version 67 were used as gene model with Tophat. Read counts per annotated gene were computed using HTSeq (version 0.5.3p9).
!Sample_data_processing = Genome_build: mm9
!Sample_data_processing = Supplementary_files_format_and_content: Gene Counts
!Sample_platform_id = GPL17021
