!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line source: 786-O
!Sample_characteristics_ch1 = gpx4 status: GPX4 knockout
!Sample_characteristics_ch1 = category: ferroptosis-resistant
!Sample_treatment_protocol_ch1 = 786-O cells were splitted at 200,000 cells per well in 6-well plates one day before RNA and genomic DNA extraction. No special treatment was administered to these cells.
!Sample_growth_protocol_ch1 = 786-O cells were cultured with RPMI 1640 medium supplemented with 10% FBS and 1% penicillin/streptomycin, and 5uM of ferrostatin-1 in a humidified incubator at 37 °C with 5% CO2.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA samples were extracted using the Rneasy Mini Kit (Qiagen) following manufacturer's instructions. Genomic DNA samples were extracted using the QIAamp Blood Mini DNA isolation kit (Qiagen) from manufacturer's instructions.
